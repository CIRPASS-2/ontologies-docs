<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/eto#"
     xml:base="https://w3id.org/eudpp/eto"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:eudpp="https://w3id.org/eudpp#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/eto">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/eto/0.2.0"/>
        <terms:contributor xml:lang="en">Nader Jelassi</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-30</terms:created>
        <terms:creator xml:lang="en">Quang-Duy Nguyen</terms:creator>
        <terms:description xml:lang="en">Example Tyre Ontology (ETO) is an exemplar ontology for the tyre sector. It specialises the EU DPP Core Ontology (CORE), whose terms it references by their IRIs.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-30</terms:issued>
        <terms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-22</terms:modified>
        <terms:title xml:lang="en">Example Tyre Ontology (ETO)</terms:title>
        <vann:preferredNamespacePrefix>eto</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/eto#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Developed against the CIRPASS-2 CORE ontology as of 12 October 2026: core v2.0.7, P_DPP v2.1.0, IDENT v1.2.0, CON v2.2.0, ACTOR v2.1.3, EVENT v1.0.0, SOC v2.0.0. Checked against the CORE of 21 October 2026: core v2.1.0, P_DPP v2.2.0, IDENT v1.2.0, CON v2.4.0, ACTOR v2.2.0, EVENT v1.0.0, SOC v2.2.0. The CORE is referenced by IRI, without owl:imports: load the CORE files together with this file for reasoning or validation.</rdfs:comment>
        <rdfs:label xml:lang="en">Example Tyre Ontology</rdfs:label>
        <owl:versionInfo xml:lang="en">Version 0.2.0 DRAFT</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/references -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/references"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#hasManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasManufacturer"/>
    


    <!-- https://w3id.org/eudpp#hasMeasurementUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMeasurementUnit"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#codeValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#codeValue"/>
    


    <!-- https://w3id.org/eudpp#description -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#description"/>
    


    <!-- https://w3id.org/eudpp#identifierExampleValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierExampleValue"/>
    


    <!-- https://w3id.org/eudpp#identifierSchemeIssuer -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierSchemeIssuer"/>
    


    <!-- https://w3id.org/eudpp#manufacturingDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#manufacturingDate"/>
    


    <!-- https://w3id.org/eudpp#numericalValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#numericalValue"/>
    


    <!-- https://w3id.org/eudpp/eto#availableInAllEUEEACountries -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#availableInAllEUEEACountries">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:references>EPREL field availabilityInEUEEACountries</terms:references>
        <rdfs:comment>Whether the tyre type is available in all EU and EEA countries. If not, eto:availableInCountry gives the countries where it is available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>available in all EU/EEA countries</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#availableInCountry -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#availableInCountry">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references>EPREL fields modelAvailabilityInEUEEACountries and modelAvailabilityInOtherCountries</terms:references>
        <rdfs:comment>Two-letter code of a country where the tyre type is available, as in EPREL: ISO 3166-1 alpha-2, except EL for Greece and XI for Northern Ireland. One value per country.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>available in country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#commercialNameLongDescription -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#commercialNameLongDescription">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#description"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Long commercial description of the tyre, combining its size, service description and commercial name (e.g. 195/65 R 17 87H Dakota Spring).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>commercial name long description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#hasValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#hasValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#boolean"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <terms:references>ETO specification document, coverage table (Step 2.4)</terms:references>
        <rdfs:comment>Value of a tyre property that is not a quantity: text, code, Boolean flag or date. Quantities use eudpp:numericalValue.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>has value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#onMarketEndDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#onMarketEndDate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <terms:references>EPREL field onMarketEndDate</terms:references>
        <rdfs:comment>Date from which the supplier no longer places the tyre type on the Union market. The first placing on the market is recorded with a eudpp:PlacingOnMarketEvent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>on-market end date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#productionEndWeek -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#productionEndWeek">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references>Regulation (EU) 2020/740, Annex III (j); EPREL fields dateEndProductionWeek and dateEndProductionYear</terms:references>
        <rdfs:comment>Week and year in which the production of the tyre type ended, once known, written as an ISO 8601 week (e.g. 2025-W52).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>production end week</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#productionStartWeek -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#productionStartWeek">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references>Regulation (EU) 2020/740, Annex III (i); EPREL fields dateStartProductionWeek and dateStartProductionYear</terms:references>
        <rdfs:comment>Week and year in which the production of the tyre type started, written as an ISO 8601 week (e.g. 2021-W10). The regulation gives two digits for the week and two digits for the year.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>production start week</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://si-digital-framework.org/SI#MeasurementUnit -->


    <owl:Class rdf:about="https://si-digital-framework.org/SI#MeasurementUnit"/>
    


    <!-- https://w3id.org/eudpp#Actor -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Actor"/>
    


    <!-- https://w3id.org/eudpp#ClassificationCode -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ClassificationCode"/>
    


    <!-- https://w3id.org/eudpp#Product -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Product"/>
    


    <!-- https://w3id.org/eudpp#ProductDimension -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductDimension"/>
    


    <!-- https://w3id.org/eudpp#ProductIdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductIdentifierScheme"/>
    


    <!-- https://w3id.org/eudpp#QuantitativeProperty -->


    <owl:Class rdf:about="https://w3id.org/eudpp#QuantitativeProperty"/>
    


    <!-- https://w3id.org/eudpp/eto#AcousticInternalStructure -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#AcousticInternalStructure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>It indicates the presence of an internal structure with specific characteristics added to a “conventional” tyre with the aim to reduce the tyre cavity noise (not necessarily external rolling noise) (TRUE/FALSE)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Acoustic Internal Structure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#AmountOfActualRepairs -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#AmountOfActualRepairs">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#numericalValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An incremental counter to record the number of repairs/patch occurred during the tyre&apos;s life - starting with zero</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Amount Of Actual Repairs</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#AspectRatio -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#AspectRatio">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#numericalValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Nominal aspect ratio: one hundred times the ratio of the nominal section height to the nominal section width of the tyre (e.g. 65 in 195/65 R 17).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Aspect Ratio</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#DateOfELTCollection -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#DateOfELTCollection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Date when the ELT has been collected by the used tyre collector.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Date Of ELT Collection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#ELTRecyclingChannelDestination -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#ELTRecyclingChannelDestination">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Recycling channel category to which the used tyre has been sent (e.g. cement, pyrolysis).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>ELT Recycling Channel Destination</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#ELTRecyclingDate -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#ELTRecyclingDate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Date when the ELT has been deconstructed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>ELT Recycling Date</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#ELTReuseStatus -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#ELTReuseStatus">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Indicates whether the ELT has been sent back to the market because partly worn out or to be sent to a retreader</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>ELT Reuse Status</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#EPRELRecordReferenceUrl -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#EPRELRecordReferenceUrl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductLabelling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740, Article 5(1) and Annex VII (product database)</terms:references>
        <rdfs:comment>URL of the record of the tyre type in the European Product Registry for Energy Labelling (EPREL).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>EPREL Record Reference Url</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#GeometricalTyreSize -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#GeometricalTyreSize">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740, Annex III (c); UN Regulation No 30</terms:references>
        <rdfs:comment>Tyre size designation as marked on the sidewall (e.g. 195/65 R 17).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Geometrical Tyre Size</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#IceGripMarking -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#IceGripMarking">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductMarking"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740, Annex III (h); EPREL field iceTyre</terms:references>
        <rdfs:comment>Indication of whether the tyre is an ice grip tyre (true or false).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Ice Grip Marking</rdfs:label>
        <skos:altLabel>Ice grip tyre</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LabelPictureUrl -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LabelPictureUrl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductLabelling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740, Annex II (tyre label)</terms:references>
        <rdfs:comment>URL of an image of the EU tyre label of the tyre.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Label Picture Url</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LabellingReferenceRegulation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LabellingReferenceRegulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductLabelling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740</terms:references>
        <rdfs:comment>Regulation under which the label classes of the tyre (fuel efficiency, wet grip, external rolling noise) are given, e.g. Regulation (EU) 2020/740.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Labelling Reference Regulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndex -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndex">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#numericalValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740, Annex III (c); UN Regulations No 30 and No 54</terms:references>
        <rdfs:comment>Load capacity index: number associated with the maximum load the tyre can carry at the speed indicated by its speed symbol.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Load Index</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndexAfterRET -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndexAfterRET">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#numericalValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Load index after Retreading</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Load Index After RET</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndexDualFitmentAfterRET -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndexDualFitmentAfterRET">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#LoadIndexAfterRET"/>
        <rdfs:comment>Load index for dual fitment after Retreading</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Load Index Dual Fitment After RET</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndexForDualFitment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndexForDualFitment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#LoadIndex"/>
        <rdfs:comment>Load capacity index of the tyre when fitted in dual (twin) configuration, as marked on commercial vehicle tyres.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Load Index For Dual Fitment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#LoadIndex"/>
        <rdfs:comment>For commercial tyres, speed adjusted load</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Load Index For Supplementary Service Condition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceConditionDualFitment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceConditionDualFitment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#LoadIndex"/>
        <rdfs:comment>For commercial tyres, speed adjusted load for dual fitment</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Load Index For Supplementary Service Condition Dual Fitment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadVersion -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadVersion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>EPREL field loadCapacityIndicator</terms:references>
        <rdfs:comment>Load version of the tyre: LL (light load), SL (standard load), XL (extra load) or HL (high load).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Load Version</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#MudAndSnow -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#MudAndSnow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductMarking"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Mud and Snow (M+S) marking</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Mud And Snow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#NoiseClass -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#NoiseClass">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductLabelling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740, Annex I and Annex III (f)</terms:references>
        <rdfs:comment>External rolling noise class of the tyre (A, B or C), as shown on the EU tyre label.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Noise Class</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#NoisePerformance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#NoisePerformance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductLabelling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#numericalValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740, Annex III (f)</terms:references>
        <rdfs:comment>External rolling noise value of the tyre, in decibels (dB), as shown on the EU tyre label.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Noise Performance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#PlaceOfELTCollection -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#PlaceOfELTCollection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Country of collection (ISO 3166-1 alpha-2) of the used tyre</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Place Of ELT Collection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#PlaceOfELTRecycling -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#PlaceOfELTRecycling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Country of deconstruction (ISO 3166-1 alpha-2) of the used tyre.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Place Of ELT Recycling</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#ProductLabelling -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#ProductLabelling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <terms:references>Regulation (EU) 2020/740, Annex II (tyre label); ETO specification document, FR2</terms:references>
        <rdfs:comment>Group of tyre properties corresponding to the EU tyre label and its registration (e.g. wet grip class, EPREL record).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Product Labelling</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#ProductMarking -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#ProductMarking">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <terms:references>ETO specification document, FR2</terms:references>
        <rdfs:comment>Group of tyre properties corresponding to markings on the tyre sidewall (e.g. M+S, 3PMSF, size prefix).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Product Marking</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#ProductSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#ProductSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment>Group of tyre properties describing its technical specification (e.g. load index, speed symbol, structure).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Product Specification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#Regrooved -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#Regrooved">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>UN Regulation No 54 (regrooving)</terms:references>
        <rdfs:comment>Indicates whether the tyre has been regrooved according to ECE R54 definition</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Regrooved</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#RegulationsComplianceCode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#RegulationsComplianceCode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>PRICAT standard</terms:references>
        <rdfs:comment>Code that indicates compliance of the tyre with specific international legal market requirements, based on the PRICAT standard.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Regulations Compliance Code</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#RegulationsComplianceMarkings -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#RegulationsComplianceMarkings">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>PRICAT standard</terms:references>
        <rdfs:comment>Code description: lists the regulations with which the tyre is compliant.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Regulations Compliance Markings</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#RemainingTreadDepth -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#RemainingTreadDepth">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasMeasurementUnit"/>
                <owl:allValuesFrom rdf:resource="https://si-digital-framework.org/SI#MeasurementUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#numericalValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>In millimeters, the remaining tread depth of the used tyre at the moment of deconstruction</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Remaining Tread Depth</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#RetreadingCycle -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#RetreadingCycle">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#numericalValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Incremental counter of the retreading operations performed during the tyre&apos;s life, starting at zero. The retreader is recorded with an eudpp:ActorRoleAssignment (eudpp:hasActor, eudpp:hasRole eudpp:remanufacturer, eudpp:inContextOfProduct).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Retreading Cycle</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#RimCode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#RimCode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasMeasurementUnit"/>
                <owl:allValuesFrom rdf:resource="https://si-digital-framework.org/SI#MeasurementUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#numericalValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rim diameter in millimeters or inches</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Rim Code</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#RollingResistanceClass -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#RollingResistanceClass">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductLabelling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740, Annex I and Annex III (d)</terms:references>
        <rdfs:comment>Fuel efficiency class of the tyre (A to E), based on its rolling resistance coefficient, as shown on the EU tyre label.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Rolling Resistance Class</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#Sealant -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#Sealant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Indicates whether the tyre is equipped with a puncture sealant</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Sealant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#SectionWidth -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#SectionWidth">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasMeasurementUnit"/>
                <owl:allValuesFrom rdf:resource="https://si-digital-framework.org/SI#MeasurementUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#numericalValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Nominal section width of the tyre in millimeters</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Section Width</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#SectionWidthCode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#SectionWidthCode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Nominal section width of the tyre defined by a code (CV tyre)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Section Width Code</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#SevereSnowMarking -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#SevereSnowMarking">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductMarking"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740, Annex III (g); UN Regulation No 117</terms:references>
        <rdfs:comment>Three-peak-mountain snowflake (3PMSF) marking: indicates a tyre for use in severe snow conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Severe Snow Marking</rdfs:label>
        <skos:altLabel>3PMSF</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#SizePrefix -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#SizePrefix">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductMarking"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>ETRTO Standards Manual, G9</terms:references>
        <rdfs:comment>Part of identification marking of the tyre (see G9 ETRTO Std Manual, T = temporary, P = Passenger for TRA std, LT = light truck (alternative to C Marking of R54)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Size Prefix</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#SizeSuffix -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#SizeSuffix">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductMarking"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>ETRTO Standards Manual, G9 to G13</terms:references>
        <rdfs:comment>Part of identification marking for light truck tyres (see G9 - G13 ETRTO Std Manual)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Size Suffix</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#SpeedSymbol -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#SpeedSymbol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references>Regulation (EU) 2020/740, Annex III (c); UN Regulations No 30 and No 54</terms:references>
