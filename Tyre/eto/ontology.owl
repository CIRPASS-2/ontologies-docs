<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/eto#"
     xml:base="https://w3id.org/eudpp/eto"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann#"
     xmlns:eudpp="https://w3id.org/eudpp#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vann2="http://purl.org/vocab/vann/"
     xmlns:eudpp1="https://w3id.org/eudpp:"
     xmlns:eudpp3="https://w3id.org/eudpp/"
     xmlns:dcterms="http://purl.org/dc/dcterms/">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/eto">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/eto/0.1"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/ACTOR"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/CONNECTOR"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/LCA"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/P_DPP"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/SOC"/>
        <terms:description>Example Tyre Ontology (ETO) is an examplar ontology for the tyre sector.</terms:description>
        <rdfs:label xml:lang="en">Example Tyre Ontology</rdfs:label>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.1</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#hasManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasManufacturer"/>
    


    <!-- https://w3id.org/eudpp/eto#hasRetreader -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/eto#hasRetreader">
        <rdfs:label>A product has a retreader (Actor from ACTOR module).</rdfs:label>
        <rdfs:label>has retreader</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#GTIN -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#GTIN"/>
    


    <!-- https://w3id.org/eudpp/eto#DOTTINFactoryCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#DOTTINFactoryCode">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>DOT TIN (Tire Identification Number) for US Market - Plant code (NHTSA Part 574)2 or 3 digits. From April 2025, only 3 digits</rdfs:comment>
        <rdfs:label>DOT TIN Factory Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#DOTTINOptionalCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#DOTTINOptionalCode">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>DOT TIN - tire optional code</rdfs:comment>
        <rdfs:label>DOT TIN Optional Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#DOTTINSizeCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#DOTTINSizeCode">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>DOT TIN - Tire size code</rdfs:comment>
        <rdfs:label>DOT TIN Size Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#DOTTINWeekYear -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#DOTTINWeekYear">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>DOT TIN (Tire Identification Number) for US Market - Production Date Week/Year (WWYY)</rdfs:comment>
        <rdfs:label>DOT TIN Week Year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#SGTIN -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#SGTIN">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#GTIN"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique Item Identifier - SGTIN-96 following Pure identity EPC URN (GS1 EPCIS) format</rdfs:comment>
        <rdfs:label>SGTIN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#commercialNameLongDescription -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#commercialNameLongDescription">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#productName"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/eto#Tyre"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Marketing text / Commercial name of the product</rdfs:comment>
        <rdfs:label>commercial name long description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#eanCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#eanCode">
        <rdfs:comment>European Article number according to GS1 standard</rdfs:comment>
        <rdfs:label>EAN Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#hasValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#hasValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#boolean"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#double"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>Property has value</rdfs:comment>
        <rdfs:label>has value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/eto#upcCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/eto#upcCode">
        <rdfs:comment>(Private) Universal Product code according to GS1 standard</rdfs:comment>
        <rdfs:label>UPC Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/eto#AcousticInternalStructure -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#AcousticInternalStructure">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment>It indicates the presence of an internal structure with specific characteristics added to a “conventional” tyre with the aim to reduce the tyre cavity noise (not necessarily external rolling noise) (TRUE/FALSE)</rdfs:comment>
        <rdfs:label>Acoustic Internal Structure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#AmountOfActualRepairs -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#AmountOfActualRepairs">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment>An incremental counter to record the number of repairs/patch occurred during the tyre&apos;s life - starting with zero</rdfs:comment>
        <rdfs:label>Amount Of Actual Repairs</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#AspectRatio -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#AspectRatio">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:comment>Aspect ratio</rdfs:comment>
        <rdfs:label>Aspect Ratio</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#BirthDate -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#BirthDate">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment>Date when the tyre is born following ISO-8601 format &quot;YYYY-MM-DD&quot;</rdfs:comment>
        <rdfs:label>Birth Date</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#CountryOfOrigin -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#CountryOfOrigin">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment>Country of origin (ISO 3166-1 alpha-3)</rdfs:comment>
        <rdfs:label>Country Of Origin</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#DateOfELTCollection -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#DateOfELTCollection">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment>Date when the ELT has been collected by the used tyre collector (DD/MM/YY)</rdfs:comment>
        <rdfs:label>Date Of ELT Collection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#ELTRecyclingChannelDestination -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#ELTRecyclingChannelDestination">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment>Country of deconstruction (ISO 3166-1 alpha-3) of the used tyre</rdfs:comment>
        <rdfs:label>ELT Recycling Channel Destination</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#ELTRecyclingDate -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#ELTRecyclingDate">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment>Date when the ELT has been deconstructed (DD/MM/YY)</rdfs:comment>
        <rdfs:label>ELT Recycling Date</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#ELTReuseStatus -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#ELTReuseStatus">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment>Indicates whether the ELT has been sent back to the market because partly worn out or to be sent to a retreader</rdfs:comment>
        <rdfs:label>ELT Reuse Status</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#EPRELRecordReferenceUrl -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#EPRELRecordReferenceUrl">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductLabelling"/>
        <rdfs:comment>URL to the EPREL record of the tire</rdfs:comment>
        <rdfs:label>EPREL Record Reference Url</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#ExtraLoad -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#ExtraLoad">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductSpecification"/>
        <rdfs:comment>Extra Load symbol - to be associated to the load index if needed.</rdfs:comment>
        <rdfs:label>Extra Load</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#GeometricalTyreSize -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#GeometricalTyreSize">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:comment>Tyre size designation</rdfs:comment>
        <rdfs:label>Geometrical Tyre Size</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#HLPC -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#HLPC">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductSpecification"/>
        <rdfs:comment>Indicates if the tire meets the UN R.30 definition of High Load (HL), values according to ETRTO standard</rdfs:comment>
        <rdfs:label>HLPC</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#HighLoad -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#HighLoad">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductSpecification"/>
        <rdfs:comment>High Load symbol - to be associated to the load index if needed.</rdfs:comment>
        <rdfs:label>High Load</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LabelPictureUrl -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LabelPictureUrl">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductLabelling"/>
        <rdfs:comment>URL to the label picture</rdfs:comment>
        <rdfs:label>Label Picture Url</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LabellingReferenceRegulation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LabellingReferenceRegulation">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductLabelling"/>
        <rdfs:comment>Regulation to which the labelling level of the tire for wet, noise and rolling resist    ance is given</rdfs:comment>
        <rdfs:label>Labelling Reference Regulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndex -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndex">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductSpecification"/>
        <rdfs:comment>Load index is a integer number refererenced by the load weight that tyre can carry.</rdfs:comment>
        <rdfs:label>Load Index</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndexAfterRET -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndexAfterRET">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductSpecification"/>
        <rdfs:comment>Load index after Retreading</rdfs:comment>
        <rdfs:label>Load Index After RET</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndexDualFitmentAfterRET -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndexDualFitmentAfterRET">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#LoadIndexAfterRET"/>
        <rdfs:comment>Load index for dual fitment after Retreading</rdfs:comment>
        <rdfs:label>Load Index Dual Fitment After RET</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndexForDualFitment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndexForDualFitment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#LoadIndex"/>
        <rdfs:comment>Load index for dual fitment</rdfs:comment>
        <rdfs:label>Load Index For Dual Fitment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#LoadIndex"/>
        <rdfs:comment>For commercial tyres, speed adjusted load</rdfs:comment>
        <rdfs:label>Load Index For Supplementary Service Condition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceConditionDualFitment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceConditionDualFitment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#LoadIndex"/>
        <rdfs:comment>For commercial tyres, speed adjusted load for dual fitment</rdfs:comment>
        <rdfs:label>Load Index For Supplementary Service Condition Dual Fitment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#MudAndSnow -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#MudAndSnow">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/eto#hasValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/eto#ProductMarking"/>
        <rdfs:comment>Mud and Snow (M+S) marking</rdfs:comment>
        <rdfs:label>Mud And Snow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/eto#NoiseClass -->


    <owl:Class rdf:about="https://w3id.org/eudpp/eto#NoiseClass">
        <owl:equivalentClass>
            <owl:Restriction>
