    <!-- https://w3id.org/eudpp/eto#C3 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/eto#C3">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ClassificationCode"/>
        <eudpp:codeValue>C3</eudpp:codeValue>
        <terms:references>Regulation (EU) 2020/740, Article 3(1); EPREL field tyreClass</terms:references>
        <rdfs:comment>Tyre class C3: tyres designed primarily for heavy-duty vehicles, such as trucks and buses. Value of eudpp:hasProductGroup for a tyre.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>C3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/eto#DOTTIN -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/eto#DOTTIN">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <eudpp:identifierExampleValue>B3 8U 005X 1020</eudpp:identifierExampleValue>
        <eudpp:identifierSchemeIssuer>U.S. Department of Transportation (NHTSA)</eudpp:identifierSchemeIssuer>
        <terms:references>49 CFR Part 574, § 574.5 (Tire identification requirements)</terms:references>
        <rdfs:comment>Tire Identification Number required on tyres for the US market: plant code (2 or 3 characters, only 3 from April 2025), tyre size code, optional manufacturer code and date code (week and year of manufacture, WWYY). Used with granularity eudpp:batch.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>DOT TIN</rdfs:label>
        <skos:altLabel>Tire Identification Number</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/eto#EPREL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/eto#EPREL">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <eudpp:identifierExampleValue>2872477</eudpp:identifierExampleValue>
        <eudpp:identifierSchemeIssuer>European Commission</eudpp:identifierSchemeIssuer>
        <terms:references>Regulation (EU) 2020/740, Article 5(1); EPREL field eprelRegistrationNumber</terms:references>
        <rdfs:comment>Scheme of the registration numbers that the European Product Registry for Energy Labelling (EPREL) gives to the product models registered by their suppliers. Used with granularity eudpp:model. The public EPREL record URL is built from the number. Local scheme: the CORE IDENT module has no EPREL scheme.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>EPREL registration number</rdfs:label>
        <skos:altLabel>European Product Registry for Energy Labelling</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/eto#SGTIN -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/eto#SGTIN">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <eudpp:identifierExampleValue>urn:epc:id:sgtin:012345.0987654.123456789</eudpp:identifierExampleValue>
        <eudpp:identifierSchemeIssuer>GS1</eudpp:identifierSchemeIssuer>
        <terms:references>GS1 EPC Tag Data Standard (SGTIN)</terms:references>
        <rdfs:comment>Serialised GTIN: a GTIN combined with a serial number, identifying one individual trade item; here in the EPC pure identity URN form (urn:epc:id:sgtin:...). Used with granularity eudpp:item. Local scheme until the CORE IDENT module provides one.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>SGTIN</rdfs:label>
        <skos:altLabel>Serialised Global Trade Item Number</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/eto#TyreTypeIdentifier -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/eto#TyreTypeIdentifier">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <eudpp:identifierExampleValue>E-PLUS01S-02</eudpp:identifierExampleValue>
        <eudpp:identifierSchemeIssuer>Tyre supplier</eudpp:identifierSchemeIssuer>
        <terms:references>Regulation (EU) 2020/740, Article 3(23); EPREL field modelIdentifier</terms:references>
        <rdfs:comment>Scheme of tyre type identifiers: codes, usually alphanumeric, which distinguish a specific tyre type from other tyre types that have the same trade name or the same trademark as that of the supplier. Used with granularity eudpp:model.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/eto"/>
        <rdfs:label>Tyre Type Identifier</rdfs:label>
    </owl:NamedIndividual>
