@prefix : <https://w3id.org/eudpp/eto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/eto#> .

<https://w3id.org/eudpp/eto> rdf:type owl:Ontology ;
                              owl:versionIRI <https://w3id.org/eudpp/eto/0.1> ;
                              owl:imports <https://w3id.org/eudpp/ACTOR> ,
                                          <https://w3id.org/eudpp/CONNECTOR> ,
                                          <https://w3id.org/eudpp/LCA> ,
                                          <https://w3id.org/eudpp/P_DPP> ,
                                          <https://w3id.org/eudpp/SOC> ;
                              <http://purl.org/dc/terms/description> "Example Tyre Ontology (ETO) is an examplar ontology for the tyre sector." ;
                              rdfs:label "Example Tyre Ontology"@en ;
                              owl:versionInfo 0.1 .

#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp#hasManufacturer
<https://w3id.org/eudpp#hasManufacturer> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp/eto#hasRetreader
:hasRetreader rdf:type owl:ObjectProperty ;
              rdfs:label "A product has a retreader (Actor from ACTOR module)." ,
                         "has retreader" .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/eudpp#GTIN
<https://w3id.org/eudpp#GTIN> rdf:type owl:DatatypeProperty .


###  https://w3id.org/eudpp/eto#DOTTINFactoryCode
:DOTTINFactoryCode rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Tyre ;
                   rdfs:range xsd:string ;
                   rdfs:comment "DOT TIN (Tire Identification Number) for US Market - Plant code (NHTSA Part 574)2 or 3 digits. From April 2025, only 3 digits" ;
                   rdfs:label "DOT TIN Factory Code" .


###  https://w3id.org/eudpp/eto#DOTTINOptionalCode
:DOTTINOptionalCode rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Tyre ;
                    rdfs:range xsd:string ;
                    rdfs:comment "DOT TIN - tire optional code" ;
                    rdfs:label "DOT TIN Optional Code" .


###  https://w3id.org/eudpp/eto#DOTTINSizeCode
:DOTTINSizeCode rdf:type owl:DatatypeProperty ;
                rdfs:domain :Tyre ;
                rdfs:range xsd:string ;
                rdfs:comment "DOT TIN - Tire size code" ;
                rdfs:label "DOT TIN Size Code" .


###  https://w3id.org/eudpp/eto#DOTTINWeekYear
:DOTTINWeekYear rdf:type owl:DatatypeProperty ;
                rdfs:domain :Tyre ;
                rdfs:range xsd:string ;
                rdfs:comment "DOT TIN (Tire Identification Number) for US Market - Production Date Week/Year (WWYY)" ;
                rdfs:label "DOT TIN Week Year" .


###  https://w3id.org/eudpp/eto#SGTIN
:SGTIN rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf <https://w3id.org/eudpp#GTIN> ;
       rdfs:domain :Tyre ;
       rdfs:range xsd:string ;
       rdfs:comment "Unique Item Identifier - SGTIN-96 following Pure identity EPC URN (GS1 EPCIS) format" ;
       rdfs:label "SGTIN" .


###  https://w3id.org/eudpp/eto#commercialNameLongDescription
:commercialNameLongDescription rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf <https://w3id.org/eudpp#productName> ;
                               rdfs:domain :Tyre ;
                               rdfs:range xsd:string ;
                               rdfs:comment "Marketing text / Commercial name of the product" ;
                               rdfs:label "commercial name long description" .


###  https://w3id.org/eudpp/eto#eanCode
:eanCode rdf:type owl:DatatypeProperty ;
         rdfs:comment "European Article number according to GS1 standard" ;
         rdfs:label "EAN Code" .


###  https://w3id.org/eudpp/eto#hasValue
:hasValue rdf:type owl:DatatypeProperty ;
          rdfs:domain <https://w3id.org/eudpp#QuantitativeProperty> ;
          rdfs:range [ rdf:type rdfs:Datatype ;
                       owl:unionOf ( xsd:boolean
                                     xsd:double
                                     xsd:integer
                                     xsd:string
                                   )
                     ] ;
          rdfs:comment "Property has value" ;
          rdfs:label "has value" .


###  https://w3id.org/eudpp/eto#upcCode
:upcCode rdf:type owl:DatatypeProperty ;
         rdfs:comment "(Private) Universal Product code according to GS1 standard" ;
         rdfs:label "UPC Code" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/eudpp/eto#AcousticInternalStructure
:AcousticInternalStructure rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasValue ;
                                                 owl:allValuesFrom xsd:string
                                               ] ;
                           rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                           rdfs:comment "It indicates the presence of an internal structure with specific characteristics added to a “conventional” tyre with the aim to reduce the tyre cavity noise (not necessarily external rolling noise) (TRUE/FALSE)" ;
                           rdfs:label "Acoustic Internal Structure" .


###  https://w3id.org/eudpp/eto#AmountOfActualRepairs
:AmountOfActualRepairs rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasValue ;
                                             owl:allValuesFrom xsd:integer
                                           ] ;
                       rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                       rdfs:comment "An incremental counter to record the number of repairs/patch occurred during the tyre's life - starting with zero" ;
                       rdfs:label "Amount Of Actual Repairs" .


###  https://w3id.org/eudpp/eto#AspectRatio
:AspectRatio rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasValue ;
                                   owl:allValuesFrom xsd:double
                                 ] ;
             rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ;
             rdfs:comment "Aspect ratio" ;
             rdfs:label "Aspect Ratio" .


###  https://w3id.org/eudpp/eto#BirthDate
:BirthDate rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasValue ;
                                 owl:allValuesFrom xsd:string
                               ] ;
           rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
           rdfs:comment "Date when the tyre is born following ISO-8601 format \"YYYY-MM-DD\"" ;
           rdfs:label "Birth Date" .


###  https://w3id.org/eudpp/eto#CountryOfOrigin
:CountryOfOrigin rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasValue ;
                                       owl:allValuesFrom xsd:string
                                     ] ;
                 rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                 rdfs:comment "Country of origin (ISO 3166-1 alpha-3)" ;
                 rdfs:label "Country Of Origin" .


###  https://w3id.org/eudpp/eto#DateOfELTCollection
:DateOfELTCollection rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasValue ;
                                           owl:allValuesFrom xsd:string
                                         ] ;
                     rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                     rdfs:comment "Date when the ELT has been collected by the used tyre collector (DD/MM/YY)" ;
                     rdfs:label "Date Of ELT Collection" .


###  https://w3id.org/eudpp/eto#ELTRecyclingChannelDestination
:ELTRecyclingChannelDestination rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty :hasValue ;
                                                      owl:allValuesFrom xsd:string
                                                    ] ;
                                rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                rdfs:comment "Country of deconstruction (ISO 3166-1 alpha-3) of the used tyre" ;
                                rdfs:label "ELT Recycling Channel Destination" .


###  https://w3id.org/eudpp/eto#ELTRecyclingDate
:ELTRecyclingDate rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasValue ;
                                        owl:allValuesFrom xsd:string
                                      ] ;
                  rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                  rdfs:comment "Date when the ELT has been deconstructed (DD/MM/YY)" ;
                  rdfs:label "ELT Recycling Date" .


###  https://w3id.org/eudpp/eto#ELTReuseStatus
:ELTReuseStatus rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasValue ;
                                      owl:allValuesFrom xsd:boolean
                                    ] ;
                rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                rdfs:comment "Indicates whether the ELT has been sent back to the market because partly worn out or to be sent to a retreader" ;
                rdfs:label "ELT Reuse Status" .


###  https://w3id.org/eudpp/eto#EPRELRecordReferenceUrl
:EPRELRecordReferenceUrl rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty :hasValue ;
                                               owl:allValuesFrom xsd:string
                                             ] ;
                         rdfs:subClassOf :ProductLabelling ;
                         rdfs:comment "URL to the EPREL record of the tire" ;
                         rdfs:label "EPREL Record Reference Url" .


###  https://w3id.org/eudpp/eto#ExtraLoad
:ExtraLoad rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasValue ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:boolean
                               ] ;
           rdfs:subClassOf :ProductSpecification ;
           rdfs:comment "Extra Load symbol - to be associated to the load index if needed." ;
           rdfs:label "Extra Load" .


###  https://w3id.org/eudpp/eto#GeometricalTyreSize
:GeometricalTyreSize rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasValue ;
                                           owl:allValuesFrom xsd:string
                                         ] ;
                     rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ;
                     rdfs:comment "Tyre size designation" ;
                     rdfs:label "Geometrical Tyre Size" .


###  https://w3id.org/eudpp/eto#HLPC
:HLPC rdf:type owl:Class ;
      owl:equivalentClass [ rdf:type owl:Restriction ;
                            owl:onProperty :hasValue ;
                            owl:allValuesFrom xsd:boolean
                          ] ;
      rdfs:subClassOf :ProductSpecification ;
      rdfs:comment "Indicates if the tire meets the UN R.30 definition of High Load (HL), values according to ETRTO standard" ;
      rdfs:label "HLPC" .


###  https://w3id.org/eudpp/eto#HighLoad
:HighLoad rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty :hasValue ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:boolean
                              ] ;
          rdfs:subClassOf :ProductSpecification ;
          rdfs:comment "High Load symbol - to be associated to the load index if needed." ;
          rdfs:label "High Load" .


###  https://w3id.org/eudpp/eto#LabelPictureUrl
:LabelPictureUrl rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasValue ;
                                       owl:allValuesFrom xsd:string
                                     ] ;
                 rdfs:subClassOf :ProductLabelling ;
                 rdfs:comment "URL to the label picture" ;
                 rdfs:label "Label Picture Url" .


###  https://w3id.org/eudpp/eto#LabellingReferenceRegulation
:LabellingReferenceRegulation rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty :hasValue ;
                                                    owl:allValuesFrom xsd:string
                                                  ] ;
                              rdfs:subClassOf :ProductLabelling ;
                              rdfs:comment "Regulation to which the labelling level of the tire for wet, noise and rolling resist    ance is given" ;
                              rdfs:label "Labelling Reference Regulation" .


###  https://w3id.org/eudpp/eto#LoadIndex
:LoadIndex rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasValue ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:integer
                               ] ;
           rdfs:subClassOf :ProductSpecification ;
           rdfs:comment "Load index is a integer number refererenced by the load weight that tyre can carry." ;
           rdfs:label "Load Index" .


###  https://w3id.org/eudpp/eto#LoadIndexAfterRET
:LoadIndexAfterRET rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasValue ;
                                         owl:allValuesFrom xsd:integer
                                       ] ;
                   rdfs:subClassOf :ProductSpecification ;
                   rdfs:comment "Load index after Retreading" ;
                   rdfs:label "Load Index After RET" .


###  https://w3id.org/eudpp/eto#LoadIndexDualFitmentAfterRET
:LoadIndexDualFitmentAfterRET rdf:type owl:Class ;
                              rdfs:subClassOf :LoadIndexAfterRET ;
                              rdfs:comment "Load index for dual fitment after Retreading" ;
                              rdfs:label "Load Index Dual Fitment After RET" .


###  https://w3id.org/eudpp/eto#LoadIndexForDualFitment
:LoadIndexForDualFitment rdf:type owl:Class ;
                         rdfs:subClassOf :LoadIndex ;
                         rdfs:comment "Load index for dual fitment" ;
                         rdfs:label "Load Index For Dual Fitment" .


###  https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceCondition
:LoadIndexForSupplementaryServiceCondition rdf:type owl:Class ;
                                           rdfs:subClassOf :LoadIndex ;
                                           rdfs:comment "For commercial tyres, speed adjusted load" ;
                                           rdfs:label "Load Index For Supplementary Service Condition" .


###  https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceConditionDualFitment
:LoadIndexForSupplementaryServiceConditionDualFitment rdf:type owl:Class ;
                                                      rdfs:subClassOf :LoadIndex ;
                                                      rdfs:comment "For commercial tyres, speed adjusted load for dual fitment" ;
                                                      rdfs:label "Load Index For Supplementary Service Condition Dual Fitment" .


###  https://w3id.org/eudpp/eto#MudAndSnow
:MudAndSnow rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasValue ;
                                  owl:allValuesFrom xsd:boolean
                                ] ;
            rdfs:subClassOf :ProductMarking ;
            rdfs:comment "Mud and Snow (M+S) marking" ;
            rdfs:label "Mud And Snow" .


###  https://w3id.org/eudpp/eto#NoiseClass
:NoiseClass rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasValue ;
                                  owl:allValuesFrom xsd:string
                                ] ;
            rdfs:subClassOf :ProductLabelling ;
            rdfs:comment "Labelling noise class" ;
            rdfs:label "Noise Class" .


###  https://w3id.org/eudpp/eto#NoisePerformance
:NoisePerformance rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasValue ;
                                        owl:allValuesFrom xsd:integer
                                      ] ;
                  rdfs:subClassOf :ProductLabelling ;
                  rdfs:comment "Labelling noise performance" ;
                  rdfs:label "Noise Performance" .


###  https://w3id.org/eudpp/eto#PlaceOfELTCollection
:PlaceOfELTCollection rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasValue ;
                                            owl:allValuesFrom xsd:string
                                          ] ;
                      rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                      rdfs:comment "Country of collection (ISO 3166-1 alpha-3) of the used tyre" ;
                      rdfs:label "Place Of ELT Collection" .


###  https://w3id.org/eudpp/eto#PlaceOfELTRecycling
:PlaceOfELTRecycling rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasValue ;
                                           owl:allValuesFrom xsd:string
                                         ] ;
                     rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                     rdfs:comment "Indicates to which recycling channel category the used tyre has been sent (Cement , Pyrolisis, etc.)" ;
                     rdfs:label "Place Of ELT Recycling" .


###  https://w3id.org/eudpp/eto#ProductLabelling
:ProductLabelling rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                  rdfs:comment "Labelling-related property" ;
                  rdfs:label "Product Labelling" .


###  https://w3id.org/eudpp/eto#ProductMarking
:ProductMarking rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                rdfs:comment "Marking-related property" ;
                rdfs:label "Product Marking" .


###  https://w3id.org/eudpp/eto#ProductSpecification
:ProductSpecification rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                      rdfs:comment "Specification-related property" ;
                      rdfs:label "Product Specification" .


###  https://w3id.org/eudpp/eto#Regrooved
:Regrooved rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasValue ;
                                 owl:allValuesFrom xsd:boolean
                               ] ;
           rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
           rdfs:comment "Indicates whether the tyre has been regrooved according to ECE R54 definition" ;
           rdfs:label "Regrooved" .


###  https://w3id.org/eudpp/eto#RegulationsComplianceCode
:RegulationsComplianceCode rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasValue ;
                                                 owl:allValuesFrom xsd:integer
                                               ] ;
                           rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                           rdfs:comment "Code that indicates compliance of tire to specific international legal market requirement based on PRICAT standard" ;
                           rdfs:label "Regulations Compliance Code" .


###  https://w3id.org/eudpp/eto#RegulationsComplianceMarkings
:RegulationsComplianceMarkings rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty :hasValue ;
                                                     owl:allValuesFrom xsd:string
                                                   ] ;
                               rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                               rdfs:comment "Code description : lists the regulations to which the tire is compliant." ;
                               rdfs:label "Regulations Compliance Markings" .


###  https://w3id.org/eudpp/eto#RemainingTreadDepth
:RemainingTreadDepth rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty <https://w3id.org/eudpp#hasMeasurementUnit> ;
                                           owl:allValuesFrom <https://si-digital-framework.org/SI#MeasurementUnit>
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasValue ;
                                           owl:allValuesFrom xsd:double
                                         ] ;
                     rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                     rdfs:comment "In millimeters, the remaining tread depth of the used tyre at the moment of deconstruction" ;
                     rdfs:label "Remaining Tread Depth" .


###  https://w3id.org/eudpp/eto#RetreadingCycle
:RetreadingCycle rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasValue ;
                                       owl:allValuesFrom xsd:integer
                                     ] ;
                 rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                 rdfs:label "An incremental counter to record the number of retreading operations occurred during the tyre's life - starting with zero" ,
                            "Retreading Cycle" .


###  https://w3id.org/eudpp/eto#RimCode
:RimCode rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Restriction ;
                               owl:onProperty <https://w3id.org/eudpp#hasMeasurementUnit> ;
                               owl:allValuesFrom <https://si-digital-framework.org/SI#MeasurementUnit>
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasValue ;
                               owl:allValuesFrom xsd:double
                             ] ;
         rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ;
         rdfs:comment "Rim diameter in millimeters or inches" ;
         rdfs:label "Rim Code" .


###  https://w3id.org/eudpp/eto#RollingResistanceClass
:RollingResistanceClass rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasValue ;
                                              owl:allValuesFrom xsd:string
                                            ] ;
                        rdfs:subClassOf :ProductLabelling ;
                        rdfs:comment "Labelling rolling resistance class" ;
                        rdfs:label "Rolling Resistance Class" .


###  https://w3id.org/eudpp/eto#SVHCPresence
:SVHCPresence rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasValue ;
                                    owl:allValuesFrom xsd:string
                                  ] ;
              rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
              rdfs:comment "SVHC designation (ECHA std) and presence % in weight of the article - EU REACH regulation" ;
              rdfs:label "SVHC Presence" .


###  https://w3id.org/eudpp/eto#Sealant
:Sealant rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Restriction ;
                               owl:onProperty :hasValue ;
                               owl:allValuesFrom xsd:boolean
                             ] ;
         rdfs:subClassOf :ProductSpecification ;
         rdfs:comment "Indicates whether the tyre is equipped with a puncture sealant" ;
         rdfs:label "Sealant" .


###  https://w3id.org/eudpp/eto#SectionWidth
:SectionWidth rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty <https://w3id.org/eudpp#hasMeasurementUnit> ;
                                    owl:allValuesFrom <https://si-digital-framework.org/SI#MeasurementUnit>
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasValue ;
                                    owl:allValuesFrom xsd:double
                                  ] ;
              rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ;
              rdfs:comment "Nominal section width of the tyre in millimeters" ;
              rdfs:label "Section Width" .


###  https://w3id.org/eudpp/eto#SectionWidthCode
:SectionWidthCode rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasValue ;
                                        owl:allValuesFrom xsd:string
                                      ] ;
                  rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ;
                  rdfs:comment "Nominal section width of the tyre defined by a code (CV tyre)" ;
                  rdfs:label "Section Width Code" .


###  https://w3id.org/eudpp/eto#SizePrefix
:SizePrefix rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasValue ;
                                  owl:allValuesFrom xsd:string
                                ] ;
            rdfs:subClassOf :ProductMarking ;
            rdfs:comment "Part of identification marking of the tyre (see G9 ETRTO Std Manual, T = temporary, P = Passenger for TRA std, LT = light truck (alternative to C Marking of R54)" ;
            rdfs:label "Size Prefix" .


###  https://w3id.org/eudpp/eto#SizeSuffix
:SizeSuffix rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasValue ;
                                  owl:allValuesFrom xsd:string
                                ] ;
            rdfs:subClassOf :ProductMarking ;
            rdfs:comment "Part of identification marking for light truck tyres (see G9 - G13 ETRTO Std Manual)" ;
            rdfs:label "Size Suffix" .


###  https://w3id.org/eudpp/eto#SpeedSymbol
:SpeedSymbol rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasValue ;
                                   owl:allValuesFrom xsd:string
                                 ] ;
             rdfs:subClassOf :ProductSpecification ;
             rdfs:comment "Speed symbol" ;
             rdfs:label "Speed Symbol" .


###  https://w3id.org/eudpp/eto#SpeedSymbolAfterRET
:SpeedSymbolAfterRET rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasValue ;
                                           owl:allValuesFrom xsd:string
                                         ] ;
                     rdfs:subClassOf :ProductSpecification ;
