@prefix : <https://w3id.org/eudpp/eto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/eto#> .

<https://w3id.org/eudpp/eto> rdf:type owl:Ontology ;
                              owl:versionIRI <https://w3id.org/eudpp/eto/0.2.0> ;
                              <http://purl.org/dc/terms/created> "2026-04-30"^^xsd:date ;
                              <http://purl.org/dc/terms/creator> "Nader Jelassi"@en ,
                                                                 "Quang-Duy Nguyen"@en ;
                              <http://purl.org/dc/terms/description> "Example Tyre Ontology (ETO) is an exemplar ontology for the tyre sector. It specialises the EU DPP Core Ontology (CORE), whose terms it references by their IRIs."@en ;
                              <http://purl.org/dc/terms/issued> "2026-04-30"^^xsd:date ;
                              <http://purl.org/dc/terms/license> <https://www.apache.org/licenses/LICENSE-2.0> ;
                              <http://purl.org/dc/terms/modified> "2026-10-22"^^xsd:date ;
                              <http://purl.org/dc/terms/title> "Example Tyre Ontology (ETO)"@en ;
                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "eto" ;
                              <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/eto#" ;
                              rdfs:comment "Developed against the CIRPASS-2 CORE ontology as of 12 October 2026: core v2.0.7, P_DPP v2.1.0, IDENT v1.2.0, CON v2.2.0, ACTOR v2.1.3, EVENT v1.0.0, SOC v2.0.0. Checked against the CORE of 21 October 2026: core v2.1.0, P_DPP v2.2.0, IDENT v1.2.0, CON v2.4.0, ACTOR v2.2.0, EVENT v1.0.0, SOC v2.2.0. The CORE is referenced by IRI, without owl:imports: load the CORE files together with this file for reasoning or validation. Terms without dcterms:references were created for this ontology, most of them from non-public data of the CIRPASS-2 tyre pilot."@en ;
                              rdfs:label "Example Tyre Ontology"@en ;
                              owl:versionInfo "Version 0.2.0 DRAFT"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/references
<http://purl.org/dc/terms/references> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp#hasManufacturer
<https://w3id.org/eudpp#hasManufacturer> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp#hasMeasurementUnit
<https://w3id.org/eudpp#hasMeasurementUnit> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/eudpp#codeValue
<https://w3id.org/eudpp#codeValue> rdf:type owl:DatatypeProperty .


###  https://w3id.org/eudpp#description
<https://w3id.org/eudpp#description> rdf:type owl:DatatypeProperty .


###  https://w3id.org/eudpp#identifierExampleValue
<https://w3id.org/eudpp#identifierExampleValue> rdf:type owl:DatatypeProperty .


###  https://w3id.org/eudpp#identifierSchemeIssuer
<https://w3id.org/eudpp#identifierSchemeIssuer> rdf:type owl:DatatypeProperty .


###  https://w3id.org/eudpp#manufacturingDate
<https://w3id.org/eudpp#manufacturingDate> rdf:type owl:DatatypeProperty .


###  https://w3id.org/eudpp#numericalValue
<https://w3id.org/eudpp#numericalValue> rdf:type owl:DatatypeProperty .


###  https://w3id.org/eudpp/eto#availableInAllEUEEACountries
:availableInAllEUEEACountries rdf:type owl:DatatypeProperty ;
                              rdfs:domain :Tyre ;
                              rdfs:range xsd:boolean ;
                              <http://purl.org/dc/terms/references> "EPREL field availabilityInEUEEACountries" ;
                              rdfs:comment "Whether the tyre type is available in all EU and EEA countries. If not, eto:availableInCountry gives the countries where it is available." ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                              rdfs:label "available in all EU/EEA countries" .


###  https://w3id.org/eudpp/eto#availableInCountry
:availableInCountry rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Tyre ;
                    rdfs:range xsd:string ;
                    <http://purl.org/dc/terms/references> "EPREL fields modelAvailabilityInEUEEACountries and modelAvailabilityInOtherCountries" ;
                    rdfs:comment "Two-letter code of a country where the tyre type is available, as in EPREL: ISO 3166-1 alpha-2, except EL for Greece and XI for Northern Ireland. One value per country." ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                    rdfs:label "available in country" .


###  https://w3id.org/eudpp/eto#commercialNameLongDescription
:commercialNameLongDescription rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf <https://w3id.org/eudpp#description> ;
                               rdfs:domain :Tyre ;
                               rdfs:range xsd:string ;
                               rdfs:comment "Long commercial description of the tyre, combining its size, service description and commercial name (e.g. 195/65 R 17 87H Dakota Spring)." ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                               rdfs:label "commercial name long description" .


###  https://w3id.org/eudpp/eto#hasValue
:hasValue rdf:type owl:DatatypeProperty ;
          rdfs:domain <https://w3id.org/eudpp#QuantitativeProperty> ;
          rdfs:range [ rdf:type rdfs:Datatype ;
                       owl:unionOf ( xsd:boolean
                                     xsd:date
                                     xsd:integer
                                     xsd:string
                                   )
                     ] ;
          <http://purl.org/dc/terms/references> "ETO specification document, coverage table (Step 2.4)" ;
          rdfs:comment "Value of a tyre property that is not a quantity: text, code, Boolean flag or date. Quantities use eudpp:numericalValue." ;
          rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
          rdfs:label "has value" .


###  https://w3id.org/eudpp/eto#onMarketEndDate
:onMarketEndDate rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Tyre ;
                 rdfs:range xsd:date ;
                 <http://purl.org/dc/terms/references> "EPREL field onMarketEndDate" ;
                 rdfs:comment "Date from which the supplier no longer places the tyre type on the Union market. The first placing on the market is recorded with a eudpp:PlacingOnMarketEvent." ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                 rdfs:label "on-market end date" .


###  https://w3id.org/eudpp/eto#productionEndWeek
:productionEndWeek rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Tyre ;
                   rdfs:range xsd:string ;
                   <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Annex III (j); EPREL fields dateEndProductionWeek and dateEndProductionYear" ;
                   rdfs:comment "Week and year in which the production of the tyre type ended, once known, written as an ISO 8601 week (e.g. 2025-W52)." ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                   rdfs:label "production end week" .


###  https://w3id.org/eudpp/eto#productionStartWeek
:productionStartWeek rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Tyre ;
                     rdfs:range xsd:string ;
                     <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Annex III (i); EPREL fields dateStartProductionWeek and dateStartProductionYear" ;
                     rdfs:comment "Week and year in which the production of the tyre type started, written as an ISO 8601 week (e.g. 2021-W10). The regulation gives two digits for the week and two digits for the year." ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                     rdfs:label "production start week" .


#################################################################
#    Classes
#################################################################

###  https://si-digital-framework.org/SI#MeasurementUnit
<https://si-digital-framework.org/SI#MeasurementUnit> rdf:type owl:Class .


###  https://w3id.org/eudpp#Actor
<https://w3id.org/eudpp#Actor> rdf:type owl:Class .


###  https://w3id.org/eudpp#ClassificationCode
<https://w3id.org/eudpp#ClassificationCode> rdf:type owl:Class .


###  https://w3id.org/eudpp#Product
<https://w3id.org/eudpp#Product> rdf:type owl:Class .


###  https://w3id.org/eudpp#ProductDimension
<https://w3id.org/eudpp#ProductDimension> rdf:type owl:Class .


###  https://w3id.org/eudpp#ProductIdentifierScheme
<https://w3id.org/eudpp#ProductIdentifierScheme> rdf:type owl:Class .


###  https://w3id.org/eudpp#QuantitativeProperty
<https://w3id.org/eudpp#QuantitativeProperty> rdf:type owl:Class .


###  https://w3id.org/eudpp/eto#AcousticInternalStructure
:AcousticInternalStructure rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasValue ;
                                             owl:allValuesFrom xsd:boolean
                                           ] ;
                           rdfs:comment "It indicates the presence of an internal structure with specific characteristics added to a “conventional” tyre with the aim to reduce the tyre cavity noise (not necessarily external rolling noise) (TRUE/FALSE)" ;
                           rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                           rdfs:label "Acoustic Internal Structure" .


###  https://w3id.org/eudpp/eto#AmountOfActualRepairs
:AmountOfActualRepairs rdf:type owl:Class ;
                       rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <https://w3id.org/eudpp#numericalValue> ;
                                         owl:allValuesFrom xsd:integer
                                       ] ;
                       rdfs:comment "An incremental counter to record the number of repairs/patch occurred during the tyre's life - starting with zero" ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                       rdfs:label "Amount Of Actual Repairs" .


###  https://w3id.org/eudpp/eto#AspectRatio
:AspectRatio rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <https://w3id.org/eudpp#numericalValue> ;
                               owl:allValuesFrom xsd:decimal
                             ] ;
             rdfs:comment "Nominal aspect ratio: one hundred times the ratio of the nominal section height to the nominal section width of the tyre (e.g. 65 in 195/65 R 17)." ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
             rdfs:label "Aspect Ratio" .


###  https://w3id.org/eudpp/eto#DateOfELTCollection
:DateOfELTCollection rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasValue ;
                                       owl:allValuesFrom xsd:date
                                     ] ;
                     rdfs:comment "Date when the ELT has been collected by the used tyre collector." ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                     rdfs:label "Date Of ELT Collection" .


###  https://w3id.org/eudpp/eto#ELTRecyclingChannelDestination
:ELTRecyclingChannelDestination rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :hasValue ;
                                                  owl:allValuesFrom xsd:string
                                                ] ;
                                rdfs:comment "Recycling channel category to which the used tyre has been sent (e.g. cement, pyrolysis)." ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                                rdfs:label "ELT Recycling Channel Destination" .


###  https://w3id.org/eudpp/eto#ELTRecyclingDate
:ELTRecyclingDate rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasValue ;
                                    owl:allValuesFrom xsd:date
                                  ] ;
                  rdfs:comment "Date when the ELT has been deconstructed." ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                  rdfs:label "ELT Recycling Date" .


###  https://w3id.org/eudpp/eto#ELTReuseStatus
:ELTReuseStatus rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasValue ;
                                  owl:allValuesFrom xsd:boolean
                                ] ;
                rdfs:comment "Indicates whether the ELT has been sent back to the market because partly worn out or to be sent to a retreader" ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                rdfs:label "ELT Reuse Status" .


###  https://w3id.org/eudpp/eto#EPRELRecordReferenceUrl
:EPRELRecordReferenceUrl rdf:type owl:Class ;
                         rdfs:subClassOf :ProductLabelling ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasValue ;
                                           owl:allValuesFrom xsd:string
                                         ] ;
                         <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Article 5(1) and Annex VII (product database)" ;
                         rdfs:comment "URL of the record of the tyre type in the European Product Registry for Energy Labelling (EPREL)." ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                         rdfs:label "EPREL Record Reference Url" .


###  https://w3id.org/eudpp/eto#GeometricalTyreSize
:GeometricalTyreSize rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasValue ;
                                       owl:allValuesFrom xsd:string
                                     ] ;
                     <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Annex III (c); UN Regulation No 30" ;
                     rdfs:comment "Tyre size designation as marked on the sidewall (e.g. 195/65 R 17)." ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                     rdfs:label "Geometrical Tyre Size" .


###  https://w3id.org/eudpp/eto#IceGripMarking
:IceGripMarking rdf:type owl:Class ;
                rdfs:subClassOf :ProductMarking ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasValue ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:boolean
                                ] ;
                <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Annex III (h); EPREL field iceTyre" ;
                rdfs:comment "Indication of whether the tyre is an ice grip tyre (true or false)." ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                rdfs:label "Ice Grip Marking" ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "Ice grip tyre" .


###  https://w3id.org/eudpp/eto#LabelPictureUrl
:LabelPictureUrl rdf:type owl:Class ;
                 rdfs:subClassOf :ProductLabelling ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasValue ;
                                   owl:allValuesFrom xsd:string
                                 ] ;
                 <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Annex II (tyre label)" ;
                 rdfs:comment "URL of an image of the EU tyre label of the tyre." ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                 rdfs:label "Label Picture Url" .


###  https://w3id.org/eudpp/eto#LabellingReferenceRegulation
:LabellingReferenceRegulation rdf:type owl:Class ;
                              rdfs:subClassOf :ProductLabelling ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty :hasValue ;
                                                owl:allValuesFrom xsd:string
                                              ] ;
                              <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740" ;
                              rdfs:comment "Regulation under which the label classes of the tyre (fuel efficiency, wet grip, external rolling noise) are given, e.g. Regulation (EU) 2020/740." ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                              rdfs:label "Labelling Reference Regulation" .


###  https://w3id.org/eudpp/eto#LoadIndex
:LoadIndex rdf:type owl:Class ;
           rdfs:subClassOf :ProductSpecification ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty <https://w3id.org/eudpp#numericalValue> ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:integer
                           ] ;
           <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Annex III (c); UN Regulations No 30 and No 54" ;
           rdfs:comment "Load capacity index: number associated with the maximum load the tyre can carry at the speed indicated by its speed symbol." ;
           rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
           rdfs:label "Load Index" .


###  https://w3id.org/eudpp/eto#LoadIndexAfterRET
:LoadIndexAfterRET rdf:type owl:Class ;
                   rdfs:subClassOf :ProductSpecification ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <https://w3id.org/eudpp#numericalValue> ;
                                     owl:allValuesFrom xsd:integer
                                   ] ;
                   rdfs:comment "Load index after Retreading" ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                   rdfs:label "Load Index After RET" .


###  https://w3id.org/eudpp/eto#LoadIndexDualFitmentAfterRET
:LoadIndexDualFitmentAfterRET rdf:type owl:Class ;
                              rdfs:subClassOf :LoadIndexAfterRET ;
                              rdfs:comment "Load index for dual fitment after Retreading" ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                              rdfs:label "Load Index Dual Fitment After RET" .


###  https://w3id.org/eudpp/eto#LoadIndexForDualFitment
:LoadIndexForDualFitment rdf:type owl:Class ;
                         rdfs:subClassOf :LoadIndex ;
                         rdfs:comment "Load capacity index of the tyre when fitted in dual (twin) configuration, as marked on commercial vehicle tyres." ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                         rdfs:label "Load Index For Dual Fitment" .


###  https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceCondition
:LoadIndexForSupplementaryServiceCondition rdf:type owl:Class ;
                                           rdfs:subClassOf :LoadIndex ;
                                           rdfs:comment "For commercial tyres, speed adjusted load" ;
                                           rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                                           rdfs:label "Load Index For Supplementary Service Condition" .


###  https://w3id.org/eudpp/eto#LoadIndexForSupplementaryServiceConditionDualFitment
:LoadIndexForSupplementaryServiceConditionDualFitment rdf:type owl:Class ;
                                                      rdfs:subClassOf :LoadIndex ;
                                                      rdfs:comment "For commercial tyres, speed adjusted load for dual fitment" ;
                                                      rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                                                      rdfs:label "Load Index For Supplementary Service Condition Dual Fitment" .


###  https://w3id.org/eudpp/eto#LoadVersion
:LoadVersion rdf:type owl:Class ;
             rdfs:subClassOf :ProductSpecification ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasValue ;
                               owl:allValuesFrom xsd:string
                             ] ;
             <http://purl.org/dc/terms/references> "EPREL field loadCapacityIndicator" ;
             rdfs:comment "Load version of the tyre: LL (light load), SL (standard load), XL (extra load) or HL (high load)." ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
             rdfs:label "Load Version" .


###  https://w3id.org/eudpp/eto#MudAndSnow
:MudAndSnow rdf:type owl:Class ;
            rdfs:subClassOf :ProductMarking ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasValue ;
                              owl:allValuesFrom xsd:boolean
                            ] ;
            rdfs:comment "Mud and Snow (M+S) marking" ;
            rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
            rdfs:label "Mud And Snow" .


###  https://w3id.org/eudpp/eto#NoiseClass
:NoiseClass rdf:type owl:Class ;
            rdfs:subClassOf :ProductLabelling ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasValue ;
                              owl:allValuesFrom xsd:string
                            ] ;
            <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Annex I and Annex III (f)" ;
            rdfs:comment "External rolling noise class of the tyre (A, B or C), as shown on the EU tyre label." ;
            rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
            rdfs:label "Noise Class" .


###  https://w3id.org/eudpp/eto#NoisePerformance
:NoisePerformance rdf:type owl:Class ;
                  rdfs:subClassOf :ProductLabelling ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty <https://w3id.org/eudpp#numericalValue> ;
                                    owl:allValuesFrom xsd:integer
                                  ] ;
                  <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Annex III (f)" ;
                  rdfs:comment "External rolling noise value of the tyre, in decibels (dB), as shown on the EU tyre label." ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                  rdfs:label "Noise Performance" .


###  https://w3id.org/eudpp/eto#PlaceOfELTCollection
:PlaceOfELTCollection rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasValue ;
                                        owl:allValuesFrom xsd:string
                                      ] ;
                      rdfs:comment "Country of collection (ISO 3166-1 alpha-2) of the used tyre" ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                      rdfs:label "Place Of ELT Collection" .


###  https://w3id.org/eudpp/eto#PlaceOfELTRecycling
:PlaceOfELTRecycling rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasValue ;
                                       owl:allValuesFrom xsd:string
                                     ] ;
                     rdfs:comment "Country of deconstruction (ISO 3166-1 alpha-2) of the used tyre." ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                     rdfs:label "Place Of ELT Recycling" .


###  https://w3id.org/eudpp/eto#ProductLabelling
:ProductLabelling rdf:type owl:Class ;
