###  https://w3id.org/eudpp/eto#DOTTIN
:DOTTIN rdf:type owl:NamedIndividual ,
                 <https://w3id.org/eudpp#ProductIdentifierScheme> ;
        <https://w3id.org/eudpp#identifierExampleValue> "B3 8U 005X 1020" ;
        <https://w3id.org/eudpp#identifierSchemeIssuer> "U.S. Department of Transportation (NHTSA)" ;
        <http://purl.org/dc/terms/references> "49 CFR Part 574, § 574.5 (Tire identification requirements)" ;
        rdfs:comment "Tire Identification Number required on tyres for the US market: plant code (2 or 3 characters, only 3 from April 2025), tyre size code, optional manufacturer code and date code (week and year of manufacture, WWYY). Used with granularity eudpp:batch." ;
        rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
        rdfs:label "DOT TIN" ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "Tire Identification Number" .


###  https://w3id.org/eudpp/eto#EPREL
:EPREL rdf:type owl:NamedIndividual ,
                <https://w3id.org/eudpp#ProductIdentifierScheme> ;
       <https://w3id.org/eudpp#identifierExampleValue> "2872477" ;
       <https://w3id.org/eudpp#identifierSchemeIssuer> "European Commission" ;
       <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Article 5(1); EPREL field eprelRegistrationNumber" ;
       rdfs:comment "Scheme of the registration numbers that the European Product Registry for Energy Labelling (EPREL) gives to the product models registered by their suppliers. Used with granularity eudpp:model. The public EPREL record URL is built from the number. Local scheme: the CORE IDENT module has no EPREL scheme." ;
       rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
       rdfs:label "EPREL registration number" ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "European Product Registry for Energy Labelling" .


###  https://w3id.org/eudpp/eto#SGTIN
:SGTIN rdf:type owl:NamedIndividual ,
                <https://w3id.org/eudpp#ProductIdentifierScheme> ;
       <https://w3id.org/eudpp#identifierExampleValue> "urn:epc:id:sgtin:012345.0987654.123456789" ;
       <https://w3id.org/eudpp#identifierSchemeIssuer> "GS1" ;
       <http://purl.org/dc/terms/references> "GS1 EPC Tag Data Standard (SGTIN)" ;
       rdfs:comment "Serialised GTIN: a GTIN combined with a serial number, identifying one individual trade item; here in the EPC pure identity URN form (urn:epc:id:sgtin:...). Used with granularity eudpp:item. Local scheme until the CORE IDENT module provides one." ;
       rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
       rdfs:label "SGTIN" ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "Serialised Global Trade Item Number" .


###  https://w3id.org/eudpp/eto#TyreTypeIdentifier
:TyreTypeIdentifier rdf:type owl:NamedIndividual ,
                             <https://w3id.org/eudpp#ProductIdentifierScheme> ;
                    <https://w3id.org/eudpp#identifierExampleValue> "E-PLUS01S-02" ;
                    <https://w3id.org/eudpp#identifierSchemeIssuer> "Tyre supplier" ;
                    <http://purl.org/dc/terms/references> "Regulation (EU) 2020/740, Article 3(23); EPREL field modelIdentifier" ;
                    rdfs:comment "Scheme of tyre type identifiers: codes, usually alphanumeric, which distinguish a specific tyre type from other tyre types that have the same trade name or the same trademark as that of the supplier. Used with granularity eudpp:model." ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/eto> ;
                    rdfs:label "Tyre Type Identifier" .


