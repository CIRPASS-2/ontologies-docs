}, {
  "@id" : "https://w3id.org/eudpp/eto#EPREL",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@value" : "Regulation (EU) 2020/740, Article 5(1); EPREL field eprelRegistrationNumber"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#ProductIdentifierScheme"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Scheme of the registration numbers that the European Product Registry for Energy Labelling (EPREL) gives to the product models registered by their suppliers. Used with granularity eudpp:model. The public EPREL record URL is built from the number. Local scheme: the CORE IDENT module has no EPREL scheme."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/eto"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "EPREL registration number"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "European Product Registry for Energy Labelling"
  } ],
  "https://w3id.org/eudpp#identifierExampleValue" : [ {
    "@value" : "2872477"
  } ],
  "https://w3id.org/eudpp#identifierSchemeIssuer" : [ {
    "@value" : "European Commission"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/eto#EPRELRecordReferenceUrl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@value" : "Regulation (EU) 2020/740, Article 5(1) and Annex VII (product database)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "URL of the record of the tyre type in the European Product Registry for Energy Labelling (EPREL)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/eto"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "EPREL Record Reference Url"
  } ],
