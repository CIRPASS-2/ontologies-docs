  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Indicates whether the ELT has been sent back to the market because partly worn out or to be sent to a retreader"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/eto"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
