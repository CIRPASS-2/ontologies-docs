}, {
  "@id" : "https://w3id.org/eudpp/eto#DOTTIN",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@value" : "49 CFR Part 574, § 574.5 (Tire identification requirements)"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#ProductIdentifierScheme"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Tire Identification Number required on tyres for the US market: plant code (2 or 3 characters, only 3 from April 2025), tyre size code, optional manufacturer code and date code (week and year of manufacture, WWYY). Used with granularity eudpp:batch."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/eto"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "DOT TIN"
  } ],
