@prefix : <https://w3id.org/eudpp/EVENT#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/EVENT#> .

<https://w3id.org/eudpp/EVENT> rdf:type owl:Ontology ;
                                <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Core Ontology Event Module. Draft version 0.1.0. DOI: https://doi.org/10.5281/zenodo.15270342/"@en ;
                                <http://purl.org/dc/terms/contributor> "Riina Maigre"@en ,
                                                                       "Tarmo Robal"@en ,
                                                                       "Theodor Chirvasuta"@en ;
                                <http://purl.org/dc/terms/created> "2026-03-06"^^xsd:date ;
                                <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                <http://purl.org/dc/terms/description> "Provides classes and properties for representing ESPR-level product and DPP events, and links product-facing events to selected GS1 EPCIS and CBV technical representation terms. Cross-module EU DPP Core Ontology relations are intended to be managed in the Connector/mapping layer."@en ;
                                <http://purl.org/dc/terms/issued> "2026-03-06"^^xsd:date ;
                                <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                <http://purl.org/dc/terms/title> "EU DPP Core Ontology Event Module"@en ;
                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "evt" ;
                                <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp#" ;
                                rdfs:comment "Draft Event module of the EU DPP Core Ontology. It defines ESPR-level product and DPP event concepts. Selected GS1 EPCIS and CBV terms are referenced in this file for technical event representation only; this does not imply a global owl:imports of EPCIS/CBV nor logical subclassing between GS1 Web Vocabulary concepts and EU DPP Core Ontology classes. Cross-module EU DPP Core Ontology relations are intended to be managed in the Connector/mapping layer."@en ;
                                rdfs:label "Event module"@en ;
                                owl:versionInfo "Version 0.1.0 DRAFT"@en .

