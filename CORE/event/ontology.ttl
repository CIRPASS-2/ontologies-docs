#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://ref.gs1.org/epcis/bizLocation
<https://ref.gs1.org/epcis/bizLocation> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                        <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                        rdfs:comment "(Optional) The business location where the objects associated with the EPCs may be found, until contradicted by a subsequent event."@en ;
                                        rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                        rdfs:label "bizLocation" ;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/bizStep
<https://ref.gs1.org/epcis/bizStep> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                    rdfs:range <https://ref.gs1.org/cbv/BizStep> ;
                                    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                    <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/BizStep> ;
                                    rdfs:comment "(Optional) The business step of which this event was a part."@en ;
                                    rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                    rdfs:label "bizStep" ;
                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/bizTransactionList
<https://ref.gs1.org/epcis/bizTransactionList> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                               rdfs:range <https://ref.gs1.org/epcis/BizTransaction> ;
                                               <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                               <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/BizTransaction> ;
                                               rdfs:comment "(Optional) An unordered list of business transactions that define the context of this event."@en ;
                                               rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                               rdfs:label "bizTransactionList" ;
                                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/bizTransactionType
<https://ref.gs1.org/epcis/bizTransactionType> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://ref.gs1.org/epcis/BizTransaction> ;
                                               rdfs:range <https://ref.gs1.org/cbv/BTT> ;
                                               <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/BizTransaction> ;
                                               <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/BTT> ;
                                               rdfs:comment "An identifier that indicates the type of BizTransaction document (e.g. Purchase Order, Despatch Advice)."@en ;
                                               rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                               rdfs:label "bizTransactionType" ;
                                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                               <https://ref.gs1.org/epcis/jsonldLabel> "type" .


###  https://ref.gs1.org/epcis/childEPCs
<https://ref.gs1.org/epcis/childEPCs> rdf:type owl:ObjectProperty ;
                                      rdfs:domain [ rdf:type owl:Class ;
                                                    owl:unionOf ( <https://ref.gs1.org/epcis/AggregationEvent>
                                                                  <https://ref.gs1.org/epcis/AssociationEvent>
                                                                )
                                                  ] ;
                                      <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent> ,
                                                                         <https://ref.gs1.org/epcis/AssociationEvent> ;
                                      rdfs:comment "(Optional) An unordered list of the EPCs of contained objects identified by instance-level identifiers. An AggregationEvent SHALL contain either a nonempty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent.  An AssociationEvent SHALL contain either a non-empty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disassociated from the parent."@en ;
                                      rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                      rdfs:label "childEPCs" ;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/childQuantityList
<https://ref.gs1.org/epcis/childQuantityList> rdf:type owl:ObjectProperty ;
                                              rdfs:domain [ rdf:type owl:Class ;
                                                            owl:unionOf ( <https://ref.gs1.org/epcis/AggregationEvent>
                                                                          <https://ref.gs1.org/epcis/AssociationEvent>
                                                                        )
                                                          ] ;
                                              rdfs:range <https://ref.gs1.org/epcis/QuantityElement> ;
                                              <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent> ,
                                                                                 <https://ref.gs1.org/epcis/AssociationEvent> ;
                                              <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                              rdfs:comment "(Optional) An unordered list of one or more QuantityElements identifying (at the class level) contained objects. An AggregationEvent SHALL contain either a nonempty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent.  An AssociationEvent SHALL contain either a non-empty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent."@en ;
                                              rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                              rdfs:label "childQuantityList" ;
                                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/destinationList
<https://ref.gs1.org/epcis/destinationList> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                            rdfs:range <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                            <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                            <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                            rdfs:comment "(Optional) An unordered list of Destination elements that provide context about the terminating endpoint of a business transfer of which this event is a part."@en ;
                                            rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                            rdfs:label "destinationList" ;
                                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/disposition
<https://ref.gs1.org/epcis/disposition> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                        rdfs:range <https://ref.gs1.org/cbv/Disp> ;
                                        <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                        <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/Disp> ;
                                        rdfs:comment "(Optional) The business condition of the objects associated with the EPCs, presumed to hold true until contradicted by a subsequent event."@en ;
                                        rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                        rdfs:label "disposition" ;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/epcClass
<https://ref.gs1.org/epcis/epcClass> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://ref.gs1.org/epcis/QuantityElement> ;
                                     <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                     rdfs:comment "A class-level identifier for the class to which the specified quantity of objects belongs."@en ;
                                     rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                     rdfs:label "epcClass" ;
                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/epcList
<https://ref.gs1.org/epcis/epcList> rdf:type owl:ObjectProperty ;
                                    rdfs:domain [ rdf:type owl:Class ;
                                                  owl:unionOf ( <https://ref.gs1.org/epcis/ObjectEvent>
                                                                <https://ref.gs1.org/epcis/TransactionEvent>
                                                              )
                                                ] ;
                                    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/ObjectEvent> ,
                                                                       <https://ref.gs1.org/epcis/TransactionEvent> ;
                                    rdfs:comment "(Optional) An unordered list of one or more EPCs naming specific objects to which the event pertained."@en ;
                                    rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                    rdfs:label "epcList" ;
                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/inputEPCList
<https://ref.gs1.org/epcis/inputEPCList> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent> ;
                                         <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent> ;
                                         rdfs:comment "(Optional) An unordered list of one or more EPCs identifying (at the instance level) objects that were inputs to the transformation."@en ;
                                         rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                         rdfs:label "inputEPCList" ;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/inputQuantityList
<https://ref.gs1.org/epcis/inputQuantityList> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent> ;
                                              rdfs:range <https://ref.gs1.org/epcis/QuantityElement> ;
                                              <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent> ;
                                              <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                              rdfs:comment "(Optional) An unordered list of one or more QuantityElements identifying (at the class level) objects that were inputs to the transformation. See below for constraints on when inputQuantityList may be omitted."@en ;
                                              rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                              rdfs:label "inputQuantityList" ;
                                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/outputEPCList
<https://ref.gs1.org/epcis/outputEPCList> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent> ;
                                          <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent> ;
                                          rdfs:comment "(Optional) An unordered list of one or more EPCs naming (at the instance level) objects that were outputs from the transformation."@en ;
                                          rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                          rdfs:label "outputEPCList" ;
                                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/outputQuantityList
<https://ref.gs1.org/epcis/outputQuantityList> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent> ;
                                               rdfs:range <https://ref.gs1.org/epcis/QuantityElement> ;
                                               <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent> ;
                                               <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                               rdfs:comment "(Optional) An unordered list of one or more QuantityElements identifying (at the class level) objects that were outputs from the transformation. See below for constraints on when outputQuantityList may be omitted."@en ;
                                               rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                               rdfs:label "outputQuantityList" ;
                                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/parentID
<https://ref.gs1.org/epcis/parentID> rdf:type owl:ObjectProperty ;
                                     rdfs:domain [ rdf:type owl:Class ;
                                                   owl:unionOf ( <https://ref.gs1.org/epcis/AggregationEvent>
                                                                 <https://ref.gs1.org/epcis/AssociationEvent>
                                                                 <https://ref.gs1.org/epcis/TransactionEvent>
                                                               )
                                                 ] ;
                                     <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent> ,
                                                                        <https://ref.gs1.org/epcis/AssociationEvent> ,
                                                                        <https://ref.gs1.org/epcis/TransactionEvent> ;
                                     rdfs:comment "(Optional when action is OBSERVE, required otherwise) The identifier of the parent of the aggregation or association. When the parent identifier is an EPC, this field SHALL contain the 'pure identity' URI for the EPC as specified in the GS1 Tag Data Standard"@en ;
                                     rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                     rdfs:label "parentID" ;
                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/quantityList
<https://ref.gs1.org/epcis/quantityList> rdf:type owl:ObjectProperty ;
                                         rdfs:domain [ rdf:type owl:Class ;
                                                       owl:unionOf ( <https://ref.gs1.org/epcis/ObjectEvent>
                                                                     <https://ref.gs1.org/epcis/TransactionEvent>
                                                                   )
                                                     ] ;
                                         rdfs:range <https://ref.gs1.org/epcis/QuantityElement> ;
                                         <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/ObjectEvent> ,
                                                                            <https://ref.gs1.org/epcis/TransactionEvent> ;
                                         <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                         rdfs:comment "(Optional) An unordered list of one or more QuantityElements identifying (at the class level) objects to which the event pertained."@en ;
                                         rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                         rdfs:label "quantityList" ;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/readPoint
<https://ref.gs1.org/epcis/readPoint> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                      <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                      rdfs:comment "(Optional) The read point at which the event took place."@en ;
                                      rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                      rdfs:label "readPoint" ;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/sourceList
<https://ref.gs1.org/epcis/sourceList> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                       rdfs:range <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                       <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                       <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                       rdfs:comment "(Optional) An unordered list of Source elements that provide context about the originating endpoint of a business transfer of which this event is a part."@en ;
                                       rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                       rdfs:label "sourceList" ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/sourceOrDestination
<https://ref.gs1.org/epcis/sourceOrDestination> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                                <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                                rdfs:comment """An identifier that denotes the specific source or destination of a business transfer.
The semantic role of the identifier is indicated by sourceOrDestinationType. Resolution of that identifier to EU DPP Actor or Facility concepts, when applicable, is handled outside the EPCIS technical carrier layer."""@en ;
                                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                rdfs:label "sourceOrDestination" ;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                                <https://ref.gs1.org/epcis/jsonldLabel> "destination" ,
                                                                                        "source" .


###  https://ref.gs1.org/epcis/sourceOrDestinationType
<https://ref.gs1.org/epcis/sourceOrDestinationType> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                                    rdfs:range <https://ref.gs1.org/cbv/SDT> ;
                                                    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                                    <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/SDT> ;
                                                    rdfs:comment """An identifier that indicates the role of SourceOrDestination in a transfer (Owning Party, Possessing Party, or Location).
This role determines how the corresponding sourceOrDestination identifier is interpreted. Mapping to EU DPP Actor or Facility concepts, when applicable, is handled outside the EPCIS technical carrier layer."""@en ;
                                                    rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                    rdfs:label "sourceOrDestinationType" ;
                                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                                    <https://ref.gs1.org/epcis/jsonldLabel> "type" .


###  https://ref.gs1.org/epcis/transformationID
<https://ref.gs1.org/epcis/transformationID> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent> ;
                                             rdfs:range <https://ref.gs1.org/epcis/Transformation> ;
                                             <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent> ;
                                             <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/Transformation> ;
                                             rdfs:comment "(Optional) Associates several TransformationEvents with a longer-running Transformation process, therefore linking them together."@en ;
                                             rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                             rdfs:label "transformationID" ;
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://w3id.org/eudpp#hasDPPActionType
<https://w3id.org/eudpp#hasDPPActionType> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://w3id.org/eudpp#DPPUpdateEvent> ;
                                          rdfs:range <https://w3id.org/eudpp#DPPActionType> ;
                                          rdfs:comment "Links a DPP update event to the type of information-level action performed on the Digital Product Passport."@en ;
                                          rdfs:label "has DPP action type"@en .


###  https://w3id.org/eudpp#hasProductEvent
<https://w3id.org/eudpp#hasProductEvent> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <https://w3id.org/eudpp#isRepresentedByCarrier> ;
                                         rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                         rdfs:range <https://w3id.org/eudpp#ProductEvent> ;
                                         rdfs:comment "Links an EPCIS-inspired technical event carrier to the product event semantics it journalises."@en ;
                                         rdfs:label "has product event"@en .


###  https://w3id.org/eudpp#isRecordedAs
<https://w3id.org/eudpp#isRecordedAs> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#DPPEvent> ;
                                      rdfs:range <https://w3id.org/eudpp#DPPEventRecord> ;
                                      rdfs:comment "Links a DPP event to a technical audit record representing its registration in an information system or audit trail."@en ;
                                      rdfs:label "is recorded as"@en .


###  https://w3id.org/eudpp#isRepresentedByCarrier
<https://w3id.org/eudpp#isRepresentedByCarrier> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
                                                rdfs:range <https://ref.gs1.org/epcis/EPCISEvent> ;
                                                rdfs:comment "Links a product event concept to an EPCIS-inspired technical event carrier used to journalise and structure the corresponding event data."@en ;
                                                rdfs:label "is represented by carrier"@en .


###  https://w3id.org/eudpp#isTriggeredByProductEvent
<https://w3id.org/eudpp#isTriggeredByProductEvent> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://w3id.org/eudpp#DPPEvent> ;
                                                   rdfs:range <https://w3id.org/eudpp#ProductEvent> ;
                                                   rdfs:comment "Links a DPP event to the product event that caused or required it. This property is used when the DPP event results from a lifecycle change affecting the product."@en ;
                                                   rdfs:label "is triggered by product event"@en .


###  https://w3id.org/eudpp#recordsDPPEvent
<https://w3id.org/eudpp#recordsDPPEvent> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <https://w3id.org/eudpp#isRecordedAs> ;
                                         rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                         rdfs:range <https://w3id.org/eudpp#DPPEvent> ;
                                         rdfs:comment "Links a DPP event record to the DPP event whose technical registration it captures."@en ;
                                         rdfs:label "records DPP event"@en .


###  https://w3id.org/eudpp#triggersDPPEvent
<https://w3id.org/eudpp#triggersDPPEvent> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <https://w3id.org/eudpp#isTriggeredByProductEvent> ;
                                          rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
                                          rdfs:range <https://w3id.org/eudpp#DPPEvent> ;
                                          rdfs:comment "Links a product event to a DPP event that is triggered as a consequence of it, reflecting the obligation to update the DPP following lifecycle changes of the product."@en ;
                                          rdfs:label "triggers DPP event"@en .


#################################################################
#    Data properties
#################################################################

###  https://ref.gs1.org/epcis/action
<https://ref.gs1.org/epcis/action> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain [ rdf:type owl:Class ;
                                                 owl:unionOf ( <https://ref.gs1.org/epcis/AggregationEvent>
                                                               <https://ref.gs1.org/epcis/AssociationEvent>
                                                               <https://ref.gs1.org/epcis/ObjectEvent>
                                                               <https://ref.gs1.org/epcis/TransactionEvent>
                                                             )
                                               ] ;
                                   rdfs:range xsd:string ;
                                   <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent> ,
                                                                      <https://ref.gs1.org/epcis/AssociationEvent> ,
                                                                      <https://ref.gs1.org/epcis/ObjectEvent> ,
                                                                      <https://ref.gs1.org/epcis/TransactionEvent> ;
                                   <http://schema.org/rangeIncludes> xsd:string ;
                                   rdfs:comment "How this event relates to the lifecycle of the EPCs named in this event."@en ;
                                   rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                   rdfs:label "action" ;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/eventTime
<https://ref.gs1.org/epcis/eventTime> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                      rdfs:range xsd:dateTimeStamp ;
                                      <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                      <http://schema.org/rangeIncludes> xsd:dateTimeStamp ;
                                      rdfs:comment "The date and time at which the EPCIS Capturing Applications asserts the event occurred."@en ;
                                      rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                      rdfs:label "eventTime" ;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/eventTimeZoneOffset
<https://ref.gs1.org/epcis/eventTimeZoneOffset> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                                rdfs:range xsd:string ;
                                                <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                                <http://schema.org/rangeIncludes> xsd:string ;
                                                rdfs:comment "The time zone offset in effect at the time and place the event occurred, expressed as an offset from UTC. The value of this field SHALL be a string consisting of the character '+' or the character '-', followed by two digits whose value is within the range 00 through 14 (inclusive), followed by a colon character ':', followed by two digits whose value is within the range 00 through 59 (inclusive), except that if the value of the first two digits is 14, the value of the second two digits must be 00. For example, the value +05:30 specifies that where the event occurred, local time was five hours and 30 minutes later than UTC (that is, midnight UTC was 5:30am local time)."@en ;
                                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                rdfs:label "eventTimeZoneOffset" ;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/quantity
<https://ref.gs1.org/epcis/quantity> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://ref.gs1.org/epcis/QuantityElement> ;
                                     rdfs:range xsd:double ;
                                     <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                     <http://schema.org/rangeIncludes> xsd:double ;
                                     rdfs:comment "A number that specifies how many or how much of the specified EPCClass is denoted by this QuantityElement."@en ;
                                     rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                     rdfs:label "quantity" ;
                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/recordTime
<https://ref.gs1.org/epcis/recordTime> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                       rdfs:range xsd:dateTimeStamp ;
                                       <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                       <http://schema.org/rangeIncludes> xsd:dateTimeStamp ;
                                       rdfs:comment "(Optional) The date and time at which this event was recorded by an EPCIS Repository. This field SHALL be ignored when an event is presented to the EPCIS Capture Interface, and SHALL be present when an event is retrieved through the EPCIS Query Interfaces. The recordTime does not describe anything about the real-world event, but is rather a bookkeeping mechanism that plays a role in the interpretation of standing queries"@en ;
                                       rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                       rdfs:label "recordTime" ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/uom
<https://ref.gs1.org/epcis/uom> rdf:type owl:DatatypeProperty ;
                                rdfs:domain [ rdf:type owl:Class ;
                                              owl:unionOf ( <https://ref.gs1.org/epcis/QuantityElement>
                                                            <https://ref.gs1.org/epcis/SensorReport>
                                                          )
                                            ] ;
                                rdfs:range xsd:string ;
                                <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/QuantityElement> ,
                                                                   <https://ref.gs1.org/epcis/SensorReport> ;
                                <http://schema.org/rangeIncludes> xsd:string ;
                                rdfs:comment "(Optional) Unit of measure by which the specified value(s) of the property specified by type should be interpreted.  If there is no value, minValue, maxValue, averageValue or percValue field present, uom SHALL be omitted.  When a uom field is present, its value SHALL be the 2- or 3-character code for a physical unit specified in the 'Common Code' column of UN/CEFACT Recommendation'20 [CEFACT20].   Note: GS1 provides a tool containing a machine-readable file which enables the automatic conversion between quantitative values expressed using UN/CEFACT common codes. [https://ref.gs1.org/tools/UnitConverterUNECERec20]"@en ;
                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                rdfs:label "uom" ;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://w3id.org/eudpp#dppEventRecordIdentifier
<https://w3id.org/eudpp#dppEventRecordIdentifier> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                                  rdfs:range xsd:anyURI ;
                                                  rdfs:comment "A unique identifier assigned to a DPP event record."@en ;
                                                  rdfs:label "dpp event record identifier"@en .


###  https://w3id.org/eudpp#dppEventRecordedAt
<https://w3id.org/eudpp#dppEventRecordedAt> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                            rdfs:range xsd:dateTime ;
                                            rdfs:comment "The date and time at which the technical record of a DPP event was created in an information system or audit trail."@en ;
                                            rdfs:label "dpp event recorded at"@en .


###  https://w3id.org/eudpp#recordedInSystem
<https://w3id.org/eudpp#recordedInSystem> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                          rdfs:range xsd:anyURI ;
                                          rdfs:comment "Indicates the URI identifying the system, application, or audit log in which the DPP event record is maintained."@en ;
                                          rdfs:label "recorded in system"@en .


###  https://w3id.org/eudpp#recordedInSystemName
<https://w3id.org/eudpp#recordedInSystemName> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                              rdfs:range xsd:string ;
                                              rdfs:comment "Indicates the human-readable name of the system, application, or audit log in which the DPP event record is maintained."@en ;
                                              rdfs:label "recorded in system name"@en .


#################################################################
#    Classes
#################################################################

###  https://ref.gs1.org/cbv/BTT
<https://ref.gs1.org/cbv/BTT> rdf:type owl:Class .


###  https://ref.gs1.org/cbv/BizStep
<https://ref.gs1.org/cbv/BizStep> rdf:type owl:Class .


###  https://ref.gs1.org/cbv/Disp
<https://ref.gs1.org/cbv/Disp> rdf:type owl:Class .


###  https://ref.gs1.org/cbv/SDT
<https://ref.gs1.org/cbv/SDT> rdf:type owl:Class .


###  https://ref.gs1.org/epcis/AggregationEvent
<https://ref.gs1.org/epcis/AggregationEvent> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent> ;
                                             rdfs:comment "The event type AggregationEvent describes events that apply to objects that have been aggregated to one another. In such an event, there is a set of 'contained' objects that have been aggregated within a 'containing' entity that's meant to identify the aggregation itself.  This event type is intended to be used for 'aggregations', meaning an association where there is a strong physical relationship between the containing and the contained objects such that they will all occupy the same location at the same time, until such time as they are disaggregated."@en ;
                                             rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                             rdfs:label "AggregationEvent" ;
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                             <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID" .


###  https://ref.gs1.org/epcis/AssociationEvent
<https://ref.gs1.org/epcis/AssociationEvent> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent> ;
                                             rdfs:comment "The event type AssociationEvent describes the association or disassociation of one or several physical objects with a parent object or a specific physical location.  Like the AggregationEvent, the AssociationEvent is also used to capture associations where there is a strong physical relationship between the containing and the contained objects such that they will all occupy the same location at the same time, until such time as they are disaggregated. However, the AggregationEvent does not allow for associations of objects with physical locations;  if action is DELETE while omitting the childEPC and childQuantityList field, all contained children are disaggregated from the containing parent. Because there are situations in which associations are more permanent, i.e. beyond the physical flow of goods (e.g. packing/unpacking and loading/unloading), an AssociationEvent SHOULD be used: (a) when objects need to be associated with a physical location or (b) when the parent object could also be subject to other, more temporary associations (i.e. captured using AggregationEvent)."@en ;
                                             rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                             rdfs:label "AssociationEvent" ;
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                             <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID" .


###  https://ref.gs1.org/epcis/BizTransaction
<https://ref.gs1.org/epcis/BizTransaction> rdf:type owl:Class ;
                                           rdfs:comment "Document that describes a particular business transaction. An example is a specific Purchase Order or Despatch Advice. Business Transaction information may be included in EPCIS events to record an event's participation in particular business transactions."@en ;
                                           rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                           rdfs:label "BizTransaction" ;
                                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                           <https://ref.gs1.org/epcis/jsonldUriLabel> "bizTransaction" .


###  https://ref.gs1.org/epcis/EPCISEvent
<https://ref.gs1.org/epcis/EPCISEvent> rdf:type owl:Class ;
                                       owl:disjointWith <https://w3id.org/eudpp#DPPEventRecord> ;
                                       rdfs:comment "A logistics event. This is a common superclass (base type) for all EPCIS events. All of the more specific event types are subclasses of EPCISEvent."@en ;
                                       rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                       rdfs:label "EPCISEvent" ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/ObjectEvent
<https://ref.gs1.org/epcis/ObjectEvent> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent> ;
                                        rdfs:comment "An ObjectEvent captures information about an event pertaining to one or more physical or digital objects identified by instance-level (EPC) or class-level (EPC Class) identifiers. In most situations, an ObjectEvent is envisioned to represent an actual observations of objects, but strictly speaking it can be used for any event a Capturing Application wants to assert about objects, including for example capturing the fact that an expected observation failed to occur."@en ;
                                        rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                        rdfs:label "ObjectEvent" ;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                        <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID" .


###  https://ref.gs1.org/epcis/QuantityElement
<https://ref.gs1.org/epcis/QuantityElement> rdf:type owl:Class ;
                                            rdfs:comment "A QuantityElement is a structure that identifies objects identified by a specific class-level identifier, either a specific quantity or an unspecified quantity."@en ;
                                            rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                            rdfs:label "QuantityElement" ;
                                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/SensorReport
<https://ref.gs1.org/epcis/SensorReport> rdf:type owl:Class .


###  https://ref.gs1.org/epcis/SourceOrDestination
<https://ref.gs1.org/epcis/SourceOrDestination> rdf:type owl:Class ;
                                                rdfs:comment "Provides additional business context when an EPCIS event is part of a business transfer; that is, a process in which there is a change of location, or transfer of ownership, or transfer of possession of physical or digital objects. Within a specified type of transfer, the business transfer is from the Source to the Destination."@en ;
                                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                rdfs:label "Source or Destination" ;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                                <https://ref.gs1.org/epcis/jsonldUriLabel> "id" .


###  https://ref.gs1.org/epcis/TransactionEvent
<https://ref.gs1.org/epcis/TransactionEvent> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent> ;
                                             rdfs:comment "The event type TransactionEvent describes the association or disassociation of physical or digital objects to one or more business transactions. While other event types have an optional bizTransactionList field that may be used to provide context for an event, the TransactionEvent is used to declare in an unequivocal way that certain objects have been associated or disassociated with one or more business transactions as part of the event."@en ;
                                             rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                             rdfs:label "TransactionEvent" ;
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                             <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID" .


###  https://ref.gs1.org/epcis/Transformation
<https://ref.gs1.org/epcis/Transformation> rdf:type owl:Class ;
                                           rdfs:comment """A transformation business processes that takes a longer period of time than a single TransformationEvent, so is associated with a series of such events.
When events share the same Transformation, the meaning is that the inputs to any of those events may have contributed in some way to each of the outputs in any of those same events."""@en ;
                                           rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                           rdfs:label "Transformation" ;
                                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/TransformationEvent
<https://ref.gs1.org/epcis/TransformationEvent> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent> ;
                                                rdfs:comment "A TransformationEvent captures information about an event in which one or more physical or digital objects identified by instance-level (EPC) or class-level (EPC Class) identifiers are fully or partially consumed as inputs and one or more objects identified by instance-level (EPC) or class-level (EPC Class) identifiers are produced as outputs. The TransformationEvent captures the relationship between the inputs and the outputs, such that any of the inputs may have contributed in some way to each of the outputs."@en ;
                                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                rdfs:label "TransformationEvent" ;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                                <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID" .


###  https://w3id.org/eudpp#DPPActionType
<https://w3id.org/eudpp#DPPActionType> rdf:type owl:Class ;
                                       owl:equivalentClass [ rdf:type owl:Class ;
                                                             owl:oneOf ( <https://w3id.org/eudpp#AddDPPDataAction>
                                                                         <https://w3id.org/eudpp#CorrectDPPDataAction>
                                                                         <https://w3id.org/eudpp#DeleteDPPDataAction>
                                                                         <https://w3id.org/eudpp#ModifyDPPDataAction>
                                                                       )
                                                           ] ;
                                       rdfs:comment "A classification indicating the type of information-level action performed during a DPP update event."@en ;
                                       rdfs:label "DPP Action Type"@en .


###  https://w3id.org/eudpp#DPPArchivalEvent
<https://w3id.org/eudpp#DPPArchivalEvent> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#DPPEvent> ;
                                          rdfs:comment "An event corresponding to the archival or end-of-active-life management of a Digital Product Passport."@en ;
                                          rdfs:label "DPP Archival Event"@en .


###  https://w3id.org/eudpp#DPPCreationEvent
<https://w3id.org/eudpp#DPPCreationEvent> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#DPPEvent> ;
                                          rdfs:comment "An event corresponding to the creation or initial issuance of a Digital Product Passport."@en ;
                                          rdfs:label "DPP Creation Event"@en .


###  https://w3id.org/eudpp#DPPEvent
<https://w3id.org/eudpp#DPPEvent> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/eudpp#ESPREvent> ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/eudpp#isTriggeredByProductEvent> ;
                                                    owl:allValuesFrom <https://w3id.org/eudpp#ProductEvent>
                                                  ] ;
                                  owl:disjointWith <https://w3id.org/eudpp#DPPEventRecord> ,
                                                   <https://w3id.org/eudpp#ProductEvent> ;
                                  rdfs:comment "An ESPR-level event concept representing an event that affects the existence, content, accessibility, update, correction, or governance of a DPP. A DPPEvent captures the passport-facing semantics of the occurrence and is modelled as distinct from the product event that may trigger it."@en ;
                                  rdfs:label "DPP Event"@en .


###  https://w3id.org/eudpp#DPPEventRecord
<https://w3id.org/eudpp#DPPEventRecord> rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#recordsDPPEvent> ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <https://w3id.org/eudpp#DPPEvent>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#dppEventRecordIdentifier> ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#dppEventRecordedAt> ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#recordedInSystem> ;
                                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#recordedInSystemName> ;
                                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                        ] ;
                                        <http://purl.org/dc/terms/source> "Defined in the EU DPP Core Ontology Event module to support the technical recording of DPP-related events."@en ;
                                        rdfs:comment "A technical audit record used to represent and log an information-level event affecting a Digital Product Passport. Unlike EPCIS carriers, this class is intended for recording DPP-side information events rather than product-facing operational events."@en ;
                                        rdfs:label "DPP Event Record"@en .


###  https://w3id.org/eudpp#DPPUpdateEvent
<https://w3id.org/eudpp#DPPUpdateEvent> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/eudpp#DPPEvent> ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#hasDPPActionType> ;
                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <https://w3id.org/eudpp#DPPActionType>
                                                        ] ;
                                        rdfs:comment "An event corresponding to an update of the content of a Digital Product Passport."@en ;
                                        rdfs:label "DPP Update Event"@en .


###  https://w3id.org/eudpp#DestructionEvent
<https://w3id.org/eudpp#DestructionEvent> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                          <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                          <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(34); Art 25(1)"@en ;
                                          rdfs:comment "The intentional damaging or discarding of a product and unsold products as waste, with the exception of discarding for the sole purpose of delivering the discarded product for preparing for reuse, including refurbishment or remanufacturing operations. ESPR Art 2(34) and Art 25(1)."@en ;
                                          rdfs:label "Destruction"@en .


###  https://w3id.org/eudpp#ESPREvent
<https://w3id.org/eudpp#ESPREvent> rdf:type owl:Class ;
                                   <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                   <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; lifecycle-event-oriented abstraction introduced for modelling purposes."@en ;
                                   rdfs:comment "Abstract superclass introduced for modelling purposes. Used to represent the regulatory or business semantics of an event relevant in the ESPR context and concerning either a product or its DPP, independently of its technical journalisation."@en ;
                                   rdfs:label "ESPR Event"@en .


###  https://w3id.org/eudpp#MaintenanceEvent
<https://w3id.org/eudpp#MaintenanceEvent> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                          <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                          <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(19)"@en ;
                                          rdfs:comment "Actions (one or more) taken to keep a product in a condition where it can fulfil its intended purpose. ESPR Art 2(19)."@en ;
                                          rdfs:label "Maintenance"@en .


###  https://w3id.org/eudpp#MakingAvailableOnMarketEvent
<https://w3id.org/eudpp#MakingAvailableOnMarketEvent> rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                                      <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                      <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(39)"@en ;
                                                      rdfs:comment "Any supply of a product for distribution, consumption or use on the Union market in the course of a commercial activity, whether in return for payment or free of charge. ESPR Art 2(39)."@en ;
                                                      rdfs:label "Making Available on the Market"@en .


###  https://w3id.org/eudpp#PlacingOnMarketEvent
<https://w3id.org/eudpp#PlacingOnMarketEvent> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/eudpp#MakingAvailableOnMarketEvent> ;
                                              <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                              <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(40)"@en ;
                                              rdfs:comment "The very first time a product is made available on the Union market. ESPR Art 2(40)."@en ;
                                              rdfs:label "Placing on the Market"@en .


###  https://w3id.org/eudpp#ProductEvent
<https://w3id.org/eudpp#ProductEvent> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/eudpp#ESPREvent> ;
                                      rdfs:comment "An ESPR-level event concept representing an event that affects the state, condition, use, circulation, transformation, maintenance, or end-of-life status of a product. A ProductEvent captures the product-facing semantics of the occurrence and is distinct from any DPP-side event that may be triggered to record or reflect it."@en ;
                                      rdfs:label "Product Event"@en .


###  https://w3id.org/eudpp#PuttingIntoServiceEvent
<https://w3id.org/eudpp#PuttingIntoServiceEvent> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                                 <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                 <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(41)"@en ;
                                                 rdfs:comment "The first use of a product for its intended purpose in the Union. ESPR Art 2(41)."@en ;
                                                 rdfs:label "Putting into Service"@en .


###  https://w3id.org/eudpp#RefurbishmentEvent
<https://w3id.org/eudpp#RefurbishmentEvent> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                            <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                            <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(18)"@en ;
                                            rdfs:comment "Actions carried out to prepare, clean, test, service and, where necessary, repair a product or a discarded product in order to restore its performance or functionality within the intended use and range of performance originally conceived at the design stage at the time of the placing of the product on the market. ESPR Art 2(18)."@en ;
                                            rdfs:label "Refurbishment"@en .


###  https://w3id.org/eudpp#RemanufacturingEvent
<https://w3id.org/eudpp#RemanufacturingEvent> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                              <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                              <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(16)"@en ;
                                              rdfs:comment "Actions through which a new product is produced from objects that are waste, products or components and through which at least one change is made that substantially affects the safety, performance, purpose or type of the product. ESPR Art 2(16)."@en ;
                                              rdfs:label "Remanufacturing"@en .


###  https://w3id.org/eudpp#RepairEvent
<https://w3id.org/eudpp#RepairEvent> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                     <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                     <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(20)"@en ;
                                     rdfs:comment "Actions taken to return a defective product or waste to a condition where it fulfils its intended purpose. ESPR Art 2(20)."@en ;
                                     rdfs:label "Repair"@en .


###  https://w3id.org/eudpp#UpgradingEvent
<https://w3id.org/eudpp#UpgradingEvent> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                        <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                        <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(17)"@en ;
                                        rdfs:comment "Actions carried out to enhance the functionality, performance, capacity, safety or aesthetics of a product. ESPR Art 2(17)."@en ;
                                        rdfs:label "Upgrading"@en .


