@prefix : <https://w3id.org/eudpp/P_DPP#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/P_DPP#> .

<https://w3id.org/eudpp/P_DPP> rdf:type owl:Ontology ;
                                <http://purl.org/dc/terms/bibliographicCitation> <https://doi.org/10.5281/zenodo.15270342> ;
                                <http://purl.org/dc/terms/contributor> "Riina Maigre"@en ,
                                                                       "Tarmo Robal"@en ,
                                                                       "Theodor Chirvasuta"@en ;
                                <http://purl.org/dc/terms/created> "2025-01-29"^^xsd:date ;
                                <http://purl.org/dc/terms/creator> "Hele-Mai Haav (up until version 1.7.1 incl.), further maintained by contributors."@en ;
                                <http://purl.org/dc/terms/description> """The EU DPP core ontology proposed in CIRPASS-2 European project  is a shared formal specification of basic concepts and properties/relationships in the cross-sectorial DPP domain to facilitate knowledge sharing across sector-specific DPPs.

The proposed  EU DPP core ontology captures several modules from which the Product and DPP module plays a central role.

DEPENDENCIES:  This module has dependencies to the following EU DPP Core Ontology (CO) modules: CON, ACTOR, SOC.  

For more information, see 
Maigre, R., Haav, H.-M., Robal, T., Wolf, M.-A., & Danash, F. (2025). Ontology Requirements Specification for an EU DPP Core Ontology Proposal (1.1). CIRPASS-2 Consortium. https://doi.org/10.5281/zenodo.15270342

"""@en ;
                                <http://purl.org/dc/terms/issued> "2026-09-22"^^xsd:date ;
                                <http://purl.org/dc/terms/license> <https://www.apache.org/licenses/LICENSE-2.0> ,
                                                                   """This ontology is licensed under the Apache License, Version 2.0. 
In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."""@en ;
                                <http://purl.org/dc/terms/title> "The Product and DPP module of an EU regulatory compliant Digital Product Passport Core Ontology (EU DPP CO) proposed by the CIRPASS-2 European project."@en ;
                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "dpp" ;
                                rdfs:comment "The Product and DPP module of an EU DPP core ontology proposed by the CIRPASS-2 European project."@en ;
                                rdfs:label "EU DPP CO P_DPP"@en ;
                                owl:versionInfo "2.0.7" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/references
<http://purl.org/dc/terms/references> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
<http://www.w3.org/2004/02/skos/core#exactMatch> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp#appliesToProduct
<https://w3id.org/eudpp#appliesToProduct> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <https://w3id.org/eudpp#hasDPP> ;
                                          rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                          rdfs:range <https://w3id.org/eudpp#Product> ;
                                          rdfs:comment "The property links DPP and the Product."@en ;
                                          rdfs:label "applies to product"@en .


###  https://w3id.org/eudpp#hasDPP
<https://w3id.org/eudpp#hasDPP> rdf:type owl:ObjectProperty ;
                                rdfs:domain <https://w3id.org/eudpp#Product> ;
                                rdfs:range <https://w3id.org/eudpp#DPP> ;
                                rdfs:comment "A Product has a DPP. The property links a Product with a DPP."@en ;
                                rdfs:label "has DPP"@en .


###  https://w3id.org/eudpp#hasMeasurementUnit
<https://w3id.org/eudpp#hasMeasurementUnit> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://w3id.org/eudpp#QuantitativeProperty> ;
                                            rdfs:range <https://si-digital-framework.org/SI#MeasurementUnit> ;
                                            rdfs:comment "Linking quantitative property to the unit of measurement."@en ;
                                            rdfs:label "has measurement unit"@en .


###  https://w3id.org/eudpp#hasProductGroup
<https://w3id.org/eudpp#hasProductGroup> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#Product> ;
                                         rdfs:range <https://w3id.org/eudpp#ClassificationCode> ;
                                         <http://purl.org/dc/terms/references> "ESPR Art 2 (4)"@en ;
                                         <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                         rdfs:comment """Product group
means a set of products that serve similar purposes and are similar in terms of use, or have similar
functional properties, and are similar in terms of consumer perception (ESPR Art 2 (4)). The product
group or groups covered are given by delegated acts. (ESPR Art 8 (a))

This will be probably a classification code from some product classification scheme ."""@en ;
                                         rdfs:label "has product group"@en .


###  https://w3id.org/eudpp#hasProperty
<https://w3id.org/eudpp#hasProperty> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                                     rdfs:range <https://w3id.org/eudpp#Property> ;
                                     rdfs:comment """Product has a property that could be a document or some measurable properties (measurands).

Linking the product to the property."""@en ;
                                     rdfs:label "has property"@en .


###  https://w3id.org/eudpp#isComponentOf
<https://w3id.org/eudpp#isComponentOf> rdf:type owl:ObjectProperty ,
                                                owl:TransitiveProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Product> ;
                                       rdfs:range <https://w3id.org/eudpp#Product> ;
                                       <http://purl.org/dc/terms/references> "ESPR Art 2(2)"@en ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                       rdfs:comment """A product is a component of another product.

‘component’ means a product intended to be incorporated into another product; [ESPR Art 2(2)]"""@en ;
                                       rdfs:label "is component of"@en .


###  https://w3id.org/eudpp#isSparePartOf
<https://w3id.org/eudpp#isSparePartOf> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Product> ;
                                       rdfs:range <https://w3id.org/eudpp#Product> ;
                                       <http://purl.org/dc/terms/references> "ESPR Annex I"@en ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                       rdfs:comment "A product is a spare part of another product."@en ;
                                       rdfs:label "is spare part of"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/eudpp#codeSet
<https://w3id.org/eudpp#codeSet> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <https://w3id.org/eudpp#ClassificationCode> ;
                                 rdfs:range xsd:anyURI ;
                                 rdfs:comment """The product classification code set.

See also Produc hasProductGroup ClassificationCode documentation."""@en ;
                                 rdfs:label "classification code set"@en .


###  https://w3id.org/eudpp#codeValue
<https://w3id.org/eudpp#codeValue> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#ClassificationCode> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "Classification code value from the Classification code set."@en ;
                                   rdfs:label "classification code value"@en .


###  https://w3id.org/eudpp#commodityCode
<https://w3id.org/eudpp#commodityCode> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Product> ;
                                       rdfs:range xsd:string ;
                                       <http://purl.org/dc/terms/references> "ESPR Annex III (d)"@en ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                       rdfs:comment "Relevant commodity codes, such as a TARIC code as defined in Council Regulation (EEC) No 2658/87.[ESPR Annex III (d)]"@en ;
                                       rdfs:label "commodity code"@en .


###  https://w3id.org/eudpp#contentType
<https://w3id.org/eudpp#contentType> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#DocumentFormattedProperty> ;
                                     rdfs:range [ rdf:type rdfs:Datatype ;
                                                  owl:oneOf [ rdf:type rdf:List ;
                                                              rdf:first "application" ;
                                                              rdf:rest [ rdf:type rdf:List ;
                                                                         rdf:first "pdf" ;
                                                                         rdf:rest rdf:nil
                                                                       ]
                                                            ]
                                                ] ;
                                     rdfs:comment "Content type of a document. Can be only “application” or “pdf”."@en ;
                                     rdfs:label "content type"@en .


###  https://w3id.org/eudpp#description
<https://w3id.org/eudpp#description> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                                     rdfs:range xsd:string ;
                                     rdfs:comment "Product description"@en ;
                                     rdfs:label "description"@en .


###  https://w3id.org/eudpp#dictionaryReference
<https://w3id.org/eudpp#dictionaryReference> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#Property> ;
                                             rdfs:range xsd:string ;
                                             rdfs:comment """The reference to the unique identifier of the data point specification defined in the repository/data dictionary.

It is formatted as a URI/URL ."""@en ;
                                             rdfs:label "dictionary reference"@en .


###  https://w3id.org/eudpp#dppStatus
<https://w3id.org/eudpp#dppStatus> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                   rdfs:range [ rdf:type rdfs:Datatype ;
                                                owl:oneOf [ rdf:type rdf:List ;
                                                            rdf:first "Active" ;
                                                            rdf:rest [ rdf:type rdf:List ;
                                                                       rdf:first "Archived" ;
                                                                       rdf:rest [ rdf:type rdf:List ;
                                                                                  rdf:first "Inactive" ;
                                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                                             rdf:first "Invalid" ;
                                                                                             rdf:rest rdf:nil
                                                                                           ]
                                                                                ]
                                                                     ]
                                                          ]
                                              ] ;
                                   rdfs:comment "The status of the DPP instance as digital resource."@en ;
                                   rdfs:label "DPP status"@en .


###  https://w3id.org/eudpp#granularity
<https://w3id.org/eudpp#granularity> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                     rdfs:range [ rdf:type rdfs:Datatype ;
                                                  owl:oneOf [ rdf:type rdf:List ;
                                                              rdf:first "batch" ;
                                                              rdf:rest [ rdf:type rdf:List ;
                                                                         rdf:first "item" ;
                                                                         rdf:rest [ rdf:type rdf:List ;
                                                                                    rdf:first "model" ;
                                                                                    rdf:rest rdf:nil
                                                                                  ]
                                                                       ]
                                                            ]
                                                ] ;
                                     <http://purl.org/dc/terms/references> "ESPR Art 9 (2) d"@en ;
                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                     rdfs:comment """ESPR Art 9 (2) d  declares that the digital product passport is to be established at model, batch or item level, and the definition of such levels (is determined by delegated acts (DA));

The product passport should be defined at the level of item, batch or product model, depending on specific needs and complexity of the value chain, the size, nature or impacts of the products considered. (Standardisation Request 5423 7)"""@en ;
                                     rdfs:label "granularity"@en .


###  https://w3id.org/eudpp#isEnergyRelated
<https://w3id.org/eudpp#isEnergyRelated> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#Product> ;
                                         rdfs:range xsd:boolean ;
                                         <http://purl.org/dc/terms/references> "ESPR Art 2 (4)"@en ;
                                         <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                         rdfs:comment """Energy related product
means any product that has an impact on energy consumption during use. (ESPR Art 2 (4)).

The boolean data type property indicates is a Product energy related or not?"""@en ;
                                         rdfs:label "is energy related Product"@en .


###  https://w3id.org/eudpp#lastUpdate
<https://w3id.org/eudpp#lastUpdate> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                    rdfs:range xsd:dateTimeStamp ;
                                    rdfs:comment "The date and time of the latest update to the DPP instance."@en ;
                                    rdfs:label "last update"@en .


###  https://w3id.org/eudpp#linkToPreviousDPP
<https://w3id.org/eudpp#linkToPreviousDPP> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                           rdfs:range xsd:anyURI ;
                                           <http://purl.org/dc/terms/references> "ESPR Art 11 (d)"@en ,
                                                                                 "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                           rdfs:comment "Where a new digital product passport is created for a product that already has a digital product passport, the new digital product passport shall be linked to the original digital product passport or passports. (ESPR Art 11 (d))"@en ;
                                           rdfs:label "link to previous DPP"@en .


###  https://w3id.org/eudpp#manufacturingDate
<https://w3id.org/eudpp#manufacturingDate> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#Product> ;
                                           rdfs:comment """Date of manufacture of the product. 

The range of the data property is intentionally left open to be specified in accordance of sectorial needs."""@en ;
                                           rdfs:label "manufacturing date"@en .


###  https://w3id.org/eudpp#numericalValue
<https://w3id.org/eudpp#numericalValue> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain <https://w3id.org/eudpp#QuantitativeProperty> ;
                                        rdfs:range xsd:decimal ;
                                        rdfs:comment "The numerical value of the quantity, i.e., quantitative property of the product."@en ;
                                        rdfs:label "numerical value"@en .


###  https://w3id.org/eudpp#productImage
<https://w3id.org/eudpp#productImage> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#Product> ;
                                      rdfs:range xsd:anyURI ;
                                      rdfs:comment "An image of the product."@en ;
                                      rdfs:label "product image"@en .


###  https://w3id.org/eudpp#productName
<https://w3id.org/eudpp#productName> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                                     rdfs:range xsd:string ;
                                     rdfs:comment "Product name"@en ;
                                     rdfs:label "product name"@en .


###  https://w3id.org/eudpp#tolerance
<https://w3id.org/eudpp#tolerance> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#QuantitativeProperty> ;
                                   rdfs:range xsd:double ;
                                   rdfs:comment """Engineering tolerance is the permissible variation in measurements deriving from the base measurement.
Tolerances can apply to many different units."""@en ;
                                   rdfs:label "tolerance"@en .


###  https://w3id.org/eudpp#validFrom
<https://w3id.org/eudpp#validFrom> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                   rdfs:range xsd:dateTimeStamp ;
                                   rdfs:comment "The date and timestamp that the DPP is valid from."@en ;
                                   rdfs:label "valid from"@en .


###  https://w3id.org/eudpp#validUntil
<https://w3id.org/eudpp#validUntil> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                    rdfs:range xsd:dateTimeStamp ;
                                    rdfs:comment "The date and timestamp that the DPP is valid until."@en ;
                                    rdfs:label "valid until"@en .


###  https://w3id.org/eudpp#value
<https://w3id.org/eudpp#value> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <https://w3id.org/eudpp#DocumentFormattedProperty> ;
                               rdfs:range xsd:string ;
                               rdfs:comment """Contains the data of the value encapsulated in the Document.

Value is xsd:string that is formatted as a URL,  where to fetch the file."""@en ;
                               rdfs:label "value related to the document"@en .


###  https://w3id.org/eudpp#webLink
<https://w3id.org/eudpp#webLink> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <https://w3id.org/eudpp#DigitalInstruction> ;
                                 rdfs:range xsd:anyURI ;
                                 rdfs:comment "Web link to an instruction document or video etc."@en ;
                                 rdfs:label "weblink"@en .


#################################################################
#    Classes
#################################################################

###  https://si-digital-framework.org/SI#MeasurementUnit
<https://si-digital-framework.org/SI#MeasurementUnit> rdf:type owl:Class ;
                                                      rdfs:comment """Measurement unit defining the magnitude of the quantity in respect to the value.
si:MeasurementUnit class is reused"""@en ;
                                                      rdfs:label "Unit of measurement"@en .


###  https://w3id.org/eudpp#CarbonFootprint
<https://w3id.org/eudpp#CarbonFootprint> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/eudpp#EnvironmentalFootprint> ;
                                         <http://purl.org/dc/terms/references> "ESPR Art 2 (25)"@en ;
                                         <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                         rdfs:comment """Carbon footprint
means the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category
of climate change. (ESPR Art 2 25))

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                         rdfs:label "Carbon footprint"@en .


###  https://w3id.org/eudpp#CircularEconomyIndicator
<https://w3id.org/eudpp#CircularEconomyIndicator> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                                  rdfs:comment """Circular Economy indicators are measures for relevant monitoring the transition to a circular economy and to measure the effects of new policy and trends.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                                  rdfs:label "Circular Economy Indicator"@en ;
                                                  rdfs:seeAlso <https://environment.ec.europa.eu/strategy/circular-economy-action-plan_en> .


###  https://w3id.org/eudpp#ClassificationCode
<https://w3id.org/eudpp#ClassificationCode> rdf:type owl:Class ;
                                            rdfs:comment "A classification code from some product classification scheme ."@en ;
                                            rdfs:label "ClassificationCode"@en .


###  https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern
<https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern> rdf:type owl:Class ;
                                                           rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                                           <http://purl.org/dc/terms/references> "ESPR Art 7(5)"@en ;
                                                           <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                           rdfs:comment "The concentration of the substances of concern, at the level of the product, its relevant components, or spare parts ESPR Art 7(5)"@en ;
                                                           rdfs:label "Concentration of the substance of concern"@en .


###  https://w3id.org/eudpp#DPP
<https://w3id.org/eudpp#DPP> rdf:type owl:Class ;
                             <http://purl.org/dc/terms/references> "ESPR Art 2 (28)"@en ;
                             <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                             rdfs:comment """Digital Product Passport (DPP) means a set of data specific to a product that includes the information specified in the applicable
delegated act adopted pursuant to Article 4 and that is accessible via electronic means through a data carrier in accordance with Chapter III. (ESPR Art 2 (28))"""@en ;
                             rdfs:label "Digital Product Passport (DPP)"@en .


###  https://w3id.org/eudpp#DigitalInstruction
<https://w3id.org/eudpp#DigitalInstruction> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/eudpp#DocumentFormattedProperty> ;
                                            <http://purl.org/dc/terms/references> "ESPR Art 27(7)"@en ;
                                            <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                            rdfs:comment """Digital instructions
mean instructions in digital format concerning the product (‘digital instructions’) in a language that can be easily understood. ESPR Art 27(7)
Digital instructions are ensured by manufacturers. These should also ensured by importers. (ESPR Art 29(4))

This class can be extended/specialised according to delegated acts or industry standards."""@en ;
                                            rdfs:label "DigitalInstruction"@en .


###  https://w3id.org/eudpp#DocumentFormattedProperty
<https://w3id.org/eudpp#DocumentFormattedProperty> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/eudpp#Property> ;
                                                   rdfs:comment "The document class describes the semantic representation of any instance of a document that might be required to be included into a digital product passport instance."@en ;
                                                   rdfs:label "Document"@en .


###  https://w3id.org/eudpp#Durability
<https://w3id.org/eudpp#Durability> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/eudpp#QualityIndicator> ;
                                    <http://purl.org/dc/terms/references> "ESPR Art 2 (22)"@en ;
                                    <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                    rdfs:comment """Durability
means the ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair. (ESPR Art 2 (22))

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                    rdfs:label "Durability"@en .


