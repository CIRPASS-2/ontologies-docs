  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "\n        The CORE is the integration ontology that imports all the specific ontology modules and the connector (bridge) ontology of these.\n        ---\n        Note on the license: This ontology is licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0). In case of dispute over CC BY 4.0 applicability, or in case considering the ontology as a software or part of it, this ontology is to be considered licensed under the Apache License, Version 2.0.\n        ---\n        THIS DOCUMENT IS PROVIDED WITH NO WARRANTIES WHATSOEVER. \n        All liability for any damages arising from use or misuse of this vocabulary is with the user.\n        "
  } ],
