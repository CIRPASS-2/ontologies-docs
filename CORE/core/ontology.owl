        </terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">CORE  of the EU DPP core ontology proposed by the CIRPASS-2 project.</terms:title>
        <vann:preferredNamespacePrefix>eudpp</vann:preferredNamespacePrefix>
        <rdfs:comment xml:lang="en">The CORE of the EU DPP core ontology proposal of the CIRPASS-2 European project.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP CORE</rdfs:label>
        <owl:versionInfo>2.2.0</owl:versionInfo>
    </owl:Ontology>
    


