    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#related -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#related"/>
    


    <!-- https://ref.gs1.org/epcis/bizLocation -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/bizLocation">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:comment xml:lang="en">(Optional) The business location where the objects associated with the EPCs may be found, until contradicted by a subsequent event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>bizLocation</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/bizStep -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/bizStep">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/cbv/BizStep"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/cbv/BizStep"/>
        <rdfs:comment xml:lang="en">(Optional) The business step of which this event was a part.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>bizStep</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/bizTransactionList -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/bizTransactionList">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/epcis/BizTransaction"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/epcis/BizTransaction"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of business transactions that define the context of this event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>bizTransactionList</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/bizTransactionType -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/bizTransactionType">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/BizTransaction"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/cbv/BTT"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/BizTransaction"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/cbv/BTT"/>
        <rdfs:comment xml:lang="en">An identifier that indicates the type of BizTransaction document (e.g. Purchase Order, Despatch Advice).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>bizTransactionType</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <epcis:jsonldLabel>type</epcis:jsonldLabel>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/childEPCs -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/childEPCs">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/AggregationEvent"/>
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/AssociationEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/AggregationEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/AssociationEvent"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of the EPCs of contained objects identified by instance-level identifiers. An AggregationEvent SHALL contain either a nonempty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent.  An AssociationEvent SHALL contain either a non-empty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disassociated from the parent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>childEPCs</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/childQuantityList -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/childQuantityList">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/AggregationEvent"/>
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/AssociationEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/AggregationEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/AssociationEvent"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of one or more QuantityElements identifying (at the class level) contained objects. An AggregationEvent SHALL contain either a nonempty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent.  An AssociationEvent SHALL contain either a non-empty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>childQuantityList</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/destinationList -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/destinationList">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/epcis/SourceOrDestination"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/epcis/SourceOrDestination"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of Destination elements that provide context about the terminating endpoint of a business transfer of which this event is a part.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>destinationList</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/disposition -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/disposition">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/cbv/Disp"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/cbv/Disp"/>
        <rdfs:comment xml:lang="en">(Optional) The business condition of the objects associated with the EPCs, presumed to hold true until contradicted by a subsequent event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>disposition</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/epcClass -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/epcClass">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <rdfs:comment xml:lang="en">A class-level identifier for the class to which the specified quantity of objects belongs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>epcClass</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/epcList -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/epcList">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/ObjectEvent"/>
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/TransactionEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/ObjectEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/TransactionEvent"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of one or more EPCs naming specific objects to which the event pertained.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>epcList</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/inputEPCList -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/inputEPCList">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/TransformationEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/TransformationEvent"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of one or more EPCs identifying (at the instance level) objects that were inputs to the transformation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>inputEPCList</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/inputQuantityList -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/inputQuantityList">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/TransformationEvent"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/TransformationEvent"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of one or more QuantityElements identifying (at the class level) objects that were inputs to the transformation. See below for constraints on when inputQuantityList may be omitted.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>inputQuantityList</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/outputEPCList -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/outputEPCList">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/TransformationEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/TransformationEvent"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of one or more EPCs naming (at the instance level) objects that were outputs from the transformation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>outputEPCList</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/outputQuantityList -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/outputQuantityList">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/TransformationEvent"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/TransformationEvent"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of one or more QuantityElements identifying (at the class level) objects that were outputs from the transformation. See below for constraints on when outputQuantityList may be omitted.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>outputQuantityList</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/parentID -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/parentID">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/AggregationEvent"/>
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/AssociationEvent"/>
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/TransactionEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/AggregationEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/AssociationEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/TransactionEvent"/>
        <rdfs:comment xml:lang="en">(Optional when action is OBSERVE, required otherwise) The identifier of the parent of the aggregation or association. When the parent identifier is an EPC, this field SHALL contain the &apos;pure identity&apos; URI for the EPC as specified in the GS1 Tag Data Standard</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>parentID</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/quantityList -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/quantityList">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/ObjectEvent"/>
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/TransactionEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/ObjectEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/TransactionEvent"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of one or more QuantityElements identifying (at the class level) objects to which the event pertained.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>quantityList</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/readPoint -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/readPoint">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:comment xml:lang="en">(Optional) The read point at which the event took place.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>readPoint</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/sourceList -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/sourceList">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/epcis/SourceOrDestination"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/epcis/SourceOrDestination"/>
        <rdfs:comment xml:lang="en">(Optional) An unordered list of Source elements that provide context about the originating endpoint of a business transfer of which this event is a part.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>sourceList</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/sourceOrDestination -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/sourceOrDestination">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/SourceOrDestination"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/SourceOrDestination"/>
        <rdfs:comment xml:lang="en">An identifier that denotes the specific source or destination of a business transfer.
The semantic role of the identifier is indicated by sourceOrDestinationType. Resolution of that identifier to EU DPP Actor or Facility concepts, when applicable, is handled outside the EPCIS technical carrier layer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>sourceOrDestination</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <epcis:jsonldLabel>destination</epcis:jsonldLabel>
        <epcis:jsonldLabel>source</epcis:jsonldLabel>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/sourceOrDestinationType -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/sourceOrDestinationType">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/SourceOrDestination"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/cbv/SDT"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/SourceOrDestination"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/cbv/SDT"/>
        <rdfs:comment xml:lang="en">An identifier that indicates the role of SourceOrDestination in a transfer (Owning Party, Possessing Party, or Location).
This role determines how the corresponding sourceOrDestination identifier is interpreted. Mapping to EU DPP Actor or Facility concepts, when applicable, is handled outside the EPCIS technical carrier layer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>sourceOrDestinationType</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <epcis:jsonldLabel>type</epcis:jsonldLabel>
    </owl:ObjectProperty>
    


    <!-- https://ref.gs1.org/epcis/transformationID -->


    <owl:ObjectProperty rdf:about="https://ref.gs1.org/epcis/transformationID">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/TransformationEvent"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/epcis/Transformation"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/TransformationEvent"/>
        <schema:rangeIncludes rdf:resource="https://ref.gs1.org/epcis/Transformation"/>
        <rdfs:comment xml:lang="en">(Optional) Associates several TransformationEvents with a longer-running Transformation process, therefore linking them together.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>transformationID</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/address -->


    <owl:ObjectProperty rdf:about="https://schema.org/address">
        <rdfs:comment xml:lang="en">Links an Actor or Facility to its postal address, represented as a schema:PostalAddress</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/address"/>
        <rdfs:label xml:lang="en">has address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/geo -->


    <owl:ObjectProperty rdf:about="https://schema.org/geo">
        <rdfs:comment xml:lang="en">Links facility to its coordinates, represented as schema:geo.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/geo"/>
        <rdfs:label xml:lang="en">has coordinates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#accordingTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#accordingTo">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ConformityCertificate"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4
Decision No 768/2008/EC Art 4</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43	
ESPR Art 43</terms:source>
        <rdfs:comment xml:lang="en">Property defining specifies conformity assess procedure/cerfication scheme underlying the cerfificate.</rdfs:comment>
        <rdfs:label xml:lang="en">according to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#addressesAoP -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#addressesAoP">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:comment xml:lang="en">Link between an LCIAImpactCategory and the Area(s)-of-protection it addresses.
1..n cardinality: a single impact category can address several Areas of Protection — for example, ozone depletion affects both Natural Environment and Human Health.</rdfs:comment>
        <rdfs:label xml:lang="en">addresses AoP</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#allowsConformityAssessmentModule -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#allowsConformityAssessmentModule">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4
Decision No 768/2008/EC Art 4</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43
ESPR Art 43</terms:source>
        <rdfs:comment xml:lang="en">A property that specifies the conformity assment procedure applicable to the type of product</rdfs:comment>
        <rdfs:label xml:lang="en">allows Conformity Assessment Module</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#appliesToProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#appliesToProduct">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#hasDPP"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">The property links DPP and the Product.</rdfs:comment>
        <rdfs:label xml:lang="en">applies to product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#assessesImpactCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#assessesImpactCategory">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCIAImpactIndicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <rdfs:comment xml:lang="en">Link from an LCIA impact indicator to the mid-point impact category it characterises. Multiple indicators may assess the same category (e.g. Eutrophication, freshwater and Eutrophication, marine both relate to Eutrophication). This property expresses a conceptual classification link, not equivalence.</rdfs:comment>
        <rdfs:label xml:lang="en">assesses impact category</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element assessIC (https://w3id.org/lcanet/ia#assessIC) in the IA module.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#belongsToEn15804Group -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#belongsToEn15804Group">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EN15804Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#EN15804IndicatorGroup"/>
        <rdfs:comment xml:lang="en">Link from an EN15804Indicator individual to the indicator EN15804IndicatorGroup it belongs to (core impact, with-caveats, resource use, waste, valorisation, exported energy).</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to EN 15804 indicator group</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#belongsToMethodology -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#belongsToMethodology">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <rdfs:comment xml:lang="en">Link from a Method to one or several LCAMethodology individuals it belongs to (e.g. eudpp:methodology_EF3_1). Cardinality 1..n: a single method can be classified into more than one methodology (for example, when two methodologies share the same characterisation factors for one indicator).</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to methodology</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary>LCAnet: relates to the element includedInMethodology (https://w3id.org/lcanet/ia#includedInMethodology) in the IA module.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#computedByMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#computedByMethod">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:comment xml:lang="en">Link from an LCAIndicator individual to the IndicatorMethod instance that describes how this indicator is computed — its impact model, impact category, methodology reference, reference report, and ILCD method metadata. 
Cardinality: at most 1 per indicator individual.&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">computed by method</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#concernsDPP -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#concernsDPP">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPPEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:comment xml:lang="en">Links a DPP event to the Digital Product Passport whose content, state, or accessibility is affected by the event. This is a cross-module relation between EVENT and P_DPP and is therefore managed in the Connector/mapping layer.

DPP is modelled in the EU DPP CO P_DPP module.
DPPEvent is modelled in the EU DPP CO EVENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">concerns DPP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#concernsProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#concernsProduct">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">Links a product event to the product whose state, condition, or lifecycle is affected by the event. This is a cross-module relation between EVENT and P_DPP and is therefore managed in the Connector/mapping layer.

Product is modelled in the EU DPP CO P_DPP module.
ProductEvent is modelled in the EU DPP CO EVENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">concerns product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#concernsSubstance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#concernsSubstance">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceOfConcern"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a reported SubstancePresence to the SubstanceOfConcern involved. dpp:Substance remains the superclass used for generic substance identity and naming properties, but the SOC reporting relation itself is intentionally restricted to dpp:SubstanceOfConcern.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Concerns substance</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#conformityAttestedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#conformityAttestedBy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>ESPR Annex V (7)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Specifies the notified body that attest the product&apos;s conformity with Union harmonisation legislation. 

UnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">conformity attested by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#conformityDeclaredTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#conformityDeclaredTo">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <terms:source xml:lang="en">ESPR Annex V</terms:source>
        <rdfs:comment xml:lang="en">A property which specifies which Union Harmonisation Legislation conformity is declared to.</rdfs:comment>
        <rdfs:label xml:lang="en">conformity declared to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#containsSubstanceOfConcern -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#containsSubstanceOfConcern">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#MaterialOfComposition"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceOfConcern"/>
        <rdfs:comment xml:lang="en">Linking the product to a substance of concern the product contains.

Product is modelled in the EU DPP CO P_DPP module.
Substance of concern is modelled in the EU DPP CO SOC module.</rdfs:comment>
        <rdfs:label xml:lang="en">contains substance of concern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#declaresManufacturerRecord -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#declaresManufacturerRecord">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ManufacturerRecord"/>
        <rdfs:comment xml:lang="en">Links an LCA study to a manufacturer record documenting the manufacturers whose data is included in the study.</rdfs:comment>
        <rdfs:label xml:lang="en">declares Manufacturer Record</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element epd24:manufacturers/epd24:manufacturer</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#followsPCR -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#followsPCR">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EPDStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#PCR"/>
        <rdfs:comment xml:lang="en">Link from an EPDStudy to the Product Category Rules document(s) it follows (1..n).</rdfs:comment>
        <rdfs:label xml:lang="en">follows PCR</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element referenceToPCR.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#followsPEFCR -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#followsPEFCR">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#PEFCR"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy to a Product Environmental Footprint Category Rules document (1..n).</rdfs:comment>
        <rdfs:label xml:lang="en">follows PEFCR</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#forLifeCycleModule -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#forLifeCycleModule">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAModuleValue"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
        <rdfs:comment xml:lang="en">Link from an LCAModuleValue to the Life-cycle module it refers to.</rdfs:comment>
        <rdfs:label xml:lang="en">for life-cycle module</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the attribute @epd:module on epd:amount.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasActor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasActor">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Links actor role assignment to actor</rdfs:comment>
        <rdfs:label xml:lang="en">has actor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasActorRoleAssignment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasActorRoleAssignment">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#isActorRoleAssignmentForEvent"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ESPREvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:comment xml:lang="en">Links an event to an actor-role assignment that is valid in the context of that event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.

ESPREvent is modelled in the EU DPP CO EVENT module.
ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has actor role assignment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasApplicableQualification -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasApplicableQualification">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
        <terms:references xml:lang="en">ESPR Articles 2(27) and 7(5).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a SubstancePresence to an applicable qualification assertion; criterion (d) context is presence-scoped.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">has applicable qualification</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded contextual relation connecting a SubstancePresence to the qualification assertion applicable in that product-specific presence context.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasAuthorisedRepresentative -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasAuthorisedRepresentative">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>Decision No 768/2008/EC Annex I Art R1 (4)</terms:references>
        <terms:references>ESPR Annex V (2,9)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Specifies the natural or legal person established within the Union who has received a written mandate from a manufacturer to act on his behalf in relation to the Declaration of Conformity.

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.

Source: 
Decision No 768/2008/EC Annex I Art R1 (4)
https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I

ESPR Annex V (2,9)
https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</rdfs:comment>
        <rdfs:label xml:lang="en">has authorised representative</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasBackUpCopyHost -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasBackUpCopyHost">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>ESPR Annex III</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">The reference of the digital product passport service provider hosting the back-up copy of the digital product passport [ESPR Annex III].

DPP is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has back-up-copy host</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasComplianceDeclaration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasComplianceDeclaration">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ComplianceDeclaration"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy (or its subclass EPDStudy) to a ComplianceDeclaration. Compliance can be declared against any standard relevant to the study type (ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, PEFCR-specific rules, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">has compliance declaration</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element complianceDeclarations/compliance. Domain widened in v1.9.7 from EPDStudy to LCAStudy.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasConcentration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasConcentration">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern"/>
        <rdfs:comment xml:lang="en">Links a substance presence to concentration information. A concentration is contextual to the structural location identified by the associated SubstancePresence. 

Different product, component, or spare-part locations requiring different concentrations should normally use distinct SubstancePresence records. 

Exact, maximum, and range representations remain distinguished by the existing P_DPP/SOC concentration model.

ConcentrationOfSubstanceOfConcern is modelled in the EU DPP CO P_DPP module.
SubstancePresence is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has concentration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasDPP -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasDPP">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:comment xml:lang="en">A Product has a DPP. The property links a Product with a DPP.</rdfs:comment>
        <rdfs:label xml:lang="en">has DPP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasDPPActionType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasDPPActionType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPPUpdateEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPPActionType"/>
        <rdfs:comment xml:lang="en">Links a DPP update event to the type of information-level action performed on the Digital Product Passport.</rdfs:comment>
        <rdfs:label xml:lang="en">has DPP action type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasDigitalProductPassportId -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasDigitalProductPassportId">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPPIdentifier"/>
        <rdfs:comment xml:lang="en">Realisation for the Unique identifier of an instance of the digital product passport.

DPP is modelled in the EU DPP CO P_DPP module.
DPPIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has digital product passport id</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasDisassemblyInstruction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasDisassemblyInstruction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceManagementInstruction"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(e).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a substance presence to information relevant for disassembly.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Has disassembly instruction</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasEUDeclarationOfConformity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasEUDeclarationOfConformity">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <terms:references>Decision No 768/2008/EC Annex I Art R10</terms:references>
        <terms:references>ESPR Art 44</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44</terms:source>
        <rdfs:comment xml:lang="en">Specifies the EU declaration of conformity issued for the product.

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Product is modelled in the EU DPP CO P_DPP module.</rdfs:comment>
        <rdfs:label xml:lang="en">has EU Declaration of Conformity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasEconomicOperator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasEconomicOperator">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Linking the product to the economic operator (Actor from ACTOR module).

Product is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has economic operator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasEndOfLifeManagementInstruction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasEndOfLifeManagementInstruction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceManagementInstruction"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(e).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a substance presence to information relevant for environmentally sound management of the product at end-of-life.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Has end-of-life management instruction</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasExternalSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasExternalSource">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy to a background source. It can be a (a) documentation (e.g. an LCA project report, safety data sheet, or explanatory material) - covering the ILCD+EPD element referenceToExternalDocumentation on dataSetInformation, (b) databases or, (c)  literature sources used for modelling.</rdfs:comment>
        <rdfs:label xml:lang="en">has external source</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasFacility -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasFacility">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Facility"/>
        <rdfs:comment xml:lang="en">Links a product to a facility.

Product is modelled in the EU DPP CO P_DPP module.
Facility is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has facility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasGranularity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasGranularity">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#IdentifierGranularity"/>
        <rdfs:comment xml:lang="en">Defines the granularity of an identifier, if exists.</rdfs:comment>
        <rdfs:label xml:lang="en">has granularity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasImpactCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasImpactCategory">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <rdfs:comment xml:lang="en">Impact category addressed by the Method.</rdfs:comment>
        <rdfs:label xml:lang="en">has impact category</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element impactCategory on LCIAMethodDataSet.</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element hasImpactCategory (https://w3id.org/lcanet/ia#hasIC) in the IA module.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasImpactModel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasImpactModel">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ImpactModel"/>
        <rdfs:comment xml:lang="en">Link from an Method to its characterisation-model block (where applicable; inventory-only methods may not have one).</rdfs:comment>
        <rdfs:label xml:lang="en">has impact model</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element usesCM (https://w3id.org/lcanet/ia#usesCM) in the IA module.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasInventoryIndicatorResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasInventoryIndicatorResult">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasLCAResult"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">Sub-property of eudpp:hasLCAResult; range narrowed to eudpp:InventoryIndicatorResult.</rdfs:comment>
        <rdfs:label xml:lang="en">has inventory indicator result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element LCIAResults/LCIAResult when the indicator is an EN 15804+A2 inventory indicator (resource use, waste, output flows).</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasIssuer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasIssuer">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Linking DPP with its issuer (Actor from ACTOR module).

DPP is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has issuer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasLCAResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasLCAResult">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy (or its subclass EPDStudy) to one of its LCA results. Range is the abstract eudpp:LCAResult; sub-properties eudpp:hasLCIAResult and eudpp:hasInventoryResult narrow the result to the corresponding sibling subclass. Querying for eudpp:hasLCAResult retrieves both kinds of results in one go.</rdfs:comment>
        <rdfs:label xml:lang="en">has LCA result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasLCAStudy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasLCAStudy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:comment xml:lang="en">A product has a LCA Study -- a measurable outcome of a life cycle assessment, representing the quantified effect of a product.

Product is modelled in the EU DPP CO P_DPP module.
LCAStudy is modelled in the EU DPP CO LCA module.</rdfs:comment>
        <rdfs:label xml:lang="en">has LCA study</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasLCAVerifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasLCAVerifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Review"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>ISO 14025:2026, 9 and 10.4; ISO 14025:2006, 3.8 and 3.9; ISO 14044:2006, 6; EN 15804:2012+A2:2019, 7.1, Table 2</terms:references>
        <terms:source>https://www.iso.org/standard/87610.html</terms:source>
        <rdfs:comment xml:lang="en">Links a review to the independent, third-party actor responsible for validating the Life Cycle Assessment (LCA) or Environmental Product Declaration (EPD).

Verifier means a person or organisation that carries out the independent verification of an EPD or LCA study, i.e. confirms through objective evidence that the specified requirements are fulfilled, e.g. the PCR and EN 15804+A2. It also covers the critical reviewer of an LCA study and the verifier of a PEF study. Independent verification may be internal or external; EPDs for business-to-consumer communication require third-party verification, also comparative assertions under ISO 14040 and any comparisons under the European Commission’s ILCD Handbook. The type of verification is recorded on the Review (TypeOfReview). ILCD: reviewer (1-3-20-87); [ISO 14025:2006, 3.8, adapted]

Review is modelled in the EU DPP CO LCA module. 
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has LCA verifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasLCIAResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasLCIAResult">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasLCAResult"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCIAResult"/>
        <rdfs:comment xml:lang="en">Sub-property of eudpp:hasLCAResult; range narrowed to eudpp:LCIAResult.</rdfs:comment>
        <rdfs:label xml:lang="en">has LCIA result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element LCIAResults/LCIAResult when the indicator is an EN 15804+A2 impact indicator.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasLicenseType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasLicenseType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LicenseType"/>
        <rdfs:comment xml:lang="en">License applicable to the LCA / EPD study.</rdfs:comment>
        <rdfs:label xml:lang="en">has license type</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element publicationAndOwnership/licenseType.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasManufacturer">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">A product has a manufacturer (Actor from ACTOR module).

Product is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasManufacturingSite -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasManufacturingSite">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ManufacturerRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Facility"/>
        <rdfs:comment xml:lang="en">Links a manufacturer record to the facility it applies to, e.g., a production site covered by an LCA study or EPD. ILCD+EPD v1.3: manufacturer/sites/site.

ManufacturerRecord is modelled in the EU DPP CO LCA module.
Facility is modelled in the EU DPP CO ACTOR module.
        </rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturing site</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMaterial">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:comment xml:lang="en">Linking the Product to a MaterialOfComposition.

Product is modelled in the EU DPP CO P_DPP module.
MaterialOfComposition is modelled in the EU DPP CO MAT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has material</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasMaterialIdentifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMaterialIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#MaterialIdentifier"/>
        <rdfs:comment xml:lang="en">Realisation of thematerial indetifier as &quot;Product parameters: identification of  ... materials [ESPR Annex I c)]&quot;

MaterialOfComposition is modelled in the EU DPP CO MAT module.
MaterialIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has material identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasMaterialOrigin -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMaterialOrigin">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#MaterialOrigin"/>
        <rdfs:comment xml:lang="en">Assigns material origin to material used for product</rdfs:comment>
        <rdfs:label xml:lang="en">has material origin</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasMaterialType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMaterialType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#MaterialType"/>
        <rdfs:comment xml:lang="en">Links material to its type in some classification system used by the sector.</rdfs:comment>
        <rdfs:label xml:lang="en">has material type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasMeasurementUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMeasurementUnit">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:range rdf:resource="https://si-digital-framework.org/SI#MeasurementUnit"/>
        <rdfs:comment xml:lang="en">Linking quantitative property to the unit of measurement.</rdfs:comment>
        <rdfs:label xml:lang="en">has measurement unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasNextDPP -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasNextDPP">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#hasPreviousDPP"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:comment xml:lang="en">Link to successor DPP</rdfs:comment>
        <rdfs:label xml:lang="en">has next DPP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasNotifiedBody -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasNotifiedBody">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>Decision No 768/2008/EC Annex I Chapter R4</terms:references>
        <terms:references>ESPR Chapter IX</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#cpt_IX</terms:source>
        <rdfs:comment xml:lang="en">Specifies the conformity assessment body notified in accordance with ESPR Chapter IX	

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has notified body</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasPerModuleValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasPerModuleValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAModuleValue"/>
        <rdfs:comment xml:lang="en">Link from an LCAResult (LCIAResult or InventoryIndicatorResult) to one of its per-module (and optionally per-scenario) numerical values.</rdfs:comment>
        <rdfs:label xml:lang="en">has per module value</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element LCIAResult/other/epd:amount.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasPreparationForReuseInstruction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasPreparationForReuseInstruction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceManagementInstruction"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(e).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a substance presence to information relevant for preparation for reuse.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Has preparation-for-reuse instruction</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasPreviousDPP -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasPreviousDPP">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:comment xml:lang="en">Link to predecessor DPP</rdfs:comment>
        <rdfs:label xml:lang="en">has previous DPP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasProductEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasProductEvent">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#isRepresentedByCarrier"/>
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:comment xml:lang="en">Links an EPCIS-inspired technical event carrier to the product event semantics it journalises.</rdfs:comment>
        <rdfs:label xml:lang="en">has product event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasProductGroup -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasProductGroup">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ClassificationCode"/>
        <terms:references xml:lang="en">ESPR Art 2 (4)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product group
means a set of products that serve similar purposes and are similar in terms of use, or have similar
functional properties, and are similar in terms of consumer perception (ESPR Art 2 (4)). The product
group or groups covered are given by delegated acts. (ESPR Art 8 (a))

This will be probably a classification code from some product classification scheme .</rdfs:comment>
        <rdfs:label xml:lang="en">has product group</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasProductStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasProductStatus">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ProductStatus"/>
        <rdfs:comment xml:lang="en">Links a Product to its current lifecycle status, as declared in its DPP.
It gives the current status only; the history of changes is represented with the events. 
Product status is distinct from DPP status (#dppStatus), i.e., the status of the passport.

Product is modelled in the EU DPP CO P_DPP module.
ProductStatus is modelled in the EU DPP CO EVENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has product status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasProperty">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Property"/>
        <rdfs:comment xml:lang="en">Product has a property that could be a document or some measurable properties (measurands).

Linking the product to the property.</rdfs:comment>
        <rdfs:label xml:lang="en">has property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasQualificationAssertion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasQualificationAssertion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstanceOfConcern"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
        <terms:references xml:lang="en">ESPR Article 2(27).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a substance of concern to a documented qualification assertion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">has qualification assertion</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded modelling relation connecting a SubstanceOfConcern to an explicit Article 2(27) qualification assertion.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasRecyclingInstruction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasRecyclingInstruction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceManagementInstruction"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(e).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a substance presence to information relevant for recycling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Has recycling instruction</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasReferenceToBackgroundDatabase -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasReferenceToBackgroundDatabase">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasExternalSource"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#BackgroundDatabase"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy to a background LCI database used for the modelling (1..n). Sub-property of eudpp:hasExternalSource.</rdfs:comment>
        <rdfs:label xml:lang="en">has reference to background database</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasRepresentativeMandate -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasRepresentativeMandate">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#representsManufacturer"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment"/>
        <rdfs:comment xml:lang="en">Relates a manufacturer to the mandate (assignment) that authorises an actor to act on the manufacturer&apos;s behalf.</rdfs:comment>
        <rdfs:label xml:lang="en">has representative mandate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasResponsibleManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasResponsibleManufacturer">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>Decision No 768/2008/EC Annex I Art R1 (3)</terms:references>
        <terms:references>ESPR Annex V (2,9)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Defines the natural or legal person responsible for the EU declaration of conformity.


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has responsible manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasReuseInstruction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasReuseInstruction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceManagementInstruction"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(e).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a substance presence to information relevant for reuse.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Has reuse instruction</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasReview -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasReview">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Review"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy to a critical-review / verification record.</rdfs:comment>
        <rdfs:label xml:lang="en">has review</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element validation/review.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasRole">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#isRoleOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Role"/>
        <rdfs:comment xml:lang="en">Links an actor role assignment to a role.</rdfs:comment>
        <rdfs:label xml:lang="en">has role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasSafeUseInstruction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasSafeUseInstruction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceManagementInstruction"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(d).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a substance presence to relevant instructions for the safe use of the product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Has safe-use instruction</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasScheme -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasScheme">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:comment>The scheme/standard the Identifier follows</rdfs:comment>
        <rdfs:label xml:lang="en">has scheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasSoCCriterion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasSoCCriterion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">ESPR Article 2(27).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a qualification assertion to one or more non-exclusive criteria (a)-(d).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">has SoC criterion</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded modelling relation connecting a qualification assertion to one or more Article 2(27) qualification criteria.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasSubstanceIdentifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasSubstanceIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceIdentifier"/>
        <rdfs:comment xml:lang="en">Substance to an IDENT-owned SubstanceIdentifier link.

Substance is modelled in the EU DPP CO SOC module.
SubstanceIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has substance identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasSubstancePresence -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasSubstancePresence">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#isSubstancePresenceOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:comment xml:lang="en">Relation from Product to contextual SubstancePresence.

Product is modelled in the EU DPP CO P_DPP module.
SubstancePresence is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has substance presence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasTypeOfReview -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasTypeOfReview">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Review"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#TypeOfReview"/>
        <rdfs:comment xml:lang="en">The kind of review performed (independent external, accredited third party, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">has type of review</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the attribute review/@type.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasUnionHarmonisationLegislation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasUnionHarmonisationLegislation">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <terms:source xml:lang="en">ESPR Annex V, (5)</terms:source>
        <rdfs:comment xml:lang="en">A property providing the Union Harmonisation Legislation refered to in the EU Declaration of Conformity.</rdfs:comment>
        <rdfs:label xml:lang="en">has Union Harmonisation Legislation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasUniqueFacilityIdentifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasUniqueFacilityIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Facility"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#FacilityIdentifier"/>
        <terms:references>ESPR Art 2 (33)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Linking a Facility to its unique facility identifier.
Facility is modelled in the EU DPP CO ACTOR module.
FacilityIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has unique facility identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasUniqueOperatorIdentifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasUniqueOperatorIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ActorIdentifier"/>
        <terms:references>ESPR Art 2 (31)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Linking an Actor to their unique operator identifier. 
Actor is modelled in the EU DPP CO ACTOR module.
ActorIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has unique operator identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasUniqueProductIdentifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasUniqueProductIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ProductIdentifier"/>
        <rdfs:comment xml:lang="en">Realisation of the uniqueProductIdentifier.

Product is modelled in the EU DPP CO P_DPP module.
ProductIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has unique product identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#identifiesDataProvider -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#identifiesDataProvider">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ManufacturerRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Identifies the entity that supplied or submitted the inventory data for this record, which may be different from the manufacturer (e.g., an industry association, a consultant, or a consortium lead for an average EPD).

ManufacturerRecord is modelled in the EU DPP CO LCA module.
Actor is modelled in the EU DPP CO ACTOR module.
        </rdfs:comment>
        <rdfs:label xml:lang="en">identifies data provider</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#identifiesManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#identifiesManufacturer">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ManufacturerRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Identifies the specific economic operator or manufacturing company whose production process and product are represented by this manufacturer record.

ManufacturerRecord is modelled in the EU DPP CO LCA module.
Actor is modelled in the EU DPP CO ACTOR module.
        </rdfs:comment>
        <rdfs:label xml:lang="en">identifies manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#inContextOfDPP -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#inContextOfDPP">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:comment xml:lang="en">Relates the actor role assignment to a specific Digital Product Passport instance (from P_DPP module).

ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
DPP is modelled in the EU DPP CO P_DPP module.
        </rdfs:comment>
        <rdfs:label xml:lang="en">in context of DPP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#inContextOfProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#inContextOfProduct">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">Relates the actor role assignment to a specific product (from P_DPP module).

ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
Product is modelled in the EU DPP CO P_DPP module.</rdfs:comment>
        <rdfs:label xml:lang="en">in context of product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#includesMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#includesMethod">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:comment xml:lang="en">Link from a Method (a collection of methods sharing a methodology such as &quot;EF 3.1&quot;) to each of the individual-indicator method instances it aggregates.</rdfs:comment>
        <rdfs:label xml:lang="en">includes method</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element referenceToIncludedMethods.
ILCD+EPD LCIA Method Data Sets can represent either a single LCIA or inventory method (one indicator) or a methodology (a collection/list of methods); this property is used only in the latter case.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isActorRoleAssignmentForEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isActorRoleAssignmentForEvent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ESPREvent"/>
        <rdfs:comment xml:lang="en">Links an actor-role assignment to the event context in which the role assignment applies. This is the inverse of evt:hasActorRoleAssignment and is managed in the Connector/mapping layer.

ESPREvent is modelled in the EU DPP CO EVENT module.
ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">is actor role assignment for event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isComponentOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isComponentOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <terms:references xml:lang="en">ESPR Art 2(2)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">A product is a component of another product.

‘component’ means a product intended to be incorporated into another product; [ESPR Art 2(2)]</rdfs:comment>
        <rdfs:label xml:lang="en">is component of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isConformWith -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isConformWith">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">Specifies Union Harminised Lagislation for which conformity of the product is stated.</rdfs:comment>
        <rdfs:label xml:lang="en">is conform with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isConnectedTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isConnectedTo">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Facility"/>
        <rdfs:comment xml:lang="en">A DPP is connected to a facility.

DPP is modelled in the EU DPP CO P_DPP module.
Facility is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">is connected to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isEstablishedIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isEstablishedIn">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LegalPerson"/>
        <rdfs:range rdf:resource="http://purl.org/dc/terms/Location"/>
        <rdfs:comment xml:lang="en">Relates a legal person to the location where it is established.</rdfs:comment>
        <rdfs:label xml:lang="en">is established in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isIssuedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isIssuedBy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>ESPR Annex V (3)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Specifies the natural or legal person issuing the Declaration of Conformity; ESPR Annex V, paragraph 3 requirement: &quot;This declaration of conformity is issued under the sole responsibility of the manufacturer:&quot;


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">issued by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isLocatedInProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isLocatedInProduct">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">Location of a substance presence in a product, component or spare part, connection between substance presence and product.

Product is modelled in the EU DPP CO P_DPP module.
SubstancePresence is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">is located in product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isNotifiedFor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isNotifiedFor">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <terms:references>Decision No 768/2008/EC Annex I Art R23 (3)</terms:references>
        <terms:references>ESPR Article 56 (3)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_56</terms:source>
        <rdfs:comment xml:lang="en">Specifies the conformity assessment activities, the conformity assessment module or modules and product or products concerned and the relevant attestation of competence	

UnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">is notified for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isRecordedAs -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isRecordedAs">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPPEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPPEventRecord"/>
        <rdfs:comment xml:lang="en">Links a DPP event to a technical audit record representing its registration in an information system or audit trail.</rdfs:comment>
        <rdfs:label xml:lang="en">is recorded as</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isRepresentedByCarrier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isRepresentedByCarrier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:range rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:comment xml:lang="en">Links a product event concept to an EPCIS-inspired technical event carrier used to journalise and structure the corresponding event data.</rdfs:comment>
        <rdfs:label xml:lang="en">is represented by carrier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isResidingIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isResidingIn">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#NaturalPerson"/>
        <rdfs:range rdf:resource="http://purl.org/dc/terms/Location"/>
        <rdfs:comment xml:lang="en">Relates a natural person to the location where they reside.</rdfs:comment>
        <rdfs:label xml:lang="en">is residing in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isRoleOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isRoleOf">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Role"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:comment xml:lang="en">Relates role to an actor role assignment.</rdfs:comment>
        <rdfs:label xml:lang="en">is role of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isSignedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isSignedBy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>ESPR Annex V (9, 10)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Specifies the natural or legal person signying the Declaration of Conformity.


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">is signed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isSparePartOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isSparePartOf">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <terms:references xml:lang="en">ESPR Annex I</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">A product is a spare part of another product.</rdfs:comment>
        <rdfs:label xml:lang="en">is spare part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isSubstancePresenceOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isSubstancePresenceOf">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">Inverse relation from SubstancePresence to Product.

Product is modelled in the EU DPP CO P_DPP module.
SubstancePresence is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">is substance presence of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isTriggeredByProductEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isTriggeredByProductEvent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPPEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:comment xml:lang="en">Links a DPP event to the product event that caused or required it. This property is used when the DPP event results from a lifecycle change affecting the product.</rdfs:comment>
        <rdfs:label xml:lang="en">is triggered by product event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isUsedByActor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isUsedByActor">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#usesFacility"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Facility"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Relates a facility to an actor.</rdfs:comment>
        <rdfs:label xml:lang="en">is used by actor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#issuesCertificate -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#issuesCertificate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ConformityCertificate"/>
        <terms:references>ESPR Annex V (7)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Specifies conformity assessment certificate issued for a certification.


ConformityCertificate is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">issues certificate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#performedAssessmentAccordingTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#performedAssessmentAccordingTo">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:references>ESPR Annex V (7)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Specifies conformity assess procedure/cerfication scheme performed by the notified body.


ConformityAssessmentModule is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">performed assessment according to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#performedAt -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#performedAt">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Facility"/>
        <rdfs:comment xml:lang="en">Links a product event to the facility where the event was performed or operationally occurred. This is a cross-module relation between EVENT and ACTOR/Facility and is therefore managed in the Connector/mapping layer.

ProductEvent is modelled in the EU DPP CO EVENT module.
Facility is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">performed at</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://ref.gs1.org/epcis/bizLocation"/>
        <rdfs:seeAlso rdf:resource="https://ref.gs1.org/epcis/readPoint"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#performedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#performedBy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Links a product event to the actor that performed, carried out, or was operationally responsible for the event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.

ProductEvent is modelled in the EU DPP CO EVENT module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">performed by</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#qualifiesSubstance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#qualifiesSubstance">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#hasQualificationAssertion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceOfConcern"/>
        <terms:references xml:lang="en">ESPR Article 2(27).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a qualification assertion to the substance of concern that it positively qualifies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">qualifies substance</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded modelling relation connecting an explicit qualification assertion to the SubstanceOfConcern it qualifies.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#quantifiesIndicator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#quantifiesIndicator">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
        <rdfs:comment xml:lang="en">Link from an LCAResult (LCIAResult or InventoryIndicatorResult) to the LCAIndicator individual that this result quantifies. 
This is the primary semantic identity of a result: a result is a quantification of an indicator, not of a method. 
Cardinality: exactly 1 per result instance.
Range: LCAIndicator (covers both EN15804Indicator individuals and non-EN-15804 indicators).</rdfs:comment>
        <rdfs:label xml:lang="en">quantifies indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#recordedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#recordedBy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPPEventRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Links a DPP event record to the actor that created the technical record of the logged DPP-side event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.

DPPEventRecord is modelled in the EU DPP CO EVENT module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">recorded by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#recordsDPPEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#recordsDPPEvent">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#isRecordedAs"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPPEventRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPPEvent"/>
        <rdfs:comment xml:lang="en">Links a DPP event record to the DPP event whose technical registration it captures.</rdfs:comment>
        <rdfs:label xml:lang="en">records DPP event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToCompleteReviewReport -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToCompleteReviewReport">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Review"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ReviewReport"/>
        <rdfs:comment xml:lang="en">Link from a Review to the full review report.</rdfs:comment>
        <rdfs:label xml:lang="en">reference to complete review report</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element review/referenceToCompleteReviewReport.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToComplianceStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToComplianceStatus">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ComplianceDeclaration"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ComplianceStatus"/>
        <rdfs:comment xml:lang="en">Level of compliance declared by a ComplianceDeclaration (fully compliant, partially compliant, or not compliant).</rdfs:comment>
        <rdfs:label xml:lang="en">reference to compliance status</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToComplianceSystem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToComplianceSystem">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ComplianceDeclaration"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ComplianceSystem"/>
        <rdfs:comment xml:lang="en">Link from a ComplianceDeclaration to the standard or programme it references (EN 15804+A2, ISO 14025, ISO 21930, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">reference to compliance system</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element compliance/referenceToComplianceSystem.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToExternalSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToExternalSource">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Link from a Method to the external documentation describing the method.</rdfs:comment>
        <rdfs:label xml:lang="en">reference to external source</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element referenceToExternalDocumentation on LCIAMethodDataSet/dataSetInformation.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToLCAMethodReport -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToLCAMethodReport">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#referenceToExternalSource"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAMethodReport"/>
        <rdfs:comment xml:lang="en">Link from a Method to the formal LCIA method report (e.g. the EF 3.1 method description).</rdfs:comment>
        <rdfs:label xml:lang="en">reference to LCA method report</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToModelSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToModelSource">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ImpactModel"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Link from an ImpactModel to the bibliographic source(s) describing the characterisation model.</rdfs:comment>
        <rdfs:label xml:lang="en">reference to model source</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element referenceToModelSource.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToOriginalEPD -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToOriginalEPD">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EPDStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#EPDDocument"/>
        <rdfs:comment xml:lang="en">Link from the machine-readable EPDStudy to the published EPD document (typically PDF).</rdfs:comment>
        <rdfs:label xml:lang="en">reference to original EPD</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element epd2:referenceToOriginalEPD.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#relatesToLCAIndicator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#relatesToLCAIndicator">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EN15804ImpactIndicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCIAImpactIndicator"/>
        <rdfs:comment xml:lang="en">Relates an EN15804 impact indicator to the conceptually corresponding EF 3.1 / PEF LCIA impact indicator. 
The two indicators are not equivalent — EN15804 indicators are EPD-specific reporting slots defined by EN15804+A2, while LCIA impact indicators follow the broader EF 3.1 characterisation framework. This property records a conceptual correspondence without implying any equivalence.</rdfs:comment>
        <rdfs:label xml:lang="en">relates to LCA indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#representsManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#representsManufacturer">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Used when the role is authorisedRepresentativeRole to indicate the manufacturer being represented.</rdfs:comment>
        <rdfs:label xml:lang="en">represents manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#representsManufacturerForProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#representsManufacturerForProduct">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">Indicates which product(s) the authorised representative&apos;s mandate covers.

AuthorisedRepresentativeRoleAssignment is modelled in the EU DPP CO ACTOR module.
Product is modelled in the EU DPP CO P_DPP module.</rdfs:comment>
        <rdfs:label xml:lang="en">represents manufacturer for product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#triggersDPPEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#triggersDPPEvent">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#isTriggeredByProductEvent"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPPEvent"/>
        <rdfs:comment xml:lang="en">Links a product event to a DPP event that is triggered as a consequence of it, reflecting the obligation to update the DPP following lifecycle changes of the product.</rdfs:comment>
        <rdfs:label xml:lang="en">triggers DPP event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#usedForPresumptionOfConformity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#usedForPresumptionOfConformity">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ProductRequirement"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I	
Decision No 768/2008/EC Annex I Art R8</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_41
ESPR Art 41</terms:source>
        <rdfs:comment xml:lang="en">This property specifies which harmonised standards (or parts thereof) was used to assess conformity with the Union harmonistation legislation.</rdfs:comment>
        <rdfs:label xml:lang="en">used for presumtion of conformity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#usesFacility -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#usesFacility">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Facility"/>
        <rdfs:comment xml:lang="en">Relates an actor to facility.</rdfs:comment>
        <rdfs:label xml:lang="en">uses facility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/hasVersion -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/hasVersion"/>
    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- https://ref.gs1.org/epcis/action -->


    <owl:DatatypeProperty rdf:about="https://ref.gs1.org/epcis/action">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/AggregationEvent"/>
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/AssociationEvent"/>
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/ObjectEvent"/>
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/TransactionEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/AggregationEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/AssociationEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/ObjectEvent"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/TransactionEvent"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">How this event relates to the lifecycle of the EPCs named in this event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>action</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- https://ref.gs1.org/epcis/eventTime -->


    <owl:DatatypeProperty rdf:about="https://ref.gs1.org/epcis/eventTime">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="en">The date and time at which the EPCIS Capturing Applications asserts the event occurred.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>eventTime</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- https://ref.gs1.org/epcis/eventTimeZoneOffset -->


    <owl:DatatypeProperty rdf:about="https://ref.gs1.org/epcis/eventTimeZoneOffset">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The time zone offset in effect at the time and place the event occurred, expressed as an offset from UTC. The value of this field SHALL be a string consisting of the character &apos;+&apos; or the character &apos;-&apos;, followed by two digits whose value is within the range 00 through 14 (inclusive), followed by a colon character &apos;:&apos;, followed by two digits whose value is within the range 00 through 59 (inclusive), except that if the value of the first two digits is 14, the value of the second two digits must be 00. For example, the value +05:30 specifies that where the event occurred, local time was five hours and 30 minutes later than UTC (that is, midnight UTC was 5:30am local time).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>eventTimeZoneOffset</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- https://ref.gs1.org/epcis/quantity -->


    <owl:DatatypeProperty rdf:about="https://ref.gs1.org/epcis/quantity">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">A number that specifies how many or how much of the specified EPCClass is denoted by this QuantityElement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>quantity</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- https://ref.gs1.org/epcis/recordTime -->


    <owl:DatatypeProperty rdf:about="https://ref.gs1.org/epcis/recordTime">
        <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="en">(Optional) The date and time at which this event was recorded by an EPCIS Repository. This field SHALL be ignored when an event is presented to the EPCIS Capture Interface, and SHALL be present when an event is retrieved through the EPCIS Query Interfaces. The recordTime does not describe anything about the real-world event, but is rather a bookkeeping mechanism that plays a role in the interpretation of standing queries</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>recordTime</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- https://ref.gs1.org/epcis/uom -->


    <owl:DatatypeProperty rdf:about="https://ref.gs1.org/epcis/uom">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/QuantityElement"/>
                    <rdf:Description rdf:about="https://ref.gs1.org/epcis/SensorReport"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/QuantityElement"/>
        <schema:domainIncludes rdf:resource="https://ref.gs1.org/epcis/SensorReport"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">(Optional) Unit of measure by which the specified value(s) of the property specified by type should be interpreted.  If there is no value, minValue, maxValue, averageValue or percValue field present, uom SHALL be omitted.  When a uom field is present, its value SHALL be the 2- or 3-character code for a physical unit specified in the &apos;Common Code&apos; column of UN/CEFACT Recommendation&apos;20 [CEFACT20].   Note: GS1 provides a tool containing a machine-readable file which enables the automatic conversion between quantitative values expressed using UN/CEFACT common codes. [https://ref.gs1.org/tools/UnitConverterUNECERec20]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>uom</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/email -->


    <owl:DatatypeProperty rdf:about="https://schema.org/email">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Links an Actor to its email address.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/email"/>
        <rdfs:label xml:lang="en">has email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/latitude -->


    <owl:DatatypeProperty rdf:about="https://schema.org/latitude">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Links facility to its coordinates. Part of schema:geo.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/latitude"/>
        <rdfs:label xml:lang="en">latitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/longitude -->


    <owl:DatatypeProperty rdf:about="https://schema.org/longitude">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Links facility to its coordinates. Part of schema:geo.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/longitude"/>
        <rdfs:label xml:lang="en">longitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/telephone -->


    <owl:DatatypeProperty rdf:about="https://schema.org/telephone">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Links an Actor to its phone.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/telephone"/>
        <rdfs:label xml:lang="en">has phone</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/url -->


    <owl:DatatypeProperty rdf:about="https://schema.org/url">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">The official website or webpage of the actor.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/url"/>
        <rdfs:label xml:lang="en">URL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#abbreviation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#abbreviation">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#otherName"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(ii)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">An abbreviation used for the substance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Abbreviation</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#accessRestrictions -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#accessRestrictions">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Human-readable description of access and use restrictions for the LCA / EPD study (equivalent to dcterms:accessRights).</rdfs:comment>
        <rdfs:label xml:lang="en">access restrictions</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element accessRestrictions.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#actorName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#actorName">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of an actor.</rdfs:comment>
        <rdfs:label xml:lang="en">actor name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#amount -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#amount">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#LCAModuleValue"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#LCAResult"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Numerical value of an LCA result or an LCIAModuleValue.</rdfs:comment>
        <rdfs:label xml:lang="en">amount</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: corresponds to the text content of epd:amount inside LCIAResult/other.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#assignedELI -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#assignedELI">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli-register/what_is_eli.html</terms:source>
        <rdfs:comment xml:lang="en">Standardised identification that makes it easier to identify and describe legislation across Europe.</rdfs:comment>
        <rdfs:label xml:lang="en">assigned ELI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#assignmentValidFrom -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#assignmentValidFrom">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date and time from which the actor role assignment is valid.</rdfs:comment>
        <rdfs:label xml:lang="en">assignment valid from</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#assignmentValidTo -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#assignmentValidTo">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date and time until which the actor role assignment is valid.</rdfs:comment>
        <rdfs:label xml:lang="en">assignment valid to</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#casName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#casName">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(iv)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The Chemical Abstracts Service name of the substance, when available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">CAS name</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#casNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#casNumber">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(iv)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The Chemical Abstracts Service registry number of the substance, when available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">CAS number</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#certificateNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#certificateNumber">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ConformityCertificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:source xml:lang="en">certificate number</terms:source>
        <rdfs:comment>Number of the certificate</rdfs:comment>
        <rdfs:label>certificate number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#certificateRevisionNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#certificateRevisionNumber">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ConformityCertificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Number of the revision of a certificate</rdfs:comment>
        <rdfs:label xml:lang="en">certificate revision number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#codeSet -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#codeSet">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ClassificationCode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">The product classification code set.

See also Produc hasProductGroup ClassificationCode documentation.</rdfs:comment>
        <rdfs:label xml:lang="en">classification code set</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#codeValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#codeValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ClassificationCode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Classification code value from the Classification code set.</rdfs:comment>
        <rdfs:label xml:lang="en">classification code value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#commodityCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#commodityCode">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Annex III (d)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Relevant commodity codes, such as a TARIC code as defined in Council Regulation (EEC) No 2658/87.[ESPR Annex III (d)]</rdfs:comment>
        <rdfs:label xml:lang="en">commodity code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#contentType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#contentType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>application</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>pdf</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Content type of a document. Can be only “application” or “pdf”.</rdfs:comment>
        <rdfs:label xml:lang="en">content type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#countryOfOrigin -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#countryOfOrigin">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Represents customs/regulatory country of origin, which may be distinct from facility location. 

Note: not specified by ESPR, requested by sectors (reasoning: country of origin must not be inferred automatically from facility country).

Recommended ISO 3166-1 country codes.</rdfs:comment>
        <rdfs:label xml:lang="en">country of origin</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#dataSetVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#dataSetVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Version number of this LCA / EPD study instance, independent of the ontology version. Format: major.minor.sub-minor (e.g. &quot;02.00.011&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">data set version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element publicationAndOwnership/dataSetVersion.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#description -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#description">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Product description</rdfs:comment>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#dictionaryReference -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#dictionaryReference">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Property"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The reference to the unique identifier of the data point specification defined in the repository/data dictionary.

It is formatted as a URI/URL .</rdfs:comment>
        <rdfs:label xml:lang="en">dictionary reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#dppBackupUrl -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#dppBackupUrl">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Fallback URL providing direct access to Digital Product Passport data in case the primary provider becomes unavailable.</rdfs:comment>
        <rdfs:label xml:lang="en">DPP backup URL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#dppEventRecordIdentifier -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#dppEventRecordIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPPEventRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">A unique identifier assigned to a DPP event record.</rdfs:comment>
        <rdfs:label xml:lang="en">dpp event record identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#dppEventRecordedAt -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#dppEventRecordedAt">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPPEventRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date and time at which the technical record of a DPP event was created in an information system or audit trail.</rdfs:comment>
        <rdfs:label xml:lang="en">dpp event recorded at</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#dppSchemaVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#dppSchemaVersion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The reference standard the DPP instance schema refers to.</rdfs:comment>
        <rdfs:label xml:lang="en">DPP schema version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#dppStatus -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#dppStatus">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Active</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Archived</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Inactive</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>Invalid</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The status of the DPP instance as digital resource.</rdfs:comment>
        <rdfs:label xml:lang="en">DPP status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#dppUrl -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#dppUrl">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Provides the HTTP/URI endpoint to access the live DPP.</rdfs:comment>
        <rdfs:label xml:lang="en">DPP URL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#ecNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#ecNumber">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(iii)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The European Community number indicated in EINECS, ELINCS or the No Longer Polymer list, when available and appropriate.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">EC number</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#echaNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#echaNumber">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(iii)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">A number assigned to the substance by the European Chemicals Agency, when available and appropriate.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">ECHA number</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#epdFormatVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#epdFormatVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EPDStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Version tag of the ILCD+EPD format used (e.g. &quot;1.3&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">EPD format version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the attribute @epd2:epd-version on processDataSet.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#expiryDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#expiryDate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EPDStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which the EPD&apos;s validity expires. EN 15804+A2 EPDs are typically valid for five years from publication.</rdfs:comment>
        <rdfs:label xml:lang="en">expiry date</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element epd2:expirationDateOfEPD on time/other.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#forScenario -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#forScenario">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAModuleValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Identifier of the scenario this LCIAModuleValue applies to (free-text label matching the EPD&apos;s scenario declaration).</rdfs:comment>
        <rdfs:label xml:lang="en">for scenario</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the attribute @epd:scenario on epd:amount.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#granularity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#granularity">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>batch</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>item</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>model</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <terms:references xml:lang="en">ESPR Art 9 (2) d</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">ESPR Art 9 (2) d  declares that the digital product passport is to be established at model, batch or item level, and the definition of such levels (is determined by delegated acts (DA));

The product passport should be defined at the level of item, batch or product model, depending on specific needs and complexity of the value chain, the size, nature or impacts of the products considered. (Standardisation Request 5423 7)</rdfs:comment>
        <rdfs:label xml:lang="en">granularity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#hasCopyright -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#hasCopyright">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if a copyright applies to the LCA / EPD study, false otherwise.</rdfs:comment>
        <rdfs:label xml:lang="en">has copyright</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element publicationAndOwnership/copyright. Modelled as xsd:boolean per the ILCD+EPD schema definition (two-valued).</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierExampleValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierExampleValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Example value of the identifier</rdfs:comment>
        <rdfs:label xml:lang="en">identifier example value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierExpiresOn -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierExpiresOn">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Identifier expiration date</rdfs:comment>
        <rdfs:label xml:lang="en">identifier expires on</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierIssuedOn -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierIssuedOn">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date of issuing the identifier</rdfs:comment>
        <rdfs:label xml:lang="en">identifier issued on</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierJurisdiction -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierJurisdiction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:length rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:length>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:pattern>[A-Z]{2}</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">An optional property used to qualify the issuing country or territory required to disambiguate national registration numbers. 

Format: ISO 3166-1 alpha-2, i.e., two-letter country code, such as FR for France, DE for Germany, EE for Estonia, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">identifier juristiction</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierMaxLength -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierMaxLength">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Maximum length of the identifier</rdfs:comment>
        <rdfs:label xml:lang="en">identifier maximum length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierMinLength -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierMinLength">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Minimum length of the identifier</rdfs:comment>
        <rdfs:label xml:lang="en">identifier minimum length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierPattern -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierPattern">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A pattern the identifier conforms to, given as a regular expression (regex).</rdfs:comment>
        <rdfs:label xml:lang="en">identifier pattern</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierSchemeIssuer -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierSchemeIssuer">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Issuer of the identifier scheme</rdfs:comment>
        <rdfs:label xml:lang="en">identifier scheme issuer</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierSchemeVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierSchemeVersion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Reference standard version the instance schema refers to</rdfs:comment>
        <rdfs:label xml:lang="en">identifier scheme version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The (unique) value of the identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">identifier value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#ilcdFormatVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#ilcdFormatVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">ILCD schema version used by the source serialisation of this study (e.g. &apos;1.1&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">ILCD format version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the attribute @version on processDataSet.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#internationalName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#internationalName">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(i)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">An internationally recognised name for the substance, used when an IUPAC name is not available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">International name</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#isCriticalRawMaterial -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#isCriticalRawMaterial">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:references xml:lang="en">[ESPR Annex I h)]</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters: use or content of recycled materials and recovery of materials, including critical raw materials; [ESPR Annex I h)]</rdfs:comment>
        <rdfs:label xml:lang="en">critical raw material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#isDeclared -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#isDeclared">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAModuleValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if this module value is declared in the study (has a numerical amount), false if the module is explicitly marked as not declared (ND / MND) for this indicator/scenario. Absence of the LCIAModuleValue triple altogether means the module was not in scope of the study (MNA - module not applicable).</rdfs:comment>
        <rdfs:label xml:lang="en">is declared</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#isEnergyRelated -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#isEnergyRelated">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:references xml:lang="en">ESPR Art 2 (4)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Energy related product
means any product that has an impact on energy consumption during use. (ESPR Art 2 (4)).

The boolean data type property indicates is a Product energy related or not?</rdfs:comment>
        <rdfs:label xml:lang="en">is energy related Product</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#isReplaceable -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#isReplaceable">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the product (e.g. a component of another product) can be replaced.</rdfs:comment>
        <rdfs:label xml:lang="en">is replacable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#iupacName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#iupacName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#internationalName"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(i)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The name of the substance in the International Union of Pure and Applied Chemistry nomenclature.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">IUPAC name</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#lastUpdate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#lastUpdate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="en">The date and time of the latest update to the DPP instance.</rdfs:comment>
        <rdfs:label xml:lang="en">last update</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#linkToPreviousDPP -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#linkToPreviousDPP">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">ESPR Art 11 (d)</terms:references>
        <terms:references>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:references>
        <rdfs:comment xml:lang="en">Where a new digital product passport is created for a product that already has a digital product passport, the new digital product passport shall be linked to the original digital product passport or passports. (ESPR Art 11 (d))</rdfs:comment>
        <rdfs:label xml:lang="en">link to previous DPP</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#manufacturingDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#manufacturingDate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">Date of manufacture of the product. 

The range of the data property is intentionally left open to be specified in accordance of sectorial needs.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturing date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialComponent -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialComponent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The specific part of the Product this material belongs to. Description. 
For example, in case of a textile product: [Main, Lining, Filling].</rdfs:comment>
        <rdfs:label xml:lang="en">part of product material is in</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialComponentLabel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialComponentLabel">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:comment xml:lang="en">Optional human-readable label identifying the role or part of the product associated with the material component (e.g. outer layer, lining, filling, casing).

Note: not defined by ESPR, requested by sectors (textile)</rdfs:comment>
        <rdfs:label xml:lang="en">material component label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialIsRecyclable -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialIsRecyclable">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:references xml:lang="en">ESPR Art 5 (1n), Annex I d)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters: design for recycling, ease and quality of recycling as expressed through use of easily recyclable materials [ESPR Art 5 (1n), Annex I d)]</rdfs:comment>
        <rdfs:label xml:lang="en">recyclable material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialIsSustainableRenewable -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialIsSustainableRenewable">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:references xml:lang="en">ESPR Annex I i)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters: use or content of sustainable renewable materials; [ESPR Annex I i)]</rdfs:comment>
        <rdfs:label xml:lang="en">sustainale or renewable material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialPercentage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialPercentage">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Material percentage in a Product, e.g., mass fraction (percentage by weight).</rdfs:comment>
        <rdfs:label xml:lang="en">material percentage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialRecycledContent -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialRecycledContent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Percentage of recycled content</rdfs:comment>
        <rdfs:label xml:lang="en">recycled content amount in material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialRecycledContentType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialRecycledContentType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>post-consumer</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>pre-consumer</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>unknown</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Specifies the origin of recycled content: pre-consumer (manufacturing waste) or post-consumer (end-of-life waste), as required by regulatory differentiation.</rdfs:comment>
        <rdfs:label xml:lang="en">material recycled content type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialTypeScheme -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialTypeScheme">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Reference system (e.g. ISO 11224, EU Textile Regulation 1007/2011 Annex I)</rdfs:comment>
        <rdfs:label xml:lang="en">material type scheme</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialTypeValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialTypeValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Code or label in the chosen nomenclature (specified by #materialTypeScheme).</rdfs:comment>
        <rdfs:label xml:lang="en">material type value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#maximumNumericalValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#maximumNumericalValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ConcentrationRange"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(c)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The upper bound of a concentration range.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Maximum numerical value</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#methodVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#methodVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Version of the specific LCIA or Inventory method instance (where applicable). Captures method-instance-level versioning, distinct from methodology-level versioning (eudpp:methodologyVersion on LCAMethodology).</rdfs:comment>
        <rdfs:label xml:lang="en">method version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#methodologyVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#methodologyVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Version identifier of an LCAMethodology individual (e.g. &quot;3.1&quot; for EF 3.1, &quot;2002&quot; for CML 2002).</rdfs:comment>
        <rdfs:label xml:lang="en">methodology version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#minimumNumericalValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#minimumNumericalValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ConcentrationRange"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(c)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The lower bound of a concentration range.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Minimum numerical value</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#modelVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#modelVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ImpactModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Version of the characterisation model used (e.g. &quot;IPCC AR6 2021&quot; vs &quot;IPCC AR5 2013&quot;, which give different GWP100 values).</rdfs:comment>
        <rdfs:label xml:lang="en">model version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#numericalValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#numericalValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The numerical value of the quantity, i.e., quantitative property of the product.</rdfs:comment>
        <rdfs:label xml:lang="en">numerical value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#otherName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#otherName">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(ii)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Another name used for the substance, including a usual name, trade name or abbreviation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Other name</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#productImage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#productImage">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">An image of the product.</rdfs:comment>
        <rdfs:label xml:lang="en">product image</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#productName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#productName">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Product name</rdfs:comment>
        <rdfs:label xml:lang="en">product name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#productTradeMark -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#productTradeMark">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">EUIPO guidelines 3.2.3.1 Trade Mark Guidelines</terms:references>
        <terms:source>https://guidelines.euipo.europa.eu/1803468/1787175/trade-mark-guidelines/3-2-3-1-trade-names</terms:source>
        <rdfs:comment xml:lang="en">Trade marks identify goods or services as produced or marketed by a particular undertaking.

Trade mark required by ESPR Art 27(6), Art 29(3), Art 36 (1a).

When placing a product on the market, importers should indicate on the product their name, registered trade name or registered trade mark as well as the postal address at which and electronic means of communication through which they can be contacted. ESPR Preamble (64).</rdfs:comment>
        <rdfs:label xml:lang="en">product trade mark</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#providesLCAData -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#providesLCAData">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ManufacturerRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the manufacturer identified in this record directly provided primary LCA data for the study. Set to true for the reference manufacturer; may be false for manufacturers listed for traceability only.</rdfs:comment>
        <rdfs:label xml:lang="en">provides LCA data</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#qualificationNote -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#qualificationNote">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">Qualification assertion metadata.</terms:references>
        <rdfs:comment xml:lang="en">Additional explanation or limitation of the qualification assertion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">qualification note</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">Modelling metadata for an explicit SoC qualification assertion.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#qualificationValidFrom -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#qualificationValidFrom">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <terms:references xml:lang="en">Versioned qualification metadata.</terms:references>
        <rdfs:comment xml:lang="en">First date on which the qualification assertion is considered valid.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">qualification valid from</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">Modelling metadata for the temporal validity of an explicit SoC qualification assertion.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#qualificationValidUntil -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#qualificationValidUntil">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <terms:references xml:lang="en">Versioned qualification metadata.</terms:references>
        <rdfs:comment xml:lang="en">Last date on which the qualification assertion is considered valid, when bounded.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">qualification valid until</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">Modelling metadata for the temporal validity of an explicit SoC qualification assertion.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#recordedInSystem -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#recordedInSystem">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPPEventRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Indicates the URI identifying the system, application, or audit log in which the DPP event record is maintained.</rdfs:comment>
        <rdfs:label xml:lang="en">recorded in system</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#recordedInSystemName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#recordedInSystemName">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPPEventRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Indicates the human-readable name of the system, application, or audit log in which the DPP event record is maintained.</rdfs:comment>
        <rdfs:label xml:lang="en">recorded in system name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#referenceYear -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#referenceYear">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="en">Start year of the time period for which the study is valid.</rdfs:comment>
        <rdfs:label xml:lang="en">reference year</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element time/referenceYear on processDataSet.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#registeredTradeName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#registeredTradeName">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Trade name under which a legal person or business operates and is registered.</rdfs:comment>
        <rdfs:label xml:lang="en">registered trade name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#registrationNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#registrationNumber">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EPDStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Identifying number issued by the EPD programme operator (typically visible on the EPD document). Distinct from the dataset UUID.</rdfs:comment>
        <rdfs:label xml:lang="en">registration number</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element publicationAndOwnership/registrationNumber.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#reviewDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#reviewDate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Review"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which the review was completed. Important for DPP consumers to assess whether the review is still current.</rdfs:comment>
        <rdfs:label xml:lang="en">review date</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#substanceLocationDescription -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#substanceLocationDescription">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(b)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">A textual description of the location of the substance within the product, used where the location cannot be represented solely by linking to a product, component or spare part.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Location description</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#tolerance -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#tolerance">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Engineering tolerance is the permissible variation in measurements deriving from the base measurement.
Tolerances can apply to many different units.</rdfs:comment>
        <rdfs:label xml:lang="en">tolerance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#tradeName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#tradeName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#otherName"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(ii)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">A trade name under which the substance is known.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Trade name</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#usualName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#usualName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#otherName"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(ii)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">A usual name under which the substance is known.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Usual name</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#uuid -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#uuid">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The Universally Unique Identifier of this LCA / EPD study, as mandated by ILCD+EPD as the primary persistent identifier. Once a study is created and a UUID is generated, the UUID stays the same forever; any change increments eudpp:dataSetVersion. String formatted as an RFC 4122 UUID (36 characters, hyphenated).</rdfs:comment>
        <rdfs:label xml:lang="en">UUID</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#validFrom -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#validFrom">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="en">The date and timestamp that the DPP is valid from.</rdfs:comment>
        <rdfs:label xml:lang="en">valid from</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#validUntil -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#validUntil">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="en">The date and timestamp that the DPP is valid until.</rdfs:comment>
        <rdfs:label xml:lang="en">valid until</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#value -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#value">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Contains the data of the value encapsulated in the Document.

Value is xsd:string that is formatted as a URL,  where to fetch the file.</rdfs:comment>
        <rdfs:label xml:lang="en">value related to the document</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#webLink -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#webLink">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DigitalInstruction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Web link to an instruction document or video etc.</rdfs:comment>
        <rdfs:label xml:lang="en">weblink</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/facilityName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/facilityName">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Facility"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Optional human-readable name of the facility.</rdfs:comment>
        <rdfs:label xml:lang="en">facility name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/Location -->


    <owl:Class rdf:about="http://purl.org/dc/terms/Location">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms"/>
        <rdfs:label xml:lang="en">Location</rdfs:label>
    </owl:Class>
    


    <!-- http://spdx.org/rdf/terms#License -->


    <owl:Class rdf:about="http://spdx.org/rdf/terms#License"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    


    <!-- http://www.w3.org/ns/prov#Activity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
    


    <!-- http://www.w3.org/ns/prov#Entity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- https://ref.gs1.org/cbv/BTT -->


    <owl:Class rdf:about="https://ref.gs1.org/cbv/BTT"/>
    


    <!-- https://ref.gs1.org/cbv/BizStep -->


    <owl:Class rdf:about="https://ref.gs1.org/cbv/BizStep"/>
    


    <!-- https://ref.gs1.org/cbv/Disp -->


    <owl:Class rdf:about="https://ref.gs1.org/cbv/Disp"/>
    


    <!-- https://ref.gs1.org/cbv/SDT -->


    <owl:Class rdf:about="https://ref.gs1.org/cbv/SDT"/>
    


    <!-- https://ref.gs1.org/epcis/AggregationEvent -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/AggregationEvent">
        <rdfs:subClassOf rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:comment xml:lang="en">The event type AggregationEvent describes events that apply to objects that have been aggregated to one another. In such an event, there is a set of &apos;contained&apos; objects that have been aggregated within a &apos;containing&apos; entity that&apos;s meant to identify the aggregation itself.  This event type is intended to be used for &apos;aggregations&apos;, meaning an association where there is a strong physical relationship between the containing and the contained objects such that they will all occupy the same location at the same time, until such time as they are disaggregated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>AggregationEvent</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <epcis:jsonldUriLabel>eventID</epcis:jsonldUriLabel>
    </owl:Class>
    


    <!-- https://ref.gs1.org/epcis/AssociationEvent -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/AssociationEvent">
        <rdfs:subClassOf rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:comment xml:lang="en">The event type AssociationEvent describes the association or disassociation of one or several physical objects with a parent object or a specific physical location.  Like the AggregationEvent, the AssociationEvent is also used to capture associations where there is a strong physical relationship between the containing and the contained objects such that they will all occupy the same location at the same time, until such time as they are disaggregated. However, the AggregationEvent does not allow for associations of objects with physical locations;  if action is DELETE while omitting the childEPC and childQuantityList field, all contained children are disaggregated from the containing parent. Because there are situations in which associations are more permanent, i.e. beyond the physical flow of goods (e.g. packing/unpacking and loading/unloading), an AssociationEvent SHOULD be used: (a) when objects need to be associated with a physical location or (b) when the parent object could also be subject to other, more temporary associations (i.e. captured using AggregationEvent).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>AssociationEvent</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <epcis:jsonldUriLabel>eventID</epcis:jsonldUriLabel>
    </owl:Class>
    


    <!-- https://ref.gs1.org/epcis/BizTransaction -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/BizTransaction">
        <rdfs:comment xml:lang="en">Document that describes a particular business transaction. An example is a specific Purchase Order or Despatch Advice. Business Transaction information may be included in EPCIS events to record an event&apos;s participation in particular business transactions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>BizTransaction</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <epcis:jsonldUriLabel>bizTransaction</epcis:jsonldUriLabel>
    </owl:Class>
    


    <!-- https://ref.gs1.org/epcis/EPCISEvent -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/EPCISEvent">
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#DPPEventRecord"/>
        <rdfs:comment xml:lang="en">A logistics event. This is a common superclass (base type) for all EPCIS events. All of the more specific event types are subclasses of EPCISEvent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>EPCISEvent</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:Class>
    


    <!-- https://ref.gs1.org/epcis/ObjectEvent -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/ObjectEvent">
        <rdfs:subClassOf rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:comment xml:lang="en">An ObjectEvent captures information about an event pertaining to one or more physical or digital objects identified by instance-level (EPC) or class-level (EPC Class) identifiers. In most situations, an ObjectEvent is envisioned to represent an actual observations of objects, but strictly speaking it can be used for any event a Capturing Application wants to assert about objects, including for example capturing the fact that an expected observation failed to occur.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>ObjectEvent</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <epcis:jsonldUriLabel>eventID</epcis:jsonldUriLabel>
    </owl:Class>
    


    <!-- https://ref.gs1.org/epcis/QuantityElement -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/QuantityElement">
        <rdfs:comment xml:lang="en">A QuantityElement is a structure that identifies objects identified by a specific class-level identifier, either a specific quantity or an unspecified quantity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>QuantityElement</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:Class>
    


    <!-- https://ref.gs1.org/epcis/SensorReport -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/SensorReport"/>
    


    <!-- https://ref.gs1.org/epcis/SourceOrDestination -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/SourceOrDestination">
        <rdfs:comment xml:lang="en">Provides additional business context when an EPCIS event is part of a business transfer; that is, a process in which there is a change of location, or transfer of ownership, or transfer of possession of physical or digital objects. Within a specified type of transfer, the business transfer is from the Source to the Destination.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>Source or Destination</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <epcis:jsonldUriLabel>id</epcis:jsonldUriLabel>
    </owl:Class>
    


    <!-- https://ref.gs1.org/epcis/TransactionEvent -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/TransactionEvent">
        <rdfs:subClassOf rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:comment xml:lang="en">The event type TransactionEvent describes the association or disassociation of physical or digital objects to one or more business transactions. While other event types have an optional bizTransactionList field that may be used to provide context for an event, the TransactionEvent is used to declare in an unequivocal way that certain objects have been associated or disassociated with one or more business transactions as part of the event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>TransactionEvent</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <epcis:jsonldUriLabel>eventID</epcis:jsonldUriLabel>
    </owl:Class>
    


    <!-- https://ref.gs1.org/epcis/Transformation -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/Transformation">
        <rdfs:comment xml:lang="en">A transformation business processes that takes a longer period of time than a single TransformationEvent, so is associated with a series of such events.
When events share the same Transformation, the meaning is that the inputs to any of those events may have contributed in some way to each of the outputs in any of those same events.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>Transformation</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:Class>
    


    <!-- https://ref.gs1.org/epcis/TransformationEvent -->


    <owl:Class rdf:about="https://ref.gs1.org/epcis/TransformationEvent">
        <rdfs:subClassOf rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
        <rdfs:comment xml:lang="en">A TransformationEvent captures information about an event in which one or more physical or digital objects identified by instance-level (EPC) or class-level (EPC Class) identifiers are fully or partially consumed as inputs and one or more objects identified by instance-level (EPC) or class-level (EPC Class) identifiers are produced as outputs. The TransformationEvent captures the relationship between the inputs and the outputs, such that any of the inputs may have contributed in some way to each of the outputs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
        <rdfs:label>TransformationEvent</rdfs:label>
        <ns:term_status>stable</ns:term_status>
        <epcis:jsonldUriLabel>eventID</epcis:jsonldUriLabel>
    </owl:Class>
    


    <!-- https://schema.org/GeoCoordinates -->


    <owl:Class rdf:about="https://schema.org/GeoCoordinates">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://schema.org/latitude"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://schema.org/longitude"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/GeoCoordinates"/>
    </owl:Class>
    


    <!-- https://schema.org/PostalAddress -->


    <owl:Class rdf:about="https://schema.org/PostalAddress">
        <rdfs:isDefinedBy rdf:resource="https://schema.org/PostalAddress"/>
    </owl:Class>
    


    <!-- https://si-digital-framework.org/SI#MeasurementUnit -->


    <owl:Class rdf:about="https://si-digital-framework.org/SI#MeasurementUnit">
        <rdfs:comment xml:lang="en">Measurement unit defining the magnitude of the quantity in respect to the value.
si:MeasurementUnit class is reused</rdfs:comment>
        <rdfs:label xml:lang="en">Unit of measurement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Actor -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Actor">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://schema.org/address"/>
                <owl:allValuesFrom rdf:resource="https://schema.org/PostalAddress"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references xml:lang="en">CIRPASS-2 User Stories 3.1</terms:references>
        <terms:source>https://zenodo.org/records/17979585</terms:source>
        <rdfs:comment xml:lang="en">Actor means a legal or natural person (e.g. John Doe, TNO). One actor can take on multiple roles; [CIRPASS-2 User Stories 3.1]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/ACTOR"/>
        <rdfs:label xml:lang="en">Actor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ActorIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ActorIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasScheme"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp#ActorIdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#DPPIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#FacilityIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#MaterialIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SoCIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SubstanceIdentifier"/>
        <rdfs:comment xml:lang="en">A type of identifier to identify Actors. A unique code assigned to Actor based on a scheme.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/IDENT"/>
        <rdfs:label xml:lang="en">Actor identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ActorIdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ActorIdentifierScheme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#FacilityIdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#MaterialIdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SubstanceIdentifierScheme"/>
        <rdfs:comment xml:lang="en">A kind of identifier scheme. The scheme or standard used to identify Actors. e.g., GLN, LEI, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Actor identifier scheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ActorRoleAssignment -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ActorRoleAssignment">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasRole"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/eudpp#Role"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Assigns a role to the actor in a particular context (DPP, Product, Event).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/ACTOR"/>
        <rdfs:label xml:lang="en">Actor role assignment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#AreaOfProtection -->


    <owl:Class rdf:about="https://w3id.org/eudpp#AreaOfProtection">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#aopHumanHealth"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#aopManMadeEnvironment"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#aopNaturalEnvironment"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#aopNaturalResources"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#aopOther"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Damage area addressed by an LCIA method via the LCIA Impact Category class using the addressesAoP object property. A closed enumeration of 5 individuals.</rdfs:comment>
        <rdfs:label xml:lang="en">Area of Protection</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: corresponds to the element AreaOfProtectionValues.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment -->


    <owl:Class rdf:about="https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasRole"/>
                <owl:hasValue rdf:resource="https://w3id.org/eudpp#authorisedRepresentative"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:references xml:lang="en">ESPR Art 2 (43)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">A specific assignment representing the written mandate between a manufacturer and an authorised representative; [ESPR Art 2 (43)]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/ACTOR"/>
        <rdfs:label xml:lang="en">Authorised representative role assignment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#AuthorityRole -->


    <owl:Class rdf:about="https://w3id.org/eudpp#AuthorityRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Role"/>
        <rdfs:comment xml:lang="en">Parent class for roles of authorities, such as market surveillance authority, customs authority, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Authority role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#BackgroundDatabase -->


    <owl:Class rdf:about="https://w3id.org/eudpp#BackgroundDatabase">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source representing a background LCI database used for the LCA modelling (e.g. ecoinvent, GaBi/Sphera, Okobaudat).</rdfs:comment>
        <rdfs:label xml:lang="en">Background Database</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#CarbonFootprint -->


    <owl:Class rdf:about="https://w3id.org/eudpp#CarbonFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCIAResult"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                        <owl:hasValue rdf:resource="https://w3id.org/eudpp#ind_EF_climateChange"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                        <owl:hasValue rdf:resource="https://w3id.org/eudpp#ind_GWPtotal"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An LCIAResult that &quot;means the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category of climate change&quot;. (ESPR Art 2 25))
 
It quantifies the global warming potential of a product over a 100-year time horizon.
Instances of this class quantify either the EN 15804+A2 individual &quot;GWP-total - Global Warming Potential (total)&quot; (ind_GWPtotal, an EN15804ImpactIndicator) or the EF 3.1 &quot;Climate Change EF&quot; indicator (ind_EF_climateChange, an LCIAImpactIndicator), depending on the reporting framework of the EPD or LCA study.</rdfs:comment>
        <rdfs:label xml:lang="en">Carbon Footprint</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ESPR Art 2 (25) https://eur-lex.europa.eu/eli/reg/2024/1781/oj</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element CarbonFootprint (https://w3id.org/lcanet/ia#CarbonFootprint) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#CircularEconomyIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#CircularEconomyIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment xml:lang="en">Circular Economy indicators are measures for relevant monitoring the transition to a circular economy and to measure the effects of new policy and trends.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Circular Economy Indicator</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://environment.ec.europa.eu/strategy/circular-economy-action-plan_en"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#CircularEconomyRole -->


    <owl:Class rdf:about="https://w3id.org/eudpp#CircularEconomyRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Role"/>
        <rdfs:comment xml:lang="en">Parent class for roles related to circular economy, such as remanufacturer, refurbisher, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Circular economy role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ClassificationCode -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ClassificationCode">
        <rdfs:comment xml:lang="en">A classification code from some product classification scheme .</rdfs:comment>
        <rdfs:label xml:lang="en">ClassificationCode</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#CommonSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp#CommonSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#TechnicalSpecification"/>
        <terms:source xml:lang="en">ESPR Art 42, https://eur-lex.europa.eu/eli/reg/2024/1781/oj#art_42</terms:source>
        <rdfs:comment xml:lang="en">Common specification means ecodesign requirements, essential requirements for digital product passports or test, measurement or calculation methods established by implementing acts adopted by the Commission for products covered by delegated acts pursuant to ESPR Article 4.</rdfs:comment>
        <rdfs:label xml:lang="en">Common Specification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ComplianceDeclaration -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ComplianceDeclaration">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A statement that the LCA or EPD study complies with a given compliance system (typically ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, or a PEFCR). The level of compliance (fully, partially, not compliant) is recorded via eudpp:complianceStatus.</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance Declaration</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element complianceDeclarations/compliance.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ComplianceStatus -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ComplianceStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#fullyCompliant"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#notCompliant"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#partiallyCompliant"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Level of compliance declared by a ComplianceDeclaration relative to its compliance system. Enumeration of 3 named individuals (fullyCompliant, partiallyCompliant, notCompliant).</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance Status</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ComplianceSystem -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ComplianceSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">A standard or programme against which an LCA or EPD study is declared compliant, such as ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, PEFCR programmes, or a specific programme operator&apos;s scheme.</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance System</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <terms:references xml:lang="en">ESPR Art 7(5)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">The concentration of the substances of concern, at the level of the product, its relevant components, or spare parts ESPR Art 7(5)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/P_DPP"/>
        <rdfs:label xml:lang="en">Concentration of the substance of concern</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ConcentrationRange -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ConcentrationRange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#MaximumConcentration"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(c)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">A concentration reported as an interval with a minimum and a maximum numerical value. The measurement unit is provided through dpp:hasMeasurementUnit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Concentration range</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ConformityAssessmentModule -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ConformityAssessmentModule">
        <terms:source xml:lang="en">Decision No 768/2008/EC Art 4, https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4</terms:source>
        <terms:source xml:lang="en">ESPR Art 43, https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43</terms:source>
        <rdfs:comment xml:lang="en">Conformity Assessment module means the possible conformity assessment elements that can be chosen, in accordance with certain criteria, to fullfill the conformity accessement required to be performed by Community harmonisation legislation in respect of a particular product.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/COMP</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Conformity Assessment Module</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ConformityAssessmentRole -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ConformityAssessmentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Role"/>
        <terms:references xml:lang="en">ESPR Art 2 (51)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Conformity assessment means the process demonstrating whether the ecodesign requirements set out in the relevant delegated acts adopted pursuant to Article 4 have been fulfilled; [ESPR Art 2 (51)]</rdfs:comment>
        <rdfs:label xml:lang="en">Conformity assessment role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ConformityCertificate -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ConformityCertificate">
        <terms:source xml:lang="en">Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4, https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001</terms:source>
        <terms:source xml:lang="en">ESPR Annex III (e)</terms:source>
        <rdfs:comment xml:lang="en">Conformity assessment certificate for a certification. The blue guide uses the term &quot;cerficate of conformity&quot;. The ESPR uses &quot;conformity certificate&quot; as well as &quot;certificate&quot; and &quot;approval decision&quot;.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/COMP</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Conformity Certificate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DPP -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DPP">
        <terms:references xml:lang="en">ESPR Art 2 (28)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Digital Product Passport (DPP) means a set of data specific to a product that includes the information specified in the applicable
delegated act adopted pursuant to Article 4 and that is accessible via electronic means through a data carrier in accordance with Chapter III. (ESPR Art 2 (28))</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/P_DPP"/>
        <rdfs:label xml:lang="en">Digital Product Passport (DPP)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DPPActionType -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DPPActionType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#AddDPPDataAction"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#CorrectDPPDataAction"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#DeleteDPPDataAction"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#ModifyDPPDataAction"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A classification indicating the type of information-level action performed during a DPP update event.</rdfs:comment>
        <rdfs:label xml:lang="en">DPP Action Type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DPPArchivalEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DPPArchivalEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DPPEvent"/>
        <rdfs:comment xml:lang="en">An event corresponding to the archival or end-of-active-life management of a Digital Product Passport.</rdfs:comment>
        <rdfs:label xml:lang="en">DPP Archival Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DPPCreationEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DPPCreationEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DPPEvent"/>
        <rdfs:comment xml:lang="en">An event corresponding to the creation or initial issuance of a Digital Product Passport.</rdfs:comment>
        <rdfs:label xml:lang="en">DPP Creation Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DPPEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DPPEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ESPREvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#isTriggeredByProductEvent"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#DPPEventRecord"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:comment xml:lang="en">An ESPR-level event concept representing an event that affects the existence, content, accessibility, update, correction, or governance of a DPP. A DPPEvent captures the passport-facing semantics of the occurrence and is modelled as distinct from the product event that may trigger it.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/EVENT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DPP Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DPPEventRecord -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DPPEventRecord">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#recordsDPPEvent"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#DPPEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#dppEventRecordIdentifier"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#dppEventRecordedAt"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#recordedInSystem"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#recordedInSystemName"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source xml:lang="en">Defined in the EU DPP Core Ontology Event module to support the technical recording of DPP-related events.</terms:source>
        <rdfs:comment xml:lang="en">A technical audit record used to represent and log an information-level event affecting a Digital Product Passport. Unlike EPCIS carriers, this class is intended for recording DPP-side information events rather than product-facing operational events.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/EVENT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DPP Event Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DPPIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DPPIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#FacilityIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#MaterialIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SoCIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SubstanceIdentifier"/>
        <rdfs:comment xml:lang="en">A type of identifier to identify DPP. DPP Identifier.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/IDENT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DPP identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DPPUpdateEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DPPUpdateEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DPPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasDPPActionType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#DPPActionType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An event corresponding to an update of the content of a Digital Product Passport.</rdfs:comment>
        <rdfs:label xml:lang="en">DPP Update Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DestructionEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DestructionEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <terms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:identifier>
        <terms:source xml:lang="en">Regulation (EU) 2024/1781; Art 2(34); Art 25(1)</terms:source>
        <rdfs:comment xml:lang="en">The intentional damaging or discarding of a product and unsold products as waste, with the exception of discarding for the sole purpose of delivering the discarded product for preparing for reuse, including refurbishment or remanufacturing operations. ESPR Art 2(34) and Art 25(1).</rdfs:comment>
        <rdfs:label xml:lang="en">Destruction</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DigitalInstruction -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DigitalInstruction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
        <terms:references xml:lang="en">ESPR Art 27(7)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Digital instructions
mean instructions in digital format concerning the product (‘digital instructions’) in a language that can be easily understood. ESPR Art 27(7)
Digital instructions are ensured by manufacturers. These should also ensured by importers. (ESPR Art 29(4))

This class can be extended/specialised according to delegated acts or industry standards.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/P_DPP"/>
        <rdfs:label xml:lang="en">DigitalInstruction</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DocumentFormattedProperty -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DocumentFormattedProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <rdfs:comment xml:lang="en">The document class describes the semantic representation of any instance of a document that might be required to be included into a digital product passport instance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/P_DPP"/>
        <rdfs:label xml:lang="en">Document</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Durability -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Durability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QualityIndicator"/>
        <terms:references xml:lang="en">ESPR Art 2 (22)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Durability
means the ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair. (ESPR Art 2 (22))

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Durability</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EN15804ImpactIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EN15804ImpactIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#EN15804Indicator"/>
        <rdfs:comment xml:lang="en">An EN 15804+A2 characterised impact indicator (core set of 13 or the 6 additional &quot;with caveats&quot; indicators). Characterised via the EF 3.1 characterisation models. Results computed for this indicator are eudpp:LCIAResult instances.</rdfs:comment>
        <rdfs:label xml:lang="en">EN 15804 Impact Indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EN15804Indicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EN15804Indicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
        <rdfs:comment xml:lang="en">An indicator defined by EN 15804+A2 (core impact, impact with caveats, resource use, waste output, or output-flow indicator). 
Subclass of the abstract eudpp:LCAIndicator parent. 
Note: an EN15804Indicator individual is the indicator definition; a result computed for that indicator is an eudpp:LCAResult instance (LCIAResult or InventoryIndicatorResult sibling).</rdfs:comment>
        <rdfs:label xml:lang="en">EN 15804 Indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EN15804IndicatorGroup -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EN15804IndicatorGroup">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_coreImpact"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_exportedEnergy"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_resourceUse"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_valorisation"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_waste"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_withCaveats"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Grouping of the EN 15804+A2 indicators based on the printed standard&apos;s tables: core impact (Table 3), impact indicators with caveats (Table 4), resource use (Table 5 resource use), waste categories (Table 5 waste), output flows valorisation (Table 5 output flows), exported energy (Table 5 output flows). Enumeration of 6 named individuals.</rdfs:comment>
        <rdfs:label xml:lang="en">EN 15804 Indicator Group</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EN15804InventoryIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EN15804InventoryIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#EN15804Indicator"/>
        <rdfs:comment xml:lang="en">An EN 15804+A2 inventory-level indicator (resource use, waste disposed, or output flow for valorisation / exported energy). Not characterised; value is an aggregated inventory quantity. Results computed for this indicator are eudpp:InventoryIndicatorResult instances.</rdfs:comment>
        <rdfs:label xml:lang="en">EN 15804 Inventory Indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EPDDocument -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EPDDocument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source representing the published PDF or HTML EPD document itself (as distinct from the ILCD+EPD machine-readable EPDStudy).</rdfs:comment>
        <rdfs:label xml:lang="en">EPD Document</rdfs:label>
        <skos:broadMatch rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EPDStudy -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EPDStudy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:comment xml:lang="en">An LCA study that conforms to EN 15804+A2 with EF 3.1 characterisation, i.e. an Environmental Product Declaration. Inherits all study-level metadata from eudpp:LCAStudy (compliance declarations, manufacturer records, reviews, LCA results, etc.) and adds EPD-specific properties: ILCD+EPD format version (eudpp:epdFormatVersion), registration number, expiry date, reference to the published EPD document (eudpp:EPDDocument via referenceToOriginalEPD), reference to the applicable Product Category Rules (eudpp:PCR via referenceToPCR). EN 15804+A2 module values per LCAResult are used to populate per-life-cycle-module values. Replaces v1.9.4&apos;s mixed structure and v1.9.5&apos;s eudpp:EPDDataSet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/LCA"/>
        <rdfs:label xml:lang="en">EPD Study</rdfs:label>
        <rdfs:label xml:lang="de">EPD-Studie</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://indatawg.github.io/ILCD-EPD-Data-Format/doc/"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ESPREvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ESPREvent">
        <terms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:identifier>
        <terms:source xml:lang="en">Regulation (EU) 2024/1781; lifecycle-event-oriented abstraction introduced for modelling purposes.</terms:source>
        <rdfs:comment xml:lang="en">Abstract superclass introduced for modelling purposes. Used to represent the regulatory or business semantics of an event relevant in the ESPR context and concerning either a product or its DPP, independently of its technical journalisation.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/EVENT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ESPR Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EUDeclarationOfConformity -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EUDeclarationOfConformity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
        <terms:source xml:lang="en">Decision No 768/2008/EC Annex I Art R10, https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source xml:lang="en">ESPR Art 44, https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44</terms:source>
        <rdfs:comment xml:lang="en">The EU Declaration of Conformity shall state that the fulfilment of the ecodesign requirements specified in the applicable delegated acts adopted pursuant to ESPR Article 4 has been demonstrated or that a presumption of conformity applies in accordance with ESPR Article 41.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/COMP</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">EU Declaration of Conformity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EconomicOperatorRole -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EconomicOperatorRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Role"/>
        <terms:references xml:lang="en">ESPR Art 2 (46)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Economic operator means the manufacturer, the authorised representative, the importer, the distributor, the dealer and the fulfilment service provider; [ESPR Art 2 (46)]</rdfs:comment>
        <rdfs:label xml:lang="en">Economic operator role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EmissionToAir -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EmissionToAir">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#EnvironmentalEmission"/>
        <terms:references xml:lang="en">ESPR Annex I</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters are listed in the ESPR Annex I :

(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Emission to air</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EmissionToSoil -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EmissionToSoil">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#EnvironmentalEmission"/>
        <terms:references xml:lang="en">ESPR Annex I</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters are listed in the ESPR Annex I :

(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Emission to soil</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EmissionToWater -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EmissionToWater">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#EnvironmentalEmission"/>
        <terms:references xml:lang="en">ESPR Annex I</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters are listed in the ESPR Annex I :

(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Emission to water</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EndUserRole -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EndUserRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Role"/>
        <rdfs:comment xml:lang="en">Parent class for roles of end users, such as consumer, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">End user role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EnergyConsumptionResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EnergyConsumptionResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An LCA inventory indicator result quantifying the consumption of primary energy resources — renewable and non-renewable — in a product system. 
Commonly associated with the EN 15804+A2 primary energy indicators (e.g. PERE, PERM, PERT, PENRE, PENRM, PENRT), though no formal quantifiesIndicator restriction is imposed, as energy consumption may span multiple indicators depending on the study scope.</rdfs:comment>
        <rdfs:label xml:lang="en">Energy Consumption Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EnvironmentalEmission -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EnvironmentalEmission">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#EnvironmentalPollution"/>
        <rdfs:comment xml:lang="en">Emission is the act or amount of sending out gas, heat, light, etc. It can also refer to harmful substances that are released into the environment, especially carbon dioxide.


This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental emission</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://dictionary.cambridge.org/dictionary/english/emission"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EnvironmentalFootprintScore -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EnvironmentalFootprintScore">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
        <rdfs:comment xml:lang="en">An aggregated single-score indicator computed as the normalised and weighted sum of a set of impact-category results. 
Holds one named individual eudpp:ind_EF_singleScore representing the EU Environmental Footprint single score (PEF score). The applied normalisation factors and weighting set are not modelled here as properties; they are determined by the active EF / PEF methodology version, which is resolvable via the study&apos;s eudpp:hasComplianceDeclaration link to a eudpp:ComplianceSystem source. 
Results computed for an EnvironmentalFootprintScore individual are eudpp:LCIAResult instances.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Footprint Score</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EnvironmentalFootprintScoreResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EnvironmentalFootprintScoreResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#EnvironmentalFootprintScore"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A normalized and weighted aggregate LCA result expressing the overall environmental performance of a product system as a single dimensionless score, computed by applying the Product Environmental Footprint (PEF) method (Recommendation (EU) 2021/2279). 
Aggregates the characterised results of all 16 EF 3.1 impact categories through normalization and weighting factors.
Instances of this class quantify the EF single score indicator (ind_EF_singleScore, an EnvironmentalFootprintScore individual) via quantifiesIndicator.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Footprint Score Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology: third sibling subclass of eudpp:LCAResult alongside eudpp:LCIAResult and eudpp:InventoryIndicatorResult, introduced to represent the aggregated EF single score result.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EnvironmentalPollution -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EnvironmentalPollution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment xml:lang="en">Environmental pollution is the addition of any substance or form of energy to the environment at a rate faster than it can be dispersed or safely stored.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental pollution</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.britannica.com/science/pollution-environment"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Facility -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Facility">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://schema.org/address"/>
                <owl:allValuesFrom rdf:resource="https://schema.org/PostalAddress"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://schema.org/geo"/>
                <owl:allValuesFrom rdf:resource="https://schema.org/GeoCoordinates"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source>https://marketbusinessnews.com/financial-glossary/facility/</terms:source>
        <rdfs:comment xml:lang="en">A Facility may be a place where specific activities occur. A production/manufacturing facility means a factory. The term may refer to any place that makes things, or plants that generate electricity.</rdfs:comment>
        <rdfs:comment xml:lang="en">Business facilities are structures that provide services to a business. This can include space for employees, technology, equipment and inventory. Facilities can be used for business administration, operations or to provide services to customers.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/ACTOR"/>
        <rdfs:label xml:lang="en">Facility</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#FacilityIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#FacilityIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#MaterialIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SoCIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SubstanceIdentifier"/>
        <rdfs:comment xml:lang="en">A unique code assigned to a physical site (factory, warehouse, plant, school, hospital, etc.), i.e., identifies a location.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/IDENT"/>
        <rdfs:label xml:lang="en">Facility identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#FacilityIdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#FacilityIdentifierScheme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#MaterialIdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SubstanceIdentifierScheme"/>
        <rdfs:comment xml:lang="en">A kind of identifier scheme. The scheme or standard used to identify Facilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Facility identifier scheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#HarmonisedStandard -->


    <owl:Class rdf:about="https://w3id.org/eudpp#HarmonisedStandard">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductRequirement"/>
        <terms:source xml:lang="en">Regulation (EU) No 1025/2012 Art 2 (1c), https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2</terms:source>
        <rdfs:comment xml:lang="en">Harmonised Standard means a European standard adopted on the basis of a request made by the Commission for the application of Union harmonisation legislation.</rdfs:comment>
        <rdfs:label xml:lang="en">Harmonised Standard</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#HazardousWasteAmount -->


    <owl:Class rdf:about="https://w3id.org/eudpp#HazardousWasteAmount">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#WasteGenerationAmount"/>
        <rdfs:comment xml:lang="en">Hazardous waste amount of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Hazardous waste amount</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Height -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Height">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:comment xml:lang="en">Height of the product</rdfs:comment>
        <rdfs:label xml:lang="en">Height</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Identifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Identifier">
        <rdfs:comment xml:lang="en">Identifier. A general class to hold different kinds of identifiers described and used for EU DPP CO. Each sub-class of this class describes a different kind of identifier. Intentionally modelled as sub-classes. 
Identifiers have value, and a scheme/standard they are based on.

Cardinatlity restrictions added to each subclass to enforce inheritance of the data propertyy identifierValue.</rdfs:comment>
        <rdfs:label>Identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#IdentifierGranularity -->


    <owl:Class rdf:about="https://w3id.org/eudpp#IdentifierGranularity">
        <rdfs:comment xml:lang="en">The granularity of the identifier. For example, for Products this could be model, batch, item.</rdfs:comment>
        <rdfs:label xml:lang="en">Identifier granularity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#IdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#IdentifierScheme">
        <rdfs:comment xml:lang="en">The scheme or standard used for Identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">Identifier scheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ImpactModel -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ImpactModel">
        <rdfs:comment xml:lang="en">The characterisation model underlying an LCIA method (e.g. IPCC AR6 2021 for GWP). It carries a model name (eudpp:modelName), optional version (eudpp:modelVersion), and optional bibliographic source (eudpp:referenceToModelSource).</rdfs:comment>
        <rdfs:label xml:lang="en">Impact Model</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: corresponds to the element impactModel of an LCIA Method Data Set.</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element CharacterizationModel (https://w3id.org/lcanet/ia#CharacterizationModel) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#InventoryIndicatorResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#InventoryIndicatorResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#EN15804InventoryIndicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A specific LCA result representing an aggregated inventory-indicator result computed for an EN 15804+A2 inventory indicator (Table 5: resource use, waste categories, output flows). 
Important disambiguation: this class represents the AGGREGATED inventory-indicator value (e.g. total kg of HWD across A1-A3 for one product), as printed in EN 15804+A2 EPD tables and computed by a Method instance. It is NOT the raw flow-level life-cycle inventory (LCI) result of a process (which would be a list of elementary-flow exchanges with amounts and units, and is out of scope for this DPP-oriented LCA module).</rdfs:comment>
        <rdfs:label xml:lang="en">Inventory Indicator Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAIndicator">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#computedByMethod"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Abstract umbrella class for an indicator definition (impact or inventory category) that an eudpp:Method calculates values for. 
Each instance identifies exactly one method under which it is computed; this constraint is formalised as owl:maxCardinality 1 on eudpp:computedByMethod. 
Note: an indicator individual is the indicator DEFINITION (e.g. &quot;FW – Net use of fresh water, in m3&quot;); a numerical value computed for that indicator on a specific study is an eudpp:LCAResult instance (LCIAResult or InventoryIndicatorResult).</rdfs:comment>
        <rdfs:label xml:lang="en">LCA Indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAMethod">
        <rdfs:comment xml:lang="en">A life-cycle assessement method that produces values for one indicator from an inventory of elementary flows. 
Covers both (a) characterised LCIA methods (which apply characterisation factors to compute a midpoint impact result), and (b) inventory aggregation methods (which sum / aggregate inventory flows to produce an inventory-indicator result, e.g. the EN 15804+A2 inventory indicators FW, HWD, PERE etc. defined as inventory-level by the standard&apos;s calculation rules).</rdfs:comment>
        <rdfs:label xml:lang="en">LCA Method</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://indatawg.github.io/ILCD-EPD-Data-Format/gitBranches/release/v1.3/schemadoc/ILCD_LCIAMethodDataSet.html"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: corresponds to the element LCIA Method Data Set, which is used in practice for both LCIA method and inventory indicator methods.</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element Method (https://w3id.org/lcanet/ia#Method) in the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAMethodReport -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAMethodReport">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source that documents a life-cycle impact assessment (LCIA) method (e.g. the EF 3.1 method description).</rdfs:comment>
        <rdfs:label xml:lang="en">LCIA Method Report</rdfs:label>
        <skos:broadMatch rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAMethodology -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAMethodology">
        <rdfs:comment xml:lang="en">A named, versioned LCA methodology (a coherent set of LCA methods sharing principles and a set of characterisation factors), to which one or more Method instances belong. 
Each individual SHOULD carry a skos:altLabel giving a short code (e.g. &quot;EF 3.1&quot;) and eudpp:methodologyVersion giving the version identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">LCA Methodology</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element Methodology (https://w3id.org/lcanet/ia#Methodology) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAModuleValue -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAModuleValue">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#forLifeCycleModule"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#amount"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#isDeclared"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#forScenario"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">One numerical LCA-result value (impact or inventory-indicator) for a specific EN 15804+A2 life-cycle module (A1-A3, A4, ..., D) and optionally a specific scenario. 
It carries eudpp:amount (the numeric value), eudpp:forLifeCycleModule, optionally eudpp:forScenario, and eudpp:isDeclared (boolean: true if the module is declared with this value; false if the module is explicitly not declared for this indicator).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/LCA"/>
        <rdfs:label xml:lang="en">LCA Module Value</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: corresponds to the element epd:amount inside LCIAResult/other.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Abstract class for any LCA computation output of a study. Has three subclasses: 
eudpp:LCIAResult (characterised impact result) which applies characterisation factors of an LCIA method, eudpp:InventoryIndicatorResult (aggregated inventory-indicator result) whcih is a sum/aggregation over the inventory without characterisation, and eudpp:EnvironmentalFootprintScoreResult which represents the aggregated EF single score result. 

In the regulatory sense of ESPR Art. 2(24), some characterized individuals of LCAResult constitute environmental footprints — quantifications of environmental impacts of a product throughout its life cycle.Other LCAResult instances, however, fall outside the strict ESPR definition. For this reason, LCAResult is linked to the ESPR &quot;Environmental Footprint&quot; concept via skos:broadMatch rather than owl:equivalentClass.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/LCA"/>
        <rdfs:label xml:lang="en">LCA Result</rdfs:label>
        <skos:broadMatch xml:lang="en">ESPR Art 2 (24) https://eur-lex.europa.eu/eli/reg/2024/1781/oj#Art2_24</skos:broadMatch>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element LcaResult (https://w3id.org/lcanet/ia#LcaResult) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAStudy -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAStudy">
        <rdfs:comment xml:lang="en">A life-cycle assessment study of a product, conducted per ISO 14040/14044, producing one or more LCA results. The general study container, applicable to any product whether or not the study follows EN 15804+A2. 
Carries study-level metadata (UUID, dataset version, name, reference year, license, copyright, ILCD format version, compliance declarations, manufacturer records, reviews, references to data sources / background databases / PEFCR, etc.). 
Cross-module link from a product to this class is provided by the Connector property eudpp:hasLCAStudy.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/LCA"/>
        <rdfs:label xml:lang="en">LCA Study</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element LcaModel (https://w3id.org/lcanet/core#LcaModel) of the Core module, which represents an LCA instance.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCIAImpactCategory -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCIAImpactCategory">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#acidification"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#climateChange"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#eutrophication"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#freshwaterEcotoxicity"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#humanToxicity"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#ionisingRadiationEcosystems"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#ionisingRadiationHumanHealth"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#landUseSoilQuality"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#marineEcotoxicity"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#ozoneDepletion"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#photochemicalOzoneFormation"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#resourceUseFossil"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#resourceUseMineralsMetals"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#respiratoryInorganics"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#terrestrialEcotoxicity"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#waterUseDeprivation"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A mid-point impact category that an LCAMethod addresses. A closed enumeration.</rdfs:comment>
        <rdfs:label xml:lang="en">LCIA Impact Category</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: matches the LCIAImpactCategoryValues.</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element ImpactCategory (https://w3id.org/lcanet/ia#ImpactCategory) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCIAImpactIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCIAImpactIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
        <rdfs:comment xml:lang="en">A characterised impact indicator outside the EN 15804+A2 selection — direct subclass of eudpp:LCAIndicator, sibling of eudpp:EN15804Indicator. Holds the 16 official EF 3.1 / PEF impact category indicators as named individuals (Andreasi Bassi et al., JRC, 2023). 
These are the impact indicators used by general LCA studies (eudpp:LCAStudy) following the EU Environmental Footprint method, distinct from the EN 15804+A2 set used by EPDStudy. 
The two sets overlap conceptually — both have e.g. a &quot;Climate change&quot; indicator with kg CO2-eq — but differ operationally: EN 15804+A2 splits Climate change into four sub-indicators (total, fossil, biogenic, luluc) and selects 6 &quot;with caveats&quot; indicators with EN-specific reporting rules; EF 3.1 keeps Climate change as one indicator and presents 16 categories at one aggregation level.</rdfs:comment>
        <rdfs:label xml:lang="en">LCIA Impact Indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element ImpactCategoryIndicator (https://w3id.org/lcanet/ia#ImpactCategoryIndicator) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCIAResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCIAResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/eudpp#EN15804ImpactIndicator"/>
                            <rdf:Description rdf:about="https://w3id.org/eudpp#LCIAImpactIndicator"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A characterised LCA result quantifying one LCIA indicator (an EN15804ImpactIndicator or an LCIAImpactIndicator ) for a product system. Each instance is linked to exactly one indicator individual via quantifiesIndicator, and carries its numerical value per life-cycle module via hasLCAModuleValue.</rdfs:comment>
        <rdfs:label xml:lang="en">LCIA Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: corresponds to the element LCIAResults/LCIAResult when the indicator is a characterised impact indicator.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LandUseResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LandUseResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An LCA result quantifying impacts associated with land occupation and transformation in a product system. 
Commonly associated with the EN 15804+A2 land use indicator (LU), which is characterised under EF 3.1. No formal quantifiesIndicator restriction is imposed; note that LU sits at the boundary between inventory and impact in EN 15804 and may be refined in future ontology versions.</rdfs:comment>
        <rdfs:label xml:lang="en">Land Use Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LegalPerson -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LegalPerson">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Actor"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#NaturalPerson"/>
        <terms:source>https://www.merriam-webster.com/legal/legal%20person</terms:source>
        <rdfs:comment xml:lang="en">A body of persons or an entity (as a corporation) considered as having many of the rights and responsibilities of a natural person and especially the capacity to sue and be sued.</rdfs:comment>
        <rdfs:label xml:lang="en">Legal Person</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Length -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Length">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:comment xml:lang="en">Length of the product</rdfs:comment>
        <rdfs:label xml:lang="en">Length</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LicenseType -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LicenseType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#freeOfChargeAll"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#freeOfChargeMembers"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#freeOfChargeSome"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#licenseFee"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#licenseOther"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://spdx.org/rdf/terms#License"/>
        <rdfs:comment xml:lang="en">License applicable to access and use of the LCA / EPD study. A closed enumeration.</rdfs:comment>
        <rdfs:label xml:lang="en">License Type</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: matching the ILCD LicenseTypeValues.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LifeCycleModule -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LifeCycleModule">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA1"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA1A3"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA2"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA3"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA4"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA5"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB1"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB2"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB3"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB4"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB5"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB6"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB7"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleC1"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleC2"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleC3"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleC4"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#moduleD"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A modelled life-cycle module per EN 15804+A2 (product stage A1-A3, construction A4-A5, use stage B1-B7, end-of-life C1-C4, benefits/loads D). Enumeration of 18 named individuals. 
Note that moduleA1A3 (aggregated product stage) is an alternative reporting form of A1+A2+A3; an EPD that reports A1-A3 should not additionally report A1, A2, A3 separately for the same indicator/scenario.</rdfs:comment>
        <rdfs:label xml:lang="en">Life Cycle Module</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaintenanceEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaintenanceEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <terms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:identifier>
        <terms:source xml:lang="en">Regulation (EU) 2024/1781; Art 2(19)</terms:source>
        <rdfs:comment xml:lang="en">Actions (one or more) taken to keep a product in a condition where it can fulfil its intended purpose. ESPR Art 2(19).</rdfs:comment>
        <rdfs:label xml:lang="en">Maintenance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MakingAvailableOnMarketEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MakingAvailableOnMarketEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <terms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:identifier>
        <terms:source xml:lang="en">Regulation (EU) 2024/1781; Art 2(39)</terms:source>
        <rdfs:comment xml:lang="en">Any supply of a product for distribution, consumption or use on the Union market in the course of a commercial activity, whether in return for payment or free of charge. ESPR Art 2(39).</rdfs:comment>
        <rdfs:label xml:lang="en">Making Available on the Market</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ManufacturerRecord -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ManufacturerRecord">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A container provenance entity (prov:Entity) documenting the involvement of a manufacturer (and optionally a data provider) in a specific LCA study, including the facility concerned and whether primary LCA data was provided.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/LCA"/>
        <rdfs:label xml:lang="en">Manufacturer Record</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element epd24:manufacturer inside epd24:manufacturers.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialFootprint -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An InventoryIndicatorResult that &quot;refers to the total amount of raw materials extracted to meet final consumption demands&quot; (ESPR Art. 2(26)).

Modelled as an inventory-level result rather than a characterised LCIA result, as it aggregates raw material extraction flows without applying characterisation factors.
No single EN 15804+A2 inventory indicator individual is pinned via quantifiesIndicator; the link is left to individual instances, as material footprint spans multiple EN 15804+A2 resource use inventory indicators (PERE, PENRE, SM, RSF, NRSF, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">Material Footprint</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ESPR Art 2 (26) https://eur-lex.europa.eu/eli/reg/2024/1781/oj</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element MaterialFootprint (https://w3id.org/lcanet/ia#MaterialFootprint) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasScheme"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp#MaterialIdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SoCIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SubstanceIdentifier"/>
        <rdfs:comment xml:lang="en">A type of identifier to identify materials. A unique code assigned to Material based on a scheme.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/IDENT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Material identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialIdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialIdentifierScheme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SubstanceIdentifierScheme"/>
        <rdfs:comment xml:lang="en">A kind of identifier scheme. The scheme or standard used to identify materials, e.g., CAS.</rdfs:comment>
        <rdfs:label xml:lang="en">Material identifier scheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialOfComposition -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialOfComposition">
        <rdfs:comment xml:lang="en">Material the product (or component) is made of [ESPR Annex I]. Material as an element of composition.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/MAT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Material of composition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialOrigin -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialOrigin">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#raw"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#recycled"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#renewable"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <terms:references xml:lang="en">[ESPR Annex I]</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Origin of the material used in product [ESPR Annex I]</rdfs:comment>
        <rdfs:label xml:lang="en">Origin of material</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialType -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialType">
        <rdfs:comment xml:lang="en">Placeholder class for material type classification applicable in a sector or mandated by a delegated act (DA).

Potential types could be, on the example of textile sector: cotton, nylon, ...</rdfs:comment>
        <rdfs:label xml:lang="en">Material type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaximumConcentration -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaximumConcentration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(c)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">A concentration reported as a maximum value. The inherited dpp:numericalValue denotes the upper bound, and dpp:hasMeasurementUnit supplies its unit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Maximum concentration</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MicroplasticRelease -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MicroplasticRelease">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#PlasticsRelease"/>
        <terms:references xml:lang="en">ESPR Annex I</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters as listed in the ESPR Annex I :

(p) microplastic and nano plastic release as expressed through the release during relevant
product life cycle stages, including manufacturing, transport, use and end of life stages;

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Microplastic release</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#NanoplasticRelease -->


    <owl:Class rdf:about="https://w3id.org/eudpp#NanoplasticRelease">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#PlasticsRelease"/>
        <terms:references xml:lang="en">ESPR Annex I</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters as listed in the ESPR Annex I :

(p) microplastic and nano plastic release as expressed through the release during relevant
product life cycle stages, including manufacturing, transport, use and end of life stages;

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Nanoplastic release</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#NaturalPerson -->


    <owl:Class rdf:about="https://w3id.org/eudpp#NaturalPerson">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:source>https://www.merriam-webster.com/legal/natural%20person</terms:source>
        <rdfs:comment xml:lang="en">A human being as distinguished from a person (as a corporation) created by operation of law</rdfs:comment>
        <rdfs:label xml:lang="en">Natural Person</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#OtherTechnicalSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp#OtherTechnicalSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#TechnicalSpecification"/>
        <terms:source xml:lang="en">ESPR Annex V, (6)</terms:source>
        <rdfs:comment xml:lang="en">Other technical specifications in relation to which conformity is declared.</rdfs:comment>
        <rdfs:label xml:lang="en">Other Technical Specification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#PCR -->


    <owl:Class rdf:about="https://w3id.org/eudpp#PCR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source that is a Product Category Rules document (EN 15804+A2 Table 2 Line 1). Used in EN 15804+A2 EPDStudy via eudpp:referenceToPCR.</rdfs:comment>
        <rdfs:label xml:lang="en">Product Category Rules (PCR)</rdfs:label>
        <skos:broadMatch rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#PEFCR -->


    <owl:Class rdf:about="https://w3id.org/eudpp#PEFCR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source that is a Product Environmental Footprint Category Rules document, the European Commission Environmental Footprint methodology&apos;s product-category-specific rules. Parallel role to PCR but for PEF studies (rather than EN 15804+A2 EPD studies). Used by an LCAStudy via eudpp:referenceToPEFCR. NEW in v1.9.7.</rdfs:comment>
        <rdfs:label xml:lang="en">Product Environmental Footprint Category Rules (PEFCR)</rdfs:label>
        <skos:broadMatch rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#PackagingWasteAmount -->


    <owl:Class rdf:about="https://w3id.org/eudpp#PackagingWasteAmount">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#WasteGenerationAmount"/>
        <rdfs:comment xml:lang="en">Packaging waste amount of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Packaging waste amount</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#PlacingOnMarketEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#PlacingOnMarketEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#MakingAvailableOnMarketEvent"/>
        <terms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:identifier>
        <terms:source xml:lang="en">Regulation (EU) 2024/1781; Art 2(40)</terms:source>
        <rdfs:comment xml:lang="en">The very first time a product is made available on the Union market. ESPR Art 2(40).</rdfs:comment>
        <rdfs:label xml:lang="en">Placing on the Market</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#PlasticsRelease -->


    <owl:Class rdf:about="https://w3id.org/eudpp#PlasticsRelease">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#EnvironmentalPollution"/>
        <terms:references xml:lang="en">ESPR Annex I</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters as listed in the ESPR Annex I :

(p) microplastic and nano plastic release as expressed through the release during relevant
product life cycle stages, including manufacturing, transport, use and end of life stages;

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Plastic release</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#PlasticsWasteAmount -->


    <owl:Class rdf:about="https://w3id.org/eudpp#PlasticsWasteAmount">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#WasteGenerationAmount"/>
        <rdfs:comment xml:lang="en">Hazardous waste amount of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Plastics waste amount</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Product -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Product">
        <terms:references xml:lang="en">ESPR Art 2 (1)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product means any physical goods that are placed on the market or put into service. ESPR Art 2 (1))</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/P_DPP"/>
        <rdfs:label xml:lang="en">Product</rdfs:label>
        <skos:closeMatch>schema:Product</skos:closeMatch>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductDimension -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <terms:references xml:lang="en">ESPR Annex I</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Dimension class covers measurements of length, width, height, volume, and weight of the product required by
ESPR Annex I in its product parameters</rdfs:comment>
        <rdfs:label xml:lang="en">Product dimension</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ESPREvent"/>
        <rdfs:comment xml:lang="en">An ESPR-level event concept representing an event that affects the state, condition, use, circulation, transformation, maintenance, or end-of-life status of a product. A ProductEvent captures the product-facing semantics of the occurrence and is distinct from any DPP-side event that may be triggered to record or reflect it.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/EVENT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Product Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasScheme"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasGranularity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#ProductIdentifierGranularity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SoCIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SubstanceIdentifier"/>
        <rdfs:comment xml:lang="en">A type of identifier to identify Products. A unique code assigned to identify a product. e.g., GTIN.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/IDENT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Product identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductIdentifierGranularity -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductIdentifierGranularity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#batch"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#item"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#model"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#IdentifierGranularity"/>
        <rdfs:comment xml:lang="en">The granularity level (batch, item, model) at which the product identifier represents the product.</rdfs:comment>
        <rdfs:label xml:lang="en">Product identifier granularity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductIdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductIdentifierScheme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SubstanceIdentifierScheme"/>
        <rdfs:comment xml:lang="en">A kind of identifier scheme. The scheme or standard used to identify Products, e.g., GTIN, SKU, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Product identifier scheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductRequirement -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductRequirement">
        <rdfs:comment xml:lang="en">Product requirements means a requirement to be fullfilled by a product when placed on the market.</rdfs:comment>
        <rdfs:label xml:lang="en">Product Requirement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductStatus -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductStatus">
        <rdfs:comment xml:lang="en">Represents the current lifecycle status of a product.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/EVENT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Product Status</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductToPackagingRatio -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductToPackagingRatio">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <terms:references xml:lang="en">ESPR Annex I</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">ESPR Annex I, the list of product parameters includes the parameter called the  product to packaging ratio.

However, it is not specified in ESPR  whether that ratio is defined on the basis of weight or on the basis of volume.

**This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.**</rdfs:comment>
        <rdfs:label xml:lang="en">Product to packaging ratio</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Property -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Property">
        <rdfs:comment xml:lang="en">A property of the product.</rdfs:comment>
        <rdfs:label xml:lang="en">Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#PuttingIntoServiceEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#PuttingIntoServiceEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <terms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:identifier>
        <terms:source xml:lang="en">Regulation (EU) 2024/1781; Art 2(41)</terms:source>
        <rdfs:comment xml:lang="en">The first use of a product for its intended purpose in the Union. ESPR Art 2(41).</rdfs:comment>
        <rdfs:label xml:lang="en">Putting into Service</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#QualityIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#QualityIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment xml:lang="en">Product characteristics like durability and reliability.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Quality indicator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#QuantitativeProperty -->


    <owl:Class rdf:about="https://w3id.org/eudpp#QuantitativeProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <rdfs:comment xml:lang="en">A property (respectively measurand of a property) of the product (model) that is expressed by a quantity value. A specific quantity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/P_DPP"/>
        <rdfs:label xml:lang="en">Quantitative Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#RecoverableRate -->


    <owl:Class rdf:about="https://w3id.org/eudpp#RecoverableRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#CircularEconomyIndicator"/>
        <rdfs:comment xml:lang="en">This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Recoverable rate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#RecycledMaterialsUseResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#RecycledMaterialsUseResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An LCA inventory indicator result quantifying the use of secondary (recycled) material inputs in a product system. 
Commonly associated with the EN 15804+A2 inventory indicator “Use of secondary material” (SM), though no formal quantifiesIndicator restriction is imposed.</rdfs:comment>
        <rdfs:label xml:lang="en">Recycled Materials Use Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#RecyclingCollectionRate -->


    <owl:Class rdf:about="https://w3id.org/eudpp#RecyclingCollectionRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#CircularEconomyIndicator"/>
        <rdfs:comment xml:lang="en">This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Recycling collection rate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#RecyclingRate -->


    <owl:Class rdf:about="https://w3id.org/eudpp#RecyclingRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#CircularEconomyIndicator"/>
        <rdfs:comment xml:lang="en">This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Recycling rate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#RefurbishmentEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#RefurbishmentEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <terms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:identifier>
        <terms:source xml:lang="en">Regulation (EU) 2024/1781; Art 2(18)</terms:source>
        <rdfs:comment xml:lang="en">Actions carried out to prepare, clean, test, service and, where necessary, repair a product or a discarded product in order to restore its performance or functionality within the intended use and range of performance originally conceived at the design stage at the time of the placing of the product on the market. ESPR Art 2(18).</rdfs:comment>
        <rdfs:label xml:lang="en">Refurbishment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Reliability -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Reliability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QualityIndicator"/>
        <terms:references xml:lang="en">ESPR Art 2 (16)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Reliability
means the probability that a product functions as required under given conditions for a given
duration without an occurrence which results in a primary or secondary function of the product no
longer being performed. (ESPR Art 2 (16))

Reliability is usually expressed in terms of mean time between failures (MTBF), which is the average length of time that a device will operate without failure.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Reliability</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#RemanufacturingEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#RemanufacturingEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <terms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:identifier>
        <terms:source xml:lang="en">Regulation (EU) 2024/1781; Art 2(16)</terms:source>
        <rdfs:comment xml:lang="en">Actions through which a new product is produced from objects that are waste, products or components and through which at least one change is made that substantially affects the safety, performance, purpose or type of the product. ESPR Art 2(16).</rdfs:comment>
        <rdfs:label xml:lang="en">Remanufacturing</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#RepairEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#RepairEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <terms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:identifier>
        <terms:source xml:lang="en">Regulation (EU) 2024/1781; Art 2(20)</terms:source>
        <rdfs:comment xml:lang="en">Actions taken to return a defective product or waste to a condition where it fulfils its intended purpose. ESPR Art 2(20).</rdfs:comment>
        <rdfs:label xml:lang="en">Repair</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Review -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Review">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">A verification / critical review performed on an LCA study or EPD study.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/LCA"/>
        <rdfs:label xml:lang="en">Review</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://indatawg.github.io/ILCD-EPD-Data-Format/doc/"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: corresponds to the element validation/review.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ReviewReport -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ReviewReport">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source holding the complete critical-review / verification report referenced from a Review.</rdfs:comment>
        <rdfs:label xml:lang="en">Review Report</rdfs:label>
        <skos:broadMatch rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Role -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Role">
        <terms:references xml:lang="en">CIRPASS-2 User Stories 3.1</terms:references>
        <terms:source>https://zenodo.org/records/17979585</terms:source>
        <rdfs:comment xml:lang="en">Role means a set of tasks typically performed by one actor. (e.g. Responsible Economic Operator, Independent operator); [CIRPASS-2 User Stories 3.1]</rdfs:comment>
        <rdfs:label xml:lang="en">Role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#SoCIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#SoCIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#SubstanceIdentifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A type of identifier to identify substances of concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Substance of concern identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#SoCQualificationAssertion -->


    <owl:Class rdf:about="https://w3id.org/eudpp#SoCQualificationAssertion">
        <terms:references xml:lang="en">ESPR Article 2(27).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2006/1907/oj"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2008/1272/oj"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2019/1021/oj"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">A documented, explicit assertion that a substance satisfies one or more non-exclusive qualification criteria in ESPR Article 2(27). For criterion (d), the applicable product context is represented by a dpp:SubstancePresence linked through dpp:hasApplicableQualification. This modelling construct records asserted qualification evidence; it does not infer legal status.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">SoC qualification assertion</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded modelling construct for recording an explicit Article 2(27) qualification; the assertion is not itself a legal term and the ontology does not infer legal status.</eudpp:sourceStatus>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Source -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Source">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A bibliographic or documentary source referenced from an LCA study, EPD study or LCIA Method. Abstract superclass; concrete source instances typically use one of the more specific subclasses (PCR, LCAMethodReport, BackgroundDatabase, ComplianceSystem, ReviewReport, EPDDocument).</rdfs:comment>
        <rdfs:label xml:lang="en">Source</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element Source Data Set.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Substance -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Substance">
        <terms:references xml:lang="en">REACH Article 3(1)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2006/1907/oj"/>
        <rdfs:comment xml:lang="en">A chemical substance used as the generic superclass for substance identity and naming information. In this SOC module it primarily supports the modelling of dpp:SubstanceOfConcern; its presence does not make SOC a general-purpose substance-reporting module.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/SOC</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Substance</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">direct legal definition reproduced from the cited legislation.</eudpp:sourceStatus>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#SubstanceIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#SubstanceIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasScheme"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp#SubstanceIdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A type of identifier to identify substances. A unique code assigned to substance based on a scheme.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/IDENT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">substance identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#SubstanceIdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#SubstanceIdentifierScheme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#SubstanceManagementInstruction -->


    <owl:Class rdf:about="https://w3id.org/eudpp#SubstanceManagementInstruction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DigitalInstruction"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(d)-(e)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">An instruction concerning the management of a substance of concern in its SubstancePresence context, including safe use, disassembly, preparation for reuse, reuse, recycling and environmentally sound end-of-life management. This domain-specific modelling abstraction supports the information elements in ESPR Article 7(5)(d)-(e); it is not a term defined by the Regulation and does not determine legal obligations or applicability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Substance management instruction</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation.</eudpp:sourceStatus>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#SubstanceOfConcern -->


    <owl:Class rdf:about="https://w3id.org/eudpp#SubstanceOfConcern">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Substance"/>
        <terms:references xml:lang="en">ESPR Article 2(27)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">A substance that: (a) meets the criteria laid down in Article 57 of Regulation (EC) No 1907/2006 and is identified in accordance with Article 59(1) of that Regulation; (b) is classified in Part 3 of Annex VI to Regulation (EC) No 1272/2008 in one of the following hazard classes or hazard categories: (i) carcinogenicity categories 1 and 2; (ii) germ cell mutagenicity categories 1 and 2; (iii) reproductive toxicity categories 1 and 2; (iv) endocrine disruption for human health categories 1 and 2; (v) endocrine disruption for the environment categories 1 and 2; (vi) persistent, mobile and toxic or very persistent, very mobile properties; (vii) persistent, bioaccumulative and toxic or very persistent, very bioaccumulative properties; (viii) respiratory sensitisation category 1; (ix) skin sensitisation category 1; (x) hazardous to the aquatic environment — categories chronic 1 to 4; (xi) hazardous to the ozone layer; (xii) specific target organ toxicity — repeated exposure categories 1 and 2; (xiii) specific target organ toxicity — single exposure categories 1 and 2; (c) is regulated under Regulation (EU) 2019/1021; or (d) negatively affects the reuse and recycling of materials in the product in which it is present.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Substance of concern</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">direct legal definition reproduced from the cited legislation.</eudpp:sourceStatus>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#SubstancePresence -->


    <owl:Class rdf:about="https://w3id.org/eudpp#SubstancePresence">
        <terms:references xml:lang="en">ESPR Article 7(5)(a)–(e)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">A contextual relation entity representing the presence of a substance in relation to a product as placed on the market, including a product, component or spare part. It enables product-dependent location, concentration and instruction information to be represented without treating those data as intrinsic characteristics of the substance itself or classifying the presence as a product property. In the CORE profile the modelling pattern is one SubstancePresence per reported location when different locations require different concentrations; sector-specific extensions may provide explicit reference bases for several calculation perspectives. This class is an ontology modelling abstraction supporting ESPR Article 7(5), rather than a term explicitly defined by the Regulation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/SOC</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Substance presence</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation.</eudpp:sourceStatus>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#SustainableRenewableMaterialsUseResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#SustainableRenewableMaterialsUseResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An LCA inventory indicator result quantifying the use of renewable secondary material and fuel inputs in a product system. 
Commonly associated with the EN 15804+A2 inventory indicators “Use of renewable secondary fuels” (RSF) or “Use of non-renewable secondary fuels” (NRSF), though no formal quantifiesIndicator restriction is imposed, as the scope of renewable material inputs may evolve.</rdfs:comment>
        <rdfs:label xml:lang="en">Sustainable Renewable Materials Use Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#TechnicalSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp#TechnicalSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductRequirement"/>
        <terms:source xml:lang="en">Regulation (EU) No 1025/2012 Art 2 (4)
https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2</terms:source>
        <rdfs:comment xml:lang="en">Technical specification means a document that prescribes technical requirements to be fulfilled by a product, process, service or system and which lays down one or more of the following: Common Specification or Other Technical Specification.</rdfs:comment>
        <rdfs:label xml:lang="en">Technical Specification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ThresholdOfSubstanceOfConcern -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ThresholdOfSubstanceOfConcern">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <terms:references xml:lang="en">ESPR FAQ 10.115, p59</terms:references>
        <terms:source>https://circabc.europa.eu/ui/group/418195ae-4919-45fa-a959-3b695c9aab28/library/25c48e7c-9ce3-41cb-96ac-d2942a8a29d6/details</terms:source>
        <rdfs:comment xml:lang="en">Relevant threshold of Substance of Concern.

By default, information on all substances of concern present in a product, above the  relevant thresholds, should be included in the DPP [ESPR FAQ 10.115, p59]</rdfs:comment>
        <rdfs:label xml:lang="en">Threshold of substance of concern</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#TypeOfReview -->


    <owl:Class rdf:about="https://w3id.org/eudpp#TypeOfReview">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#accreditedThirdPartyReview"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#dependentInternalReview"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#independentExternalReview"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#independentInternalReview"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#independentReviewPanel"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#notReviewed"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Kind of critical-review/verification performed on a dataset. Enumeration matching ILCD TypeOfReviewValues.</rdfs:comment>
        <rdfs:label xml:lang="en">Type of Review</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#UnionHarmonisationLegislation -->


    <owl:Class rdf:about="https://w3id.org/eudpp#UnionHarmonisationLegislation">
        <terms:source xml:lang="en">Decision No 768/2008/EC Annex I Art R1 (17)
https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <rdfs:comment xml:lang="en">Union Harmonisation Legislation shall mean any Union legislation harmonising the conditions for the marketing of products. Examples are directives, regulations and delegated acts.</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/eudpp/COMP</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Union Harmonised Legislation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#UpgradingEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp#UpgradingEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <terms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:identifier>
        <terms:source xml:lang="en">Regulation (EU) 2024/1781; Art 2(17)</terms:source>
        <rdfs:comment xml:lang="en">Actions carried out to enhance the functionality, performance, capacity, safety or aesthetics of a product. ESPR Art 2(17).</rdfs:comment>
        <rdfs:label xml:lang="en">Upgrading</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Volume -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Volume">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:comment xml:lang="en">Volume of the product</rdfs:comment>
        <rdfs:label xml:lang="en">Volume</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#WasteGenerationAmount -->


    <owl:Class rdf:about="https://w3id.org/eudpp#WasteGenerationAmount">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#QuantitativeProperty"/>
        <rdfs:comment xml:lang="en">Waste generation amount of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Waste generation amount</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#WaterConsumptionResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#WaterConsumptionResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An LCA inventory indicator result quantifying the net consumption of fresh water resources in a product system. 
This class is typically associated with the EN 15804+A2 inventory indicator “Use of net fresh water” (FW), though no formal quantifiesIndicator restriction is imposed to allow for future indicator additions or revised indicator frameworks.</rdfs:comment>
        <rdfs:label xml:lang="en">Water Consumption Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Weight -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Weight">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:comment xml:lang="en">Weight of the product</rdfs:comment>
        <rdfs:label xml:lang="en">Weight</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Width -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Width">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductDimension"/>
        <rdfs:comment xml:lang="en">Width of the product</rdfs:comment>
        <rdfs:label xml:lang="en">Width</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://publications.europa.eu/resource/authority/corporate-body/COM -->


    <owl:NamedIndividual rdf:about="http://publications.europa.eu/resource/authority/corporate-body/COM">
        <owl:sameAs rdf:resource="https://w3id.org/eudpp#EuropeanCommission"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#EuropeanCommission -->


    <rdf:Description rdf:about="https://w3id.org/eudpp#EuropeanCommission"/>
    


    <!-- http://publications.europa.eu/resource/authority/country/EUR -->


    <owl:NamedIndividual rdf:about="http://publications.europa.eu/resource/authority/country/EUR">
        <rdfs:comment xml:lang="en">European Union is used here as a jurisdictional or geographic entity for legal and regulatory contexts.</rdfs:comment>
        <rdfs:label xml:lang="en">European Union</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#AddDPPDataAction -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#AddDPPDataAction">
        <rdf:type rdf:resource="https://w3id.org/eudpp#DPPActionType"/>
        <rdfs:comment xml:lang="en">Indicates that new information is added to the Digital Product Passport.</rdfs:comment>
        <rdfs:label xml:lang="en">add data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#CAS -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#CAS">
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialIdentifierScheme"/>
        <eudpp:identifierExampleValue>7732-18-5</eudpp:identifierExampleValue>
        <eudpp:identifierMaxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</eudpp:identifierMaxLength>
        <eudpp:identifierMinLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</eudpp:identifierMinLength>
        <rdfs:comment xml:lang="en">CAS Number (Chemical Abstracts Service)</rdfs:comment>
        <rdfs:comment xml:lang="en">Governance note: CAS is currently a MaterialIdentifierScheme. IDENT/MAT governance must determine whether a substance-identifier use requires reassignment, a shared scheme model, or another compatible pattern.</rdfs:comment>
        <rdfs:label xml:lang="en">CAS</rdfs:label>
        <rdfs:seeAlso>https://www.cas.org/support/documentation/chemical-substances/faqs</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">Chemical Abstracts Service Registry Number</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#CorrectDPPDataAction -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#CorrectDPPDataAction">
        <rdf:type rdf:resource="https://w3id.org/eudpp#DPPActionType"/>
        <rdfs:comment xml:lang="en">Indicates that erroneous, inconsistent, or incomplete information in the Digital Product Passport is corrected.</rdfs:comment>
        <rdfs:label xml:lang="en">correct data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#CriterionA -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#CriterionA">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">ESPR Article 2(27)(a); REACH Articles 57 and 59(1).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2006/1907/oj"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The substance meets the relevant REACH Article 57 criteria and has been identified under Article 59(1).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <skos:definition xml:lang="en">The substance meets the relevant REACH Article 57 criteria and has been identified under Article 59(1).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp#SoCCriterionScheme"/>
        <skos:notation>a</skos:notation>
        <skos:prefLabel xml:lang="en">Criterion (a)</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp#SoCCriterionScheme"/>
        <eudpp:sourceStatus xml:lang="en">Legal qualification criterion represented as a SKOS concept corresponding to ESPR Article 2(27)(a).</eudpp:sourceStatus>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#CriterionB -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#CriterionB">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">ESPR Article 2(27)(b); CLP Annex VI Part 3.</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2008/1272/oj"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The substance has a harmonised CLP Annex VI Part 3 classification in one of the hazard classes or categories listed by ESPR Article 2(27)(b).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <skos:definition xml:lang="en">The substance has a harmonised CLP Annex VI Part 3 classification in one of the hazard classes or categories listed by ESPR Article 2(27)(b).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp#SoCCriterionScheme"/>
        <skos:notation>b</skos:notation>
        <skos:prefLabel xml:lang="en">Criterion (b)</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp#SoCCriterionScheme"/>
        <eudpp:sourceStatus xml:lang="en">Legal qualification criterion represented as a SKOS concept corresponding to ESPR Article 2(27)(b).</eudpp:sourceStatus>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#CriterionC -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#CriterionC">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">ESPR Article 2(27)(c); Regulation (EU) 2019/1021.</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2019/1021/oj"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The substance is regulated under Regulation (EU) 2019/1021 on persistent organic pollutants.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <skos:definition xml:lang="en">The substance is regulated under Regulation (EU) 2019/1021 on persistent organic pollutants.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp#SoCCriterionScheme"/>
        <skos:notation>c</skos:notation>
        <skos:prefLabel xml:lang="en">Criterion (c)</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp#SoCCriterionScheme"/>
        <eudpp:sourceStatus xml:lang="en">Legal qualification criterion represented as a SKOS concept corresponding to ESPR Article 2(27)(c).</eudpp:sourceStatus>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#CriterionD -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#CriterionD">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">ESPR Article 2(27)(d).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The substance negatively affects reuse and recycling of materials in the product in which it is present.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <skos:definition xml:lang="en">The substance negatively affects reuse and recycling of materials in the product in which it is present.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp#SoCCriterionScheme"/>
        <skos:notation>d</skos:notation>
        <skos:prefLabel xml:lang="en">Criterion (d)</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Criterion (d) is product-context dependent. The context is represented by linking the relevant dpp:SubstancePresence to the qualification assertion through dpp:hasApplicableQualification.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp#SoCCriterionScheme"/>
        <eudpp:sourceStatus xml:lang="en">Legal qualification criterion represented as a SKOS concept corresponding to ESPR Article 2(27)(d); product context is represented through SubstancePresence.</eudpp:sourceStatus>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#DeleteDPPDataAction -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#DeleteDPPDataAction">
        <rdf:type rdf:resource="https://w3id.org/eudpp#DPPActionType"/>
        <rdfs:comment xml:lang="en">Indicates that information is removed from the Digital Product Passport.</rdfs:comment>
        <rdfs:label xml:lang="en">delete data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#EC -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#EC">
        <rdf:type rdf:resource="https://w3id.org/eudpp#SubstanceIdentifierScheme"/>
        <eudpp:identifierExampleValue>200-578-6</eudpp:identifierExampleValue>
        <eudpp:identifierMaxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</eudpp:identifierMaxLength>
        <eudpp:identifierPattern>^[2-5]\d{2}-\d{3}-\d$</eudpp:identifierPattern>
        <rdfs:comment xml:lang="en">EC number is a unique identification number assigned to a chemical substance in the European Union. It is used to identify substances in regulatory databases, safety data sheets (SDSs), and chemical legislation.</rdfs:comment>
        <rdfs:comment xml:lang="en">The EC number is a seven-digit identifier typically written in the format XXX-XXX-X and used to identify chemical substances in European regulatory inventories.

Example:
Substance: Ethanol
EC number: 200-578-6</rdfs:comment>
        <rdfs:label xml:lang="en">EC</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#ECHA -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#ECHA">
        <rdf:type rdf:resource="https://w3id.org/eudpp#SubstanceIdentifierScheme"/>
        <rdfs:comment xml:lang="en">ECHA substance identification scheme refers to the approach used by the European Chemicals Agency (ECHA) to identify and distinguish chemical substances for regulatory purposes under EU chemicals legislation, particularly REACH.</rdfs:comment>
        <rdfs:label xml:lang="en">ECHA</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#EORI -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#EORI">
        <eudpp:identifierExampleValue>DE123456789012345</eudpp:identifierExampleValue>
        <eudpp:identifierMaxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</eudpp:identifierMaxLength>
        <eudpp:identifierMinLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</eudpp:identifierMinLength>
        <rdfs:comment xml:lang="en">Economic Operators Registration and Identification (EU).
This is the EU’s official identifier for companies involved in import/export.
Mandatory for any company trading with the EU.

Used in customs declarations
Unique per company

Format: country code + number (e.g., DE123456789)

This is the most widely used identifier for economic operators in EU trade.</rdfs:comment>
        <rdfs:label xml:lang="en">EORI</rdfs:label>
        <rdfs:label>https://taxation-customs.ec.europa.eu/customs/customs-procedures-import-and-export/customs-operations/economic-operators-registration-and-identification-number-eori_en</rdfs:label>
        <skos:altLabel xml:lang="en">Economic Operators Registration and Identification (EU</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#EuropeanCommission -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#EuropeanCommission">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LegalPerson"/>
        <terms:source>https://ec.europa.eu/eurostat/statistics-explained/index.php?title=Glossary:European_Commission_(EC)</terms:source>
        <rdfs:comment xml:lang="en">The European Commission, abbreviated as EC, is the executive branch of the European Union.</rdfs:comment>
        <rdfs:label xml:lang="en">European Commission</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#GLN -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#GLN">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ActorIdentifierScheme"/>
        <eudpp:identifierExampleValue>9501101530003</eudpp:identifierExampleValue>
        <eudpp:identifierMaxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</eudpp:identifierMaxLength>
        <eudpp:identifierMinLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</eudpp:identifierMinLength>
        <eudpp:identifierSchemeIssuer>GS1</eudpp:identifierSchemeIssuer>
        <rdfs:comment xml:lang="en">A globally unique identifier defined by GS1 used to identify legal entities, functional entities, and physical locations within business and supply chain processes.

Typically identifies: legal entities, functional entities (departments), physical locations (warehouses, sites).</rdfs:comment>
        <rdfs:label xml:lang="en">GLN</rdfs:label>
        <rdfs:seeAlso>https://www.gs1.org/standards/id-keys/gln</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">Global Location Number</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#GTIN -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#GTIN">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <eudpp:identifierExampleValue>14006381333938</eudpp:identifierExampleValue>
        <eudpp:identifierMaxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</eudpp:identifierMaxLength>
        <eudpp:identifierMinLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</eudpp:identifierMinLength>
        <eudpp:identifierSchemeIssuer>GS1</eudpp:identifierSchemeIssuer>
        <rdfs:comment xml:lang="en">A globally unique identifier for trade items, defined by GS1, used to identify products at various packaging levels.</rdfs:comment>
        <rdfs:label xml:lang="en">GTIN</rdfs:label>
        <rdfs:seeAlso>https://www.gs1.org/standards/id-keys/gtin</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">Global Trade Item Number</skos:altLabel>
        <skos:definition xml:lang="en">A globally unique identifier for trade items, defined by GS1, used to identify products at various packaging levels.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#LEI -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#LEI">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ActorIdentifierScheme"/>
        <eudpp:identifierExampleValue>529900T8BM49AURSDO55</eudpp:identifierExampleValue>
        <eudpp:identifierMaxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</eudpp:identifierMaxLength>
        <eudpp:identifierMinLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</eudpp:identifierMinLength>
        <eudpp:identifierSchemeIssuer>ISO</eudpp:identifierSchemeIssuer>
        <rdfs:comment xml:lang="en">A Legal Entity Identifier (LEI) is a globally unique 20-character alphanumeric code that identifies legally distinct entities participating in financial transactions, as defined by ISO 17442.

A 20‑character code used globally for financial and regulatory reporting.
Required for companies involved in financial transactions.
Used by regulators, banks, customs, and some trade systems.</rdfs:comment>
        <rdfs:label xml:lang="en">LEI</rdfs:label>
        <rdfs:seeAlso>https://www.iso.org/standard/78829.html</rdfs:seeAlso>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#ModifyDPPDataAction -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#ModifyDPPDataAction">
        <rdf:type rdf:resource="https://w3id.org/eudpp#DPPActionType"/>
        <rdfs:comment xml:lang="en">Indicates that existing information in the Digital Product Passport is modified.</rdfs:comment>
        <rdfs:label xml:lang="en">modify data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#SKU -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#SKU">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <eudpp:identifierExampleValue>ABC-RED-XL</eudpp:identifierExampleValue>
        <eudpp:identifierMaxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</eudpp:identifierMaxLength>
        <eudpp:identifierMinLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</eudpp:identifierMinLength>
        <rdfs:comment xml:lang="en">A Stock Keeping Unit (SKU) is an internal identifier assigned by an organization to uniquely identify and track a product, item, or variant within its own inventory and management systems.</rdfs:comment>
        <rdfs:label xml:lang="en">SKU</rdfs:label>
        <rdfs:seeAlso>https://en.wikipedia.org/wiki/Stock_keeping_unit</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">Stock Keeping Unit</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#SoCCriterionScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#SoCCriterionScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Legal qualification criteria corresponding to points (a)-(d) of ESPR Article 2(27). A substance may satisfy more than one criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">SoC criterion scheme</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">Controlled vocabulary representing the four legal qualification branches of ESPR Article 2(27).</eudpp:sourceStatus>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#accreditedThirdPartyReview -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#accreditedThirdPartyReview">
        <rdf:type rdf:resource="https://w3id.org/eudpp#TypeOfReview"/>
        <rdfs:comment xml:lang="en">Reviewer independent of the organisations involved and accredited by an independent accreditation body. Highest level acceptable for EN 15804+A2 compliance.</rdfs:comment>
        <rdfs:label xml:lang="en">Accredited third party review</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#acidification -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#acidification">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopNaturalEnvironment"/>
        <rdfs:label xml:lang="en">Acidification</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#aopHumanHealth -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#aopHumanHealth">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:label xml:lang="en">Human health</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#aopManMadeEnvironment -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#aopManMadeEnvironment">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:label xml:lang="en">Man-made environment</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#aopNaturalEnvironment -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#aopNaturalEnvironment">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:label xml:lang="en">Natural environment</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#aopNaturalResources -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#aopNaturalResources">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:label xml:lang="en">Natural resources</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#aopOther -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#aopOther">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:label xml:lang="en">Other AoP</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#authorisedRepresentative -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#authorisedRepresentative">
        <rdf:type rdf:resource="https://w3id.org/eudpp#EconomicOperatorRole"/>
        <terms:references xml:lang="en">ESPR Art 2 (43)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Authorised representative means any natural or legal person established in the Union that has received a written mandate from the manufacturer to act on the manufacturer’s behalf in relation to specified tasks with regard to the manufacturer’s obligations under this Regulation; [ESPR Art 2 (43)]</rdfs:comment>
        <rdfs:label xml:lang="en">Authorised Representative</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#batch -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#batch">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ProductIdentifierGranularity"/>
        <rdfs:comment xml:lang="en">According to ESPR Art 9 (2d) the digital product passport is to be established at model, batch or item level, and the definition of such levels is given by delegated acts;

The term ‘batch’ usually refers to a subset of a specific model composed of all products produced in a specific manufacturing plant at a specific moment in time (ESPR preamble (33)).</rdfs:comment>
        <rdfs:label xml:lang="en">batch</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#climateChange -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#climateChange">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopHumanHealth"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopNaturalEnvironment"/>
        <rdfs:label xml:lang="en">Climate change</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#conformityAssessmentBody -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#conformityAssessmentBody">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ConformityAssessmentRole"/>
        <terms:references xml:lang="en">ESPR Art 2 (52)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Conformity assessment body means a body that performs conformity assessment activities including calibration, testing, certification and inspection; [ESPR Art 2 (52)]</rdfs:comment>
        <rdfs:label xml:lang="en">Conformity Assessment Body</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#consumer -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#consumer">
        <rdf:type rdf:resource="https://w3id.org/eudpp#EndUserRole"/>
        <skos:broader rdf:resource="https://w3id.org/eudpp#customer"/>
        <terms:references xml:lang="en">Directive (EU) 2019/771, Art 2 (2)</terms:references>
        <terms:source>http://data.europa.eu/eli/dir/2019/771/oj</terms:source>
        <rdfs:comment xml:lang="en">Consumer means any natural person who, in relation to contracts covered by Directive (EU) 2019/771, is acting for purposes which are outside that person&apos;s trade, business, craft or profession; [Directive (EU) 2019/771, Art 2 (2)]</rdfs:comment>
        <rdfs:label xml:lang="en">Consumer</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#credentialAgency -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#credentialAgency">
        <rdf:type rdf:resource="https://w3id.org/eudpp#Role"/>
        <terms:references xml:lang="en">CIRPASS-2 User Stories 3.1</terms:references>
        <terms:source>https://zenodo.org/records/17979585</terms:source>
        <rdfs:comment xml:lang="en">A legal person that provides (professional) credentials to parties, which may be used to make and verify a variety of claims in the DPP, (ESPR) Art. 11 last paragraph. For example, a credentials agency could certify a professional repairer and provide appropriate credentials for the DPP system; [CIRPASS-2 User Stories 3.1]</rdfs:comment>
        <rdfs:label xml:lang="en">Credential Agency</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#customer -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#customer">
        <rdf:type rdf:resource="https://w3id.org/eudpp#EndUserRole"/>
        <terms:references xml:lang="en">ESPR Art 2 (35)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Customer means a natural or legal person that purchases, hires or receives a product for their own use whether or not acting for purposes which are outside their trade, business, craft or profession; [ESPR Art 2 (35)]</rdfs:comment>
        <rdfs:label xml:lang="en">Customer</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#customsAuthority -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#customsAuthority">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AuthorityRole"/>
        <terms:references xml:lang="en">Regulation (EU) 2019/1020, Art 3 (24)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2019/1020/oj</terms:source>
        <rdfs:comment xml:lang="en">Customs authorities means  customs authorities as defined in point 1 of Article 5 of Regulation (EU) No 952/2013; [Regulation (EU) 2019/1020, Art 3 (24)]</rdfs:comment>
        <rdfs:comment xml:lang="en">Customs authorities means the customs administrations of the Member States responsible for applying the customs legislation and any other authorities empowered under national law to apply certain customs legislation (Regulation (EU) No 952/2013 Art 5 (1);</rdfs:comment>
        <rdfs:label xml:lang="en">Customs Authority</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#dealer -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#dealer">
        <rdf:type rdf:resource="https://w3id.org/eudpp#EconomicOperatorRole"/>
        <skos:related rdf:resource="https://w3id.org/eudpp#distributor"/>
        <terms:references xml:lang="en">ESPR Art 2 (55)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Dealer means a distributor or any other natural or legal person that offers products for sale, hire or hire purchase, or that displays products, to end users in the course of a commercial activity, including through distance selling; and includes any natural or legal person that puts a product into service in the course of a commercial activity; [ESPR Art 2 (55)]</rdfs:comment>
        <rdfs:label xml:lang="en">Dealer</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#dependentInternalReview -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#dependentInternalReview">
        <rdf:type rdf:resource="https://w3id.org/eudpp#TypeOfReview"/>
        <rdfs:comment xml:lang="en">Reviewer involved in data collection or modelling, or representing the process/product system. Not acceptable for EN 15804+A2 compliance.</rdfs:comment>
        <rdfs:label xml:lang="en">Dependent internal review</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#distributor -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#distributor">
        <rdf:type rdf:resource="https://w3id.org/eudpp#EconomicOperatorRole"/>
        <skos:related rdf:resource="https://w3id.org/eudpp#dealer"/>
        <terms:references xml:lang="en">ESPR Art 2 (45)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Distributor means any natural or legal person in the supply chain, other than the manufacturer or the importer, that makes a product available on the market; [ESPR Art 2 (45)]</rdfs:comment>
        <rdfs:label xml:lang="en">Distributor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#dppServiceProvider -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#dppServiceProvider">
        <rdf:type rdf:resource="https://w3id.org/eudpp#Role"/>
        <terms:references xml:lang="en">ESPR Art 2 (32)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Digital product passport service provider means a natural or legal person that is an independent third-party authorised by the economic operator which places the product on the market or puts it into service and that processes the digital product passport data for that product for the purpose of making such data available to economic operators and other relevant actors with a right to access those data under this Regulation or other Union law; [ESPR Art 2 (32)]</rdfs:comment>
        <rdfs:label xml:lang="en">DPP Service Provider</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#en15804moduleA1 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#en15804moduleA1">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
        <rdfs:label xml:lang="en">A1 - Raw material extraction and supply</rdfs:label>
        <skos:altLabel xml:lang="en">A1</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#en15804moduleA1A3 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#en15804moduleA1A3">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
        <rdfs:label xml:lang="en">A1-A3 - Product stage (aggregated)</rdfs:label>
        <skos:altLabel xml:lang="en">A1-A3</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#en15804moduleA2 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#en15804moduleA2">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
        <rdfs:label xml:lang="en">A2 - Transport to manufacturer</rdfs:label>
        <skos:altLabel xml:lang="en">A2</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#en15804moduleA3 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#en15804moduleA3">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
        <rdfs:label xml:lang="en">A3 - Manufacturing</rdfs:label>
        <skos:altLabel xml:lang="en">A3</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#en15804moduleA4 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#en15804moduleA4">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
