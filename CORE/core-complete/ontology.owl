        <rdfs:label xml:lang="en">Acidification EF</rdfs:label>
        <skos:altLabel xml:lang="en">Acidification</skos:altLabel>
        <eudpp:sourceVocabulary>LCA ontology extension</eudpp:sourceVocabulary>
        <eudpp:unitAsString xml:lang="en">mol H+-eq</eudpp:unitAsString>
        <LCA:assessesImpactCategory rdf:resource="https://w3id.org/eudpp#acidification"/>
