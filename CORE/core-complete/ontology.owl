    <!-- https://w3id.org/eudpp#ind_EF_climateChange -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#ind_EF_climateChange">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCIAImpactIndicator"/>
        <rdfs:comment xml:lang="en">Radiative forcing as global warming potential, GWP100, expressed in kg CO2-equivalent. Aggregate of climate-change effects from fossil, biogenic and land-use-and-land-use-change sources. EF 3.1 / PEF impact category. Colloquially known as the carbon footprint of the product. JRC characterisation factors per EUR 31414 EN (2023).</rdfs:comment>
        <rdfs:label xml:lang="en">Climate change EF</rdfs:label>
        <skos:altLabel xml:lang="en">Carbon footprint</skos:altLabel>
        <skos:altLabel xml:lang="en">Climate change</skos:altLabel>
        <eudpp:sourceVocabulary>LCA ontology extension</eudpp:sourceVocabulary>
        <eudpp:unitAsString xml:lang="en">kg CO2-eq</eudpp:unitAsString>
        <LCA:assessesImpactCategory rdf:resource="https://w3id.org/eudpp#climateChange"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#ind_EF_ecotoxicityFreshwater -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#ind_EF_ecotoxicityFreshwater">
