    <!-- https://w3id.org/eudpp#notifiedBody -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#notifiedBody">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ConformityAssessmentRole"/>
        <terms:references xml:lang="en">ESPR Art 2 (53)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Notified body means a conformity assessment body notified in accordance with Chapter IX.; [ESPR Art 2 (53)]</rdfs:comment>
        <rdfs:label xml:lang="en">Notified Body</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#professionalRepairer -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#professionalRepairer">
        <rdf:type rdf:resource="https://w3id.org/eudpp#CircularEconomyRole"/>
        <terms:references xml:lang="en">ESPR Art 2 (48)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Professional repairer means a natural or legal person that provides professional repair or maintenance services for a product, irrespective of whether that person acts within the manufacturer’s distribution system or independently; [ESPR Art 2 (48)]</rdfs:comment>
        <rdfs:label xml:lang="en">Professional Repairer</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#raw -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#raw">
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialOrigin"/>
        <rdfs:comment>Raw material</rdfs:comment>
        <rdfs:label xml:lang="en">raw material</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#recycled -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#recycled">
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialOrigin"/>
        <rdfs:comment>Recycled material</rdfs:comment>
        <rdfs:label xml:lang="en">recycled material</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#recycler -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#recycler">
        <rdf:type rdf:resource="https://w3id.org/eudpp#CircularEconomyRole"/>
        <skos:broader rdf:resource="https://w3id.org/eudpp#independentOperator"/>
        <terms:references xml:lang="en">WFD Art 3 (17)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/dir/2008/98/oj</terms:source>
        <rdfs:comment xml:lang="en">An actor performing recycling, which means &quot;any recovery operation by which waste materials are reprocessed into products, materials or substances whether for the original or other purposes. It includes the reprocessing of organic material but does not include energy recovery and the reprocessing into materials that are to be used as fuels or for backfilling operations&quot; [WFD Art 3 (17)]</rdfs:comment>
        <rdfs:label xml:lang="en">Recycler</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#refurbisher -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#refurbisher">
        <rdf:type rdf:resource="https://w3id.org/eudpp#CircularEconomyRole"/>
        <skos:broader rdf:resource="https://w3id.org/eudpp#independentOperator"/>
        <terms:references xml:lang="en">ESPR Art 2 (18)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">An actor performing refurbishment, which means &quot;actions carried out to prepare, clean, test, service and, where necessary, repair a product or a discarded product in order to restore its performance or functionality within the intended use and range of performance originally conceived at the design stage at the time of the placing of the product on the market.&quot;; [ESPR Art 2 (18)]</rdfs:comment>
        <rdfs:label xml:lang="en">Refurbisher</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#remanufacturer -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#remanufacturer">
        <rdf:type rdf:resource="https://w3id.org/eudpp#CircularEconomyRole"/>
        <skos:broader rdf:resource="https://w3id.org/eudpp#manufacturer"/>
        <terms:references xml:lang="en">ESPR Art 2 (16)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">An actor performing remanufacturing, which means &quot;actions through which a new product is produced from objects that are waste, products or components and through which at least one change is made that substantially affects the safety, performance, purpose or type of the product&quot;; [ESPR Art 2 (16)]</rdfs:comment>
        <rdfs:label xml:lang="en">Remanufacturer</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#renewable -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#renewable">
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialOrigin"/>
        <rdfs:comment>Renewable material</rdfs:comment>
        <rdfs:label xml:lang="en">renewable material</rdfs:label>
    </owl:NamedIndividual>
