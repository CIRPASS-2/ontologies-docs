        <eudpp:belongsToEn15804Group rdf:resource="https://w3id.org/eudpp#group_coreImpact"/>
        <rdfs:comment xml:lang="en">Abiotic depletion potential for non-fossil resources (minerals and metals), in kg Sb-equivalent. Core EN 15804+A2 impact indicator.</rdfs:comment>
        <rdfs:label xml:lang="en">ADPE - Abiotic Depletion Potential (elements, minerals and metals)</rdfs:label>
        <skos:altLabel xml:lang="en">ADPE</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
        <eudpp:unitAsString xml:lang="en">kg Sb-eq</eudpp:unitAsString>
        <LCA:relatesToLCAIndicator rdf:resource="https://w3id.org/eudpp#ind_EF_resourceUseMineralsMetals"/>
    </owl:NamedIndividual>
    


