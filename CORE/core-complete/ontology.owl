        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II	
Decision No 768/2008/EC Annex II</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001	
Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4</terms:source>
        <rdfs:comment xml:lang="en">Decision No 768/2008/EC module C2

Conformity to type based on internal production control plus supervised product checks at random intervals</rdfs:comment>
        <rdfs:label xml:lang="en">module C2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#moduleD -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#moduleD">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II
Decision No 768/2008/EC Annex II</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001	
Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4</terms:source>
        <rdfs:comment xml:lang="en">Decision No 768/2008/EC module D

Conformity to EU-type based on quality assurance of the production process</rdfs:comment>
        <rdfs:label xml:lang="en">module D</rdfs:label>
    </owl:NamedIndividual>
    


