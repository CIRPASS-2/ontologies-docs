        <eudpp:belongsToEn15804Group rdf:resource="https://w3id.org/eudpp#group_coreImpact"/>
        <rdfs:comment xml:lang="en">Acidification accumulated exceedance, in mol H+-equivalent. Core EN 15804+A2 impact indicator (note: unit change versus EN 15804+A1, which used kg SO2-eq).</rdfs:comment>
        <rdfs:label xml:lang="en">AP - Acidification (accumulated exceedance)</rdfs:label>
        <skos:altLabel xml:lang="en">AP</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
        <eudpp:unitAsString xml:lang="en">mol H+-eq</eudpp:unitAsString>
        <LCA:relatesToLCAIndicator rdf:resource="https://w3id.org/eudpp#ind_EF_acidification"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#ind_CRU -->


