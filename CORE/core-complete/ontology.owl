<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/"
     xml:base="https://w3id.org/eudpp/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:LCA="https://w3id.org/eudpp/LCA#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:epcis="https://ref.gs1.org/epcis/"
     xmlns:eudpp="https://w3id.org/eudpp#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vann1="http://purl.org/vocab/vann#"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/">
        <terms:contributor>Gisa Foyer</terms:contributor>
        <terms:contributor>Jens Niederhausen</terms:contributor>
        <terms:contributor>Theodor Chirvasuta</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-27</terms:created>
        <terms:creator>Daniel Hutzschenreuter</terms:creator>
        <terms:creator>Elio Hbeich</terms:creator>
        <terms:creator>Fatima Danash</terms:creator>
        <terms:creator>Hele-Mai Haav</terms:creator>
        <terms:creator>Marc-Andree Wolf</terms:creator>
        <terms:creator>Riina Maigre</terms:creator>
        <terms:creator>Tarmo Robal</terms:creator>
        <terms:description xml:lang="en">The CORE is the integration ontology that imports all the specific ontology modules and the connector (bridge) ontology of these.

--
THIS DOCUMENT IS PROVIDED WITH NO WARRANTIES WHATSOEVER. 
All liability for any damages arising from use or misuse of this vocabulary is with the user.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</terms:issued>
        <terms:license rdf:resource="http://www.apache.org/licenses/LICENSE-2.0"/>
        <terms:license xml:lang="en">This ontology is licensed under the Apache License, Version 2.0. 
In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0).</terms:license>
        <terms:title xml:lang="en">CORE  of the EU DPP core ontology proposed by the CIRPASS-2 project.</terms:title>
        <vann:preferredNamespacePrefix>eudpp</vann:preferredNamespacePrefix>
        <rdfs:comment xml:lang="en">The CORE of the EU DPP core ontology proposal of the CIRPASS-2 European project.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP CORE</rdfs:label>
        <owl:versionInfo>2.1.0</owl:versionInfo>
    </owl:Ontology>
    


