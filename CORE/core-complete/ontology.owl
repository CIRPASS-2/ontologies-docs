        <rdf:type rdf:resource="https://w3id.org/eudpp#TypeOfReview"/>
        <rdfs:comment xml:lang="en">Reviewer independent of the organisations involved. Acceptable for EN 15804+A2 compliance.</rdfs:comment>
        <rdfs:label xml:lang="en">Independent external review</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#independentInternalReview -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#independentInternalReview">
        <rdf:type rdf:resource="https://w3id.org/eudpp#TypeOfReview"/>
        <rdfs:comment xml:lang="en">Reviewer not involved in the work but belonging to the same organisation or legally linked organisation. Acceptable only for generic data per InData.</rdfs:comment>
        <rdfs:label xml:lang="en">Independent internal review</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#independentOperator -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#independentOperator">
        <rdf:type rdf:resource="https://w3id.org/eudpp#CircularEconomyRole"/>
        <terms:references xml:lang="en">ESPR Art 2 (47)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Independent operator means natural or legal person that is independent of the manufacturer and is directly or indirectly involved in the refurbishment, repair, maintenance or repurposing of a product, and includes waste management operators, refurbishers, repairers, manufacturers or distributors of repair equipment, tools or spare parts, as well as publishers of technical information, operators offering inspection and testing services and operators offering training for installers, manufacturers and repairers of equipment; [ESPR Art 2 (47)]</rdfs:comment>
        <rdfs:label xml:lang="en">Independent Operator</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#independentReviewPanel -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#independentReviewPanel">
        <rdf:type rdf:resource="https://w3id.org/eudpp#TypeOfReview"/>
        <rdfs:comment xml:lang="en">Panel of at least three independent internal or external reviewers, chaired by an independent external reviewer.</rdfs:comment>
        <rdfs:label xml:lang="en">Independent review panel</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#ionisingRadiationEcosystems -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#ionisingRadiationEcosystems">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopNaturalEnvironment"/>
        <rdfs:comment xml:lang="en">Ionising radiation on ecosystems. Note: EN 15804+A2 does not mandate an ecosystems-level ionising-radiation indicator (only IRP for human health). This impact category is retained for ILCD completeness; no EN 15804+A2 indicator individual maps to it.</rdfs:comment>
        <rdfs:label xml:lang="en">Ionising radiation, ecosystems</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#ionisingRadiationHumanHealth -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#ionisingRadiationHumanHealth">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopHumanHealth"/>
        <rdfs:label xml:lang="en">Ionising radiation, human health</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#issuingAgency -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#issuingAgency">
        <rdf:type rdf:resource="https://w3id.org/eudpp#Role"/>
        <terms:references xml:lang="en">ESPR Art 12 (4a)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Issuing agency is a legal person that provides unique identifiers and data carriers Art 12 (4a). Under specific conditions, economic operators may perform the functions associated with an Issuing Agency; [ESPR Art 12 (4b)]</rdfs:comment>
        <rdfs:label xml:lang="en">Issuing Agency</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#item -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#item">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ProductIdentifierGranularity"/>
        <rdfs:comment xml:lang="en">According to ESPR Art 9 (2d) the digital product passport is to be established at model, batch or item level, and the definition of such levels is given by delegated acts;

The term ‘item’ usually refers to a single unit of a model (ESPR preamble (33)).</rdfs:comment>
        <rdfs:label xml:lang="en">item</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#landUseSoilQuality -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#landUseSoilQuality">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopNaturalEnvironment"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopNaturalResources"/>
        <rdfs:label xml:lang="en">Land use / soil quality</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#lcaVerifier -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#lcaVerifier">
        <rdf:type rdf:resource="https://w3id.org/eudpp#Role"/>
        <terms:references xml:lang="en">ISO 14025:2026, 9 and 10.4; ISO 14025:2006, 3.8 and 3.9; ISO 14044:2006, 6; EN 15804:2012+A2:2019, 7.1, Table 2</terms:references>
        <terms:source>https://www.iso.org/standard/87610.html</terms:source>
        <rdfs:comment xml:lang="en">Verifier means a person or organisation that carries out the independent verification of an EPD or LCA study, i.e. confirms through objective evidence that the specified requirements are fulfilled, e.g. the PCR and EN 15804+A2. It also covers the critical reviewer of an LCA study and the verifier of a PEF study. Independent verification may be internal or external; EPDs for business-to-consumer communication require third-party verification, also comparative assertions under ISO 14040 and any comparisons under the European Commission’s ILCD Handbook. The type of verification is recorded on the Review (TypeOfReview). ILCD: reviewer (1-3-20-87); [ISO 14025:2006, 3.8, adapted]</rdfs:comment>
        <rdfs:label xml:lang="en">LCA or EPD verifier</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#licenseFee -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#licenseFee">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LicenseType"/>
        <rdfs:comment xml:lang="en">The study is accessible for a license fee.</rdfs:comment>
        <rdfs:label xml:lang="en">License fee</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#licenseOther -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#licenseOther">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LicenseType"/>
        <rdfs:comment xml:lang="en">Other licensing conditions apply; see accessRestrictions for details.</rdfs:comment>
        <rdfs:label xml:lang="en">Other license</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#manufacturer -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#manufacturer">
        <rdf:type rdf:resource="https://w3id.org/eudpp#EconomicOperatorRole"/>
        <terms:references xml:lang="en">ESPR Art 2 (42)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Manufacturer means any natural or legal person that manufactures a product or that has a product designed or manufactured and markets that product under their name or trademark; [ESPR Art 2 (42)]</rdfs:comment>
        <rdfs:label xml:lang="en">Manufacturer</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#marineEcotoxicity -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#marineEcotoxicity">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopNaturalEnvironment"/>
        <rdfs:label xml:lang="en">Marine ecotoxicity</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#marketSurveillanceAuthority -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#marketSurveillanceAuthority">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AuthorityRole"/>
        <terms:references xml:lang="en">Regulation (EU) 2019/1020, Art 3 (4)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2019/1020/oj</terms:source>
        <rdfs:comment xml:lang="en">Market surveillance authority means an authority designated by a Member State under Article 10 as responsible for carrying out market surveillance in the territory of that Member State; [Regulation (EU) 2019/1020 Art 3 (4)]</rdfs:comment>
        <rdfs:label xml:lang="en">Market Surveillance Authority</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#massFractionUnit -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#massFractionUnit">
        <rdf:type rdf:resource="https://si-digital-framework.org/SI#MeasurementUnit"/>
        <terms:references xml:lang="en">SI style convention: percent denotes the number 0.01; mass fraction values should be represented as decimal ratios in data.</terms:references>
        <terms:source rdf:resource="https://physics.nist.gov/cuu/Units/checklist.html"/>
        <terms:source rdf:resource="https://si-digital-framework.org/"/>
        <rdfs:comment xml:lang="en">Project-managed measurement-unit convention for dimensionless mass fraction expressed as a decimal ratio of masses. Use dpp:numericalValue &quot;0.001&quot;^^xsd:decimal for 0.1 % by mass. This avoids encoding &quot;w/w&quot; in the unit symbol and may be replaced by an official SI Digital Framework PID if one becomes available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">mass fraction unit</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">Implementation measurement-unit convention; not a named SI Digital Framework unit PID.</eudpp:sourceStatus>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#methodology_CML2002 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#methodology_CML2002">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <eudpp:methodologyVersion>2002</eudpp:methodologyVersion>
        <rdfs:comment xml:lang="en">CML-IA (Institute of Environmental Sciences, Leiden University) baseline 2002 methodology. Used by EN 15804+A1 (predecessor of +A2).</rdfs:comment>
        <rdfs:label xml:lang="en">CML 2002</rdfs:label>
        <skos:altLabel xml:lang="en">CML 2002</skos:altLabel>
        <eudpp:sourceVocabulary>LCA ontology extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#methodology_EF3_0 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#methodology_EF3_0">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <eudpp:methodologyVersion>3.0</eudpp:methodologyVersion>
        <rdfs:comment xml:lang="en">European Commission Environmental Footprint method, version 3.0. Predecessor of EF 3.1; some characterisation factors differ.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Footprint 3.0</rdfs:label>
        <skos:altLabel xml:lang="en">EF 3.0</skos:altLabel>
        <eudpp:sourceVocabulary>LCA ontology extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#methodology_EF3_1 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#methodology_EF3_1">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <eudpp:methodologyVersion>3.1</eudpp:methodologyVersion>
        <rdfs:comment xml:lang="en">European Commission Environmental Footprint method, version 3.1. Mandated by EN 15804+A2 as the characterisation basis for the 13 core and 6 with-caveat impact indicators.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Footprint 3.1</rdfs:label>
        <skos:altLabel xml:lang="en">EF 3.1</skos:altLabel>
        <eudpp:sourceVocabulary>LCA ontology extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#methodology_EN15804InventoryRules -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#methodology_EN15804InventoryRules">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <eudpp:methodologyVersion>A2:2019</eudpp:methodologyVersion>
        <rdfs:comment xml:lang="en">Inventory calculation rules defined by EN 15804+A2 itself for the 18 resource-use / waste / output-flow inventory indicators (PERE, PERM, ... EEE, EET). This &quot;methodology&quot; is inventory-level rather than characterised; it is distinguished here from EF 3.1 because the inventory indicators do not use EF characterisation factors.</rdfs:comment>
        <rdfs:label xml:lang="en">EN 15804+A2 inventory calculation rules</rdfs:label>
        <skos:altLabel xml:lang="en">EN 15804+A2 inventory</skos:altLabel>
        <eudpp:sourceVocabulary>LCA ontology extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#methodology_IPCC_AR6 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#methodology_IPCC_AR6">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <eudpp:methodologyVersion>AR6 2021</eudpp:methodologyVersion>
        <rdfs:comment xml:lang="en">IPCC Sixth Assessment Report (2021) global-warming-potential characterisation factors, 100-year time horizon.</rdfs:comment>
        <rdfs:label xml:lang="en">IPCC AR6 (GWP)</rdfs:label>
        <skos:altLabel xml:lang="en">IPCC AR6</skos:altLabel>
        <eudpp:sourceVocabulary>LCA ontology extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#methodology_ReCiPe2016 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#methodology_ReCiPe2016">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <eudpp:methodologyVersion>2016</eudpp:methodologyVersion>
        <rdfs:comment xml:lang="en">ReCiPe methodology version 2016 (midpoint and endpoint). Not used by EN 15804+A2 but frequently used for non-construction-products LCAs.</rdfs:comment>
        <rdfs:label xml:lang="en">ReCiPe 2016</rdfs:label>
        <skos:altLabel xml:lang="en">ReCiPe 2016</skos:altLabel>
        <eudpp:sourceVocabulary>LCA ontology extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#model -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#model">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ProductIdentifierGranularity"/>
        <rdfs:comment xml:lang="en">According to ESPR Art 9 (2d) the digital product passport is to be established at model, batch or item level, and the definition of such levels is given by delegated acts;

The term ‘model’ usually refers to a version of a product of which all units share the same technical characteristics relevant for the ecodesign requirements and the same model identifier (ESPR preamble (33)).</rdfs:comment>
        <rdfs:label xml:lang="en">model</rdfs:label>
    </owl:NamedIndividual>
    


