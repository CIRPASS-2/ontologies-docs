@prefix : <https://w3id.org/eudpp/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/> .

<https://w3id.org/eudpp/> rdf:type owl:Ontology ;
                           <http://purl.org/dc/terms/contributor> "Gisa Foyer" ,
                                                                  "Jens Niederhausen" ,
                                                                  "Theodor Chirvasuta" ;
                           <http://purl.org/dc/terms/created> "2025-02-27"^^xsd:date ;
                           <http://purl.org/dc/terms/creator> "Daniel Hutzschenreuter" ,
                                                              "Elio Hbeich" ,
                                                              "Fatima Danash" ,
                                                              "Hele-Mai Haav" ,
                                                              "Marc-Andree Wolf" ,
                                                              "Riina Maigre" ,
                                                              "Tarmo Robal" ;
                           <http://purl.org/dc/terms/description> """The CORE is the integration ontology that imports all the specific ontology modules and the connector (bridge) ontology of these.

--
THIS DOCUMENT IS PROVIDED WITH NO WARRANTIES WHATSOEVER. 
All liability for any damages arising from use or misuse of this vocabulary is with the user."""@en ;
                           <http://purl.org/dc/terms/issued> "2026-10-16"^^xsd:date ;
                           <http://purl.org/dc/terms/license> <http://www.apache.org/licenses/LICENSE-2.0> ,
                                                              """This ontology is licensed under the Apache License, Version 2.0. 
In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."""@en ;
                           <http://purl.org/dc/terms/title> "CORE  of the EU DPP core ontology proposed by the CIRPASS-2 project."@en ;
                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "eudpp" ;
                           rdfs:comment "The CORE of the EU DPP core ontology proposal of the CIRPASS-2 European project."@en ;
                           rdfs:label "EU DPP CORE"@en ;
                           owl:versionInfo "2.1.0" .

