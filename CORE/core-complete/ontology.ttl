                                                   <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                                   rdfs:comment "Links a substance of concern to a documented qualification assertion."@en ;
                                                   rdfs:isDefinedBy :SOC ;
                                                   rdfs:label "has qualification assertion"@en ;
                                                   <https://w3id.org/eudpp#sourceStatus> "ESPR-grounded modelling relation connecting a SubstanceOfConcern to an explicit Article 2(27) qualification assertion."@en .


###  https://w3id.org/eudpp#hasRecyclingInstruction
<https://w3id.org/eudpp#hasRecyclingInstruction> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                                 rdfs:range <https://w3id.org/eudpp#SubstanceManagementInstruction> ;
                                                 <http://purl.org/dc/terms/references> "ESPR Article 7(5)(e)."@en ;
                                                 <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                                 rdfs:comment "Links a substance presence to information relevant for recycling."@en ;
                                                 rdfs:isDefinedBy :SOC ;
                                                 rdfs:label "Has recycling instruction"@en ;
                                                 <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#hasReferenceToBackgroundDatabase
<https://w3id.org/eudpp#hasReferenceToBackgroundDatabase> rdf:type owl:ObjectProperty ;
                                                          rdfs:subPropertyOf <https://w3id.org/eudpp#hasExternalSource> ;
                                                          rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                                          rdfs:range <https://w3id.org/eudpp#BackgroundDatabase> ;
                                                          rdfs:comment "Link from an LCAStudy to a background LCI database used for the modelling (1..n). Sub-property of eudpp:hasExternalSource."@en ;
                                                          rdfs:label "has reference to background database"@en ;
                                                          <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en .


###  https://w3id.org/eudpp#hasRepresentativeMandate
<https://w3id.org/eudpp#hasRepresentativeMandate> rdf:type owl:ObjectProperty ;
                                                  owl:inverseOf <https://w3id.org/eudpp#representsManufacturer> ;
                                                  rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                                  rdfs:range <https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment> ;
                                                  rdfs:comment "Relates a manufacturer to the mandate (assignment) that authorises an actor to act on the manufacturer's behalf."@en ;
                                                  rdfs:label "has representative mandate"@en .


###  https://w3id.org/eudpp#hasResponsibleManufacturer
<https://w3id.org/eudpp#hasResponsibleManufacturer> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                                    rdfs:range <https://w3id.org/eudpp#Actor> ;
                                                    <http://purl.org/dc/terms/references> "Decision No 768/2008/EC Annex I Art R1 (3)" ,
                                                                                          "ESPR Annex V (2,9)" ;
                                                    <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                                      "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                                    rdfs:comment """Defines the natural or legal person responsible for the EU declaration of conformity.


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                                    rdfs:label "has responsible manufacturer"@en .


###  https://w3id.org/eudpp#hasReuseInstruction
<https://w3id.org/eudpp#hasReuseInstruction> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                             rdfs:range <https://w3id.org/eudpp#SubstanceManagementInstruction> ;
                                             <http://purl.org/dc/terms/references> "ESPR Article 7(5)(e)."@en ;
                                             <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                             rdfs:comment "Links a substance presence to information relevant for reuse."@en ;
                                             rdfs:isDefinedBy :SOC ;
                                             rdfs:label "Has reuse instruction"@en ;
                                             <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#hasReview
<https://w3id.org/eudpp#hasReview> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                   rdfs:range <https://w3id.org/eudpp#Review> ;
                                   rdfs:comment "Link from an LCAStudy to a critical-review / verification record."@en ;
                                   rdfs:label "has review"@en ;
                                   <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element validation/review."@en .


###  https://w3id.org/eudpp#hasRole
