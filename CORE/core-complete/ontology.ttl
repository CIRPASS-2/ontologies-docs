                                    rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                    rdfs:range <https://w3id.org/eudpp#DPP> ;
                                    rdfs:comment "Link to successor DPP"@en ;
                                    rdfs:label "has next DPP"@en .


###  https://w3id.org/eudpp#hasNotifiedBody
<https://w3id.org/eudpp#hasNotifiedBody> rdf:type owl:ObjectProperty ;
