                                            rdfs:domain <https://w3id.org/eudpp#QuantitativeProperty> ;
                                            rdfs:range <https://si-digital-framework.org/SI#MeasurementUnit> ;
                                            rdfs:comment "Linking quantitative property to the unit of measurement."@en ;
                                            rdfs:label "has measurement unit"@en .


###  https://w3id.org/eudpp#hasNotifiedBody
<https://w3id.org/eudpp#hasNotifiedBody> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                         rdfs:range <https://w3id.org/eudpp#Actor> ;
                                         <http://purl.org/dc/terms/references> "Decision No 768/2008/EC Annex I Chapter R4" ,
                                                                               "ESPR Chapter IX" ;
                                         <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                           "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#cpt_IX" ;
                                         rdfs:comment """Specifies the conformity assessment body notified in accordance with ESPR Chapter IX	

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                         rdfs:label "has notified body"@en .


###  https://w3id.org/eudpp#hasProductEvent
<https://w3id.org/eudpp#hasProductEvent> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <https://w3id.org/eudpp#isRepresentedByCarrier> ;
                                         rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                         rdfs:range <https://w3id.org/eudpp#ProductEvent> ;
                                         rdfs:comment "Links an EPCIS-inspired technical event carrier to the product event semantics it journalises."@en ;
                                         rdfs:label "has product event"@en .


###  https://w3id.org/eudpp#hasProductGroup
<https://w3id.org/eudpp#hasProductGroup> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#Product> ;
                                         rdfs:range <https://w3id.org/eudpp#ClassificationCode> ;
                                         <http://purl.org/dc/terms/references> "ESPR Art 2 (4)"@en ;
                                         <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                         rdfs:comment """Product group
means a set of products that serve similar purposes and are similar in terms of use, or have similar
functional properties, and are similar in terms of consumer perception (ESPR Art 2 (4)). The product
group or groups covered are given by delegated acts. (ESPR Art 8 (a))

This will be probably a classification code from some product classification scheme ."""@en ;
                                         rdfs:label "has product group"@en .


###  https://w3id.org/eudpp#hasProperty
<https://w3id.org/eudpp#hasProperty> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                                     rdfs:range <https://w3id.org/eudpp#Property> ;
                                     rdfs:comment """Product has a property that could be a document or some measurable properties (measurands).

Linking the product to the property."""@en ;
                                     rdfs:label "has property"@en .


###  https://w3id.org/eudpp#hasRepresentativeMandate
<https://w3id.org/eudpp#hasRepresentativeMandate> rdf:type owl:ObjectProperty ;
                                                  owl:inverseOf <https://w3id.org/eudpp#representsManufacturer> ;
                                                  rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                                  rdfs:range <https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment> ;
                                                  rdfs:comment "Relates a manufacturer to the mandate (assignment) that authorises an actor to act on the manufacturer's behalf."@en ;
                                                  rdfs:label "has representative mandate"@en .


###  https://w3id.org/eudpp#hasResponsibleManufacturer
<https://w3id.org/eudpp#hasResponsibleManufacturer> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                                    rdfs:range <https://w3id.org/eudpp#Actor> ;
