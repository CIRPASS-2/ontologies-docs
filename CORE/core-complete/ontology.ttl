<https://w3id.org/eudpp#isRepresentedByCarrier> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
                                                rdfs:range <https://ref.gs1.org/epcis/EPCISEvent> ;
