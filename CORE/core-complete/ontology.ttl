                                           rdfs:label "issues certificate"@en .


###  https://w3id.org/eudpp#performedAssessmentAccordingTo
<https://w3id.org/eudpp#performedAssessmentAccordingTo> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                                        rdfs:range <https://w3id.org/eudpp#ConformityAssessmentModule> ;
                                                        <http://purl.org/dc/terms/references> "ESPR Annex V (7)" ;
                                                        <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                                        rdfs:comment """Specifies conformity assess procedure/cerfication scheme performed by the notified body.


ConformityAssessmentModule is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                                        rdfs:label "performed assessment according to"@en .


###  https://w3id.org/eudpp#performedAt
<https://w3id.org/eudpp#performedAt> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
                                     rdfs:range <https://w3id.org/eudpp#Facility> ;
                                     rdfs:comment """Links a product event to the facility where the event was performed or operationally occurred. This is a cross-module relation between EVENT and ACTOR/Facility and is therefore managed in the Connector/mapping layer.

ProductEvent is modelled in the EU DPP CO EVENT module.
Facility is modelled in the EU DPP CO ACTOR module."""@en ;
                                     rdfs:label "performed at"@en ;
                                     rdfs:seeAlso <https://ref.gs1.org/epcis/bizLocation> ,
                                                  <https://ref.gs1.org/epcis/readPoint> .


###  https://w3id.org/eudpp#performedBy
<https://w3id.org/eudpp#performedBy> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
                                     rdfs:range <https://w3id.org/eudpp#Actor> ;
                                     rdfs:comment """Links a product event to the actor that performed, carried out, or was operationally responsible for the event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.

ProductEvent is modelled in the EU DPP CO EVENT module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                     rdfs:label "performed by"@en ;
                                     rdfs:seeAlso <https://w3id.org/eudpp#ActorRoleAssignment> .


###  https://w3id.org/eudpp#qualifiesSubstance
<https://w3id.org/eudpp#qualifiesSubstance> rdf:type owl:ObjectProperty ;
                                            owl:inverseOf <https://w3id.org/eudpp#hasQualificationAssertion> ;
                                            rdfs:domain <https://w3id.org/eudpp#SoCQualificationAssertion> ;
                                            rdfs:range <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                            <http://purl.org/dc/terms/references> "ESPR Article 2(27)."@en ;
                                            <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                            rdfs:comment "Links a qualification assertion to the substance of concern that it positively qualifies."@en ;
                                            rdfs:isDefinedBy :SOC ;
                                            rdfs:label "qualifies substance"@en ;
                                            <https://w3id.org/eudpp#sourceStatus> "ESPR-grounded modelling relation connecting an explicit qualification assertion to the SubstanceOfConcern it qualifies."@en .


###  https://w3id.org/eudpp#quantifiesIndicator
<https://w3id.org/eudpp#quantifiesIndicator> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#LCAResult> ;
                                             rdfs:range <https://w3id.org/eudpp#LCAIndicator> ;
                                             rdfs:comment """Link from an LCAResult (LCIAResult or InventoryIndicatorResult) to the LCAIndicator individual that this result quantifies. 
This is the primary semantic identity of a result: a result is a quantification of an indicator, not of a method. 
Cardinality: exactly 1 per result instance.
Range: LCAIndicator (covers both EN15804Indicator individuals and non-EN-15804 indicators)."""@en ;
                                             rdfs:label "quantifies indicator"@en ;
                                             <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en .


###  https://w3id.org/eudpp#recordedBy
<https://w3id.org/eudpp#recordedBy> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                    rdfs:range <https://w3id.org/eudpp#Actor> ;
                                    rdfs:comment """Links a DPP event record to the actor that created the technical record of the logged DPP-side event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.

DPPEventRecord is modelled in the EU DPP CO EVENT module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                    rdfs:label "recorded by"@en .


###  https://w3id.org/eudpp#recordsDPPEvent
<https://w3id.org/eudpp#recordsDPPEvent> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <https://w3id.org/eudpp#isRecordedAs> ;
                                         rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                         rdfs:range <https://w3id.org/eudpp#DPPEvent> ;
                                         rdfs:comment "Links a DPP event record to the DPP event whose technical registration it captures."@en ;
                                         rdfs:label "records DPP event"@en .


###  https://w3id.org/eudpp#referenceToCompleteReviewReport
<https://w3id.org/eudpp#referenceToCompleteReviewReport> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <https://w3id.org/eudpp#Review> ;
                                                         rdfs:range <https://w3id.org/eudpp#ReviewReport> ;
                                                         rdfs:comment "Link from a Review to the full review report."@en ;
                                                         rdfs:label "reference to complete review report"@en ;
                                                         <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element review/referenceToCompleteReviewReport."@en .


###  https://w3id.org/eudpp#referenceToComplianceStatus
<https://w3id.org/eudpp#referenceToComplianceStatus> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#ComplianceDeclaration> ;
                                                     rdfs:range <https://w3id.org/eudpp#ComplianceStatus> ;
                                                     rdfs:comment "Level of compliance declared by a ComplianceDeclaration (fully compliant, partially compliant, or not compliant)."@en ;
                                                     rdfs:label "reference to compliance status"@en ;
                                                     <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en .


###  https://w3id.org/eudpp#referenceToComplianceSystem
<https://w3id.org/eudpp#referenceToComplianceSystem> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#ComplianceDeclaration> ;
                                                     rdfs:range <https://w3id.org/eudpp#ComplianceSystem> ;
                                                     rdfs:comment "Link from a ComplianceDeclaration to the standard or programme it references (EN 15804+A2, ISO 14025, ISO 21930, etc.)."@en ;
                                                     rdfs:label "reference to compliance system"@en ;
                                                     <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element compliance/referenceToComplianceSystem."@en .


###  https://w3id.org/eudpp#referenceToExternalSource
<https://w3id.org/eudpp#referenceToExternalSource> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://w3id.org/eudpp#LCAMethod> ;
                                                   rdfs:range <https://w3id.org/eudpp#Source> ;
                                                   rdfs:comment "Link from a Method to the external documentation describing the method."@en ;
                                                   rdfs:label "reference to external source"@en ;
                                                   <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element referenceToExternalDocumentation on LCIAMethodDataSet/dataSetInformation."@en .


###  https://w3id.org/eudpp#referenceToLCAMethodReport
<https://w3id.org/eudpp#referenceToLCAMethodReport> rdf:type owl:ObjectProperty ;
                                                    rdfs:subPropertyOf <https://w3id.org/eudpp#referenceToExternalSource> ;
                                                    rdfs:domain <https://w3id.org/eudpp#LCAMethod> ;
                                                    rdfs:range <https://w3id.org/eudpp#LCAMethodReport> ;
                                                    rdfs:comment "Link from a Method to the formal LCIA method report (e.g. the EF 3.1 method description)."@en ;
                                                    rdfs:label "reference to LCA method report"@en ;
                                                    <https://w3id.org/eudpp#sourceVocabulary> "ILCD base"@en .


###  https://w3id.org/eudpp#referenceToModelSource
<https://w3id.org/eudpp#referenceToModelSource> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#ImpactModel> ;
                                                rdfs:range <https://w3id.org/eudpp#Source> ;
                                                rdfs:comment "Link from an ImpactModel to the bibliographic source(s) describing the characterisation model."@en ;
                                                rdfs:label "reference to model source"@en ;
                                                <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element referenceToModelSource."@en .


###  https://w3id.org/eudpp#referenceToOriginalEPD
<https://w3id.org/eudpp#referenceToOriginalEPD> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#EPDStudy> ;
                                                rdfs:range <https://w3id.org/eudpp#EPDDocument> ;
                                                rdfs:comment "Link from the machine-readable EPDStudy to the published EPD document (typically PDF)."@en ;
                                                rdfs:label "reference to original EPD"@en ;
                                                <https://w3id.org/eudpp#sourceVocabulary> "ILCD+EPD extension: Corresponds to the element epd2:referenceToOriginalEPD."@en .


###  https://w3id.org/eudpp#relatesToLCAIndicator
<https://w3id.org/eudpp#relatesToLCAIndicator> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://w3id.org/eudpp#EN15804ImpactIndicator> ;
                                               rdfs:range <https://w3id.org/eudpp#LCIAImpactIndicator> ;
                                               rdfs:comment """Relates an EN15804 impact indicator to the conceptually corresponding EF 3.1 / PEF LCIA impact indicator. 
The two indicators are not equivalent — EN15804 indicators are EPD-specific reporting slots defined by EN15804+A2, while LCIA impact indicators follow the broader EF 3.1 characterisation framework. This property records a conceptual correspondence without implying any equivalence."""@en ;
                                               rdfs:label "relates to LCA indicator"@en ;
                                               <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en .


###  https://w3id.org/eudpp#representsManufacturer
<https://w3id.org/eudpp#representsManufacturer> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment> ;
                                                rdfs:range <https://w3id.org/eudpp#Actor> ;
                                                rdfs:comment "Used when the role is authorisedRepresentativeRole to indicate the manufacturer being represented."@en ;
                                                rdfs:label "represents manufacturer"@en .


###  https://w3id.org/eudpp#representsManufacturerForProduct
<https://w3id.org/eudpp#representsManufacturerForProduct> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment> ;
                                                          rdfs:range <https://w3id.org/eudpp#Product> ;
                                                          rdfs:comment """Indicates which product(s) the authorised representative's mandate covers.

AuthorisedRepresentativeRoleAssignment is modelled in the EU DPP CO ACTOR module.
Product is modelled in the EU DPP CO P_DPP module."""@en ;
                                                          rdfs:label "represents manufacturer for product"@en .


###  https://w3id.org/eudpp#triggersDPPEvent
<https://w3id.org/eudpp#triggersDPPEvent> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <https://w3id.org/eudpp#isTriggeredByProductEvent> ;
                                          rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
                                          rdfs:range <https://w3id.org/eudpp#DPPEvent> ;
                                          rdfs:comment "Links a product event to a DPP event that is triggered as a consequence of it, reflecting the obligation to update the DPP following lifecycle changes of the product."@en ;
                                          rdfs:label "triggers DPP event"@en .


###  https://w3id.org/eudpp#usedForPresumptionOfConformity
<https://w3id.org/eudpp#usedForPresumptionOfConformity> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <https://w3id.org/eudpp#ProductRequirement> ;
                                                        rdfs:range <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
                                                        <http://purl.org/dc/terms/source> """https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I	
Decision No 768/2008/EC Annex I Art R8"""@en ,
                                                                                          """https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_41
ESPR Art 41"""@en ;
                                                        rdfs:comment "This property specifies which harmonised standards (or parts thereof) was used to assess conformity with the Union harmonistation legislation."@en ;
                                                        rdfs:label "used for presumtion of conformity"@en .


###  https://w3id.org/eudpp#usesFacility
<https://w3id.org/eudpp#usesFacility> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                      rdfs:range <https://w3id.org/eudpp#Facility> ;
                                      rdfs:comment "Relates an actor to facility."@en ;
                                      rdfs:label "uses facility"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/hasVersion
<http://purl.org/dc/terms/hasVersion> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty .


###  https://ref.gs1.org/epcis/action
<https://ref.gs1.org/epcis/action> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain [ rdf:type owl:Class ;
                                                 owl:unionOf ( <https://ref.gs1.org/epcis/AggregationEvent>
                                                               <https://ref.gs1.org/epcis/AssociationEvent>
                                                               <https://ref.gs1.org/epcis/ObjectEvent>
                                                               <https://ref.gs1.org/epcis/TransactionEvent>
                                                             )
                                               ] ;
                                   rdfs:range xsd:string ;
                                   <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent> ,
                                                                      <https://ref.gs1.org/epcis/AssociationEvent> ,
                                                                      <https://ref.gs1.org/epcis/ObjectEvent> ,
                                                                      <https://ref.gs1.org/epcis/TransactionEvent> ;
                                   <http://schema.org/rangeIncludes> xsd:string ;
                                   rdfs:comment "How this event relates to the lifecycle of the EPCs named in this event."@en ;
                                   rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                   rdfs:label "action" ;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/eventTime
<https://ref.gs1.org/epcis/eventTime> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                      rdfs:range xsd:dateTimeStamp ;
                                      <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                      <http://schema.org/rangeIncludes> xsd:dateTimeStamp ;
                                      rdfs:comment "The date and time at which the EPCIS Capturing Applications asserts the event occurred."@en ;
                                      rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                      rdfs:label "eventTime" ;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/eventTimeZoneOffset
<https://ref.gs1.org/epcis/eventTimeZoneOffset> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                                rdfs:range xsd:string ;
                                                <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                                <http://schema.org/rangeIncludes> xsd:string ;
                                                rdfs:comment "The time zone offset in effect at the time and place the event occurred, expressed as an offset from UTC. The value of this field SHALL be a string consisting of the character '+' or the character '-', followed by two digits whose value is within the range 00 through 14 (inclusive), followed by a colon character ':', followed by two digits whose value is within the range 00 through 59 (inclusive), except that if the value of the first two digits is 14, the value of the second two digits must be 00. For example, the value +05:30 specifies that where the event occurred, local time was five hours and 30 minutes later than UTC (that is, midnight UTC was 5:30am local time)."@en ;
                                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                rdfs:label "eventTimeZoneOffset" ;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/quantity
<https://ref.gs1.org/epcis/quantity> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://ref.gs1.org/epcis/QuantityElement> ;
                                     rdfs:range xsd:double ;
                                     <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                     <http://schema.org/rangeIncludes> xsd:double ;
                                     rdfs:comment "A number that specifies how many or how much of the specified EPCClass is denoted by this QuantityElement."@en ;
                                     rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                     rdfs:label "quantity" ;
                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/recordTime
<https://ref.gs1.org/epcis/recordTime> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                       rdfs:range xsd:dateTimeStamp ;
                                       <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                       <http://schema.org/rangeIncludes> xsd:dateTimeStamp ;
                                       rdfs:comment "(Optional) The date and time at which this event was recorded by an EPCIS Repository. This field SHALL be ignored when an event is presented to the EPCIS Capture Interface, and SHALL be present when an event is retrieved through the EPCIS Query Interfaces. The recordTime does not describe anything about the real-world event, but is rather a bookkeeping mechanism that plays a role in the interpretation of standing queries"@en ;
                                       rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                       rdfs:label "recordTime" ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/uom
<https://ref.gs1.org/epcis/uom> rdf:type owl:DatatypeProperty ;
                                rdfs:domain [ rdf:type owl:Class ;
                                              owl:unionOf ( <https://ref.gs1.org/epcis/QuantityElement>
                                                            <https://ref.gs1.org/epcis/SensorReport>
                                                          )
                                            ] ;
                                rdfs:range xsd:string ;
                                <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/QuantityElement> ,
                                                                   <https://ref.gs1.org/epcis/SensorReport> ;
                                <http://schema.org/rangeIncludes> xsd:string ;
                                rdfs:comment "(Optional) Unit of measure by which the specified value(s) of the property specified by type should be interpreted.  If there is no value, minValue, maxValue, averageValue or percValue field present, uom SHALL be omitted.  When a uom field is present, its value SHALL be the 2- or 3-character code for a physical unit specified in the 'Common Code' column of UN/CEFACT Recommendation'20 [CEFACT20].   Note: GS1 provides a tool containing a machine-readable file which enables the automatic conversion between quantitative values expressed using UN/CEFACT common codes. [https://ref.gs1.org/tools/UnitConverterUNECERec20]"@en ;
                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                rdfs:label "uom" ;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://schema.org/email
<https://schema.org/email> rdf:type owl:DatatypeProperty ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Links an Actor to its email address."@en ;
                           rdfs:isDefinedBy <https://schema.org/email> ;
                           rdfs:label "has email"@en .


###  https://schema.org/latitude
<https://schema.org/latitude> rdf:type owl:DatatypeProperty ;
                              rdfs:range xsd:decimal ;
                              rdfs:comment "Links facility to its coordinates. Part of schema:geo."@en ;
                              rdfs:isDefinedBy <https://schema.org/latitude> ;
                              rdfs:label "latitude"@en .


###  https://schema.org/longitude
<https://schema.org/longitude> rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:decimal ;
                               rdfs:comment "Links facility to its coordinates. Part of schema:geo."@en ;
                               rdfs:isDefinedBy <https://schema.org/longitude> ;
                               rdfs:label "longitude"@en .


###  https://schema.org/telephone
<https://schema.org/telephone> rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:string ;
                               rdfs:comment "Links an Actor to its phone."@en ;
                               rdfs:isDefinedBy <https://schema.org/telephone> ;
                               rdfs:label "has phone"@en .


###  https://schema.org/url
<https://schema.org/url> rdf:type owl:DatatypeProperty ;
                         rdfs:range xsd:anyURI ;
                         rdfs:comment "The official website or webpage of the actor."^^xsd:anyURI ;
                         rdfs:isDefinedBy <https://schema.org/url> ;
                         rdfs:label "URL"@en .


###  https://w3id.org/eudpp#abbreviation
<https://w3id.org/eudpp#abbreviation> rdf:type owl:DatatypeProperty ;
                                      rdfs:subPropertyOf <https://w3id.org/eudpp#otherName> ;
                                      rdfs:domain <https://w3id.org/eudpp#Substance> ;
                                      rdfs:range xsd:string ;
                                      <http://purl.org/dc/terms/references> "ESPR Article 7(5)(a)(ii)"@en ;
                                      <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                      rdfs:comment "An abbreviation used for the substance."@en ;
                                      rdfs:isDefinedBy :SOC ;
                                      rdfs:label "Abbreviation"@en ;
                                      <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#accessRestrictions
<https://w3id.org/eudpp#accessRestrictions> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                            rdfs:range rdf:langString ;
                                            rdfs:comment "Human-readable description of access and use restrictions for the LCA / EPD study (equivalent to dcterms:accessRights)."@en ;
                                            rdfs:label "access restrictions"@en ;
                                            <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element accessRestrictions."@en .


###  https://w3id.org/eudpp#actorName
<https://w3id.org/eudpp#actorName> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "Name of an actor."@en ;
                                   rdfs:label "actor name"@en .


###  https://w3id.org/eudpp#amount
<https://w3id.org/eudpp#amount> rdf:type owl:DatatypeProperty ;
                                rdfs:domain [ rdf:type owl:Class ;
                                              owl:unionOf ( <https://w3id.org/eudpp#LCAModuleValue>
                                                            <https://w3id.org/eudpp#LCAResult>
                                                          )
                                            ] ;
                                rdfs:range xsd:double ;
                                rdfs:comment "Numerical value of an LCA result or an LCIAModuleValue."@en ;
                                rdfs:label "amount"@en ;
                                <https://w3id.org/eudpp#sourceVocabulary> "ILCD+EPD extension: corresponds to the text content of epd:amount inside LCIAResult/other."@en .


###  https://w3id.org/eudpp#assignedELI
<https://w3id.org/eudpp#assignedELI> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
                                     rdfs:range xsd:anyURI ;
                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli-register/what_is_eli.html"@en ;
                                     rdfs:comment "Standardised identification that makes it easier to identify and describe legislation across Europe."@en ;
                                     rdfs:label "assigned ELI"@en .


###  https://w3id.org/eudpp#assignmentValidFrom
<https://w3id.org/eudpp#assignmentValidFrom> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                             rdfs:range xsd:dateTime ;
                                             rdfs:comment "The date and time from which the actor role assignment is valid."@en ;
                                             rdfs:label "assignment valid from"@en .


###  https://w3id.org/eudpp#assignmentValidTo
<https://w3id.org/eudpp#assignmentValidTo> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                           rdfs:range xsd:dateTime ;
                                           rdfs:comment "The date and time until which the actor role assignment is valid."@en ;
                                           rdfs:label "assignment valid to"@en .


###  https://w3id.org/eudpp#casName
<https://w3id.org/eudpp#casName> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <https://w3id.org/eudpp#Substance> ;
                                 rdfs:range xsd:string ;
                                 <http://purl.org/dc/terms/references> "ESPR Article 7(5)(a)(iv)"@en ;
                                 <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                 rdfs:comment "The Chemical Abstracts Service name of the substance, when available."@en ;
                                 rdfs:isDefinedBy :SOC ;
                                 rdfs:label "CAS name"@en ;
                                 <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#casNumber
<https://w3id.org/eudpp#casNumber> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#Substance> ;
                                   rdfs:range xsd:string ;
                                   <http://purl.org/dc/terms/references> "ESPR Article 7(5)(a)(iv)"@en ;
                                   <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                   rdfs:comment "The Chemical Abstracts Service registry number of the substance, when available."@en ;
                                   rdfs:isDefinedBy :SOC ;
                                   rdfs:label "CAS number"@en ;
                                   <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#certificateNumber
<https://w3id.org/eudpp#certificateNumber> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#ConformityCertificate> ;
                                           rdfs:range xsd:string ;
                                           <http://purl.org/dc/terms/source> "certificate number"@en ;
                                           rdfs:comment "Number of the certificate" ;
                                           rdfs:label "certificate number" .


###  https://w3id.org/eudpp#certificateRevisionNumber
<https://w3id.org/eudpp#certificateRevisionNumber> rdf:type owl:DatatypeProperty ;
                                                   rdfs:domain <https://w3id.org/eudpp#ConformityCertificate> ;
                                                   rdfs:range xsd:string ;
                                                   rdfs:comment "Number of the revision of a certificate" ;
                                                   rdfs:label "certificate revision number"@en .


###  https://w3id.org/eudpp#codeSet
<https://w3id.org/eudpp#codeSet> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <https://w3id.org/eudpp#ClassificationCode> ;
                                 rdfs:range xsd:anyURI ;
                                 rdfs:comment """The product classification code set.

See also Produc hasProductGroup ClassificationCode documentation."""@en ;
                                 rdfs:label "classification code set"@en .


###  https://w3id.org/eudpp#codeValue
<https://w3id.org/eudpp#codeValue> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#ClassificationCode> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "Classification code value from the Classification code set."@en ;
                                   rdfs:label "classification code value"@en .


###  https://w3id.org/eudpp#commodityCode
<https://w3id.org/eudpp#commodityCode> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Product> ;
                                       rdfs:range xsd:string ;
                                       <http://purl.org/dc/terms/references> "ESPR Annex III (d)"@en ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                       rdfs:comment "Relevant commodity codes, such as a TARIC code as defined in Council Regulation (EEC) No 2658/87.[ESPR Annex III (d)]"@en ;
                                       rdfs:label "commodity code"@en .


###  https://w3id.org/eudpp#contentType
<https://w3id.org/eudpp#contentType> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#DocumentFormattedProperty> ;
                                     rdfs:range [ rdf:type rdfs:Datatype ;
                                                  owl:oneOf [ rdf:type rdf:List ;
                                                              rdf:first "application" ;
                                                              rdf:rest [ rdf:type rdf:List ;
                                                                         rdf:first "pdf" ;
                                                                         rdf:rest rdf:nil
                                                                       ]
                                                            ]
                                                ] ;
                                     rdfs:comment "Content type of a document. Can be only “application” or “pdf”."@en ;
                                     rdfs:label "content type"@en .


###  https://w3id.org/eudpp#countryOfOrigin
<https://w3id.org/eudpp#countryOfOrigin> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#Product> ;
                                         rdfs:range xsd:string ;
                                         rdfs:comment """Represents customs/regulatory country of origin, which may be distinct from facility location. 

Note: not specified by ESPR, requested by sectors (reasoning: country of origin must not be inferred automatically from facility country).

Recommended ISO 3166-1 country codes."""@en ;
                                         rdfs:label "country of origin"@en .


###  https://w3id.org/eudpp#dataSetVersion
<https://w3id.org/eudpp#dataSetVersion> rdf:type owl:DatatypeProperty ;
                                        rdfs:subPropertyOf <http://purl.org/dc/terms/hasVersion> ;
                                        rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                        rdfs:range xsd:string ;
                                        rdfs:comment "Version number of this LCA / EPD study instance, independent of the ontology version. Format: major.minor.sub-minor (e.g. \"02.00.011\")."@en ;
                                        rdfs:label "data set version"@en ;
                                        <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element publicationAndOwnership/dataSetVersion."@en .


###  https://w3id.org/eudpp#description
<https://w3id.org/eudpp#description> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                                     rdfs:range xsd:string ;
                                     rdfs:comment "Product description"@en ;
                                     rdfs:label "description"@en .


###  https://w3id.org/eudpp#dictionaryReference
<https://w3id.org/eudpp#dictionaryReference> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#Property> ;
                                             rdfs:range xsd:string ;
                                             rdfs:comment """The reference to the unique identifier of the data point specification defined in the repository/data dictionary.

It is formatted as a URI/URL ."""@en ;
                                             rdfs:label "dictionary reference"@en .


###  https://w3id.org/eudpp#dppBackupUrl
<https://w3id.org/eudpp#dppBackupUrl> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                      rdfs:range xsd:anyURI ;
                                      rdfs:comment "Fallback URL providing direct access to Digital Product Passport data in case the primary provider becomes unavailable."@en ;
                                      rdfs:label "DPP backup URL"@en .


###  https://w3id.org/eudpp#dppEventRecordIdentifier
<https://w3id.org/eudpp#dppEventRecordIdentifier> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                                  rdfs:range xsd:anyURI ;
                                                  rdfs:comment "A unique identifier assigned to a DPP event record."@en ;
                                                  rdfs:label "dpp event record identifier"@en .


###  https://w3id.org/eudpp#dppEventRecordedAt
<https://w3id.org/eudpp#dppEventRecordedAt> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                            rdfs:range xsd:dateTime ;
                                            rdfs:comment "The date and time at which the technical record of a DPP event was created in an information system or audit trail."@en ;
                                            rdfs:label "dpp event recorded at"@en .


###  https://w3id.org/eudpp#dppSchemaVersion
<https://w3id.org/eudpp#dppSchemaVersion> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                          rdfs:range xsd:string ;
                                          rdfs:comment "The reference standard the DPP instance schema refers to."@en ;
                                          rdfs:label "DPP schema version"@en .


###  https://w3id.org/eudpp#dppStatus
<https://w3id.org/eudpp#dppStatus> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                   rdfs:range [ rdf:type rdfs:Datatype ;
                                                owl:oneOf [ rdf:type rdf:List ;
                                                            rdf:first "Active" ;
                                                            rdf:rest [ rdf:type rdf:List ;
                                                                       rdf:first "Archived" ;
                                                                       rdf:rest [ rdf:type rdf:List ;
                                                                                  rdf:first "Inactive" ;
                                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                                             rdf:first "Invalid" ;
                                                                                             rdf:rest rdf:nil
                                                                                           ]
                                                                                ]
                                                                     ]
                                                          ]
                                              ] ;
                                   rdfs:comment "The status of the DPP instance as digital resource."@en ;
                                   rdfs:label "DPP status"@en .


###  https://w3id.org/eudpp#dppUrl
<https://w3id.org/eudpp#dppUrl> rdf:type owl:DatatypeProperty ;
                                rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                rdfs:range xsd:anyURI ;
                                rdfs:comment "Provides the HTTP/URI endpoint to access the live DPP."@en ;
                                rdfs:label "DPP URL"@en .


###  https://w3id.org/eudpp#ecNumber
<https://w3id.org/eudpp#ecNumber> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain <https://w3id.org/eudpp#Substance> ;
                                  rdfs:range xsd:string ;
                                  <http://purl.org/dc/terms/references> "ESPR Article 7(5)(a)(iii)"@en ;
                                  <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                  rdfs:comment "The European Community number indicated in EINECS, ELINCS or the No Longer Polymer list, when available and appropriate."@en ;
                                  rdfs:isDefinedBy :SOC ;
                                  rdfs:label "EC number"@en ;
                                  <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#echaNumber
<https://w3id.org/eudpp#echaNumber> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#Substance> ;
                                    rdfs:range xsd:string ;
                                    <http://purl.org/dc/terms/references> "ESPR Article 7(5)(a)(iii)"@en ;
                                    <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                    rdfs:comment "A number assigned to the substance by the European Chemicals Agency, when available and appropriate."@en ;
                                    rdfs:isDefinedBy :SOC ;
                                    rdfs:label "ECHA number"@en ;
                                    <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#epdFormatVersion
<https://w3id.org/eudpp#epdFormatVersion> rdf:type owl:DatatypeProperty ;
                                          rdfs:subPropertyOf <http://purl.org/dc/terms/hasVersion> ;
                                          rdfs:domain <https://w3id.org/eudpp#EPDStudy> ;
                                          rdfs:range xsd:string ;
                                          rdfs:comment "Version tag of the ILCD+EPD format used (e.g. \"1.3\")."@en ;
                                          rdfs:label "EPD format version"@en ;
                                          <https://w3id.org/eudpp#sourceVocabulary> "ILCD+EPD extension: Corresponds to the attribute @epd2:epd-version on processDataSet."@en .


###  https://w3id.org/eudpp#expiryDate
<https://w3id.org/eudpp#expiryDate> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#EPDStudy> ;
                                    rdfs:range xsd:date ;
                                    rdfs:comment "Date on which the EPD's validity expires. EN 15804+A2 EPDs are typically valid for five years from publication."@en ;
                                    rdfs:label "expiry date"@en ;
                                    <https://w3id.org/eudpp#sourceVocabulary> "ILCD+EPD extension: Corresponds to the element epd2:expirationDateOfEPD on time/other."@en .


###  https://w3id.org/eudpp#forScenario
<https://w3id.org/eudpp#forScenario> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#LCAModuleValue> ;
                                     rdfs:range xsd:string ;
                                     rdfs:comment "Identifier of the scenario this LCIAModuleValue applies to (free-text label matching the EPD's scenario declaration)."@en ;
                                     rdfs:label "for scenario"@en ;
                                     <https://w3id.org/eudpp#sourceVocabulary> "ILCD+EPD extension: Corresponds to the attribute @epd:scenario on epd:amount."@en .


###  https://w3id.org/eudpp#granularity
<https://w3id.org/eudpp#granularity> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                     rdfs:range [ rdf:type rdfs:Datatype ;
                                                  owl:oneOf [ rdf:type rdf:List ;
                                                              rdf:first "batch" ;
                                                              rdf:rest [ rdf:type rdf:List ;
                                                                         rdf:first "item" ;
                                                                         rdf:rest [ rdf:type rdf:List ;
                                                                                    rdf:first "model" ;
                                                                                    rdf:rest rdf:nil
                                                                                  ]
                                                                       ]
                                                            ]
                                                ] ;
                                     <http://purl.org/dc/terms/references> "ESPR Art 9 (2) d"@en ;
                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                     rdfs:comment """ESPR Art 9 (2) d  declares that the digital product passport is to be established at model, batch or item level, and the definition of such levels (is determined by delegated acts (DA));

The product passport should be defined at the level of item, batch or product model, depending on specific needs and complexity of the value chain, the size, nature or impacts of the products considered. (Standardisation Request 5423 7)"""@en ;
                                     rdfs:label "granularity"@en .


###  https://w3id.org/eudpp#hasCopyright
<https://w3id.org/eudpp#hasCopyright> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                      rdfs:range xsd:boolean ;
                                      rdfs:comment "True if a copyright applies to the LCA / EPD study, false otherwise."@en ;
                                      rdfs:label "has copyright"@en ;
                                      <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element publicationAndOwnership/copyright. Modelled as xsd:boolean per the ILCD+EPD schema definition (two-valued)."@en .


###  https://w3id.org/eudpp#identifierExampleValue
<https://w3id.org/eudpp#identifierExampleValue> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#IdentifierScheme> ;
                                                rdfs:range xsd:string ;
                                                rdfs:comment "Example value of the identifier"@en ;
                                                rdfs:label "identifier example value"@en .


###  https://w3id.org/eudpp#identifierExpiresOn
<https://w3id.org/eudpp#identifierExpiresOn> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#Identifier> ;
                                             rdfs:range xsd:date ;
                                             rdfs:comment "Identifier expiration date"@en ;
                                             rdfs:label "identifier expires on"@en .


###  https://w3id.org/eudpp#identifierIssuedOn
<https://w3id.org/eudpp#identifierIssuedOn> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <https://w3id.org/eudpp#Identifier> ;
                                            rdfs:range xsd:date ;
                                            rdfs:comment "Date of issuing the identifier"@en ;
                                            rdfs:label "identifier issued on"@en .


###  https://w3id.org/eudpp#identifierJurisdiction
<https://w3id.org/eudpp#identifierJurisdiction> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#Identifier> ;
                                                rdfs:range [ rdf:type rdfs:Datatype ;
                                                             owl:onDatatype xsd:string ;
                                                             owl:withRestrictions ( [ xsd:length 2
                                                                                    ]
                                                                                    [ xsd:pattern "[A-Z]{2}"
                                                                                    ]
                                                                                  )
                                                           ] ;
                                                rdfs:comment """An optional property used to qualify the issuing country or territory required to disambiguate national registration numbers. 

Format: ISO 3166-1 alpha-2, i.e., two-letter country code, such as FR for France, DE for Germany, EE for Estonia, etc."""@en ;
                                                rdfs:label "identifier juristiction"@en .


###  https://w3id.org/eudpp#identifierMaxLength
<https://w3id.org/eudpp#identifierMaxLength> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#IdentifierScheme> ;
                                             rdfs:range xsd:integer ;
                                             rdfs:comment "Maximum length of the identifier"@en ;
                                             rdfs:label "identifier maximum length"@en .


###  https://w3id.org/eudpp#identifierMinLength
<https://w3id.org/eudpp#identifierMinLength> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#IdentifierScheme> ;
                                             rdfs:range xsd:integer ;
                                             rdfs:comment "Minimum length of the identifier"@en ;
                                             rdfs:label "identifier minimum length"@en .


###  https://w3id.org/eudpp#identifierPattern
<https://w3id.org/eudpp#identifierPattern> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#IdentifierScheme> ;
                                           rdfs:range xsd:string ;
                                           rdfs:comment "A pattern the identifier conforms to, given as a regular expression (regex)."@en ;
                                           rdfs:label "identifier pattern"@en .


###  https://w3id.org/eudpp#identifierSchemeIssuer
<https://w3id.org/eudpp#identifierSchemeIssuer> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#IdentifierScheme> ;
                                                rdfs:range xsd:string ;
                                                rdfs:comment "Issuer of the identifier scheme"@en ;
                                                rdfs:label "identifier scheme issuer"@en .


###  https://w3id.org/eudpp#identifierSchemeVersion
<https://w3id.org/eudpp#identifierSchemeVersion> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain <https://w3id.org/eudpp#IdentifierScheme> ;
                                                 rdfs:range xsd:string ;
                                                 rdfs:comment "Reference standard version the instance schema refers to"@en ;
                                                 rdfs:label "identifier scheme version"@en .


###  https://w3id.org/eudpp#identifierValue
<https://w3id.org/eudpp#identifierValue> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#Identifier> ;
                                         rdfs:range xsd:string ;
                                         rdfs:comment "The (unique) value of the identifier."@en ;
                                         rdfs:label "identifier value"@en .


###  https://w3id.org/eudpp#ilcdFormatVersion
<https://w3id.org/eudpp#ilcdFormatVersion> rdf:type owl:DatatypeProperty ;
                                           rdfs:subPropertyOf <http://purl.org/dc/terms/hasVersion> ;
                                           rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                           rdfs:range xsd:string ;
                                           rdfs:comment "ILCD schema version used by the source serialisation of this study (e.g. '1.1')."@en ;
                                           rdfs:label "ILCD format version"@en ;
                                           <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the attribute @version on processDataSet."@en .


###  https://w3id.org/eudpp#internationalName
<https://w3id.org/eudpp#internationalName> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#Substance> ;
                                           rdfs:range xsd:string ;
                                           <http://purl.org/dc/terms/references> "ESPR Article 7(5)(a)(i)"@en ;
                                           <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                           rdfs:comment "An internationally recognised name for the substance, used when an IUPAC name is not available."@en ;
                                           rdfs:isDefinedBy :SOC ;
                                           rdfs:label "International name"@en ;
                                           <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#isCriticalRawMaterial
<https://w3id.org/eudpp#isCriticalRawMaterial> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                               rdfs:range xsd:boolean ;
                                               <http://purl.org/dc/terms/references> "[ESPR Annex I h)]"@en ;
                                               <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                               rdfs:comment "Product parameters: use or content of recycled materials and recovery of materials, including critical raw materials; [ESPR Annex I h)]"@en ;
                                               rdfs:label "critical raw material"@en .


###  https://w3id.org/eudpp#isDeclared
<https://w3id.org/eudpp#isDeclared> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#LCAModuleValue> ;
                                    rdfs:range xsd:boolean ;
                                    rdfs:comment "True if this module value is declared in the study (has a numerical amount), false if the module is explicitly marked as not declared (ND / MND) for this indicator/scenario. Absence of the LCIAModuleValue triple altogether means the module was not in scope of the study (MNA - module not applicable)."@en ;
                                    rdfs:label "is declared"@en ;
                                    <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en .


###  https://w3id.org/eudpp#isEnergyRelated
<https://w3id.org/eudpp#isEnergyRelated> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#Product> ;
                                         rdfs:range xsd:boolean ;
                                         <http://purl.org/dc/terms/references> "ESPR Art 2 (4)"@en ;
                                         <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                         rdfs:comment """Energy related product
means any product that has an impact on energy consumption during use. (ESPR Art 2 (4)).

The boolean data type property indicates is a Product energy related or not?"""@en ;
                                         rdfs:label "is energy related Product"@en .


###  https://w3id.org/eudpp#isReplaceable
<https://w3id.org/eudpp#isReplaceable> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Product> ;
                                       rdfs:range xsd:boolean ;
                                       rdfs:comment "Indicates whether the product (e.g. a component of another product) can be replaced."@en ;
                                       rdfs:label "is replacable"@en .


###  https://w3id.org/eudpp#iupacName
<https://w3id.org/eudpp#iupacName> rdf:type owl:DatatypeProperty ;
                                   rdfs:subPropertyOf <https://w3id.org/eudpp#internationalName> ;
                                   rdfs:domain <https://w3id.org/eudpp#Substance> ;
                                   rdfs:range xsd:string ;
                                   <http://purl.org/dc/terms/references> "ESPR Article 7(5)(a)(i)"@en ;
                                   <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                   rdfs:comment "The name of the substance in the International Union of Pure and Applied Chemistry nomenclature."@en ;
                                   rdfs:isDefinedBy :SOC ;
                                   rdfs:label "IUPAC name"@en ;
                                   <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#lastUpdate
<https://w3id.org/eudpp#lastUpdate> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                    rdfs:range xsd:dateTimeStamp ;
                                    rdfs:comment "The date and time of the latest update to the DPP instance."@en ;
                                    rdfs:label "last update"@en .


###  https://w3id.org/eudpp#linkToPreviousDPP
<https://w3id.org/eudpp#linkToPreviousDPP> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                           rdfs:range xsd:anyURI ;
                                           <http://purl.org/dc/terms/references> "ESPR Art 11 (d)"@en ,
                                                                                 "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                           rdfs:comment "Where a new digital product passport is created for a product that already has a digital product passport, the new digital product passport shall be linked to the original digital product passport or passports. (ESPR Art 11 (d))"@en ;
                                           rdfs:label "link to previous DPP"@en .


###  https://w3id.org/eudpp#manufacturingDate
<https://w3id.org/eudpp#manufacturingDate> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#Product> ;
                                           rdfs:comment """Date of manufacture of the product. 

The range of the data property is intentionally left open to be specified in accordance of sectorial needs."""@en ;
                                           rdfs:label "manufacturing date"@en .


###  https://w3id.org/eudpp#materialComponent
<https://w3id.org/eudpp#materialComponent> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                           rdfs:range xsd:string ;
                                           rdfs:comment """The specific part of the Product this material belongs to. Description. 
For example, in case of a textile product: [Main, Lining, Filling]."""@en ;
                                           rdfs:label "part of product material is in"@en .


###  https://w3id.org/eudpp#materialComponentLabel
<https://w3id.org/eudpp#materialComponentLabel> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                                rdfs:comment """Optional human-readable label identifying the role or part of the product associated with the material component (e.g. outer layer, lining, filling, casing).

Note: not defined by ESPR, requested by sectors (textile)"""@en ;
                                                rdfs:label "material component label"@en .


###  https://w3id.org/eudpp#materialIsRecyclable
<https://w3id.org/eudpp#materialIsRecyclable> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                              rdfs:range xsd:boolean ;
                                              <http://purl.org/dc/terms/references> "ESPR Art 5 (1n), Annex I d)"@en ;
                                              <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                              rdfs:comment "Product parameters: design for recycling, ease and quality of recycling as expressed through use of easily recyclable materials [ESPR Art 5 (1n), Annex I d)]"@en ;
                                              rdfs:label "recyclable material"@en .


###  https://w3id.org/eudpp#materialIsSustainableRenewable
<https://w3id.org/eudpp#materialIsSustainableRenewable> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                                        rdfs:range xsd:boolean ;
                                                        <http://purl.org/dc/terms/references> "ESPR Annex I i)"@en ;
                                                        <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                        rdfs:comment "Product parameters: use or content of sustainable renewable materials; [ESPR Annex I i)]"@en ;
                                                        rdfs:label "sustainale or renewable material"@en .


###  https://w3id.org/eudpp#materialPercentage
<https://w3id.org/eudpp#materialPercentage> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                            rdfs:range xsd:decimal ;
                                            rdfs:comment "Material percentage in a Product, e.g., mass fraction (percentage by weight)."@en ;
                                            rdfs:label "material percentage"@en .


###  https://w3id.org/eudpp#materialRecycledContent
<https://w3id.org/eudpp#materialRecycledContent> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                                 rdfs:range xsd:decimal ;
                                                 rdfs:comment "Percentage of recycled content"@en ;
                                                 rdfs:label "recycled content amount in material"@en .


###  https://w3id.org/eudpp#materialRecycledContentType
<https://w3id.org/eudpp#materialRecycledContentType> rdf:type owl:DatatypeProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                                     rdfs:range [ rdf:type rdfs:Datatype ;
                                                                  owl:oneOf [ rdf:type rdf:List ;
                                                                              rdf:first "post-consumer" ;
                                                                              rdf:rest [ rdf:type rdf:List ;
                                                                                         rdf:first "pre-consumer" ;
                                                                                         rdf:rest [ rdf:type rdf:List ;
                                                                                                    rdf:first "unknown" ;
                                                                                                    rdf:rest rdf:nil
                                                                                                  ]
                                                                                       ]
                                                                            ]
                                                                ] ;
                                                     rdfs:comment "Specifies the origin of recycled content: pre-consumer (manufacturing waste) or post-consumer (end-of-life waste), as required by regulatory differentiation."@en ;
                                                     rdfs:label "material recycled content type"@en .


###  https://w3id.org/eudpp#materialTypeScheme
