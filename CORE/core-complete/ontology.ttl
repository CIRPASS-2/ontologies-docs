xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#broader
<http://www.w3.org/2004/02/skos/core#broader> rdf:type owl:ObjectProperty .


###  http://www.w3.org/2004/02/skos/core#related
<http://www.w3.org/2004/02/skos/core#related> rdf:type owl:ObjectProperty .


###  https://ref.gs1.org/epcis/bizLocation
<https://ref.gs1.org/epcis/bizLocation> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                        <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                        rdfs:comment "(Optional) The business location where the objects associated with the EPCs may be found, until contradicted by a subsequent event."@en ;
                                        rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                        rdfs:label "bizLocation" ;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/bizStep
<https://ref.gs1.org/epcis/bizStep> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                    rdfs:range <https://ref.gs1.org/cbv/BizStep> ;
                                    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                    <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/BizStep> ;
                                    rdfs:comment "(Optional) The business step of which this event was a part."@en ;
                                    rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                    rdfs:label "bizStep" ;
                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/bizTransactionList
<https://ref.gs1.org/epcis/bizTransactionList> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                               rdfs:range <https://ref.gs1.org/epcis/BizTransaction> ;
                                               <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                               <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/BizTransaction> ;
                                               rdfs:comment "(Optional) An unordered list of business transactions that define the context of this event."@en ;
                                               rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                               rdfs:label "bizTransactionList" ;
                                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/bizTransactionType
<https://ref.gs1.org/epcis/bizTransactionType> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://ref.gs1.org/epcis/BizTransaction> ;
                                               rdfs:range <https://ref.gs1.org/cbv/BTT> ;
                                               <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/BizTransaction> ;
                                               <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/BTT> ;
                                               rdfs:comment "An identifier that indicates the type of BizTransaction document (e.g. Purchase Order, Despatch Advice)."@en ;
                                               rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                               rdfs:label "bizTransactionType" ;
                                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                               <https://ref.gs1.org/epcis/jsonldLabel> "type" .


###  https://ref.gs1.org/epcis/childEPCs
<https://ref.gs1.org/epcis/childEPCs> rdf:type owl:ObjectProperty ;
                                      rdfs:domain [ rdf:type owl:Class ;
                                                    owl:unionOf ( <https://ref.gs1.org/epcis/AggregationEvent>
                                                                  <https://ref.gs1.org/epcis/AssociationEvent>
                                                                )
                                                  ] ;
                                      <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent> ,
                                                                         <https://ref.gs1.org/epcis/AssociationEvent> ;
                                      rdfs:comment "(Optional) An unordered list of the EPCs of contained objects identified by instance-level identifiers. An AggregationEvent SHALL contain either a nonempty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent.  An AssociationEvent SHALL contain either a non-empty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disassociated from the parent."@en ;
                                      rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                      rdfs:label "childEPCs" ;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/childQuantityList
<https://ref.gs1.org/epcis/childQuantityList> rdf:type owl:ObjectProperty ;
                                              rdfs:domain [ rdf:type owl:Class ;
                                                            owl:unionOf ( <https://ref.gs1.org/epcis/AggregationEvent>
                                                                          <https://ref.gs1.org/epcis/AssociationEvent>
                                                                        )
                                                          ] ;
                                              rdfs:range <https://ref.gs1.org/epcis/QuantityElement> ;
                                              <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent> ,
                                                                                 <https://ref.gs1.org/epcis/AssociationEvent> ;
                                              <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                              rdfs:comment "(Optional) An unordered list of one or more QuantityElements identifying (at the class level) contained objects. An AggregationEvent SHALL contain either a nonempty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent.  An AssociationEvent SHALL contain either a non-empty childEPCs, a non-empty childQuantityList, or both, except that both childEPCs and childQuantityList MAY be empty if action is DELETE, indicating that all children are disaggregated from the parent."@en ;
                                              rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                              rdfs:label "childQuantityList" ;
                                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/destinationList
<https://ref.gs1.org/epcis/destinationList> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                            rdfs:range <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                            <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                            <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                            rdfs:comment "(Optional) An unordered list of Destination elements that provide context about the terminating endpoint of a business transfer of which this event is a part."@en ;
                                            rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                            rdfs:label "destinationList" ;
                                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/disposition
<https://ref.gs1.org/epcis/disposition> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                        rdfs:range <https://ref.gs1.org/cbv/Disp> ;
                                        <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                        <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/Disp> ;
                                        rdfs:comment "(Optional) The business condition of the objects associated with the EPCs, presumed to hold true until contradicted by a subsequent event."@en ;
                                        rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                        rdfs:label "disposition" ;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/epcClass
<https://ref.gs1.org/epcis/epcClass> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://ref.gs1.org/epcis/QuantityElement> ;
                                     <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                     rdfs:comment "A class-level identifier for the class to which the specified quantity of objects belongs."@en ;
                                     rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                     rdfs:label "epcClass" ;
                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/epcList
<https://ref.gs1.org/epcis/epcList> rdf:type owl:ObjectProperty ;
                                    rdfs:domain [ rdf:type owl:Class ;
                                                  owl:unionOf ( <https://ref.gs1.org/epcis/ObjectEvent>
                                                                <https://ref.gs1.org/epcis/TransactionEvent>
                                                              )
                                                ] ;
                                    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/ObjectEvent> ,
                                                                       <https://ref.gs1.org/epcis/TransactionEvent> ;
                                    rdfs:comment "(Optional) An unordered list of one or more EPCs naming specific objects to which the event pertained."@en ;
                                    rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                    rdfs:label "epcList" ;
                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/inputEPCList
<https://ref.gs1.org/epcis/inputEPCList> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent> ;
                                         <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent> ;
                                         rdfs:comment "(Optional) An unordered list of one or more EPCs identifying (at the instance level) objects that were inputs to the transformation."@en ;
                                         rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                         rdfs:label "inputEPCList" ;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/inputQuantityList
<https://ref.gs1.org/epcis/inputQuantityList> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent> ;
                                              rdfs:range <https://ref.gs1.org/epcis/QuantityElement> ;
                                              <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent> ;
                                              <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                              rdfs:comment "(Optional) An unordered list of one or more QuantityElements identifying (at the class level) objects that were inputs to the transformation. See below for constraints on when inputQuantityList may be omitted."@en ;
                                              rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                              rdfs:label "inputQuantityList" ;
                                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/outputEPCList
<https://ref.gs1.org/epcis/outputEPCList> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent> ;
                                          <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent> ;
                                          rdfs:comment "(Optional) An unordered list of one or more EPCs naming (at the instance level) objects that were outputs from the transformation."@en ;
                                          rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                          rdfs:label "outputEPCList" ;
                                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/outputQuantityList
<https://ref.gs1.org/epcis/outputQuantityList> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent> ;
                                               rdfs:range <https://ref.gs1.org/epcis/QuantityElement> ;
                                               <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent> ;
                                               <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                               rdfs:comment "(Optional) An unordered list of one or more QuantityElements identifying (at the class level) objects that were outputs from the transformation. See below for constraints on when outputQuantityList may be omitted."@en ;
                                               rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                               rdfs:label "outputQuantityList" ;
                                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/parentID
<https://ref.gs1.org/epcis/parentID> rdf:type owl:ObjectProperty ;
                                     rdfs:domain [ rdf:type owl:Class ;
                                                   owl:unionOf ( <https://ref.gs1.org/epcis/AggregationEvent>
                                                                 <https://ref.gs1.org/epcis/AssociationEvent>
                                                                 <https://ref.gs1.org/epcis/TransactionEvent>
                                                               )
                                                 ] ;
                                     <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent> ,
                                                                        <https://ref.gs1.org/epcis/AssociationEvent> ,
                                                                        <https://ref.gs1.org/epcis/TransactionEvent> ;
                                     rdfs:comment "(Optional when action is OBSERVE, required otherwise) The identifier of the parent of the aggregation or association. When the parent identifier is an EPC, this field SHALL contain the 'pure identity' URI for the EPC as specified in the GS1 Tag Data Standard"@en ;
                                     rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                     rdfs:label "parentID" ;
                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/quantityList
<https://ref.gs1.org/epcis/quantityList> rdf:type owl:ObjectProperty ;
                                         rdfs:domain [ rdf:type owl:Class ;
                                                       owl:unionOf ( <https://ref.gs1.org/epcis/ObjectEvent>
                                                                     <https://ref.gs1.org/epcis/TransactionEvent>
                                                                   )
                                                     ] ;
                                         rdfs:range <https://ref.gs1.org/epcis/QuantityElement> ;
                                         <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/ObjectEvent> ,
                                                                            <https://ref.gs1.org/epcis/TransactionEvent> ;
                                         <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                         rdfs:comment "(Optional) An unordered list of one or more QuantityElements identifying (at the class level) objects to which the event pertained."@en ;
                                         rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                         rdfs:label "quantityList" ;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/readPoint
<https://ref.gs1.org/epcis/readPoint> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                      <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                      rdfs:comment "(Optional) The read point at which the event took place."@en ;
                                      rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                      rdfs:label "readPoint" ;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/sourceList
<https://ref.gs1.org/epcis/sourceList> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                       rdfs:range <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                       <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                       <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                       rdfs:comment "(Optional) An unordered list of Source elements that provide context about the originating endpoint of a business transfer of which this event is a part."@en ;
                                       rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                       rdfs:label "sourceList" ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/sourceOrDestination
<https://ref.gs1.org/epcis/sourceOrDestination> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                                <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                                rdfs:comment """An identifier that denotes the specific source or destination of a business transfer.
The semantic role of the identifier is indicated by sourceOrDestinationType. Resolution of that identifier to EU DPP Actor or Facility concepts, when applicable, is handled outside the EPCIS technical carrier layer."""@en ;
                                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                rdfs:label "sourceOrDestination" ;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                                <https://ref.gs1.org/epcis/jsonldLabel> "destination" ,
                                                                                        "source" .


###  https://ref.gs1.org/epcis/sourceOrDestinationType
<https://ref.gs1.org/epcis/sourceOrDestinationType> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                                    rdfs:range <https://ref.gs1.org/cbv/SDT> ;
                                                    <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/SourceOrDestination> ;
                                                    <http://schema.org/rangeIncludes> <https://ref.gs1.org/cbv/SDT> ;
                                                    rdfs:comment """An identifier that indicates the role of SourceOrDestination in a transfer (Owning Party, Possessing Party, or Location).
This role determines how the corresponding sourceOrDestination identifier is interpreted. Mapping to EU DPP Actor or Facility concepts, when applicable, is handled outside the EPCIS technical carrier layer."""@en ;
                                                    rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                    rdfs:label "sourceOrDestinationType" ;
                                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                                    <https://ref.gs1.org/epcis/jsonldLabel> "type" .


###  https://ref.gs1.org/epcis/transformationID
<https://ref.gs1.org/epcis/transformationID> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://ref.gs1.org/epcis/TransformationEvent> ;
                                             rdfs:range <https://ref.gs1.org/epcis/Transformation> ;
                                             <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/TransformationEvent> ;
                                             <http://schema.org/rangeIncludes> <https://ref.gs1.org/epcis/Transformation> ;
                                             rdfs:comment "(Optional) Associates several TransformationEvents with a longer-running Transformation process, therefore linking them together."@en ;
                                             rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                             rdfs:label "transformationID" ;
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://schema.org/address
<https://schema.org/address> rdf:type owl:ObjectProperty ;
                             rdfs:comment "Links an Actor or Facility to its postal address, represented as a schema:PostalAddress"@en ;
                             rdfs:isDefinedBy <https://schema.org/address> ;
                             rdfs:label "has address"@en .


###  https://schema.org/geo
<https://schema.org/geo> rdf:type owl:ObjectProperty ;
                         rdfs:comment "Links facility to its coordinates, represented as schema:geo."@en ;
                         rdfs:isDefinedBy <https://schema.org/geo> ;
                         rdfs:label "has coordinates"@en .


###  https://w3id.org/eudpp#accordingTo
<https://w3id.org/eudpp#accordingTo> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#ConformityCertificate> ;
                                     rdfs:range <https://w3id.org/eudpp#ConformityAssessmentModule> ;
                                     <http://purl.org/dc/terms/source> """https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4
Decision No 768/2008/EC Art 4"""@en ,
                                                                       """https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43	
ESPR Art 43"""@en ;
                                     rdfs:comment "Property defining specifies conformity assess procedure/cerfication scheme underlying the cerfificate."@en ;
                                     rdfs:label "according to"@en .


###  https://w3id.org/eudpp#addressesAoP
<https://w3id.org/eudpp#addressesAoP> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#LCIAImpactCategory> ;
                                      rdfs:range <https://w3id.org/eudpp#AreaOfProtection> ;
                                      rdfs:comment """Link between an LCIAImpactCategory and the Area(s)-of-protection it addresses.
1..n cardinality: a single impact category can address several Areas of Protection — for example, ozone depletion affects both Natural Environment and Human Health."""@en ;
                                      rdfs:label "addresses AoP"@en ;
                                      <https://w3id.org/eudpp#sourceVocabulary> "ILCD base"@en .


###  https://w3id.org/eudpp#allowsConformityAssessmentModule
<https://w3id.org/eudpp#allowsConformityAssessmentModule> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
                                                          rdfs:range <https://w3id.org/eudpp#ConformityAssessmentModule> ;
                                                          <http://purl.org/dc/terms/source> """https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4
Decision No 768/2008/EC Art 4"""@en ,
                                                                                            """https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43
ESPR Art 43"""@en ;
                                                          rdfs:comment "A property that specifies the conformity assment procedure applicable to the type of product"@en ;
                                                          rdfs:label "allows Conformity Assessment Module"@en .


###  https://w3id.org/eudpp#appliesToProduct
<https://w3id.org/eudpp#appliesToProduct> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <https://w3id.org/eudpp#hasDPP> ;
                                          rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                          rdfs:range <https://w3id.org/eudpp#Product> ;
                                          rdfs:comment "The property links DPP and the Product."@en ;
                                          rdfs:label "applies to product"@en .


###  https://w3id.org/eudpp#assessesImpactCategory
<https://w3id.org/eudpp#assessesImpactCategory> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#LCIAImpactIndicator> ;
                                                rdfs:range <https://w3id.org/eudpp#LCIAImpactCategory> ;
                                                rdfs:comment "Link from an LCIA impact indicator to the mid-point impact category it characterises. Multiple indicators may assess the same category (e.g. Eutrophication, freshwater and Eutrophication, marine both relate to Eutrophication). This property expresses a conceptual classification link, not equivalence."@en ;
                                                rdfs:label "assesses impact category"@en ;
                                                <https://w3id.org/eudpp#sourceVocabulary> "LCAnet: relates to the element assessIC (https://w3id.org/lcanet/ia#assessIC) in the IA module."@en .


###  https://w3id.org/eudpp#belongsToEn15804Group
<https://w3id.org/eudpp#belongsToEn15804Group> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://w3id.org/eudpp#EN15804Indicator> ;
                                               rdfs:range <https://w3id.org/eudpp#EN15804IndicatorGroup> ;
                                               rdfs:comment "Link from an EN15804Indicator individual to the indicator EN15804IndicatorGroup it belongs to (core impact, with-caveats, resource use, waste, valorisation, exported energy)."@en ;
                                               rdfs:label "belongs to EN 15804 indicator group"@en ;
                                               <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en .


###  https://w3id.org/eudpp#belongsToMethodology
<https://w3id.org/eudpp#belongsToMethodology> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://w3id.org/eudpp#LCAMethod> ;
                                              rdfs:range <https://w3id.org/eudpp#LCAMethodology> ;
                                              rdfs:comment "Link from a Method to one or several LCAMethodology individuals it belongs to (e.g. eudpp:methodology_EF3_1). Cardinality 1..n: a single method can be classified into more than one methodology (for example, when two methodologies share the same characterisation factors for one indicator)."@en ;
                                              rdfs:label "belongs to methodology"@en ;
                                              <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en ,
                                                                                        "LCAnet: relates to the element includedInMethodology (https://w3id.org/lcanet/ia#includedInMethodology) in the IA module." .


###  https://w3id.org/eudpp#computedByMethod
<https://w3id.org/eudpp#computedByMethod> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://w3id.org/eudpp#LCAIndicator> ;
                                          rdfs:range <https://w3id.org/eudpp#LCAMethod> ;
                                          rdfs:comment """Link from an LCAIndicator individual to the IndicatorMethod instance that describes how this indicator is computed — its impact model, impact category, methodology reference, reference report, and ILCD method metadata. 
Cardinality: at most 1 per indicator individual.\""""@en ;
                                          rdfs:label "computed by method"@en ;
                                          <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en .


###  https://w3id.org/eudpp#concernsDPP
<https://w3id.org/eudpp#concernsDPP> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#DPPEvent> ;
                                     rdfs:range <https://w3id.org/eudpp#DPP> ;
                                     rdfs:comment """Links a DPP event to the Digital Product Passport whose content, state, or accessibility is affected by the event. This is a cross-module relation between EVENT and P_DPP and is therefore managed in the Connector/mapping layer.

DPP is modelled in the EU DPP CO P_DPP module.
DPPEvent is modelled in the EU DPP CO EVENT module."""@en ;
                                     rdfs:label "concerns DPP"@en .


###  https://w3id.org/eudpp#concernsProduct
<https://w3id.org/eudpp#concernsProduct> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
                                         rdfs:range <https://w3id.org/eudpp#Product> ;
                                         rdfs:comment """Links a product event to the product whose state, condition, or lifecycle is affected by the event. This is a cross-module relation between EVENT and P_DPP and is therefore managed in the Connector/mapping layer.

Product is modelled in the EU DPP CO P_DPP module.
ProductEvent is modelled in the EU DPP CO EVENT module."""@en ;
                                         rdfs:label "concerns product"@en .


###  https://w3id.org/eudpp#concernsSubstance
<https://w3id.org/eudpp#concernsSubstance> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                           rdfs:range <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                           <http://purl.org/dc/terms/references> "ESPR Article 7(5)(a)"@en ;
                                           <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                           rdfs:comment "Links a reported SubstancePresence to the SubstanceOfConcern involved. dpp:Substance remains the superclass used for generic substance identity and naming properties, but the SOC reporting relation itself is intentionally restricted to dpp:SubstanceOfConcern."@en ;
                                           rdfs:isDefinedBy :SOC ;
                                           rdfs:label "Concerns substance"@en ;
                                           <https://w3id.org/eudpp#sourceStatus> "ESPR-grounded ontology modelling abstraction; this RDF resource is not itself a term defined by the Regulation."@en .


###  https://w3id.org/eudpp#conformityAttestedBy
<https://w3id.org/eudpp#conformityAttestedBy> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
                                              rdfs:range <https://w3id.org/eudpp#Actor> ;
                                              <http://purl.org/dc/terms/references> "ESPR Annex V (7)" ;
                                              <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                              rdfs:comment """Specifies the notified body that attest the product's conformity with Union harmonisation legislation. 

UnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                              rdfs:label "conformity attested by"@en .


###  https://w3id.org/eudpp#conformityDeclaredTo
<https://w3id.org/eudpp#conformityDeclaredTo> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                              rdfs:range <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
                                              <http://purl.org/dc/terms/source> "ESPR Annex V"@en ;
                                              rdfs:comment "A property which specifies which Union Harmonisation Legislation conformity is declared to."@en ;
                                              rdfs:label "conformity declared to"@en .


###  https://w3id.org/eudpp#containsSubstanceOfConcern
<https://w3id.org/eudpp#containsSubstanceOfConcern> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain [ rdf:type owl:Class ;
                                                                  owl:unionOf ( <https://w3id.org/eudpp#MaterialOfComposition>
                                                                                <https://w3id.org/eudpp#Product>
                                                                              )
                                                                ] ;
                                                    rdfs:range <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                                    rdfs:comment """Linking the product to a substance of concern the product contains.

Product is modelled in the EU DPP CO P_DPP module.
Substance of concern is modelled in the EU DPP CO SOC module."""@en ;
                                                    rdfs:label "contains substance of concern"@en .


###  https://w3id.org/eudpp#declaresManufacturerRecord
<https://w3id.org/eudpp#declaresManufacturerRecord> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                                    rdfs:range <https://w3id.org/eudpp#ManufacturerRecord> ;
                                                    rdfs:comment "Links an LCA study to a manufacturer record documenting the manufacturers whose data is included in the study."@en ;
                                                    rdfs:label "declares Manufacturer Record"@en ;
                                                    <https://w3id.org/eudpp#sourceVocabulary> "ILCD+EPD extension: Corresponds to the element epd24:manufacturers/epd24:manufacturer"@en .


###  https://w3id.org/eudpp#followsPCR
<https://w3id.org/eudpp#followsPCR> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#EPDStudy> ;
                                    rdfs:range <https://w3id.org/eudpp#PCR> ;
                                    rdfs:comment "Link from an EPDStudy to the Product Category Rules document(s) it follows (1..n)."@en ;
                                    rdfs:label "follows PCR"@en ;
                                    <https://w3id.org/eudpp#sourceVocabulary> "ILCD+EPD extension: Corresponds to the element referenceToPCR."@en .


###  https://w3id.org/eudpp#followsPEFCR
<https://w3id.org/eudpp#followsPEFCR> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                      rdfs:range <https://w3id.org/eudpp#PEFCR> ;
                                      rdfs:comment "Link from an LCAStudy to a Product Environmental Footprint Category Rules document (1..n)."@en ;
                                      rdfs:label "follows PEFCR"@en ;
                                      <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en .


###  https://w3id.org/eudpp#forLifeCycleModule
<https://w3id.org/eudpp#forLifeCycleModule> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://w3id.org/eudpp#LCAModuleValue> ;
                                            rdfs:range <https://w3id.org/eudpp#LifeCycleModule> ;
                                            rdfs:comment "Link from an LCAModuleValue to the Life-cycle module it refers to."@en ;
                                            rdfs:label "for life-cycle module"@en ;
                                            <https://w3id.org/eudpp#sourceVocabulary> "ILCD+EPD extension: Corresponds to the attribute @epd:module on epd:amount."@en .


###  https://w3id.org/eudpp#hasActor
<https://w3id.org/eudpp#hasActor> rdf:type owl:ObjectProperty ;
                                  rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                  rdfs:range <https://w3id.org/eudpp#Actor> ;
                                  rdfs:comment "Links actor role assignment to actor"@en ;
                                  rdfs:label "has actor"@en .


###  https://w3id.org/eudpp#hasActorRoleAssignment
<https://w3id.org/eudpp#hasActorRoleAssignment> rdf:type owl:ObjectProperty ;
                                                owl:inverseOf <https://w3id.org/eudpp#isActorRoleAssignmentForEvent> ;
                                                rdfs:domain <https://w3id.org/eudpp#ESPREvent> ;
                                                rdfs:range <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                                rdfs:comment """Links an event to an actor-role assignment that is valid in the context of that event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.

ESPREvent is modelled in the EU DPP CO EVENT module.
ActorRoleAssignment is modelled in the EU DPP CO ACTOR module."""@en ;
                                                rdfs:label "has actor role assignment"@en .


###  https://w3id.org/eudpp#hasApplicableQualification
<https://w3id.org/eudpp#hasApplicableQualification> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                                    rdfs:range <https://w3id.org/eudpp#SoCQualificationAssertion> ;
                                                    <http://purl.org/dc/terms/references> "ESPR Articles 2(27) and 7(5)."@en ;
                                                    <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                                    rdfs:comment "Links a SubstancePresence to an applicable qualification assertion; criterion (d) context is presence-scoped."@en ;
                                                    rdfs:isDefinedBy :SOC ;
                                                    rdfs:label "has applicable qualification"@en ;
                                                    <https://w3id.org/eudpp#sourceStatus> "ESPR-grounded contextual relation connecting a SubstancePresence to the qualification assertion applicable in that product-specific presence context."@en .


###  https://w3id.org/eudpp#hasAuthorisedRepresentative
<https://w3id.org/eudpp#hasAuthorisedRepresentative> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                                     rdfs:range <https://w3id.org/eudpp#Actor> ;
                                                     <http://purl.org/dc/terms/references> "Decision No 768/2008/EC Annex I Art R1 (4)" ,
                                                                                           "ESPR Annex V (2,9)" ;
                                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                                       "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                                     rdfs:comment """Specifies the natural or legal person established within the Union who has received a written mandate from a manufacturer to act on his behalf in relation to the Declaration of Conformity.

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.

Source: 
Decision No 768/2008/EC Annex I Art R1 (4)
https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I

ESPR Annex V (2,9)
https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V"""@en ;
                                                     rdfs:label "has authorised representative"@en .


###  https://w3id.org/eudpp#hasBackUpCopyHost
<https://w3id.org/eudpp#hasBackUpCopyHost> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                           rdfs:range <https://w3id.org/eudpp#Actor> ;
                                           <http://purl.org/dc/terms/references> "ESPR Annex III" ;
                                           <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                           rdfs:comment """The reference of the digital product passport service provider hosting the back-up copy of the digital product passport [ESPR Annex III].

DPP is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                           rdfs:label "has back-up-copy host"@en .


###  https://w3id.org/eudpp#hasComplianceDeclaration
<https://w3id.org/eudpp#hasComplianceDeclaration> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                                  rdfs:range <https://w3id.org/eudpp#ComplianceDeclaration> ;
                                                  rdfs:comment "Link from an LCAStudy (or its subclass EPDStudy) to a ComplianceDeclaration. Compliance can be declared against any standard relevant to the study type (ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, PEFCR-specific rules, etc.)."@en ;
                                                  rdfs:label "has compliance declaration"@en ;
                                                  <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element complianceDeclarations/compliance. Domain widened in v1.9.7 from EPDStudy to LCAStudy."@en .


###  https://w3id.org/eudpp#hasConcentration
<https://w3id.org/eudpp#hasConcentration> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                          rdfs:range <https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern> ;
                                          rdfs:comment """Links a substance presence to concentration information. A concentration is contextual to the structural location identified by the associated SubstancePresence. 

Different product, component, or spare-part locations requiring different concentrations should normally use distinct SubstancePresence records. 

Exact, maximum, and range representations remain distinguished by the existing P_DPP/SOC concentration model.

ConcentrationOfSubstanceOfConcern is modelled in the EU DPP CO P_DPP module.
SubstancePresence is modelled in the EU DPP CO IDENT module."""@en ;
                                          rdfs:label "has concentration"@en .


###  https://w3id.org/eudpp#hasDPP
<https://w3id.org/eudpp#hasDPP> rdf:type owl:ObjectProperty ;
                                rdfs:domain <https://w3id.org/eudpp#Product> ;
                                rdfs:range <https://w3id.org/eudpp#DPP> ;
                                rdfs:comment "A Product has a DPP. The property links a Product with a DPP."@en ;
                                rdfs:label "has DPP"@en .


###  https://w3id.org/eudpp#hasDPPActionType
<https://w3id.org/eudpp#hasDPPActionType> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://w3id.org/eudpp#DPPUpdateEvent> ;
                                          rdfs:range <https://w3id.org/eudpp#DPPActionType> ;
                                          rdfs:comment "Links a DPP update event to the type of information-level action performed on the Digital Product Passport."@en ;
                                          rdfs:label "has DPP action type"@en .


###  https://w3id.org/eudpp#hasDigitalProductPassportId
<https://w3id.org/eudpp#hasDigitalProductPassportId> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                                     rdfs:range <https://w3id.org/eudpp#DPPIdentifier> ;
                                                     rdfs:comment """Realisation for the Unique identifier of an instance of the digital product passport.

DPP is modelled in the EU DPP CO P_DPP module.
DPPIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
                                                     rdfs:label "has digital product passport id"@en .


###  https://w3id.org/eudpp#hasDisassemblyInstruction
<https://w3id.org/eudpp#hasDisassemblyInstruction> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                                   rdfs:range <https://w3id.org/eudpp#SubstanceManagementInstruction> ;
                                                   <http://purl.org/dc/terms/references> "ESPR Article 7(5)(e)."@en ;
                                                   <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                                   rdfs:comment "Links a substance presence to information relevant for disassembly."@en ;
                                                   rdfs:isDefinedBy :SOC ;
                                                   rdfs:label "Has disassembly instruction"@en ;
                                                   <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#hasEUDeclarationOfConformity
<https://w3id.org/eudpp#hasEUDeclarationOfConformity> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <https://w3id.org/eudpp#Product> ;
                                                      rdfs:range <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                                      <http://purl.org/dc/terms/references> "Decision No 768/2008/EC Annex I Art R10" ,
                                                                                            "ESPR Art 44" ;
                                                      <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                                        "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44" ;
                                                      rdfs:comment """Specifies the EU declaration of conformity issued for the product.

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Product is modelled in the EU DPP CO P_DPP module."""@en ;
                                                      rdfs:label "has EU Declaration of Conformity"@en .


###  https://w3id.org/eudpp#hasEconomicOperator
<https://w3id.org/eudpp#hasEconomicOperator> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#Product> ;
                                             rdfs:range <https://w3id.org/eudpp#Actor> ;
                                             rdfs:comment """Linking the product to the economic operator (Actor from ACTOR module).

Product is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                             rdfs:label "has economic operator"@en .


###  https://w3id.org/eudpp#hasEndOfLifeManagementInstruction
<https://w3id.org/eudpp#hasEndOfLifeManagementInstruction> rdf:type owl:ObjectProperty ;
                                                           rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                                           rdfs:range <https://w3id.org/eudpp#SubstanceManagementInstruction> ;
                                                           <http://purl.org/dc/terms/references> "ESPR Article 7(5)(e)."@en ;
                                                           <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                                           rdfs:comment "Links a substance presence to information relevant for environmentally sound management of the product at end-of-life."@en ;
                                                           rdfs:isDefinedBy :SOC ;
                                                           rdfs:label "Has end-of-life management instruction"@en ;
                                                           <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#hasExternalSource
<https://w3id.org/eudpp#hasExternalSource> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                           rdfs:range <https://w3id.org/eudpp#Source> ;
                                           rdfs:comment "Link from an LCAStudy to a background source. It can be a (a) documentation (e.g. an LCA project report, safety data sheet, or explanatory material) - covering the ILCD+EPD element referenceToExternalDocumentation on dataSetInformation, (b) databases or, (c)  literature sources used for modelling."@en ;
                                           rdfs:label "has external source"@en ;
                                           <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en .


###  https://w3id.org/eudpp#hasFacility
<https://w3id.org/eudpp#hasFacility> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                                     rdfs:range <https://w3id.org/eudpp#Facility> ;
                                     rdfs:comment """Links a product to a facility.

Product is modelled in the EU DPP CO P_DPP module.
Facility is modelled in the EU DPP CO ACTOR module."""@en ;
                                     rdfs:label "has facility"@en .


###  https://w3id.org/eudpp#hasGranularity
<https://w3id.org/eudpp#hasGranularity> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://w3id.org/eudpp#Identifier> ;
                                        rdfs:range <https://w3id.org/eudpp#IdentifierGranularity> ;
                                        rdfs:comment "Defines the granularity of an identifier, if exists."@en ;
                                        rdfs:label "has granularity"@en .


###  https://w3id.org/eudpp#hasImpactCategory
<https://w3id.org/eudpp#hasImpactCategory> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#LCAMethod> ;
                                           rdfs:range <https://w3id.org/eudpp#LCIAImpactCategory> ;
                                           rdfs:comment "Impact category addressed by the Method."@en ;
                                           rdfs:label "has impact category"@en ;
                                           <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element impactCategory on LCIAMethodDataSet."@en ,
                                                                                     "LCAnet: relates to the element hasImpactCategory (https://w3id.org/lcanet/ia#hasIC) in the IA module."@en .


###  https://w3id.org/eudpp#hasImpactModel
<https://w3id.org/eudpp#hasImpactModel> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://w3id.org/eudpp#LCAMethod> ;
                                        rdfs:range <https://w3id.org/eudpp#ImpactModel> ;
                                        rdfs:comment "Link from an Method to its characterisation-model block (where applicable; inventory-only methods may not have one)."@en ;
                                        rdfs:label "has impact model"@en ;
                                        <https://w3id.org/eudpp#sourceVocabulary> "LCAnet: relates to the element usesCM (https://w3id.org/lcanet/ia#usesCM) in the IA module."@en .


###  https://w3id.org/eudpp#hasInventoryIndicatorResult
<https://w3id.org/eudpp#hasInventoryIndicatorResult> rdf:type owl:ObjectProperty ;
                                                     rdfs:subPropertyOf <https://w3id.org/eudpp#hasLCAResult> ;
                                                     rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                                     rdfs:range <https://w3id.org/eudpp#InventoryIndicatorResult> ;
                                                     rdfs:comment "Sub-property of eudpp:hasLCAResult; range narrowed to eudpp:InventoryIndicatorResult."@en ;
                                                     rdfs:label "has inventory indicator result"@en ;
                                                     <https://w3id.org/eudpp#sourceVocabulary> "ILCD+EPD extension: Corresponds to the element LCIAResults/LCIAResult when the indicator is an EN 15804+A2 inventory indicator (resource use, waste, output flows)."@en .


###  https://w3id.org/eudpp#hasIssuer
<https://w3id.org/eudpp#hasIssuer> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                   rdfs:range <https://w3id.org/eudpp#Actor> ;
                                   rdfs:comment """Linking DPP with its issuer (Actor from ACTOR module).

DPP is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                   rdfs:label "has issuer"@en .


###  https://w3id.org/eudpp#hasLCAResult
<https://w3id.org/eudpp#hasLCAResult> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                      rdfs:range <https://w3id.org/eudpp#LCAResult> ;
                                      rdfs:comment "Link from an LCAStudy (or its subclass EPDStudy) to one of its LCA results. Range is the abstract eudpp:LCAResult; sub-properties eudpp:hasLCIAResult and eudpp:hasInventoryResult narrow the result to the corresponding sibling subclass. Querying for eudpp:hasLCAResult retrieves both kinds of results in one go."@en ;
                                      rdfs:label "has LCA result"@en ;
                                      <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology"@en .


###  https://w3id.org/eudpp#hasLCAStudy
<https://w3id.org/eudpp#hasLCAStudy> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                                     rdfs:range <https://w3id.org/eudpp#LCAStudy> ;
                                     rdfs:comment """A product has a LCA Study -- a measurable outcome of a life cycle assessment, representing the quantified effect of a product.

Product is modelled in the EU DPP CO P_DPP module.
LCAStudy is modelled in the EU DPP CO LCA module."""@en ;
                                     rdfs:label "has LCA study"@en .


###  https://w3id.org/eudpp#hasLCAVerifier
<https://w3id.org/eudpp#hasLCAVerifier> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://w3id.org/eudpp#Review> ;
                                        rdfs:range <https://w3id.org/eudpp#Actor> ;
                                        <http://purl.org/dc/terms/references> "ISO 14025:2026, 9 and 10.4; ISO 14025:2006, 3.8 and 3.9; ISO 14044:2006, 6; EN 15804:2012+A2:2019, 7.1, Table 2" ;
                                        <http://purl.org/dc/terms/source> "https://www.iso.org/standard/87610.html" ;
                                        rdfs:comment """Links a review to the independent, third-party actor responsible for validating the Life Cycle Assessment (LCA) or Environmental Product Declaration (EPD).

Verifier means a person or organisation that carries out the independent verification of an EPD or LCA study, i.e. confirms through objective evidence that the specified requirements are fulfilled, e.g. the PCR and EN 15804+A2. It also covers the critical reviewer of an LCA study and the verifier of a PEF study. Independent verification may be internal or external; EPDs for business-to-consumer communication require third-party verification, also comparative assertions under ISO 14040 and any comparisons under the European Commission’s ILCD Handbook. The type of verification is recorded on the Review (TypeOfReview). ILCD: reviewer (1-3-20-87); [ISO 14025:2006, 3.8, adapted]

Review is modelled in the EU DPP CO LCA module. 
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                        rdfs:label "has LCA verifier"@en .


###  https://w3id.org/eudpp#hasLCIAResult
<https://w3id.org/eudpp#hasLCIAResult> rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf <https://w3id.org/eudpp#hasLCAResult> ;
                                       rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                       rdfs:range <https://w3id.org/eudpp#LCIAResult> ;
                                       rdfs:comment "Sub-property of eudpp:hasLCAResult; range narrowed to eudpp:LCIAResult."@en ;
                                       rdfs:label "has LCIA result"@en ;
                                       <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element LCIAResults/LCIAResult when the indicator is an EN 15804+A2 impact indicator."@en .


###  https://w3id.org/eudpp#hasLicenseType
<https://w3id.org/eudpp#hasLicenseType> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://w3id.org/eudpp#LCAStudy> ;
                                        rdfs:range <https://w3id.org/eudpp#LicenseType> ;
                                        rdfs:comment "License applicable to the LCA / EPD study."@en ;
                                        rdfs:label "has license type"@en ;
                                        <https://w3id.org/eudpp#sourceVocabulary> "ILCD base: Corresponds to the element publicationAndOwnership/licenseType."@en .


