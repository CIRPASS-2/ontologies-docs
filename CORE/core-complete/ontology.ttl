###  https://w3id.org/eudpp#nameCAS
<https://w3id.org/eudpp#nameCAS> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                 rdfs:range xsd:string ;
                                 <http://purl.org/dc/terms/references> "ESPR Article 7(5)"@en ;
                                 <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                 rdfs:comment "The Chemical Abstract Service (CAS) name, if available; [ESPR Article 7(5)]"@en ;
                                 rdfs:label "CAS name"@en .


###  https://w3id.org/eudpp#nameIUPAC
<https://w3id.org/eudpp#nameIUPAC> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                   rdfs:range xsd:string ;
                                   <http://purl.org/dc/terms/references> "ESPR Article 7(5)"@en ;
                                   <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                   rdfs:comment "Name in the International Union of Pure and Applied Chemistry (IUPAC) nomenclature, or another international name when IUPAC name is not available [ESPR Article 7(5)]"@en ;
                                   rdfs:label "IUPAC name"@en .


###  https://w3id.org/eudpp#numberCAS
<https://w3id.org/eudpp#numberCAS> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                   rdfs:range xsd:string ;
                                   <http://purl.org/dc/terms/references> "ESPR Article 7(5)"@en ;
                                   <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                   rdfs:comment "The Chemical Abstract Service (CAS) number, if available; [ESPR Article 7(5)]"@en ;
                                   rdfs:label "CAS number"@en .


###  https://w3id.org/eudpp#numberEC
<https://w3id.org/eudpp#numberEC> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                  rdfs:range xsd:string ;
                                  <http://purl.org/dc/terms/references> "ESPR Article 7(5)"@en ;
                                  <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                  rdfs:comment "European Community (EC) number, as indicated in the European Inventory of Existing Commercial Chemical Substances (EINECS), the European List of Notified Chemical Substances (ELINCS) or the No Longer Polymer (NLP) list or the number assigned by the European Chemicals Agency (ECHA), if available and appropriate [ESPR Article 7(5)]"@en ,
                                               """EXAMPLES:

Mercurous Oxide
EC Number: 239-934-0
CAS Number: 15829-53-5""" ;
                                  rdfs:label "EC number"@en .


###  https://w3id.org/eudpp#numericalValue
<https://w3id.org/eudpp#numericalValue> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain <https://w3id.org/eudpp#QuantitativeProperty> ;
                                        rdfs:range xsd:decimal ;
                                        rdfs:comment "The numerical value of the quantity, i.e., quantitative property of the product."@en ;
                                        rdfs:label "numerical value"@en .


###  https://w3id.org/eudpp#otherName
<https://w3id.org/eudpp#otherName> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                   rdfs:range xsd:string ;
                                   <http://purl.org/dc/terms/references> "ESPR Article 7(5)"@en ;
                                   <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                   rdfs:comment "Other names, including usual name, trade name, abbreviation; [ESPR Article 7(5)]"@en ;
                                   rdfs:label "Other names"@en .


###  https://w3id.org/eudpp#productImage
<https://w3id.org/eudpp#productImage> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#Product> ;
                                      rdfs:range xsd:anyURI ;
                                      rdfs:comment "An image of the product."@en ;
                                      rdfs:label "product image"@en .


###  https://w3id.org/eudpp#productName
<https://w3id.org/eudpp#productName> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                                     rdfs:range xsd:string ;
                                     rdfs:comment "Product name"@en ;
                                     rdfs:label "product name"@en .


###  https://w3id.org/eudpp#recordedInSystem
<https://w3id.org/eudpp#recordedInSystem> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                          rdfs:range xsd:anyURI ;
                                          rdfs:comment "Indicates the URI identifying the system, application, or audit log in which the DPP event record is maintained."@en ;
                                          rdfs:label "recorded in system"@en .


###  https://w3id.org/eudpp#recordedInSystemName
<https://w3id.org/eudpp#recordedInSystemName> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                              rdfs:range xsd:string ;
                                              rdfs:comment "Indicates the human-readable name of the system, application, or audit log in which the DPP event record is maintained."@en ;
                                              rdfs:label "recorded in system name"@en .


###  https://w3id.org/eudpp#registeredTradeName
<https://w3id.org/eudpp#registeredTradeName> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                             rdfs:range xsd:string ;
                                             rdfs:comment "Trade name under which a legal person or business operates and is registered."@en ;
                                             rdfs:label "registered trade name"@en .


###  https://w3id.org/eudpp#registeredTrademark
<https://w3id.org/eudpp#registeredTrademark> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                             rdfs:range xsd:string ;
                                             rdfs:comment "A trademark officially registered and owned by an actor."@en ;
                                             rdfs:label "registered trademark"@en .


###  https://w3id.org/eudpp#substanceLocation
<https://w3id.org/eudpp#substanceLocation> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                           rdfs:range xsd:string ;
                                           <http://purl.org/dc/terms/references> "ESPR Article 7(5)"@en ;
                                           <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                           rdfs:comment "Location of the substance in the product; ESPR Art 7(5)"@en ;
                                           rdfs:label "Location of substance"@en .


###  https://w3id.org/eudpp#tolerance
<https://w3id.org/eudpp#tolerance> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#QuantitativeProperty> ;
                                   rdfs:range xsd:double ;
                                   rdfs:comment """Engineering tolerance is the permissible variation in measurements deriving from the base measurement.
Tolerances can apply to many different units."""@en ;
                                   rdfs:label "tolerance"@en .


###  https://w3id.org/eudpp#tradeName
<https://w3id.org/eudpp#tradeName> rdf:type owl:DatatypeProperty ;
                                   rdfs:subPropertyOf <https://w3id.org/eudpp#otherName> ;
                                   rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "The trade name under which the Substance of Concern is known; [ESPR Article 7(5)]"@en ;
                                   rdfs:label "Trade name"@en .


###  https://w3id.org/eudpp#usualName
<https://w3id.org/eudpp#usualName> rdf:type owl:DatatypeProperty ;
                                   rdfs:subPropertyOf <https://w3id.org/eudpp#otherName> ;
                                   rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "The usual name under which the Substance of Concern is known; [ESPR Article 7(5)]"@en ;
                                   rdfs:label "Usual name"@en .


###  https://w3id.org/eudpp#validFrom
<https://w3id.org/eudpp#validFrom> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                   rdfs:range xsd:dateTimeStamp ;
                                   rdfs:comment "The date and timestamp that the DPP is valid from."@en ;
                                   rdfs:label "valid from"@en .


###  https://w3id.org/eudpp#validUntil
<https://w3id.org/eudpp#validUntil> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                    rdfs:range xsd:dateTimeStamp ;
                                    rdfs:comment "The date and timestamp that the DPP is valid until."@en ;
                                    rdfs:label "valid until"@en .


###  https://w3id.org/eudpp#value
<https://w3id.org/eudpp#value> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <https://w3id.org/eudpp#DocumentFormattedProperty> ;
                               rdfs:range xsd:string ;
                               rdfs:comment """Contains the data of the value encapsulated in the Document.

Value is xsd:string that is formatted as a URL,  where to fetch the file."""@en ;
                               rdfs:label "value related to the document"@en .


###  https://w3id.org/eudpp#webLink
<https://w3id.org/eudpp#webLink> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <https://w3id.org/eudpp#DigitalInstruction> ;
                                 rdfs:range xsd:anyURI ;
                                 rdfs:comment "Web link to an instruction document or video etc."@en ;
                                 rdfs:label "weblink"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/dc/terms#Location
<http://purl.org/dc/terms#Location> rdf:type owl:Class ;
                                    rdfs:isDefinedBy <http://purl.org/dc/terms#Location> .


###  http://purl.org/dc/terms/Location
<http://purl.org/dc/terms/Location> rdf:type owl:Class .


###  http://w3id.org/eudpp#DPPEvent
<http://w3id.org/eudpp#DPPEvent> rdf:type owl:Class ;
                                 rdfs:isDefinedBy "http://w3id.org/eudpp/EVENT" .


###  http://w3id.org/eudpp#DPPEventRecord
<http://w3id.org/eudpp#DPPEventRecord> rdf:type owl:Class ;
                                       rdfs:isDefinedBy "http://w3id.org/eudpp/EVENT" .


###  http://w3id.org/eudpp#ProductEvent
<http://w3id.org/eudpp#ProductEvent> rdf:type owl:Class ;
                                     rdfs:isDefinedBy "http://w3id.org/eudpp/EVENT" .


###  https://ref.gs1.org/cbv/BTT
<https://ref.gs1.org/cbv/BTT> rdf:type owl:Class .


###  https://ref.gs1.org/cbv/BizStep
<https://ref.gs1.org/cbv/BizStep> rdf:type owl:Class .


###  https://ref.gs1.org/cbv/Disp
<https://ref.gs1.org/cbv/Disp> rdf:type owl:Class .


###  https://ref.gs1.org/cbv/SDT
<https://ref.gs1.org/cbv/SDT> rdf:type owl:Class .


###  https://ref.gs1.org/epcis/AggregationEvent
<https://ref.gs1.org/epcis/AggregationEvent> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent> ;
                                             rdfs:comment "The event type AggregationEvent describes events that apply to objects that have been aggregated to one another. In such an event, there is a set of 'contained' objects that have been aggregated within a 'containing' entity that's meant to identify the aggregation itself.  This event type is intended to be used for 'aggregations', meaning an association where there is a strong physical relationship between the containing and the contained objects such that they will all occupy the same location at the same time, until such time as they are disaggregated."@en ;
                                             rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                             rdfs:label "AggregationEvent" ;
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                             <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID" .


###  https://ref.gs1.org/epcis/AssociationEvent
<https://ref.gs1.org/epcis/AssociationEvent> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent> ;
                                             rdfs:comment "The event type AssociationEvent describes the association or disassociation of one or several physical objects with a parent object or a specific physical location.  Like the AggregationEvent, the AssociationEvent is also used to capture associations where there is a strong physical relationship between the containing and the contained objects such that they will all occupy the same location at the same time, until such time as they are disaggregated. However, the AggregationEvent does not allow for associations of objects with physical locations;  if action is DELETE while omitting the childEPC and childQuantityList field, all contained children are disaggregated from the containing parent. Because there are situations in which associations are more permanent, i.e. beyond the physical flow of goods (e.g. packing/unpacking and loading/unloading), an AssociationEvent SHOULD be used: (a) when objects need to be associated with a physical location or (b) when the parent object could also be subject to other, more temporary associations (i.e. captured using AggregationEvent)."@en ;
                                             rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                             rdfs:label "AssociationEvent" ;
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                             <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID" .


###  https://ref.gs1.org/epcis/BizTransaction
<https://ref.gs1.org/epcis/BizTransaction> rdf:type owl:Class ;
                                           rdfs:comment "Document that describes a particular business transaction. An example is a specific Purchase Order or Despatch Advice. Business Transaction information may be included in EPCIS events to record an event's participation in particular business transactions."@en ;
                                           rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                           rdfs:label "BizTransaction" ;
                                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                           <https://ref.gs1.org/epcis/jsonldUriLabel> "bizTransaction" .


###  https://ref.gs1.org/epcis/EPCISEvent
<https://ref.gs1.org/epcis/EPCISEvent> rdf:type owl:Class ;
                                       owl:disjointWith <https://w3id.org/eudpp#DPPEventRecord> ;
                                       rdfs:comment "A logistics event. This is a common superclass (base type) for all EPCIS events. All of the more specific event types are subclasses of EPCISEvent."@en ;
                                       rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                       rdfs:label "EPCISEvent" ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/ObjectEvent
<https://ref.gs1.org/epcis/ObjectEvent> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent> ;
                                        rdfs:comment "An ObjectEvent captures information about an event pertaining to one or more physical or digital objects identified by instance-level (EPC) or class-level (EPC Class) identifiers. In most situations, an ObjectEvent is envisioned to represent an actual observations of objects, but strictly speaking it can be used for any event a Capturing Application wants to assert about objects, including for example capturing the fact that an expected observation failed to occur."@en ;
                                        rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                        rdfs:label "ObjectEvent" ;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                        <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID" .


###  https://ref.gs1.org/epcis/QuantityElement
<https://ref.gs1.org/epcis/QuantityElement> rdf:type owl:Class ;
                                            rdfs:comment "A QuantityElement is a structure that identifies objects identified by a specific class-level identifier, either a specific quantity or an unspecified quantity."@en ;
                                            rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                            rdfs:label "QuantityElement" ;
                                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/SensorReport
<https://ref.gs1.org/epcis/SensorReport> rdf:type owl:Class .


###  https://ref.gs1.org/epcis/SourceOrDestination
<https://ref.gs1.org/epcis/SourceOrDestination> rdf:type owl:Class ;
                                                rdfs:comment "Provides additional business context when an EPCIS event is part of a business transfer; that is, a process in which there is a change of location, or transfer of ownership, or transfer of possession of physical or digital objects. Within a specified type of transfer, the business transfer is from the Source to the Destination."@en ;
                                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                rdfs:label "Source or Destination" ;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                                <https://ref.gs1.org/epcis/jsonldUriLabel> "id" .


###  https://ref.gs1.org/epcis/TransactionEvent
<https://ref.gs1.org/epcis/TransactionEvent> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent> ;
                                             rdfs:comment "The event type TransactionEvent describes the association or disassociation of physical or digital objects to one or more business transactions. While other event types have an optional bizTransactionList field that may be used to provide context for an event, the TransactionEvent is used to declare in an unequivocal way that certain objects have been associated or disassociated with one or more business transactions as part of the event."@en ;
                                             rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                             rdfs:label "TransactionEvent" ;
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                             <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID" .


###  https://ref.gs1.org/epcis/Transformation
<https://ref.gs1.org/epcis/Transformation> rdf:type owl:Class ;
                                           rdfs:comment """A transformation business processes that takes a longer period of time than a single TransformationEvent, so is associated with a series of such events.
When events share the same Transformation, the meaning is that the inputs to any of those events may have contributed in some way to each of the outputs in any of those same events."""@en ;
                                           rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                           rdfs:label "Transformation" ;
                                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/TransformationEvent
<https://ref.gs1.org/epcis/TransformationEvent> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://ref.gs1.org/epcis/EPCISEvent> ;
                                                rdfs:comment "A TransformationEvent captures information about an event in which one or more physical or digital objects identified by instance-level (EPC) or class-level (EPC Class) identifiers are fully or partially consumed as inputs and one or more objects identified by instance-level (EPC) or class-level (EPC Class) identifiers are produced as outputs. The TransformationEvent captures the relationship between the inputs and the outputs, such that any of the inputs may have contributed in some way to each of the outputs."@en ;
                                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                rdfs:label "TransformationEvent" ;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                                <https://ref.gs1.org/epcis/jsonldUriLabel> "eventID" .


###  https://schema.org/GeoCoordinates
<https://schema.org/GeoCoordinates> rdf:type owl:Class ;
                                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://schema.org/latitude> ;
                                                      owl:someValuesFrom xsd:decimal
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://schema.org/longitude> ;
                                                      owl:someValuesFrom xsd:decimal
                                                    ] ;
                                    rdfs:isDefinedBy <https://schema.org/GeoCoordinates> .


###  https://schema.org/PostalAddress
<https://schema.org/PostalAddress> rdf:type owl:Class ;
                                   rdfs:isDefinedBy <https://schema.org/PostalAddress> .


###  https://si-digital-framework.org/SI#MeasurementUnit
<https://si-digital-framework.org/SI#MeasurementUnit> rdf:type owl:Class ;
                                                      rdfs:comment """Measurement unit defining the magnitude of the quantity in respect to the value.
si:MeasurementUnit class is reused"""@en ;
                                                      rdfs:label "Unit of measurement"@en .


###  https://w3id.org/eudpp#Actor
<https://w3id.org/eudpp#Actor> rdf:type owl:Class ;
                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://schema.org/address> ;
                                                 owl:allValuesFrom <https://schema.org/PostalAddress>
                                               ] ;
                               <http://purl.org/dc/terms/references> "CIRPASS-2 User Stories 3.1"@en ;
                               <http://purl.org/dc/terms/source> "https://zenodo.org/records/17979585" ;
                               rdfs:comment "Actor means a legal or natural person (e.g. John Doe, TNO). One actor can take on multiple roles; [CIRPASS-2 User Stories 3.1]"@en ;
                               rdfs:isDefinedBy :ACTOR ;
                               rdfs:label "Actor"@en .


###  https://w3id.org/eudpp#ActorIdentifier
<https://w3id.org/eudpp#ActorIdentifier> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/eudpp#Identifier> ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/eudpp#hasScheme> ;
                                                           owl:someValuesFrom <https://w3id.org/eudpp#ActorIdentifierScheme>
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/eudpp#identifierValue> ;
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onDataRange xsd:string
                                                         ] ;
                                         owl:disjointWith <https://w3id.org/eudpp#DPPIdentifier> ,
                                                          <https://w3id.org/eudpp#FacilityIdentifier> ,
                                                          <https://w3id.org/eudpp#MaterialIdentifier> ,
                                                          <https://w3id.org/eudpp#ProductIdentifier> ,
                                                          <https://w3id.org/eudpp#SoCIdentifier> ;
                                         rdfs:comment "A type of identifier to identify Actors. A unique code assigned to Actor based on a scheme."@en ;
                                         rdfs:isDefinedBy :IDENT ;
                                         rdfs:label "Actor identifier"@en .


###  https://w3id.org/eudpp#ActorIdentifierScheme
<https://w3id.org/eudpp#ActorIdentifierScheme> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/eudpp#IdentifierScheme> ;
                                               owl:disjointWith <https://w3id.org/eudpp#MaterialIdentifierScheme> ,
                                                                <https://w3id.org/eudpp#ProductIdentifierScheme> ;
                                               rdfs:comment "A kind of identifier scheme. The scheme or standard used to identify Actors. e.g., GLN, LEI, etc."@en ;
                                               rdfs:label "Actor identifier scheme"@en .


###  https://w3id.org/eudpp#ActorRoleAssignment
<https://w3id.org/eudpp#ActorRoleAssignment> rdf:type owl:Class ;
                                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/eudpp#hasRole> ;
                                                               owl:allValuesFrom <https://w3id.org/eudpp#Role>
                                                             ] ;
                                             rdfs:comment "Assigns a role to the actor in a particular context (DPP, Product, Event)."@en ;
                                             rdfs:isDefinedBy :ACTOR ;
                                             rdfs:label "Actor role assignment"@en .


###  https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment
<https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment> rdf:type owl:Class ;
                                                                rdfs:subClassOf <https://w3id.org/eudpp#ActorRoleAssignment> ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <https://w3id.org/eudpp#hasRole> ;
                                                                                  owl:hasValue <https://w3id.org/eudpp#authorisedRepresentative>
                                                                                ] ;
                                                                <http://purl.org/dc/terms/references> "ESPR Art 2 (43)"@en ;
                                                                <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                                rdfs:comment "A specific assignment representing the written mandate between a manufacturer and an authorised representative; [ESPR Art 2 (43)]"@en ;
                                                                rdfs:isDefinedBy :ACTOR ;
                                                                rdfs:label "Authorised representative role assignment"@en .


###  https://w3id.org/eudpp#AuthorityRole
<https://w3id.org/eudpp#AuthorityRole> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/eudpp#Role> ;
                                       rdfs:comment "Parent class for roles of authorities, such as market surveillance authority, customs authority, etc."@en ;
                                       rdfs:label "Authority role"@en .


###  https://w3id.org/eudpp#CarbonFootprint
<https://w3id.org/eudpp#CarbonFootprint> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/eudpp#EnvironmentalFootprint> ;
                                         <http://purl.org/dc/terms/references> "ESPR Art 2 (25)"@en ;
                                         <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                         rdfs:comment """Carbon footprint
means the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category
of climate change. (ESPR Art 2 25))

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                         rdfs:label "Carbon footprint"@en .


###  https://w3id.org/eudpp#CircularEconomyIndicator
<https://w3id.org/eudpp#CircularEconomyIndicator> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                                  rdfs:comment """Circular Economy indicators are measures for relevant monitoring the transition to a circular economy and to measure the effects of new policy and trends.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                                  rdfs:label "Circular Economy Indicator"@en ;
                                                  rdfs:seeAlso <https://environment.ec.europa.eu/strategy/circular-economy-action-plan_en> .


###  https://w3id.org/eudpp#CircularEconomyRole
<https://w3id.org/eudpp#CircularEconomyRole> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/eudpp#Role> ;
                                             rdfs:comment "Parent class for roles related to circular economy, such as remanufacturer, refurbisher, etc."@en ;
                                             rdfs:label "Circular economy role"@en .


###  https://w3id.org/eudpp#ClassificationCode
<https://w3id.org/eudpp#ClassificationCode> rdf:type owl:Class ;
                                            rdfs:comment "A classification code from some product classification scheme ."@en ;
                                            rdfs:label "ClassificationCode"@en .


###  https://w3id.org/eudpp#CommonSpecification
<https://w3id.org/eudpp#CommonSpecification> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/eudpp#TechnicalSpecification> ;
                                             <http://purl.org/dc/terms/source> "ESPR Art 42, https://eur-lex.europa.eu/eli/reg/2024/1781/oj#art_42"@en ;
                                             rdfs:comment "Common specification means ecodesign requirements, essential requirements for digital product passports or test, measurement or calculation methods established by implementing acts adopted by the Commission for products covered by delegated acts pursuant to ESPR Article 4."@en ;
                                             rdfs:label "Common Specification"@en .


###  https://w3id.org/eudpp#Concentration
<https://w3id.org/eudpp#Concentration> rdf:type owl:Class ;
                                       <http://purl.org/dc/terms/references> "ESPR Art 7(5)"@en ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                       rdfs:comment "The concentration of the substances of concern, at the level of the product, its relevant components, or spare parts ESPR Art 7(5)"@en ;
                                       rdfs:label "Concentration of the substance of concern"@en .


###  https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern
<https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern> rdf:type owl:Class ;
                                                           rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                                           <http://purl.org/dc/terms/references> "ESPR Art 7(5)"@en ;
                                                           <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                           rdfs:comment "The concentration of the substances of concern, at the level of the product, its relevant components, or spare parts ESPR Art 7(5)"@en ;
                                                           rdfs:label "Concentration of the substance of concern"@en .


###  https://w3id.org/eudpp#ConformityAssessmentModule
<https://w3id.org/eudpp#ConformityAssessmentModule> rdf:type owl:Class ;
                                                    <http://purl.org/dc/terms/source> "Decision No 768/2008/EC Art 4, https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4"@en ,
                                                                                      "ESPR Art 43, https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43"@en ;
                                                    rdfs:comment "Conformity Assessment module means the possible conformity assessment elements that can be chosen, in accordance with certain criteria, to fullfill the conformity accessement required to be performed by Community harmonisation legislation in respect of a particular product."@en ;
                                                    rdfs:isDefinedBy "https://w3id.org/eudpp/COMP" ;
                                                    rdfs:label "Conformity Assessment Module"@en .


###  https://w3id.org/eudpp#ConformityAssessmentRole
<https://w3id.org/eudpp#ConformityAssessmentRole> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/eudpp#Role> ;
                                                  <http://purl.org/dc/terms/references> "ESPR Art 2 (51)"@en ;
                                                  <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                  rdfs:comment "Conformity assessment means the process demonstrating whether the ecodesign requirements set out in the relevant delegated acts adopted pursuant to Article 4 have been fulfilled; [ESPR Art 2 (51)]"@en ;
                                                  rdfs:label "Conformity assessment role"@en .


###  https://w3id.org/eudpp#ConformityCertificate
<https://w3id.org/eudpp#ConformityCertificate> rdf:type owl:Class ;
                                               <http://purl.org/dc/terms/source> "Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4, https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001"@en ,
                                                                                 "ESPR Annex III (e)"@en ;
                                               rdfs:comment "Conformity assessment certificate for a certification. The blue guide uses the term \"cerficate of conformity\". The ESPR uses \"conformity certificate\" as well as \"certificate\" and \"approval decision\"."@en ;
                                               rdfs:isDefinedBy "https://w3id.org/eudpp/COMP" ;
                                               rdfs:label "Conformity Certificate"@en .


###  https://w3id.org/eudpp#DPP
<https://w3id.org/eudpp#DPP> rdf:type owl:Class ;
                             <http://purl.org/dc/terms/references> "ESPR Art 2 (28)"@en ;
                             <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                             rdfs:comment """Digital Product Passport (DPP) means a set of data specific to a product that includes the information specified in the applicable
delegated act adopted pursuant to Article 4 and that is accessible via electronic means through a data carrier in accordance with Chapter III. (ESPR Art 2 (28))"""@en ;
                             rdfs:isDefinedBy :P_DPP ;
                             rdfs:label "Digital Product Passport (DPP)"@en .


###  https://w3id.org/eudpp#DPPActionType
<https://w3id.org/eudpp#DPPActionType> rdf:type owl:Class ;
                                       owl:equivalentClass [ rdf:type owl:Class ;
                                                             owl:oneOf ( <https://w3id.org/eudpp#AddDPPDataAction>
                                                                         <https://w3id.org/eudpp#CorrectDPPDataAction>
                                                                         <https://w3id.org/eudpp#DeleteDPPDataAction>
                                                                         <https://w3id.org/eudpp#ModifyDPPDataAction>
                                                                       )
                                                           ] ;
                                       rdfs:comment "A classification indicating the type of information-level action performed during a DPP update event."@en ;
                                       rdfs:label "DPP Action Type"@en .


###  https://w3id.org/eudpp#DPPArchivalEvent
<https://w3id.org/eudpp#DPPArchivalEvent> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#DPPEvent> ;
                                          rdfs:comment "An event corresponding to the archival or end-of-active-life management of a Digital Product Passport."@en ;
                                          rdfs:label "DPP Archival Event"@en .


###  https://w3id.org/eudpp#DPPCreationEvent
<https://w3id.org/eudpp#DPPCreationEvent> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#DPPEvent> ;
                                          rdfs:comment "An event corresponding to the creation or initial issuance of a Digital Product Passport."@en ;
                                          rdfs:label "DPP Creation Event"@en .


###  https://w3id.org/eudpp#DPPEvent
<https://w3id.org/eudpp#DPPEvent> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/eudpp#ESPREvent> ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/eudpp#isTriggeredByProductEvent> ;
                                                    owl:allValuesFrom <https://w3id.org/eudpp#ProductEvent>
                                                  ] ;
                                  owl:disjointWith <https://w3id.org/eudpp#DPPEventRecord> ,
                                                   <https://w3id.org/eudpp#ProductEvent> ;
                                  rdfs:comment "An ESPR-level event concept representing an event that affects the existence, content, accessibility, update, correction, or governance of a DPP. A DPPEvent captures the passport-facing semantics of the occurrence and is modelled as distinct from the product event that may trigger it."@en ;
                                  rdfs:label "DPP Event"@en .


###  https://w3id.org/eudpp#DPPEventRecord
<https://w3id.org/eudpp#DPPEventRecord> rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#recordsDPPEvent> ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <https://w3id.org/eudpp#DPPEvent>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#dppEventRecordIdentifier> ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#dppEventRecordedAt> ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#recordedInSystem> ;
                                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#recordedInSystemName> ;
                                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                        ] ;
                                        <http://purl.org/dc/terms/source> "Defined in the EU DPP Core Ontology Event module to support the technical recording of DPP-related events."@en ;
                                        rdfs:comment "A technical audit record used to represent and log an information-level event affecting a Digital Product Passport. Unlike EPCIS carriers, this class is intended for recording DPP-side information events rather than product-facing operational events."@en ;
                                        rdfs:label "DPP Event Record"@en .


###  https://w3id.org/eudpp#DPPIdentifier
<https://w3id.org/eudpp#DPPIdentifier> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/eudpp#Identifier> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/eudpp#identifierValue> ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onDataRange xsd:string
                                                       ] ;
                                       owl:disjointWith <https://w3id.org/eudpp#FacilityIdentifier> ,
                                                        <https://w3id.org/eudpp#MaterialIdentifier> ,
                                                        <https://w3id.org/eudpp#ProductIdentifier> ,
                                                        <https://w3id.org/eudpp#SoCIdentifier> ;
                                       rdfs:comment "A type of identifier to identify DPP. DPP Identifier."@en ;
                                       rdfs:isDefinedBy "https://w3id.org/eudpp/IDENT" ;
                                       rdfs:label "DPP identifier"@en .


###  https://w3id.org/eudpp#DPPUpdateEvent
<https://w3id.org/eudpp#DPPUpdateEvent> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/eudpp#DPPEvent> ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/eudpp#hasDPPActionType> ;
                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <https://w3id.org/eudpp#DPPActionType>
                                                        ] ;
                                        rdfs:comment "An event corresponding to an update of the content of a Digital Product Passport."@en ;
                                        rdfs:label "DPP Update Event"@en .


###  https://w3id.org/eudpp#DestructionEvent
<https://w3id.org/eudpp#DestructionEvent> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                          <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                          <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(34); Art 25(1)"@en ;
                                          rdfs:comment "The intentional damaging or discarding of a product and unsold products as waste, with the exception of discarding for the sole purpose of delivering the discarded product for preparing for reuse, including refurbishment or remanufacturing operations. ESPR Art 2(34) and Art 25(1)."@en ;
                                          rdfs:label "Destruction"@en .


###  https://w3id.org/eudpp#DigitalInstruction
<https://w3id.org/eudpp#DigitalInstruction> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/eudpp#DocumentFormattedProperty> ;
                                            <http://purl.org/dc/terms/references> "ESPR Art 27(7)"@en ;
                                            <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                            rdfs:comment """Digital instructions
mean instructions in digital format concerning the product (‘digital instructions’) in a language that can be easily understood. ESPR Art 27(7)
Digital instructions are ensured by manufacturers. These should also ensured by importers. (ESPR Art 29(4))

This class can be extended/specialised according to delegated acts or industry standards."""@en ;
                                            rdfs:label "DigitalInstruction"@en .


###  https://w3id.org/eudpp#DocumentFormattedProperty
<https://w3id.org/eudpp#DocumentFormattedProperty> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/eudpp#Property> ;
                                                   rdfs:comment "The document class describes the semantic representation of any instance of a document that might be required to be included into a digital product passport instance."@en ;
                                                   rdfs:isDefinedBy :P_DPP ;
                                                   rdfs:label "Document"@en .


###  https://w3id.org/eudpp#Durability
<https://w3id.org/eudpp#Durability> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/eudpp#QualityIndicator> ;
                                    <http://purl.org/dc/terms/references> "ESPR Art 2 (22)"@en ;
                                    <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                    rdfs:comment """Durability
means the ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair. (ESPR Art 2 (22))

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                    rdfs:label "Durability"@en .


###  https://w3id.org/eudpp#ESPREvent
<https://w3id.org/eudpp#ESPREvent> rdf:type owl:Class ;
                                   <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                   <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; lifecycle-event-oriented abstraction introduced for modelling purposes."@en ;
                                   rdfs:comment "Abstract superclass introduced for modelling purposes. Used to represent the regulatory or business semantics of an event relevant in the ESPR context and concerning either a product or its DPP, independently of its technical journalisation."@en ;
                                   rdfs:isDefinedBy "https://w3id.org/eudpp/EVENT" ;
                                   rdfs:label "ESPR Event"@en .


###  https://w3id.org/eudpp#EUDeclarationOfConformity
<https://w3id.org/eudpp#EUDeclarationOfConformity> rdf:type owl:Class ;
                                                   rdfs:subClassOf owl:Thing ,
                                                                   <https://w3id.org/eudpp#DocumentFormattedProperty> ;
                                                   <http://purl.org/dc/terms/source> "Decision No 768/2008/EC Annex I Art R10, https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I"@en ,
                                                                                     "ESPR Art 44, https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44"@en ;
                                                   rdfs:comment "The EU Declaration of Conformity shall state that the fulfilment of the ecodesign requirements specified in the applicable delegated acts adopted pursuant to ESPR Article 4 has been demonstrated or that a presumption of conformity applies in accordance with ESPR Article 41."@en ;
                                                   rdfs:isDefinedBy "https://w3id.org/eudpp/COMP" ;
                                                   rdfs:label "EU Declaration of Conformity"@en .


###  https://w3id.org/eudpp#EconomicOperatorRole
<https://w3id.org/eudpp#EconomicOperatorRole> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/eudpp#Role> ;
                                              <http://purl.org/dc/terms/references> "ESPR Art 2 (46)"@en ;
                                              <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                              rdfs:comment "Economic operator means the manufacturer, the authorised representative, the importer, the distributor, the dealer and the fulfilment service provider; [ESPR Art 2 (46)]"@en ;
                                              rdfs:label "Economic operator role"@en .


###  https://w3id.org/eudpp#EmissionToAir
<https://w3id.org/eudpp#EmissionToAir> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/eudpp#EnvironmentalEmission> ;
                                       <http://purl.org/dc/terms/references> "ESPR Annex I"@en ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                       rdfs:comment """Product parameters are listed in the ESPR Annex I :

(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                       rdfs:label "Emission to air"@en .


###  https://w3id.org/eudpp#EmissionToSoil
<https://w3id.org/eudpp#EmissionToSoil> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/eudpp#EnvironmentalEmission> ;
                                        <http://purl.org/dc/terms/references> "ESPR Annex I"@en ;
                                        <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                        rdfs:comment """Product parameters are listed in the ESPR Annex I :

(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                        rdfs:label "Emission to soil"@en .


###  https://w3id.org/eudpp#EmissionToWater
<https://w3id.org/eudpp#EmissionToWater> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/eudpp#EnvironmentalEmission> ;
                                         <http://purl.org/dc/terms/references> "ESPR Annex I"@en ;
                                         <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                         rdfs:comment """Product parameters are listed in the ESPR Annex I :

(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                         rdfs:label "Emission to water"@en .


###  https://w3id.org/eudpp#EndUserRole
<https://w3id.org/eudpp#EndUserRole> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/eudpp#Role> ;
                                     rdfs:comment "Parent class for roles of end users, such as consumer, etc."@en ;
                                     rdfs:label "End user role"@en .


###  https://w3id.org/eudpp#EnergyConsumption
<https://w3id.org/eudpp#EnergyConsumption> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/eudpp#ResourceConsumption> ;
                                           rdfs:comment """Energy consumption of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                           rdfs:label "Energy consumption"@en .


###  https://w3id.org/eudpp#EnvironmentalEmission
<https://w3id.org/eudpp#EnvironmentalEmission> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/eudpp#EnvironmentalPollution> ;
                                               rdfs:comment """Emission is the act or amount of sending out gas, heat, light, etc. It can also refer to harmful substances that are released into the environment, especially carbon dioxide.


This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                               rdfs:label "Environmental emission"@en ;
                                               rdfs:seeAlso <https://dictionary.cambridge.org/dictionary/english/emission> .


###  https://w3id.org/eudpp#EnvironmentalFootprint
<https://w3id.org/eudpp#EnvironmentalFootprint> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                                <http://purl.org/dc/terms/references> "ESPR Art 2 (24)"@en ;
                                                <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                rdfs:comment """Environmental footprint
means a quantification of the environmental impacts resulting from a product throughout its life
cycle, whether in relation to a single environmental impact category or an aggregated set of impact
categories based on the Product Environmental Footprint method established by Recommendation
(EU) 2 021/2279 or other scientific methods developed by international organisations, widely tested
in collaboration with different industry sectors and adopted or implemented by the Commission in
other Union law. (ESPR Art 2 (24)).

Product parameters list ESPR Annex I
(m) The environmental footprint of the product, expressed as a quantification;

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                                rdfs:label "Environmental footprint"@en .


###  https://w3id.org/eudpp#EnvironmentalPollution
<https://w3id.org/eudpp#EnvironmentalPollution> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                                rdfs:comment """Environmental pollution is the addition of any substance or form of energy to the environment at a rate faster than it can be dispersed or safely stored.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                                rdfs:label "Environmental pollution"@en ;
                                                rdfs:seeAlso <https://www.britannica.com/science/pollution-environment> .


###  https://w3id.org/eudpp#Facility
<https://w3id.org/eudpp#Facility> rdf:type owl:Class ;
                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://schema.org/address> ;
                                                    owl:allValuesFrom <https://schema.org/PostalAddress>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://schema.org/geo> ;
                                                    owl:allValuesFrom <https://schema.org/GeoCoordinates>
                                                  ] ;
                                  <http://purl.org/dc/terms/source> "https://marketbusinessnews.com/financial-glossary/facility/" ;
                                  rdfs:comment "A Facility may be a place where specific activities occur. A production/manufacturing facility means a factory. The term may refer to any place that makes things, or plants that generate electricity."@en ,
                                               "Business facilities are structures that provide services to a business. This can include space for employees, technology, equipment and inventory. Facilities can be used for business administration, operations or to provide services to customers."@en ;
                                  rdfs:isDefinedBy :ACTOR ;
                                  rdfs:label "Facility"@en .


###  https://w3id.org/eudpp#FacilityIdentifier
<https://w3id.org/eudpp#FacilityIdentifier> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/eudpp#Identifier> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/eudpp#identifierValue> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onDataRange xsd:string
                                                            ] ;
                                            owl:disjointWith <https://w3id.org/eudpp#MaterialIdentifier> ,
                                                             <https://w3id.org/eudpp#ProductIdentifier> ,
                                                             <https://w3id.org/eudpp#SoCIdentifier> ;
                                            rdfs:comment "A unique code assigned to a physical site (factory, warehouse, plant, school, hospital, etc.), i.e., identifies a location."@en ;
                                            rdfs:isDefinedBy :IDENT ;
                                            rdfs:label "Facility identifier"@en .


###  https://w3id.org/eudpp#HarmonisedStandard
<https://w3id.org/eudpp#HarmonisedStandard> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/eudpp#ProductRequirement> ;
                                            <http://purl.org/dc/terms/source> "Regulation (EU) No 1025/2012 Art 2 (1c), https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2"@en ;
                                            rdfs:comment "Harmonised Standard means a European standard adopted on the basis of a request made by the Commission for the application of Union harmonisation legislation."@en ;
                                            rdfs:label "Harmonised Standard"@en .


###  https://w3id.org/eudpp#HazardousWasteAmount
<https://w3id.org/eudpp#HazardousWasteAmount> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/eudpp#WasteGenerationAmount> ;
                                              rdfs:comment """Hazardous waste amount of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                              rdfs:label "Hazardous waste amount"@en .


###  https://w3id.org/eudpp#Height
<https://w3id.org/eudpp#Height> rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ;
                                rdfs:comment "Height of the product"@en ;
                                rdfs:label "Height"@en .


###  https://w3id.org/eudpp#Identifier
<https://w3id.org/eudpp#Identifier> rdf:type owl:Class ;
                                    rdfs:comment """Identifier. A general class to hold different kinds of identifiers described and used for EU DPP CO. Each sub-class of this class describes a different kind of identifier. Intentionally modelled as sub-classes. 
Identifiers have value, and a scheme/standard they are based on.

Cardinatlity restrictions added to each subclass to enforce inheritance of the data propertyy identifierValue."""@en ;
                                    rdfs:label "Identifier" .


###  https://w3id.org/eudpp#IdentifierGranularity
<https://w3id.org/eudpp#IdentifierGranularity> rdf:type owl:Class ;
                                               rdfs:comment "The granularity of the identifier. For example, for Products this could be model, batch, item."@en ;
                                               rdfs:label "Identifier granularity"@en .


###  https://w3id.org/eudpp#IdentifierScheme
<https://w3id.org/eudpp#IdentifierScheme> rdf:type owl:Class ;
                                          rdfs:comment "The scheme or standard used for Identifier."@en ;
                                          rdfs:label "Identifier scheme"@en .


###  https://w3id.org/eudpp#LCAStudy
<https://w3id.org/eudpp#LCAStudy> rdf:type owl:Class ;
                                  rdfs:isDefinedBy :LCA .


###  https://w3id.org/eudpp#LandUse
<https://w3id.org/eudpp#LandUse> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/eudpp#ResourceConsumption> ;
                                 rdfs:comment """Land use of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                 rdfs:label "Land use"@en .


###  https://w3id.org/eudpp#LegalPerson
<https://w3id.org/eudpp#LegalPerson> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/eudpp#Actor> ;
                                     owl:disjointWith <https://w3id.org/eudpp#NaturalPerson> ;
                                     <http://purl.org/dc/terms/source> "https://www.merriam-webster.com/legal/legal%20person" ;
                                     rdfs:comment "A body of persons or an entity (as a corporation) considered as having many of the rights and responsibilities of a natural person and especially the capacity to sue and be sued."@en ;
                                     rdfs:label "Legal Person"@en .


###  https://w3id.org/eudpp#Length
<https://w3id.org/eudpp#Length> rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ;
                                rdfs:comment "Length of the product"@en ;
                                rdfs:label "Length"@en .


###  https://w3id.org/eudpp#MaintenanceEvent
<https://w3id.org/eudpp#MaintenanceEvent> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                          <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                          <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(19)"@en ;
                                          rdfs:comment "Actions (one or more) taken to keep a product in a condition where it can fulfil its intended purpose. ESPR Art 2(19)."@en ;
                                          rdfs:label "Maintenance"@en .


###  https://w3id.org/eudpp#MakingAvailableOnMarketEvent
<https://w3id.org/eudpp#MakingAvailableOnMarketEvent> rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                                      <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                      <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(39)"@en ;
                                                      rdfs:comment "Any supply of a product for distribution, consumption or use on the Union market in the course of a commercial activity, whether in return for payment or free of charge. ESPR Art 2(39)."@en ;
                                                      rdfs:label "Making Available on the Market"@en .


###  https://w3id.org/eudpp#MaterialFootprint
<https://w3id.org/eudpp#MaterialFootprint> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/eudpp#EnvironmentalFootprint> ;
                                           <http://purl.org/dc/terms/references> "ESPR Art 2 (26)"@en ;
                                           <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                           rdfs:comment """Material footprint
refers to the total amount of raw materials extracted to meet final consumption demands. (ESPR Art 2 (26))

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                           rdfs:label "Material footprint"@en .


###  https://w3id.org/eudpp#MaterialIdentifier
<https://w3id.org/eudpp#MaterialIdentifier> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/eudpp#Identifier> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/eudpp#hasScheme> ;
                                                              owl:someValuesFrom <https://w3id.org/eudpp#MaterialIdentifierScheme>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/eudpp#identifierValue> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onDataRange xsd:string
                                                            ] ;
                                            owl:disjointWith <https://w3id.org/eudpp#ProductIdentifier> ,
                                                             <https://w3id.org/eudpp#SoCIdentifier> ;
                                            rdfs:comment "A type of identifier to identify materials. A unique code assigned to Material based on a scheme."@en ;
                                            rdfs:isDefinedBy "https://w3id.org/eudpp/IDENT" ;
                                            rdfs:label "Material identifier"@en .


###  https://w3id.org/eudpp#MaterialIdentifierScheme
<https://w3id.org/eudpp#MaterialIdentifierScheme> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/eudpp#IdentifierScheme> ;
                                                  owl:disjointWith <https://w3id.org/eudpp#ProductIdentifierScheme> ;
                                                  rdfs:comment "A kind of identifier scheme. The scheme or standard used to identify materials, e.g., CAS."@en ;
                                                  rdfs:label "Material identifier scheme"@en .


###  https://w3id.org/eudpp#MaterialOfComposition
<https://w3id.org/eudpp#MaterialOfComposition> rdf:type owl:Class ;
                                               rdfs:comment "Material the product (or component) is made of [ESPR Annex I]. Material as an element of composition."@en ;
                                               rdfs:isDefinedBy "https://w3id.org/eudpp/MAT" ;
                                               rdfs:label "Material of composition"@en .


###  https://w3id.org/eudpp#MaterialOrigin
<https://w3id.org/eudpp#MaterialOrigin> rdf:type owl:Class ;
                                        owl:equivalentClass [ rdf:type owl:Class ;
                                                              owl:oneOf ( <https://w3id.org/eudpp#raw>
                                                                          <https://w3id.org/eudpp#recycled>
                                                                          <https://w3id.org/eudpp#renewable>
                                                                        )
                                                            ] ;
                                        <http://purl.org/dc/terms/references> "[ESPR Annex I]"@en ;
                                        <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                        rdfs:comment "Origin of the material used in product [ESPR Annex I]"@en ;
                                        rdfs:label "Origin of material"@en .


###  https://w3id.org/eudpp#MaterialType
<https://w3id.org/eudpp#MaterialType> rdf:type owl:Class ;
                                      rdfs:comment """Placeholder class for material type classification applicable in a sector or mandated by a delegated act (DA).

Potential types could be, on the example of textile sector: cotton, nylon, ..."""@en ;
                                      rdfs:label "Material type"@en .


###  https://w3id.org/eudpp#MicroplasticRelease
<https://w3id.org/eudpp#MicroplasticRelease> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/eudpp#PlasticsRelease> ;
                                             <http://purl.org/dc/terms/references> "ESPR Annex I"@en ;
                                             <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                             rdfs:comment """Product parameters as listed in the ESPR Annex I :

(p) microplastic and nano plastic release as expressed through the release during relevant
product life cycle stages, including manufacturing, transport, use and end of life stages;

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                             rdfs:label "Microplastic release"@en .


###  https://w3id.org/eudpp#NanoplasticRelease
<https://w3id.org/eudpp#NanoplasticRelease> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/eudpp#PlasticsRelease> ;
                                            <http://purl.org/dc/terms/references> "ESPR Annex I"@en ;
                                            <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                            rdfs:comment """Product parameters as listed in the ESPR Annex I :

(p) microplastic and nano plastic release as expressed through the release during relevant
product life cycle stages, including manufacturing, transport, use and end of life stages;

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                            rdfs:label "Nanoplastic release"@en .


###  https://w3id.org/eudpp#NaturalPerson
<https://w3id.org/eudpp#NaturalPerson> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/eudpp#Actor> ;
                                       <http://purl.org/dc/terms/source> "https://www.merriam-webster.com/legal/natural%20person" ;
                                       rdfs:comment "A human being as distinguished from a person (as a corporation) created by operation of law"@en ;
                                       rdfs:label "Natural Person"@en .


###  https://w3id.org/eudpp#OtherTechnicalSpecification
<https://w3id.org/eudpp#OtherTechnicalSpecification> rdf:type owl:Class ;
                                                     rdfs:subClassOf <https://w3id.org/eudpp#TechnicalSpecification> ;
                                                     <http://purl.org/dc/terms/source> "ESPR Annex V, (6)"@en ;
                                                     rdfs:comment "Other technical specifications in relation to which conformity is declared."@en ;
                                                     rdfs:label "Other Technical Specification"@en .


###  https://w3id.org/eudpp#PackagingWasteAmount
<https://w3id.org/eudpp#PackagingWasteAmount> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/eudpp#WasteGenerationAmount> ;
                                              rdfs:comment """Packaging waste amount of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                              rdfs:label "Packaging waste amount"@en .


###  https://w3id.org/eudpp#PlacingOnMarketEvent
<https://w3id.org/eudpp#PlacingOnMarketEvent> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/eudpp#MakingAvailableOnMarketEvent> ;
                                              <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                              <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(40)"@en ;
                                              rdfs:comment "The very first time a product is made available on the Union market. ESPR Art 2(40)."@en ;
                                              rdfs:label "Placing on the Market"@en .


###  https://w3id.org/eudpp#PlasticsRelease
<https://w3id.org/eudpp#PlasticsRelease> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/eudpp#EnvironmentalPollution> ;
                                         <http://purl.org/dc/terms/references> "ESPR Annex I"@en ;
                                         <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                         rdfs:comment """Product parameters as listed in the ESPR Annex I :

(p) microplastic and nano plastic release as expressed through the release during relevant
product life cycle stages, including manufacturing, transport, use and end of life stages;

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                         rdfs:label "Plastic release"@en .


###  https://w3id.org/eudpp#PlasticsWasteAmount
<https://w3id.org/eudpp#PlasticsWasteAmount> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/eudpp#WasteGenerationAmount> ;
                                             rdfs:comment """Hazardous waste amount of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                             rdfs:label "Plastics waste amount"@en .


###  https://w3id.org/eudpp#Product
<https://w3id.org/eudpp#Product> rdf:type owl:Class ;
                                 <http://purl.org/dc/terms/references> "ESPR Art 2 (1)"@en ;
                                 <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                 rdfs:comment "Product means any physical goods that are placed on the market or put into service. ESPR Art 2 (1))"@en ;
                                 rdfs:isDefinedBy :P_DPP ;
                                 rdfs:label "Product"@en ;
                                 <http://www.w3.org/2004/02/skos/core#closeMatch> "schema:Product" .


###  https://w3id.org/eudpp#ProductDimension
<https://w3id.org/eudpp#ProductDimension> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                          <http://purl.org/dc/terms/references> "ESPR Annex I"@en ;
                                          <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                          rdfs:comment """Dimension class covers measurements of length, width, height, volume, and weight of the product required by
ESPR Annex I in its product parameters"""@en ;
                                          rdfs:label "Product dimension"@en .


###  https://w3id.org/eudpp#ProductEvent
<https://w3id.org/eudpp#ProductEvent> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/eudpp#ESPREvent> ;
                                      rdfs:comment "An ESPR-level event concept representing an event that affects the state, condition, use, circulation, transformation, maintenance, or end-of-life status of a product. A ProductEvent captures the product-facing semantics of the occurrence and is distinct from any DPP-side event that may be triggered to record or reflect it."@en ;
                                      rdfs:label "Product Event"@en .


###  https://w3id.org/eudpp#ProductIdentifier
<https://w3id.org/eudpp#ProductIdentifier> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/eudpp#Identifier> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://w3id.org/eudpp#hasScheme> ;
                                                             owl:someValuesFrom <https://w3id.org/eudpp#ProductIdentifierScheme>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://w3id.org/eudpp#hasGranularity> ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onClass <https://w3id.org/eudpp#ProductIdentifierGranularity>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://w3id.org/eudpp#identifierValue> ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onDataRange xsd:string
                                                           ] ;
                                           owl:disjointWith <https://w3id.org/eudpp#SoCIdentifier> ;
                                           rdfs:comment "A type of identifier to identify Products. A unique code assigned to identify a product. e.g., GTIN."@en ;
                                           rdfs:isDefinedBy "https://w3id.org/eudpp/IDENT" ;
                                           rdfs:label "Product identifier"@en .


###  https://w3id.org/eudpp#ProductIdentifierGranularity
<https://w3id.org/eudpp#ProductIdentifierGranularity> rdf:type owl:Class ;
                                                      owl:equivalentClass [ rdf:type owl:Class ;
                                                                            owl:oneOf ( <https://w3id.org/eudpp#batch>
                                                                                        <https://w3id.org/eudpp#item>
                                                                                        <https://w3id.org/eudpp#model>
                                                                                      )
                                                                          ] ;
                                                      rdfs:subClassOf <https://w3id.org/eudpp#IdentifierGranularity> ;
                                                      rdfs:comment "The granularity level (batch, item, model) at which the product identifier represents the product."@en ;
                                                      rdfs:label "Product identifier granularity"@en .


###  https://w3id.org/eudpp#ProductIdentifierScheme
<https://w3id.org/eudpp#ProductIdentifierScheme> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/eudpp#IdentifierScheme> ;
                                                 rdfs:comment "A kind of identifier scheme. The scheme or standard used to identify Products, e.g., GTIN, SKU, etc."@en ;
                                                 rdfs:label "Product identifier scheme"@en .


###  https://w3id.org/eudpp#ProductRequirement
<https://w3id.org/eudpp#ProductRequirement> rdf:type owl:Class ;
                                            rdfs:comment "Product requirements means a requirement to be fullfilled by a product when placed on the market."@en ;
                                            rdfs:label "Product Requirement"@en .


###  https://w3id.org/eudpp#ProductToPackagingRatio
<https://w3id.org/eudpp#ProductToPackagingRatio> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                                 <http://purl.org/dc/terms/references> "ESPR Annex I"@en ;
                                                 <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                 rdfs:comment """ESPR Annex I, the list of product parameters includes the parameter called the  product to packaging ratio.

However, it is not specified in ESPR  whether that ratio is defined on the basis of weight or on the basis of volume.

**This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.**"""@en ;
                                                 rdfs:label "Product to packaging ratio"@en .


###  https://w3id.org/eudpp#Property
<https://w3id.org/eudpp#Property> rdf:type owl:Class ;
                                  rdfs:comment "A property of the product."@en ;
                                  rdfs:label "Property"@en .


###  https://w3id.org/eudpp#PuttingIntoServiceEvent
<https://w3id.org/eudpp#PuttingIntoServiceEvent> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                                 <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                 <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(41)"@en ;
                                                 rdfs:comment "The first use of a product for its intended purpose in the Union. ESPR Art 2(41)."@en ;
                                                 rdfs:label "Putting into Service"@en .


###  https://w3id.org/eudpp#QualityIndicator
<https://w3id.org/eudpp#QualityIndicator> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                          rdfs:comment """Product characteristics like durability and reliability.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                          rdfs:label "Quality indicator"@en .


###  https://w3id.org/eudpp#QuantitativeProperty
<https://w3id.org/eudpp#QuantitativeProperty> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/eudpp#Property> ;
                                              rdfs:comment "A property (respectively measurand of a property) of the product (model) that is expressed by a quantity value. A specific quantity."@en ;
                                              rdfs:label "Quantitative Property"@en .


###  https://w3id.org/eudpp#RecoverableRate
<https://w3id.org/eudpp#RecoverableRate> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/eudpp#CircularEconomyIndicator> ;
                                         rdfs:comment "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en ;
                                         rdfs:label "Recoverable rate"@en .


###  https://w3id.org/eudpp#RecycledMaterialsUse
<https://w3id.org/eudpp#RecycledMaterialsUse> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/eudpp#ResourceConsumption> ;
                                              rdfs:comment """Recycled materials use of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                              rdfs:label "Recycled materials use"@en .


###  https://w3id.org/eudpp#RecyclingCollectionRate
<https://w3id.org/eudpp#RecyclingCollectionRate> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/eudpp#CircularEconomyIndicator> ;
                                                 rdfs:comment "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en ;
                                                 rdfs:label "Recycling collection rate"@en .


###  https://w3id.org/eudpp#RecyclingRate
<https://w3id.org/eudpp#RecyclingRate> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/eudpp#CircularEconomyIndicator> ;
                                       rdfs:comment "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."@en ;
                                       rdfs:label "Recycling rate"@en .


###  https://w3id.org/eudpp#RefurbishmentEvent
<https://w3id.org/eudpp#RefurbishmentEvent> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                            <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                            <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(18)"@en ;
                                            rdfs:comment "Actions carried out to prepare, clean, test, service and, where necessary, repair a product or a discarded product in order to restore its performance or functionality within the intended use and range of performance originally conceived at the design stage at the time of the placing of the product on the market. ESPR Art 2(18)."@en ;
                                            rdfs:label "Refurbishment"@en .


###  https://w3id.org/eudpp#Reliability
<https://w3id.org/eudpp#Reliability> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/eudpp#QualityIndicator> ;
                                     <http://purl.org/dc/terms/references> "ESPR Art 2 (16)"@en ;
                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                     rdfs:comment """Reliability
means the probability that a product functions as required under given conditions for a given
duration without an occurrence which results in a primary or secondary function of the product no
longer being performed. (ESPR Art 2 (16))

Reliability is usually expressed in terms of mean time between failures (MTBF), which is the average length of time that a device will operate without failure.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                     rdfs:label "Reliability"@en .


###  https://w3id.org/eudpp#RemanufacturingEvent
<https://w3id.org/eudpp#RemanufacturingEvent> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                              <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                              <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(16)"@en ;
                                              rdfs:comment "Actions through which a new product is produced from objects that are waste, products or components and through which at least one change is made that substantially affects the safety, performance, purpose or type of the product. ESPR Art 2(16)."@en ;
                                              rdfs:label "Remanufacturing"@en .


###  https://w3id.org/eudpp#RepairEvent
<https://w3id.org/eudpp#RepairEvent> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                     <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                     <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(20)"@en ;
                                     rdfs:comment "Actions taken to return a defective product or waste to a condition where it fulfils its intended purpose. ESPR Art 2(20)."@en ;
                                     rdfs:label "Repair"@en .


###  https://w3id.org/eudpp#ResourceConsumption
<https://w3id.org/eudpp#ResourceConsumption> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                             rdfs:comment """Resource consumption of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                             rdfs:label "Resource consumption"@en .


###  https://w3id.org/eudpp#Role
<https://w3id.org/eudpp#Role> rdf:type owl:Class ;
                              <http://purl.org/dc/terms/references> "CIRPASS-2 User Stories 3.1"@en ;
                              <http://purl.org/dc/terms/source> "https://zenodo.org/records/17979585" ;
                              rdfs:comment "Role means a set of tasks typically performed by one actor. (e.g. Responsible Economic Operator, Independent operator); [CIRPASS-2 User Stories 3.1]"@en ;
                              rdfs:label "Role"@en .


###  https://w3id.org/eudpp#SoCIdentifier
<https://w3id.org/eudpp#SoCIdentifier> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/eudpp#Identifier> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/eudpp#identifierValue> ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onDataRange xsd:string
                                                       ] ;
                                       rdfs:comment "A type of identifier to identify substances of concern."@en ;
                                       rdfs:label "Substance of concern identifier"@en .


###  https://w3id.org/eudpp#Substance
<https://w3id.org/eudpp#Substance> rdf:type owl:Class ;
                                   <http://purl.org/dc/terms/references> "ESPR Art 2"@en ,
                                                                         "Regulation (EC) No 1907/2006"@en ;
                                   <http://purl.org/dc/terms/source> "http://data.europa.eu/eli/reg/2006/1907/oj" ,
                                                                     "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                   rdfs:comment "Means a chemical element and its compounds in the natural state or obtained by any manufacturing process, including any additive necessary to preserve its stability and any impurity deriving from the process used, but excluding any solvent which may be separated without affecting the stability of the substance or changing its composition; ESPR Art 2, Regulation (EC) No 1907/2006"@en ;
                                   rdfs:label "Substance"@en .


###  https://w3id.org/eudpp#SubstanceOfConcern
<https://w3id.org/eudpp#SubstanceOfConcern> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/eudpp#Substance> ;
                                            <http://purl.org/dc/terms/references> "ESPR Art 2(10)"@en ;
                                            <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                            rdfs:comment "means a substance that:(a) meets the criteria laid down in Article 57 of Regulation (EC) No 1907/2006 and is identified in accordance with Article 59(1) of that Regulation; (b) is classified in Part 3 of Annex VI to Regulation (EC) No 1272/2008 in one of the following hazard classes or hazard categories: (i) carcinogenicity categories 1 and 2; (ii) germ cell mutagenicity categories 1 and 2; (iii) reproductive toxicity categories 1 and 2; (iv) endocrine disruption for human health categories 1 and 2; (v) endocrine disruption for the environment categories 1 and 2; (vi) persistent, mobile and toxic or very persistent, very mobile properties; (vii) persistent, bioaccumulative and toxic or very persistent, very bioaccumulative properties; (viii) respiratory sensitisation category 1; (ix) skin sensitisation category 1; (x) hazardous to the aquatic environment — categories chronic 1 to 4; (xi) hazardous to the ozone layer; (xii) specific target organ toxicity — repeated exposure categories 1 and 2; (xiii) specific target organ toxicity — single exposure categories 1 and 2; (c) is regulated under Regulation (EU) 2019/1021; or (d) negatively affects the reuse and recycling of materials in the product in which it is present [ESPR Art 2(10)]"@en ;
                                            rdfs:isDefinedBy :SOC ;
                                            rdfs:label "Substance of concern"@en .


###  https://w3id.org/eudpp#SustainableRenewableMaterialsUse
<https://w3id.org/eudpp#SustainableRenewableMaterialsUse> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://w3id.org/eudpp#ResourceConsumption> ;
                                                          rdfs:comment """Sustainable renewable materials use of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                                          rdfs:label "Sustainable renewable materials use"@en .


###  https://w3id.org/eudpp#TechnicalSpecification
<https://w3id.org/eudpp#TechnicalSpecification> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/eudpp#ProductRequirement> ;
                                                <http://purl.org/dc/terms/source> """Regulation (EU) No 1025/2012 Art 2 (4)
https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2"""@en ;
                                                rdfs:comment "Technical specification means a document that prescribes technical requirements to be fulfilled by a product, process, service or system and which lays down one or more of the following: Common Specification or Other Technical Specification."@en ;
                                                rdfs:label "Technical Specification"@en .


###  https://w3id.org/eudpp#Threshold
<https://w3id.org/eudpp#Threshold> rdf:type owl:Class ;
                                   <http://purl.org/dc/terms/references> "ESPR FAQ 10.115, p59"@en ;
                                   <http://purl.org/dc/terms/source> "https://circabc.europa.eu/ui/group/418195ae-4919-45fa-a959-3b695c9aab28/library/25c48e7c-9ce3-41cb-96ac-d2942a8a29d6/details" ;
                                   rdfs:comment """Relevant threshold of Substance of Concern.

By default, information on all substances of concern present in a product, above the  relevant thresholds, should be included in the DPP [ESPR FAQ 10.115, p59]"""@en ;
                                   rdfs:label "Threshold of substance of concern"@en .


###  https://w3id.org/eudpp#ThresholdOfSubstanceOfConcern
<https://w3id.org/eudpp#ThresholdOfSubstanceOfConcern> rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                                       <http://purl.org/dc/terms/references> "ESPR FAQ 10.115, p59"@en ;
                                                       <http://purl.org/dc/terms/source> "https://circabc.europa.eu/ui/group/418195ae-4919-45fa-a959-3b695c9aab28/library/25c48e7c-9ce3-41cb-96ac-d2942a8a29d6/details" ;
                                                       rdfs:comment """Relevant threshold of Substance of Concern.

By default, information on all substances of concern present in a product, above the  relevant thresholds, should be included in the DPP [ESPR FAQ 10.115, p59]"""@en ;
                                                       rdfs:label "Threshold of substance of concern"@en .


###  https://w3id.org/eudpp#UnionHarmonisationLegislation
<https://w3id.org/eudpp#UnionHarmonisationLegislation> rdf:type owl:Class ;
                                                       <http://purl.org/dc/terms/source> """Decision No 768/2008/EC Annex I Art R1 (17)
https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I"""@en ;
                                                       rdfs:comment "Union Harmonisation Legislation shall mean any Union legislation harmonising the conditions for the marketing of products. Examples are directives, regulations and delegated acts."@en ;
                                                       rdfs:isDefinedBy "https://w3id.org/eudpp/COMP" ;
                                                       rdfs:label "Union Harmonised Legislation"@en .


###  https://w3id.org/eudpp#UpgradingEvent
<https://w3id.org/eudpp#UpgradingEvent> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ;
                                        <http://purl.org/dc/terms/identifier> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                        <http://purl.org/dc/terms/source> "Regulation (EU) 2024/1781; Art 2(17)"@en ;
                                        rdfs:comment "Actions carried out to enhance the functionality, performance, capacity, safety or aesthetics of a product. ESPR Art 2(17)."@en ;
                                        rdfs:label "Upgrading"@en .


###  https://w3id.org/eudpp#Volume
<https://w3id.org/eudpp#Volume> rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ;
                                rdfs:comment "Volume of the product"@en ;
                                rdfs:label "Volume"@en .


###  https://w3id.org/eudpp#WasteGenerationAmount
<https://w3id.org/eudpp#WasteGenerationAmount> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/eudpp#QuantitativeProperty> ;
                                               rdfs:comment """Waste generation amount of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                               rdfs:label "Waste generation amount"@en .


###  https://w3id.org/eudpp#WaterConsumption
<https://w3id.org/eudpp#WaterConsumption> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/eudpp#ResourceConsumption> ;
                                          rdfs:comment """Water consumption of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
                                          rdfs:label "Water consumption"@en .


###  https://w3id.org/eudpp#Weight
<https://w3id.org/eudpp#Weight> rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ;
                                rdfs:comment "Weight of the product"@en ;
                                rdfs:label "Weight"@en .


###  https://w3id.org/eudpp#Width
<https://w3id.org/eudpp#Width> rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/eudpp#ProductDimension> ;
                               rdfs:comment "Width of the product"@en ;
                               rdfs:label "Width"@en .


#################################################################
#    Individuals
#################################################################

###  http://publications.europa.eu/resource/authority/corporate-body/COM
<http://publications.europa.eu/resource/authority/corporate-body/COM> rdf:type owl:NamedIndividual ;
                                                                      owl:sameAs <https://w3id.org/eudpp#EuropeanCommission> .


###  https://w3id.org/eudpp#EuropeanCommission

###  http://publications.europa.eu/resource/authority/country/EUR
<http://publications.europa.eu/resource/authority/country/EUR> rdf:type owl:NamedIndividual ;
                                                               rdfs:comment "European Union is used here as a jurisdictional or geographic entity for legal and regulatory contexts."@en ;
                                                               rdfs:label "European Union"@en .


###  https://w3id.org/eudpp#AddDPPDataAction
<https://w3id.org/eudpp#AddDPPDataAction> rdf:type owl:NamedIndividual ,
                                                   <https://w3id.org/eudpp#DPPActionType> ;
                                          rdfs:comment "Indicates that new information is added to the Digital Product Passport."@en ;
                                          rdfs:label "add data"@en .


###  https://w3id.org/eudpp#CAS
<https://w3id.org/eudpp#CAS> rdf:type owl:NamedIndividual ,
                                      <https://w3id.org/eudpp#MaterialIdentifierScheme> ;
                             <https://w3id.org/eudpp#identifierExampleValue> "7732-18-5" ;
                             <https://w3id.org/eudpp#identifierMaxLength> 12 ;
                             <https://w3id.org/eudpp#identifierMinLength> 7 ;
                             rdfs:comment "CAS Number (Chemical Abstracts Service)"@en ;
                             rdfs:label "CAS"@en ;
                             rdfs:seeAlso "https://www.cas.org/support/documentation/chemical-substances/faqs" ;
                             <http://www.w3.org/2004/02/skos/core#altLabel> "Chemical Abstracts Service Registry Number"@en .


###  https://w3id.org/eudpp#CorrectDPPDataAction
<https://w3id.org/eudpp#CorrectDPPDataAction> rdf:type owl:NamedIndividual ,
                                                       <https://w3id.org/eudpp#DPPActionType> ;
                                              rdfs:comment "Indicates that erroneous, inconsistent, or incomplete information in the Digital Product Passport is corrected."@en ;
                                              rdfs:label "correct data"@en .


###  https://w3id.org/eudpp#DeleteDPPDataAction
<https://w3id.org/eudpp#DeleteDPPDataAction> rdf:type owl:NamedIndividual ,
                                                      <https://w3id.org/eudpp#DPPActionType> ;
                                             rdfs:comment "Indicates that information is removed from the Digital Product Passport."@en ;
                                             rdfs:label "delete data"@en .


###  https://w3id.org/eudpp#EORI
<https://w3id.org/eudpp#EORI> rdf:type owl:NamedIndividual ;
                              <https://w3id.org/eudpp#identifierExampleValue> "DE123456789012345" ;
                              <https://w3id.org/eudpp#identifierMaxLength> 17 ;
                              <https://w3id.org/eudpp#identifierMinLength> 8 ;
                              rdfs:comment """Economic Operators Registration and Identification (EU).
This is the EU’s official identifier for companies involved in import/export.
Mandatory for any company trading with the EU.

Used in customs declarations
Unique per company

Format: country code + number (e.g., DE123456789)

This is the most widely used identifier for economic operators in EU trade."""@en ;
                              rdfs:label "EORI"@en ,
                                         "https://taxation-customs.ec.europa.eu/customs/customs-procedures-import-and-export/customs-operations/economic-operators-registration-and-identification-number-eori_en" ;
                              <http://www.w3.org/2004/02/skos/core#altLabel> "Economic Operators Registration and Identification (EU"@en .


###  https://w3id.org/eudpp#EuropeanCommission
<https://w3id.org/eudpp#EuropeanCommission> rdf:type owl:NamedIndividual ,
                                                     <https://w3id.org/eudpp#LegalPerson> ;
                                            <http://purl.org/dc/terms/source> "https://ec.europa.eu/eurostat/statistics-explained/index.php?title=Glossary:European_Commission_(EC)" ;
                                            rdfs:comment "The European Commission, abbreviated as EC, is the executive branch of the European Union."@en ;
                                            rdfs:label "European Commission"@en .


###  https://w3id.org/eudpp#GLN
<https://w3id.org/eudpp#GLN> rdf:type owl:NamedIndividual ,
                                      <https://w3id.org/eudpp#ActorIdentifierScheme> ;
                             <https://w3id.org/eudpp#identifierExampleValue> "9501101530003" ;
                             <https://w3id.org/eudpp#identifierMaxLength> 13 ;
                             <https://w3id.org/eudpp#identifierMinLength> 13 ;
                             <https://w3id.org/eudpp#identifierSchemeIssuer> "GS1" ;
                             rdfs:comment """A globally unique identifier defined by GS1 used to identify legal entities, functional entities, and physical locations within business and supply chain processes.

Typically identifies: legal entities, functional entities (departments), physical locations (warehouses, sites)."""@en ;
                             rdfs:label "GLN"@en ;
                             rdfs:seeAlso "https://www.gs1.org/standards/id-keys/gln" ;
                             <http://www.w3.org/2004/02/skos/core#altLabel> "Global Location Number"@en .


###  https://w3id.org/eudpp#GTIN
<https://w3id.org/eudpp#GTIN> rdf:type owl:NamedIndividual ,
                                       <https://w3id.org/eudpp#ProductIdentifierScheme> ;
                              <https://w3id.org/eudpp#identifierExampleValue> "14006381333938" ;
                              <https://w3id.org/eudpp#identifierMaxLength> 14 ;
                              <https://w3id.org/eudpp#identifierMinLength> 8 ;
                              <https://w3id.org/eudpp#identifierSchemeIssuer> "GS1" ;
                              rdfs:comment "A globally unique identifier for trade items, defined by GS1, used to identify products at various packaging levels."@en ;
                              rdfs:label "GTIN"@en ;
                              rdfs:seeAlso "https://www.gs1.org/standards/id-keys/gtin" ;
                              <http://www.w3.org/2004/02/skos/core#altLabel> "Global Trade Item Number"@en ;
                              <http://www.w3.org/2004/02/skos/core#definition> "A globally unique identifier for trade items, defined by GS1, used to identify products at various packaging levels."@en .


###  https://w3id.org/eudpp#LEI
<https://w3id.org/eudpp#LEI> rdf:type owl:NamedIndividual ,
                                      <https://w3id.org/eudpp#ActorIdentifierScheme> ;
                             <https://w3id.org/eudpp#identifierExampleValue> "529900T8BM49AURSDO55" ;
                             <https://w3id.org/eudpp#identifierMaxLength> 20 ;
                             <https://w3id.org/eudpp#identifierMinLength> 20 ;
                             <https://w3id.org/eudpp#identifierSchemeIssuer> "ISO" ;
                             rdfs:comment """A Legal Entity Identifier (LEI) is a globally unique 20-character alphanumeric code that identifies legally distinct entities participating in financial transactions, as defined by ISO 17442.

A 20‑character code used globally for financial and regulatory reporting.
Required for companies involved in financial transactions.
Used by regulators, banks, customs, and some trade systems."""@en ;
                             rdfs:label "LEI"@en ;
                             rdfs:seeAlso "https://www.iso.org/standard/78829.html" .


###  https://w3id.org/eudpp#ModifyDPPDataAction
<https://w3id.org/eudpp#ModifyDPPDataAction> rdf:type owl:NamedIndividual ,
                                                      <https://w3id.org/eudpp#DPPActionType> ;
                                             rdfs:comment "Indicates that existing information in the Digital Product Passport is modified."@en ;
                                             rdfs:label "modify data"@en .


###  https://w3id.org/eudpp#SKU
<https://w3id.org/eudpp#SKU> rdf:type owl:NamedIndividual ,
                                      <https://w3id.org/eudpp#ProductIdentifierScheme> ;
                             <https://w3id.org/eudpp#identifierExampleValue> "ABC-RED-XL" ;
                             <https://w3id.org/eudpp#identifierMaxLength> 50 ;
                             <https://w3id.org/eudpp#identifierMinLength> 1 ;
                             rdfs:comment "A Stock Keeping Unit (SKU) is an internal identifier assigned by an organization to uniquely identify and track a product, item, or variant within its own inventory and management systems."@en ;
                             rdfs:label "SKU"@en ;
                             rdfs:seeAlso "https://en.wikipedia.org/wiki/Stock_keeping_unit" ;
                             <http://www.w3.org/2004/02/skos/core#altLabel> "Stock Keeping Unit"@en .


###  https://w3id.org/eudpp#authorisedRepresentative
<https://w3id.org/eudpp#authorisedRepresentative> rdf:type owl:NamedIndividual ,
                                                           <https://w3id.org/eudpp#EconomicOperatorRole> ;
                                                  <http://purl.org/dc/terms/references> "ESPR Art 2 (43)"@en ;
                                                  <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                  rdfs:comment "Authorised representative means any natural or legal person established in the Union that has received a written mandate from the manufacturer to act on the manufacturer’s behalf in relation to specified tasks with regard to the manufacturer’s obligations under this Regulation; [ESPR Art 2 (43)]"@en ;
                                                  rdfs:label "Authorised Representative"@en .


###  https://w3id.org/eudpp#batch
<https://w3id.org/eudpp#batch> rdf:type owl:NamedIndividual ,
                                        <https://w3id.org/eudpp#ProductIdentifierGranularity> ;
                               rdfs:comment "According to ESPR Art 9 (2d) the digital product passport is to be established at model, batch or item level, and the definition of such levels is given by delegated acts;"@en ;
                               rdfs:label "batch"@en .


###  https://w3id.org/eudpp#conformityAssessmentBody
<https://w3id.org/eudpp#conformityAssessmentBody> rdf:type owl:NamedIndividual ,
                                                           <https://w3id.org/eudpp#ConformityAssessmentRole> ;
                                                  <http://purl.org/dc/terms/references> "ESPR Art 2 (52)"@en ;
                                                  <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                  rdfs:comment "Conformity assessment body means a body that performs conformity assessment activities including calibration, testing, certification and inspection; [ESPR Art 2 (52)]"@en ;
                                                  rdfs:label "Conformity Assessment Body"@en .


###  https://w3id.org/eudpp#consumer
<https://w3id.org/eudpp#consumer> rdf:type owl:NamedIndividual ,
                                           <https://w3id.org/eudpp#EndUserRole> ;
                                  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/eudpp#customer> ;
                                  <http://purl.org/dc/terms/references> "Directive (EU) 2019/771, Art 2 (2)"@en ;
                                  <http://purl.org/dc/terms/source> "http://data.europa.eu/eli/dir/2019/771/oj" ;
                                  rdfs:comment "Consumer means any natural person who, in relation to contracts covered by Directive (EU) 2019/771, is acting for purposes which are outside that person's trade, business, craft or profession; [Directive (EU) 2019/771, Art 2 (2)]"@en ;
                                  rdfs:label "Consumer"@en .


###  https://w3id.org/eudpp#credentialAgency
<https://w3id.org/eudpp#credentialAgency> rdf:type owl:NamedIndividual ,
                                                   <https://w3id.org/eudpp#Role> ;
                                          <http://purl.org/dc/terms/references> "CIRPASS-2 User Stories 3.1"@en ;
                                          <http://purl.org/dc/terms/source> "https://zenodo.org/records/17979585" ;
                                          rdfs:comment "A legal person that provides (professional) credentials to parties, which may be used to make and verify a variety of claims in the DPP, (ESPR) Art. 11 last paragraph. For example, a credentials agency could certify a professional repairer and provide appropriate credentials for the DPP system; [CIRPASS-2 User Stories 3.1]"@en ;
                                          rdfs:label "Credential Agency"@en .


###  https://w3id.org/eudpp#customer
<https://w3id.org/eudpp#customer> rdf:type owl:NamedIndividual ,
                                           <https://w3id.org/eudpp#EndUserRole> ;
                                  <http://purl.org/dc/terms/references> "ESPR Art 2 (35)"@en ;
                                  <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                  rdfs:comment "Customer means a natural or legal person that purchases, hires or receives a product for their own use whether or not acting for purposes which are outside their trade, business, craft or profession; [ESPR Art 2 (35)]"@en ;
                                  rdfs:label "Customer"@en .


###  https://w3id.org/eudpp#customsAuthority
<https://w3id.org/eudpp#customsAuthority> rdf:type owl:NamedIndividual ,
                                                   <https://w3id.org/eudpp#AuthorityRole> ;
                                          <http://purl.org/dc/terms/references> "Regulation (EU) 2019/1020, Art 3 (24)"@en ;
                                          <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2019/1020/oj" ;
                                          rdfs:comment "Customs authorities means  customs authorities as defined in point 1 of Article 5 of Regulation (EU) No 952/2013; [Regulation (EU) 2019/1020, Art 3 (24)]"@en ,
                                                       "Customs authorities means the customs administrations of the Member States responsible for applying the customs legislation and any other authorities empowered under national law to apply certain customs legislation (Regulation (EU) No 952/2013 Art 5 (1);"@en ;
                                          rdfs:label "Customs Authority"@en .


###  https://w3id.org/eudpp#dealer
<https://w3id.org/eudpp#dealer> rdf:type owl:NamedIndividual ,
                                         <https://w3id.org/eudpp#EconomicOperatorRole> ;
                                <http://www.w3.org/2004/02/skos/core#related> <https://w3id.org/eudpp#distributor> ;
                                <http://purl.org/dc/terms/references> "ESPR Art 2 (55)"@en ;
                                <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                rdfs:comment "Dealer means a distributor or any other natural or legal person that offers products for sale, hire or hire purchase, or that displays products, to end users in the course of a commercial activity, including through distance selling; and includes any natural or legal person that puts a product into service in the course of a commercial activity; [ESPR Art 2 (55)]"@en ;
                                rdfs:label "Dealer"@en .


###  https://w3id.org/eudpp#distributor
<https://w3id.org/eudpp#distributor> rdf:type owl:NamedIndividual ,
                                              <https://w3id.org/eudpp#EconomicOperatorRole> ;
                                     <http://www.w3.org/2004/02/skos/core#related> <https://w3id.org/eudpp#dealer> ;
                                     <http://purl.org/dc/terms/references> "ESPR Art 2 (45)"@en ;
                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                     rdfs:comment "Distributor means any natural or legal person in the supply chain, other than the manufacturer or the importer, that makes a product available on the market; [ESPR Art 2 (45)]"@en ;
                                     rdfs:label "Distributor"@en .


###  https://w3id.org/eudpp#dppServiceProvider
<https://w3id.org/eudpp#dppServiceProvider> rdf:type owl:NamedIndividual ,
                                                     <https://w3id.org/eudpp#Role> ;
                                            <http://purl.org/dc/terms/references> "ESPR Art 2 (32)"@en ;
                                            <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                            rdfs:comment "Digital product passport service provider means a natural or legal person that is an independent third-party authorised by the economic operator which places the product on the market or puts it into service and that processes the digital product passport data for that product for the purpose of making such data available to economic operators and other relevant actors with a right to access those data under this Regulation or other Union law; [ESPR Art 2 (32)]"@en ;
                                            rdfs:label "DPP Service Provider"@en .


###  https://w3id.org/eudpp#endUser
<https://w3id.org/eudpp#endUser> rdf:type owl:NamedIndividual ,
                                          <https://w3id.org/eudpp#EndUserRole> ;
                                 <http://www.w3.org/2004/02/skos/core#related> <https://w3id.org/eudpp#customer> ;
                                 <http://purl.org/dc/terms/references> "Regulation (EU) 2019/1020, Art 3 (21)"@en ;
                                 <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2019/1020/oj" ;
                                 rdfs:comment "End user means any natural or legal person residing or established in the Union, to whom a product has been made available either as a consumer outside of any trade, business, craft or profession or as a professional end user in the course of its industrial or professional activities; [Regulation (EU) 2019/1020  Art 3 (21)]"@en ;
                                 rdfs:label "End User"@en .


###  https://w3id.org/eudpp#fulfilmentServiceProvider
<https://w3id.org/eudpp#fulfilmentServiceProvider> rdf:type owl:NamedIndividual ,
                                                            <https://w3id.org/eudpp#EconomicOperatorRole> ;
                                                   <http://purl.org/dc/terms/references> "Regulation (EU) 2019/1020, Art 3 (11)"@en ;
                                                   <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2019/1020/oj" ;
                                                   rdfs:comment "Fulfilment service provider means any natural or legal person offering, in the course of commercial activity, at least two of the following services: warehousing, packaging, addressing and dispatching, without having ownership of the products involved, excluding postal services as defined in point 1 of Article 2 of Directive 97/67/EC of the European Parliament and of the Council (31), parcel delivery services as defined in point 2 of Article 2 of Regulation (EU) 2018/644 of the European Parliament and of the Council (32), and any other postal services or freight transport services; [Regulation (EU) 2019/1020 Art 3 (11)]."@en ;
                                                   rdfs:label "Fulfilment Service Provider"@en .


###  https://w3id.org/eudpp#importer
<https://w3id.org/eudpp#importer> rdf:type owl:NamedIndividual ,
                                           <https://w3id.org/eudpp#EconomicOperatorRole> ;
                                  <http://purl.org/dc/terms/references> "ESPR Art 2 (44)"@en ;
                                  <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                  rdfs:comment "Importer means any natural or legal person established in the Union that places a product from a third country on the Union market; [ESPR Art 2 (44)]"@en ;
                                  rdfs:label "Importer"@en .


###  https://w3id.org/eudpp#independentOperator
<https://w3id.org/eudpp#independentOperator> rdf:type owl:NamedIndividual ,
                                                      <https://w3id.org/eudpp#CircularEconomyRole> ;
                                             <http://purl.org/dc/terms/references> "ESPR Art 2 (47)"@en ;
                                             <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                             rdfs:comment "Independent operator means natural or legal person that is independent of the manufacturer and is directly or indirectly involved in the refurbishment, repair, maintenance or repurposing of a product, and includes waste management operators, refurbishers, repairers, manufacturers or distributors of repair equipment, tools or spare parts, as well as publishers of technical information, operators offering inspection and testing services and operators offering training for installers, manufacturers and repairers of equipment; [ESPR Art 2 (47)]"@en ;
                                             rdfs:label "Independent Operator"@en .


###  https://w3id.org/eudpp#issuingAgency
<https://w3id.org/eudpp#issuingAgency> rdf:type owl:NamedIndividual ,
                                                <https://w3id.org/eudpp#Role> ;
                                       <http://purl.org/dc/terms/references> "ESPR Art 12 (4a)"@en ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                       rdfs:comment "Issuing agency is a legal persons that provide unique identifiers and data carriers Art 12 (4a). Under specific conditions, economic operators may perform the functions associated with an Issuing Agency; [ESPR Art 12 (4b)]"@en ;
                                       rdfs:label "Issuing Agency"@en .


###  https://w3id.org/eudpp#item
<https://w3id.org/eudpp#item> rdf:type owl:NamedIndividual ,
