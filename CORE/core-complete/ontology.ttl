                                   rdfs:domain <https://w3id.org/eudpp#Identifier> ;
                                   rdfs:range <https://w3id.org/eudpp#IdentifierScheme> ;
                                   rdfs:comment "The scheme/standard the Identifier follows" ;
                                   rdfs:label "has scheme"@en .


###  https://w3id.org/eudpp#hasSoCCriterion
<https://w3id.org/eudpp#hasSoCCriterion> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#SoCQualificationAssertion> ;
                                         rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                                         <http://purl.org/dc/terms/references> "ESPR Article 2(27)."@en ;
                                         <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                         rdfs:comment "Links a qualification assertion to one or more non-exclusive criteria (a)-(d)."@en ;
                                         rdfs:isDefinedBy :SOC ;
                                         rdfs:label "has SoC criterion"@en ;
                                         <https://w3id.org/eudpp#sourceStatus> "ESPR-grounded modelling relation connecting a qualification assertion to one or more Article 2(27) qualification criteria."@en .


###  https://w3id.org/eudpp#hasSubstanceIdentifier
