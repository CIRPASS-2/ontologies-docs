                                                                                          "ESPR Annex V (2,9)" ;
                                                    <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                                      "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                                    rdfs:comment """Defines the natural or legal person responsible for the EU declaration of conformity.


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                                    rdfs:label "has responsible manufacturer"@en .


###  https://w3id.org/eudpp#hasRole
<https://w3id.org/eudpp#hasRole> rdf:type owl:ObjectProperty ;
                                 owl:inverseOf <https://w3id.org/eudpp#isRoleOf> ;
                                 rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                 rdfs:range <https://w3id.org/eudpp#Role> ;
                                 rdfs:comment "Links an actor role assignment to a role."@en ;
                                 rdfs:label "has role"@en .


###  https://w3id.org/eudpp#hasScheme
<https://w3id.org/eudpp#hasScheme> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#Identifier> ;
                                   rdfs:range <https://w3id.org/eudpp#IdentifierScheme> ;
                                   rdfs:comment "The scheme/standard the Identifier follows" ;
                                   rdfs:label "has scheme"@en .


###  https://w3id.org/eudpp#hasThreshold
<https://w3id.org/eudpp#hasThreshold> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                      rdfs:range <https://w3id.org/eudpp#Threshold> ;
                                      <http://purl.org/dc/terms/references> "ESPR FAQ 10.115, p59"@en ;
                                      <http://purl.org/dc/terms/source> "https://circabc.europa.eu/ui/group/418195ae-4919-45fa-a959-3b695c9aab28/library/25c48e7c-9ce3-41cb-96ac-d2942a8a29d6/details" ;
                                      rdfs:comment """Describes relevant threshold of Substance of Concern.

By default, information on all substances of concern present in a product, above the  relevant thresholds, should be included in the DPP [ESPR FAQ 10.115, p59]"""@en ;
                                      rdfs:label "Has threshold"@en .


###  https://w3id.org/eudpp#hasUnionHarmonisationLegislation
<https://w3id.org/eudpp#hasUnionHarmonisationLegislation> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                                          rdfs:range <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
                                                          <http://purl.org/dc/terms/source> "ESPR Annex V, (5)"@en ;
                                                          rdfs:comment "A property providing the Union Harmonisation Legislation refered to in the EU Declaration of Conformity."@en ;
                                                          rdfs:label "has Union Harmonisation Legislation"@en .


###  https://w3id.org/eudpp#hasUniqueFacilityIdentifier
<https://w3id.org/eudpp#hasUniqueFacilityIdentifier> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#Facility> ;
                                                     rdfs:range <https://w3id.org/eudpp#FacilityIdentifier> ;
                                                     <http://purl.org/dc/terms/references> "ESPR Art 2 (33)"@en ;
                                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                     rdfs:comment """Linking a Facility to its unique facility identifier.
Facility is modelled in the EU DPP CO ACTOR module.
FacilityIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
                                                     rdfs:label "has unique facility identifier"@en .


###  https://w3id.org/eudpp#hasUniqueOperatorIdentifier
<https://w3id.org/eudpp#hasUniqueOperatorIdentifier> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                                     rdfs:range <https://w3id.org/eudpp#ActorIdentifier> ;
                                                     <http://purl.org/dc/terms/references> "ESPR Art 2 (31)"@en ;
                                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                     rdfs:comment """Linking an Actor to their unique operator identifier. 
Actor is modelled in the EU DPP CO ACTOR module.
ActorIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
                                                     rdfs:label "has unique operator identifier"@en .


###  https://w3id.org/eudpp#hasUniqueProductIdentifier
<https://w3id.org/eudpp#hasUniqueProductIdentifier> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://w3id.org/eudpp#Product> ;
                                                    rdfs:range <https://w3id.org/eudpp#ProductIdentifier> ;
                                                    rdfs:comment """Realisation of the uniqueProductIdentifier.

Product is modelled in the EU DPP CO P_DPP module.
ProductIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
                                                    rdfs:label "has unique product identifier"@en .


###  https://w3id.org/eudpp#inContextOfDPP
<https://w3id.org/eudpp#inContextOfDPP> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                        rdfs:range <https://w3id.org/eudpp#DPP> ;
                                        rdfs:comment """Relates the actor role assignment to a specific Digital Product Passport instance (from P_DPP module).

ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
DPP is modelled in the EU DPP CO P_DPP module.
        """@en ;
                                        rdfs:label "in context of DPP"@en .


###  https://w3id.org/eudpp#inContextOfProduct
<https://w3id.org/eudpp#inContextOfProduct> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                            rdfs:range <https://w3id.org/eudpp#Product> ;
                                            rdfs:comment """Relates the actor role assignment to a specific product (from P_DPP module).

ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
Product is modelled in the EU DPP CO P_DPP module."""@en ;
                                            rdfs:label "in context of product"@en .


###  https://w3id.org/eudpp#isActorRoleAssignmentForEvent
<https://w3id.org/eudpp#isActorRoleAssignmentForEvent> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                                       rdfs:range <https://w3id.org/eudpp#ESPREvent> ;
                                                       rdfs:comment """Links an actor-role assignment to the event context in which the role assignment applies. This is the inverse of evt:hasActorRoleAssignment and is managed in the Connector/mapping layer.

ESPREvent is modelled in the EU DPP CO EVENT module.
ActorRoleAssignment is modelled in the EU DPP CO ACTOR module."""@en ;
                                                       rdfs:label "is actor role assignment for event"@en .


###  https://w3id.org/eudpp#isComponentOf
<https://w3id.org/eudpp#isComponentOf> rdf:type owl:ObjectProperty ,
                                                owl:TransitiveProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Product> ;
                                       rdfs:range <https://w3id.org/eudpp#Product> ;
                                       <http://purl.org/dc/terms/references> "ESPR Art 2(2)"@en ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                       rdfs:comment """A product is a component of another product.

‘component’ means a product intended to be incorporated into another product; [ESPR Art 2(2)]"""@en ;
                                       rdfs:label "is component of"@en .


###  https://w3id.org/eudpp#isConformWith
<https://w3id.org/eudpp#isConformWith> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Product> ;
                                       rdfs:comment "Specifies Union Harminised Lagislation for which conformity of the product is stated."@en ;
                                       rdfs:label "is conform with"@en .


###  https://w3id.org/eudpp#isConnectedTo
<https://w3id.org/eudpp#isConnectedTo> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                       rdfs:range <https://w3id.org/eudpp#Facility> ;
                                       rdfs:comment """A DPP is connected to a facility.

DPP is modelled in the EU DPP CO P_DPP module.
Facility is modelled in the EU DPP CO ACTOR module."""@en ;
                                       rdfs:label "is connected to"@en .


###  https://w3id.org/eudpp#isEstablishedIn
<https://w3id.org/eudpp#isEstablishedIn> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#LegalPerson> ;
                                         rdfs:range <http://purl.org/dc/terms/Location> ;
                                         rdfs:comment "Relates a legal person to the location where it is established."@en ;
                                         rdfs:label "is established in"@en .


###  https://w3id.org/eudpp#isIssuedBy
<https://w3id.org/eudpp#isIssuedBy> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                    rdfs:range <https://w3id.org/eudpp#Actor> ;
                                    <http://purl.org/dc/terms/references> "ESPR Annex V (3)" ;
                                    <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                    rdfs:comment """Specifies the natural or legal person issuing the Declaration of Conformity; ESPR Annex V, paragraph 3 requirement: \"This declaration of conformity is issued under the sole responsibility of the manufacturer:\"


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                    rdfs:label "issued by"@en .


###  https://w3id.org/eudpp#isNotifiedFor
<https://w3id.org/eudpp#isNotifiedFor> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                       rdfs:range <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
                                       <http://purl.org/dc/terms/references> "Decision No 768/2008/EC Annex I Art R23 (3)" ,
                                                                             "ESPR Article 56 (3)" ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                         "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_56" ;
                                       rdfs:comment """Specifies the conformity assessment activities, the conformity assessment module or modules and product or products concerned and the relevant attestation of competence	

UnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                       rdfs:label "is notified for"@en .


###  https://w3id.org/eudpp#isRecordedAs
<https://w3id.org/eudpp#isRecordedAs> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#DPPEvent> ;
                                      rdfs:range <https://w3id.org/eudpp#DPPEventRecord> ;
                                      rdfs:comment "Links a DPP event to a technical audit record representing its registration in an information system or audit trail."@en ;
                                      rdfs:label "is recorded as"@en .


###  https://w3id.org/eudpp#isRepresentedByCarrier
<https://w3id.org/eudpp#isRepresentedByCarrier> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
                                                rdfs:range <https://ref.gs1.org/epcis/EPCISEvent> ;
                                                rdfs:comment "Links a product event concept to an EPCIS-inspired technical event carrier used to journalise and structure the corresponding event data."@en ;
                                                rdfs:label "is represented by carrier"@en .


###  https://w3id.org/eudpp#isResidingIn
<https://w3id.org/eudpp#isResidingIn> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#NaturalPerson> ;
                                      rdfs:range <http://purl.org/dc/terms/Location> ;
                                      rdfs:comment "Relates a natural person to the location where they reside."@en ;
                                      rdfs:label "is residing in"@en .


###  https://w3id.org/eudpp#isRoleOf
<https://w3id.org/eudpp#isRoleOf> rdf:type owl:ObjectProperty ;
                                  rdfs:domain <https://w3id.org/eudpp#Role> ;
                                  rdfs:range <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                  rdfs:comment "Relates role to an actor role assignment."@en ;
                                  rdfs:label "is role of"@en .


###  https://w3id.org/eudpp#isSignedBy
<https://w3id.org/eudpp#isSignedBy> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                    rdfs:range <https://w3id.org/eudpp#Actor> ;
                                    <http://purl.org/dc/terms/references> "ESPR Annex V (9, 10)" ;
                                    <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                    rdfs:comment """Specifies the natural or legal person signying the Declaration of Conformity.


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                    rdfs:label "is signed by"@en .


###  https://w3id.org/eudpp#isSparePartOf
<https://w3id.org/eudpp#isSparePartOf> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Product> ;
                                       rdfs:range <https://w3id.org/eudpp#Product> ;
                                       <http://purl.org/dc/terms/references> "ESPR Annex I"@en ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                       rdfs:comment "A product is a spare part of another product."@en ;
                                       rdfs:label "is spare part of"@en .


###  https://w3id.org/eudpp#isTriggeredByProductEvent
<https://w3id.org/eudpp#isTriggeredByProductEvent> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://w3id.org/eudpp#DPPEvent> ;
                                                   rdfs:range <https://w3id.org/eudpp#ProductEvent> ;
                                                   rdfs:comment "Links a DPP event to the product event that caused or required it. This property is used when the DPP event results from a lifecycle change affecting the product."@en ;
                                                   rdfs:label "is triggered by product event"@en .


###  https://w3id.org/eudpp#isUsedByActor
<https://w3id.org/eudpp#isUsedByActor> rdf:type owl:ObjectProperty ;
                                       owl:inverseOf <https://w3id.org/eudpp#usesFacility> ;
                                       rdfs:domain <https://w3id.org/eudpp#Facility> ;
                                       rdfs:range <https://w3id.org/eudpp#Actor> ;
                                       rdfs:comment "Relates a facility to an actor."@en ;
                                       rdfs:label "is used by actor"@en .


###  https://w3id.org/eudpp#issuesCertificate
<https://w3id.org/eudpp#issuesCertificate> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                           rdfs:range <https://w3id.org/eudpp#ConformityCertificate> ;
                                           <http://purl.org/dc/terms/references> "ESPR Annex V (7)" ;
                                           <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                           rdfs:comment """Specifies conformity assessment certificate issued for a certification.


ConformityCertificate is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                           rdfs:label "issues certificate"@en .


###  https://w3id.org/eudpp#performedAssessmentAccordingTo
<https://w3id.org/eudpp#performedAssessmentAccordingTo> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                                        rdfs:range <https://w3id.org/eudpp#ConformityAssessmentModule> ;
                                                        <http://purl.org/dc/terms/references> "ESPR Annex V (7)" ;
                                                        <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                                        rdfs:comment """Specifies conformity assess procedure/cerfication scheme performed by the notified body.


ConformityAssessmentModule is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                                        rdfs:label "performed assessment according to"@en .


###  https://w3id.org/eudpp#performedAt
<https://w3id.org/eudpp#performedAt> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <http://w3id.org/eudpp#ProductEvent> ;
                                     rdfs:range <https://w3id.org/eudpp#Facility> ;
                                     rdfs:comment """Links a product event to the facility where the event was performed or operationally occurred. This is a cross-module relation between EVENT and ACTOR/Facility and is therefore managed in the Connector/mapping layer.

ProductEvent is modelled in the EU DPP CO EVENT module.
Facility is modelled in the EU DPP CO ACTOR module."""@en ;
                                     rdfs:label "performed at"@en ;
                                     rdfs:seeAlso <https://ref.gs1.org/epcis/bizLocation> ,
                                                  <https://ref.gs1.org/epcis/readPoint> .


###  https://w3id.org/eudpp#performedBy
<https://w3id.org/eudpp#performedBy> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <http://w3id.org/eudpp#ProductEvent> ;
                                     rdfs:range <https://w3id.org/eudpp#Actor> ;
                                     rdfs:comment """Links a product event to the actor that performed, carried out, or was operationally responsible for the event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.

ProductEvent is modelled in the EU DPP CO EVENT module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                     rdfs:label "performed by"@en ;
                                     rdfs:seeAlso <https://w3id.org/eudpp#ActorRoleAssignment> .


###  https://w3id.org/eudpp#recordedBy
<https://w3id.org/eudpp#recordedBy> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <http://w3id.org/eudpp#DPPEventRecord> ;
                                    rdfs:range <https://w3id.org/eudpp#Actor> ;
                                    rdfs:comment """Links a DPP event record to the actor that created the technical record of the logged DPP-side event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.

DPPEventRecord is modelled in the EU DPP CO EVENT module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                    rdfs:label "recorded by"@en .


###  https://w3id.org/eudpp#recordsDPPEvent
<https://w3id.org/eudpp#recordsDPPEvent> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <https://w3id.org/eudpp#isRecordedAs> ;
                                         rdfs:domain <https://w3id.org/eudpp#DPPEventRecord> ;
                                         rdfs:range <https://w3id.org/eudpp#DPPEvent> ;
                                         rdfs:comment "Links a DPP event record to the DPP event whose technical registration it captures."@en ;
                                         rdfs:label "records DPP event"@en .


###  https://w3id.org/eudpp#representsManufacturer
<https://w3id.org/eudpp#representsManufacturer> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment> ;
                                                rdfs:range <https://w3id.org/eudpp#Actor> ;
                                                rdfs:comment "Used when the role is authorisedRepresentativeRole to indicate the manufacturer being represented."@en ;
                                                rdfs:label "represents manufacturer"@en .


###  https://w3id.org/eudpp#representsManufacturerForProduct
<https://w3id.org/eudpp#representsManufacturerForProduct> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment> ;
                                                          rdfs:range <https://w3id.org/eudpp#Product> ;
                                                          rdfs:comment """Indicates which product(s) the authorised representative's mandate covers.

AuthorisedRepresentativeRoleAssignment is modelled in the EU DPP CO ACTOR module.
Product is modelled in the EU DPP CO P_DPP module."""@en ;
                                                          rdfs:label "represents manufacturer for product"@en .


###  https://w3id.org/eudpp#triggersDPPEvent
<https://w3id.org/eudpp#triggersDPPEvent> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <https://w3id.org/eudpp#isTriggeredByProductEvent> ;
                                          rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
                                          rdfs:range <https://w3id.org/eudpp#DPPEvent> ;
                                          rdfs:comment "Links a product event to a DPP event that is triggered as a consequence of it, reflecting the obligation to update the DPP following lifecycle changes of the product."@en ;
                                          rdfs:label "triggers DPP event"@en .


###  https://w3id.org/eudpp#usedForPresumptionOfConformity
<https://w3id.org/eudpp#usedForPresumptionOfConformity> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <https://w3id.org/eudpp#ProductRequirement> ;
                                                        rdfs:range <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
                                                        <http://purl.org/dc/terms/source> """https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I	
Decision No 768/2008/EC Annex I Art R8"""@en ,
                                                                                          """https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_41
ESPR Art 41"""@en ;
                                                        rdfs:comment "This property specifies which harmonised standards (or parts thereof) was used to assess conformity with the Union harmonistation legislation."@en ;
                                                        rdfs:label "used for presumtion of conformity"@en .


###  https://w3id.org/eudpp#usesFacility
<https://w3id.org/eudpp#usesFacility> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                      rdfs:range <https://w3id.org/eudpp#Facility> ;
                                      rdfs:comment "Relates an actor to facility."@en ;
                                      rdfs:label "uses facility"@en .


#################################################################
#    Data properties
#################################################################

###  https://ref.gs1.org/epcis/action
<https://ref.gs1.org/epcis/action> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain [ rdf:type owl:Class ;
                                                 owl:unionOf ( <https://ref.gs1.org/epcis/AggregationEvent>
                                                               <https://ref.gs1.org/epcis/AssociationEvent>
                                                               <https://ref.gs1.org/epcis/ObjectEvent>
                                                               <https://ref.gs1.org/epcis/TransactionEvent>
                                                             )
                                               ] ;
                                   rdfs:range xsd:string ;
                                   <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/AggregationEvent> ,
                                                                      <https://ref.gs1.org/epcis/AssociationEvent> ,
                                                                      <https://ref.gs1.org/epcis/ObjectEvent> ,
                                                                      <https://ref.gs1.org/epcis/TransactionEvent> ;
                                   <http://schema.org/rangeIncludes> xsd:string ;
                                   rdfs:comment "How this event relates to the lifecycle of the EPCs named in this event."@en ;
                                   rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                   rdfs:label "action" ;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/eventTime
<https://ref.gs1.org/epcis/eventTime> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                      rdfs:range xsd:dateTimeStamp ;
                                      <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                      <http://schema.org/rangeIncludes> xsd:dateTimeStamp ;
                                      rdfs:comment "The date and time at which the EPCIS Capturing Applications asserts the event occurred."@en ;
                                      rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                      rdfs:label "eventTime" ;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/eventTimeZoneOffset
<https://ref.gs1.org/epcis/eventTimeZoneOffset> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                                rdfs:range xsd:string ;
                                                <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                                <http://schema.org/rangeIncludes> xsd:string ;
                                                rdfs:comment "The time zone offset in effect at the time and place the event occurred, expressed as an offset from UTC. The value of this field SHALL be a string consisting of the character '+' or the character '-', followed by two digits whose value is within the range 00 through 14 (inclusive), followed by a colon character ':', followed by two digits whose value is within the range 00 through 59 (inclusive), except that if the value of the first two digits is 14, the value of the second two digits must be 00. For example, the value +05:30 specifies that where the event occurred, local time was five hours and 30 minutes later than UTC (that is, midnight UTC was 5:30am local time)."@en ;
                                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                                rdfs:label "eventTimeZoneOffset" ;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/quantity
<https://ref.gs1.org/epcis/quantity> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://ref.gs1.org/epcis/QuantityElement> ;
                                     rdfs:range xsd:double ;
                                     <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/QuantityElement> ;
                                     <http://schema.org/rangeIncludes> xsd:double ;
                                     rdfs:comment "A number that specifies how many or how much of the specified EPCClass is denoted by this QuantityElement."@en ;
                                     rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                     rdfs:label "quantity" ;
                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/recordTime
<https://ref.gs1.org/epcis/recordTime> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://ref.gs1.org/epcis/EPCISEvent> ;
                                       rdfs:range xsd:dateTimeStamp ;
                                       <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/EPCISEvent> ;
                                       <http://schema.org/rangeIncludes> xsd:dateTimeStamp ;
                                       rdfs:comment "(Optional) The date and time at which this event was recorded by an EPCIS Repository. This field SHALL be ignored when an event is presented to the EPCIS Capture Interface, and SHALL be present when an event is retrieved through the EPCIS Query Interfaces. The recordTime does not describe anything about the real-world event, but is rather a bookkeeping mechanism that plays a role in the interpretation of standing queries"@en ;
                                       rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                       rdfs:label "recordTime" ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://ref.gs1.org/epcis/uom
<https://ref.gs1.org/epcis/uom> rdf:type owl:DatatypeProperty ;
                                rdfs:domain [ rdf:type owl:Class ;
                                              owl:unionOf ( <https://ref.gs1.org/epcis/QuantityElement>
                                                            <https://ref.gs1.org/epcis/SensorReport>
                                                          )
                                            ] ;
                                rdfs:range xsd:string ;
                                <http://schema.org/domainIncludes> <https://ref.gs1.org/epcis/QuantityElement> ,
                                                                   <https://ref.gs1.org/epcis/SensorReport> ;
                                <http://schema.org/rangeIncludes> xsd:string ;
                                rdfs:comment "(Optional) Unit of measure by which the specified value(s) of the property specified by type should be interpreted.  If there is no value, minValue, maxValue, averageValue or percValue field present, uom SHALL be omitted.  When a uom field is present, its value SHALL be the 2- or 3-character code for a physical unit specified in the 'Common Code' column of UN/CEFACT Recommendation'20 [CEFACT20].   Note: GS1 provides a tool containing a machine-readable file which enables the automatic conversion between quantitative values expressed using UN/CEFACT common codes. [https://ref.gs1.org/tools/UnitConverterUNECERec20]"@en ;
                                rdfs:isDefinedBy <https://ref.gs1.org/epcis/> ;
                                rdfs:label "uom" ;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://schema.org/email
<https://schema.org/email> rdf:type owl:DatatypeProperty ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Links an Actor to its email address."@en ;
                           rdfs:isDefinedBy <https://schema.org/email> ;
