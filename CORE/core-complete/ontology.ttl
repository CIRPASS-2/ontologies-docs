                                           <http://www.w3.org/2004/02/skos/core#altLabel> "EF 3.1"@en ;
                                           <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology extension" .


###  https://w3id.org/eudpp#methodology_EN15804InventoryRules
<https://w3id.org/eudpp#methodology_EN15804InventoryRules> rdf:type owl:NamedIndividual ,
                                                                    <https://w3id.org/eudpp#LCAMethodology> ;
                                                           <https://w3id.org/eudpp#methodologyVersion> "A2:2019" ;
                                                           rdfs:comment "Inventory calculation rules defined by EN 15804+A2 itself for the 18 resource-use / waste / output-flow inventory indicators (PERE, PERM, ... EEE, EET). This \"methodology\" is inventory-level rather than characterised; it is distinguished here from EF 3.1 because the inventory indicators do not use EF characterisation factors."@en ;
                                                           rdfs:label "EN 15804+A2 inventory calculation rules"@en ;
                                                           <http://www.w3.org/2004/02/skos/core#altLabel> "EN 15804+A2 inventory"@en ;
                                                           <https://w3id.org/eudpp#sourceVocabulary> "LCA ontology extension" .


