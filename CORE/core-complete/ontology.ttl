                                 owl:inverseOf <https://w3id.org/eudpp#isRoleOf> ;
                                 rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                 rdfs:range <https://w3id.org/eudpp#Role> ;
                                 rdfs:comment "Links an actor role assignment to a role."@en ;
                                 rdfs:label "has role"@en .


###  https://w3id.org/eudpp#hasSafeUseInstruction
<https://w3id.org/eudpp#hasSafeUseInstruction> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                               rdfs:range <https://w3id.org/eudpp#SubstanceManagementInstruction> ;
                                               <http://purl.org/dc/terms/references> "ESPR Article 7(5)(d)."@en ;
                                               <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                               rdfs:comment "Links a substance presence to relevant instructions for the safe use of the product."@en ;
                                               rdfs:isDefinedBy :SOC ;
                                               rdfs:label "Has safe-use instruction"@en ;
                                               <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


