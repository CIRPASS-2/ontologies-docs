    "@value" : "(Optional when action is OBSERVE, required otherwise) The identifier of the parent of the aggregation or association. When the parent identifier is an EPC, this field SHALL contain the 'pure identity' URI for the EPC as specified in the GS1 Tag Data Standard"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
