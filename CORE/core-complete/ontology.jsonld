  } ]
}, {
  "@id" : "https://ref.gs1.org/epcis/eventTimeZoneOffset",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "https://ref.gs1.org/epcis/EPCISEvent"
  } ],
  "http://schema.org/rangeIncludes" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The time zone offset in effect at the time and place the event occurred, expressed as an offset from UTC. The value of this field SHALL be a string consisting of the character '+' or the character '-', followed by two digits whose value is within the range 00 through 14 (inclusive), followed by a colon character ':', followed by two digits whose value is within the range 00 through 59 (inclusive), except that if the value of the first two digits is 14, the value of the second two digits must be 00. For example, the value +05:30 specifies that where the event occurred, local time was five hours and 30 minutes later than UTC (that is, midnight UTC was 5:30am local time)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://ref.gs1.org/epcis/EPCISEvent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://ref.gs1.org/epcis/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "eventTimeZoneOffset"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status" : [ {
    "@value" : "stable"
  } ]
