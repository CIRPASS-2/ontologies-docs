  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Land use of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Land use"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
