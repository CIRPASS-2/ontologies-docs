    "@language" : "en",
    "@value" : "has product event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/eudpp#ProductEvent"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/eudpp#isRepresentedByCarrier"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#hasProductGroup",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (4)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Product group\nmeans a set of products that serve similar purposes and are similar in terms of use, or have similar\nfunctional properties, and are similar in terms of consumer perception (ESPR Art 2 (4)). The product\ngroup or groups covered are given by delegated acts. (ESPR Art 8 (a))\n\nThis will be probably a classification code from some product classification scheme ."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#Product"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has product group"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/eudpp#ClassificationCode"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#hasProperty",
