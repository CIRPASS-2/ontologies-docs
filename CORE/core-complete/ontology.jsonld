}, {
  "@id" : "https://w3id.org/eudpp#LEI",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#ActorIdentifierScheme"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A Legal Entity Identifier (LEI) is a globally unique 20-character alphanumeric code that identifies legally distinct entities participating in financial transactions, as defined by ISO 17442.\n\nA 20‑character code used globally for financial and regulatory reporting.\nRequired for companies involved in financial transactions.\nUsed by regulators, banks, customs, and some trade systems."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "LEI"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.iso.org/standard/78829.html"
  } ],
  "https://w3id.org/eudpp#identifierExampleValue" : [ {
    "@value" : "529900T8BM49AURSDO55"
  } ],
  "https://w3id.org/eudpp#identifierMaxLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "20"
  } ],
  "https://w3id.org/eudpp#identifierMinLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "20"
  } ],
  "https://w3id.org/eudpp#identifierSchemeIssuer" : [ {
    "@value" : "ISO"
  } ]
