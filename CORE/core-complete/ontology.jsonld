  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Product parameters: design for recycling, ease and quality of recycling as expressed through use of easily recyclable materials [ESPR Art 5 (1n), Annex I d)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#MaterialOfComposition"
