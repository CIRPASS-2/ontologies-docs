}, {
  "@id" : "https://w3id.org/eudpp#CarbonFootprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (25)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Carbon footprint\nmeans the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category\nof climate change. (ESPR Art 2 25))\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Carbon footprint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#EnvironmentalFootprint"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#CircularEconomyIndicator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Circular Economy indicators are measures for relevant monitoring the transition to a circular economy and to measure the effects of new policy and trends.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Circular Economy Indicator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://environment.ec.europa.eu/strategy/circular-economy-action-plan_en"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#QuantitativeProperty"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#CircularEconomyRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Parent class for roles related to circular economy, such as remanufacturer, refurbisher, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Circular economy role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ClassificationCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A classification code from some product classification scheme ."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ClassificationCode"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#CommonSpecification",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 42, https://eur-lex.europa.eu/eli/reg/2024/1781/oj#art_42"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Common specification means ecodesign requirements, essential requirements for digital product passports or test, measurement or calculation methods established by implementing acts adopted by the Commission for products covered by delegated acts pursuant to ESPR Article 4."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Common Specification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#TechnicalSpecification"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Concentration",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 7(5)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The concentration of the substances of concern, at the level of the product, its relevant components, or spare parts ESPR Art 7(5)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Concentration of the substance of concern"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 7(5)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The concentration of the substances of concern, at the level of the product, its relevant components, or spare parts ESPR Art 7(5)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Concentration of the substance of concern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#QuantitativeProperty"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ConformityAssessmentModule",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Decision No 768/2008/EC Art 4, https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4"
  }, {
    "@language" : "en",
    "@value" : "ESPR Art 43, https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Conformity Assessment module means the possible conformity assessment elements that can be chosen, in accordance with certain criteria, to fullfill the conformity accessement required to be performed by Community harmonisation legislation in respect of a particular product."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@value" : "https://w3id.org/eudpp/COMP"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Conformity Assessment Module"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ConformityAssessmentRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (51)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Conformity assessment means the process demonstrating whether the ecodesign requirements set out in the relevant delegated acts adopted pursuant to Article 4 have been fulfilled; [ESPR Art 2 (51)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Conformity assessment role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ConformityCertificate",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4, https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001"
  }, {
    "@language" : "en",
    "@value" : "ESPR Annex III (e)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Conformity assessment certificate for a certification. The blue guide uses the term \"cerficate of conformity\". The ESPR uses \"conformity certificate\" as well as \"certificate\" and \"approval decision\"."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@value" : "https://w3id.org/eudpp/COMP"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Conformity Certificate"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#CorrectDPPDataAction",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#DPPActionType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Indicates that erroneous, inconsistent, or incomplete information in the Digital Product Passport is corrected."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "correct data"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DPP",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (28)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Digital Product Passport (DPP) means a set of data specific to a product that includes the information specified in the applicable\ndelegated act adopted pursuant to Article 4 and that is accessible via electronic means through a data carrier in accordance with Chapter III. (ESPR Art 2 (28))"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/P_DPP"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Digital Product Passport (DPP)"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DPPActionType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A classification indicating the type of information-level action performed during a DPP update event."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DPP Action Type"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid47"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DPPArchivalEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An event corresponding to the archival or end-of-active-life management of a Digital Product Passport."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DPP Archival Event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#DPPEvent"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DPPCreationEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An event corresponding to the creation or initial issuance of a Digital Product Passport."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DPP Creation Event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#DPPEvent"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DPPEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An ESPR-level event concept representing an event that affects the existence, content, accessibility, update, correction, or governance of a DPP. A DPPEvent captures the passport-facing semantics of the occurrence and is modelled as distinct from the product event that may trigger it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DPP Event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ESPREvent"
  }, {
    "@id" : "_:genid52"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/eudpp#DPPEventRecord"
  }, {
    "@id" : "https://w3id.org/eudpp#ProductEvent"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DPPEventRecord",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Defined in the EU DPP Core Ontology Event module to support the technical recording of DPP-related events."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A technical audit record used to represent and log an information-level event affecting a Digital Product Passport. Unlike EPCIS carriers, this class is intended for recording DPP-side information events rather than product-facing operational events."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DPP Event Record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid53"
  }, {
    "@id" : "_:genid54"
  }, {
    "@id" : "_:genid55"
  }, {
    "@id" : "_:genid56"
  }, {
    "@id" : "_:genid57"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DPPIdentifier",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A type of identifier to identify DPP. DPP Identifier."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@value" : "https://w3id.org/eudpp/IDENT"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DPP identifier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Identifier"
  }, {
    "@id" : "_:genid58"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/eudpp#FacilityIdentifier"
  }, {
    "@id" : "https://w3id.org/eudpp#MaterialIdentifier"
  }, {
    "@id" : "https://w3id.org/eudpp#ProductIdentifier"
  }, {
    "@id" : "https://w3id.org/eudpp#SoCIdentifier"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DPPUpdateEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An event corresponding to an update of the content of a Digital Product Passport."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DPP Update Event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#DPPEvent"
  }, {
    "@id" : "_:genid59"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DeleteDPPDataAction",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#DPPActionType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Indicates that information is removed from the Digital Product Passport."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "delete data"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DestructionEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2024/1781; Art 2(34); Art 25(1)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The intentional damaging or discarding of a product and unsold products as waste, with the exception of discarding for the sole purpose of delivering the discarded product for preparing for reuse, including refurbishment or remanufacturing operations. ESPR Art 2(34) and Art 25(1)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Destruction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ProductEvent"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DigitalInstruction",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 27(7)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Digital instructions\nmean instructions in digital format concerning the product (‘digital instructions’) in a language that can be easily understood. ESPR Art 27(7)\nDigital instructions are ensured by manufacturers. These should also ensured by importers. (ESPR Art 29(4))\n\nThis class can be extended/specialised according to delegated acts or industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DigitalInstruction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#DocumentFormattedProperty"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#DocumentFormattedProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The document class describes the semantic representation of any instance of a document that might be required to be included into a digital product passport instance."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/P_DPP"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Document"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Property"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Durability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (22)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Durability\nmeans the ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair. (ESPR Art 2 (22))\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#QualityIndicator"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EORI",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Economic Operators Registration and Identification (EU).\nThis is the EU’s official identifier for companies involved in import/export.\nMandatory for any company trading with the EU.\n\nUsed in customs declarations\nUnique per company\n\nFormat: country code + number (e.g., DE123456789)\n\nThis is the most widely used identifier for economic operators in EU trade."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EORI"
  }, {
    "@value" : "https://taxation-customs.ec.europa.eu/customs/customs-procedures-import-and-export/customs-operations/economic-operators-registration-and-identification-number-eori_en"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Economic Operators Registration and Identification (EU"
  } ],
  "https://w3id.org/eudpp#identifierExampleValue" : [ {
    "@value" : "DE123456789012345"
  } ],
  "https://w3id.org/eudpp#identifierMaxLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "17"
  } ],
  "https://w3id.org/eudpp#identifierMinLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "8"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ESPREvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2024/1781; lifecycle-event-oriented abstraction introduced for modelling purposes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Abstract superclass introduced for modelling purposes. Used to represent the regulatory or business semantics of an event relevant in the ESPR context and concerning either a product or its DPP, independently of its technical journalisation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@value" : "https://w3id.org/eudpp/EVENT"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ESPR Event"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EUDeclarationOfConformity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Decision No 768/2008/EC Annex I Art R10, https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I"
  }, {
    "@language" : "en",
    "@value" : "ESPR Art 44, https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The EU Declaration of Conformity shall state that the fulfilment of the ecodesign requirements specified in the applicable delegated acts adopted pursuant to ESPR Article 4 has been demonstrated or that a presumption of conformity applies in accordance with ESPR Article 41."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@value" : "https://w3id.org/eudpp/COMP"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EU Declaration of Conformity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://w3id.org/eudpp#DocumentFormattedProperty"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EconomicOperatorRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (46)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Economic operator means the manufacturer, the authorised representative, the importer, the distributor, the dealer and the fulfilment service provider; [ESPR Art 2 (46)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Economic operator role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EmissionToAir",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Annex I"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Product parameters are listed in the ESPR Annex I :\n\n(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Emission to air"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#EnvironmentalEmission"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EmissionToSoil",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Annex I"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Product parameters are listed in the ESPR Annex I :\n\n(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Emission to soil"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#EnvironmentalEmission"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EmissionToWater",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Annex I"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Product parameters are listed in the ESPR Annex I :\n\n(q) emissions to air, water or soil released in one or more lifecycle stages of the product as expressed through quantities and nature of emissions, including noise.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Emission to water"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#EnvironmentalEmission"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EndUserRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Parent class for roles of end users, such as consumer, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "End user role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EnergyConsumption",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Energy consumption of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Energy consumption"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ResourceConsumption"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EnvironmentalEmission",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Emission is the act or amount of sending out gas, heat, light, etc. It can also refer to harmful substances that are released into the environment, especially carbon dioxide.\n\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Environmental emission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://dictionary.cambridge.org/dictionary/english/emission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#EnvironmentalPollution"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EnvironmentalFootprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (24)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Environmental footprint\nmeans a quantification of the environmental impacts resulting from a product throughout its life\ncycle, whether in relation to a single environmental impact category or an aggregated set of impact\ncategories based on the Product Environmental Footprint method established by Recommendation\n(EU) 2 021/2279 or other scientific methods developed by international organisations, widely tested\nin collaboration with different industry sectors and adopted or implemented by the Commission in\nother Union law. (ESPR Art 2 (24)).\n\nProduct parameters list ESPR Annex I\n(m) The environmental footprint of the product, expressed as a quantification;\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Environmental footprint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#QuantitativeProperty"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EnvironmentalPollution",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Environmental pollution is the addition of any substance or form of energy to the environment at a rate faster than it can be dispersed or safely stored.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Environmental pollution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://www.britannica.com/science/pollution-environment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#QuantitativeProperty"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EuropeanCommission",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://ec.europa.eu/eurostat/statistics-explained/index.php?title=Glossary:European_Commission_(EC)"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#LegalPerson"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The European Commission, abbreviated as EC, is the executive branch of the European Union."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "European Commission"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Facility",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://marketbusinessnews.com/financial-glossary/facility/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A Facility may be a place where specific activities occur. A production/manufacturing facility means a factory. The term may refer to any place that makes things, or plants that generate electricity."
  }, {
    "@language" : "en",
    "@value" : "Business facilities are structures that provide services to a business. This can include space for employees, technology, equipment and inventory. Facilities can be used for business administration, operations or to provide services to customers."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/ACTOR"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Facility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid60"
  }, {
    "@id" : "_:genid61"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#FacilityIdentifier",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A unique code assigned to a physical site (factory, warehouse, plant, school, hospital, etc.), i.e., identifies a location."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/IDENT"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Facility identifier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Identifier"
  }, {
    "@id" : "_:genid62"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/eudpp#MaterialIdentifier"
  }, {
    "@id" : "https://w3id.org/eudpp#ProductIdentifier"
  }, {
    "@id" : "https://w3id.org/eudpp#SoCIdentifier"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#GLN",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#ActorIdentifierScheme"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A globally unique identifier defined by GS1 used to identify legal entities, functional entities, and physical locations within business and supply chain processes.\n\nTypically identifies: legal entities, functional entities (departments), physical locations (warehouses, sites)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "GLN"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.gs1.org/standards/id-keys/gln"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Global Location Number"
  } ],
  "https://w3id.org/eudpp#identifierExampleValue" : [ {
    "@value" : "9501101530003"
  } ],
  "https://w3id.org/eudpp#identifierMaxLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "13"
  } ],
  "https://w3id.org/eudpp#identifierMinLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "13"
  } ],
  "https://w3id.org/eudpp#identifierSchemeIssuer" : [ {
    "@value" : "GS1"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#GTIN",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#ProductIdentifierScheme"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A globally unique identifier for trade items, defined by GS1, used to identify products at various packaging levels."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "GTIN"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://www.gs1.org/standards/id-keys/gtin"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Global Trade Item Number"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A globally unique identifier for trade items, defined by GS1, used to identify products at various packaging levels."
  } ],
  "https://w3id.org/eudpp#identifierExampleValue" : [ {
    "@value" : "14006381333938"
  } ],
  "https://w3id.org/eudpp#identifierMaxLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "14"
  } ],
  "https://w3id.org/eudpp#identifierMinLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "8"
  } ],
  "https://w3id.org/eudpp#identifierSchemeIssuer" : [ {
    "@value" : "GS1"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#HarmonisedStandard",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) No 1025/2012 Art 2 (1c), https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Harmonised Standard means a European standard adopted on the basis of a request made by the Commission for the application of Union harmonisation legislation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Harmonised Standard"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ProductRequirement"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#HazardousWasteAmount",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Hazardous waste amount of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hazardous waste amount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#WasteGenerationAmount"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Height",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Height of the product"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Height"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ProductDimension"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Identifier",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Identifier. A general class to hold different kinds of identifiers described and used for EU DPP CO. Each sub-class of this class describes a different kind of identifier. Intentionally modelled as sub-classes. \nIdentifiers have value, and a scheme/standard they are based on.\n\nCardinatlity restrictions added to each subclass to enforce inheritance of the data propertyy identifierValue."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Identifier"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#IdentifierGranularity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The granularity of the identifier. For example, for Products this could be model, batch, item."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
