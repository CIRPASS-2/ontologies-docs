}, {
  "@id" : "https://w3id.org/eudpp#ProductEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An ESPR-level event concept representing an event that affects the state, condition, use, circulation, transformation, maintenance, or end-of-life status of a product. A ProductEvent captures the product-facing semantics of the occurrence and is distinct from any DPP-side event that may be triggered to record or reflect it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Product Event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ESPREvent"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ProductIdentifier",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A type of identifier to identify Products. A unique code assigned to identify a product. e.g., GTIN."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@value" : "https://w3id.org/eudpp/IDENT"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Product identifier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Identifier"
  }, {
    "@id" : "_:genid69"
  }, {
    "@id" : "_:genid70"
  }, {
    "@id" : "_:genid71"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/eudpp#SoCIdentifier"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ProductIdentifierGranularity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The granularity level (batch, item, model) at which the product identifier represents the product."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Product identifier granularity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#IdentifierGranularity"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid72"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ProductIdentifierScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A kind of identifier scheme. The scheme or standard used to identify Products, e.g., GTIN, SKU, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Product identifier scheme"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#IdentifierScheme"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ProductRequirement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Product requirements means a requirement to be fullfilled by a product when placed on the market."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Product Requirement"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ProductToPackagingRatio",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Annex I"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "ESPR Annex I, the list of product parameters includes the parameter called the  product to packaging ratio.\n\nHowever, it is not specified in ESPR  whether that ratio is defined on the basis of weight or on the basis of volume.\n\n**This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards.**"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Product to packaging ratio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#QuantitativeProperty"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Property",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A property of the product."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Property"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#PuttingIntoServiceEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2024/1781; Art 2(41)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The first use of a product for its intended purpose in the Union. ESPR Art 2(41)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Putting into Service"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ProductEvent"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#QualityIndicator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Product characteristics like durability and reliability.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Quality indicator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#QuantitativeProperty"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#QuantitativeProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A property (respectively measurand of a property) of the product (model) that is expressed by a quantity value. A specific quantity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Quantitative Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Property"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#RecoverableRate",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Recoverable rate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#CircularEconomyIndicator"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#RecycledMaterialsUse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Recycled materials use of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Recycled materials use"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ResourceConsumption"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#RecyclingCollectionRate",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Recycling collection rate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#CircularEconomyIndicator"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#RecyclingRate",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Recycling rate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#CircularEconomyIndicator"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#RefurbishmentEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2024/1781; Art 2(18)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Actions carried out to prepare, clean, test, service and, where necessary, repair a product or a discarded product in order to restore its performance or functionality within the intended use and range of performance originally conceived at the design stage at the time of the placing of the product on the market. ESPR Art 2(18)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Refurbishment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ProductEvent"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Reliability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (16)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Reliability\nmeans the probability that a product functions as required under given conditions for a given\nduration without an occurrence which results in a primary or secondary function of the product no\nlonger being performed. (ESPR Art 2 (16))\n\nReliability is usually expressed in terms of mean time between failures (MTBF), which is the average length of time that a device will operate without failure.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Reliability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#QualityIndicator"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#RemanufacturingEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2024/1781; Art 2(16)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Actions through which a new product is produced from objects that are waste, products or components and through which at least one change is made that substantially affects the safety, performance, purpose or type of the product. ESPR Art 2(16)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Remanufacturing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ProductEvent"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#RepairEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2024/1781; Art 2(20)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Actions taken to return a defective product or waste to a condition where it fulfils its intended purpose. ESPR Art 2(20)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Repair"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ProductEvent"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ResourceConsumption",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Resource consumption of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Resource consumption"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#QuantitativeProperty"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Role",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "CIRPASS-2 User Stories 3.1"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://zenodo.org/records/17979585"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Role means a set of tasks typically performed by one actor. (e.g. Responsible Economic Operator, Independent operator); [CIRPASS-2 User Stories 3.1]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#SKU",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#ProductIdentifierScheme"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A Stock Keeping Unit (SKU) is an internal identifier assigned by an organization to uniquely identify and track a product, item, or variant within its own inventory and management systems."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "SKU"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "https://en.wikipedia.org/wiki/Stock_keeping_unit"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Stock Keeping Unit"
  } ],
  "https://w3id.org/eudpp#identifierExampleValue" : [ {
    "@value" : "ABC-RED-XL"
  } ],
  "https://w3id.org/eudpp#identifierMaxLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "50"
  } ],
  "https://w3id.org/eudpp#identifierMinLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#SoCIdentifier",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A type of identifier to identify substances of concern."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Substance of concern identifier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Identifier"
  }, {
    "@id" : "_:genid76"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Substance",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2"
  }, {
    "@language" : "en",
    "@value" : "Regulation (EC) No 1907/2006"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "http://data.europa.eu/eli/reg/2006/1907/oj"
  }, {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Means a chemical element and its compounds in the natural state or obtained by any manufacturing process, including any additive necessary to preserve its stability and any impurity deriving from the process used, but excluding any solvent which may be separated without affecting the stability of the substance or changing its composition; ESPR Art 2, Regulation (EC) No 1907/2006"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Substance"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#SubstanceOfConcern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2(10)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "means a substance that:(a) meets the criteria laid down in Article 57 of Regulation (EC) No 1907/2006 and is identified in accordance with Article 59(1) of that Regulation; (b) is classified in Part 3 of Annex VI to Regulation (EC) No 1272/2008 in one of the following hazard classes or hazard categories: (i) carcinogenicity categories 1 and 2; (ii) germ cell mutagenicity categories 1 and 2; (iii) reproductive toxicity categories 1 and 2; (iv) endocrine disruption for human health categories 1 and 2; (v) endocrine disruption for the environment categories 1 and 2; (vi) persistent, mobile and toxic or very persistent, very mobile properties; (vii) persistent, bioaccumulative and toxic or very persistent, very bioaccumulative properties; (viii) respiratory sensitisation category 1; (ix) skin sensitisation category 1; (x) hazardous to the aquatic environment — categories chronic 1 to 4; (xi) hazardous to the ozone layer; (xii) specific target organ toxicity — repeated exposure categories 1 and 2; (xiii) specific target organ toxicity — single exposure categories 1 and 2; (c) is regulated under Regulation (EU) 2019/1021; or (d) negatively affects the reuse and recycling of materials in the product in which it is present [ESPR Art 2(10)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/SOC"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Substance of concern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Substance"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#SustainableRenewableMaterialsUse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Sustainable renewable materials use of the product.\n\nThis class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Sustainable renewable materials use"
  } ],
