  } ]
}, {
  "@id" : "https://w3id.org/eudpp#hasNotifiedBody",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://purl.org/dc/terms/references" : [ {
    "@value" : "Decision No 768/2008/EC Annex I Chapter R4"
  }, {
    "@value" : "ESPR Chapter IX"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I"
  }, {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#cpt_IX"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Specifies the conformity assessment body notified in accordance with ESPR Chapter IX\t\n\nEUDeclarationOfConformity is modelled in the EU DPP CO COMP module.\nActor is modelled in the EU DPP CO ACTOR module."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#EUDeclarationOfConformity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has notified body"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#hasProductEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links an EPCIS-inspired technical event carrier to the product event semantics it journalises."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://ref.gs1.org/epcis/EPCISEvent"
  } ],
