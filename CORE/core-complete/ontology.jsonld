  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Technical specification means a document that prescribes technical requirements to be fulfilled by a product, process, service or system and which lays down one or more of the following: Common Specification or Other Technical Specification."
