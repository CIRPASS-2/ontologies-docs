xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp#hasMaterialOrigin
<https://w3id.org/eudpp#hasMaterialOrigin> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                           rdfs:range <https://w3id.org/eudpp#MaterialOrigin> ;
                                           rdfs:comment "Assigns material origin to material used for product"@en ;
                                           rdfs:label "has material origin"@en .


###  https://w3id.org/eudpp#hasMaterialType
<https://w3id.org/eudpp#hasMaterialType> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                         rdfs:range <https://w3id.org/eudpp#MaterialType> ;
                                         rdfs:comment "Links material to its type in some classification system used by the sector."@en ;
                                         rdfs:label "has material type"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/eudpp#isCriticalRawMaterial
<https://w3id.org/eudpp#isCriticalRawMaterial> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                               rdfs:range xsd:boolean ;
                                               <http://purl.org/dc/terms/references> "[ESPR Annex I h)]"@en ;
                                               <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                               rdfs:comment "Product parameters: use or content of recycled materials and recovery of materials, including critical raw materials; [ESPR Annex I h)]"@en ;
                                               rdfs:label "critical raw material"@en .


###  https://w3id.org/eudpp#materialComponent
<https://w3id.org/eudpp#materialComponent> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                           rdfs:range xsd:string ;
                                           rdfs:comment """The specific part of the Product this material belongs to. Description. 
For example, in case of a textile product: [Main, Lining, Filling]."""@en ;
                                           rdfs:label "part of product material is in"@en .


###  https://w3id.org/eudpp#materialIsRecyclable
<https://w3id.org/eudpp#materialIsRecyclable> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                              rdfs:range xsd:boolean ;
                                              <http://purl.org/dc/terms/references> "ESPR Art 5 (1n), Annex I d)"@en ;
                                              <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                              rdfs:comment "Product parameters: design for recycling, ease and quality of recycling as expressed through use of easily recyclable materials [ESPR Art 5 (1n), Annex I d)]"@en ;
                                              rdfs:label "recyclable material"@en .


###  https://w3id.org/eudpp#materialIsSustainableRenewable
<https://w3id.org/eudpp#materialIsSustainableRenewable> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                                        rdfs:range xsd:boolean ;
                                                        <http://purl.org/dc/terms/references> "ESPR Annex I i)"@en ;
                                                        <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                        rdfs:comment "Product parameters: use or content of sustainable renewable materials; [ESPR Annex I i)]"@en ;
                                                        rdfs:label "sustainale or renewable material"@en .


###  https://w3id.org/eudpp#materialPercentage
<https://w3id.org/eudpp#materialPercentage> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                            rdfs:range xsd:decimal ;
                                            rdfs:comment "Material percentage in a Product, e.g., mass fraction (percentage by weight)."@en ;
                                            rdfs:label "material percentage"@en .


###  https://w3id.org/eudpp#materialRecycledContent
<https://w3id.org/eudpp#materialRecycledContent> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                                 rdfs:range xsd:decimal ;
                                                 rdfs:comment "Percentage of recycled content"@en ;
                                                 rdfs:label "recycled content amount in material"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/eudpp#MaterialOfComposition
<https://w3id.org/eudpp#MaterialOfComposition> rdf:type owl:Class ;
                                               rdfs:comment "Material the product (or component) is made of [ESPR Annex I]. Material as an element of composition."@en ;
                                               rdfs:label "Material of composition"@en .


###  https://w3id.org/eudpp#MaterialOrigin
<https://w3id.org/eudpp#MaterialOrigin> rdf:type owl:Class ;
                                        owl:equivalentClass [ rdf:type owl:Class ;
                                                              owl:oneOf ( <https://w3id.org/eudpp#raw>
                                                                          <https://w3id.org/eudpp#recycled>
                                                                          <https://w3id.org/eudpp#renewable>
                                                                        )
                                                            ] ;
                                        <http://purl.org/dc/terms/references> "[ESPR Annex I]"@en ;
                                        <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                        rdfs:comment "Origin of the material used in product [ESPR Annex I]"@en ;
                                        rdfs:label "Origin of material"@en .


###  https://w3id.org/eudpp#MaterialType
<https://w3id.org/eudpp#MaterialType> rdf:type owl:Class ;
                                      rdfs:comment """Placeholder class for material type classification applicable in a sector or mandated by a delegated act (DA).

Potential types could be, on the example of textile sector: cotton, nylon, ..."""@en ;
                                      rdfs:label "Material type"@en .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/eudpp#raw
<https://w3id.org/eudpp#raw> rdf:type owl:NamedIndividual ,
                                      <https://w3id.org/eudpp#MaterialOrigin> ;
                             rdfs:comment "Raw material" ;
                             rdfs:label "raw material"@en .


###  https://w3id.org/eudpp#recycled
<https://w3id.org/eudpp#recycled> rdf:type owl:NamedIndividual ,
                                           <https://w3id.org/eudpp#MaterialOrigin> ;
                                  rdfs:comment "Recycled material" ;
                                  rdfs:label "recycled material"@en .


###  https://w3id.org/eudpp#renewable
<https://w3id.org/eudpp#renewable> rdf:type owl:NamedIndividual ,
                                            <https://w3id.org/eudpp#MaterialOrigin> ;
                                   rdfs:comment "Renewable material" ;
                                   rdfs:label "renewable material"@en .


