    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#hasMaterialOrigin -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMaterialOrigin">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#MaterialOrigin"/>
        <rdfs:comment xml:lang="en">Assigns material origin to material used for product</rdfs:comment>
        <rdfs:label xml:lang="en">has material origin</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasMaterialType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMaterialType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#MaterialType"/>
        <rdfs:comment xml:lang="en">Links material to its type in some classification system used by the sector.</rdfs:comment>
        <rdfs:label xml:lang="en">has material type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#isCriticalRawMaterial -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#isCriticalRawMaterial">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:references xml:lang="en">[ESPR Annex I h)]</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters: use or content of recycled materials and recovery of materials, including critical raw materials; [ESPR Annex I h)]</rdfs:comment>
        <rdfs:label xml:lang="en">critical raw material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialComponent -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialComponent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The specific part of the Product this material belongs to. Description. 
For example, in case of a textile product: [Main, Lining, Filling].</rdfs:comment>
        <rdfs:label xml:lang="en">part of product material is in</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialIsRecyclable -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialIsRecyclable">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:references xml:lang="en">ESPR Art 5 (1n), Annex I d)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters: design for recycling, ease and quality of recycling as expressed through use of easily recyclable materials [ESPR Art 5 (1n), Annex I d)]</rdfs:comment>
        <rdfs:label xml:lang="en">recyclable material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialIsSustainableRenewable -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialIsSustainableRenewable">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:references xml:lang="en">ESPR Annex I i)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Product parameters: use or content of sustainable renewable materials; [ESPR Annex I i)]</rdfs:comment>
        <rdfs:label xml:lang="en">sustainale or renewable material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialPercentage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialPercentage">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Material percentage in a Product, e.g., mass fraction (percentage by weight).</rdfs:comment>
        <rdfs:label xml:lang="en">material percentage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#materialRecycledContent -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#materialRecycledContent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Percentage of recycled content</rdfs:comment>
        <rdfs:label xml:lang="en">recycled content amount in material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#MaterialOfComposition -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialOfComposition">
        <rdfs:comment xml:lang="en">Material the product (or component) is made of [ESPR Annex I]. Material as an element of composition.</rdfs:comment>
        <rdfs:label xml:lang="en">Material of composition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialOrigin -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialOrigin">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#raw"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#recycled"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#renewable"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <terms:references xml:lang="en">[ESPR Annex I]</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Origin of the material used in product [ESPR Annex I]</rdfs:comment>
        <rdfs:label xml:lang="en">Origin of material</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialType -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialType">
        <rdfs:comment xml:lang="en">Placeholder class for material type classification applicable in a sector or mandated by a delegated act (DA).

Potential types could be, on the example of textile sector: cotton, nylon, ...</rdfs:comment>
        <rdfs:label xml:lang="en">Material type</rdfs:label>
    </owl:Class>
    


