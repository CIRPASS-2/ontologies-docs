    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#raw -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#raw">
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialOrigin"/>
        <rdfs:comment>Raw material</rdfs:comment>
        <rdfs:label xml:lang="en">raw material</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#recycled -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#recycled">
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialOrigin"/>
        <rdfs:comment>Recycled material</rdfs:comment>
        <rdfs:label xml:lang="en">recycled material</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#renewable -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#renewable">
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialOrigin"/>
        <rdfs:comment>Renewable material</rdfs:comment>
        <rdfs:label xml:lang="en">renewable material</rdfs:label>
    </owl:NamedIndividual>
</rdf:RDF>



