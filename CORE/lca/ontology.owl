    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2002/07/owl#priorVersion -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#priorVersion"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broadMatch -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch"/>
    


    <!-- https://w3id.org/eudpp#sourceVocabulary -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp#sourceVocabulary">
        <rdfs:comment xml:lang="en">Provenance annotation identifying the vocabulary, standard, or ontology from which a class, property, or named individual of this ontology aligns with. 
Possible values: &quot;LCA ontology&quot; (introduced by this ontology, no direct external counterpart), &quot;ILCD base&quot; (corresponds to the ILCD base data format), &quot;ILCD+EPD extension&quot; (corresponds to the ILCD+EPD v1.3 extension, InData epd/epd2/epd24 namespaces), &quot;Dublin Core&quot; (aligned with dcterms), &quot;PROV-O&quot; (aligned with W3C Provenance Ontology), &quot;SKOS&quot; (aligned with W3C Simple Knowledge Organization System), &quot;FOAF&quot; (aligned with Friend of a Friend vocabulary), &quot;LCAnet&quot; (aligned with the LCAnet ontology).</rdfs:comment>
        <rdfs:label xml:lang="en">source vocabulary</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp#unitAsString -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp#unitAsString">
        <rdfs:comment xml:lang="en">Human-readable label of the unit in which the associated EN 15804 indicator value is expressed, e.g. &quot;kg CO2-eq&quot;, &quot;MJ, net calorific value&quot;, &quot;m3&quot;. Annotation property (not for automated unit arithmetic).</rdfs:comment>
        <rdfs:label xml:lang="en">unit as string</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/LCA#assessesImpactCategory -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/LCA#assessesImpactCategory"/>
    


    <!-- https://w3id.org/eudpp/LCA#relatesToLCAIndicator -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/LCA#relatesToLCAIndicator"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#addressesAoP -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#addressesAoP">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:comment xml:lang="en">Link between an LCIAImpactCategory and the Area(s)-of-protection it addresses.
1..n cardinality: a single impact category can address several Areas of Protection — for example, ozone depletion affects both Natural Environment and Human Health.</rdfs:comment>
        <rdfs:label xml:lang="en">addresses AoP</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#assessesImpactCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#assessesImpactCategory">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCIAImpactIndicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <rdfs:comment xml:lang="en">Link from an LCIA impact indicator to the mid-point impact category it characterises. Multiple indicators may assess the same category (e.g. Eutrophication, freshwater and Eutrophication, marine both relate to Eutrophication). This property expresses a conceptual classification link, not equivalence.</rdfs:comment>
        <rdfs:label xml:lang="en">assesses impact category</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element assessIC (https://w3id.org/lcanet/ia#assessIC) in the IA module.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#belongsToEn15804Group -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#belongsToEn15804Group">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EN15804Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#EN15804IndicatorGroup"/>
        <rdfs:comment xml:lang="en">Link from an EN15804Indicator individual to the indicator EN15804IndicatorGroup it belongs to (core impact, with-caveats, resource use, waste, valorisation, exported energy).</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to EN 15804 indicator group</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#belongsToMethodology -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#belongsToMethodology">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <rdfs:comment xml:lang="en">Link from a Method to one or several LCAMethodology individuals it belongs to (e.g. eudpp:methodology_EF3_1). Cardinality 1..n: a single method can be classified into more than one methodology (for example, when two methodologies share the same characterisation factors for one indicator).</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to methodology</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary>LCAnet: relates to the element includedInMethodology (https://w3id.org/lcanet/ia#includedInMethodology) in the IA module.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#computedByMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#computedByMethod">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:comment xml:lang="en">Link from an LCAIndicator individual to the IndicatorMethod instance that describes how this indicator is computed — its impact model, impact category, methodology reference, reference report, and ILCD method metadata. 
Cardinality: at most 1 per indicator individual.&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">computed by method</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#declaresManufacturerRecord -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#declaresManufacturerRecord">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ManufacturerRecord"/>
        <rdfs:comment xml:lang="en">Links an LCA study to a manufacturer record documenting the manufacturers whose data is included in the study.</rdfs:comment>
        <rdfs:label xml:lang="en">declares Manufacturer Record</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element epd24:manufacturers/epd24:manufacturer</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#followsPCR -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#followsPCR">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EPDStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#PCR"/>
        <rdfs:comment xml:lang="en">Link from an EPDStudy to the Product Category Rules document(s) it follows (1..n).</rdfs:comment>
        <rdfs:label xml:lang="en">follows PCR</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element referenceToPCR.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#followsPEFCR -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#followsPEFCR">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#PEFCR"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy to a Product Environmental Footprint Category Rules document (1..n).</rdfs:comment>
        <rdfs:label xml:lang="en">follows PEFCR</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#forLifeCycleModule -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#forLifeCycleModule">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAModuleValue"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
        <rdfs:comment xml:lang="en">Link from an LCAModuleValue to the Life-cycle module it refers to.</rdfs:comment>
        <rdfs:label xml:lang="en">for life-cycle module</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the attribute @epd:module on epd:amount.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasComplianceDeclaration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasComplianceDeclaration">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ComplianceDeclaration"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy (or its subclass EPDStudy) to a ComplianceDeclaration. Compliance can be declared against any standard relevant to the study type (ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, PEFCR-specific rules, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">has compliance declaration</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element complianceDeclarations/compliance. Domain widened in v1.9.7 from EPDStudy to LCAStudy.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasExternalSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasExternalSource">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy to a background source. It can be a (a) documentation (e.g. an LCA project report, safety data sheet, or explanatory material) - covering the ILCD+EPD element referenceToExternalDocumentation on dataSetInformation, (b) databases or, (c)  literature sources used for modelling.</rdfs:comment>
        <rdfs:label xml:lang="en">has external source</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasImpactCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasImpactCategory">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <rdfs:comment xml:lang="en">Impact category addressed by the Method.</rdfs:comment>
        <rdfs:label xml:lang="en">has impact category</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element impactCategory on LCIAMethodDataSet.</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element hasImpactCategory (https://w3id.org/lcanet/ia#hasIC) in the IA module.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasImpactModel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasImpactModel">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ImpactModel"/>
        <rdfs:comment xml:lang="en">Link from an Method to its characterisation-model block (where applicable; inventory-only methods may not have one).</rdfs:comment>
        <rdfs:label xml:lang="en">has impact model</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element usesCM (https://w3id.org/lcanet/ia#usesCM) in the IA module.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasInventoryIndicatorResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasInventoryIndicatorResult">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasLCAResult"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">Sub-property of eudpp:hasLCAResult; range narrowed to eudpp:InventoryIndicatorResult.</rdfs:comment>
        <rdfs:label xml:lang="en">has inventory indicator result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element LCIAResults/LCIAResult when the indicator is an EN 15804+A2 inventory indicator (resource use, waste, output flows).</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasLCAResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasLCAResult">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy (or its subclass EPDStudy) to one of its LCA results. Range is the abstract eudpp:LCAResult; sub-properties eudpp:hasLCIAResult and eudpp:hasInventoryResult narrow the result to the corresponding sibling subclass. Querying for eudpp:hasLCAResult retrieves both kinds of results in one go.</rdfs:comment>
        <rdfs:label xml:lang="en">has LCA result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasLCIAResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasLCIAResult">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasLCAResult"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCIAResult"/>
        <rdfs:comment xml:lang="en">Sub-property of eudpp:hasLCAResult; range narrowed to eudpp:LCIAResult.</rdfs:comment>
        <rdfs:label xml:lang="en">has LCIA result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element LCIAResults/LCIAResult when the indicator is an EN 15804+A2 impact indicator.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasLicenseType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasLicenseType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LicenseType"/>
        <rdfs:comment xml:lang="en">License applicable to the LCA / EPD study.</rdfs:comment>
        <rdfs:label xml:lang="en">has license type</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element publicationAndOwnership/licenseType.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasPerModuleValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasPerModuleValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAModuleValue"/>
        <rdfs:comment xml:lang="en">Link from an LCAResult (LCIAResult or InventoryIndicatorResult) to one of its per-module (and optionally per-scenario) numerical values.</rdfs:comment>
        <rdfs:label xml:lang="en">has per module value</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element LCIAResult/other/epd:amount.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasReferenceToBackgroundDatabase -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasReferenceToBackgroundDatabase">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasExternalSource"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#BackgroundDatabase"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy to a background LCI database used for the modelling (1..n). Sub-property of eudpp:hasExternalSource.</rdfs:comment>
        <rdfs:label xml:lang="en">has reference to background database</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasReview -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasReview">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Review"/>
        <rdfs:comment xml:lang="en">Link from an LCAStudy to a critical-review / verification record.</rdfs:comment>
        <rdfs:label xml:lang="en">has review</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element validation/review.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasTypeOfReview -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasTypeOfReview">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Review"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#TypeOfReview"/>
        <rdfs:comment xml:lang="en">The kind of review performed (independent external, accredited third party, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">has type of review</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the attribute review/@type.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#includesMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#includesMethod">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:comment xml:lang="en">Link from a Method (a collection of methods sharing a methodology such as &quot;EF 3.1&quot;) to each of the individual-indicator method instances it aggregates.</rdfs:comment>
        <rdfs:label xml:lang="en">includes method</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element referenceToIncludedMethods.
ILCD+EPD LCIA Method Data Sets can represent either a single LCIA or inventory method (one indicator) or a methodology (a collection/list of methods); this property is used only in the latter case.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#quantifiesIndicator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#quantifiesIndicator">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
        <rdfs:comment xml:lang="en">Link from an LCAResult (LCIAResult or InventoryIndicatorResult) to the LCAIndicator individual that this result quantifies. 
This is the primary semantic identity of a result: a result is a quantification of an indicator, not of a method. 
Cardinality: exactly 1 per result instance.
Range: LCAIndicator (covers both EN15804Indicator individuals and non-EN-15804 indicators).</rdfs:comment>
        <rdfs:label xml:lang="en">quantifies indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToCompleteReviewReport -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToCompleteReviewReport">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Review"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ReviewReport"/>
        <rdfs:comment xml:lang="en">Link from a Review to the full review report.</rdfs:comment>
        <rdfs:label xml:lang="en">reference to complete review report</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element review/referenceToCompleteReviewReport.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToComplianceStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToComplianceStatus">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ComplianceDeclaration"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ComplianceStatus"/>
        <rdfs:comment xml:lang="en">Level of compliance declared by a ComplianceDeclaration (fully compliant, partially compliant, or not compliant).</rdfs:comment>
        <rdfs:label xml:lang="en">reference to compliance status</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToComplianceSystem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToComplianceSystem">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ComplianceDeclaration"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ComplianceSystem"/>
        <rdfs:comment xml:lang="en">Link from a ComplianceDeclaration to the standard or programme it references (EN 15804+A2, ISO 14025, ISO 21930, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">reference to compliance system</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element compliance/referenceToComplianceSystem.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToExternalSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToExternalSource">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Link from a Method to the external documentation describing the method.</rdfs:comment>
        <rdfs:label xml:lang="en">reference to external source</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element referenceToExternalDocumentation on LCIAMethodDataSet/dataSetInformation.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToLCAMethodReport -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToLCAMethodReport">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#referenceToExternalSource"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAMethodReport"/>
        <rdfs:comment xml:lang="en">Link from a Method to the formal LCIA method report (e.g. the EF 3.1 method description).</rdfs:comment>
        <rdfs:label xml:lang="en">reference to LCA method report</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToModelSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToModelSource">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ImpactModel"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Link from an ImpactModel to the bibliographic source(s) describing the characterisation model.</rdfs:comment>
        <rdfs:label xml:lang="en">reference to model source</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element referenceToModelSource.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#referenceToOriginalEPD -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#referenceToOriginalEPD">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EPDStudy"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#EPDDocument"/>
        <rdfs:comment xml:lang="en">Link from the machine-readable EPDStudy to the published EPD document (typically PDF).</rdfs:comment>
        <rdfs:label xml:lang="en">reference to original EPD</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element epd2:referenceToOriginalEPD.</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#relatesToLCAIndicator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#relatesToLCAIndicator">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EN15804ImpactIndicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCIAImpactIndicator"/>
        <rdfs:comment xml:lang="en">Relates an EN15804 impact indicator to the conceptually corresponding EF 3.1 / PEF LCIA impact indicator. 
The two indicators are not equivalent — EN15804 indicators are EPD-specific reporting slots defined by EN15804+A2, while LCIA impact indicators follow the broader EF 3.1 characterisation framework. This property records a conceptual correspondence without implying any equivalence.</rdfs:comment>
        <rdfs:label xml:lang="en">relates to LCA indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/hasVersion -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/hasVersion"/>
    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- https://w3id.org/eudpp#accessRestrictions -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#accessRestrictions">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Human-readable description of access and use restrictions for the LCA / EPD study (equivalent to dcterms:accessRights).</rdfs:comment>
        <rdfs:label xml:lang="en">access restrictions</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element accessRestrictions.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#amount -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#amount">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#LCAModuleValue"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#LCAResult"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Numerical value of an LCA result or an LCIAModuleValue.</rdfs:comment>
        <rdfs:label xml:lang="en">amount</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: corresponds to the text content of epd:amount inside LCIAResult/other.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#dataSetVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#dataSetVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Version number of this LCA / EPD study instance, independent of the ontology version. Format: major.minor.sub-minor (e.g. &quot;02.00.011&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">data set version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element publicationAndOwnership/dataSetVersion.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#epdFormatVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#epdFormatVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EPDStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Version tag of the ILCD+EPD format used (e.g. &quot;1.3&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">EPD format version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the attribute @epd2:epd-version on processDataSet.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#expiryDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#expiryDate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EPDStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which the EPD&apos;s validity expires. EN 15804+A2 EPDs are typically valid for five years from publication.</rdfs:comment>
        <rdfs:label xml:lang="en">expiry date</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element epd2:expirationDateOfEPD on time/other.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#forScenario -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#forScenario">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAModuleValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Identifier of the scenario this LCIAModuleValue applies to (free-text label matching the EPD&apos;s scenario declaration).</rdfs:comment>
        <rdfs:label xml:lang="en">for scenario</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the attribute @epd:scenario on epd:amount.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#hasCopyright -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#hasCopyright">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if a copyright applies to the LCA / EPD study, false otherwise.</rdfs:comment>
        <rdfs:label xml:lang="en">has copyright</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element publicationAndOwnership/copyright. Modelled as xsd:boolean per the ILCD+EPD schema definition (two-valued).</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#ilcdFormatVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#ilcdFormatVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">ILCD schema version used by the source serialisation of this study (e.g. &apos;1.1&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">ILCD format version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the attribute @version on processDataSet.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#isDeclared -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#isDeclared">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAModuleValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if this module value is declared in the study (has a numerical amount), false if the module is explicitly marked as not declared (ND / MND) for this indicator/scenario. Absence of the LCIAModuleValue triple altogether means the module was not in scope of the study (MNA - module not applicable).</rdfs:comment>
        <rdfs:label xml:lang="en">is declared</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#methodVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#methodVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Version of the specific LCIA or Inventory method instance (where applicable). Captures method-instance-level versioning, distinct from methodology-level versioning (eudpp:methodologyVersion on LCAMethodology).</rdfs:comment>
        <rdfs:label xml:lang="en">method version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#methodologyVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#methodologyVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Version identifier of an LCAMethodology individual (e.g. &quot;3.1&quot; for EF 3.1, &quot;2002&quot; for CML 2002).</rdfs:comment>
        <rdfs:label xml:lang="en">methodology version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#modelVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#modelVersion">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasVersion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ImpactModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Version of the characterisation model used (e.g. &quot;IPCC AR6 2021&quot; vs &quot;IPCC AR5 2013&quot;, which give different GWP100 values).</rdfs:comment>
        <rdfs:label xml:lang="en">model version</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#providesLCAData -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#providesLCAData">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ManufacturerRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the manufacturer identified in this record directly provided primary LCA data for the study. Set to true for the reference manufacturer; may be false for manufacturers listed for traceability only.</rdfs:comment>
        <rdfs:label xml:lang="en">provides LCA data</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#referenceYear -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#referenceYear">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="en">Start year of the time period for which the study is valid.</rdfs:comment>
        <rdfs:label xml:lang="en">reference year</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element time/referenceYear on processDataSet.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#registrationNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#registrationNumber">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EPDStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Identifying number issued by the EPD programme operator (typically visible on the EPD document). Distinct from the dataset UUID.</rdfs:comment>
        <rdfs:label xml:lang="en">registration number</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: Corresponds to the element publicationAndOwnership/registrationNumber.</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#reviewDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#reviewDate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Review"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which the review was completed. Important for DPP consumers to assess whether the review is still current.</rdfs:comment>
        <rdfs:label xml:lang="en">review date</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#uuid -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#uuid">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The Universally Unique Identifier of this LCA / EPD study, as mandated by ILCD+EPD as the primary persistent identifier. Once a study is created and a UUID is generated, the UUID stays the same forever; any change increments eudpp:dataSetVersion. String formatted as an RFC 4122 UUID (36 characters, hyphenated).</rdfs:comment>
        <rdfs:label xml:lang="en">UUID</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://spdx.org/rdf/terms#License -->


    <owl:Class rdf:about="http://spdx.org/rdf/terms#License"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/ns/prov#Activity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
    


    <!-- http://www.w3.org/ns/prov#Entity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- https://w3id.org/eudpp#AreaOfProtection -->


    <owl:Class rdf:about="https://w3id.org/eudpp#AreaOfProtection">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#aopHumanHealth"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#aopManMadeEnvironment"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#aopNaturalEnvironment"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#aopNaturalResources"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#aopOther"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Damage area addressed by an LCIA method via the LCIA Impact Category class using the addressesAoP object property. A closed enumeration of 5 individuals.</rdfs:comment>
        <rdfs:label xml:lang="en">Area of Protection</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: corresponds to the element AreaOfProtectionValues.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#BackgroundDatabase -->


    <owl:Class rdf:about="https://w3id.org/eudpp#BackgroundDatabase">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source representing a background LCI database used for the LCA modelling (e.g. ecoinvent, GaBi/Sphera, Okobaudat).</rdfs:comment>
        <rdfs:label xml:lang="en">Background Database</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#CarbonFootprint -->


    <owl:Class rdf:about="https://w3id.org/eudpp#CarbonFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCIAResult"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                        <owl:hasValue rdf:resource="https://w3id.org/eudpp#ind_EF_climateChange"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                        <owl:hasValue rdf:resource="https://w3id.org/eudpp#ind_GWPtotal"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An LCIAResult that &quot;means the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category of climate change&quot;. (ESPR Art 2 25))
 
It quantifies the global warming potential of a product over a 100-year time horizon.
Instances of this class quantify either the EN 15804+A2 individual &quot;GWP-total - Global Warming Potential (total)&quot; (ind_GWPtotal, an EN15804ImpactIndicator) or the EF 3.1 &quot;Climate Change EF&quot; indicator (ind_EF_climateChange, an LCIAImpactIndicator), depending on the reporting framework of the EPD or LCA study.</rdfs:comment>
        <rdfs:label xml:lang="en">Carbon Footprint</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ESPR Art 2 (25) https://eur-lex.europa.eu/eli/reg/2024/1781/oj</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element CarbonFootprint (https://w3id.org/lcanet/ia#CarbonFootprint) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ComplianceDeclaration -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ComplianceDeclaration">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A statement that the LCA or EPD study complies with a given compliance system (typically ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, or a PEFCR). The level of compliance (fully, partially, not compliant) is recorded via eudpp:complianceStatus.</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance Declaration</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element complianceDeclarations/compliance.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ComplianceStatus -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ComplianceStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#fullyCompliant"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#notCompliant"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#partiallyCompliant"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Level of compliance declared by a ComplianceDeclaration relative to its compliance system. Enumeration of 3 named individuals (fullyCompliant, partiallyCompliant, notCompliant).</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance Status</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ComplianceSystem -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ComplianceSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">A standard or programme against which an LCA or EPD study is declared compliant, such as ISO 14040/14044, ISO 14025, ISO 14067, ISO 21930, EN 15804+A2, PEFCR programmes, or a specific programme operator&apos;s scheme.</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance System</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EN15804ImpactIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EN15804ImpactIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#EN15804Indicator"/>
        <rdfs:comment xml:lang="en">An EN 15804+A2 characterised impact indicator (core set of 13 or the 6 additional &quot;with caveats&quot; indicators). Characterised via the EF 3.1 characterisation models. Results computed for this indicator are eudpp:LCIAResult instances.</rdfs:comment>
        <rdfs:label xml:lang="en">EN 15804 Impact Indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EN15804Indicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EN15804Indicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
        <rdfs:comment xml:lang="en">An indicator defined by EN 15804+A2 (core impact, impact with caveats, resource use, waste output, or output-flow indicator). 
Subclass of the abstract eudpp:LCAIndicator parent. 
Note: an EN15804Indicator individual is the indicator definition; a result computed for that indicator is an eudpp:LCAResult instance (LCIAResult or InventoryIndicatorResult sibling).</rdfs:comment>
        <rdfs:label xml:lang="en">EN 15804 Indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EN15804IndicatorGroup -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EN15804IndicatorGroup">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_coreImpact"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_exportedEnergy"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_resourceUse"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_valorisation"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_waste"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#group_withCaveats"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Grouping of the EN 15804+A2 indicators based on the printed standard&apos;s tables: core impact (Table 3), impact indicators with caveats (Table 4), resource use (Table 5 resource use), waste categories (Table 5 waste), output flows valorisation (Table 5 output flows), exported energy (Table 5 output flows). Enumeration of 6 named individuals.</rdfs:comment>
        <rdfs:label xml:lang="en">EN 15804 Indicator Group</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EN15804InventoryIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EN15804InventoryIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#EN15804Indicator"/>
        <rdfs:comment xml:lang="en">An EN 15804+A2 inventory-level indicator (resource use, waste disposed, or output flow for valorisation / exported energy). Not characterised; value is an aggregated inventory quantity. Results computed for this indicator are eudpp:InventoryIndicatorResult instances.</rdfs:comment>
        <rdfs:label xml:lang="en">EN 15804 Inventory Indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EPDDocument -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EPDDocument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source representing the published PDF or HTML EPD document itself (as distinct from the ILCD+EPD machine-readable EPDStudy).</rdfs:comment>
        <rdfs:label xml:lang="en">EPD Document</rdfs:label>
        <skos:broadMatch rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EPDStudy -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EPDStudy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:comment xml:lang="en">An LCA study that conforms to EN 15804+A2 with EF 3.1 characterisation, i.e. an Environmental Product Declaration. Inherits all study-level metadata from eudpp:LCAStudy (compliance declarations, manufacturer records, reviews, LCA results, etc.) and adds EPD-specific properties: ILCD+EPD format version (eudpp:epdFormatVersion), registration number, expiry date, reference to the published EPD document (eudpp:EPDDocument via referenceToOriginalEPD), reference to the applicable Product Category Rules (eudpp:PCR via referenceToPCR). EN 15804+A2 module values per LCAResult are used to populate per-life-cycle-module values. Replaces v1.9.4&apos;s mixed structure and v1.9.5&apos;s eudpp:EPDDataSet.</rdfs:comment>
        <rdfs:label xml:lang="en">EPD Study</rdfs:label>
        <rdfs:label xml:lang="de">EPD-Studie</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://indatawg.github.io/ILCD-EPD-Data-Format/doc/"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EnergyConsumptionResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EnergyConsumptionResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An LCA inventory indicator result quantifying the consumption of primary energy resources — renewable and non-renewable — in a product system. 
Commonly associated with the EN 15804+A2 primary energy indicators (e.g. PERE, PERM, PERT, PENRE, PENRM, PENRT), though no formal quantifiesIndicator restriction is imposed, as energy consumption may span multiple indicators depending on the study scope.</rdfs:comment>
        <rdfs:label xml:lang="en">Energy Consumption Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EnvironmentalFootprintScore -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EnvironmentalFootprintScore">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
        <rdfs:comment xml:lang="en">An aggregated single-score indicator computed as the normalised and weighted sum of a set of impact-category results. 
Holds one named individual eudpp:ind_EF_singleScore representing the EU Environmental Footprint single score (PEF score). The applied normalisation factors and weighting set are not modelled here as properties; they are determined by the active EF / PEF methodology version, which is resolvable via the study&apos;s eudpp:hasComplianceDeclaration link to a eudpp:ComplianceSystem source. 
Results computed for an EnvironmentalFootprintScore individual are eudpp:LCIAResult instances.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Footprint Score</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EnvironmentalFootprintScoreResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EnvironmentalFootprintScoreResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#EnvironmentalFootprintScore"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A normalized and weighted aggregate LCA result expressing the overall environmental performance of a product system as a single dimensionless score, computed by applying the Product Environmental Footprint (PEF) method (Recommendation (EU) 2021/2279). 
Aggregates the characterised results of all 16 EF 3.1 impact categories through normalization and weighting factors.
Instances of this class quantify the EF single score indicator (ind_EF_singleScore, an EnvironmentalFootprintScore individual) via quantifiesIndicator.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Footprint Score Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology: third sibling subclass of eudpp:LCAResult alongside eudpp:LCIAResult and eudpp:InventoryIndicatorResult, introduced to represent the aggregated EF single score result.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ImpactModel -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ImpactModel">
        <rdfs:comment xml:lang="en">The characterisation model underlying an LCIA method (e.g. IPCC AR6 2021 for GWP). It carries a model name (eudpp:modelName), optional version (eudpp:modelVersion), and optional bibliographic source (eudpp:referenceToModelSource).</rdfs:comment>
        <rdfs:label xml:lang="en">Impact Model</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: corresponds to the element impactModel of an LCIA Method Data Set.</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element CharacterizationModel (https://w3id.org/lcanet/ia#CharacterizationModel) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#InventoryIndicatorResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#InventoryIndicatorResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#EN15804InventoryIndicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A specific LCA result representing an aggregated inventory-indicator result computed for an EN 15804+A2 inventory indicator (Table 5: resource use, waste categories, output flows). 
Important disambiguation: this class represents the AGGREGATED inventory-indicator value (e.g. total kg of HWD across A1-A3 for one product), as printed in EN 15804+A2 EPD tables and computed by a Method instance. It is NOT the raw flow-level life-cycle inventory (LCI) result of a process (which would be a list of elementary-flow exchanges with amounts and units, and is out of scope for this DPP-oriented LCA module).</rdfs:comment>
        <rdfs:label xml:lang="en">Inventory Indicator Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAIndicator">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#computedByMethod"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#LCAMethod"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Abstract umbrella class for an indicator definition (impact or inventory category) that an eudpp:Method calculates values for. 
Each instance identifies exactly one method under which it is computed; this constraint is formalised as owl:maxCardinality 1 on eudpp:computedByMethod. 
Note: an indicator individual is the indicator DEFINITION (e.g. &quot;FW – Net use of fresh water, in m3&quot;); a numerical value computed for that indicator on a specific study is an eudpp:LCAResult instance (LCIAResult or InventoryIndicatorResult).</rdfs:comment>
        <rdfs:label xml:lang="en">LCA Indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAMethod">
        <rdfs:comment xml:lang="en">A life-cycle assessement method that produces values for one indicator from an inventory of elementary flows. 
Covers both (a) characterised LCIA methods (which apply characterisation factors to compute a midpoint impact result), and (b) inventory aggregation methods (which sum / aggregate inventory flows to produce an inventory-indicator result, e.g. the EN 15804+A2 inventory indicators FW, HWD, PERE etc. defined as inventory-level by the standard&apos;s calculation rules).</rdfs:comment>
        <rdfs:label xml:lang="en">LCA Method</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://indatawg.github.io/ILCD-EPD-Data-Format/gitBranches/release/v1.3/schemadoc/ILCD_LCIAMethodDataSet.html"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: corresponds to the element LCIA Method Data Set, which is used in practice for both LCIA method and inventory indicator methods.</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element Method (https://w3id.org/lcanet/ia#Method) in the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAMethodReport -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAMethodReport">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source that documents a life-cycle impact assessment (LCIA) method (e.g. the EF 3.1 method description).</rdfs:comment>
        <rdfs:label xml:lang="en">LCIA Method Report</rdfs:label>
        <skos:broadMatch rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAMethodology -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAMethodology">
        <rdfs:comment xml:lang="en">A named, versioned LCA methodology (a coherent set of LCA methods sharing principles and a set of characterisation factors), to which one or more Method instances belong. 
Each individual SHOULD carry a skos:altLabel giving a short code (e.g. &quot;EF 3.1&quot;) and eudpp:methodologyVersion giving the version identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">LCA Methodology</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element Methodology (https://w3id.org/lcanet/ia#Methodology) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAModuleValue -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAModuleValue">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#forLifeCycleModule"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#amount"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#isDeclared"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#forScenario"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">One numerical LCA-result value (impact or inventory-indicator) for a specific EN 15804+A2 life-cycle module (A1-A3, A4, ..., D) and optionally a specific scenario. 
It carries eudpp:amount (the numeric value), eudpp:forLifeCycleModule, optionally eudpp:forScenario, and eudpp:isDeclared (boolean: true if the module is declared with this value; false if the module is explicitly not declared for this indicator).</rdfs:comment>
        <rdfs:label xml:lang="en">LCA Module Value</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: corresponds to the element epd:amount inside LCIAResult/other.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAResult">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Abstract class for any LCA computation output of a study. Has three subclasses: 
eudpp:LCIAResult (characterised impact result) which applies characterisation factors of an LCIA method, eudpp:InventoryIndicatorResult (aggregated inventory-indicator result) whcih is a sum/aggregation over the inventory without characterisation, and eudpp:EnvironmentalFootprintScoreResult which represents the aggregated EF single score result. 

In the regulatory sense of ESPR Art. 2(24), some characterized individuals of LCAResult constitute environmental footprints — quantifications of environmental impacts of a product throughout its life cycle.Other LCAResult instances, however, fall outside the strict ESPR definition. For this reason, LCAResult is linked to the ESPR &quot;Environmental Footprint&quot; concept via skos:broadMatch rather than owl:equivalentClass.</rdfs:comment>
        <rdfs:label xml:lang="en">LCA Result</rdfs:label>
        <skos:broadMatch xml:lang="en">ESPR Art 2 (24) https://eur-lex.europa.eu/eli/reg/2024/1781/oj#Art2_24</skos:broadMatch>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element LcaResult (https://w3id.org/lcanet/ia#LcaResult) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCAStudy -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCAStudy">
        <rdfs:comment xml:lang="en">A life-cycle assessment study of a product, conducted per ISO 14040/14044, producing one or more LCA results. The general study container, applicable to any product whether or not the study follows EN 15804+A2. 
Carries study-level metadata (UUID, dataset version, name, reference year, license, copyright, ILCD format version, compliance declarations, manufacturer records, reviews, references to data sources / background databases / PEFCR, etc.). 
Cross-module link from a product to this class is provided by the Connector property eudpp:hasLCAStudy.</rdfs:comment>
        <rdfs:label xml:lang="en">LCA Study</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element LcaModel (https://w3id.org/lcanet/core#LcaModel) of the Core module, which represents an LCA instance.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCIAImpactCategory -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCIAImpactCategory">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#acidification"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#climateChange"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#eutrophication"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#freshwaterEcotoxicity"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#humanToxicity"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#ionisingRadiationEcosystems"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#ionisingRadiationHumanHealth"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#landUseSoilQuality"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#marineEcotoxicity"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#ozoneDepletion"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#photochemicalOzoneFormation"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#resourceUseFossil"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#resourceUseMineralsMetals"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#respiratoryInorganics"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#terrestrialEcotoxicity"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#waterUseDeprivation"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A mid-point impact category that an LCAMethod addresses. A closed enumeration.</rdfs:comment>
        <rdfs:label xml:lang="en">LCIA Impact Category</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: matches the LCIAImpactCategoryValues.</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element ImpactCategory (https://w3id.org/lcanet/ia#ImpactCategory) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCIAImpactIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCIAImpactIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAIndicator"/>
        <rdfs:comment xml:lang="en">A characterised impact indicator outside the EN 15804+A2 selection — direct subclass of eudpp:LCAIndicator, sibling of eudpp:EN15804Indicator. Holds the 16 official EF 3.1 / PEF impact category indicators as named individuals (Andreasi Bassi et al., JRC, 2023). 
These are the impact indicators used by general LCA studies (eudpp:LCAStudy) following the EU Environmental Footprint method, distinct from the EN 15804+A2 set used by EPDStudy. 
The two sets overlap conceptually — both have e.g. a &quot;Climate change&quot; indicator with kg CO2-eq — but differ operationally: EN 15804+A2 splits Climate change into four sub-indicators (total, fossil, biogenic, luluc) and selects 6 &quot;with caveats&quot; indicators with EN-specific reporting rules; EF 3.1 keeps Climate change as one indicator and presents 16 categories at one aggregation level.</rdfs:comment>
        <rdfs:label xml:lang="en">LCIA Impact Indicator</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element ImpactCategoryIndicator (https://w3id.org/lcanet/ia#ImpactCategoryIndicator) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LCIAResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LCIAResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#LCAResult"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#quantifiesIndicator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/eudpp#EN15804ImpactIndicator"/>
                            <rdf:Description rdf:about="https://w3id.org/eudpp#LCIAImpactIndicator"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A characterised LCA result quantifying one LCIA indicator (an EN15804ImpactIndicator or an LCIAImpactIndicator ) for a product system. Each instance is linked to exactly one indicator individual via quantifiesIndicator, and carries its numerical value per life-cycle module via hasLCAModuleValue.</rdfs:comment>
        <rdfs:label xml:lang="en">LCIA Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: corresponds to the element LCIAResults/LCIAResult when the indicator is a characterised impact indicator.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LandUseResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LandUseResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An LCA result quantifying impacts associated with land occupation and transformation in a product system. 
Commonly associated with the EN 15804+A2 land use indicator (LU), which is characterised under EF 3.1. No formal quantifiesIndicator restriction is imposed; note that LU sits at the boundary between inventory and impact in EN 15804 and may be refined in future ontology versions.</rdfs:comment>
        <rdfs:label xml:lang="en">Land Use Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LicenseType -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LicenseType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#freeOfChargeAll"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#freeOfChargeMembers"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#freeOfChargeSome"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#licenseFee"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#licenseOther"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://spdx.org/rdf/terms#License"/>
        <rdfs:comment xml:lang="en">License applicable to access and use of the LCA / EPD study. A closed enumeration.</rdfs:comment>
        <rdfs:label xml:lang="en">License Type</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: matching the ILCD LicenseTypeValues.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#LifeCycleModule -->


    <owl:Class rdf:about="https://w3id.org/eudpp#LifeCycleModule">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA1"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA1A3"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA2"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA3"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA4"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleA5"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB1"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB2"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB3"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB4"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB5"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB6"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleB7"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleC1"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleC2"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleC3"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#en15804moduleC4"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#moduleD"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A modelled life-cycle module per EN 15804+A2 (product stage A1-A3, construction A4-A5, use stage B1-B7, end-of-life C1-C4, benefits/loads D). Enumeration of 18 named individuals. 
Note that moduleA1A3 (aggregated product stage) is an alternative reporting form of A1+A2+A3; an EPD that reports A1-A3 should not additionally report A1, A2, A3 separately for the same indicator/scenario.</rdfs:comment>
        <rdfs:label xml:lang="en">Life Cycle Module</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ManufacturerRecord -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ManufacturerRecord">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A container provenance entity (prov:Entity) documenting the involvement of a manufacturer (and optionally a data provider) in a specific LCA study, including the facility concerned and whether primary LCA data was provided.</rdfs:comment>
        <rdfs:label xml:lang="en">Manufacturer Record</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element epd24:manufacturer inside epd24:manufacturers.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialFootprint -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An InventoryIndicatorResult that &quot;refers to the total amount of raw materials extracted to meet final consumption demands&quot; (ESPR Art. 2(26)).

Modelled as an inventory-level result rather than a characterised LCIA result, as it aggregates raw material extraction flows without applying characterisation factors.
No single EN 15804+A2 inventory indicator individual is pinned via quantifiesIndicator; the link is left to individual instances, as material footprint spans multiple EN 15804+A2 resource use inventory indicators (PERE, PENRE, SM, RSF, NRSF, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">Material Footprint</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ESPR Art 2 (26) https://eur-lex.europa.eu/eli/reg/2024/1781/oj</eudpp:sourceVocabulary>
        <eudpp:sourceVocabulary xml:lang="en">LCAnet: relates to the element MaterialFootprint (https://w3id.org/lcanet/ia#MaterialFootprint) of the IA module.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#PCR -->


    <owl:Class rdf:about="https://w3id.org/eudpp#PCR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source that is a Product Category Rules document (EN 15804+A2 Table 2 Line 1). Used in EN 15804+A2 EPDStudy via eudpp:referenceToPCR.</rdfs:comment>
        <rdfs:label xml:lang="en">Product Category Rules (PCR)</rdfs:label>
        <skos:broadMatch rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#PEFCR -->


    <owl:Class rdf:about="https://w3id.org/eudpp#PEFCR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source that is a Product Environmental Footprint Category Rules document, the European Commission Environmental Footprint methodology&apos;s product-category-specific rules. Parallel role to PCR but for PEF studies (rather than EN 15804+A2 EPD studies). Used by an LCAStudy via eudpp:referenceToPEFCR. NEW in v1.9.7.</rdfs:comment>
        <rdfs:label xml:lang="en">Product Environmental Footprint Category Rules (PEFCR)</rdfs:label>
        <skos:broadMatch rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#RecycledMaterialsUseResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#RecycledMaterialsUseResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An LCA inventory indicator result quantifying the use of secondary (recycled) material inputs in a product system. 
Commonly associated with the EN 15804+A2 inventory indicator “Use of secondary material” (SM), though no formal quantifiesIndicator restriction is imposed.</rdfs:comment>
        <rdfs:label xml:lang="en">Recycled Materials Use Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Review -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Review">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">A verification / critical review performed on an LCA study or EPD study.</rdfs:comment>
        <rdfs:label xml:lang="en">Review</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://indatawg.github.io/ILCD-EPD-Data-Format/doc/"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base: corresponds to the element validation/review.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ReviewReport -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ReviewReport">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Source"/>
        <rdfs:comment xml:lang="en">Source holding the complete critical-review / verification report referenced from a Review.</rdfs:comment>
        <rdfs:label xml:lang="en">Review Report</rdfs:label>
        <skos:broadMatch rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Source -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Source">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A bibliographic or documentary source referenced from an LCA study, EPD study or LCIA Method. Abstract superclass; concrete source instances typically use one of the more specific subclasses (PCR, LCAMethodReport, BackgroundDatabase, ComplianceSystem, ReviewReport, EPDDocument).</rdfs:comment>
        <rdfs:label xml:lang="en">Source</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD+EPD extension: Corresponds to the element Source Data Set.</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#SustainableRenewableMaterialsUseResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#SustainableRenewableMaterialsUseResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An LCA inventory indicator result quantifying the use of renewable secondary material and fuel inputs in a product system. 
Commonly associated with the EN 15804+A2 inventory indicators “Use of renewable secondary fuels” (RSF) or “Use of non-renewable secondary fuels” (NRSF), though no formal quantifiesIndicator restriction is imposed, as the scope of renewable material inputs may evolve.</rdfs:comment>
        <rdfs:label xml:lang="en">Sustainable Renewable Materials Use Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#TypeOfReview -->


    <owl:Class rdf:about="https://w3id.org/eudpp#TypeOfReview">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#accreditedThirdPartyReview"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#dependentInternalReview"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#independentExternalReview"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#independentInternalReview"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#independentReviewPanel"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#notReviewed"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Kind of critical-review/verification performed on a dataset. Enumeration matching ILCD TypeOfReviewValues.</rdfs:comment>
        <rdfs:label xml:lang="en">Type of Review</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">ILCD base</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#WaterConsumptionResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp#WaterConsumptionResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#InventoryIndicatorResult"/>
        <rdfs:comment xml:lang="en">An LCA inventory indicator result quantifying the net consumption of fresh water resources in a product system. 
This class is typically associated with the EN 15804+A2 inventory indicator “Use of net fresh water” (FW), though no formal quantifiesIndicator restriction is imposed to allow for future indicator additions or revised indicator frameworks.</rdfs:comment>
        <rdfs:label xml:lang="en">Water Consumption Result</rdfs:label>
        <eudpp:sourceVocabulary xml:lang="en">LCA ontology</eudpp:sourceVocabulary>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#accreditedThirdPartyReview -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#accreditedThirdPartyReview">
        <rdf:type rdf:resource="https://w3id.org/eudpp#TypeOfReview"/>
        <rdfs:comment xml:lang="en">Reviewer independent of the organisations involved and accredited by an independent accreditation body. Highest level acceptable for EN 15804+A2 compliance.</rdfs:comment>
        <rdfs:label xml:lang="en">Accredited third party review</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#acidification -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#acidification">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopNaturalEnvironment"/>
        <rdfs:label xml:lang="en">Acidification</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#aopHumanHealth -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#aopHumanHealth">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:label xml:lang="en">Human health</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#aopManMadeEnvironment -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#aopManMadeEnvironment">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:label xml:lang="en">Man-made environment</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#aopNaturalEnvironment -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#aopNaturalEnvironment">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:label xml:lang="en">Natural environment</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#aopNaturalResources -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#aopNaturalResources">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:label xml:lang="en">Natural resources</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#aopOther -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#aopOther">
        <rdf:type rdf:resource="https://w3id.org/eudpp#AreaOfProtection"/>
        <rdfs:label xml:lang="en">Other AoP</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#climateChange -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#climateChange">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCIAImpactCategory"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopHumanHealth"/>
        <eudpp:addressesAoP rdf:resource="https://w3id.org/eudpp#aopNaturalEnvironment"/>
        <rdfs:label xml:lang="en">Climate change</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#dependentInternalReview -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#dependentInternalReview">
        <rdf:type rdf:resource="https://w3id.org/eudpp#TypeOfReview"/>
        <rdfs:comment xml:lang="en">Reviewer involved in data collection or modelling, or representing the process/product system. Not acceptable for EN 15804+A2 compliance.</rdfs:comment>
        <rdfs:label xml:lang="en">Dependent internal review</rdfs:label>
        <eudpp:sourceVocabulary>ILCD base</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#en15804moduleA1 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#en15804moduleA1">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
        <rdfs:label xml:lang="en">A1 - Raw material extraction and supply</rdfs:label>
        <skos:altLabel xml:lang="en">A1</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#en15804moduleA1A3 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#en15804moduleA1A3">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
        <rdfs:label xml:lang="en">A1-A3 - Product stage (aggregated)</rdfs:label>
        <skos:altLabel xml:lang="en">A1-A3</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#en15804moduleA2 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#en15804moduleA2">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
        <rdfs:label xml:lang="en">A2 - Transport to manufacturer</rdfs:label>
        <skos:altLabel xml:lang="en">A2</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#en15804moduleA3 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#en15804moduleA3">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LifeCycleModule"/>
        <rdfs:label xml:lang="en">A3 - Manufacturing</rdfs:label>
        <skos:altLabel xml:lang="en">A3</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
    </owl:NamedIndividual>
    


