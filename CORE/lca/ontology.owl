    <!-- https://w3id.org/eudpp#methodology_EN15804InventoryRules -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#methodology_EN15804InventoryRules">
        <rdf:type rdf:resource="https://w3id.org/eudpp#LCAMethodology"/>
        <eudpp:methodologyVersion>A2:2019</eudpp:methodologyVersion>
        <rdfs:comment xml:lang="en">Inventory calculation rules defined by EN 15804+A2 itself for the 18 resource-use / waste / output-flow inventory indicators (PERE, PERM, ... EEE, EET). This &quot;methodology&quot; is inventory-level rather than characterised; it is distinguished here from EF 3.1 because the inventory indicators do not use EF characterisation factors.</rdfs:comment>
