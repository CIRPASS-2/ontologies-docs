        <rdfs:comment xml:lang="en">European Commission Environmental Footprint method, version 3.1. Mandated by EN 15804+A2 as the characterisation basis for the 13 core and 6 with-caveat impact indicators.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Footprint 3.1</rdfs:label>
        <skos:altLabel xml:lang="en">EF 3.1</skos:altLabel>
        <eudpp:sourceVocabulary>LCA ontology extension</eudpp:sourceVocabulary>
