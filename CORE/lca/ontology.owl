        <eudpp:belongsToEn15804Group rdf:resource="https://w3id.org/eudpp#group_coreImpact"/>
        <rdfs:comment xml:lang="en">Fraction of nutrients reaching freshwater end compartment, in kg P-equivalent. Core EN 15804+A2 impact indicator. ERRATUM: the published text of EN 15804:2012+A2:2019 states the unit as &apos;kg PO4-eq&apos; for this indicator, but the characterisation factors used by the EF 3.1 implementation operate on phosphorus (P), so the correct unit when reporting results against EF 3.1 characterisation factors is &apos;kg P-eq&apos;. This ontology adopts the corrected unit. See JRC / EPD programme clarifications for details.</rdfs:comment>
        <rdfs:label xml:lang="en">EP-freshwater - Eutrophication (freshwater)</rdfs:label>
        <skos:altLabel xml:lang="en">EP-freshwater</skos:altLabel>
        <eudpp:sourceVocabulary>ILCD+EPD extension</eudpp:sourceVocabulary>
        <eudpp:unitAsString xml:lang="en">kg P-eq</eudpp:unitAsString>
        <relatesToLCAIndicator rdf:resource="https://w3id.org/eudpp#ind_EF_eutrophicationFreshwater"/>
    </owl:NamedIndividual>
    


