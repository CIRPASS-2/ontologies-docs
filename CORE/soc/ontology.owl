    <!-- https://w3id.org/eudpp#abbreviation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#abbreviation">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#otherName"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(a)(ii)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">An abbreviation used for the substance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Abbreviation</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


