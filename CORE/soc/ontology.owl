        <terms:references xml:lang="en">ESPR Article 7(5)(a)(iv)</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">The Chemical Abstracts Service name of the substance, when available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">CAS name</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:DatatypeProperty>
    


