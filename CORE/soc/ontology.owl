        <rdfs:label xml:lang="en">Has recycling instruction</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasReuseInstruction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasReuseInstruction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceManagementInstruction"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(e).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a substance presence to information relevant for reuse.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Has reuse instruction</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasSafeUseInstruction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasSafeUseInstruction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SubstancePresence"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceManagementInstruction"/>
        <terms:references xml:lang="en">ESPR Article 7(5)(d).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a substance presence to relevant instructions for the safe use of the product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">Has safe-use instruction</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasSoCCriterion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasSoCCriterion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">ESPR Article 2(27).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a qualification assertion to one or more non-exclusive criteria (a)-(d).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">has SoC criterion</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded modelling relation connecting a qualification assertion to one or more Article 2(27) qualification criteria.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#qualifiesSubstance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#qualifiesSubstance">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#hasQualificationAssertion"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceOfConcern"/>
        <terms:references xml:lang="en">ESPR Article 2(27).</terms:references>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <rdfs:comment xml:lang="en">Links a qualification assertion to the substance of concern that it positively qualifies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">qualifies substance</rdfs:label>
        <eudpp:sourceStatus xml:lang="en">ESPR-grounded modelling relation connecting an explicit qualification assertion to the SubstanceOfConcern it qualifies.</eudpp:sourceStatus>
    </owl:ObjectProperty>
    


