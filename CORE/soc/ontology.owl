    <!-- https://w3id.org/eudpp#sourceStatus -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp#sourceStatus">
        <terms:references xml:lang="en">Introduced to avoid using dcterms:provenance for epistemic source-status annotations.</terms:references>
        <terms:source rdf:resource="https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/provenance/"/>
        <rdfs:comment xml:lang="en">Annotation property used to state the epistemic or normative status of the source for an ontology resource, for example direct legal definition, explicit legal information element, ESPR-grounded modelling abstraction, or JRC draft proposal. It is intentionally distinct from dcterms:provenance, which is reserved for ownership and custody history.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/SOC"/>
        <rdfs:label xml:lang="en">source status</rdfs:label>
    </owl:AnnotationProperty>
    


