###  https://w3id.org/eudpp#hasQualificationAssertion
<https://w3id.org/eudpp#hasQualificationAssertion> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                                   rdfs:range <https://w3id.org/eudpp#SoCQualificationAssertion> ;
                                                   <http://purl.org/dc/terms/references> "ESPR Article 2(27)."@en ;
                                                   <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                                   rdfs:comment "Links a substance of concern to a documented qualification assertion."@en ;
                                                   rdfs:isDefinedBy <https://w3id.org/eudpp/SOC> ;
                                                   rdfs:label "has qualification assertion"@en ;
                                                   <https://w3id.org/eudpp#sourceStatus> "ESPR-grounded modelling relation connecting a SubstanceOfConcern to an explicit Article 2(27) qualification assertion."@en .


###  https://w3id.org/eudpp#hasRecyclingInstruction
<https://w3id.org/eudpp#hasRecyclingInstruction> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                                 rdfs:range <https://w3id.org/eudpp#SubstanceManagementInstruction> ;
                                                 <http://purl.org/dc/terms/references> "ESPR Article 7(5)(e)."@en ;
                                                 <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                                 rdfs:comment "Links a substance presence to information relevant for recycling."@en ;
                                                 rdfs:isDefinedBy <https://w3id.org/eudpp/SOC> ;
                                                 rdfs:label "Has recycling instruction"@en ;
                                                 <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#hasReuseInstruction
<https://w3id.org/eudpp#hasReuseInstruction> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                             rdfs:range <https://w3id.org/eudpp#SubstanceManagementInstruction> ;
                                             <http://purl.org/dc/terms/references> "ESPR Article 7(5)(e)."@en ;
                                             <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                             rdfs:comment "Links a substance presence to information relevant for reuse."@en ;
                                             rdfs:isDefinedBy <https://w3id.org/eudpp/SOC> ;
                                             rdfs:label "Has reuse instruction"@en ;
                                             <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#hasSafeUseInstruction
<https://w3id.org/eudpp#hasSafeUseInstruction> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://w3id.org/eudpp#SubstancePresence> ;
                                               rdfs:range <https://w3id.org/eudpp#SubstanceManagementInstruction> ;
                                               <http://purl.org/dc/terms/references> "ESPR Article 7(5)(d)."@en ;
                                               <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                               rdfs:comment "Links a substance presence to relevant instructions for the safe use of the product."@en ;
                                               rdfs:isDefinedBy <https://w3id.org/eudpp/SOC> ;
                                               rdfs:label "Has safe-use instruction"@en ;
                                               <https://w3id.org/eudpp#sourceStatus> "representation of an information element explicitly required by the cited ESPR provision; the RDF resource itself is an ontology modelling construct."@en .


###  https://w3id.org/eudpp#hasSoCCriterion
<https://w3id.org/eudpp#hasSoCCriterion> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#SoCQualificationAssertion> ;
                                         rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                                         <http://purl.org/dc/terms/references> "ESPR Article 2(27)."@en ;
                                         <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                         rdfs:comment "Links a qualification assertion to one or more non-exclusive criteria (a)-(d)."@en ;
                                         rdfs:isDefinedBy <https://w3id.org/eudpp/SOC> ;
                                         rdfs:label "has SoC criterion"@en ;
                                         <https://w3id.org/eudpp#sourceStatus> "ESPR-grounded modelling relation connecting a qualification assertion to one or more Article 2(27) qualification criteria."@en .


###  https://w3id.org/eudpp#qualifiesSubstance
<https://w3id.org/eudpp#qualifiesSubstance> rdf:type owl:ObjectProperty ;
                                            owl:inverseOf <https://w3id.org/eudpp#hasQualificationAssertion> ;
                                            rdfs:domain <https://w3id.org/eudpp#SoCQualificationAssertion> ;
                                            rdfs:range <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                            <http://purl.org/dc/terms/references> "ESPR Article 2(27)."@en ;
                                            <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ;
                                            rdfs:comment "Links a qualification assertion to the substance of concern that it positively qualifies."@en ;
                                            rdfs:isDefinedBy <https://w3id.org/eudpp/SOC> ;
                                            rdfs:label "qualifies substance"@en ;
                                            <https://w3id.org/eudpp#sourceStatus> "ESPR-grounded modelling relation connecting an explicit qualification assertion to the SubstanceOfConcern it qualifies."@en .


