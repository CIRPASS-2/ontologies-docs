###  https://w3id.org/eudpp#hasConcentration
<https://w3id.org/eudpp#hasConcentration> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                          rdfs:range <https://w3id.org/eudpp#Concentration> ;
                                          <http://purl.org/dc/terms/references> "ESPR Art 7(5)"@en ;
                                          <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                          rdfs:comment "Defines the the concentration, maximum concentration or concentration range of the substances of concern, at the level of the product, its relevant components, or spare parts; ESPR Art 7(5)"@en ;
                                          rdfs:label "Has concentration"@en .


###  https://w3id.org/eudpp#hasLifeCycleStage
<https://w3id.org/eudpp#hasLifeCycleStage> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                           <http://purl.org/dc/terms/references> "ESPR Annex I (f)"@en ;
                                           <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                           rdfs:comment """Describes the life cycle stage during which the Substance of Concern occurs for product (used during production, resulting being in product, in waste); ESPR Annex I (f).

Known issue: Range is some type of an Event, not yet present in the EU DPP CO."""@en ;
                                           rdfs:label "Has life cycle stage"@en .


###  https://w3id.org/eudpp#hasThreshold
<https://w3id.org/eudpp#hasThreshold> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                      rdfs:range <https://w3id.org/eudpp#Threshold> ;
                                      <http://purl.org/dc/terms/references> "ESPR FAQ 10.115, p59"@en ;
                                      <http://purl.org/dc/terms/source> "https://circabc.europa.eu/ui/group/418195ae-4919-45fa-a959-3b695c9aab28/library/25c48e7c-9ce3-41cb-96ac-d2942a8a29d6/details" ;
                                      rdfs:comment """Describes relevant threshold of Substance of Concern.

By default, information on all substances of concern present in a product, above the  relevant thresholds, should be included in the DPP [ESPR FAQ 10.115, p59]"""@en ;
                                      rdfs:label "Has threshold"@en .


