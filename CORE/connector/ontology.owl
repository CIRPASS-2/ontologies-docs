<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/CON#"
     xml:base="https://w3id.org/eudpp/CON"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vann1="http://purl.org/vocab/vann#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/CON">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-27</terms:created>
        <terms:creator xml:lang="en">Riina Maigre</terms:creator>
        <terms:creator xml:lang="en">Tarmo Robal</terms:creator>
        <terms:description xml:lang="en">Connector (Bridge) module that only defines object properties between modules. The connector contains only object properties that have domain and range specified in different modules. 

--
THIS DOCUMENT IS PROVIDED WITH NO WARRANTIES WHATSOEVER. 
All liability for any damages arising from use or misuse of this vocabulary is with the user.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-22</terms:issued>
        <terms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
        <terms:license xml:lang="en">This ontology is licensed under the Apache License, Version 2.0. 
In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0).</terms:license>
        <terms:title xml:lang="en">The Connector module of the EU regulatory compliant Digital Product Passport Core Ontology (EU DPP CO) proposed by the CIRPASS-2 European project.</terms:title>
        <vann:preferredNamespacePrefix>con</vann:preferredNamespacePrefix>
        <rdfs:comment xml:lang="en">The CON module of the EU DPP core ontology proposal of the CIRPASS-2 European project.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP CORE CON</rdfs:label>
        <owl:versionInfo>2.0.7</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/references -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/references"/>
    


    <!-- http://purl.org/dc/terms/source -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann#preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann#preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#concernsDPP -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#concernsDPP">
        <rdfs:domain rdf:resource="http://w3id.org/eudpp#DPPEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:comment xml:lang="en">Links a DPP event to the Digital Product Passport whose content, state, or accessibility is affected by the event. This is a cross-module relation between EVENT and P_DPP and is therefore managed in the Connector/mapping layer.

DPP is modelled in the EU DPP CO P_DPP module.
DPPEvent is modelled in the EU DPP CO EVENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">concerns DPP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#concernsProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#concernsProduct">
        <rdfs:domain rdf:resource="http://w3id.org/eudpp#ProductEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">Links a product event to the product whose state, condition, or lifecycle is affected by the event. This is a cross-module relation between EVENT and P_DPP and is therefore managed in the Connector/mapping layer.

Product is modelled in the EU DPP CO P_DPP module.
ProductEvent is modelled in the EU DPP CO EVENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">concerns product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#conformityAttestedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#conformityAttestedBy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>ESPR Annex V (7)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Specifies the notified body that attest the product&apos;s conformity with Union harmonisation legislation. 

UnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">conformity attested by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#containsSubstanceOfConcern -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#containsSubstanceOfConcern">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#MaterialOfComposition"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#SubstanceOfConcern"/>
        <rdfs:comment xml:lang="en">Linking the product to a substance of concern the product contains.

Product is modelled in the EU DPP CO P_DPP module.
Substance of concern is modelled in the EU DPP CO SOC module.</rdfs:comment>
        <rdfs:label xml:lang="en">contains substance of concern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasActorRoleAssignment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasActorRoleAssignment">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp#isActorRoleAssignmentForEvent"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ESPREvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:comment xml:lang="en">Links an event to an actor-role assignment that is valid in the context of that event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.

ESPREvent is modelled in the EU DPP CO EVENT module.
ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has actor role assignment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasAuthorisedRepresentative -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasAuthorisedRepresentative">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>Decision No 768/2008/EC Annex I Art R1 (4)</terms:references>
        <terms:references>ESPR Annex V (2,9)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Specifies the natural or legal person established within the Union who has received a written mandate from a manufacturer to act on his behalf in relation to the Declaration of Conformity.

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.

Source: 
Decision No 768/2008/EC Annex I Art R1 (4)
https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I

ESPR Annex V (2,9)
https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</rdfs:comment>
        <rdfs:label xml:lang="en">has authorised representative</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasBackUpCopyHost -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasBackUpCopyHost">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>ESPR Annex III</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">The reference of the digital product passport service provider hosting the back-up copy of the digital product passport [ESPR Annex III].

DPP is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has back-up-copy host</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasDigitalProductPassportId -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasDigitalProductPassportId">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPPIdentifier"/>
        <rdfs:comment>Realisation for the Unique identifier of an instance of the digital product passport.

DPP is modelled in the EU DPP CO P_DPP module.
DPPIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has digital product passport id</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasEUDeclarationOfConformity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasEUDeclarationOfConformity">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <terms:references>Decision No 768/2008/EC Annex I Art R10</terms:references>
        <terms:references>ESPR Art 44</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44</terms:source>
        <rdfs:comment xml:lang="en">Specifies the EU declaration of conformity issued for the product.

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Product is modelled in the EU DPP CO P_DPP module.</rdfs:comment>
        <rdfs:label xml:lang="en">has EU Declaration of Conformity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasEconomicOperator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasEconomicOperator">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Linking the product to the economic operator (Actor from ACTOR module).

Product is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has economic operator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasIssuer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasIssuer">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">Linking DPP with its issuer (Actor from ACTOR module).

DPP is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has issuer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasLCAStudy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasLCAStudy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#LCAStudy"/>
        <rdfs:comment xml:lang="en">A product has a LCA Study -- a measurable outcome of a life cycle assessment, representing the quantified effect of a product.

Product is modelled in the EU DPP CO P_DPP module.
LCAStudy is modelled in the EU DPP CO LCA module.</rdfs:comment>
        <rdfs:label xml:lang="en">has LCA study</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasManufacturer">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:comment xml:lang="en">A product has a manufacturer (Actor from ACTOR module).

Product is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMaterial">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:comment xml:lang="en">Linking the Product to a MaterialOfComposition.

Product is modelled in the EU DPP CO P_DPP module.
MaterialOfComposition is modelled in the EU DPP CO MAT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has material</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasMaterialIdentifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMaterialIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#MaterialIdentifier"/>
        <rdfs:comment xml:lang="en">Realisation of thematerial indetifier as &quot;Product parameters: identification of  ... materials [ESPR Annex I c)]&quot;

MaterialOfComposition is modelled in the EU DPP CO MAT module.
MaterialIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has material identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasNotifiedBody -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasNotifiedBody">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>Decision No 768/2008/EC Annex I Chapter R4</terms:references>
        <terms:references>ESPR Chapter IX</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#cpt_IX</terms:source>
        <rdfs:comment xml:lang="en">Specifies the conformity assessment body notified in accordance with ESPR Chapter IX	

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has notified body</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasResponsibleManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasResponsibleManufacturer">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>Decision No 768/2008/EC Annex I Art R1 (3)</terms:references>
        <terms:references>ESPR Annex V (2,9)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Defines the natural or legal person responsible for the EU declaration of conformity.


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">has responsible manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasUniqueFacilityIdentifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasUniqueFacilityIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Facility"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#FacilityIdentifier"/>
        <terms:references xml:lang="en">ESPR Art 2 (33)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Linking a Facility to its unique facility identifier.
Facility is modelled in the EU DPP CO ACTOR module.
FacilityIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has unique facility identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasUniqueOperatorIdentifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasUniqueOperatorIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Actor"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ActorIdentifier"/>
        <terms:references xml:lang="en">ESPR Art 2 (31)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</terms:source>
        <rdfs:comment xml:lang="en">Linking an Actor to their unique operator identifier. 
Actor is modelled in the EU DPP CO ACTOR module.
ActorIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has unique operator identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasUniqueProductIdentifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasUniqueProductIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ProductIdentifier"/>
        <rdfs:comment xml:lang="en">Realisation of the uniqueProductIdentifier.

Product is modelled in the EU DPP CO P_DPP module.
ProductIdentifier is modelled in the EU DPP CO IDENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">has unique product identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#inContextOfDPP -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#inContextOfDPP">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:comment xml:lang="en">Relates the actor role assignment to a specific Digital Product Passport instance (from P_DPP module).

ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
DPP is modelled in the EU DPP CO P_DPP module.
        </rdfs:comment>
        <rdfs:label xml:lang="en">in context of DPP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#inContextOfProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#inContextOfProduct">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">Relates the actor role assignment to a specific product (from P_DPP module).

ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
Product is modelled in the EU DPP CO P_DPP module.</rdfs:comment>
        <rdfs:label xml:lang="en">in context of product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isActorRoleAssignmentForEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isActorRoleAssignmentForEvent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ActorRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ESPREvent"/>
        <rdfs:comment xml:lang="en">Links an actor-role assignment to the event context in which the role assignment applies. This is the inverse of evt:hasActorRoleAssignment and is managed in the Connector/mapping layer.

ESPREvent is modelled in the EU DPP CO EVENT module.
ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">is actor role assignment for event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isConformWith -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isConformWith">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:comment xml:lang="en">Specifies Union Harminised Lagislation for which conformity of the product is stated.</rdfs:comment>
        <rdfs:label xml:lang="en">is conform with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isConnectedTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isConnectedTo">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#DPP"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Facility"/>
        <rdfs:comment xml:lang="en">A DPP is connected to a facility.

DPP is modelled in the EU DPP CO P_DPP module.
Facility is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">is connected to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#isIssuedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#isIssuedBy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Actor"/>
        <terms:references>ESPR Annex V (3)</terms:references>
        <terms:source>https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V</terms:source>
        <rdfs:comment xml:lang="en">Specifies the natural or legal person issuing the Declaration of Conformity; ESPR Annex V, paragraph 3 requirement: &quot;This declaration of conformity is issued under the sole responsibility of the manufacturer:&quot;


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.</rdfs:comment>
        <rdfs:label xml:lang="en">issued by</rdfs:label>
    </owl:ObjectProperty>
    


