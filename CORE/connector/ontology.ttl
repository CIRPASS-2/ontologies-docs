@prefix : <https://w3id.org/eudpp/CON#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/CON#> .

<https://w3id.org/eudpp/CON> rdf:type owl:Ontology ;
                              <http://purl.org/dc/terms/created> "2025-02-27"^^xsd:date ;
                              <http://purl.org/dc/terms/creator> "Riina Maigre"@en ,
                                                                 "Tarmo Robal"@en ;
                              <http://purl.org/dc/terms/description> """Connector (Bridge) module that only defines object properties between modules. The connector contains only object properties that have domain and range specified in different modules. 

--
THIS DOCUMENT IS PROVIDED WITH NO WARRANTIES WHATSOEVER. 
All liability for any damages arising from use or misuse of this vocabulary is with the user."""@en ;
                              <http://purl.org/dc/terms/issued> "2026-09-22"^^xsd:date ;
                              <http://purl.org/dc/terms/license> <https://www.apache.org/licenses/LICENSE-2.0> ,
                                                                 """This ontology is licensed under the Apache License, Version 2.0. 
In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."""@en ;
                              <http://purl.org/dc/terms/title> "The Connector module of the EU regulatory compliant Digital Product Passport Core Ontology (EU DPP CO) proposed by the CIRPASS-2 European project."@en ;
                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "con" ;
                              rdfs:comment "The CON module of the EU DPP core ontology proposal of the CIRPASS-2 European project."@en ;
                              rdfs:label "EU DPP CORE CON"@en ;
                              owl:versionInfo "2.0.7" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/references
<http://purl.org/dc/terms/references> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann#preferredNamespacePrefix
<http://purl.org/vocab/vann#preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp#concernsDPP
<https://w3id.org/eudpp#concernsDPP> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <http://w3id.org/eudpp#DPPEvent> ;
                                     rdfs:range <https://w3id.org/eudpp#DPP> ;
                                     rdfs:comment """Links a DPP event to the Digital Product Passport whose content, state, or accessibility is affected by the event. This is a cross-module relation between EVENT and P_DPP and is therefore managed in the Connector/mapping layer.

DPP is modelled in the EU DPP CO P_DPP module.
DPPEvent is modelled in the EU DPP CO EVENT module."""@en ;
                                     rdfs:label "concerns DPP"@en .


###  https://w3id.org/eudpp#concernsProduct
<https://w3id.org/eudpp#concernsProduct> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://w3id.org/eudpp#ProductEvent> ;
                                         rdfs:range <https://w3id.org/eudpp#Product> ;
                                         rdfs:comment """Links a product event to the product whose state, condition, or lifecycle is affected by the event. This is a cross-module relation between EVENT and P_DPP and is therefore managed in the Connector/mapping layer.

Product is modelled in the EU DPP CO P_DPP module.
ProductEvent is modelled in the EU DPP CO EVENT module."""@en ;
                                         rdfs:label "concerns product"@en .


###  https://w3id.org/eudpp#conformityAttestedBy
<https://w3id.org/eudpp#conformityAttestedBy> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
                                              rdfs:range <https://w3id.org/eudpp#Actor> ;
                                              <http://purl.org/dc/terms/references> "ESPR Annex V (7)" ;
                                              <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                              rdfs:comment """Specifies the notified body that attest the product's conformity with Union harmonisation legislation. 

UnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                              rdfs:label "conformity attested by"@en .


###  https://w3id.org/eudpp#containsSubstanceOfConcern
<https://w3id.org/eudpp#containsSubstanceOfConcern> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain [ rdf:type owl:Class ;
                                                                  owl:unionOf ( <https://w3id.org/eudpp#MaterialOfComposition>
                                                                                <https://w3id.org/eudpp#Product>
                                                                              )
                                                                ] ;
                                                    rdfs:range <https://w3id.org/eudpp#SubstanceOfConcern> ;
                                                    rdfs:comment """Linking the product to a substance of concern the product contains.

Product is modelled in the EU DPP CO P_DPP module.
Substance of concern is modelled in the EU DPP CO SOC module."""@en ;
                                                    rdfs:label "contains substance of concern"@en .


###  https://w3id.org/eudpp#hasActorRoleAssignment
<https://w3id.org/eudpp#hasActorRoleAssignment> rdf:type owl:ObjectProperty ;
                                                owl:inverseOf <https://w3id.org/eudpp#isActorRoleAssignmentForEvent> ;
                                                rdfs:domain <https://w3id.org/eudpp#ESPREvent> ;
                                                rdfs:range <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                                rdfs:comment """Links an event to an actor-role assignment that is valid in the context of that event. This is a cross-module relation between EVENT and ACTOR and is therefore managed in the Connector/mapping layer.

ESPREvent is modelled in the EU DPP CO EVENT module.
ActorRoleAssignment is modelled in the EU DPP CO ACTOR module."""@en ;
                                                rdfs:label "has actor role assignment"@en .


###  https://w3id.org/eudpp#hasAuthorisedRepresentative
<https://w3id.org/eudpp#hasAuthorisedRepresentative> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                                     rdfs:range <https://w3id.org/eudpp#Actor> ;
                                                     <http://purl.org/dc/terms/references> "Decision No 768/2008/EC Annex I Art R1 (4)" ,
                                                                                           "ESPR Annex V (2,9)" ;
                                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                                       "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                                     rdfs:comment """Specifies the natural or legal person established within the Union who has received a written mandate from a manufacturer to act on his behalf in relation to the Declaration of Conformity.

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module.

Source: 
Decision No 768/2008/EC Annex I Art R1 (4)
https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I

ESPR Annex V (2,9)
https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V"""@en ;
                                                     rdfs:label "has authorised representative"@en .


###  https://w3id.org/eudpp#hasBackUpCopyHost
<https://w3id.org/eudpp#hasBackUpCopyHost> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                           rdfs:range <https://w3id.org/eudpp#Actor> ;
                                           <http://purl.org/dc/terms/references> "ESPR Annex III" ;
                                           <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                           rdfs:comment """The reference of the digital product passport service provider hosting the back-up copy of the digital product passport [ESPR Annex III].

DPP is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                           rdfs:label "has back-up-copy host"@en .


###  https://w3id.org/eudpp#hasDigitalProductPassportId
<https://w3id.org/eudpp#hasDigitalProductPassportId> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                                     rdfs:range <https://w3id.org/eudpp#DPPIdentifier> ;
                                                     rdfs:comment """Realisation for the Unique identifier of an instance of the digital product passport.

DPP is modelled in the EU DPP CO P_DPP module.
DPPIdentifier is modelled in the EU DPP CO IDENT module.""" ;
                                                     rdfs:label "has digital product passport id"@en .


###  https://w3id.org/eudpp#hasEUDeclarationOfConformity
<https://w3id.org/eudpp#hasEUDeclarationOfConformity> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <https://w3id.org/eudpp#Product> ;
                                                      rdfs:range <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                                      <http://purl.org/dc/terms/references> "Decision No 768/2008/EC Annex I Art R10" ,
                                                                                            "ESPR Art 44" ;
                                                      <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                                        "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44" ;
                                                      rdfs:comment """Specifies the EU declaration of conformity issued for the product.

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Product is modelled in the EU DPP CO P_DPP module."""@en ;
                                                      rdfs:label "has EU Declaration of Conformity"@en .


###  https://w3id.org/eudpp#hasEconomicOperator
<https://w3id.org/eudpp#hasEconomicOperator> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://w3id.org/eudpp#Product> ;
                                             rdfs:range <https://w3id.org/eudpp#Actor> ;
                                             rdfs:comment """Linking the product to the economic operator (Actor from ACTOR module).

Product is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                             rdfs:label "has economic operator"@en .


###  https://w3id.org/eudpp#hasIssuer
<https://w3id.org/eudpp#hasIssuer> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                   rdfs:range <https://w3id.org/eudpp#Actor> ;
                                   rdfs:comment """Linking DPP with its issuer (Actor from ACTOR module).

DPP is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                   rdfs:label "has issuer"@en .


###  https://w3id.org/eudpp#hasLCAStudy
<https://w3id.org/eudpp#hasLCAStudy> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                                     rdfs:range <https://w3id.org/eudpp#LCAStudy> ;
                                     rdfs:comment """A product has a LCA Study -- a measurable outcome of a life cycle assessment, representing the quantified effect of a product.

Product is modelled in the EU DPP CO P_DPP module.
LCAStudy is modelled in the EU DPP CO LCA module."""@en ;
                                     rdfs:label "has LCA study"@en .


###  https://w3id.org/eudpp#hasManufacturer
<https://w3id.org/eudpp#hasManufacturer> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#Product> ;
                                         rdfs:range <https://w3id.org/eudpp#Actor> ;
                                         rdfs:comment """A product has a manufacturer (Actor from ACTOR module).

Product is modelled in the EU DPP CO P_DPP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                         rdfs:label "has manufacturer"@en .


###  https://w3id.org/eudpp#hasMaterial
<https://w3id.org/eudpp#hasMaterial> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                                     rdfs:range <https://w3id.org/eudpp#MaterialOfComposition> ;
                                     rdfs:comment """Linking the Product to a MaterialOfComposition.

Product is modelled in the EU DPP CO P_DPP module.
MaterialOfComposition is modelled in the EU DPP CO MAT module."""@en ;
                                     rdfs:label "has material"@en .


###  https://w3id.org/eudpp#hasMaterialIdentifier
<https://w3id.org/eudpp#hasMaterialIdentifier> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://w3id.org/eudpp#MaterialOfComposition> ;
                                               rdfs:range <https://w3id.org/eudpp#MaterialIdentifier> ;
                                               rdfs:comment """Realisation of thematerial indetifier as \"Product parameters: identification of  ... materials [ESPR Annex I c)]\"

MaterialOfComposition is modelled in the EU DPP CO MAT module.
MaterialIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
                                               rdfs:label "has material identifier"@en .


###  https://w3id.org/eudpp#hasNotifiedBody
<https://w3id.org/eudpp#hasNotifiedBody> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                         rdfs:range <https://w3id.org/eudpp#Actor> ;
                                         <http://purl.org/dc/terms/references> "Decision No 768/2008/EC Annex I Chapter R4" ,
                                                                               "ESPR Chapter IX" ;
                                         <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                           "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#cpt_IX" ;
                                         rdfs:comment """Specifies the conformity assessment body notified in accordance with ESPR Chapter IX	

EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                         rdfs:label "has notified body"@en .


###  https://w3id.org/eudpp#hasResponsibleManufacturer
<https://w3id.org/eudpp#hasResponsibleManufacturer> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                                    rdfs:range <https://w3id.org/eudpp#Actor> ;
                                                    <http://purl.org/dc/terms/references> "Decision No 768/2008/EC Annex I Art R1 (3)" ,
                                                                                          "ESPR Annex V (2,9)" ;
                                                    <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                                      "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                                    rdfs:comment """Defines the natural or legal person responsible for the EU declaration of conformity.


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                                    rdfs:label "has responsible manufacturer"@en .


###  https://w3id.org/eudpp#hasUniqueFacilityIdentifier
<https://w3id.org/eudpp#hasUniqueFacilityIdentifier> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#Facility> ;
                                                     rdfs:range <https://w3id.org/eudpp#FacilityIdentifier> ;
                                                     <http://purl.org/dc/terms/references> "ESPR Art 2 (33)"@en ;
                                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                     rdfs:comment """Linking a Facility to its unique facility identifier.
Facility is modelled in the EU DPP CO ACTOR module.
FacilityIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
                                                     rdfs:label "has unique facility identifier"@en .


###  https://w3id.org/eudpp#hasUniqueOperatorIdentifier
<https://w3id.org/eudpp#hasUniqueOperatorIdentifier> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                                     rdfs:range <https://w3id.org/eudpp#ActorIdentifier> ;
                                                     <http://purl.org/dc/terms/references> "ESPR Art 2 (31)"@en ;
                                                     <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" ;
                                                     rdfs:comment """Linking an Actor to their unique operator identifier. 
Actor is modelled in the EU DPP CO ACTOR module.
ActorIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
                                                     rdfs:label "has unique operator identifier"@en .


###  https://w3id.org/eudpp#hasUniqueProductIdentifier
<https://w3id.org/eudpp#hasUniqueProductIdentifier> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://w3id.org/eudpp#Product> ;
                                                    rdfs:range <https://w3id.org/eudpp#ProductIdentifier> ;
                                                    rdfs:comment """Realisation of the uniqueProductIdentifier.

Product is modelled in the EU DPP CO P_DPP module.
ProductIdentifier is modelled in the EU DPP CO IDENT module."""@en ;
                                                    rdfs:label "has unique product identifier"@en .


###  https://w3id.org/eudpp#inContextOfDPP
<https://w3id.org/eudpp#inContextOfDPP> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                        rdfs:range <https://w3id.org/eudpp#DPP> ;
                                        rdfs:comment """Relates the actor role assignment to a specific Digital Product Passport instance (from P_DPP module).

ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
DPP is modelled in the EU DPP CO P_DPP module.
        """@en ;
                                        rdfs:label "in context of DPP"@en .


###  https://w3id.org/eudpp#inContextOfProduct
<https://w3id.org/eudpp#inContextOfProduct> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                            rdfs:range <https://w3id.org/eudpp#Product> ;
                                            rdfs:comment """Relates the actor role assignment to a specific product (from P_DPP module).

ActorRoleAssignment is modelled in the EU DPP CO ACTOR module.
Product is modelled in the EU DPP CO P_DPP module."""@en ;
                                            rdfs:label "in context of product"@en .


###  https://w3id.org/eudpp#isActorRoleAssignmentForEvent
<https://w3id.org/eudpp#isActorRoleAssignmentForEvent> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <https://w3id.org/eudpp#ActorRoleAssignment> ;
                                                       rdfs:range <https://w3id.org/eudpp#ESPREvent> ;
                                                       rdfs:comment """Links an actor-role assignment to the event context in which the role assignment applies. This is the inverse of evt:hasActorRoleAssignment and is managed in the Connector/mapping layer.

ESPREvent is modelled in the EU DPP CO EVENT module.
ActorRoleAssignment is modelled in the EU DPP CO ACTOR module."""@en ;
                                                       rdfs:label "is actor role assignment for event"@en .


###  https://w3id.org/eudpp#isConformWith
<https://w3id.org/eudpp#isConformWith> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Product> ;
                                       rdfs:comment "Specifies Union Harminised Lagislation for which conformity of the product is stated."@en ;
                                       rdfs:label "is conform with"@en .


###  https://w3id.org/eudpp#isConnectedTo
<https://w3id.org/eudpp#isConnectedTo> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#DPP> ;
                                       rdfs:range <https://w3id.org/eudpp#Facility> ;
                                       rdfs:comment """A DPP is connected to a facility.

DPP is modelled in the EU DPP CO P_DPP module.
Facility is modelled in the EU DPP CO ACTOR module."""@en ;
                                       rdfs:label "is connected to"@en .


###  https://w3id.org/eudpp#isIssuedBy
<https://w3id.org/eudpp#isIssuedBy> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                    rdfs:range <https://w3id.org/eudpp#Actor> ;
                                    <http://purl.org/dc/terms/references> "ESPR Annex V (3)" ;
                                    <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                    rdfs:comment """Specifies the natural or legal person issuing the Declaration of Conformity; ESPR Annex V, paragraph 3 requirement: \"This declaration of conformity is issued under the sole responsibility of the manufacturer:\"


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                    rdfs:label "issued by"@en .


###  https://w3id.org/eudpp#isNotifiedFor
<https://w3id.org/eudpp#isNotifiedFor> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                       rdfs:range <https://w3id.org/eudpp#UnionHarmonisationLegislation> ;
                                       <http://purl.org/dc/terms/references> "Decision No 768/2008/EC Annex I Art R23 (3)" ,
                                                                             "ESPR Article 56 (3)" ;
                                       <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I" ,
                                                                         "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_56" ;
                                       rdfs:comment """Specifies the conformity assessment activities, the conformity assessment module or modules and product or products concerned and the relevant attestation of competence	

UnionHarmonisationLegislation is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                       rdfs:label "is notified for"@en .


###  https://w3id.org/eudpp#isSignedBy
<https://w3id.org/eudpp#isSignedBy> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://w3id.org/eudpp#EUDeclarationOfConformity> ;
                                    rdfs:range <https://w3id.org/eudpp#Actor> ;
                                    <http://purl.org/dc/terms/references> "ESPR Annex V (9, 10)" ;
                                    <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                    rdfs:comment """Specifies the natural or legal person signying the Declaration of Conformity.


EUDeclarationOfConformity is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                    rdfs:label "is signed by"@en .


###  https://w3id.org/eudpp#issuesCertificate
<https://w3id.org/eudpp#issuesCertificate> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                           rdfs:range <https://w3id.org/eudpp#ConformityCertificate> ;
                                           <http://purl.org/dc/terms/references> "ESPR Annex V (7)" ;
                                           <http://purl.org/dc/terms/source> "https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#anx_%C2%A0V" ;
                                           rdfs:comment """Specifies conformity assessment certificate issued for a certification.


ConformityCertificate is modelled in the EU DPP CO COMP module.
Actor is modelled in the EU DPP CO ACTOR module."""@en ;
                                           rdfs:label "issues certificate"@en .


###  https://w3id.org/eudpp#performedAssessmentAccordingTo
<https://w3id.org/eudpp#performedAssessmentAccordingTo> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <https://w3id.org/eudpp#Actor> ;
                                                        rdfs:range <https://w3id.org/eudpp#ConformityAssessmentModule> ;
                                                        <http://purl.org/dc/terms/references> "ESPR Annex V (7)" ;
