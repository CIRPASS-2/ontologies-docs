    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#accordingTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#accordingTo">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ConformityCertificate"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4
Decision No 768/2008/EC Art 4</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43	
ESPR Art 43</terms:source>
        <rdfs:comment xml:lang="en">Property defining specifies conformity assess procedure/cerfication scheme underlying the cerfificate.</rdfs:comment>
        <rdfs:label xml:lang="en">according to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#allowsConformityAssessmentModule -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#allowsConformityAssessmentModule">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4
Decision No 768/2008/EC Art 4</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43
ESPR Art 43</terms:source>
        <rdfs:comment xml:lang="en">A property that specifies the conformity assment procedure applicable to the type of product</rdfs:comment>
        <rdfs:label xml:lang="en">allows Conformity Assessment Module</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#conformityDeclaredTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#conformityDeclaredTo">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <terms:source xml:lang="en">ESPR Annex V</terms:source>
        <rdfs:comment xml:lang="en">A property which specifies which Union Harmonisation Legislation conformity is declared to.</rdfs:comment>
        <rdfs:label xml:lang="en">conformity declared to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasUnionHarmonisationLegislation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasUnionHarmonisationLegislation">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#EUDeclarationOfConformity"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <terms:source xml:lang="en">ESPR Annex V, (5)</terms:source>
        <rdfs:comment xml:lang="en">A property providing the Union Harmonisation Legislation refered to in the EU Declaration of Conformity.</rdfs:comment>
        <rdfs:label xml:lang="en">has Union Harmonisation Legislation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#usedForPresumptionOfConformity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#usedForPresumptionOfConformity">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ProductRequirement"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I	
Decision No 768/2008/EC Annex I Art R8</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_41
ESPR Art 41</terms:source>
        <rdfs:comment xml:lang="en">This property specifies which harmonised standards (or parts thereof) was used to assess conformity with the Union harmonistation legislation.</rdfs:comment>
        <rdfs:label xml:lang="en">used for presumtion of conformity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#assignedELI -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#assignedELI">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#UnionHarmonisationLegislation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli-register/what_is_eli.html</terms:source>
        <rdfs:comment xml:lang="en">Standardised identification that makes it easier to identify and describe legislation across Europe.</rdfs:comment>
        <rdfs:label xml:lang="en">assigned ELI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#certificateNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#certificateNumber">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ConformityCertificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:source xml:lang="en">certificate number</terms:source>
        <rdfs:comment>Number of the certificate</rdfs:comment>
        <rdfs:label>certificate number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#certificateRevisionNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#certificateRevisionNumber">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ConformityCertificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Number of the revision of a certificate</rdfs:comment>
        <rdfs:label xml:lang="en">certificate revision number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#CommonSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp#CommonSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#TechnicalSpecification"/>
        <terms:source xml:lang="en">ESPR Art 42, https://eur-lex.europa.eu/eli/reg/2024/1781/oj#art_42</terms:source>
        <rdfs:comment xml:lang="en">Common specification means ecodesign requirements, essential requirements for digital product passports or test, measurement or calculation methods established by implementing acts adopted by the Commission for products covered by delegated acts pursuant to ESPR Article 4.</rdfs:comment>
        <rdfs:label xml:lang="en">Common Specification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ConformityAssessmentModule -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ConformityAssessmentModule">
        <terms:source xml:lang="en">Decision No 768/2008/EC Art 4, https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#art_4</terms:source>
        <terms:source xml:lang="en">ESPR Art 43, https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_43</terms:source>
        <rdfs:comment xml:lang="en">Conformity Assessment module means the possible conformity assessment elements that can be chosen, in accordance with certain criteria, to fullfill the conformity accessement required to be performed by Community harmonisation legislation in respect of a particular product.</rdfs:comment>
        <rdfs:label xml:lang="en">Conformity Assessment Module</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ConformityCertificate -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ConformityCertificate">
        <terms:source xml:lang="en">Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4, https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001</terms:source>
        <terms:source xml:lang="en">ESPR Annex III (e)</terms:source>
        <rdfs:comment xml:lang="en">Conformity assessment certificate for a certification. The blue guide uses the term &quot;cerficate of conformity&quot;. The ESPR uses &quot;conformity certificate&quot; as well as &quot;certificate&quot; and &quot;approval decision&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">Conformity Certificate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#EUDeclarationOfConformity -->


    <owl:Class rdf:about="https://w3id.org/eudpp#EUDeclarationOfConformity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:source xml:lang="en">Decision No 768/2008/EC Annex I Art R10, https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <terms:source xml:lang="en">ESPR Art 44, https://eur-lex.europa.eu/eli/reg/2024/1781/oj/#art_44</terms:source>
        <rdfs:comment xml:lang="en">The EU Declaration of Conformity shall state that the fulfilment of the ecodesign requirements specified in the applicable delegated acts adopted pursuant to ESPR Article 4 has been demonstrated or that a presumption of conformity applies in accordance with ESPR Article 41.</rdfs:comment>
        <rdfs:label xml:lang="en">EU Declaration of Conformity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#HarmonisedStandard -->


    <owl:Class rdf:about="https://w3id.org/eudpp#HarmonisedStandard">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductRequirement"/>
        <terms:source xml:lang="en">Regulation (EU) No 1025/2012 Art 2 (1c), https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2</terms:source>
        <rdfs:comment xml:lang="en">Harmonised Standard means a European standard adopted on the basis of a request made by the Commission for the application of Union harmonisation legislation.</rdfs:comment>
        <rdfs:label xml:lang="en">Harmonised Standard</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#OtherTechnicalSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp#OtherTechnicalSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#TechnicalSpecification"/>
        <terms:source xml:lang="en">ESPR Annex V, (6)</terms:source>
        <rdfs:comment xml:lang="en">Other technical specifications in relation to which conformity is declared.</rdfs:comment>
        <rdfs:label xml:lang="en">Other Technical Specification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductRequirement -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductRequirement">
        <rdfs:comment xml:lang="en">Product requirements means a requirement to be fullfilled by a product when placed on the market.</rdfs:comment>
        <rdfs:label xml:lang="en">Product Requirement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#TechnicalSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp#TechnicalSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductRequirement"/>
        <terms:source xml:lang="en">Regulation (EU) No 1025/2012 Art 2 (4)
https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32012R1025#art_2</terms:source>
        <rdfs:comment xml:lang="en">Technical specification means a document that prescribes technical requirements to be fulfilled by a product, process, service or system and which lays down one or more of the following: Common Specification or Other Technical Specification.</rdfs:comment>
        <rdfs:label xml:lang="en">Technical Specification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#UnionHarmonisationLegislation -->


    <owl:Class rdf:about="https://w3id.org/eudpp#UnionHarmonisationLegislation">
        <terms:source xml:lang="en">Decision No 768/2008/EC Annex I Art R1 (17)
https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_I</terms:source>
        <rdfs:comment xml:lang="en">Union Harmonisation Legislation shall mean any Union legislation harmonising the conditions for the marketing of products. Examples are directives, regulations and delegated acts.</rdfs:comment>
        <rdfs:label xml:lang="en">Union Harmonised Legislation</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#moduleA -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#moduleA">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II
Decision No 768/2008/EC Annex II</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001	
Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4</terms:source>
        <rdfs:comment xml:lang="en">Decision No 768/2008/EC module A

Internal production control</rdfs:comment>
        <rdfs:label xml:lang="en">module A</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#moduleA1 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#moduleA1">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II	
Decision No 768/2008/EC Annex II</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001	
Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4</terms:source>
        <rdfs:comment xml:lang="en">Decision No 768/2008/EC module A1.

Internal production control plus supervised product testing</rdfs:comment>
        <rdfs:label xml:lang="en">module A1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#moduleA2 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#moduleA2">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II
Decision No 768/2008/EC Annex II</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001	
Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4</terms:source>
        <rdfs:comment xml:lang="en">Decision No 768/2008/EC module A2

Internal production control plus supervised product checks at random intervals</rdfs:comment>
        <rdfs:label xml:lang="en">module A2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#moduleB -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#moduleB">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II
Decision No 768/2008/EC Annex II</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001	
Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4</terms:source>
        <rdfs:comment xml:lang="en">Decision No 768/2008/EC module B

EC-type examination</rdfs:comment>
        <rdfs:label xml:lang="en">module B</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#moduleC -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#moduleC">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II
Decision No 768/2008/EC Annex II</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001	
Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4</terms:source>
        <rdfs:comment xml:lang="en">Decision No 768/2008/EC module C

Conformity to type based on internal production control</rdfs:comment>
        <rdfs:label xml:lang="en">module C</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#moduleC1 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#moduleC1">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/eli/dec/2008/768(1)/oj#anx_II
Decision No 768/2008/EC Annex II</terms:source>
        <terms:source xml:lang="en">https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=oj:JOC_2022_247_R_0001	
Commission notice The ‘Blue Guide’ on the implementation of EU product rules 2022 Annex 4</terms:source>
        <rdfs:comment xml:lang="en">Decision No 768/2008/EC module C1

Conformity to type based on internal production control plus supervised product testing</rdfs:comment>
        <rdfs:label xml:lang="en">module C1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#moduleC2 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#moduleC2">
        <rdf:type rdf:resource="https://w3id.org/eudpp#ConformityAssessmentModule"/>
