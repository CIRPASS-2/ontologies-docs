  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid4"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (43)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A specific assignment representing the written mandate between a manufacturer and an authorised representative; [ESPR Art 2 (43)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Authorised representative role assignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#ActorRoleAssignment"
  }, {
    "@id" : "_:genid5"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#AuthorityRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Parent class for roles of authorities, such as market surveillance authority, customs authority, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Authority role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#CircularEconomyRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Parent class for roles related to circular economy, such as remanufacturer, refurbisher, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Circular economy role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#ConformityAssessmentRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (51)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Conformity assessment means the process demonstrating whether the ecodesign requirements set out in the relevant delegated acts adopted pursuant to Article 4 have been fulfilled; [ESPR Art 2 (51)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Conformity assessment role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EconomicOperatorRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (46)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Economic operator means the manufacturer, the authorised representative, the importer, the distributor, the dealer and the fulfilment service provider; [ESPR Art 2 (46)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Economic operator role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EndUserRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Parent class for roles of end users, such as consumer, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "End user role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EuropeanCommission",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://ec.europa.eu/eurostat/statistics-explained/index.php?title=Glossary:European_Commission_(EC)"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#LegalPerson"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The European Commission, abbreviated as EC, is the executive branch of the European Union."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "European Commission"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Facility",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://marketbusinessnews.com/financial-glossary/facility/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A Facility may be a place where specific activities occur. A production/manufacturing facility means a factory. The term may refer to any place that makes things, or plants that generate electricity."
  }, {
    "@language" : "en",
    "@value" : "Business facilities are structures that provide services to a business. This can include space for employees, technology, equipment and inventory. Facilities can be used for business administration, operations or to provide services to customers."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Facility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid6"
  }, {
    "@id" : "_:genid7"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#LegalPerson",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://www.merriam-webster.com/legal/legal%20person"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A body of persons or an entity (as a corporation) considered as having many of the rights and responsibilities of a natural person and especially the capacity to sue and be sued."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legal Person"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/eudpp#NaturalPerson"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#NaturalPerson",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://www.merriam-webster.com/legal/natural%20person"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A human being as distinguished from a person (as a corporation) created by operation of law"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Natural Person"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#Role",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "CIRPASS-2 User Stories 3.1"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://zenodo.org/records/17979585"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Role means a set of tasks typically performed by one actor. (e.g. Responsible Economic Operator, Independent operator); [CIRPASS-2 User Stories 3.1]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Role"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#actorName",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Name of an actor."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "actor name"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#assignmentValidFrom",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The date and time from which the actor role assignment is valid."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#ActorRoleAssignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "assignment valid from"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#assignmentValidTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The date and time until which the actor role assignment is valid."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#ActorRoleAssignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "assignment valid to"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#authorisedRepresentative",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (43)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#EconomicOperatorRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Authorised representative means any natural or legal person established in the Union that has received a written mandate from the manufacturer to act on the manufacturer’s behalf in relation to specified tasks with regard to the manufacturer’s obligations under this Regulation; [ESPR Art 2 (43)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Authorised Representative"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#conformityAssessmentBody",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (52)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#ConformityAssessmentRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Conformity assessment body means a body that performs conformity assessment activities including calibration, testing, certification and inspection; [ESPR Art 2 (52)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Conformity Assessment Body"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#consumer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Directive (EU) 2019/771, Art 2 (2)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "http://data.europa.eu/eli/dir/2019/771/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#EndUserRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Consumer means any natural person who, in relation to contracts covered by Directive (EU) 2019/771, is acting for purposes which are outside that person's trade, business, craft or profession; [Directive (EU) 2019/771, Art 2 (2)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Consumer"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/eudpp#customer"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#credentialAgency",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "CIRPASS-2 User Stories 3.1"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://zenodo.org/records/17979585"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A legal person that provides (professional) credentials to parties, which may be used to make and verify a variety of claims in the DPP, (ESPR) Art. 11 last paragraph. For example, a credentials agency could certify a professional repairer and provide appropriate credentials for the DPP system; [CIRPASS-2 User Stories 3.1]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Credential Agency"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#customer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (35)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#EndUserRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Customer means a natural or legal person that purchases, hires or receives a product for their own use whether or not acting for purposes which are outside their trade, business, craft or profession; [ESPR Art 2 (35)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Customer"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#customsAuthority",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2019/1020, Art 3 (24)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2019/1020/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#AuthorityRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Customs authorities means  customs authorities as defined in point 1 of Article 5 of Regulation (EU) No 952/2013; [Regulation (EU) 2019/1020, Art 3 (24)]"
  }, {
    "@language" : "en",
    "@value" : "Customs authorities means the customs administrations of the Member States responsible for applying the customs legislation and any other authorities empowered under national law to apply certain customs legislation (Regulation (EU) No 952/2013 Art 5 (1);"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Customs Authority"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#dealer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (55)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#EconomicOperatorRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Dealer means a distributor or any other natural or legal person that offers products for sale, hire or hire purchase, or that displays products, to end users in the course of a commercial activity, including through distance selling; and includes any natural or legal person that puts a product into service in the course of a commercial activity; [ESPR Art 2 (55)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Dealer"
  } ],
  "http://www.w3.org/2004/02/skos/core#related" : [ {
    "@id" : "https://w3id.org/eudpp#distributor"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#distributor",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (45)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#EconomicOperatorRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Distributor means any natural or legal person in the supply chain, other than the manufacturer or the importer, that makes a product available on the market; [ESPR Art 2 (45)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Distributor"
  } ],
  "http://www.w3.org/2004/02/skos/core#related" : [ {
    "@id" : "https://w3id.org/eudpp#dealer"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#dppServiceProvider",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (32)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Digital product passport service provider means a natural or legal person that is an independent third-party authorised by the economic operator which places the product on the market or puts it into service and that processes the digital product passport data for that product for the purpose of making such data available to economic operators and other relevant actors with a right to access those data under this Regulation or other Union law; [ESPR Art 2 (32)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DPP Service Provider"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#endUser",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2019/1020, Art 3 (21)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2019/1020/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#EndUserRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "End user means any natural or legal person residing or established in the Union, to whom a product has been made available either as a consumer outside of any trade, business, craft or profession or as a professional end user in the course of its industrial or professional activities; [Regulation (EU) 2019/1020  Art 3 (21)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "End User"
  } ],
  "http://www.w3.org/2004/02/skos/core#related" : [ {
    "@id" : "https://w3id.org/eudpp#customer"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#fulfilmentServiceProvider",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2019/1020, Art 3 (11)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2019/1020/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#EconomicOperatorRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Fulfilment service provider means any natural or legal person offering, in the course of commercial activity, at least two of the following services: warehousing, packaging, addressing and dispatching, without having ownership of the products involved, excluding postal services as defined in point 1 of Article 2 of Directive 97/67/EC of the European Parliament and of the Council (31), parcel delivery services as defined in point 2 of Article 2 of Regulation (EU) 2018/644 of the European Parliament and of the Council (32), and any other postal services or freight transport services; [Regulation (EU) 2019/1020 Art 3 (11)]."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Fulfilment Service Provider"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#hasActor",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links actor role assignment to actor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#ActorRoleAssignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has actor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#hasRepresentativeMandate",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates a manufacturer to the mandate (assignment) that authorises an actor to act on the manufacturer's behalf."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has representative mandate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/eudpp#representsManufacturer"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#hasRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links an actor role assignment to a role."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#ActorRoleAssignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/eudpp#isRoleOf"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#importer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (44)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#EconomicOperatorRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Importer means any natural or legal person established in the Union that places a product from a third country on the Union market; [ESPR Art 2 (44)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Importer"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#independentOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (47)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#CircularEconomyRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Independent operator means natural or legal person that is independent of the manufacturer and is directly or indirectly involved in the refurbishment, repair, maintenance or repurposing of a product, and includes waste management operators, refurbishers, repairers, manufacturers or distributors of repair equipment, tools or spare parts, as well as publishers of technical information, operators offering inspection and testing services and operators offering training for installers, manufacturers and repairers of equipment; [ESPR Art 2 (47)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Independent Operator"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#isEstablishedIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates a legal person to the location where it is established."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#LegalPerson"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is established in"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.org/dc/terms/Location"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#isResidingIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates a natural person to the location where they reside."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#NaturalPerson"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is residing in"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.org/dc/terms/Location"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#isRoleOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates role to an actor role assignment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is role of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/eudpp#ActorRoleAssignment"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#isUsedByActor",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates a facility to an actor."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#Facility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is used by actor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/eudpp#usesFacility"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#issuingAgency",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 12 (4a)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Issuing agency is a legal persons that provide unique identifiers and data carriers Art 12 (4a). Under specific conditions, economic operators may perform the functions associated with an Issuing Agency; [ESPR Art 12 (4b)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Issuing Agency"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#manufacturer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (42)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#EconomicOperatorRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Manufacturer means any natural or legal person that manufactures a product or that has a product designed or manufactured and markets that product under their name or trademark; [ESPR Art 2 (42)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Manufacturer"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#marketSurveillanceAuthority",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2019/1020, Art 3 (4)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2019/1020/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#AuthorityRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Market surveillance authority means an authority designated by a Member State under Article 10 as responsible for carrying out market surveillance in the territory of that Member State; [Regulation (EU) 2019/1020 Art 3 (4)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Market Surveillance Authority"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#notifiedBody",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (53)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#ConformityAssessmentRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Notified body means a conformity assessment body notified in accordance with Chapter IX.; [ESPR Art 2 (53)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Notified Body"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#professionalRepairer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (48)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#CircularEconomyRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Professional repairer means a natural or legal person that provides professional repair or maintenance services for a product, irrespective of whether that person acts within the manufacturer’s distribution system or independently; [ESPR Art 2 (48)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Professional Repairer"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#recycler",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "WFD Art 3 (17)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/dir/2008/98/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#CircularEconomyRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An actor performing recycling, which means \"any recovery operation by which waste materials are reprocessed into products, materials or substances whether for the original or other purposes. It includes the reprocessing of organic material but does not include energy recovery and the reprocessing into materials that are to be used as fuels or for backfilling operations\" [WFD Art 3 (17)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Recycler"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/eudpp#independentOperator"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#refurbisher",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (18)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#CircularEconomyRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An actor performing refurbishment, which means \"actions carried out to prepare, clean, test, service and, where necessary, repair a product or a discarded product in order to restore its performance or functionality within the intended use and range of performance originally conceived at the design stage at the time of the placing of the product on the market.\"; [ESPR Art 2 (18)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Refurbisher"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/eudpp#independentOperator"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#registeredTradeName",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Trade name under which a legal person or business operates and is registered."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "registered trade name"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#registeredTrademark",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A trademark officially registered and owned by an actor."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "registered trademark"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#remanufacturer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "ESPR Art 2 (16)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/eudpp#CircularEconomyRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An actor performing remanufacturing, which means \"actions through which a new product is produced from objects that are waste, products or components and through which at least one change is made that substantially affects the safety, performance, purpose or type of the product\"; [ESPR Art 2 (16)]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Remanufacturer"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/eudpp#manufacturer"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#representsManufacturer",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Used when the role is authorisedRepresentativeRole to indicate the manufacturer being represented."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#AuthorisedRepresentativeRoleAssignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "represents manufacturer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#usesFacility",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates an actor to facility."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/eudpp#Actor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "uses facility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/eudpp#Facility"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/ACTOR",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@language" : "en",
    "@value" : "Hele-Mai Haav"
  }, {
    "@language" : "en",
    "@value" : "Tarmo Robal"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-03-14"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@language" : "en",
    "@value" : "Riina Maigre"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Actor module of an EU DPP core ontology proposal of the CIRPASS-2 European project.\n\nDEPENDENCIES:  This module has dependencies to the following EU DPP Core Ontology modules: CON, P_DPP, EVENT.  \n\nFor more information, see \nMaigre, R., Haav, H.-M., Robal, T., Wolf, M.-A., &amp; Danash, F. (2025). Ontology Requirements Specification for an EU DPP Core Ontology Proposal (1.1). CIRPASS-2 Consortium. https://doi.org/10.5281/zenodo.15270342\n\n\n        "
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-09-22"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://www.apache.org/licenses/LICENSE-2.0"
  }, {
    "@language" : "en",
    "@value" : "This ontology is licensed under the Apache License, Version 2.0. \nIn case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-04-30"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Actors and roles module for an EU DPP core ontology proposed by CIRPASS-2 European project."
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "act"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Actor module of an EU DPP core ontology proposed by the CIRPASS-2 European project."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EU DPP CO ACTOR"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "2.0.1"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp:references",
