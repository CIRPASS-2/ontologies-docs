    <!-- https://w3id.org/eudpp#hasGranularity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasGranularity">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#IdentifierGranularity"/>
        <rdfs:comment xml:lang="en">Defines the granularity of an identifier, if exists.</rdfs:comment>
        <rdfs:label xml:lang="en">has granularity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp#hasScheme -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasScheme">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:comment>The scheme/standard the Identifier follows</rdfs:comment>
        <rdfs:label xml:lang="en">has scheme</rdfs:label>
    </owl:ObjectProperty>
    


