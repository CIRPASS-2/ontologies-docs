    <!-- https://w3id.org/eudpp#identifierExampleValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierExampleValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Example value of the identifier</rdfs:comment>
        <rdfs:label xml:lang="en">identifier example value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierExpiresOn -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierExpiresOn">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">identifier expires on</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierIssuedOn -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierIssuedOn">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">identifier issued on</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierMaxLength -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierMaxLength">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Maximum length of the identifier</rdfs:comment>
        <rdfs:label xml:lang="en">identifier maximum length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierMinLength -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierMinLength">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Minimum length of the identifier</rdfs:comment>
        <rdfs:label xml:lang="en">identifier minimum length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierPattern -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierPattern">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A pattern the identifier conforms to, given as a regular expression (regex).</rdfs:comment>
        <rdfs:label xml:lang="en">identifier pattern</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierSchemeIssuer -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierSchemeIssuer">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Issuer of the identifier scheme</rdfs:comment>
        <rdfs:label xml:lang="en">identifier scheme issuer</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierSchemeVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierSchemeVersion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Reference standard version the instance schema refers to</rdfs:comment>
        <rdfs:label xml:lang="en">identifier scheme version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp#identifierValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp#identifierValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The (unique) value of the identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">identifier value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#ActorIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ActorIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasScheme"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp#ActorIdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#DPPIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#FacilityIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#MaterialIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SoCIdentifier"/>
        <rdfs:comment xml:lang="en">A type of identifier to identify Actors. A unique code assigned to Actor based on a scheme.</rdfs:comment>
        <rdfs:label xml:lang="en">Actor identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ActorIdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ActorIdentifierScheme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#MaterialIdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <rdfs:comment xml:lang="en">A kind of identifier scheme. The scheme or standard used to identify Actors. e.g., GLN, LEI, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Actor identifier scheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#DPPIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#DPPIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#FacilityIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#MaterialIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SoCIdentifier"/>
        <rdfs:comment xml:lang="en">A type of identifier to identify DPP. DPP Identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">DPP identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#FacilityIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#FacilityIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#MaterialIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SoCIdentifier"/>
        <rdfs:comment xml:lang="en">A unique code assigned to a physical site (factory, warehouse, plant, school, hospital, etc.), i.e., identifies a location.</rdfs:comment>
        <rdfs:label xml:lang="en">Facility identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#Identifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Identifier">
        <rdfs:comment xml:lang="en">Identifier. A general class to hold different kinds of identifiers described and used for EU DPP CO. Each sub-class of this class describes a different kind of identifier. Intentionally modelled as sub-classes. 
Identifiers have value, and a scheme/standard they are based on.

Cardinatlity restrictions added to each subclass to enforce inheritance of the data propertyy identifierValue.</rdfs:comment>
        <rdfs:label>Identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#IdentifierGranularity -->


    <owl:Class rdf:about="https://w3id.org/eudpp#IdentifierGranularity">
        <rdfs:comment xml:lang="en">The granularity of the identifier. For example, for Products this could be model, batch, item.</rdfs:comment>
        <rdfs:label xml:lang="en">Identifier granularity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#IdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#IdentifierScheme">
        <rdfs:comment xml:lang="en">The scheme or standard used for Identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">Identifier scheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasScheme"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp#MaterialIdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifier"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SoCIdentifier"/>
        <rdfs:comment xml:lang="en">A type of identifier to identify materials. A unique code assigned to Material based on a scheme.</rdfs:comment>
        <rdfs:label xml:lang="en">Material identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#MaterialIdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialIdentifierScheme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
        <rdfs:comment xml:lang="en">A kind of identifier scheme. The scheme or standard used to identify materials, e.g., CAS.</rdfs:comment>
        <rdfs:label xml:lang="en">Material identifier scheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasScheme"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp#ProductIdentifierScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#hasGranularity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/eudpp#ProductIdentifierGranularity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp#SoCIdentifier"/>
        <rdfs:comment xml:lang="en">A type of identifier to identify Products. A unique code assigned to identify a product. e.g., GTIN.</rdfs:comment>
        <rdfs:label xml:lang="en">Product identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductIdentifierGranularity -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductIdentifierGranularity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#batch"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#item"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp#model"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#IdentifierGranularity"/>
        <rdfs:comment xml:lang="en">The granularity level (batch, item, model) at which the product identifier represents the product.</rdfs:comment>
        <rdfs:label xml:lang="en">Product identifier granularity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#ProductIdentifierScheme -->


    <owl:Class rdf:about="https://w3id.org/eudpp#ProductIdentifierScheme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#IdentifierScheme"/>
        <rdfs:comment xml:lang="en">A kind of identifier scheme. The scheme or standard used to identify Products, e.g., GTIN, SKU, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Product identifier scheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp#SoCIdentifier -->


    <owl:Class rdf:about="https://w3id.org/eudpp#SoCIdentifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp#identifierValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A type of identifier to identify substances of concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Substance of concern identifier</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#CAS -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#CAS">
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialIdentifierScheme"/>
        <eudpp:identifierExampleValue>7732-18-5</eudpp:identifierExampleValue>
        <eudpp:identifierMaxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</eudpp:identifierMaxLength>
        <eudpp:identifierMinLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</eudpp:identifierMinLength>
        <rdfs:comment xml:lang="en">CAS Number (Chemical Abstracts Service)</rdfs:comment>
        <rdfs:label xml:lang="en">CAS</rdfs:label>
        <rdfs:seeAlso>https://www.cas.org/support/documentation/chemical-substances/faqs</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">Chemical Abstracts Service Registry Number</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp#EORI -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp#EORI">
        <eudpp:identifierExampleValue>DE123456789012345</eudpp:identifierExampleValue>
        <eudpp:identifierMaxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</eudpp:identifierMaxLength>
        <eudpp:identifierMinLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</eudpp:identifierMinLength>
        <rdfs:comment xml:lang="en">Economic Operators Registration and Identification (EU).
This is the EU’s official identifier for companies involved in import/export.
Mandatory for any company trading with the EU.

Used in customs declarations
Unique per company

Format: country code + number (e.g., DE123456789)

This is the most widely used identifier for economic operators in EU trade.</rdfs:comment>
        <rdfs:label xml:lang="en">EORI</rdfs:label>
