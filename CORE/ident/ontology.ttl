                                             rdfs:range xsd:integer ;
                                             rdfs:comment "Minimum length of the identifier"@en ;
                                             rdfs:label "identifier minimum length"@en .


###  https://w3id.org/eudpp#identifierPattern
<https://w3id.org/eudpp#identifierPattern> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://w3id.org/eudpp#IdentifierScheme> ;
                                           rdfs:range xsd:string ;
                                           rdfs:comment "A pattern the identifier conforms to, given as a regular expression (regex)."@en ;
                                           rdfs:label "identifier pattern"@en .


###  https://w3id.org/eudpp#identifierSchemeIssuer
<https://w3id.org/eudpp#identifierSchemeIssuer> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://w3id.org/eudpp#IdentifierScheme> ;
                                                rdfs:range xsd:string ;
                                                rdfs:comment "Issuer of the identifier scheme"@en ;
                                                rdfs:label "identifier scheme issuer"@en .


###  https://w3id.org/eudpp#identifierSchemeVersion
<https://w3id.org/eudpp#identifierSchemeVersion> rdf:type owl:DatatypeProperty ;
