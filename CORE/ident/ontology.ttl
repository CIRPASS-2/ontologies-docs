                                             rdfs:range xsd:integer ;
                                             rdfs:comment "Maximum length of the identifier"@en ;
                                             rdfs:label "identifier maximum length"@en .


###  https://w3id.org/eudpp#identifierMinLength
<https://w3id.org/eudpp#identifierMinLength> rdf:type owl:DatatypeProperty ;
