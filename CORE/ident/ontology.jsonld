  } ]
}, {
  "@id" : "https://w3id.org/eudpp#EORI",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Economic Operators Registration and Identification (EU).\nThis is the EU’s official identifier for companies involved in import/export.\nMandatory for any company trading with the EU.\n\nUsed in customs declarations\nUnique per company\n\nFormat: country code + number (e.g., DE123456789)\n\nThis is the most widely used identifier for economic operators in EU trade."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EORI"
  }, {
    "@value" : "https://taxation-customs.ec.europa.eu/customs/customs-procedures-import-and-export/customs-operations/economic-operators-registration-and-identification-number-eori_en"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Economic Operators Registration and Identification (EU"
  } ],
  "https://w3id.org/eudpp#identifierExampleValue" : [ {
    "@value" : "DE123456789012345"
  } ],
  "https://w3id.org/eudpp#identifierMaxLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "17"
  } ],
  "https://w3id.org/eudpp#identifierMinLength" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "8"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp#FacilityIdentifier",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A unique code assigned to a physical site (factory, warehouse, plant, school, hospital, etc.), i.e., identifies a location."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Facility identifier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Identifier"
  }, {
    "@id" : "_:genid4"
  } ],
