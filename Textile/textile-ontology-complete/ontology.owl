    <!-- https://w3id.org/eudpp/textile-repairability#Upgradability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#Upgradability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Ability of a product to be accessible for actions that enhance functionality, performance, capacity, safety or aesthetics.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Upgradability</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 9.1.2, printed pages 101-102, lines 2722-2728; JRC Preparatory Study, Section 13.10.1.4, printed page 472, lines 11264-11272; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#UpgradeProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#UpgradeProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#UserAcceptanceCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#UserAcceptanceCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Contextual condition concerning whether a user accepts the restored function and potentially changed aesthetics of the product after repair.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">User acceptance condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3419-3428.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#UserAcceptanceStatusConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#UserAcceptanceStatusConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#RatingValueConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled rating-value concept describing the recorded acceptance status of a repaired product in a stated assessment context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">User acceptance status concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#NonTextileComponentMaterialGroup -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#NonTextileComponentMaterialGroup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#MaterialGroup"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A material grouping associated with one or more non-textile components, used as a location or concentration reference unit without treating the component itself as a material group.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Non-textile component material group</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileConcentrationInformation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileConcentrationInformation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#ConcentrationInformation"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Concentration information for a substance present in a textile product, expressed at product, component, material-group or spare-part level as an exact value, maximum value or range.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile concentration information</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Regulation (EU) 2024/1781, Article 7(5)(c)</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileFibreCompositionMaterialGroup -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileFibreCompositionMaterialGroup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#FibreCompositionComponent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-soc#TextileMaterialGroup"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Bridge class for a fibre-composition component that is used as the material-group scope of a textile substance-of-concern presence context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile fibre-composition material group</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This local bridge avoids globally reclassifying every Textile Core fibre-composition component as a SoC material group.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 12.3.12, printed page 246, lines 6847-6863.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileMaterialGroup -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileMaterialGroup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#MaterialGroup"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A fibre-, yarn- or fabric-based material grouping within a textile product that serves as a location or mass-reference unit for substance reporting.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile material group</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileProductGroupSoCReference -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileProductGroupSoCReference">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#ProductGroupSpecificSoCList"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A versioned reference identifying the textile-product-group source that qualifies a substance under the product-group-specific type (d) criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile product-group SoC reference</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Regulation (EU) 2024/1781, Article 2(27)(d).</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileRecyclingAlertThreshold -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileRecyclingAlertThreshold">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#AlertConcentrationThreshold"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A textile-sector alert concentration used to inform sorting, recycling or environmentally sound end-of-life handling when the substance may hinder circular treatment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile recycling alert threshold</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.2, printed page 142, lines 3910-3927; Section 12.3.12, printed page 246, lines 6823-6863.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileSoCHandlingInformation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileSoCHandlingInformation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#InstructionInformation"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Textile-specific instruction information concerning safe use and lifecycle handling in the presence of a substance of concern, including disassembly, preparation for reuse, reuse, recycling and environmentally sound end-of-life management; repair guidance may be added as a textile/JRC extension.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile SoC handling information</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 12.1, printed pages 219-220, lines 6205-6220.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileSoCLocationTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileSoCLocationTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept describing a textile-specific kind of product location used to qualify a substance location statement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile SoC location type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">ESPR Annex I; JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#SubstanceOfConcernPresenceContext"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A substance-of-concern presence context specialised for a textile product, textile material group or non-textile component.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile substance of concern presence context</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Regulation (EU) 2024/1781, Article 2(27) and Article 7(5); core pivot pattern soc:SubstanceOfConcernPresenceContext</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileTrackingThreshold -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileTrackingThreshold">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#TrackingThreshold"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A tracking or disclosure threshold applicable to a substance occurrence in a textile product or textile product group.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile tracking threshold</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 12.1, printed page 220, lines 6213-6220; Section 12.3.12, printed page 246, lines 6823-6863.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileTypeDQualification -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileTypeDQualification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#SoCTypeDQualification"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A product-group-specific type (d) qualification indicating that a substance hinders the reuse or recycling of a textile product or textile material stream.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile type (d) qualification</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 12.1, printed page 219, lines 6169-6170; Section 12.3.6, printed pages 238-239, lines 6634-6639; Section 12.3.11, printed page 246, lines 6815-6822.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Characteristic of garment or textile assembly, including seams, sewing and cutting quality.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Assembly characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Structural superclass introduced to organise the module; not necessarily a verbatim JRC term.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#CutPrecision -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#CutPrecision">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assembly characteristic concerning precision of cutting or pattern construction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Cut precision</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Cut precision may influence assembly quality and seam performance, but it is reconstructed here mainly to prepare links with the future confectioning process model.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Reconstructed concept added to support future links with confectioning process and final product quality.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Table 182, printed pages 494-495; table caption at line 11907; supporting text on printed page 495, lines 11927-11932.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#SeamStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricAppearance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricAppearance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricVisualCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric visual characteristic concerning the overall visible appearance or visual quality of a fabric.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric appearance</rdfs:label>
        <skos:altLabel xml:lang="en">Fabric visual appearance</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric appearance is represented as a fabric visual characteristic in TEXTILE_STRUCTURE. Observed changes in fabric appearance after use or cleaning cycles should be represented in TEXTILE_DURABILITY or TEXTILE_ASSESSMENT, not as the structural characteristic itself.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricBehaviouralCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricBehaviouralCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fabric-level characteristic concerning the physical behaviour of a fabric under use, gravity, movement, care or stress conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric behavioural characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This superclass organises fabric drape without reducing it either to a purely structural dimension or to an assessment result.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricBreathability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricBreathability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricFunctionalCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric functional characteristic concerning the passage of water vapour through the fabric and evaporative cooling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric breathability</rdfs:label>
        <skos:altLabel xml:lang="en">Air permeability</skos:altLabel>
        <skos:altLabel xml:lang="en">Breathability</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric breathability is represented in TEXTILE_STRUCTURE as a fabric-level functional characteristic, not as a TEXTILE_CORE product class and not as an assessment result.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fabric-level characteristic relevant to durability, comfort, appearance or functional performance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This superclass avoids forcing tactile fabric properties such as fabric handle under a purely structural fabric category.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricConstructionCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricConstructionCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fabric structural characteristic concerning fabric construction, density, mass per area or arrangement of yarns/threads.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric construction characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This superclass distinguishes structural fabric characteristics from process parameters in TEXTILE_PROCESS. The same real-world quantity may be represented as a process target/parameter in TEXTILE_PROCESS and as a product/fabric characteristic in TEXTILE_STRUCTURE, but these roles should be kept explicit.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricDrape -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricDrape">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricBehaviouralCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric behavioural characteristic concerning how a fabric hangs in three dimensions and adapts to contours.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric drape</rdfs:label>
        <skos:altLabel xml:lang="en">Drape</skos:altLabel>
        <skos:altLabel xml:lang="en">Drapeability</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric drape is modelled as a fabric behavioural characteristic. Concrete drape measurements, test methods or performance levels should be represented in TEXTILE_ASSESSMENT.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricElasticity -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricElasticity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric structural characteristic denoting elastic behaviour of the fabric.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric elasticity</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric elasticity may influence dimensional stability and wrinkle recovery; the relation depends on fibre composition, yarn structure and fabric construction.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Reconstructed concept added to support relations between fabric manufacturing methods, fabric structure and deformation performance.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 178-179, printed pages 488-490; captions at lines 11875 and 11877.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#DimensionalStability"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#Wrinkling"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricFunctionalCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricFunctionalCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fabric-level characteristic concerning functional performance relevant to use, comfort or intended application.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric functional characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This superclass keeps functional fabric characteristics out of TEXTILE_CORE and separate from observed durability parameters.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricHandle -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricHandle">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricTactileCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric tactile characteristic concerning softness, smoothness, flexibility and overall sensation when touched.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric handle</rdfs:label>
        <skos:altLabel xml:lang="en">Fabric hand</skos:altLabel>
        <skos:altLabel xml:lang="en">Fabric softness</skos:altLabel>
        <skos:altLabel xml:lang="en">Hand feel</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric handle is modelled as a fabric tactile characteristic, not as a simple fabric structural characteristic and not as an assessment result. Quantitative or qualitative measurements of softness, handle or touch should be represented through the assessment module when a concrete method or result is recorded.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Table 180 relates fabric softness or handle to fibre characteristics. The influence links are represented as weak annotation-level relations, not as deterministic OWL causal axioms.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricInsulation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricInsulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricFunctionalCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric functional characteristic concerning the retention of heat and reduction of heat transfer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric insulation</rdfs:label>
        <skos:altLabel xml:lang="en">Insulation</skos:altLabel>
        <skos:altLabel xml:lang="en">Thermal insulation</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric insulation is represented as a fabric-level functional characteristic. Concrete insulation values or standard test results should be represented in TEXTILE_ASSESSMENT.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricLustre -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricLustre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricVisualCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric visual characteristic concerning the reflection of light that creates a shiny or glossy appearance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric lustre</rdfs:label>
        <skos:altLabel xml:lang="en">Fabric luster</skos:altLabel>
        <skos:altLabel xml:lang="en">Fabric sheen</skos:altLabel>
        <skos:altLabel xml:lang="en">Fabric shininess</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Concrete observations or measurements of lustre, shininess or appearance should be represented through the assessment module when a test method, visual inspection protocol or measured value is recorded.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Table 180 reports that fabric shininess increases with the increase of fibre length and fibre fineness. Fabric lustre is modelled as a fabric visual characteristic, not as a structural dimension and not as an assessment result.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricMassPerUnitArea -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricMassPerUnitArea">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricConstructionCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric construction characteristic expressing the mass of fabric per unit surface area.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric mass per unit area</rdfs:label>
        <skos:altLabel xml:lang="en">Fabric grammage</skos:altLabel>
        <skos:altLabel xml:lang="en">Fabric weight</skos:altLabel>
        <textile-connector:modellingNote xml:lang="en">The preferred term uses mass rather than weight, following the technical note in JRC Section 2, page 14, footnote 15. Expected SI quantity kind: quantities:SUDE (surface density).</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 4.5, printed page 41, lines 1018-1020; JRC Preparatory Study, Section 13.10.2, printed pages 493-494, lines 11902-11915; Table 182, printed page 494, caption line 11907.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricBreathability"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricDrape"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricInsulation"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricRigidity -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricRigidity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric structural characteristic denoting rigidity or stiffness.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric rigidity</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric rigidity may influence wrinkling and deformation behaviour, but the direction and acceptability depend on product type and fabric construction.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Reconstructed concept added to support relations between fabric manufacturing methods and fabric behaviour.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 178-179, printed pages 488-490; captions at lines 11875 and 11877.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#Wrinkling"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Characteristic of fabric structure or fabric-level physical behaviour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric structural characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Specific fabric structural characteristics are included as reconstructed or strongly implied concepts where needed to represent relations extracted from the JRC study.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricTactileCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricTactileCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fabric-level characteristic concerning touch, hand-feel or perceived tactile behaviour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric tactile characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This superclass organises G-006 Fabric handle / fabric softness without treating it as a purely structural dimension or as an assessment result.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FabricVisualCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FabricVisualCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fabric-level characteristic concerning visible appearance, lustre, shininess, sheen or other visual qualities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fabric visual characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This superclass organises G-007 Fabric lustre / fabric shininess without treating it as a purely structural dimension or as an assessment result.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FibreCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FibreCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A characteristic of a textile fibre that can influence yarn manufacture, fabric behaviour and durability-related performance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fibre characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This class corresponds to the aggregated MAT-001 concept. MAT-004 Fibre type is represented in TEXTILE_CORE through txt:FibreTypeConcept and txtcs:FibreTypeScheme, and used through txt:hasFibreType on txt:FibreCompositionComponent. It is therefore not duplicated as a textile structure class in this module.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FibreCleanliness -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FibreCleanliness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreQualityCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fibre quality characteristic concerning impurities or foreign matter remaining in the fibre.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fibre cleanliness</rdfs:label>
        <skos:editorialNote xml:lang="en">The term is named FibreCleanliness rather than FibreCleanness, following standard textile and English usage.</skos:editorialNote>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">A weak influence link from fibre cleanliness to yarn appearance is represented in this module. The corresponding link to fabric appearance remains pending until a fabric appearance target concept is introduced.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Fibre cleanliness is modelled as a fibre quality characteristic, not as a structural dimension such as length, fineness or section shape. Quantitative or qualitative measurements of contamination, trash content or impurity levels should be represented through assessment results.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricAppearance"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnAppearance"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FibreColour -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FibreColour">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#VisualFibreCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Visual fibre characteristic concerning the colour of a fibre and its influence on dyeing or bleaching behaviour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fibre colour</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FibreElasticity -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FibreElasticity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#MechanicalFibreCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Mechanical fibre characteristic concerning deformation and recovery after removal of a load.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fibre elasticity</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fibre elasticity may influence wrinkling behaviour through recovery behaviour. The relation is context-dependent and mediated by fabric and garment structure.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#Wrinkling"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FibreFineness -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FibreFineness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#StructuralFibreCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Structural fibre characteristic expressing fibre fineness or linear density.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fibre fineness</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fibre fineness typically affects yarn uniformity and regularity, but the direction and magnitude depend on fibre type and process conditions.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-process#SpinningLimit"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-process#SpinningProductivity"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricDrape"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricHandle"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricLustre"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnHairiness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FibreLength -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FibreLength">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#StructuralFibreCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Structural fibre characteristic expressing the length of textile fibres.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fibre length</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fibre length is modelled as typically influencing yarn strength through yarn structure. The relation should not be interpreted as a deterministic rule.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-process#SpinningLimit"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-process#SpinningProductivity"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricHandle"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricLustre"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnHairiness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FibreQualityCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FibreQualityCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fibre characteristic concerning fibre quality conditions that are not purely structural, mechanical, physical or visual.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fibre quality characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This superclass was introduced to avoid forcing fibre cleanliness under a purely structural or visual fibre characteristic. It organises G-002 without changing the semantics of existing fibre characteristic subclasses.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FibreSectionShape -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FibreSectionShape">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#StructuralFibreCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Structural fibre characteristic expressing the cross-sectional shape of textile fibres.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fibre section shape</rdfs:label>
        <skos:altLabel xml:lang="en">Fibre cross-section shape</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#FibreStrength -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#FibreStrength">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#MechanicalFibreCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Mechanical fibre characteristic expressing resistance of fibres to tensile stress or breakage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Fibre strength</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fibre strength typically contributes to yarn strength as a mechanical input.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-process#SpinningLimit"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-process#SpinningProductivity"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnHairiness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Characteristic of an intermediate textile structure such as yarn, fabric, resistance property or assembly.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Intermediate textile characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Structural superclass introduced to organise the module; not necessarily a verbatim JRC term.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#MechanicalFibreCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#MechanicalFibreCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fibre characteristic concerning mechanical behaviour such as strength or elasticity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Mechanical fibre characteristic</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#MoistureRetention -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#MoistureRetention">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#PhysicalFibreCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Physical fibre characteristic concerning the capacity of fibres to absorb or retain moisture.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Moisture retention</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 178-179, printed pages 488-490; captions at lines 11875 and 11877.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#PhysicalFibreCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#PhysicalFibreCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fibre characteristic concerning physical behaviour such as moisture retention.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Physical fibre characteristic</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#ResistanceCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#ResistanceCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Structural or material resistance characteristic, distinct from the observed degradation phenomenon itself.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Resistance characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Resistance characteristics are distinct from the observed degradation phenomena themselves. For example, pilling resistance is not the same as observed pilling.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Structural superclass introduced to organise the module; not necessarily a verbatim JRC term.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#SeamStrength -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#SeamStrength">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assembly characteristic expressing the mechanical strength or integrity of a seam.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Seam strength</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Seam strength typically reduces the likelihood of seam-related failure modes and influences seam slippage behaviour.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Table 182, printed pages 494-495; table caption at line 11907; supporting text on printed page 495, lines 11927-11932.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#SeamSlippage"/>
        <textile-connector:typicallyReducesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#SeamFailure"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#SewingCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#SewingCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assembly characteristic concerning sewing quality or sewing-related construction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Sewing characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Reconstructed concept added to support future links with confectioning process and seam-related durability.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Sewing characteristics may influence seam strength and final product durability. Detailed process parameters should be represented in TEXTILE_PROCESS.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Table 182, printed pages 494-495; table caption at line 11907; supporting text on printed page 495, lines 11927-11932.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#SeamStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#StructuralFibreCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#StructuralFibreCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fibre characteristic concerning fibre structure, morphology or geometry.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Structural fibre characteristic</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A property describing the structure, physical constitution, mechanical behaviour, tactile quality, visual quality or functional behaviour of a textile fibre, yarn, fabric or assembly.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Textile structure characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Modelled as a subclass of dpp:Property because instances are linked from products through a subproperty of dpp:hasProperty.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Structural characteristics are disjoint from observed performance parameters, degradation phenomena and failure modes. For example, pilling resistance is a structure/resistance characteristic, while pilling is an observed degradation phenomenon.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Structural superclass introduced to organise the module; not necessarily a verbatim JRC term.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">This is the top-level class for structural characteristics in the textile structure module. It should not be used for observed durability performance parameters themselves.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 177-182, printed pages 486-495; captions at lines 11873-11907.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#ThreadCount -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#ThreadCount">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricConstructionCharacteristic"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#VisualFibreCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#VisualFibreCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Fibre characteristic concerning visual properties such as colour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Visual fibre characteristic</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnAppearance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnAppearance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnVisualCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Yarn visual characteristic concerning diameter, hairiness, visible defects and overall appearance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn appearance</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Quantitative or qualitative observations of yarn appearance should be represented through the assessment module when a concrete test, inspection or result is recorded.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Table 180 reports that yarn appearance improves with the increase of fibre cleanliness. Yarn appearance is therefore modelled as a yarn-level visual characteristic, not as a fibre characteristic and not as an assessment result.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricAppearance"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Characteristic of a yarn that may influence fabric and product durability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This class corresponds to the aggregated INT-001 concept. More specific yarn characteristics are represented as subclasses.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnElasticity -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnElasticity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnMechanicalCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Yarn mechanical characteristic concerning the ability of yarn to deform and recover.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn elasticity</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Reconstructed concept added to support process-related relations such as the effect of twist level on yarn elasticity.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Yarn elasticity may influence wrinkling and recovery behaviour, but the relation is mediated by fabric structure and garment construction.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#Wrinkling"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnHairiness -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnHairiness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStructuralCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Yarn structural characteristic concerning fibre ends and loops protruding from the yarn body.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn hairiness</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Table 180 identifies yarn hairiness as an unwanted yarn characteristic. It reports that hairiness decreases with increasing fibre length and fibre strength, while it may increase with fibre fineness after the optimal working range.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Yarn hairiness is modelled as a yarn structural characteristic rather than as an assessment result. Quantitative hairiness values, test methods or thresholds should be represented in the assessment module.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnMechanicalCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnMechanicalCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Yarn characteristic concerning mechanical behaviour such as yarn strength or elasticity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn mechanical characteristic</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnSoftness -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnSoftness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnTactileCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Yarn tactile characteristic concerning perceived softness or smoothness.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn softness</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnStrength -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnStrength">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnMechanicalCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Yarn mechanical characteristic expressing the ability of a yarn to withstand tensile force without breaking.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn strength</rdfs:label>
        <skos:altLabel xml:lang="en">Yarn tenacity</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Yarn strength typically contributes to fabric strength, but the relation is mediated by fabric construction and processing.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#FabricStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnStructuralCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnStructuralCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Yarn characteristic concerning structural regularity or configuration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn structural characteristic</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnTactileCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnTactileCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Yarn characteristic concerning tactile or hand-feel behaviour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn tactile characteristic</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnUniformity -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnUniformity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStructuralCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Yarn structural characteristic expressing uniformity in thickness and mass along the yarn length.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn uniformity</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Yarn uniformity may contribute to fabric strength and regularity, but the relation depends on fabric structure and process conditions.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#FabricStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-structure#YarnVisualCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-structure#YarnVisualCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnCharacteristic"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Yarn characteristic concerning visible appearance or visual quality.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">Yarn visual characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This superclass was introduced to organise G-003 Yarn appearance without placing a yarn-level visual characteristic under a fibre-level visual characteristic.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#equalTo"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#greaterThan"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#greaterThanOrEqualTo"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#lessThan"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#lessThanOrEqualTo"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled vocabulary of comparison operators used by performance thresholds.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Threshold comparison operator scheme</rdfs:label>
        <skos:prefLabel xml:lang="en">Threshold comparison operator scheme</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology 1.1.0, assessment threshold-comparison vocabulary specification.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-assessment-codelists#equalTo -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-assessment-codelists#equalTo">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/textile-assessment#ThresholdComparisonOperatorConcept"/>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">The measured or assessed value must equal the threshold value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">equal to</rdfs:label>
        <skos:prefLabel xml:lang="en">equal to</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology 1.1.0, assessment threshold-comparison vocabulary specification.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-assessment-codelists#greaterThan -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-assessment-codelists#greaterThan">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/textile-assessment#ThresholdComparisonOperatorConcept"/>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">The measured or assessed value must be greater than the threshold value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">greater than</rdfs:label>
        <skos:prefLabel xml:lang="en">greater than</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology 1.1.0, assessment threshold-comparison vocabulary specification.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-assessment-codelists#greaterThanOrEqualTo -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-assessment-codelists#greaterThanOrEqualTo">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/textile-assessment#ThresholdComparisonOperatorConcept"/>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">The measured or assessed value must be greater than or equal to the threshold value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">greater than or equal to</rdfs:label>
        <skos:prefLabel xml:lang="en">greater than or equal to</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology 1.1.0, assessment threshold-comparison vocabulary specification.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-assessment-codelists#lessThan -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-assessment-codelists#lessThan">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/textile-assessment#ThresholdComparisonOperatorConcept"/>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">The measured or assessed value must be lower than the threshold value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">less than</rdfs:label>
        <skos:prefLabel xml:lang="en">less than</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology 1.1.0, assessment threshold-comparison vocabulary specification.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-assessment-codelists#lessThanOrEqualTo -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-assessment-codelists#lessThanOrEqualTo">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/textile-assessment#ThresholdComparisonOperatorConcept"/>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">The measured or assessed value must be lower than or equal to the threshold value.</rdfs:comment>
