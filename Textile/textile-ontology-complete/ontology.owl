        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled rating value, grade or scale level.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Rating value concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#RobustnessAssessment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#RobustnessAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment framework that evaluates resistance to selected external stresses and inspection parameters as a proxy for physical durability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Robustness assessment</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5250; JRC Preparatory Study, Section 11.1.1.1, printed page 185, lines 5251-5259.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#RobustnessScoringMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#RobustnessScoringMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#RobustnessAssessment"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Robustness assessment method that maps test and inspection results to points and combines them into a robustness score.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Robustness scoring method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5251-5279; JRC Preparatory Study, Section 11.1.1.1, Table 71, printed page 186; caption line 5284.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#TestCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#TestCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentCondition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled assessment condition used in a test protocol, such as temperature, humidity, load, duration, washing cycle or abrasion cycle.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Test condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5260-5279.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#TestEndpoint -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#TestEndpoint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentDecisionCriterion"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Defined observation or stopping condition used to determine when a test is complete, such as specimen breakdown or a specified appearance change.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Test endpoint</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.4, Table 124, printed pages 362-367; table caption at line 9698.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#TestExecution -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#TestExecution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment execution that performs a test method under controlled test conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Test execution</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#TestMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#TestMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment method that applies a controlled experimental or inspection procedure to a durability-related performance parameter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Test method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3182-3184; JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5260-5279.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#TestingStandard -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#TestingStandard">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentStandard"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment standard specialised for test and verification procedures.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Testing standard</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3182-3184.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#ThresholdComparisonOperatorConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#ThresholdComparisonOperatorConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept identifying the comparison operator used by a performance threshold.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Threshold comparison operator concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#ProductComponent"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A physical component integrated into a textile product that is not itself part of the primary textile fibre composition, such as a button, zipper or sequin.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Non-textile component</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The alignment with soc:ProductComponent is owned here because this module defines the non-textile component class. It does not imply that every component contains a substance of concern.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6855-6861; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#NonTextileComponentTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponentTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A controlled SKOS concept used to classify the functional type of a non-textile component.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Non-textile component type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6855-6861.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A material occurrence used for the packaging, transport, storage or delivery of a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Packaging material</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">PackagingMaterial is aligned as a subclass of dpp:MaterialOfComposition. The textile-specific type property remains separate because its range is a SKOS controlled concept, while dpp:hasMaterialType ranges over an OWL class.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#PackagingMaterialTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#PackagingMaterialTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A controlled SKOS concept used to classify a packaging material occurrence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Packaging material type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A controlled concept describing the technical function performed by a chemical in textile production or treatment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Textile chemical function concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed page 226, lines 6437-6455.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#Substance"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A substance used or occurring in a textile manufacturing, treatment, finishing, coating or related textile-production context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Textile chemical substance</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This class describes textile use context only. It does not assert that the substance remains in the final product or qualifies as a substance of concern.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed pages 225-226, lines 6424-6455.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A controlled concept describing whether a chemical is intended to act during processing, remain for product performance, or occur unintentionally.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Textile chemical use category concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3, printed page 226, lines 6428-6455.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled concept classifying a product technology as base case, best available technology or best not-yet-available technology.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">Product technology level concept</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This shared class prevents aspect modules from recreating the same BC/BAT/BNAT axis. Aspect-specific profiles may map to one of its concepts without becoming equivalent to that generic level.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 17, lines 228-235.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-connector#QuantitativeValue -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-connector#QuantitativeValue">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A numerical value expressed using a measurement unit and, when useful, a kind of quantity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">Quantitative value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-001.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-connector#ReferencePeriod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-connector#ReferencePeriod">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Structured temporal interval used to qualify the period to which an observation, indicator or other time-bound textile statement applies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">Reference period</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-context#TextileContextFactorConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A SKOS concept identifying the type of contextual condition observed or declared for a textile product or process execution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">Textile context factor concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-context#TextileContextObservation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-context#TextileContextObservation">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A concrete observation, declaration or setting of a contextual condition applying to a textile product or a textile process execution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">Textile context observation</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#ElectronicTextile -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#ElectronicTextile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile-based system that exhibits an intended and exploitable response to changes in its surroundings or to an external signal or input.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Electronic textile</rdfs:label>
        <skos:altLabel xml:lang="en">E-textile</skos:altLabel>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-477.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-core:defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <textile-core:jrcExclusionReason xml:lang="en">Excluded because electronic textiles are very different from textile apparel in terms of function and physical characteristics.</textile-core:jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#Fabric -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#Fabric">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile product made from yarns, fibres or filaments and intended to be incorporated into another textile product or used in further manufacturing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Fabric</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Fabric is modelled as a textile product. When a fabric is incorporated into another product, the instance-level relation dpp:isComponentOf expresses that role; no separate intermediate-product class is required.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 486-492; JRC Preparatory Study, Section 3.3.1, printed page 27, lines 536-546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#FibreCompositionComponent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#FibreCompositionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-core#hasFibreMassFraction"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-core#hasFibreType"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp/textile-core#FibreTypeConcept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A structured component of a textile product fibre composition, specifying a fibre type and its quantitative share in the product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Fibre composition component</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#FibreTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#FibreTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled value for textile fibre type in a fibre composition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Fibre type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#MedicalDeviceTextileApparel -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#MedicalDeviceTextileApparel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileApparel"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile apparel identified as a medical device or as an accessory for a medical device in accordance with Regulation (EU) 2017/745.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Medical device textile apparel</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-481.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-core:defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <textile-core:jrcExclusionReason xml:lang="en">Excluded because textile apparel identified as a medical device or as an accessory for a medical device is outside the selected scope.</textile-core:jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#PPETextileApparel -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#PPETextileApparel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileApparel"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile apparel identified as personal protective equipment in accordance with Regulation (EU) 2016/425.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">PPE textile apparel</rdfs:label>
        <skos:altLabel xml:lang="en">Personal protective equipment textile apparel</skos:altLabel>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-479.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-core:defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <textile-core:jrcExclusionReason xml:lang="en">Excluded because textile apparel identified as personal protective equipment is outside the selected scope.</textile-core:jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#ReusableTextileAbsorbentHygieneProduct -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#ReusableTextileAbsorbentHygieneProduct">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Reusable textile absorbent hygiene product considered a technical textile and excluded from scope.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Reusable textile absorbent hygiene product</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 495-506; JRC Preparatory Study, relevant section, printed page 19, lines 275-279; JRC Preparatory Study, relevant section, Table 3, printed page 19; caption line 275.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-core:defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <textile-core:jrcExclusionReason xml:lang="en">Excluded because reusable textile absorbent hygiene products perform a different function from textile apparel and are considered technical textiles.</textile-core:jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#SmartTextile -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#SmartTextile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile able to sense and react to environmental conditions or external stimuli through incorporated sensors or responsive components.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Smart textile</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-474.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-core:defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <textile-core:jrcExclusionReason xml:lang="en">Excluded because smart textiles are very different from textile apparel in terms of function and physical characteristics.</textile-core:jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#StudyScopeStatusConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#StudyScopeStatusConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept used to indicate whether a textile product type is included in, excluded from, or otherwise qualified with respect to a study or regulatory modelling scope.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Study scope status concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#TextileApparel -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileApparel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile products that aim to cover the body with everything except footwear, including clothing and clothing accessories worn to clothe, adorn, shield, provide comfort, or express identity and belonging.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile apparel</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">TextileApparel is a final textile product category for apparel and apparel accessories. The supplied EU DPP Core snapshot does not declare a separate FinalProduct class, so final-product status remains a local textile distinction under dpp:Product. It is narrower than TextileProduct and should not be confused with the whole textile product domain.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 14, lines 167-170; JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-core:defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#includedInJRCPreparatoryStudyScope"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#TextileApparelProductTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileApparelProductTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled value for classifying textile apparel product types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile apparel product type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#TextileCleaningProduct -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileCleaningProduct">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile cleaning product considered a technical textile and excluded from scope because its function differs from apparel.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile cleaning product</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 495-505; JRC Preparatory Study, relevant section, printed page 19, lines 275-279; JRC Preparatory Study, relevant section, Table 3, printed page 19; caption line 275.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-core:defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <textile-core:jrcExclusionReason xml:lang="en">Excluded because textile cleaning products perform a different function from textile apparel and are considered technical textiles.</textile-core:jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#TextileFibre -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileFibre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Unit of matter characterised by flexibility, fineness and a high ratio of length to maximum transverse dimension, suitable for textile applications.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile fibre</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">TextileFibre is modelled as a textile product when it is represented as an identifiable fibre batch or traceability object. Its incorporation into yarn, fabric or another product is represented with dpp:isComponentOf.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 14, lines 154-160.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#TextileProduct -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileProduct">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Product"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Any raw, semi-worked, worked, semi-manufactured, manufactured, semi-made-up or made-up product which is exclusively composed of textile fibres, as well as a product containing at least 80% textile fibres by weight.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile product</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">TextileProduct is the broad textile product class. It includes final products and products serving an intermediate or component role when they are represented as product-like traceability resources. Identification constraints should be specified by SHACL according to product granularity rather than imposed uniformly on every TextileProduct.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 14, lines 161-166.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#ToyTextileApparel -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#ToyTextileApparel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileApparel"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile apparel identified as a toy in accordance with Directive 2009/48/EC.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Toy textile apparel</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-core:defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <textile-core:jrcExclusionReason xml:lang="en">Excluded because textile apparel identified as a toy is outside the selected scope.</textile-core:jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#Yarn -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#Yarn">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile product consisting of fibres assembled into a continuous strand and intended to be incorporated into fabric or another textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Yarn</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Yarn is modelled as a textile product. Its role as an input or component of a fabric or another product is represented with dpp:isComponentOf.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 486-492; JRC Preparatory Study, Section 3.3.1, printed page 27, lines 536-546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#AbrasionResistance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#AbrasionResistance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Observed performance parameter describing the resistance of a textile material or product to wear caused by rubbing or abrasion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Abrasion resistance</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Observed abrasion resistance contributes to the interpretation of intrinsic durability but is not equivalent to intrinsic durability.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#directExtraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#AccidentalDamage -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#AccidentalDamage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ExternalDamage"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">External damage occurring during use, such as accidental tearing, ripping or staining, which may lead to product rejection or disposal.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Accidental damage</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Accidental damage may result in tear or rip, but this is not a necessary relation in every case.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11090-11091.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-durability:typicalProgressionTo rdf:resource="https://w3id.org/eudpp/textile-durability#TearOrRip"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#AssemblyPerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#AssemblyPerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of observed performance parameters related to seams, assembly or garment construction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Assembly performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ColourDepthEvenness -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ColourDepthEvenness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Observed visual performance parameter describing the depth and evenness of colour in a textile product or fabric, especially in relation to dyeing and finishing quality.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Colour depth and evenness</rdfs:label>
        <skos:altLabel xml:lang="en">Colour depth</skos:altLabel>
        <skos:altLabel xml:lang="en">Colour evenness</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Colour depth and evenness is distinct from colour fastness. Colour fastness concerns resistance to fading, running or alteration, whereas colour depth/evenness concerns the achieved visual colour quality.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-durability:typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#Discolouration"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ColourFading -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ColourFading">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Visual failure mode corresponding to progressive loss of colour intensity during use, washing, ageing or exposure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Colour fading</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11089-11093; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2276-2279.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ColourFastness -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ColourFastness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Observed performance parameter describing the resistance of a textile colour to fading, running or alteration under conditions such as washing, rubbing, perspiration or light exposure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Colour fastness</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Colour fastness is the resistance parameter; colour fading is a typical visual failure expression of its degradation.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Observed colour fastness contributes to the interpretation of intrinsic durability, while colour fading is a failure expression.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-durability:typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#ColourFading"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ComponentFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ComponentFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes affecting components or trims.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Component failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of observed performance parameters related to deformation, shape retention or dimensional behaviour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Deformation performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#DimensionalStability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#DimensionalStability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Observed performance parameter describing the ability of a textile product or fabric to retain its dimensions after use, laundering or other treatment cycles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Dimensional stability</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Dimensional stability contributes to the interpretation of intrinsic durability; loss of dimensional stability is the corresponding failure expression.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Dimensional stability is the performance parameter; loss of dimensional stability is the corresponding failure expression.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 11.1.1.1, printed page 186, lines 5267-5273; Annex 13.10.1, printed page 469, lines 11089-11094.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-durability:typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#Discolouration -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#Discolouration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Kept distinct from colour fading because discolouration may be localised, irregular or caused by specific use or exposure conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Discolouration</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11093.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#Durability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#Durability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Durability"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Durability</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Through the alignment txtdur:Durability rdfs:subClassOf dpp:Durability, this class inherits dpp:QualityIndicator and dpp:QuantitativeProperty. This is an inherited EU DPP Core commitment: it does not make a durability instance a numeric value. Numerical observations and results remain represented through Textile Assessment and txtcon:QuantitativeValue.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11067.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ElasticityLoss -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ElasticityLoss">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Structural failure mode corresponding to loss of elasticity, elastic recovery or stretch-related functionality of a textile product or fabric.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Elasticity loss</rdfs:label>
        <skos:altLabel xml:lang="en">Loss of elasticity</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Elasticity loss is kept distinct from loss of dimensional stability. A product may lose elastic recovery without necessarily being described primarily as dimensionally unstable.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-connector:typicallyIncreasesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#LossOfComfort"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ExternalDamage -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ExternalDamage">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Damage caused by external or accidental events during product use, not necessarily resulting from intrinsic lack of durability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">External damage</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FabricBreakdown -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FabricBreakdown">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Aggregated failure mode. It may be decomposed later into more specific phenomena such as fraying, thinning, localised wear or hole formation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Fabric breakdown</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11089-11093; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FabricSmoothness -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FabricSmoothness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Observed performance parameter describing the visible or tactile smoothness of a fabric surface, commonly considered during visual inspection after washing, drying or other durability-related stress.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Fabric smoothness</rdfs:label>
        <skos:altLabel xml:lang="en">Surface smoothness</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric smoothness is represented as an observed performance parameter. A measured value or inspection grade should be represented in the assessment module, while rough or stiff fabric is modelled as a failure expression.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-durability:typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FabricStrength -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FabricStrength">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Aggregated observed mechanical performance parameter describing the strength of a fabric, potentially covering tensile strength, tear strength or bursting strength depending on the test context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Fabric strength</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric strength contributes to the interpretation of intrinsic durability as an aggregated mechanical performance parameter.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Fabric strength is modelled as reducing the likelihood of tear or rip under comparable conditions, rather than as negatively affecting tear or rip.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicallyReducesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#TearOrRip"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FailureMode">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Failure modes are kept separate from observed performance parameters. For example, colour fastness is a parameter, while colour fading is a failure mode.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FunctionalFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FunctionalFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily involving loss of intended use, comfort or functional suitability of a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Functional failure mode</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Introduced to represent failure modes that are not adequately captured by visual, structural, mechanical or component failure categories alone.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FuzzingOrMatting -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FuzzingOrMatting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Observed surface degradation phenomenon involving fuzzing or matting of the fabric surface. The term follows the JRC and ISO wording &apos;fuzzing or matting&apos;, not &apos;melting&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Fuzzing or matting</rdfs:label>
        <skos:altLabel xml:lang="en">Fabric fuzzing</skos:altLabel>
        <skos:altLabel xml:lang="en">Fabric matting</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">FuzzingOrMatting is not made a subclass of FailureMode because it is modelled following the existing pilling pattern as an observed degradation phenomenon used in performance inspection.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The research gap used the wording &apos;fuzzing/melting&apos;, but the JRC and referenced ISO standards use fuzzing/matting. This ontology therefore introduces FuzzingOrMatting and avoids the unsupported term melting.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-durability:typicalProgressionTo rdf:resource="https://w3id.org/eudpp/textile-durability#FabricBreakdown"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#HoleInSeam -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#HoleInSeam">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SeamFailure"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Specific seam failure involving a hole or localised opening at or around a seam.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Hole in seam</rdfs:label>
        <skos:altLabel xml:lang="en">Holes in seams</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11093.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#IntrinsicDurability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#IntrinsicDurability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Durability construct based on the physical and measurable ability of a textile product to maintain relevant performance characteristics over time under specified use, maintenance or test conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Intrinsic durability</rdfs:label>
        <skos:altLabel xml:lang="en">Physical durability</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#LogoFailure -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#LogoFailure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Logo failure may also be interpreted as a component-related failure depending on whether the logo is printed, embroidered or applied as a separate component. It is kept under visual failure mode in this module.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Logo failure</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11091-11092.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#LossOfComfort -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#LossOfComfort">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FunctionalFailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Functional failure mode corresponding to loss of comfort or comfort-related suitability during use, maintenance or ageing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Loss of comfort</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Loss of comfort is kept as a functional failure mode. Specific causes may include roughness, stiffness, loss of elasticity, poor breathability, poor insulation or other context-dependent phenomena.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Failure expression corresponding to loss of the ability of a textile product or fabric to retain its dimensions after use, laundering or treatment cycles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Loss of dimensional stability</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11091-11092.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#MechanicalFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#MechanicalFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily involving rupture, tearing or mechanical damage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Mechanical failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of observed performance parameters related to mechanical resistance or strength.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Mechanical performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Observable phenomenon indicating physical deterioration of a textile material or product. It is distinct from the performance characteristic used to assess resistance to that deterioration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Observed degradation phenomenon</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Durability-related product characteristic that can be observed, assessed or measured to evaluate physical durability. It denotes the characteristic type, not a test, observation, result or quantitative value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Observed performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#Pilling -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#Pilling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Observed surface degradation phenomenon involving the formation of small balls or pills of entangled fibres on a textile surface during wear, friction, use or testing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Pilling</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Observed pilling may contribute to fabric breakdown as part of a progressive surface degradation process, but it should not be treated as the sole necessary cause of fabric breakdown.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Observed pilling negatively affects the interpretation of intrinsic durability; pilling resistance, if modelled separately, should be represented as a protective characteristic.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-durability:typicalProgressionTo rdf:resource="https://w3id.org/eudpp/textile-durability#FabricBreakdown"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#PillingResistance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#PillingResistance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Durability-related performance characteristic describing the ability of a textile material, fabric or product to resist the formation of pills under friction, wear or use conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Pilling resistance</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Pilling resistance is separated from Pilling.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-durability:typicalDegradationExpression rdf:resource="https://w3id.org/eudpp/textile-durability#Pilling"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ProductAgeing -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ProductAgeing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Progressive change or degradation of textile product performance over time under repeated use, care, environmental exposure or stress.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Product ageing</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1.3, printed pages 112-113, lines 2968-3010.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#RadiationInducedDegradation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#RadiationInducedDegradation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ProductAgeing"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Degradation of textile material or product properties associated with ultraviolet or other relevant radiation exposure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Radiation-induced degradation</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 12.3.16, printed page 254, lines 7150-7157.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#TactileFailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Failure mode in which a fabric becomes or is perceived as rough, stiff or unpleasant to touch, affecting user acceptance and comfort-related use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Rough or stiff fabric</rdfs:label>
        <skos:altLabel xml:lang="en">Fabric roughness</skos:altLabel>
        <skos:altLabel xml:lang="en">Fabric stiffness</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">The concept is modelled as a tactile failure mode rather than as a structural characteristic. The corresponding structural or tactile fabric property remains outside this module.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-connector:typicallyIncreasesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#LossOfComfort"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#SeamFailure -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#SeamFailure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Structural or assembly-related failure mode involving loss of seam integrity or seam functionality.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Seam failure</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 469, lines 11089-11094.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#SeamSlippage -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#SeamSlippage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#AssemblyPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Durability-related assembly performance characteristic describing displacement of yarns at or near a seam under mechanical stress, which may lead to deformation or opening.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Seam slippage</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Seam slippage negatively affects the interpretation of intrinsic durability as a loss of assembly performance.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#StructuralFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#StructuralFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily affecting structure, integrity or dimensional behaviour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Structural failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Observed degradation phenomenon affecting the surface condition of a textile material or product, such as pilling, fuzzing or matting.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Surface degradation phenomenon</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Introduced to keep surface degradation phenomena separate from strict FailureMode, because the ontology declares FailureMode and ObservedPerformanceParameter disjoint at high level.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#SurfaceFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#SurfaceFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily affecting the textile surface. Borderline surface phenomena that are also assessed as performance parameters should remain under ObservedDegradationPhenomenon to preserve the module disjointness pattern.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Surface failure mode</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This class is available for strict failure modes. Pilling and fuzzing/matting are intentionally kept as observed degradation phenomena when they are used as inspection parameters.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of observed performance parameters related to surface behaviour or surface degradation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Surface performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#TactileFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#TactileFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily affecting tactile perception, hand feel or comfort-related touch properties of a textile product or fabric.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Tactile failure mode</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Introduced to avoid forcing tactile failures such as rough or stiff fabric into purely visual or purely structural categories.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#TearOrRip -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#TearOrRip">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#MechanicalFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Mechanical failure mode involving rupture, tearing or ripping of textile material under stress, snagging or damage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Tear or rip</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Annex 13.10.1.1, printed page 469, lines 11090-11091.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#TrimFailure -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#TrimFailure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ComponentFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Component failure mode involving failure of trims or auxiliary components associated with a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Trim failure</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11094.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#VisualFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#VisualFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily affecting visible appearance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Visual failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of observed performance parameters related to visual appearance or colour behaviour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Visual performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#Wrinkling -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#Wrinkling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Durability-related deformation behaviour describing the tendency of a textile material or product to form creases under use or after deformation and recovery cycles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Wrinkling</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Wrinkling affects the interpretation of intrinsic durability depending on product type, use context and acceptable thresholds.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ZipperFailure -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ZipperFailure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#TrimFailure"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Specific trim failure involving failure of a zipper or zip fastener.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Zipper failure</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#implicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2273-2274.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#DegradationRate -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#DegradationRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Calculated indicator expressing change in a performance parameter or degradation phenomenon per stated unit of time, use, cycle or exposure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Degradation rate</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 11.1.1, printed page 185, lines 5231-5243.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#DurabilityIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#DurabilityIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <terms:relation rdf:resource="https://w3id.org/eudpp#QualityIndicator"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Indicator used to express or interpret durability-related evidence about a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Durability indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#EstimatedLifetime -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#EstimatedLifetime">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#LifetimeOfProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">An estimated lifetime is not a directly measured property and must identify its evidence, method and assumptions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Estimated lifetime</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3168-3181; JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5243.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#Indicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#Indicator">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Derived information object used to calculate, interpret, aggregate, compare or communicate evidence about a textile product. An indicator is not the underlying assessment result, characteristic, threshold or quantitative value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#LifetimeIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#LifetimeIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#DurabilityIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Durability indicator expressing, estimating or interpreting a product lifespan or duration of service.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Lifetime indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 5.8, printed page 73, lines 1695-1715; Section 9.2.1.5, printed page 121, lines 3168-3179.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#LifetimeOfProduct -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#LifetimeOfProduct">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#LifetimeIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Indicator expressing a stated, observed or inferred lifespan of a textile product using a specified lifespan descriptor and stated assumptions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Lifetime of product</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 5.8, printed page 73, lines 1695-1710; JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3168-3181; JRC Preparatory Study, Section 5.8, Table 32, printed page 73; caption line 1703.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#NumberOfUseCycles -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#NumberOfUseCycles">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#UseRelatedIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">This indicator concerns product use and must not be confused with txtass:NumberOfCycles used as a test-protocol parameter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Number of use cycles</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5238.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#PerformanceAfterNCycles -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#PerformanceAfterNCycles">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Derived performance indicator reporting a performance state or level after a stated number and type of use, wash, abrasion, ageing or other cycles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Performance after N cycles</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5238.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#PerformanceIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#DurabilityIndicator"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Durability indicator expressing a derived level, score, rate, retention or trajectory of a durability-related performance parameter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Performance indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#PerformanceLevelOverTime -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#PerformanceLevelOverTime">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A performance trajectory should preserve the underlying assessment results or constituent point indicators from which it was derived.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Performance level over time</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5243.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#PerformanceRetentionRate -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#PerformanceRetentionRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Calculated indicator expressing retained performance relative to an initial or reference performance value under stated calculation rules.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Performance retention rate</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5243.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#ProductReplacementFrequency -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#ProductReplacementFrequency">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#UseRelatedIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Replacement frequency is not a direct measure of intrinsic durability because disposal and replacement also depend on fit, perceived value, fashion and other contextual factors.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Product replacement frequency</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 5.8, printed page 73, lines 1695-1710; JRC Preparatory Study, Section 6.4.1, printed pages 88-89, lines 2281-2294.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#RobustnessScore -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#RobustnessScore">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Score produced by a robustness scoring method from selected textile test and visual-inspection results; it is proxy information for physical durability and is not a service-lifetime value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Robustness score</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5228-5246; JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5251-5286; JRC Preparatory Study, Section 11.1.1.1, Table 71, printed page 186; caption line 5284.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicallyContributesTo rdf:resource="https://w3id.org/eudpp/textile-durability#IntrinsicDurability"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#UseRelatedIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#UseRelatedIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
