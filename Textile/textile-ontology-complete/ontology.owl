        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-structure#characteristicOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-structure#characteristicOf">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-structure#hasStructuralCharacteristic"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
