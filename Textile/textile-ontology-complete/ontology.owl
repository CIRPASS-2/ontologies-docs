        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Precision of cuts is modelled as influenced by the cutting process and relevant to final appearance and physical durability.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#CutPrecision"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#DefectControl -->


