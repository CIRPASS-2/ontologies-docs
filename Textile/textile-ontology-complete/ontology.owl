    <!-- https://w3id.org/eudpp/textile-recyclability#ruleEvaluatesCriterion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#ruleEvaluatesCriterion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringRule"/>
