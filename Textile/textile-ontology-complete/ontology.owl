    <!-- https://w3id.org/eudpp/textile-assessment#PerformanceThreshold -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#PerformanceThreshold">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentDecisionCriterion"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Decision criterion specifying a minimum, maximum, target or equality value against which a result is evaluated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Performance threshold</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5255-5279.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#RatingScale -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#RatingScale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#InterpretationScale"/>
