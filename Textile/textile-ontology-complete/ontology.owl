        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Incineration process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#InputYarnCountSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#InputYarnCountSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricConstructionParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A process target or input specification stating the yarn count or yarn linear-density class selected for fabric manufacturing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Input yarn count specification</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The JRC identifies yarn count as one of the weaving parameters affecting fabric characteristics. The exact target characteristic depends on fabric construction, yarn type and end use; therefore only weak influence annotations are used.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The process-side target remains distinct from the resulting characteristic represented in Textile Structure.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Yarn count is identified by the JRC as a fabric manufacturing parameter affecting fabric characteristics. A broad weak influence target is used here because the specific effect depends on yarn type, fabric construction and end use.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#IroningProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#IroningProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ConfectioningProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Confectioning or care-related process applying heat and pressure to shape, smooth or finish textile products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Ironing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#IroningTemperature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#IroningTemperature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#CareParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Care parameter describing ironing temperature.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Ironing temperature</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#KnittingPatternSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#KnittingPatternSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricConstructionParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A process target specification stating the knitting structure or pattern to be produced.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Knitting pattern specification</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Knitting pattern is kept as a process-side construction parameter. Its relation to fabric elasticity and drape depends on the knitting structure and yarn choice.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The process-side target remains distinct from the resulting characteristic represented in Textile Structure.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricDrape"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricElasticity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#KnittingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#KnittingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricManufacturingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric manufacturing process in which yarns are interlooped using needles to form fabric on knitting machines.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Knitting process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Knitting is generally used for relatively more elastic fabrics, depending on yarns, knitting pattern and product application.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricElasticity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#LaminatingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#LaminatingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FinishingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Finishing or assembly process joining textile materials with layers or membranes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Laminating process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#LandfillingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#LandfillingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">End-of-life process involving disposal of textile products or textile waste in landfill.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Landfilling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#LiquorRatio -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#LiquorRatio">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#DyeingParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Dyeing-process parameter expressing the relation between the quantity of treatment liquor and the mass of dry textile material. The reporting basis and unit must be stated explicitly.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Liquor ratio</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">The JRC example uses litres of water per kilogram of textile material; it should not automatically be treated as a dimensionless ratio.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.6.1, printed pages 144-145, lines 4001-4031.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#MachineryCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#MachineryCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter or equipment characteristic describing machinery quality, configuration or components relevant to textile processing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Machinery characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">High quality machinery and components are modelled as contributing to consistent yarns and mechanical-related yarn performance.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#MaintenanceAndRepairProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#MaintenanceAndRepairProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#UseAndCareProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">This class groups processes that are related to lifetime extension but are not assessment indicators. Product lifetime itself is represented in TEXTILE_INDICATOR.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Maintenance and repair process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#MechanicalFinishingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#MechanicalFinishingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FinishingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Finishing process using mechanical treatment to modify physical properties, surface behaviour, handle or appearance of textile materials or products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Mechanical finishing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Mechanical finishing can provide or modify physical properties such as handle, surface behaviour and structural performance. Links to observed durability parameters should be asserted only when the specific performance effect is known.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#RecyclingProcess"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#NonwovenManufacturingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#NonwovenManufacturingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricManufacturingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric manufacturing process producing nonwoven textile structures by bonding or entangling fibres or filaments.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Nonwoven manufacturing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PackagingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PackagingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">PackagingProcess is included so that packaging material can be used as an input in a process context without treating packaging material as an input to ordinary textile manufacturing processes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Packaging process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">Textile ontology project process-modelling decision; domain evidence: JRC Table 8, printed pages 27-29, caption line 546; Table 168, printed page 459, caption line 10991; Annex 13.11.9, printed page 512, lines 12384-12387.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PolycottonThermoChemicalRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PolycottonThermoChemicalRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Chemical or thermo-chemical recycling process for polycotton blends, producing cellulosic pulp, polyester fibres, polymers or monomers depending on the applied technique.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Polycotton thermo-chemical recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PrintingBinderUse -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PrintingBinderUse">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#PrintingParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">The binder substance or chemical role should be represented in TEXTILE_ASSOCIATED_MATERIALS. This parameter only records the process-use aspect.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Printing binder use</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PrintingParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PrintingParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FinishingParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessControlParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter relevant to textile printing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Printing parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PrintingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PrintingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#WetProcessingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile process applying colour, patterns or markings to textile materials or products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Printing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Printing gives colour-related characteristics and may influence colour fastness depending on process and material choices.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#ColourFastness"/>
        <textile-process:typicallyUsesChemicalFunction rdf:resource="https://w3id.org/eudpp/textile-associated-materials-codelists#pigment"/>
        <textile-process:typicallyUsesChemicalUseCategory rdf:resource="https://w3id.org/eudpp/textile-associated-materials-codelists#performanceChemical"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ProcessControlParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ProcessControlParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A process parameter that controls, configures or monitors the execution conditions of a textile process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Process control parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">motivated by JRC Table 181 and care-process parameters.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ProcessMethodConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ProcessMethodConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled value for a textile process method or technique.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Process method concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ProcessParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ProcessParameter">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A semantic type for a configurable process condition, method choice, control variable or target specification relevant to a textile process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Process parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">domain motivation from JRC Annex 13.10.2, pages 492-493, Table 181, lines 11889-11901. JRC Annex 13.10.2, pages 493-495, Table 182, lines 11902-11920. JRC Section 9.2.2.2, pages 125-126, lines 3296-3327; Annex 13.7.2, pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ProcessParameterSetting -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ProcessParameterSetting">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A concrete value or selected category assigned to a process parameter for a specific process execution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Process parameter setting</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-009.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ProcessTargetSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ProcessTargetSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A process-side specification stating a target product or intermediate-product characteristic to be achieved by a process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Process target specification</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">A target specification is not the resulting measured product characteristic.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">motivated by JRC Table 182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PyrolysisGasificationRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PyrolysisGasificationRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Thermo-chemical process producing syngas or pyrolysis oil that may be used as feedstock for material production. Use of the output as fuel is energy recovery and is not represented as recycling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Pyrolysis or gasification recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#RecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#RecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">End-of-life process that transforms textile products, textile waste or recovered textile materials into reusable fibre or material feedstock.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#RepairProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#RepairProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#MaintenanceAndRepairProcess"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ReuseProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ReuseProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">End-of-life or post-use process enabling a textile product to be used again without major material transformation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Reuse process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SeamConstructionParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SeamConstructionParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SewingParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Sewing parameter describing seam type, stitch, thread, construction or other seam-related configuration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Seam construction parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SewingParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SewingParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ConfectioningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Confectioning parameter relevant to sewing operations and seam formation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Sewing parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SewingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SewingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ConfectioningProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Confectioning process joining textile parts or components using stitches or seams.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Sewing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Sewing process characteristics influence seam strength and final product durability.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#SeamStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#SewingCharacteristic"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinSpeed -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinSpeed">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#CareParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Care parameter describing spin speed used in laundering.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spin speed</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningLimit -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningLimit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter expressing the range of yarn counts achievable from a given fibre using a specific spinning system; it depends on the number and thickness of fibres or filaments twisted together.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning limit</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Table 180 reports that spinning limit increases proportionally with the increase of fibre length, fibre strength and fibre fineness. These dependencies are represented as weak influence annotations, not as OWL causal axioms.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Table 179, printed page 489; table caption at line 11877.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningMethodConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningMethodConcept">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessMethodConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled value for a spinning method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning method concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningMethodParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningMethodParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">When the selected method is represented directly as a controlled value on a spinning process, use txtprc:hasSpinningMethod with a txtprc:SpinningMethodConcept. This class is retained only when the method must be treated explicitly as a process parameter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning method parameter</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">The selected spinning method provides different levels of yarn evenness, softness and strength. Specific methods are represented as SKOS concepts.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnSoftness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessControlParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter relevant to spinning or yarn manufacturing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#YarnManufacturingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Specific spinning techniques such as ring spinning, rotor open-end spinning and air-jet spinning are represented as SKOS concepts in the spinning method scheme.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningProductivity -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningProductivity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter expressing the finest yarn count producible from a given fibre while maintaining acceptable performance and minimising end-breakage rates.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning productivity</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Table 180 reports that spinning productivity increases with the increase of fibre length, fibre strength and fibre fineness. These dependencies are represented as weak influence annotations, not as OWL causal axioms.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Table 179, printed page 489; table caption at line 11877.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningSpeed -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningSpeed">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Spinning parameter describing the speed of spinning.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning speed</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Higher spinning speeds can cause breakages and may negatively influence yarn strength depending on process conditions.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningTension -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningTension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Spinning parameter describing tension during spinning.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning tension</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Controlling optimal spinning tension is important for yarn strength and uniformity; uneven tension can cause breakages during subsequent processing.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#StorageConditionParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#StorageConditionParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#CareParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Care parameter describing storage-related conditions, such as humidity, sunlight exposure, folding or hanging.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Storage condition parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#StorageProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#StorageProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#UseAndCareProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Use-phase or care-related process involving storage of a textile product under specified or unspecified conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Storage process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Storage conditions such as excessive humidity or direct sunlight may affect textile durability. Detailed environmental conditions are represented in the Textile Context module.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#ColourFastness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#FabricBreakdown"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SyntheticFibreChemicalRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SyntheticFibreChemicalRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Chemical recycling process for synthetic textile feedstock such as polyester or polyamide 6, producing recovered monomers, oligomers or polymers.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Synthetic-fibre chemical recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TargetFabricDensity -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TargetFabricDensity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricConstructionParameter"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TargetFabricMassPerUnitArea -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TargetFabricMassPerUnitArea">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricConstructionParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A process target specification stating the intended mass of fabric per unit surface area.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Target fabric mass per unit area</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Expected SI quantity kind: quantities:SUDE (surface density).</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Fabric weight is represented here as a process-side target or parameter. The influence annotations point to structure-side fabric characteristics rather than merging both concepts.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The process-side target remains distinct from the resulting characteristic represented in Textile Structure.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">This class is not declared equivalent to txtstr:FabricMassPerUnitArea, because this module represents the process-side parameter or target setting, whereas TEXTILE_STRUCTURE represents the resulting fabric characteristic.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricBreathability"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricDrape"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricInsulation"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TemperatureControl -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TemperatureControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter describing control of temperature during textile manufacturing, processing or care.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Temperature control</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Temperature control is modelled as a process parameter influencing yarn processing quality and mechanical-related characteristics.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileCareInstruction -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileCareInstruction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Product instruction describing recommended textile care operations or conditions, such as washing temperature and cycle, detergent use, drying, ironing, bleaching or professional cleaning.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Textile care instruction</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The instruction is product information. User compliance with that instruction is represented separately as a Textile Context observation.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.3.2, printed page 85, lines 2144-2173; JRC Preparatory Study, Section 13.7.2.8, printed page 404, lines 10440-10458.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileEndOfLifeInstruction -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileEndOfLifeInstruction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <rdfs:comment xml:lang="en">Product instruction supporting appropriate end-of-life handling of a textile product, including collection, sorting, preparation for reuse, material separation, recycling or another stated waste-management route.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Textile end-of-life instruction</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This class represents general product instructions. Substance-triggered lifecycle instructions remain represented through the SoC instruction model and should not be duplicated here.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.3.8, printed page 359, lines 9662-9688; JRC Preparatory Study, Section 6.3.3, printed page 86, lines 2183-2192; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546; JRC DPP Study, Section 7.3, printed page 49, end-of-life treatment information data point.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileManufacturingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileManufacturingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile process involved in the manufacturing or transformation of textile fibres, yarns, fabrics, assemblies or finished textile products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Textile manufacturing process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileProcess">
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A type of process involved in manufacturing, transforming, using, caring for, repairing, reusing, recycling or treating a textile product, including a product used as a component of another product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Textile process</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The JRC describes process families across lifecycle stages; the ontology introduces a common superclass.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileProcessExecution -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A concrete occurrence of a textile process applied to one or more products, including products serving an intermediate or component role, materials or components.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Textile process execution</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-008.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ThermoMechanicalRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ThermoMechanicalRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#RecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Recycling process in which thermoplastic textile polymers are remelted or otherwise thermally and mechanically reprocessed into granulate or fibre material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Thermo-mechanical recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TwistLevel -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TwistLevel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Spinning parameter describing the degree or level of twist inserted into a yarn.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Twist level</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Twist level may enhance yarn tenacity and pilling resistance, diminish yarn softness and elasticity, and increase spirality. Yarn strength increases with twist to a peak and may then decrease.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#PillingResistance"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnElasticity"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnSoftness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TwistNumber -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TwistNumber">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Spinning parameter describing the number of twists inserted into a yarn.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Twist number</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">The number of twists is treated as a process parameter closely related to twist level. Its effects are context-dependent and mediated by fibre characteristics.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnSoftness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#UseAndCareProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#UseAndCareProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process occurring during the use or care phase of a textile product, including wearing, washing, drying, cleaning, ironing and storage-related care.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Use and care process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#UseWearProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#UseWearProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#UseAndCareProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Use-phase process corresponding to wearing, using or exposing a textile product during its intended use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Use or wear process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#WashingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#WashingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#UseAndCareProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Care process involving laundering or washing of a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Washing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Washing conditions may influence colour fastness and dimensional stability during use and care.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#ColourFastness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#DimensionalStability"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#WashingTemperature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#WashingTemperature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#CareParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Care parameter describing the temperature used in a washing process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Washing temperature</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#WeavePatternSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#WeavePatternSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricConstructionParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A process target specification stating the weave pattern to be produced.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Weave pattern specification</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The JRC identifies weave pattern as one of the weaving parameters affecting fabric characteristics. The relation is represented as weak influence annotations rather than as deterministic OWL axioms.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The process-side target remains distinct from the resulting characteristic represented in Textile Structure.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Weave pattern is a fabric construction parameter that may affect visual appearance, permeability, drape and handle. The relation is represented as weak influence because the direction depends on the specific weave and yarns.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricAppearance"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricBreathability"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricDrape"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricHandle"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#WeavingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#WeavingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricManufacturingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric manufacturing process in which two sets of yarns are interlaced at right angles on a loom.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Weaving process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Weaving is generally used for relatively more rigid and stronger fabrics, depending on yarns, weave pattern and product application.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#FabricStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricRigidity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#WetProcessingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#WetProcessingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileManufacturingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile manufacturing process involving liquid media, chemical treatment, washing, dyeing, printing or finishing operations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Wet processing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#YarnConditioning -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#YarnConditioning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Spinning or post-spinning parameter corresponding to yarn conditioning, such as steaming, that may enhance flexibility, strength or evenness.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Yarn conditioning</rdfs:label>
        <skos:altLabel xml:lang="en">Conditioning</skos:altLabel>
        <skos:altLabel xml:lang="en">Steaming</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Proper yarn conditioning can enhance flexibility, strength and evenness.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnElasticity"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#YarnManufacturingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#YarnManufacturingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileManufacturingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Manufacturing process transforming fibres or filaments into yarns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Yarn manufacturing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#ChainOfCustodyVerificationMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#ChainOfCustodyVerificationMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Third-party verification method relying on chain-of-custody tracking of recycled material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Chain-of-custody verification method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#ChemicalRecyclingRoute -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#ChemicalRecyclingRoute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingRoute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-recyclability#usesRecyclingProcessType"/>
                <owl:hasValue rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Recycling route whose principal recycling stage chemically transforms textile inputs to recover polymeric, cellulosic or other material feedstock.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Chemical recycling route</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#CollectionForRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#CollectionForRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">End-of-life process in which discarded textile products are collected for potential sorting, preparation and recycling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Collection for recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#CollectionSchemeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#CollectionSchemeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used to classify an arrangement for collecting textile waste.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Collection scheme concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, pages 135-136.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#ManufacturerDeclarationVerificationMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#ManufacturerDeclarationVerificationMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Verification method based on a declaration made by the manufacturer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Manufacturer-declaration verification method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#MechanicalRecyclingRoute -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#MechanicalRecyclingRoute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingRoute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-recyclability#usesRecyclingProcessType"/>
                <owl:hasValue rdf:resource="https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Recycling route whose principal recycling stage mechanically transforms textile inputs into reusable fibres or materials.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Mechanical recycling route</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used to classify a technique that prepares textile waste for a recycling process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Pre-treatment technique concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, page 137.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#PreparationForRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#PreparationForRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">End-of-life process that prepares a textile product or material for recycling, including removal, cleaning, cutting, opening or other pre-treatment required by a route.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Preparation for recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecoveredMaterialQualityResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecoveredMaterialQualityResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment result describing whether recovered textile material meets stated quality requirements for a target use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recovered material quality result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecoveredTextileMaterial -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecoveredTextileMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Material output recovered from an actual textile recycling process and potentially usable as input to another production process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recovered textile material</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#Recyclability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#Recyclability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContent"/>
        <terms:relation rdf:resource="https://w3id.org/eudpp#RecoverableRate"/>
        <terms:relation rdf:resource="https://w3id.org/eudpp#RecyclingRate"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Potential of a textile product, under a specified collection, sorting, preparation and recycling context, to provide fibre or material feedstock usable in one or more recycling routes without disruptive elements or substances.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessment"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Concrete execution of a recyclability assessment method on a specified textile product for stated recycling routes and conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability assessment</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Reusable procedure for evaluating textile-product recyclability against stated criteria, assumed system conditions and one or more recycling routes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability assessment method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessmentResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Result produced by a recyclability assessment, reporting route-specific criterion outcomes, barriers, recyclable fraction, score or label when applicable.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability assessment result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrier -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentElement"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Product, material, substance, information or system condition that hinders collection, sorting, preparation, recycling or the use and quality of recovered material for a specified route.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability barrier</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept classifying a recyclability barrier.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability barrier type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept identifying a criterion used in a recyclability assessment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability criterion concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment result reporting the outcome of one controlled recyclability criterion for a product and, where relevant, a specified recycling route.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability criterion result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled categorical label used by a specified recyclability scoring method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability label concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityOutcomeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityOutcomeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept expressing the outcome of a recyclability criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability outcome concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityScore -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScore">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Method-specific indicator calculated from stated recyclability criteria and assumptions. A score does not by itself prove that a product will be collected or recycled in practice.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability score</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5392-5443; Table 76, printed page 191; JRC DPP Study, Section 7.3, printed page 49, data point “Recyclability score”.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment method that combines criterion outcomes into a method-specific recyclability score or label. It is not a universal regulatory scoring formula.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability scoring method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5402-5443; Table 76, printed page 191, caption line 5441.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringRule -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringRule">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Rule belonging to a recyclability scoring method and assigning a quantitative point value to a stated criterion under stated route or threshold conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability scoring rule</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">domain evidence from JRC Section 11.1.2.1, Table 76, pages 190-191.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Product aspect describing the proportion by mass of recycled fibres from post-industrial, pre-consumer or post-consumer waste in a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5, printed page 134, lines 3666-3675; Section 9.2.5.4, printed page 143, lines 3957-3961.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment execution that verifies or evaluates a recycled-content declaration for a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content assessment</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3982.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessmentResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessmentResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment result reporting the outcome of verifying or evaluating a recycled-content declaration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content assessment result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Sections 9.2.5.4-9.2.5.5, pages 143-144.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentDeclaration -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentDeclaration">
        <terms:relation rdf:resource="https://w3id.org/eudpp#RecycledMaterialsUse"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Declaration reporting the mass fraction of recycled material in a textile product or material. Recycled content is related to, but distinct from, recyclability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content declaration</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC DPP Study, Section 7.3, printed page 50, data point “Recycled content”.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentPerformanceThreshold -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentPerformanceThreshold">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#PerformanceThreshold"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Performance threshold defining a minimum recycled-content value for a stated product, fibre or source context. Candidate values proposed in the JRC design option remain assessment data rather than universal OWL axioms.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content performance threshold</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.3, printed page 194, lines 5496-5503; JRC Preparatory Study, Section 11.1.3.1, printed page 194, lines 5504-5519.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept identifying the lifecycle source category of recycled content, including post-industrial, pre-consumer and post-consumer material. The declaration or method must state the definition framework used because ISO and ESPR terminology are not fully aligned.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content source concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC DPP Study, Section 7.3, printed page 50, data point “Origin of the recycled content”.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment method used to verify a recycled-content declaration where no direct laboratory determination of recycled versus virgin fibre origin is available at scale.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content verification method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledTextileFibre -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledTextileFibre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileFibre"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecoveredTextileMaterial"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Recovered textile material represented as a textile fibre suitable, subject to quality and process requirements, for use in textile products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled textile fibre</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclingLoopConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclingLoopConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept identifying the intended material-loop destination of a recycling route.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycling loop concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclingRoute -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclingRoute">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Specified sequence or configuration of collection, sorting, preparation and recycling stages used as the context for a recyclability assessment or actual recycling operation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycling route</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclingYieldResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclingYieldResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment result reporting the mass fraction or other stated yield of recovered material produced by an actual or modelled recycling operation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycling yield result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#SortingCriterionConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#SortingCriterionConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used to classify a criterion applied during sorting for recycling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Sorting criterion concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, pages 136-137.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#SortingForRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#SortingForRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">End-of-life process in which collected textile products or materials are segregated into streams suitable for subsequent recycling routes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Sorting for recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#SortingTechniqueConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#SortingTechniqueConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used to classify a textile sorting technique.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Sorting technique concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, page 137.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#TextileChemicalRecyclingEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileChemicalRecyclingEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-process#executesProcessType"/>
                <owl:hasValue rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Textile recycling event executing the chemical recycling process type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Textile chemical recycling event</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#TextileMechanicalRecyclingEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileMechanicalRecyclingEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-process#executesProcessType"/>
                <owl:hasValue rdf:resource="https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Textile recycling event executing the mechanical recycling process type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Textile mechanical recycling event</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Concrete textile recycling occurrence represented both as a product event and as a textile process execution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Textile recycling event</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">EU DPP EVENT module: dpp:ProductEvent.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#TextileWaste -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileWaste">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile product that the holder discards, intends to discard or is required to discard.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Textile waste</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">TextileWaste represents a textile product in a waste status. The generation-stage category is supplied separately through hasWasteSourceType.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 15, lines 188-212; JRC Preparatory Study, Section 9.2.4, printed page 130, lines 3487-3509.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled concept classifying textile waste according to the lifecycle stage at which it became waste.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Textile waste source concept</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This vocabulary classifies a concrete waste resource and is distinct from RecycledContentSourceConcept, which classifies the declared origin of material already incorporated as recycled content.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 15, lines 188-212; JRC Preparatory Study, Section 9.2.4, printed page 130, lines 3487-3509.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#DigitalRepairGuidance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#DigitalRepairGuidance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DigitalInstruction"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairGuidance"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Repair guidance provided in digital form and capable of carrying a web link through the DPP digital-instruction pattern.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Digital repair guidance</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#DisassemblyFeature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#DisassemblyFeature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Design feature describing whether a product or relevant element can be taken apart for repair, upgrade, refurbishment or remanufacturing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Disassembly feature</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11283; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11378-11386; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11649-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#EaseOfDisassembly -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#EaseOfDisassembly">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#DisassemblyFeature"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Disassembly feature concerning the ease with which a product or relevant element can be taken apart without damage or excessive effort.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Ease of disassembly</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11283; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11378-11386; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11649-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#InteractiveRepairSupport -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#InteractiveRepairSupport">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#DigitalRepairGuidance"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Interactive real-time digital repair guidance, for example through augmented reality, artificial intelligence or another interactive technology.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Interactive repair support</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#directExtraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Product aspect concerning intervention-based extension or restoration of textile-product use, functionality or value through repair, upgrade, refurbishment or remanufacturing. It is an organising class and not a score.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Life-extension intervention aspect</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#LifeExtensionProductEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#LifeExtensionProductEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-event-mireot"/>
        <rdfs:comment xml:lang="en">A concrete textile process occurrence that is also interpreted as a product lifecycle event intended to extend, restore or substantially change the useful life, functionality or condition of a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Life-extension product event</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#ModularityFeature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#ModularityFeature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Design feature by which relevant product elements are modular, detachable or interchangeable in support of repair or upgrade.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Modularity feature</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#PriorityRepairElement -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#PriorityRepairElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentElement"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment role assigned to a product element that is important for repairability because of failure frequency or functional relevance. The physical element itself remains represented in the appropriate textile or component module.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Priority repair element</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#PriorityRepairElementTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#PriorityRepairElementTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept identifying a priority repair element type such as fabric, zipper, button or embellishment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Priority repair element type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RefurbishmentPossibility -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RefurbishmentPossibility">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Ability of a product or discarded product to be prepared, cleaned, tested, serviced and, where necessary, repaired so that performance or functionality is restored within the originally intended use and performance range.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Possibility of refurbishment</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11374-11400; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RefurbishmentProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RefurbishmentProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RemanufacturingPossibility -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RemanufacturingPossibility">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Possibility of producing a new product from waste objects, products or components through actions involving at least one change that may affect the product performance, purpose or type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Possibility of remanufacturing</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 16-17, lines 222-225; JRC Preparatory Study, Section 13.10.1.13, printed pages 480-481, lines 11645-11673; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RemanufacturingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RemanufacturingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairActionTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairActionTypeConcept">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessMethodConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled process-method concept identifying a textile repair action such as patching, mending, button replacement or zipper replacement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair action type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairActorTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairActorTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept used to classify the role or category of an actor participating in textile repair.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair actor type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3436-3443.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairCostCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairCostCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Economic condition describing repair cost in relation to a comparable new product price and its influence on a repair decision.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair cost condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3429-3435; JRC Preparatory Study, Section 9.2.3.3, printed page 129, lines 3477-3481.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairGuidance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairGuidance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Information or instructions supporting repair of textile apparel or common damaged elements. Guidance may be physical or digital and is distinct from the repair service and the repair operation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair guidance</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile process type related to upgrade, refurbishment or remanufacturing and organised with repair under the broader family of life-extension interventions. Concrete operations are represented as txtprc:TextileProcessExecution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair-related life-extension process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairService -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairService">
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Service that performs, organises or supports textile repair interventions, including company-provided, independent professional and community-supported repair.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair service</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3474-3476; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairServiceConfigurationConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairServiceConfigurationConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#RatingValueConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept representing a BC, BAT or BNAT repair-service and guidance configuration from JRC Table 48.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair service configuration concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#Repairability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#Repairability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Ability of a defective product or waste object to return, through one or more actions, to a condition in which it fulfils its intended use. For textile apparel, user acceptance of restored functionality and potentially changed aesthetics is contextually relevant.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repairability</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Repair may extend product use, but the outcome depends on failure type, service availability, cost, user acceptance and the effectiveness of the intervention; no deterministic inference is asserted.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11273-11279; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicallyContributesTo rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment execution that gathers contextual evidence about repairability-related product aspects, services, guidance, design features, priority elements, costs, spare-part availability and user acceptance. It does not itself constitute the result.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repairability assessment</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairabilityAssessmentResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessmentResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Result produced by a repairability assessment. It records the evidence-based outcome and relevant service configuration without asserting a universal objective repairability score.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repairability assessment result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentCondition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment condition external to intrinsic product design that influences repair feasibility or the decision to repair.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repairability contextual condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentElement"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Design-related feature that may enable repair, upgrade, refurbishment or remanufacturing, such as modularity, standardisation or disassembly.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repairability design feature</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11290; JRC Preparatory Study, Section 9.2.3.1, printed page 127, lines 3362-3375.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#SparePartAvailabilityCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#SparePartAvailabilityCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Condition describing whether a suitable spare component or replacement element is available for a contemplated repair. Availability may depend on collections, styles, colours, logistics and actual expected use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Spare-part availability condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3399-3408; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11291-11296.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#StandardisationFeature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#StandardisationFeature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Design feature by which components or interfaces are standardised in a way that may support replacement, repair or upgrade.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Standardisation feature</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#TextileRefurbishmentEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#TextileRefurbishmentEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#RefurbishmentEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionProductEvent"/>
