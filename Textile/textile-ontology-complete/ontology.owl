        <rdfs:comment xml:lang="en">Relates a textile structure characteristic occurrence to the textile product that it describes, including a product used as a component of another product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">characteristic of</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 177-182, printed pages 486-495; captions at lines 11873-11907.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-structure#hasCharacteristicValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-structure#hasCharacteristicValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
