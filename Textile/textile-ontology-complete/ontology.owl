        <rdfs:comment xml:lang="en">Condition under which an assessment execution is performed or a result is obtained.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Assessment condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 11.1.1.1, printed pages 185-186, lines 5252-5279; Table 71, printed page 186.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#AssessmentDecisionCriterion -->


