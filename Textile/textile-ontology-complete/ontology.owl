        <rdfs:label xml:lang="en">has characteristic value</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-002.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-structure#hasStructuralCharacteristic -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-structure#hasStructuralCharacteristic">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile product, including a product used as a component of another product, to a textile structure characteristic occurrence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <rdfs:label xml:lang="en">has structural characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 177-182, printed pages 486-495; captions at lines 11873-11907.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


