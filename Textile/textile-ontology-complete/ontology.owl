    <!-- https://w3id.org/eudpp/textile-assessment#AgeingSimulationMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#AgeingSimulationMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#TestMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Test method that applies controlled and repeatable use or care cycles to simulate product ageing before or during durability assessment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Ageing simulation method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1.3, printed pages 112-113, lines 2968-3010.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#AssessmentCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#AssessmentCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentElement"/>
