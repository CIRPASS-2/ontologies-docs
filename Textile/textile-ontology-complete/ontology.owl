        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#requiresRouteStage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#requiresRouteStage">
