        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecycledContentAspect -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecycledContentAspect">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
