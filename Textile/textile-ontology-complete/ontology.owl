        <rdfs:comment xml:lang="en">Interpretation scale composed of controlled rating values or grades.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">Rating scale</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5251-5279.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-assessment#RatingValueConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-assessment#RatingValueConcept">
