        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">refers to non-textile component</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5410-5443; Table 76, printed page 191, caption line 5441; JRC Preparatory Study, Section 12.3.8, printed pages 239-240, lines 6673-6719; JRC Preparatory Study, Section 12.3.10, printed pages 241-242, lines 6739-6779.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#refersToSubstancePresence -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#refersToSubstancePresence">
