    <!-- https://w3id.org/eudpp/textile-connector#evidenceStatus -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#evidenceStatus">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an ontology resource to one or more controlled concepts describing how explicitly the resource is supported or how strongly it was reconstructed from source material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">evidence status</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This annotation qualifies the ontology resource itself. Evidence and polarity for an individual weak relation edge remain in the canonical relation register or require a reified statement model.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#modellingNote -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#modellingNote">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Human-readable note documenting a modelling decision, limitation, assumption, source wording or intended future refinement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">modelling note</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#sourceLocator -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#sourceLocator">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Identifies, in human-readable form, the section, page, table, figure, line range or file location in the cited source that supports an ontology resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">source locator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Source Traceability Policy, lines 7-43 and 86-108</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#sourceType -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#sourceType">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an ontology resource to a controlled source-category concept describing how the resource was obtained or justified.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">source type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Source Traceability Policy, lines 7-43 and 86-108</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#typicalInfluenceOn -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a source concept, parameter, process, context factor or structural characteristic typically influences a target concept, without asserting a deterministic or universally valid causal relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">typical influence on</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Use this property for cross-module class-level or concept-level links such as process parameter to structural characteristic, structure to durability, or context factor to durability. It is intentionally an annotation property to avoid strong OWL inferences over classes.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#typicallyContributesTo -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicallyContributesTo">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a source entity typically contributes to, supports or participates in the realisation of a target characteristic, performance aspect or outcome.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">typically contributes to</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This is a specialised form of typical influence. It should not be interpreted as a necessary or sufficient condition.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a source entity typically increases the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">typically increases likelihood of</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This property is appropriate for risk-like links, for example context or use factors increasing the likelihood of a durability failure mode.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a source entity typically reduces the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">typically reduces likelihood of</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This property is appropriate for protective or mitigating links. It should not be interpreted as a guarantee of prevention.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-context#typicallyQualifiesProcess -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-context#typicallyQualifiesProcess">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a context factor typically qualifies the interpretation, applicability or expected effect of a textile process type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">typically qualifies process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-core#defaultStudyScopeStatus -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-core#defaultStudyScopeStatus">
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Annotation property used on product-type classes to document their default status with respect to a study or regulatory modelling scope.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">default study scope status</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This is an annotation-level modelling aid for product types. Instance-level scope status, if needed, should be represented with a data validation pattern or a dedicated object property in a context module.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-core#jrcExclusionReason -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-core#jrcExclusionReason">
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Annotation specifying the reason why a textile product class or category is excluded from the JRC preparatory study scope.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">JRC exclusion reason</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-core#jrcScopeCondition -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-core#jrcScopeCondition">
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Annotation specifying a textual condition governing inclusion of a textile product class or category in the JRC preparatory study scope.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">JRC scope condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#typicalDegradationExpression -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-durability#typicalDegradationExpression">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Annotation used at class level to document a usual degradation expression of a durability-related performance characteristic without imposing a necessary OWL restriction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">typical degradation expression</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#typicalFailureExpression -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-durability#typicalFailureExpression">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Annotation used at class level to document the usual failure expression of an observed performance parameter without imposing an OWL existential restriction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">typical failure expression</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#typicalProgressionTo -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-durability#typicalProgressionTo">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Annotation used at class level to document a typical degradation progression without asserting a necessary causal relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">typical progression to</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#typicallyUsesChemicalFunction -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-process#typicallyUsesChemicalFunction">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a textile process type typically uses a chemical function represented in Textile Associated Materials.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">typically uses chemical function</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#typicallyUsesChemicalUseCategory -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-process#typicallyUsesChemicalUseCategory">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a textile process type typically uses a chemical from a use category represented in Textile Associated Materials.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">typically uses chemical use category</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:AnnotationProperty>
    


