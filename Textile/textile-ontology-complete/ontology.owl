        <rdfs:comment xml:lang="en">Classifies a recyclability assessment result using the shared product-technology-level vocabulary defined in Textile Connector.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has recyclability technology level</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecyclableMassFractionValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecyclableMassFractionValue">
