                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#FibreCharacteristic
:FibreCharacteristic rdf:type owl:Class ;
                     rdfs:subClassOf :TextileStructureCharacteristic ;
                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                     rdfs:comment "A characteristic of a textile fibre that can influence yarn manufacture, fabric behaviour and durability-related performance."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                     rdfs:label "Fibre characteristic"@en ;
                     <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                     <https://w3id.org/eudpp/textile-connector#modellingNote> "This class corresponds to the aggregated MAT-001 concept. MAT-004 Fibre type is represented in TEXTILE_CORE through txt:FibreTypeConcept and txtcs:FibreTypeScheme, and used through txt:hasFibreType on txt:FibreCompositionComponent. It is therefore not duplicated as a textile structure class in this module."@en ,
                                                                              "This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-structure#FibreCleanliness
:FibreCleanliness rdf:type owl:Class ;
                  rdfs:subClassOf :FibreQualityCharacteristic ;
                  <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                  rdfs:comment "Fibre quality characteristic concerning impurities or foreign matter remaining in the fibre."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                  rdfs:label "Fibre cleanliness"@en ;
                  <http://www.w3.org/2004/02/skos/core#editorialNote> "The term is named FibreCleanliness rather than FibreCleanness, following standard textile and English usage."@en ;
                  <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                  <https://w3id.org/eudpp/textile-connector#modellingNote> "A weak influence link from fibre cleanliness to yarn appearance is represented in this module. The corresponding link to fabric appearance remains pending until a fabric appearance target concept is introduced."@en ,
                                                                           "Fibre cleanliness is modelled as a fibre quality characteristic, not as a structural dimension such as length, fineness or section shape. Quantitative or qualitative measurements of contamination, trash content or impurity levels should be represented through assessment results."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                  <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> :FabricAppearance ,
                                                                                :YarnAppearance .


###  https://w3id.org/eudpp/textile-structure#FibreColour
:FibreColour rdf:type owl:Class ;
             rdfs:subClassOf :VisualFibreCharacteristic ;
             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
             rdfs:comment "Visual fibre characteristic concerning the colour of a fibre and its influence on dyeing or bleaching behaviour."@en ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
             rdfs:label "Fibre colour"@en ;
             <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ,
                                                                       <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-structure#FibreElasticity
:FibreElasticity rdf:type owl:Class ;
                 rdfs:subClassOf :MechanicalFibreCharacteristic ;
                 <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                 rdfs:comment "Mechanical fibre characteristic concerning deformation and recovery after removal of a load."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                 rdfs:label "Fibre elasticity"@en ;
                 <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                 <https://w3id.org/eudpp/textile-connector#modellingNote> "Fibre elasticity may influence wrinkling behaviour through recovery behaviour. The relation is context-dependent and mediated by fabric and garment structure."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                 <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> <https://w3id.org/eudpp/textile-durability#Wrinkling> .


###  https://w3id.org/eudpp/textile-structure#FibreFineness
:FibreFineness rdf:type owl:Class ;
               rdfs:subClassOf :StructuralFibreCharacteristic ;
               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
               rdfs:comment "Structural fibre characteristic expressing fibre fineness or linear density."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
               rdfs:label "Fibre fineness"@en ;
               <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
               <https://w3id.org/eudpp/textile-connector#modellingNote> "Fibre fineness typically affects yarn uniformity and regularity, but the direction and magnitude depend on fibre type and process conditions."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
               <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> :FabricDrape ,
                                                                             :FabricHandle ,
                                                                             :FabricLustre ,
                                                                             :YarnHairiness ,
                                                                             :YarnUniformity .


###  https://w3id.org/eudpp/textile-structure#FibreLength
:FibreLength rdf:type owl:Class ;
             rdfs:subClassOf :StructuralFibreCharacteristic ;
             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
             rdfs:comment "Structural fibre characteristic expressing the length of textile fibres."@en ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
             rdfs:label "Fibre length"@en ;
             <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
             <https://w3id.org/eudpp/textile-connector#modellingNote> "Fibre length is modelled as typically influencing yarn strength through yarn structure. The relation should not be interpreted as a deterministic rule."@en ,
                                                                      "This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
             <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> :FabricHandle ,
                                                                           :FabricLustre ,
                                                                           :YarnHairiness ,
                                                                           :YarnStrength .


###  https://w3id.org/eudpp/textile-structure#FibreQualityCharacteristic
:FibreQualityCharacteristic rdf:type owl:Class ;
                            rdfs:subClassOf :FibreCharacteristic ;
                            <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                            rdfs:comment "Fibre characteristic concerning fibre quality conditions that are not purely structural, mechanical, physical or visual."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                            rdfs:label "Fibre quality characteristic"@en ;
                            <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                            <https://w3id.org/eudpp/textile-connector#modellingNote> "This superclass was introduced to avoid forcing fibre cleanliness under a purely structural or visual fibre characteristic. It organises G-002 without changing the semantics of existing fibre characteristic subclasses."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#FibreSectionShape
:FibreSectionShape rdf:type owl:Class ;
                   rdfs:subClassOf :StructuralFibreCharacteristic ;
                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                   rdfs:comment "Structural fibre characteristic expressing the cross-sectional shape of textile fibres."@en ;
