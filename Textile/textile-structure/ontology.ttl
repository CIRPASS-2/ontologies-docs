###  https://w3id.org/eudpp/textile-structure#YarnElasticity
:YarnElasticity rdf:type owl:Class ;
                rdfs:subClassOf :YarnMechanicalCharacteristic ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Yarn mechanical characteristic concerning the ability of yarn to deform and recover."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                rdfs:label "Yarn elasticity"@en ;
                <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ,
