#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp#hasProperty
<https://w3id.org/eudpp#hasProperty> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp/textile-structure#characteristicOf
:characteristicOf rdf:type owl:ObjectProperty ;
                  owl:inverseOf :hasStructuralCharacteristic ;
                  rdfs:domain :TextileStructureCharacteristic ;
                  rdfs:range <https://w3id.org/eudpp/textile-core#TextileProduct> ;
                  <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                  rdfs:comment "Relates a textile structure characteristic occurrence to the textile product that it describes, including a product used as a component of another product."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                  rdfs:label "characteristic of"@en ;
                  <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                  <https://w3id.org/eudpp/textile-connector#modellingNote> "This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.2, Tables 177-182, printed pages 486-495; captions at lines 11873-11907."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#hasCharacteristicValue
:hasCharacteristicValue rdf:type owl:ObjectProperty ;
                        rdfs:domain :TextileStructureCharacteristic ;
                        rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                        <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Relates a textile structure characteristic occurrence to a quantitative value containing a number and a measurement unit."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                        rdfs:label "has characteristic value"@en ;
                        <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                        <https://w3id.org/eudpp/textile-connector#modellingNote> "This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "docs/decisions/TXT-DEC-002.md"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#hasStructuralCharacteristic
:hasStructuralCharacteristic rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf <https://w3id.org/eudpp#hasProperty> ;
                             rdfs:domain <https://w3id.org/eudpp/textile-core#TextileProduct> ;
                             rdfs:range :TextileStructureCharacteristic ;
                             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                             rdfs:comment "Relates a textile product, including a product used as a component of another product, to a textile structure characteristic occurrence."@en ;
                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                             rdfs:label "has structural characteristic"@en ;
                             <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                             <https://w3id.org/eudpp/textile-connector#modellingNote> "This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.2, Tables 177-182, printed pages 486-495; captions at lines 11873-11907."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/eudpp/textile-structure#hasTextualValue
:hasTextualValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain :TextileStructureCharacteristic ;
                 rdfs:range xsd:string ;
                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                 rdfs:comment "Relates a textile structure characteristic occurrence to a free-text value when no controlled value list is available."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                 rdfs:label "has textual value"@en ;
                 <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                 <https://w3id.org/eudpp/textile-connector#modellingNote> "Controlled qualitative characteristic values may later be represented as SKOS concepts if required."@en ,
                                                                          "This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "docs/decisions/TXT-DEC-005.md"@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/eudpp#Property
<https://w3id.org/eudpp#Property> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-connector#QuantitativeValue
<https://w3id.org/eudpp/textile-connector#QuantitativeValue> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-core#TextileProduct
<https://w3id.org/eudpp/textile-core#TextileProduct> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-durability#FailureMode
<https://w3id.org/eudpp/textile-durability#FailureMode> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon
<https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter
<https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic
:AssemblyCharacteristic rdf:type owl:Class ;
                        rdfs:subClassOf :IntermediateTextileCharacteristic ;
                        <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Characteristic of garment or textile assembly, including seams, sewing and cutting quality."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                        rdfs:label "Assembly characteristic"@en ;
                        <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                        <https://w3id.org/eudpp/textile-connector#modellingNote> "Structural superclass introduced to organise the module; not necessarily a verbatim JRC term."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#CutPrecision
:CutPrecision rdf:type owl:Class ;
              rdfs:subClassOf :AssemblyCharacteristic ;
              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
              rdfs:comment "Assembly characteristic concerning precision of cutting or pattern construction."@en ;
              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
              rdfs:label "Cut precision"@en ;
              <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ,
                                                                        <https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence> ;
              <https://w3id.org/eudpp/textile-connector#modellingNote> "Cut precision may influence assembly quality and seam performance, but it is reconstructed here mainly to prepare links with the future confectioning process model."@en ,
                                                                       "Reconstructed concept added to support future links with confectioning process and final product quality."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.2, Table 182, printed pages 494-495; table caption at line 11907; supporting text on printed page 495, lines 11927-11932."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> ;
              <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> :SeamStrength .


###  https://w3id.org/eudpp/textile-structure#FabricAppearance
:FabricAppearance rdf:type owl:Class ;
                  rdfs:subClassOf :FabricVisualCharacteristic ;
                  <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                  rdfs:comment "Fabric visual characteristic concerning the overall visible appearance or visual quality of a fabric."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                  rdfs:label "Fabric appearance"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Fabric visual appearance"@en ;
                  <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ,
                                                                            <https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence> ;
                  <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric appearance is represented as a fabric visual characteristic in TEXTILE_STRUCTURE. Observed changes in fabric appearance after use or cleaning cycles should be represented in TEXTILE_DURABILITY or TEXTILE_ASSESSMENT, not as the structural characteristic itself."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-structure#FabricBehaviouralCharacteristic
:FabricBehaviouralCharacteristic rdf:type owl:Class ;
                                 rdfs:subClassOf :FabricCharacteristic ;
                                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                 rdfs:comment "Fabric-level characteristic concerning the physical behaviour of a fabric under use, gravity, movement, care or stress conditions."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                                 rdfs:label "Fabric behavioural characteristic"@en ;
                                 <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                                 <https://w3id.org/eudpp/textile-connector#modellingNote> "This superclass organises fabric drape without reducing it either to a purely structural dimension or to an assessment result."@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#FabricBreathability
:FabricBreathability rdf:type owl:Class ;
                     rdfs:subClassOf :FabricFunctionalCharacteristic ;
                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                     rdfs:comment "Fabric functional characteristic concerning the passage of water vapour through the fabric and evaporative cooling."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                     rdfs:label "Fabric breathability"@en ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Air permeability"@en ,
                                                                    "Breathability"@en ;
                     <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                     <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric breathability is represented in TEXTILE_STRUCTURE as a fabric-level functional characteristic, not as a TEXTILE_CORE product class and not as an assessment result."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-structure#FabricCharacteristic
:FabricCharacteristic rdf:type owl:Class ;
                      rdfs:subClassOf :IntermediateTextileCharacteristic ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Fabric-level characteristic relevant to durability, comfort, appearance or functional performance."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                      rdfs:label "Fabric characteristic"@en ;
                      <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                      <https://w3id.org/eudpp/textile-connector#modellingNote> "This superclass avoids forcing tactile fabric properties such as fabric handle under a purely structural fabric category."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#FabricConstructionCharacteristic
:FabricConstructionCharacteristic rdf:type owl:Class ;
                                  rdfs:subClassOf :FabricStructuralCharacteristic ;
                                  <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                  rdfs:comment "Fabric structural characteristic concerning fabric construction, density, mass per area or arrangement of yarns/threads."@en ;
                                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                                  rdfs:label "Fabric construction characteristic"@en ;
                                  <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                                  <https://w3id.org/eudpp/textile-connector#modellingNote> "This superclass distinguishes structural fabric characteristics from process parameters in TEXTILE_PROCESS. The same real-world quantity may be represented as a process target/parameter in TEXTILE_PROCESS and as a product/fabric characteristic in TEXTILE_STRUCTURE, but these roles should be kept explicit."@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#FabricDrape
:FabricDrape rdf:type owl:Class ;
             rdfs:subClassOf :FabricBehaviouralCharacteristic ;
             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
             rdfs:comment "Fabric behavioural characteristic concerning how a fabric hangs in three dimensions and adapts to contours."@en ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
             rdfs:label "Fabric drape"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Drape"@en ,
                                                            "Drapeability"@en ;
             <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
             <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric drape is modelled as a fabric behavioural characteristic. Concrete drape measurements, test methods or performance levels should be represented in TEXTILE_ASSESSMENT."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-structure#FabricElasticity
:FabricElasticity rdf:type owl:Class ;
                  rdfs:subClassOf :FabricStructuralCharacteristic ;
                  <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                  rdfs:comment "Fabric structural characteristic denoting elastic behaviour of the fabric."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                  rdfs:label "Fabric elasticity"@en ;
                  <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ,
                                                                            <https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence> ;
                  <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric elasticity may influence dimensional stability and wrinkle recovery; the relation depends on fibre composition, yarn structure and fabric construction."@en ,
                                                                           "Reconstructed concept added to support relations between fabric manufacturing methods, fabric structure and deformation performance."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.2, Tables 178-179, printed pages 488-490; captions at lines 11875 and 11877."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> ;
                  <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> <https://w3id.org/eudpp/textile-durability#DimensionalStability> ,
                                                                                <https://w3id.org/eudpp/textile-durability#Wrinkling> .


###  https://w3id.org/eudpp/textile-structure#FabricFunctionalCharacteristic
:FabricFunctionalCharacteristic rdf:type owl:Class ;
                                rdfs:subClassOf :FabricCharacteristic ;
                                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                rdfs:comment "Fabric-level characteristic concerning functional performance relevant to use, comfort or intended application."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                                rdfs:label "Fabric functional characteristic"@en ;
                                <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                                <https://w3id.org/eudpp/textile-connector#modellingNote> "This superclass keeps functional fabric characteristics out of TEXTILE_CORE and separate from observed durability parameters."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#FabricHandle
:FabricHandle rdf:type owl:Class ;
              rdfs:subClassOf :FabricTactileCharacteristic ;
              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
              rdfs:comment "Fabric tactile characteristic concerning softness, smoothness, flexibility and overall sensation when touched."@en ;
              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
              rdfs:label "Fabric handle"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Fabric hand"@en ,
                                                             "Fabric softness"@en ,
                                                             "Hand feel"@en ;
              <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
              <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric handle is modelled as a fabric tactile characteristic, not as a simple fabric structural characteristic and not as an assessment result. Quantitative or qualitative measurements of softness, handle or touch should be represented through the assessment module when a concrete method or result is recorded."@en ,
                                                                       "Table 180 relates fabric softness or handle to fibre characteristics. The influence links are represented as weak annotation-level relations, not as deterministic OWL causal axioms."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-structure#FabricInsulation
:FabricInsulation rdf:type owl:Class ;
                  rdfs:subClassOf :FabricFunctionalCharacteristic ;
                  <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                  rdfs:comment "Fabric functional characteristic concerning the retention of heat and reduction of heat transfer."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                  rdfs:label "Fabric insulation"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Insulation"@en ,
                                                                 "Thermal insulation"@en ;
                  <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                  <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric insulation is represented as a fabric-level functional characteristic. Concrete insulation values or standard test results should be represented in TEXTILE_ASSESSMENT."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-structure#FabricLustre
:FabricLustre rdf:type owl:Class ;
              rdfs:subClassOf :FabricVisualCharacteristic ;
              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
              rdfs:comment "Fabric visual characteristic concerning the reflection of light that creates a shiny or glossy appearance."@en ;
              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
              rdfs:label "Fabric lustre"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Fabric luster"@en ,
                                                             "Fabric sheen"@en ,
                                                             "Fabric shininess"@en ;
              <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
              <https://w3id.org/eudpp/textile-connector#modellingNote> "Concrete observations or measurements of lustre, shininess or appearance should be represented through the assessment module when a test method, visual inspection protocol or measured value is recorded."@en ,
                                                                       "Table 180 reports that fabric shininess increases with the increase of fibre length and fibre fineness. Fabric lustre is modelled as a fabric visual characteristic, not as a structural dimension and not as an assessment result."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-structure#FabricMassPerUnitArea
:FabricMassPerUnitArea rdf:type owl:Class ;
                       rdfs:subClassOf :FabricConstructionCharacteristic ;
                       <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                       rdfs:comment "Fabric construction characteristic expressing the mass of fabric per unit surface area."@en ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                       rdfs:label "Fabric mass per unit area"@en ;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "Fabric grammage"@en ,
                                                                      "Fabric weight"@en ;
                       <https://w3id.org/eudpp/textile-connector#modellingNote> "The preferred term uses mass rather than weight, following the technical note in JRC Section 2, page 14, footnote 15. Expected SI quantity kind: quantities:SUDE (surface density)."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 4.5, printed page 41, lines 1018-1020; JRC Preparatory Study, Section 13.10.2, printed pages 493-494, lines 11902-11915; Table 182, printed page 494, caption line 11907."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                       <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> :FabricBreathability ,
                                                                                     :FabricDrape ,
                                                                                     :FabricInsulation .


###  https://w3id.org/eudpp/textile-structure#FabricRigidity
:FabricRigidity rdf:type owl:Class ;
                rdfs:subClassOf :FabricStructuralCharacteristic ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Fabric structural characteristic denoting rigidity or stiffness."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                rdfs:label "Fabric rigidity"@en ;
                <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ,
                                                                          <https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence> ;
                <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric rigidity may influence wrinkling and deformation behaviour, but the direction and acceptability depend on product type and fabric construction."@en ,
                                                                         "Reconstructed concept added to support relations between fabric manufacturing methods and fabric behaviour."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.2, Tables 178-179, printed pages 488-490; captions at lines 11875 and 11877."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> ;
                <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> <https://w3id.org/eudpp/textile-durability#Wrinkling> .


###  https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic
:FabricStructuralCharacteristic rdf:type owl:Class ;
                                rdfs:subClassOf :FabricCharacteristic ;
                                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                rdfs:comment "Characteristic of fabric structure or fabric-level physical behaviour."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                                rdfs:label "Fabric structural characteristic"@en ;
                                <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                                <https://w3id.org/eudpp/textile-connector#modellingNote> "Specific fabric structural characteristics are included as reconstructed or strongly implied concepts where needed to represent relations extracted from the JRC study."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#FabricTactileCharacteristic
:FabricTactileCharacteristic rdf:type owl:Class ;
                             rdfs:subClassOf :FabricCharacteristic ;
                             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
