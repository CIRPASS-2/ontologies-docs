###  https://w3id.org/eudpp/textile-structure#YarnAppearance
:YarnAppearance rdf:type owl:Class ;
                rdfs:subClassOf :YarnVisualCharacteristic ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Yarn visual characteristic concerning diameter, hairiness, visible defects and overall appearance."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                rdfs:label "Yarn appearance"@en ;
                <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                <https://w3id.org/eudpp/textile-connector#modellingNote> "Quantitative or qualitative observations of yarn appearance should be represented through the assessment module when a concrete test, inspection or result is recorded."@en ,
                                                                         "Table 180 reports that yarn appearance improves with the increase of fibre cleanliness. Yarn appearance is therefore modelled as a yarn-level visual characteristic, not as a fibre characteristic and not as an assessment result."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> :FabricAppearance .


