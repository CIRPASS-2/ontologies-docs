###  https://w3id.org/eudpp/textile-structure#SeamStrength
:SeamStrength rdf:type owl:Class ;
              rdfs:subClassOf :AssemblyCharacteristic ;
              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
              rdfs:comment "Assembly characteristic expressing the mechanical strength or integrity of a seam."@en ;
