                             rdfs:label "Fabric tactile characteristic"@en ;
                             <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                             <https://w3id.org/eudpp/textile-connector#modellingNote> "This superclass organises G-006 Fabric handle / fabric softness without treating it as a purely structural dimension or as an assessment result."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#FabricVisualCharacteristic
:FabricVisualCharacteristic rdf:type owl:Class ;
                            rdfs:subClassOf :FabricCharacteristic ;
                            <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                            rdfs:comment "Fabric-level characteristic concerning visible appearance, lustre, shininess, sheen or other visual qualities."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                            rdfs:label "Fabric visual characteristic"@en ;
                            <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                            <https://w3id.org/eudpp/textile-connector#modellingNote> "This superclass organises G-007 Fabric lustre / fabric shininess without treating it as a purely structural dimension or as an assessment result."@en ;
