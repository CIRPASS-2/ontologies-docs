@prefix : <https://w3id.org/eudpp/textile-structure#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-structure#> .

<https://w3id.org/eudpp/textile-structure> rdf:type owl:Ontology ;
                                            owl:versionIRI <https://w3id.org/eudpp/textile-structure/1.1.2> ;
                                            owl:imports <https://w3id.org/eudpp/textile-connector> ,
                                                        <https://w3id.org/eudpp/textile-core> ,
                                                        <https://w3id.org/eudpp/textile-dpp-mireot> ,
                                                        <https://w3id.org/eudpp/textile-durability> ;
                                            <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Structure Ontology. Version 1.1.2."@en ;
                                            <http://purl.org/dc/terms/created> "2026-03-06"^^xsd:date ;
                                            <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                            <http://purl.org/dc/terms/description> "Ontology module for characteristics of textile fibres, yarns, fabrics and assemblies. It separates characteristic types from quantitative or qualitative values and does not represent process settings, assessment results or observed degradation phenomena."@en ;
                                            <http://purl.org/dc/terms/issued> "2026-03-06"^^xsd:date ;
                                            <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                            <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                            <http://purl.org/dc/terms/title> "EU DPP Textile Structure Ontology"@en ;
                                            <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtstr" ;
                                            <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-structure#" ;
                                            rdfs:comment "Characteristic classes describe what is observed or declared about a fibre, yarn, fabric or assembly. Concrete numerical values are represented as txtcon:QuantitativeValue instances, while methods and results belong to Textile Assessment and process settings belong to Textile Process."@en ;
                                            rdfs:label "EU DPP Textile Structure Ontology"@en ;
                                            owl:versionInfo "Version 1.1.2" ;
                                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.2, pages 484-495, Tables 177-182, lines ending at 11874 and lines 11875-11920; Section 4.5, page 41, lines 1001-1037."@en ;
                                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#ontologyModule> .

