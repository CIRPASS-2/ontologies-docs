###  https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic
:TextileStructureCharacteristic rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/eudpp#Property> ;
                                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                rdfs:comment "A property describing the structure, physical constitution, mechanical behaviour, tactile quality, visual quality or functional behaviour of a textile fibre, yarn, fabric or assembly."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
                                rdfs:label "Textile structure characteristic"@en ;
                                <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                                <https://w3id.org/eudpp/textile-connector#modellingNote> "Modelled as a subclass of dpp:Property because instances are linked from products through a subproperty of dpp:hasProperty."@en ,
                                                                                         "Structural characteristics are disjoint from observed performance parameters, degradation phenomena and failure modes. For example, pilling resistance is a structure/resistance characteristic, while pilling is an observed degradation phenomenon."@en ,
                                                                                         "Structural superclass introduced to organise the module; not necessarily a verbatim JRC term."@en ,
                                                                                         "This is the top-level class for structural characteristics in the textile structure module. It should not be used for observed durability performance parameters themselves."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.2, Tables 177-182, printed pages 486-495; captions at lines 11873-11907."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-structure#ThreadCount
:ThreadCount rdf:type owl:Class ;
             rdfs:subClassOf :FabricConstructionCharacteristic ;
             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
             rdfs:comment "Fabric construction characteristic expressing the number of threads per specified unit length in a woven fabric."@en ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-structure> ;
             rdfs:label "Thread count"@en ;
             rdfs:seeAlso <https://w3id.org/eudpp/textile-process#TargetFabricDensity> ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Number of threads"@en ,
                                                            "Thread density"@en ;
             <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://w3id.org/eudpp/textile-process#TargetFabricDensity> ;
             <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
             <https://w3id.org/eudpp/textile-connector#modellingNote> "Although the JRC uses the term thread count, its definition is a density per unit length. A quantitative value should therefore include a reciprocal-length unit rather than a dimensionless count."@en ,
                                                                      "Thread count is represented in TEXTILE_STRUCTURE as a fabric construction characteristic. The related process-side concept txtprc:TargetFabricDensity remains a fabric manufacturing parameter. The two concepts should not be merged automatically; one describes a product/fabric characteristic, the other a process parameter or target."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 493-494, lines 11902-11907; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
             <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> :FabricBreathability ,
                                                                           :FabricHandle .


