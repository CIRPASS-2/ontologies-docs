              rdfs:label "Seam strength"@en ;
              <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ,
                                                                        <https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence> ;
              <https://w3id.org/eudpp/textile-connector#modellingNote> "Seam strength typically reduces the likelihood of seam-related failure modes and influences seam slippage behaviour."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.2, Table 182, printed pages 494-495; table caption at line 11907; supporting text on printed page 495, lines 11927-11932."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
              <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> <https://w3id.org/eudpp/textile-durability#SeamSlippage> ;
              <https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf> <https://w3id.org/eudpp/textile-durability#SeamFailure> .


###  https://w3id.org/eudpp/textile-structure#SewingCharacteristic
