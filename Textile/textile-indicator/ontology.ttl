@prefix : <https://w3id.org/eudpp/textile-indicator#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-indicator#> .

<https://w3id.org/eudpp/textile-indicator> rdf:type owl:Ontology ;
                                            owl:versionIRI <https://w3id.org/eudpp/textile-indicator/1.1.2> ;
                                            owl:imports <https://w3id.org/eudpp/textile-assessment> ,
                                                        <https://w3id.org/eudpp/textile-connector> ,
                                                        <https://w3id.org/eudpp/textile-dpp-mireot> ,
                                                        <https://w3id.org/eudpp/textile-durability> ;
                                            <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Indicator Ontology. Version 1.1.2."@en ;
                                            <http://purl.org/dc/terms/created> "2026-03-06"^^xsd:date ;
                                            <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                            <http://purl.org/dc/terms/description> "Ontology module for derived textile durability and use-related indicators. It separates indicators from assessment results, product characteristics, thresholds and quantitative values."@en ;
                                            <http://purl.org/dc/terms/issued> "2026-03-06"^^xsd:date ;
                                            <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                            <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                            <http://purl.org/dc/terms/title> "EU DPP Textile Indicator Ontology"@en ;
                                            <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtind" ;
                                            <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-indicator#" ;
                                            rdfs:comment "The module deliberately does not subclass dpp:QualityIndicator because the inspected DPP Core makes dpp:QualityIndicator a subclass of dpp:QuantitativeProperty. That pattern would conflate an indicator with the quantitative-value model rejected by the textile network."@en ,
                                                         "This module models interpretive or calculated indicators. It does not treat a raw assessment result, a durability characteristic, a threshold or a quantitative value as an indicator."@en ;
                                            rdfs:label "EU DPP Textile Indicator Ontology"@en ;
                                            owl:versionInfo "Version 1.1.2" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/relation
<http://purl.org/dc/terms/relation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-connector#sourceLocator
<https://w3id.org/eudpp/textile-connector#sourceLocator> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-connector#sourceType
<https://w3id.org/eudpp/textile-connector#sourceType> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-connector#typicallyContributesTo
<https://w3id.org/eudpp/textile-connector#typicallyContributesTo> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp/textile-indicator#concernsDegradationPhenomenon
:concernsDegradationPhenomenon rdf:type owl:ObjectProperty ;
                               rdfs:domain :Indicator ;
                               rdfs:range <https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon> ;
                               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "Relates an indicator to an observed textile degradation phenomenon that it interprets."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                               rdfs:label "concerns degradation phenomenon"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#concernsDurabilityAspect
:concernsDurabilityAspect rdf:type owl:ObjectProperty ;
                          rdfs:domain :Indicator ;
                          rdfs:range <https://w3id.org/eudpp/textile-durability#Durability> ;
                          <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                          rdfs:comment "Relates an indicator to the durability concept whose interpretation it supports."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                          rdfs:label "concerns durability aspect"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#concernsFailureMode
:concernsFailureMode rdf:type owl:ObjectProperty ;
                     rdfs:domain :Indicator ;
                     rdfs:range <https://w3id.org/eudpp/textile-durability#FailureMode> ;
                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                       <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Relates an indicator to a textile failure mode that it interprets or uses in its derivation."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                     rdfs:label "concerns failure mode"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3177-3180."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#concernsPerformanceParameter
:concernsPerformanceParameter rdf:type owl:ObjectProperty ;
                              rdfs:domain :Indicator ;
                              rdfs:range <https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter> ;
                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                              rdfs:comment "Relates an indicator to the durability-related performance parameter that it interprets."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                              rdfs:label "concerns performance parameter"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#concernsProduct
:concernsProduct rdf:type owl:ObjectProperty ;
                 rdfs:domain :Indicator ;
                 rdfs:range <https://w3id.org/eudpp#Product> ;
                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                 rdfs:comment "Relates an indicator to the product that it describes or interprets."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                 rdfs:label "concerns product"@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#contributesToIndicator
:contributesToIndicator rdf:type owl:ObjectProperty ;
                        rdfs:domain :Indicator ;
                        rdfs:range :Indicator ;
                        <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Relates an indicator to a broader indicator to which it contributes."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                        rdfs:label "contributes to indicator"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#derivedFrom
:derivedFrom rdf:type owl:ObjectProperty ;
             rdfs:domain :Indicator ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( <https://w3id.org/eudpp/textile-assessment#AssessmentResult>
                                        :Indicator
                                      )
                        ] ;
             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
             rdfs:comment "Relates an indicator to an assessment result or another indicator used as evidence in its calculation, aggregation or interpretation."@en ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
             rdfs:label "derived from"@en ;
             <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#derivedUsingMethod
:derivedUsingMethod rdf:type owl:ObjectProperty ;
                    rdfs:domain :Indicator ;
                    rdfs:range <https://w3id.org/eudpp/textile-assessment#AssessmentMethod> ;
                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                      <https://w3id.org/eudpp/textile-ontology> ;
                    rdfs:comment "Relates an indicator to the assessment, scoring or interpretive method used to derive it."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                    rdfs:label "derived using method"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 11.1.1.1, printed pages 185-186, lines 5251-5284."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#evaluatedAgainstThreshold
:evaluatedAgainstThreshold rdf:type owl:ObjectProperty ;
                           rdfs:domain :Indicator ;
                           rdfs:range <https://w3id.org/eudpp/textile-assessment#PerformanceThreshold> ;
                           <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                           rdfs:comment "Relates an indicator to a performance threshold used to interpret or classify its value."@en ;
                           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                           rdfs:label "evaluated against threshold"@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#hasCategoricalValue
:hasCategoricalValue rdf:type owl:ObjectProperty ;
                     rdfs:domain :Indicator ;
                     rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                     <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Relates an indicator to a controlled categorical, ordinal or rating value represented as a SKOS concept."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                     rdfs:label "has categorical value"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#hasConstituentIndicator
:hasConstituentIndicator rdf:type owl:ObjectProperty ;
                         owl:inverseOf :contributesToIndicator ;
                         rdfs:domain :Indicator ;
                         rdfs:range :Indicator ;
                         <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                         rdfs:comment "Relates an aggregate or trajectory indicator to a more specific indicator included in its derivation."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                         rdfs:label "has constituent indicator"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#hasIndicator
:hasIndicator rdf:type owl:ObjectProperty ;
              owl:inverseOf :isIndicatorOf ;
              rdfs:domain <https://w3id.org/eudpp#Product> ;
              rdfs:range :Indicator ;
              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
              rdfs:comment "Relates a product to an indicator that describes or interprets it."@en ;
              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
              rdfs:label "has indicator"@en ;
              <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#hasQuantitativeValue
:hasQuantitativeValue rdf:type owl:ObjectProperty ;
                      rdfs:domain :Indicator ;
                      rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates an indicator to the quantitative value that expresses its reported or calculated value."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                      rdfs:label "has quantitative value"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#hasReferencePeriod
:hasReferencePeriod rdf:type owl:ObjectProperty ;
                    rdfs:domain :Indicator ;
                    rdfs:range <https://w3id.org/eudpp/textile-connector#ReferencePeriod> ;
                    <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                    rdfs:comment "Relates an indicator to the structured temporal interval to which it applies."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                    rdfs:label "has reference period"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#informsEstimateOf
:informsEstimateOf rdf:type owl:ObjectProperty ;
                   rdfs:domain :Indicator ;
                   rdfs:range :LifetimeOfProduct ;
                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                     <https://w3id.org/eudpp/textile-ontology> ;
                   rdfs:comment "Relates supporting indicator evidence to a lifetime-of-product indicator whose value is inferred from that evidence."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                   rdfs:label "informs estimate of"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3168-3181."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#isIndicatorOf
:isIndicatorOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :concernsProduct ;
               rdfs:domain :Indicator ;
               rdfs:range <https://w3id.org/eudpp#Product> ;
               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
               rdfs:comment "Relates an indicator to the product that it describes or interprets."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
               rdfs:label "is indicator of"@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#isQualifiedByParameterSetting
:isQualifiedByParameterSetting rdf:type owl:ObjectProperty ;
                               rdfs:domain :Indicator ;
                               rdfs:range <https://w3id.org/eudpp/textile-assessment#MeasurementParameterSetting> ;
                               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "Relates an indicator to the concrete measurement-parameter setting that qualifies its meaning, such as a number and type of cycles."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                               rdfs:label "is qualified by parameter setting"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#isStructuredByMeasurementParameter
:isStructuredByMeasurementParameter rdf:type owl:ObjectProperty ;
                                    rdfs:domain :Indicator ;
                                    rdfs:range <https://w3id.org/eudpp/textile-assessment#MeasurementParameter> ;
                                    <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                    rdfs:comment "Relates a series or trajectory indicator to the measurement parameter used as its organising axis."@en ;
                                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                                    rdfs:label "is structured by measurement parameter"@en ;
                                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#supportsAssessmentOf
:supportsAssessmentOf rdf:type owl:ObjectProperty ;
                      rdfs:domain :Indicator ;
                      rdfs:range <https://w3id.org/eudpp/textile-durability#Durability> ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates an indicator to a durability concept whose assessment it supports without asserting equivalence."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                      rdfs:label "supports assessment of"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/eudpp/textile-indicator#calculationAssumption
:calculationAssumption rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Indicator ;
                       rdfs:range xsd:string ;
                       <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                         <https://w3id.org/eudpp/textile-ontology> ;
                       rdfs:comment "Textual statement of an assumption used in calculating, estimating or interpreting an indicator."@en ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                       rdfs:label "calculation assumption"@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 11.1.1, printed page 185, lines 5239-5243."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#calculationDescription
:calculationDescription rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Indicator ;
                        rdfs:range xsd:string ;
                        <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Textual description of the calculation, aggregation or interpretation procedure used for an indicator."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-indicator> ;
                        rdfs:label "calculation description"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-indicator#hasTextualValue
:hasTextualValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Indicator ;
                 rdfs:range xsd:string ;
                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
