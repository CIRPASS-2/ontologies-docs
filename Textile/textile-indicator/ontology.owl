<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/textile-indicator#"
     xml:base="https://w3id.org/eudpp/textile-indicator"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:textile-connector="https://w3id.org/eudpp/textile-connector#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-indicator">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-indicator/1.1.2"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Textile Indicator Ontology. Version 1.1.2.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:created>
        <terms:creator xml:lang="en">Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Ontology module for derived textile durability and use-related indicators. It separates indicators from assessment results, product characteristics, thresholds and quantitative values.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:title xml:lang="en">EU DPP Textile Indicator Ontology</terms:title>
        <vann:preferredNamespacePrefix>txtind</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-indicator#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">The module deliberately does not subclass dpp:QualityIndicator because the inspected DPP Core makes dpp:QualityIndicator a subclass of dpp:QuantitativeProperty. That pattern would conflate an indicator with the quantitative-value model rejected by the textile network.</rdfs:comment>
        <rdfs:comment xml:lang="en">This module models interpretive or calculated indicators. It does not treat a raw assessment result, a durability characteristic, a threshold or a quantitative value as an indicator.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Textile Indicator Ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/relation -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/relation"/>
    


    <!-- http://purl.org/dc/terms/source -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- https://w3id.org/eudpp/textile-connector#sourceLocator -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#sourceLocator"/>
    


    <!-- https://w3id.org/eudpp/textile-connector#sourceType -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#sourceType"/>
    


    <!-- https://w3id.org/eudpp/textile-connector#typicallyContributesTo -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicallyContributesTo"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/textile-indicator#concernsDegradationPhenomenon -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#concernsDegradationPhenomenon">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to an observed textile degradation phenomenon that it interprets.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">concerns degradation phenomenon</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#concernsDurabilityAspect -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#concernsDurabilityAspect">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to the durability concept whose interpretation it supports.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">concerns durability aspect</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#concernsFailureMode -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#concernsFailureMode">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to a textile failure mode that it interprets or uses in its derivation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">concerns failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3177-3180.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#concernsPerformanceParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#concernsPerformanceParameter">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to the durability-related performance parameter that it interprets.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">concerns performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#concernsProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#concernsProduct">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to the product that it describes or interprets.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">concerns product</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#contributesToIndicator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#contributesToIndicator">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to a broader indicator to which it contributes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">contributes to indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#derivedFrom -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#derivedFrom">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#Indicator"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to an assessment result or another indicator used as evidence in its calculation, aggregation or interpretation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">derived from</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#derivedUsingMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#derivedUsingMethod">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to the assessment, scoring or interpretive method used to derive it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">derived using method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 11.1.1.1, printed pages 185-186, lines 5251-5284.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#evaluatedAgainstThreshold -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#evaluatedAgainstThreshold">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#PerformanceThreshold"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to a performance threshold used to interpret or classify its value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">evaluated against threshold</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#hasCategoricalValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#hasCategoricalValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to a controlled categorical, ordinal or rating value represented as a SKOS concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">has categorical value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#hasConstituentIndicator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#hasConstituentIndicator">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-indicator#contributesToIndicator"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an aggregate or trajectory indicator to a more specific indicator included in its derivation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">has constituent indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#hasIndicator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#hasIndicator">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-indicator#isIndicatorOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a product to an indicator that describes or interprets it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">has indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#hasQuantitativeValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#hasQuantitativeValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to the quantitative value that expresses its reported or calculated value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">has quantitative value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#hasReferencePeriod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#hasReferencePeriod">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#ReferencePeriod"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to the structured temporal interval to which it applies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">has reference period</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#informsEstimateOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#informsEstimateOf">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-indicator#LifetimeOfProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates supporting indicator evidence to a lifetime-of-product indicator whose value is inferred from that evidence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">informs estimate of</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3168-3181.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#isIndicatorOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#isIndicatorOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-indicator#concernsProduct"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to the product that it describes or interprets.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">is indicator of</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#isQualifiedByParameterSetting -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#isQualifiedByParameterSetting">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#MeasurementParameterSetting"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to the concrete measurement-parameter setting that qualifies its meaning, such as a number and type of cycles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">is qualified by parameter setting</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#isStructuredByMeasurementParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#isStructuredByMeasurementParameter">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#MeasurementParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a series or trajectory indicator to the measurement parameter used as its organising axis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">is structured by measurement parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#supportsAssessmentOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#supportsAssessmentOf">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to a durability concept whose assessment it supports without asserting equivalence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">supports assessment of</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


