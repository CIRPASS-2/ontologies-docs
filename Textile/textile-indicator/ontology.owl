    <!-- https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
    


    <!-- https://w3id.org/eudpp/textile-indicator#DegradationRate -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#DegradationRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Calculated indicator expressing change in a performance parameter or degradation phenomenon per stated unit of time, use, cycle or exposure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Degradation rate</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 11.1.1, printed page 185, lines 5231-5243.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#DurabilityIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#DurabilityIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <terms:relation rdf:resource="https://w3id.org/eudpp#QualityIndicator"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Indicator used to express or interpret durability-related evidence about a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Durability indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#EstimatedLifetime -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#EstimatedLifetime">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#LifetimeOfProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">An estimated lifetime is not a directly measured property and must identify its evidence, method and assumptions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Estimated lifetime</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3168-3181; JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5243.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#Indicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#Indicator">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Derived information object used to calculate, interpret, aggregate, compare or communicate evidence about a textile product. An indicator is not the underlying assessment result, characteristic, threshold or quantitative value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#LifetimeIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#LifetimeIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#DurabilityIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Durability indicator expressing, estimating or interpreting a product lifespan or duration of service.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Lifetime indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 5.8, printed page 73, lines 1695-1715; Section 9.2.1.5, printed page 121, lines 3168-3179.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#LifetimeOfProduct -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#LifetimeOfProduct">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#LifetimeIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Indicator expressing a stated, observed or inferred lifespan of a textile product using a specified lifespan descriptor and stated assumptions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Lifetime of product</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 5.8, printed page 73, lines 1695-1710; JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3168-3181; JRC Preparatory Study, Section 5.8, Table 32, printed page 73; caption line 1703.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#NumberOfUseCycles -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#NumberOfUseCycles">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#UseRelatedIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">This indicator concerns product use and must not be confused with txtass:NumberOfCycles used as a test-protocol parameter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Number of use cycles</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5238.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#PerformanceAfterNCycles -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#PerformanceAfterNCycles">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Derived performance indicator reporting a performance state or level after a stated number and type of use, wash, abrasion, ageing or other cycles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Performance after N cycles</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5238.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#PerformanceIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#DurabilityIndicator"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Durability indicator expressing a derived level, score, rate, retention or trajectory of a durability-related performance parameter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Performance indicator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#PerformanceLevelOverTime -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#PerformanceLevelOverTime">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A performance trajectory should preserve the underlying assessment results or constituent point indicators from which it was derived.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Performance level over time</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5243.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#PerformanceRetentionRate -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#PerformanceRetentionRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Calculated indicator expressing retained performance relative to an initial or reference performance value under stated calculation rules.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Performance retention rate</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5243.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#ProductReplacementFrequency -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#ProductReplacementFrequency">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#UseRelatedIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Replacement frequency is not a direct measure of intrinsic durability because disposal and replacement also depend on fit, perceived value, fashion and other contextual factors.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Product replacement frequency</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 5.8, printed page 73, lines 1695-1710; JRC Preparatory Study, Section 6.4.1, printed pages 88-89, lines 2281-2294.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#RobustnessScore -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#RobustnessScore">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Score produced by a robustness scoring method from selected textile test and visual-inspection results; it is proxy information for physical durability and is not a service-lifetime value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">Robustness score</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5228-5246; JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5251-5286; JRC Preparatory Study, Section 11.1.1.1, Table 71, printed page 186; caption line 5284.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicallyContributesTo rdf:resource="https://w3id.org/eudpp/textile-durability#IntrinsicDurability"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-indicator#UseRelatedIndicator -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-indicator#UseRelatedIndicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Indicator concerning actual or expected product use, use-cycle count or replacement behaviour.</rdfs:comment>
