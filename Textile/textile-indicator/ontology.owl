    <!-- https://w3id.org/eudpp/textile-indicator#calculationAssumption -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/textile-indicator#calculationAssumption">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Textual statement of an assumption used in calculating, estimating or interpreting an indicator.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">calculation assumption</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 11.1.1, printed page 185, lines 5239-5243.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#calculationDescription -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/textile-indicator#calculationDescription">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Textual description of the calculation, aggregation or interpretation procedure used for an indicator.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">calculation description</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/textile-indicator#hasTextualValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/textile-indicator#hasTextualValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an indicator to a free-text value when no controlled categorical value is available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <rdfs:label xml:lang="en">has textual value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:DatatypeProperty>
    


