        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter relevant to textile finishing, including chemical and mechanical finishing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Finishing parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#FinishingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#FinishingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileManufacturingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile process applied to modify appearance, handle, function or physical properties of textile materials or products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Finishing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#FinishingTreatmentParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#FinishingTreatmentParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FinishingParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter describing a finishing treatment type, intensity, duration or configuration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Finishing treatment parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#FixationCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#FixationCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#DyeingParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Dyeing or printing parameter describing conditions used to fix a dye, pigment, print or finish to the textile material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Fixation condition</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#HumidityControl -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#HumidityControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter describing control of humidity during textile manufacturing, processing or care.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Humidity control</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Proper humidity control can prevent static electricity, material processing issues, equipment damage and fabric shrinkage.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#IncinerationProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#IncinerationProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">End-of-life process involving combustion of textile products or textile waste.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Incineration process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#InputYarnCountSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#InputYarnCountSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricConstructionParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A process target or input specification stating the yarn count or yarn linear-density class selected for fabric manufacturing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Input yarn count specification</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The JRC identifies yarn count as one of the weaving parameters affecting fabric characteristics. The exact target characteristic depends on fabric construction, yarn type and end use; therefore only weak influence annotations are used.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The process-side target remains distinct from the resulting characteristic represented in Textile Structure.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Yarn count is identified by the JRC as a fabric manufacturing parameter affecting fabric characteristics. A broad weak influence target is used here because the specific effect depends on yarn type, fabric construction and end use.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#IroningProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#IroningProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ConfectioningProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Confectioning or care-related process applying heat and pressure to shape, smooth or finish textile products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Ironing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#IroningTemperature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#IroningTemperature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#CareParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Care parameter describing ironing temperature.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Ironing temperature</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#KnittingPatternSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#KnittingPatternSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricConstructionParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A process target specification stating the knitting structure or pattern to be produced.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Knitting pattern specification</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Knitting pattern is kept as a process-side construction parameter. Its relation to fabric elasticity and drape depends on the knitting structure and yarn choice.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The process-side target remains distinct from the resulting characteristic represented in Textile Structure.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricDrape"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricElasticity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#KnittingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#KnittingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricManufacturingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric manufacturing process in which yarns are interlooped using needles to form fabric on knitting machines.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Knitting process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Knitting is generally used for relatively more elastic fabrics, depending on yarns, knitting pattern and product application.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricElasticity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#LaminatingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#LaminatingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FinishingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Finishing or assembly process joining textile materials with layers or membranes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Laminating process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#LandfillingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#LandfillingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">End-of-life process involving disposal of textile products or textile waste in landfill.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Landfilling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#LiquorRatio -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#LiquorRatio">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#DyeingParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Dyeing-process parameter expressing the relation between the quantity of treatment liquor and the mass of dry textile material. The reporting basis and unit must be stated explicitly.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Liquor ratio</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">The JRC example uses litres of water per kilogram of textile material; it should not automatically be treated as a dimensionless ratio.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.6.1, printed pages 144-145, lines 4001-4031.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#MachineryCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#MachineryCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter or equipment characteristic describing machinery quality, configuration or components relevant to textile processing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Machinery characteristic</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">High quality machinery and components are modelled as contributing to consistent yarns and mechanical-related yarn performance.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#MaintenanceAndRepairProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#MaintenanceAndRepairProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#UseAndCareProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">This class groups processes that are related to lifetime extension but are not assessment indicators. Product lifetime itself is represented in TEXTILE_INDICATOR.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Maintenance and repair process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#MechanicalFinishingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#MechanicalFinishingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FinishingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Finishing process using mechanical treatment to modify physical properties, surface behaviour, handle or appearance of textile materials or products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Mechanical finishing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Mechanical finishing can provide or modify physical properties such as handle, surface behaviour and structural performance. Links to observed durability parameters should be asserted only when the specific performance effect is known.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#RecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Recycling process mechanically transforming textile products or textile waste into reusable fibres or materials.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Mechanical recycling process</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This class represents a recycling process type. Product recyclability, barriers, compatibility and recyclability assessment belong to the Textile Recyclability module.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#NonwovenManufacturingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#NonwovenManufacturingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricManufacturingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Fabric manufacturing process producing nonwoven textile structures by bonding or entangling fibres or filaments.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Nonwoven manufacturing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PackagingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PackagingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">PackagingProcess is included so that packaging material can be used as an input in a process context without treating packaging material as an input to ordinary textile manufacturing processes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Packaging process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">Textile ontology project process-modelling decision; domain evidence: JRC Table 8, printed pages 27-29, caption line 546; Table 168, printed page 459, caption line 10991; Annex 13.11.9, printed page 512, lines 12384-12387.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PolycottonThermoChemicalRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PolycottonThermoChemicalRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Chemical or thermo-chemical recycling process for polycotton blends, producing cellulosic pulp, polyester fibres, polymers or monomers depending on the applied technique.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Polycotton thermo-chemical recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PrintingBinderUse -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PrintingBinderUse">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#PrintingParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">The binder substance or chemical role should be represented in TEXTILE_ASSOCIATED_MATERIALS. This parameter only records the process-use aspect.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Printing binder use</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PrintingParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PrintingParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FinishingParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessControlParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter relevant to textile printing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Printing parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PrintingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PrintingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#WetProcessingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile process applying colour, patterns or markings to textile materials or products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Printing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Printing gives colour-related characteristics and may influence colour fastness depending on process and material choices.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#ColourFastness"/>
        <typicallyUsesChemicalFunction rdf:resource="https://w3id.org/eudpp/textile-associated-materials-codelists#pigment"/>
        <typicallyUsesChemicalUseCategory rdf:resource="https://w3id.org/eudpp/textile-associated-materials-codelists#performanceChemical"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ProcessControlParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ProcessControlParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A process parameter that controls, configures or monitors the execution conditions of a textile process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Process control parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">motivated by JRC Table 181 and care-process parameters.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ProcessMethodConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ProcessMethodConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled value for a textile process method or technique.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Process method concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ProcessParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ProcessParameter">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A semantic type for a configurable process condition, method choice, control variable or target specification relevant to a textile process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Process parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">domain motivation from JRC Annex 13.10.2, pages 492-493, Table 181, lines 11889-11901. JRC Annex 13.10.2, pages 493-495, Table 182, lines 11902-11920. JRC Section 9.2.2.2, pages 125-126, lines 3296-3327; Annex 13.7.2, pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ProcessParameterSetting -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ProcessParameterSetting">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A concrete value or selected category assigned to a process parameter for a specific process execution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Process parameter setting</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-009.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ProcessTargetSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ProcessTargetSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A process-side specification stating a target product or intermediate-product characteristic to be achieved by a process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Process target specification</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">A target specification is not the resulting measured product characteristic.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">motivated by JRC Table 182.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#PyrolysisGasificationRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#PyrolysisGasificationRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Thermo-chemical process producing syngas or pyrolysis oil that may be used as feedstock for material production. Use of the output as fuel is energy recovery and is not represented as recycling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Pyrolysis or gasification recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#RecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#RecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">End-of-life process that transforms textile products, textile waste or recovered textile materials into reusable fibre or material feedstock.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#RepairProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#RepairProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#MaintenanceAndRepairProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Repair can extend the usable lifetime of a textile product, but this module does not import TEXTILE_INDICATOR. Links from repair to product lifetime indicators should be handled in TEXTILE_INDICATOR or in a cross-module relation layer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Repair process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Repair can extend the usable lifetime of a textile product. Product lifetime indicators are represented in TEXTILE_INDICATOR, and any formal link should be handled there or in a cross-module relation layer.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">This class represents a repair activity or process type. Repairability capability, repair service information and repairability assessment belong to Textile Repairability.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3484; JRC Preparatory Study, Section 13.10.1.5, printed pages 473-474, lines 11273-11326.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ReuseProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ReuseProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">End-of-life or post-use process enabling a textile product to be used again without major material transformation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Reuse process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SeamConstructionParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SeamConstructionParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SewingParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Sewing parameter describing seam type, stitch, thread, construction or other seam-related configuration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Seam construction parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SewingParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SewingParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ConfectioningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Confectioning parameter relevant to sewing operations and seam formation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Sewing parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SewingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SewingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ConfectioningProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Confectioning process joining textile parts or components using stitches or seams.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Sewing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Sewing process characteristics influence seam strength and final product durability.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#SeamStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#SewingCharacteristic"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinSpeed -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinSpeed">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#CareParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Care parameter describing spin speed used in laundering.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spin speed</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningLimit -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningLimit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter expressing the range of yarn counts achievable from a given fibre using a specific spinning system; it depends on the number and thickness of fibres or filaments twisted together.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning limit</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Table 180 reports that spinning limit increases proportionally with the increase of fibre length, fibre strength and fibre fineness. These dependencies are represented as weak influence annotations, not as OWL causal axioms.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Table 179, printed page 489; table caption at line 11877.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningMethodConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningMethodConcept">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessMethodConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled value for a spinning method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning method concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningMethodParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningMethodParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">When the selected method is represented directly as a controlled value on a spinning process, use txtprc:hasSpinningMethod with a txtprc:SpinningMethodConcept. This class is retained only when the method must be treated explicitly as a process parameter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning method parameter</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">The selected spinning method provides different levels of yarn evenness, softness and strength. Specific methods are represented as SKOS concepts.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnSoftness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessControlParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter relevant to spinning or yarn manufacturing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#YarnManufacturingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Specific spinning techniques such as ring spinning, rotor open-end spinning and air-jet spinning are represented as SKOS concepts in the spinning method scheme.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningProductivity -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningProductivity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter expressing the finest yarn count producible from a given fibre while maintaining acceptable performance and minimising end-breakage rates.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning productivity</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Table 180 reports that spinning productivity increases with the increase of fibre length, fibre strength and fibre fineness. These dependencies are represented as weak influence annotations, not as OWL causal axioms.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.2, Table 179, printed page 489; table caption at line 11877.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningSpeed -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningSpeed">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Spinning parameter describing the speed of spinning.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning speed</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Higher spinning speeds can cause breakages and may negatively influence yarn strength depending on process conditions.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SpinningTension -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SpinningTension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Spinning parameter describing tension during spinning.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Spinning tension</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Controlling optimal spinning tension is important for yarn strength and uniformity; uneven tension can cause breakages during subsequent processing.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#StorageConditionParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#StorageConditionParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#CareParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Care parameter describing storage-related conditions, such as humidity, sunlight exposure, folding or hanging.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Storage condition parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#StorageProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#StorageProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#UseAndCareProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Use-phase or care-related process involving storage of a textile product under specified or unspecified conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Storage process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Storage conditions such as excessive humidity or direct sunlight may affect textile durability. Detailed environmental conditions are represented in the Textile Context module.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#ColourFastness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#FabricBreakdown"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#SyntheticFibreChemicalRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#SyntheticFibreChemicalRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Chemical recycling process for synthetic textile feedstock such as polyester or polyamide 6, producing recovered monomers, oligomers or polymers.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Synthetic-fibre chemical recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TargetFabricDensity -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TargetFabricDensity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricConstructionParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A process target specification stating the intended thread or loop density of the resulting fabric.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Target fabric density</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Fabric density is related to thread count or loop density. Its effects on breathability, handle and appearance are mediated by fabric type and construction.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The process-side target remains distinct from the resulting characteristic represented in Textile Structure.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">This class is not declared equivalent to txtstr:ThreadCount. FabricDensity is process-side and may cover thread density, loop density or related construction-density settings; ThreadCount is the structure-side fabric characteristic currently represented in TEXTILE_STRUCTURE.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricAppearance"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricBreathability"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricHandle"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TargetFabricMassPerUnitArea -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TargetFabricMassPerUnitArea">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricConstructionParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A process target specification stating the intended mass of fabric per unit surface area.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Target fabric mass per unit area</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Expected SI quantity kind: quantities:SUDE (surface density).</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Fabric weight is represented here as a process-side target or parameter. The influence annotations point to structure-side fabric characteristics rather than merging both concepts.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The process-side target remains distinct from the resulting characteristic represented in Textile Structure.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">This class is not declared equivalent to txtstr:FabricMassPerUnitArea, because this module represents the process-side parameter or target setting, whereas TEXTILE_STRUCTURE represents the resulting fabric characteristic.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricBreathability"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricDrape"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricInsulation"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TemperatureControl -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TemperatureControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter describing control of temperature during textile manufacturing, processing or care.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Temperature control</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Temperature control is modelled as a process parameter influencing yarn processing quality and mechanical-related characteristics.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileCareInstruction -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileCareInstruction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Product instruction describing recommended textile care operations or conditions, such as washing temperature and cycle, detergent use, drying, ironing, bleaching or professional cleaning.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Textile care instruction</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The instruction is product information. User compliance with that instruction is represented separately as a Textile Context observation.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.3.2, printed page 85, lines 2144-2173; JRC Preparatory Study, Section 13.7.2.8, printed page 404, lines 10440-10458.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileEndOfLifeInstruction -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileEndOfLifeInstruction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <rdfs:comment xml:lang="en">Product instruction supporting appropriate end-of-life handling of a textile product, including collection, sorting, preparation for reuse, material separation, recycling or another stated waste-management route.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Textile end-of-life instruction</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This class represents general product instructions. Substance-triggered lifecycle instructions remain represented through the SoC instruction model and should not be duplicated here.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.3.8, printed page 359, lines 9662-9688; JRC Preparatory Study, Section 6.3.3, printed page 86, lines 2183-2192; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546; JRC DPP Study, Section 7.3, printed page 49, end-of-life treatment information data point.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileManufacturingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileManufacturingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile process involved in the manufacturing or transformation of textile fibres, yarns, fabrics, assemblies or finished textile products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Textile manufacturing process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileProcess">
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A type of process involved in manufacturing, transforming, using, caring for, repairing, reusing, recycling or treating a textile product, including a product used as a component of another product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Textile process</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The JRC describes process families across lifecycle stages; the ontology introduces a common superclass.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileProcessExecution -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A concrete occurrence of a textile process applied to one or more products, including products serving an intermediate or component role, materials or components.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Textile process execution</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-008.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ThermoMechanicalRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ThermoMechanicalRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#RecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Recycling process in which thermoplastic textile polymers are remelted or otherwise thermally and mechanically reprocessed into granulate or fibre material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Thermo-mechanical recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TwistLevel -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TwistLevel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Spinning parameter describing the degree or level of twist inserted into a yarn.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Twist level</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Twist level may enhance yarn tenacity and pilling resistance, diminish yarn softness and elasticity, and increase spirality. Yarn strength increases with twist to a peak and may then decrease.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#PillingResistance"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnElasticity"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnSoftness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TwistNumber -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TwistNumber">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#SpinningParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Spinning parameter describing the number of twists inserted into a yarn.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Twist number</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">The number of twists is treated as a process parameter closely related to twist level. Its effects are context-dependent and mediated by fibre characteristics.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnSoftness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#UseAndCareProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#UseAndCareProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process occurring during the use or care phase of a textile product, including wearing, washing, drying, cleaning, ironing and storage-related care.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Use and care process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#UseWearProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#UseWearProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#UseAndCareProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Use-phase process corresponding to wearing, using or exposing a textile product during its intended use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Use or wear process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#WashingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#WashingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#UseAndCareProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Care process involving laundering or washing of a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Washing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Washing conditions may influence colour fastness and dimensional stability during use and care.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#ColourFastness"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#DimensionalStability"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#WashingTemperature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#WashingTemperature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#CareParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Care parameter describing the temperature used in a washing process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Washing temperature</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Expected SI quantity kind for a Celsius temperature value: quantities:TEMC; expected unit: units:degreeCelsius.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#WeavePatternSpecification -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#WeavePatternSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricConstructionParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A process target specification stating the weave pattern to be produced.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Weave pattern specification</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The JRC identifies weave pattern as one of the weaving parameters affecting fabric characteristics. The relation is represented as weak influence annotations rather than as deterministic OWL axioms.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The process-side target remains distinct from the resulting characteristic represented in Textile Structure.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Weave pattern is a fabric construction parameter that may affect visual appearance, permeability, drape and handle. The relation is represented as weak influence because the direction depends on the specific weave and yarns.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114.</textile-connector:sourceLocator>
