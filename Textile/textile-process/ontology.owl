    <!-- https://w3id.org/eudpp#hasProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasProperty"/>
    


    <!-- https://w3id.org/eudpp/textile-process#appliesTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#appliesTo">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile process type or concrete process execution to a textile product to which it applies, including a product used as a component of another product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">applies to</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process participation pattern; domain motivation from JRC Section 3.3.1, Table 8</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#concernsProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#concernsProduct">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-process#hasProcessExecution"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a concrete textile process execution to the textile product that it concerns, including a product used as a component of another product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">concerns product</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">clearer replacement for the ambiguous local name concerns.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#executesProcessType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#executesProcessType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a concrete textile process execution to the textile process type that it instantiates.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">executes process type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-007.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#hasCareInstruction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#hasCareInstruction">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#TextileCareInstruction"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile product to product-specific care instructions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has care instruction</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.3.2, printed page 85, lines 2144-2173; JRC Preparatory Study, Section 13.7.2.8, printed page 404, lines 10440-10458.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#hasCategoricalValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#hasCategoricalValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameterSetting"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a process parameter setting to a controlled SKOS concept used as its categorical value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has categorical value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process value pattern: controlled categorical values are represented as SKOS concepts rather than free text</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#hasEndOfLifeInstruction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#hasEndOfLifeInstruction">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#TextileEndOfLifeInstruction"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile product to product-specific instructions for its end-of-life handling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has end-of-life instruction</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.3.8, printed page 359, lines 9662-9688; JRC Preparatory Study, Section 6.3.3, printed page 86, lines 2183-2192; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546; JRC DPP Study, Section 7.3, printed page 49, end-of-life treatment information data point.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#hasFabricManufacturingMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#hasFabricManufacturingMethod">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-process#hasProcessMethod"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#FabricManufacturingProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#FabricManufacturingMethodConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a fabric manufacturing process type or concrete execution to a controlled fabric-manufacturing-method concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has fabric manufacturing method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#hasProcessExecution -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#hasProcessExecution">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile product, including a product used as a component of another product, to a concrete process execution applied to it or recorded in its lifecycle.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has process execution</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process execution pattern; domain motivation from JRC Section 3.3.1, Table 8</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#hasProcessMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#hasProcessMethod">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#ProcessMethodConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile process type or concrete execution to a controlled SKOS concept identifying the selected process method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has process method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#hasProcessParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#hasProcessParameter">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile process type to a process parameter or target specification relevant to that process type. Concrete executions use txtprc:hasProcessParameterSetting.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has process parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">concrete value belongs to a parameter setting.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#hasProcessParameterSetting -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#hasProcessParameterSetting">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameterSetting"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a concrete process execution to a concrete parameter setting used in that execution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has process parameter setting</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#hasQuantitativeValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#hasQuantitativeValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameterSetting"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a concrete process parameter setting to a quantitative value containing a number, a measurement unit and, when useful, a quantity kind.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has quantitative value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-003.md</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#hasSpinningMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#hasSpinningMethod">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-process#hasProcessMethod"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#SpinningProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#SpinningMethodConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a spinning process type or concrete execution to a controlled spinning-method concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has spinning method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#isRepresentedByProductEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#isRepresentedByProductEvent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Links a concrete textile process execution to the product event that records or represents it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">is represented by product event</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This bridge does not assert that a process execution is itself an event. It links the execution to an event resource that records or represents it.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#parameterOfProcess -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#parameterOfProcess">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-process#hasProcessParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a process parameter or target specification to the textile process type that it configures or specifies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">parameter of process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Inverse of the corrected hasProcessParameter pattern</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#producesOutput -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#producesOutput">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile process type or execution to a textile product produced as an output, including a product that may subsequently be used as a component of another product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">produces output</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#representsProcessExecution -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#representsProcessExecution">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-process#isRepresentedByProductEvent"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Links a product event to the textile process execution it records or represents.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">represents process execution</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This bridge does not assert that a process execution is itself an event. It links the execution to an event resource that records or represents it.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#settingForProcessParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#settingForProcessParameter">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameterSetting"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a concrete process parameter setting to the parameter type or target specification that it instantiates.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">setting for process parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#usesChemicalFunction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#usesChemicalFunction">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile process type or execution to the technical function of a chemical used in that process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">uses chemical function</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#usesChemicalSubstance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#usesChemicalSubstance">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile process type or execution to a specific textile chemical substance used in the process. This does not imply that the substance remains in the final product or is a substance of concern.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">uses chemical substance</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#usesChemicalUseCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#usesChemicalUseCategory">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile process type or execution to the use category of a chemical used in that process, such as process chemical or performance chemical.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">uses chemical use category</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#usesInput -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#usesInput">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#MaterialOfComposition"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-core#TextileProduct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile process type or execution to a textile product, including a product serving an intermediate or component role, or to a material of composition, chemical substance, non-textile component or packaging material used as an input.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">uses input</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


