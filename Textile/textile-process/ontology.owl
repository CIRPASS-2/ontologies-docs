        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a process parameter setting to a free-text value when no controlled concept is available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">has textual value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process value pattern, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:DatatypeProperty>
    


