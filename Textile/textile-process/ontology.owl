    <!-- https://w3id.org/eudpp/textile-process#typicallyUsesChemicalFunction -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-process#typicallyUsesChemicalFunction">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a textile process type typically uses a chemical function represented in Textile Associated Materials.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">typically uses chemical function</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-process#typicallyUsesChemicalUseCategory -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-process#typicallyUsesChemicalUseCategory">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a textile process type typically uses a chemical from a use category represented in Textile Associated Materials.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">typically uses chemical use category</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:AnnotationProperty>
    


