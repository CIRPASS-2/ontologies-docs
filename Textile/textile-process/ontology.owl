    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileProduct"/>
    


    <!-- https://w3id.org/eudpp/textile-process#CareMethodConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#CareMethodConcept">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessMethodConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled value for a textile care method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Care method concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#CareParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#CareParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessControlParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process parameter relevant to textile care, including washing, drying, ironing, bleaching, cleaning or storage conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Care parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#CellulosicChemicalRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#CellulosicChemicalRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Chemical recycling process for cellulosic textile feedstock, producing cellulosic pulp or another recovered cellulosic feedstock.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Cellulosic chemical recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ChemicalFinishingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ChemicalFinishingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FinishingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Finishing process using chemical substances or treatments to confer or modify functional properties of textile materials or products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Chemical finishing process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Chemical finishing can provide functional properties such as water repellency, flame retardancy, antimicrobial effects or UV protection. The exact relation should be asserted through the chemical role represented in TEXTILE_ASSOCIATED_MATERIALS and through specific durability parameters when known.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#RecyclingProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Recycling process using chemical transformation to recover material from textile products or textile waste.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
