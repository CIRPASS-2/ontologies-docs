    <!-- https://w3id.org/eudpp/textile-process#hasTextualValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/textile-process#hasTextualValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameterSetting"/>
