        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#FibrePreparationProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#FibrePreparationProcess">
