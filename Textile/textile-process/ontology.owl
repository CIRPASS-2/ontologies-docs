        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Dyeing parameter describing the duration of a dyeing process or dyeing step.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Dyeing time</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Expected SI quantity kind: quantities:TIME. Units such as units:second or units:minute may be used.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.6.1, printed pages 144-145, lines 4001-4031; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#EndOfLifeProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#EndOfLifeProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process occurring at or after the end of the use phase of a textile product, including reuse, recycling, incineration or landfilling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">End-of-life process</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, printed page 29, lines 547-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#FabricConstructionParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#FabricConstructionParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#FabricManufacturingParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessTargetSpecification"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process-side parameter describing how a fabric construction is specified or controlled during manufacturing. The resulting observable construction characteristics are represented in TEXTILE_STRUCTURE.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Fabric construction parameter</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This superclass separates fabric-construction process parameters from broader fabric manufacturing parameters and clarifies their relation to fabric-level structural characteristics.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#FabricManufacturingMethodConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#FabricManufacturingMethodConcept">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessMethodConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled value for a fabric manufacturing method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Fabric manufacturing method concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#FabricManufacturingParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#FabricManufacturingParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">This superclass covers process-side parameters used during fabric manufacturing. It should not be used to represent the resulting structural characteristics of the fabric as a product object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <rdfs:label xml:lang="en">Fabric manufacturing parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#FabricManufacturingProcess -->


