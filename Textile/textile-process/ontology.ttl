###  https://w3id.org/eudpp/textile-process#RepairProcess
:RepairProcess rdf:type owl:Class ;
               rdfs:subClassOf :MaintenanceAndRepairProcess ;
               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
               rdfs:comment "Repair can extend the usable lifetime of a textile product, but this module does not import TEXTILE_INDICATOR. Links from repair to product lifetime indicators should be handled in TEXTILE_INDICATOR or in a cross-module relation layer."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
               rdfs:label "Repair process"@en ;
               <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ,
                                                                         <https://w3id.org/eudpp/textile-connector#supportingEvidence> ;
               <https://w3id.org/eudpp/textile-connector#modellingNote> "Repair can extend the usable lifetime of a textile product. Product lifetime indicators are represented in TEXTILE_INDICATOR, and any formal link should be handled there or in a cross-module relation layer."@en ,
                                                                        "This class represents a repair activity or process type. Repairability capability, repair service information and repairability assessment belong to Textile Repairability."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3484; JRC Preparatory Study, Section 13.10.1.5, printed pages 473-474, lines 11273-11326."@en ;
