###  https://w3id.org/eudpp/textile-process#CareMethodConcept
:CareMethodConcept rdf:type owl:Class ;
                   rdfs:subClassOf :ProcessMethodConcept ;
                   <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                   rdfs:comment "SKOS concept used as a controlled value for a textile care method."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                   rdfs:label "Care method concept"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Process modelling pattern for controlled process methods; domain motivation from JRC Section 3.3.1, Table 8 and Annex Table 181"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#CareParameter
:CareParameter rdf:type owl:Class ;
               rdfs:subClassOf :ProcessControlParameter ,
                               :ProcessParameter ;
               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
               rdfs:comment "Process parameter relevant to textile care, including washing, drying, ironing, bleaching, cleaning or storage conditions."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
               rdfs:label "Care parameter"@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3327; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-process#CellulosicChemicalRecyclingProcess
:CellulosicChemicalRecyclingProcess rdf:type owl:Class ;
                                    rdfs:subClassOf :ChemicalRecyclingProcess ;
                                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                    rdfs:comment "Chemical recycling process for cellulosic textile feedstock, producing cellulosic pulp or another recovered cellulosic feedstock."@en ;
                                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                                    rdfs:label "Cellulosic chemical recycling process"@en ;
                                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.5.1, Table 50, printed pages 137-138; table caption at line 3774; supporting discussion on printed page 139, lines 3782-3804."@en ;
                                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-process#ChemicalFinishingProcess
:ChemicalFinishingProcess rdf:type owl:Class ;
                          rdfs:subClassOf :FinishingProcess ;
                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                          rdfs:comment "Finishing process using chemical substances or treatments to confer or modify functional properties of textile materials or products."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                          rdfs:label "Chemical finishing process"@en ;
                          <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ,
                                                                                    <https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence> ;
                          <https://w3id.org/eudpp/textile-connector#modellingNote> "Chemical finishing can provide functional properties such as water repellency, flame retardancy, antimicrobial effects or UV protection. The exact relation should be asserted through the chemical role represented in TEXTILE_ASSOCIATED_MATERIALS and through specific durability parameters when known."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 9.2.1.1, printed page 110, lines 2889-2910; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess
:ChemicalRecyclingProcess rdf:type owl:Class ;
                          rdfs:subClassOf :RecyclingProcess ;
                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                          rdfs:comment "Recycling process using chemical transformation to recover material from textile products or textile waste."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                          rdfs:label "Chemical recycling process"@en ;
                          <https://w3id.org/eudpp/textile-connector#modellingNote> "This class represents a recycling process type. Product recyclability, barriers, compatibility and recyclability assessment belong to the Textile Recyclability module."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


