###  https://w3id.org/eudpp/textile-process#TwistLevel
:TwistLevel rdf:type owl:Class ;
            rdfs:subClassOf :SpinningParameter ;
            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
            rdfs:comment "Spinning parameter describing the degree or level of twist inserted into a yarn."@en ;
            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
            rdfs:label "Twist level"@en ;
            <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
            <https://w3id.org/eudpp/textile-connector#modellingNote> "Twist level may enhance yarn tenacity and pilling resistance, diminish yarn softness and elasticity, and increase spirality. Yarn strength increases with twist to a peak and may then decrease."@en ;
            <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
            <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> <https://w3id.org/eudpp/textile-durability#PillingResistance> ,
                                                                          <https://w3id.org/eudpp/textile-structure#YarnElasticity> ,
                                                                          <https://w3id.org/eudpp/textile-structure#YarnSoftness> ,
                                                                          <https://w3id.org/eudpp/textile-structure#YarnStrength> .


###  https://w3id.org/eudpp/textile-process#TwistNumber
:TwistNumber rdf:type owl:Class ;
             rdfs:subClassOf :SpinningParameter ;
             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
             rdfs:comment "Spinning parameter describing the number of twists inserted into a yarn."@en ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
             rdfs:label "Twist number"@en ;
             <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
             <https://w3id.org/eudpp/textile-connector#modellingNote> "The number of twists is treated as a process parameter closely related to twist level. Its effects are context-dependent and mediated by fibre characteristics."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
