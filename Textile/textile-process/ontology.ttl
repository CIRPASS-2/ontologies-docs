###  https://w3id.org/eudpp/textile-process#WashingProcess
:WashingProcess rdf:type owl:Class ;
                rdfs:subClassOf :UseAndCareProcess ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Care process involving laundering or washing of a textile product."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                rdfs:label "Washing process"@en ;
