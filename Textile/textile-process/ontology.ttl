               <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
               <https://w3id.org/eudpp/textile-connector#modellingNote> "Higher spinning speeds can cause breakages and may negatively influence yarn strength depending on process conditions."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
               <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> <https://w3id.org/eudpp/textile-structure#YarnStrength> .


###  https://w3id.org/eudpp/textile-process#SpinningTension
:SpinningTension rdf:type owl:Class ;
                 rdfs:subClassOf :SpinningParameter ;
                 <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                 rdfs:comment "Spinning parameter describing tension during spinning."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                 rdfs:label "Spinning tension"@en ;
                 <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                 <https://w3id.org/eudpp/textile-connector#modellingNote> "Controlling optimal spinning tension is important for yarn strength and uniformity; uneven tension can cause breakages during subsequent processing."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
