                        rdfs:comment "Product instruction describing recommended textile care operations or conditions, such as washing temperature and cycle, detergent use, drying, ironing, bleaching or professional cleaning."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                        rdfs:label "Textile care instruction"@en ;
