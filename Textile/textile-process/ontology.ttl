@prefix : <https://w3id.org/eudpp/textile-process#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-process#> .

<https://w3id.org/eudpp/textile-process> rdf:type owl:Ontology ;
                                          owl:versionIRI <https://w3id.org/eudpp/textile-process/1.1.2> ;
                                          owl:imports <https://w3id.org/eudpp/textile-associated-materials> ,
                                                      <https://w3id.org/eudpp/textile-connector> ,
                                                      <https://w3id.org/eudpp/textile-core> ,
                                                      <https://w3id.org/eudpp/textile-dpp-mireot> ,
                                                      <https://w3id.org/eudpp/textile-durability> ,
                                                      <https://w3id.org/eudpp/textile-event-mireot> ,
                                                      <https://w3id.org/eudpp/textile-structure> ;
                                          <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Process Ontology. Version 1.1.2."@en ;
                                          <http://purl.org/dc/terms/created> "2026-03-06"^^xsd:date ;
                                          <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                          <http://purl.org/dc/terms/description> "Ontology module for textile process types, concrete process executions, process parameters, target specifications and parameter settings across manufacturing, care, repair and end-of-life stages."@en ;
                                          <http://purl.org/dc/terms/issued> "2026-03-06"^^xsd:date ;
                                          <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                          <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                            <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ;
                                          <http://purl.org/dc/terms/title> "EU DPP Textile Process Ontology"@en ;
                                          <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtprc" ;
                                          <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-process#" ;
                                          rdfs:comment "The module separates process types from concrete executions, parameter types from concrete settings, and process controls from target product specifications. Product characteristics and assessment results remain in their dedicated modules."@en ;
                                          rdfs:label "EU DPP Textile Process Ontology"@en ;
                                          owl:versionInfo "Version 1.1.2" ;
                                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 3.3.1, pages 27-29, Table 8, lines 536-547. JRC Section 9.2.1.1, pages 110-111, lines 2889-2910, Figure 22. JRC Annex 13.10.2, pages 492-493, Table 181, lines 11889-11901. JRC Annex 13.10.2, pages 493-495, Table 182, lines 11902-11920. JRC Section 9.2.2.2, pages 125-126, lines 3296-3327; Annex 13.7.2, pages 394-395, lines 10227-10248. JRC Section 9.2.3.2-9.2.3.3, pages 129-130, lines 3466-3483; Annex 13.10.1.5, pages 473-474, lines 11273-11326. JRC Section 3.3.1, page 29, Table 8, line 547; Annex 13.10.1, pages 481-482, lines 11685-11730."@en ;
                                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#ontologyModule> .

