###  https://w3id.org/eudpp/textile-process#typicallyUsesChemicalFunction
:typicallyUsesChemicalFunction rdf:type owl:AnnotationProperty ;
                               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "Weak annotation relation indicating that a textile process type typically uses a chemical function represented in Textile Associated Materials."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                               rdfs:label "typically uses chemical function"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-process#typicallyUsesChemicalUseCategory
:typicallyUsesChemicalUseCategory rdf:type owl:AnnotationProperty ;
                                  <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                  rdfs:comment "Weak annotation relation indicating that a textile process type typically uses a chemical from a use category represented in Textile Associated Materials."@en ;
                                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                                  rdfs:label "typically uses chemical use category"@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


