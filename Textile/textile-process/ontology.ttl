xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp#hasProperty
<https://w3id.org/eudpp#hasProperty> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp/textile-process#appliesTo
:appliesTo rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :TextileProcess
                                       :TextileProcessExecution
                                     )
                       ] ;
           rdfs:range <https://w3id.org/eudpp/textile-core#TextileProduct> ;
           <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
           rdfs:comment "Relates a textile process type or concrete process execution to a textile product to which it applies, including a product used as a component of another product."@en ;
           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
           rdfs:label "applies to"@en ;
           <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Process participation pattern; domain motivation from JRC Section 3.3.1, Table 8"@en ;
           <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#concernsProduct
:concernsProduct rdf:type owl:ObjectProperty ;
                 owl:inverseOf :hasProcessExecution ;
                 rdfs:domain :TextileProcessExecution ;
                 rdfs:range <https://w3id.org/eudpp/textile-core#TextileProduct> ;
                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                 rdfs:comment "Relates a concrete textile process execution to the textile product that it concerns, including a product used as a component of another product."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                 rdfs:label "concerns product"@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "clearer replacement for the ambiguous local name concerns."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-process#executesProcessType
:executesProcessType rdf:type owl:ObjectProperty ;
                     rdfs:domain :TextileProcessExecution ;
                     rdfs:range :TextileProcess ;
                     <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Relates a concrete textile process execution to the textile process type that it instantiates."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                     rdfs:label "executes process type"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "docs/decisions/TXT-DEC-007.md"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#hasCareInstruction
:hasCareInstruction rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <https://w3id.org/eudpp#hasProperty> ;
                    rdfs:domain <https://w3id.org/eudpp/textile-core#TextileProduct> ;
                    rdfs:range :TextileCareInstruction ;
                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                    rdfs:comment "Relates a textile product to product-specific care instructions."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                    rdfs:label "has care instruction"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 6.3.2, printed page 85, lines 2144-2173; JRC Preparatory Study, Section 13.7.2.8, printed page 404, lines 10440-10458."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-process#hasCategoricalValue
:hasCategoricalValue rdf:type owl:ObjectProperty ;
                     rdfs:domain :ProcessParameterSetting ;
                     rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                     <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Relates a process parameter setting to a controlled SKOS concept used as its categorical value."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                     rdfs:label "has categorical value"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Process value pattern: controlled categorical values are represented as SKOS concepts rather than free text"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#hasEndOfLifeInstruction
:hasEndOfLifeInstruction rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <https://w3id.org/eudpp#hasProperty> ;
                         rdfs:domain <https://w3id.org/eudpp/textile-core#TextileProduct> ;
                         rdfs:range :TextileEndOfLifeInstruction ;
                         <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                           <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ;
                         rdfs:comment "Relates a textile product to product-specific instructions for its end-of-life handling."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                         rdfs:label "has end-of-life instruction"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.3.8, printed page 359, lines 9662-9688; JRC Preparatory Study, Section 6.3.3, printed page 86, lines 2183-2192; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546; JRC DPP Study, Section 7.3, printed page 49, end-of-life treatment information data point."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-process#hasFabricManufacturingMethod
:hasFabricManufacturingMethod rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :hasProcessMethod ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( :FabricManufacturingProcess
                                                          :TextileProcessExecution
                                                        )
                                          ] ;
                              rdfs:range :FabricManufacturingMethodConcept ;
                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                              rdfs:comment "Relates a fabric manufacturing process type or concrete execution to a controlled fabric-manufacturing-method concept."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                              rdfs:label "has fabric manufacturing method"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#hasProcessExecution
:hasProcessExecution rdf:type owl:ObjectProperty ;
                     rdfs:domain <https://w3id.org/eudpp/textile-core#TextileProduct> ;
                     rdfs:range :TextileProcessExecution ;
                     <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Relates a textile product, including a product used as a component of another product, to a concrete process execution applied to it or recorded in its lifecycle."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                     rdfs:label "has process execution"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Process execution pattern; domain motivation from JRC Section 3.3.1, Table 8"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#hasProcessMethod
:hasProcessMethod rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :TextileProcess
                                              :TextileProcessExecution
                                            )
                              ] ;
                  rdfs:range :ProcessMethodConcept ;
                  <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                  rdfs:comment "Relates a textile process type or concrete execution to a controlled SKOS concept identifying the selected process method."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                  rdfs:label "has process method"@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181"@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#hasProcessParameter
:hasProcessParameter rdf:type owl:ObjectProperty ;
                     rdfs:domain :TextileProcess ;
                     rdfs:range :ProcessParameter ;
                     <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Relates a textile process type to a process parameter or target specification relevant to that process type. Concrete executions use txtprc:hasProcessParameterSetting."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                     rdfs:label "has process parameter"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "concrete value belongs to a parameter setting."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-process#hasProcessParameterSetting
:hasProcessParameterSetting rdf:type owl:ObjectProperty ;
                            rdfs:domain :TextileProcessExecution ;
                            rdfs:range :ProcessParameterSetting ;
                            <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                            rdfs:comment "Relates a concrete process execution to a concrete parameter setting used in that execution."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                            rdfs:label "has process parameter setting"@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181"@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#hasQuantitativeValue
:hasQuantitativeValue rdf:type owl:ObjectProperty ;
                      rdfs:domain :ProcessParameterSetting ;
                      rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates a concrete process parameter setting to a quantitative value containing a number, a measurement unit and, when useful, a quantity kind."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                      rdfs:label "has quantitative value"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "docs/decisions/TXT-DEC-003.md"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#hasSpinningMethod
:hasSpinningMethod rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasProcessMethod ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :SpinningProcess
                                               :TextileProcessExecution
                                             )
                               ] ;
                   rdfs:range :SpinningMethodConcept ;
                   <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                   rdfs:comment "Relates a spinning process type or concrete execution to a controlled spinning-method concept."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                   rdfs:label "has spinning method"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#isRepresentedByProductEvent
:isRepresentedByProductEvent rdf:type owl:ObjectProperty ;
                             rdfs:domain :TextileProcessExecution ;
                             rdfs:range <https://w3id.org/eudpp#ProductEvent> ;
                             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                             rdfs:comment "Links a concrete textile process execution to the product event that records or represents it."@en ;
                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                             rdfs:label "is represented by product event"@en ;
                             <https://w3id.org/eudpp/textile-connector#modellingNote> "This bridge does not assert that a process execution is itself an event. It links the execution to an event resource that records or represents it."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-process#parameterOfProcess
:parameterOfProcess rdf:type owl:ObjectProperty ;
                    owl:inverseOf :hasProcessParameter ;
                    rdfs:domain :ProcessParameter ;
                    rdfs:range :TextileProcess ;
                    <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                    rdfs:comment "Relates a process parameter or target specification to the textile process type that it configures or specifies."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                    rdfs:label "parameter of process"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "Inverse of the corrected hasProcessParameter pattern"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-process#producesOutput
:producesOutput rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :TextileProcess
                                            :TextileProcessExecution
                                          )
                            ] ;
                rdfs:range <https://w3id.org/eudpp/textile-core#TextileProduct> ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Relates a textile process type or execution to a textile product produced as an output, including a product that may subsequently be used as a component of another product."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                rdfs:label "produces output"@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#representsProcessExecution
:representsProcessExecution rdf:type owl:ObjectProperty ;
                            owl:inverseOf :isRepresentedByProductEvent ;
                            rdfs:domain <https://w3id.org/eudpp#ProductEvent> ;
                            rdfs:range :TextileProcessExecution ;
                            <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                            rdfs:comment "Links a product event to the textile process execution it records or represents."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                            rdfs:label "represents process execution"@en ;
                            <https://w3id.org/eudpp/textile-connector#modellingNote> "This bridge does not assert that a process execution is itself an event. It links the execution to an event resource that records or represents it."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-process#settingForProcessParameter
:settingForProcessParameter rdf:type owl:ObjectProperty ;
                            rdfs:domain :ProcessParameterSetting ;
                            rdfs:range :ProcessParameter ;
                            <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                            rdfs:comment "Relates a concrete process parameter setting to the parameter type or target specification that it instantiates."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                            rdfs:label "setting for process parameter"@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "Textile Process parameter/method modelling pattern; domain motivation from JRC Table 8 and Table 181"@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#usesChemicalFunction
:usesChemicalFunction rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :TextileProcess
                                                  :TextileProcessExecution
                                                )
                                  ] ;
                      rdfs:range <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept> ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates a textile process type or execution to the technical function of a chemical used in that process."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                      rdfs:label "uses chemical function"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-process#usesChemicalSubstance
:usesChemicalSubstance rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( :TextileProcess
                                                   :TextileProcessExecution
                                                 )
                                   ] ;
                       rdfs:range <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance> ;
                       <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                       rdfs:comment "Relates a textile process type or execution to a specific textile chemical substance used in the process. This does not imply that the substance remains in the final product or is a substance of concern."@en ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                       rdfs:label "uses chemical substance"@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-process#usesChemicalUseCategory
:usesChemicalUseCategory rdf:type owl:ObjectProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :TextileProcess
                                                     :TextileProcessExecution
                                                   )
                                     ] ;
                         rdfs:range <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept> ;
                         <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                         rdfs:comment "Relates a textile process type or execution to the use category of a chemical used in that process, such as process chemical or performance chemical."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                         rdfs:label "uses chemical use category"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-process#usesInput
:usesInput rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :TextileProcess
                                       :TextileProcessExecution
                                     )
                       ] ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( <https://w3id.org/eudpp#MaterialOfComposition>
                                      <https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent>
                                      <https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial>
                                      <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance>
                                      <https://w3id.org/eudpp/textile-core#TextileProduct>
                                    )
                      ] ;
           <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
           rdfs:comment "Relates a textile process type or execution to a textile product, including a product serving an intermediate or component role, or to a material of composition, chemical substance, non-textile component or packaging material used as an input."@en ;
           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
           rdfs:label "uses input"@en ;
           <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
           <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


