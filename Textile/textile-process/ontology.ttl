###  https://w3id.org/eudpp/textile-process#TargetFabricDensity
:TargetFabricDensity rdf:type owl:Class ;
                     rdfs:subClassOf :FabricConstructionParameter ;
                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                     rdfs:comment "A process target specification stating the intended thread or loop density of the resulting fabric."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                     rdfs:label "Target fabric density"@en ;
                     <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric density is related to thread count or loop density. Its effects on breathability, handle and appearance are mediated by fabric type and construction."@en ,
                                                                              "The process-side target remains distinct from the resulting characteristic represented in Textile Structure."@en ,
                                                                              "This class is not declared equivalent to txtstr:ThreadCount. FabricDensity is process-side and may cover thread density, loop density or related construction-density settings; ThreadCount is the structure-side fabric characteristic currently represented in TEXTILE_STRUCTURE."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                     <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> <https://w3id.org/eudpp/textile-structure#FabricAppearance> ,
                                                                                   <https://w3id.org/eudpp/textile-structure#FabricBreathability> ,
                                                                                   <https://w3id.org/eudpp/textile-structure#FabricHandle> .


###  https://w3id.org/eudpp/textile-process#TargetFabricMassPerUnitArea
:TargetFabricMassPerUnitArea rdf:type owl:Class ;
                             rdfs:subClassOf :FabricConstructionParameter ;
                             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                             rdfs:comment "A process target specification stating the intended mass of fabric per unit surface area."@en ;
                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                             rdfs:label "Target fabric mass per unit area"@en ;
                             <https://w3id.org/eudpp/textile-connector#modellingNote> "Expected SI quantity kind: quantities:SUDE (surface density)."@en ,
                                                                                      "Fabric weight is represented here as a process-side target or parameter. The influence annotations point to structure-side fabric characteristics rather than merging both concepts."@en ,
                                                                                      "The process-side target remains distinct from the resulting characteristic represented in Textile Structure."@en ,
                                                                                      "This class is not declared equivalent to txtstr:FabricMassPerUnitArea, because this module represents the process-side parameter or target setting, whereas TEXTILE_STRUCTURE represents the resulting fabric characteristic."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.2, printed pages 493-495, lines 11902-11920; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                             <https://w3id.org/eudpp/textile-connector#typicalInfluenceOn> <https://w3id.org/eudpp/textile-structure#FabricBreathability> ,
                                                                                           <https://w3id.org/eudpp/textile-structure#FabricDrape> ,
                                                                                           <https://w3id.org/eudpp/textile-structure#FabricInsulation> .


