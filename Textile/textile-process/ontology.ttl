###  https://w3id.org/eudpp/textile-process#TextileEndOfLifeInstruction
:TextileEndOfLifeInstruction rdf:type owl:Class ;
                             rdfs:subClassOf <https://w3id.org/eudpp#DocumentFormattedProperty> ;
                             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                               <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ;
                             rdfs:comment "Product instruction supporting appropriate end-of-life handling of a textile product, including collection, sorting, preparation for reuse, material separation, recycling or another stated waste-management route."@en ;
                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-process> ;
                             rdfs:label "Textile end-of-life instruction"@en ;
