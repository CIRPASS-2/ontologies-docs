}, {
  "@id" : "https://w3id.org/eudpp/textile-process#ChemicalFinishingProcess",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Finishing process using chemical substances or treatments to confer or modify functional properties of textile materials or products."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-process"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Chemical finishing process"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-process#FinishingProcess"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Chemical finishing can provide functional properties such as water repellency, flame retardancy, antimicrobial effects or UV protection. The exact relation should be asserted through the chemical role represented in TEXTILE_ASSOCIATED_MATERIALS and through specific durability parameters when known."
  } ],
