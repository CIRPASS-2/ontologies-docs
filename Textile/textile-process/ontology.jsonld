  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "The JRC identifies weave pattern as one of the weaving parameters affecting fabric characteristics. The relation is represented as weak influence annotations rather than as deterministic OWL axioms."
  }, {
    "@language" : "en",
    "@value" : "The process-side target remains distinct from the resulting characteristic represented in Textile Structure."
  }, {
    "@language" : "en",
    "@value" : "Weave pattern is a fabric construction parameter that may affect visual appearance, permeability, drape and handle. The relation is represented as weak influence because the direction depends on the specific weave and yarns."
  } ],
