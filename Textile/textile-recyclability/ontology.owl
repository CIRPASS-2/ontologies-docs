    <!-- https://w3id.org/eudpp/textile-recyclability#recyclingInformationAvailabilityCriterion -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-recyclability#recyclingInformationAvailabilityCriterion">
