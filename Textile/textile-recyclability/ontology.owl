        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has recycled content mass fraction value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Study on DPP content for textile apparel products under ESPR, page 51, lines 2218-2233; JRC 3rd Milestone working document, page 194</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecycledContentSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecycledContentSource">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentDeclaration"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a recycled-content declaration to a controlled post-industrial, pre-consumer or post-consumer source category defined by the stated methodology.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has recycled content source</rdfs:label>
