    <!-- https://w3id.org/eudpp/textile-recyclability#routeSpecificCriterion -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-recyclability#routeSpecificCriterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
