        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has recycling yield value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasReferenceProductMassValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasReferenceProductMassValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentDeclaration"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <rdfs:comment xml:lang="en">Relates a recycled-content declaration to the reference product mass, excluding trims where the applicable method requires this basis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has reference product mass value</rdfs:label>
