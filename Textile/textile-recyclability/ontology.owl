    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecycledContentDeclaration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecycledContentDeclaration">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
