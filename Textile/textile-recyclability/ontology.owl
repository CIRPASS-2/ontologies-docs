        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecycledContentTechnologyLevel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecycledContentTechnologyLevel">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessmentResult"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Classifies a recycled-content assessment result using the shared product-technology-level vocabulary defined in Textile Connector.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has recycled content technology level</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecycledMaterialMassValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecycledMaterialMassValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentDeclaration"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <rdfs:comment xml:lang="en">Relates a recycled-content declaration to the absolute mass of recycled material included in the product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has recycled material mass value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC DPP Study, Section 7.4, printed page 54, data point “Amount of recycled material”.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecyclingLoop -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecyclingLoop">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentResult"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclingRoute"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingLoopConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a route, assessment result or event to the intended material-loop destination.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has recycling loop</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecyclingYieldResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecyclingYieldResult">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingYieldResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
