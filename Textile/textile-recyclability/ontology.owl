    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#postIndustrialTextileWaste -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-recyclability#postIndustrialTextileWaste">
