    <!-- https://w3id.org/eudpp/textile-recyclability#disruptiveElementAbsenceCriterion -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-recyclability#disruptiveElementAbsenceCriterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
