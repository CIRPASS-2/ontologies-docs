    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#hasProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasProperty"/>
    


    <!-- https://w3id.org/eudpp/textile-assessment#assessesProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#assessesProduct"/>
    


    <!-- https://w3id.org/eudpp/textile-indicator#hasCategoricalValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-indicator#hasCategoricalValue"/>
    


    <!-- https://w3id.org/eudpp/textile-process#executesProcessType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-process#executesProcessType"/>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#appliesSortingCriterion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#appliesSortingCriterion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingForRecyclingProcess"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingCriterionConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a sorting-for-recycling process to a criterion applied during sorting.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">applies sorting criterion</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#assessesRecyclabilityOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#assessesRecyclabilityOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-assessment#assessesProduct"/>
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#hasRecyclabilityAssessment"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a recyclability assessment execution specifically to the product whose recyclability it assesses.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">assesses recyclability of</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#assessesRecyclingRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#assessesRecyclingRoute">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingRoute"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a recyclability assessment to a recycling route evaluated by that assessment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">assesses recycling route</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#awardsScoreValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#awardsScoreValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringRule"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a recyclability scoring rule to the dimensionless quantitative score value awarded when the rule is satisfied.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">awards score value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 11.1.2.1, Table 76, pages 190-191.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#barrierAppliesToRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#barrierAppliesToRoute">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrier"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingRoute"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a recyclability barrier to the recycling route it hinders.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">barrier applies to route</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#evaluatesCriterion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#evaluatesCriterion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionResult"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a criterion result to the controlled criterion it evaluates.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">evaluates criterion</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#followsRecyclingRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#followsRecyclingRoute">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingRoute"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an actual textile recycling event to the route it follows.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">follows recycling route</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasBarrierType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasBarrierType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrier"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Classifies a recyclability barrier using a controlled barrier concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has barrier type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasCriterionOutcome -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasCriterionOutcome">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionResult"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityOutcomeConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a criterion result to its controlled assessment outcome.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has criterion outcome</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasCriterionResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasCriterionResult">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentResult"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an aggregate recyclability result to an outcome for one evaluated criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has criterion result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasMaximumScoreValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasMaximumScoreValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a recyclability scoring method to the maximum dimensionless score value defined by that method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has maximum score value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">candidate JRC DO2 scale in Section 11.1.2.1, pages 190-191.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasMinimumScoreValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasMinimumScoreValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a recyclability scoring method to the minimum dimensionless score value defined by that method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has minimum score value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">candidate JRC DO2 scale in Section 11.1.2.1, pages 190-191.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecoveredMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecoveredMaterial">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecoveredTextileMaterial"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an actual textile recycling event to material recovered as an output.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has recovered material</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecoveredMaterialQualityResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecoveredMaterialQualityResult">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentResult"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecoveredMaterialQualityResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an assessment or recycling result to a quality result for the recovered material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">has recovered material quality result</rdfs:label>
