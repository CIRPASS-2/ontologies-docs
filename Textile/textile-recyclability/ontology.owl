        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#hasRecycledContentMassFractionValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecycledContentMassFractionValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentDeclaration"/>
