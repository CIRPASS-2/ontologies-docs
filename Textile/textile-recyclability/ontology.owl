    <!-- https://w3id.org/eudpp/textile-recyclability#hasWasteSourceType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-recyclability#hasWasteSourceType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileWaste"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile waste resource to the lifecycle-stage category in which it became waste.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
