    <!-- https://w3id.org/eudpp/textile-recyclability#elastaneProportionCriterion -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-recyclability#elastaneProportionCriterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
