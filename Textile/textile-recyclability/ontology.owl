    <!-- https://w3id.org/eudpp/textile-recyclability#ChainOfCustodyVerificationMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#ChainOfCustodyVerificationMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Third-party verification method relying on chain-of-custody tracking of recycled material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Chain-of-custody verification method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#ChemicalRecyclingRoute -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#ChemicalRecyclingRoute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingRoute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-recyclability#usesRecyclingProcessType"/>
                <owl:hasValue rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Recycling route whose principal recycling stage chemically transforms textile inputs to recover polymeric, cellulosic or other material feedstock.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Chemical recycling route</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#CollectionForRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#CollectionForRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">End-of-life process in which discarded textile products are collected for potential sorting, preparation and recycling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Collection for recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#CollectionSchemeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#CollectionSchemeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used to classify an arrangement for collecting textile waste.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Collection scheme concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, pages 135-136.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#ManufacturerDeclarationVerificationMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#ManufacturerDeclarationVerificationMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Verification method based on a declaration made by the manufacturer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Manufacturer-declaration verification method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#MechanicalRecyclingRoute -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#MechanicalRecyclingRoute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingRoute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-recyclability#usesRecyclingProcessType"/>
                <owl:hasValue rdf:resource="https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Recycling route whose principal recycling stage mechanically transforms textile inputs into reusable fibres or materials.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Mechanical recycling route</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used to classify a technique that prepares textile waste for a recycling process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Pre-treatment technique concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, page 137.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#PreparationForRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#PreparationForRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">End-of-life process that prepares a textile product or material for recycling, including removal, cleaning, cutting, opening or other pre-treatment required by a route.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Preparation for recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecoveredMaterialQualityResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecoveredMaterialQualityResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment result describing whether recovered textile material meets stated quality requirements for a target use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recovered material quality result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecoveredTextileMaterial -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecoveredTextileMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Material output recovered from an actual textile recycling process and potentially usable as input to another production process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recovered textile material</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#Recyclability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#Recyclability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContent"/>
        <terms:relation rdf:resource="https://w3id.org/eudpp#RecoverableRate"/>
        <terms:relation rdf:resource="https://w3id.org/eudpp#RecyclingRate"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Potential of a textile product, under a specified collection, sorting, preparation and recycling context, to provide fibre or material feedstock usable in one or more recycling routes without disruptive elements or substances.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessment"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Concrete execution of a recyclability assessment method on a specified textile product for stated recycling routes and conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability assessment</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Reusable procedure for evaluating textile-product recyclability against stated criteria, assumed system conditions and one or more recycling routes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability assessment method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
        <owl:disjointWith rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessmentResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Result produced by a recyclability assessment, reporting route-specific criterion outcomes, barriers, recyclable fraction, score or label when applicable.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability assessment result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrier -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentElement"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Product, material, substance, information or system condition that hinders collection, sorting, preparation, recycling or the use and quality of recovered material for a specified route.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability barrier</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept classifying a recyclability barrier.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability barrier type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept identifying a criterion used in a recyclability assessment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability criterion concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment result reporting the outcome of one controlled recyclability criterion for a product and, where relevant, a specified recycling route.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability criterion result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled categorical label used by a specified recyclability scoring method.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability label concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityOutcomeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityOutcomeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept expressing the outcome of a recyclability criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability outcome concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityScore -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScore">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Method-specific indicator calculated from stated recyclability criteria and assumptions. A score does not by itself prove that a product will be collected or recycled in practice.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability score</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5392-5443; Table 76, printed page 191; JRC DPP Study, Section 7.3, printed page 49, data point “Recyclability score”.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment method that combines criterion outcomes into a method-specific recyclability score or label. It is not a universal regulatory scoring formula.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability scoring method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5402-5443; Table 76, printed page 191, caption line 5441.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringRule -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringRule">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Rule belonging to a recyclability scoring method and assigning a quantitative point value to a stated criterion under stated route or threshold conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability scoring rule</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">domain evidence from JRC Section 11.1.2.1, Table 76, pages 190-191.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Product aspect describing the proportion by mass of recycled fibres from post-industrial, pre-consumer or post-consumer waste in a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5, printed page 134, lines 3666-3675; Section 9.2.5.4, printed page 143, lines 3957-3961.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment execution that verifies or evaluates a recycled-content declaration for a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content assessment</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3982.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessmentResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessmentResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment result reporting the outcome of verifying or evaluating a recycled-content declaration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content assessment result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Sections 9.2.5.4-9.2.5.5, pages 143-144.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentDeclaration -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentDeclaration">
        <terms:relation rdf:resource="https://w3id.org/eudpp#RecycledMaterialsUse"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Declaration reporting the mass fraction of recycled material in a textile product or material. Recycled content is related to, but distinct from, recyclability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content declaration</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC DPP Study, Section 7.3, printed page 50, data point “Recycled content”.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentPerformanceThreshold -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentPerformanceThreshold">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#PerformanceThreshold"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Performance threshold defining a minimum recycled-content value for a stated product, fibre or source context. Candidate values proposed in the JRC design option remain assessment data rather than universal OWL axioms.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content performance threshold</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.3, printed page 194, lines 5496-5503; JRC Preparatory Study, Section 11.1.3.1, printed page 194, lines 5504-5519.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept identifying the lifecycle source category of recycled content, including post-industrial, pre-consumer and post-consumer material. The declaration or method must state the definition framework used because ISO and ESPR terminology are not fully aligned.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content source concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC DPP Study, Section 7.3, printed page 50, data point “Origin of the recycled content”.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment method used to verify a recycled-content declaration where no direct laboratory determination of recycled versus virgin fibre origin is available at scale.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled content verification method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecycledTextileFibre -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledTextileFibre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileFibre"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecoveredTextileMaterial"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Recovered textile material represented as a textile fibre suitable, subject to quality and process requirements, for use in textile products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycled textile fibre</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclingLoopConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclingLoopConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled concept identifying the intended material-loop destination of a recycling route.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycling loop concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclingRoute -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclingRoute">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Specified sequence or configuration of collection, sorting, preparation and recycling stages used as the context for a recyclability assessment or actual recycling operation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycling route</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclingYieldResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclingYieldResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Assessment result reporting the mass fraction or other stated yield of recovered material produced by an actual or modelled recycling operation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recycling yield result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#SortingCriterionConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#SortingCriterionConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used to classify a criterion applied during sorting for recycling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Sorting criterion concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, pages 136-137.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#SortingForRecyclingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#SortingForRecyclingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">End-of-life process in which collected textile products or materials are segregated into streams suitable for subsequent recycling routes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Sorting for recycling process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#SortingTechniqueConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#SortingTechniqueConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">SKOS concept used to classify a textile sorting technique.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Sorting technique concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, page 137.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#TextileChemicalRecyclingEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileChemicalRecyclingEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-process#executesProcessType"/>
                <owl:hasValue rdf:resource="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Textile recycling event executing the chemical recycling process type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Textile chemical recycling event</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#TextileMechanicalRecyclingEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileMechanicalRecyclingEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-process#executesProcessType"/>
                <owl:hasValue rdf:resource="https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Textile recycling event executing the mechanical recycling process type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Textile mechanical recycling event</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Concrete textile recycling occurrence represented both as a product event and as a textile process execution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Textile recycling event</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">EU DPP EVENT module: dpp:ProductEvent.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#TextileWaste -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileWaste">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile product that the holder discards, intends to discard or is required to discard.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Textile waste</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">TextileWaste represents a textile product in a waste status. The generation-stage category is supplied separately through hasWasteSourceType.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 15, lines 188-212; JRC Preparatory Study, Section 9.2.4, printed page 130, lines 3487-3509.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled concept classifying textile waste according to the lifecycle stage at which it became waste.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Textile waste source concept</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This vocabulary classifies a concrete waste resource and is distinct from RecycledContentSourceConcept, which classifies the declared origin of material already incorporated as recycled content.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 15, lines 188-212; JRC Preparatory Study, Section 9.2.4, printed page 130, lines 3487-3509.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess"/>
    


    <!-- https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess"/>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#CollectionScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-recyclability#CollectionScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled vocabulary of collection schemes for textile waste.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Collection scheme</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#dropOffCollectionScheme"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#pickUpCollectionScheme"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#takeBackCollectionScheme"/>
        <skos:prefLabel xml:lang="en">Collection scheme</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, printed page 135, lines 3705-3712.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled vocabulary of techniques used to prepare textile waste for recycling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Pre-treatment technique scheme</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#disassemblyPreTreatment"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#manualSeparationPreTreatment"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#mechanicalSeparationPreTreatment"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#shreddingPreTreatment"/>
        <skos:prefLabel xml:lang="en">Pre-treatment technique scheme</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.5.1, printed pages 136-137, lines 3753-3760; Table 50, printed pages 137-138, caption at line 3774.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled vocabulary for recyclability barrier type scheme.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <rdfs:label xml:lang="en">Recyclability barrier type scheme</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#chemicalFinishBarrier"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#coatingBarrier"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#collectionOrSortingSystemBarrier"/>
