<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/textile-recyclability#"
     xml:base="https://w3id.org/eudpp/textile-recyclability"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:textile-connector="https://w3id.org/eudpp/textile-connector#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-recyclability">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-recyclability/1.1.2"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-event-mireot"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Textile Recyclability Ontology. Version 1.1.2.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-09</terms:created>
        <terms:creator xml:lang="en">Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Ontology module for route-specific textile recyclability, assessment criteria and results, barriers, scores and labels, actual recycling events, recovered materials, textile waste categories, recycling yield and recycled-content declarations.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-09</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <terms:title xml:lang="en">EU DPP Textile Recyclability Ontology</terms:title>
        <vann:preferredNamespacePrefix>txtrec</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-recyclability#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Recyclability is represented as route-specific potential assessed under stated collection, sorting, preparation and recycling conditions. It must not be inferred from a universal boolean.</rdfs:comment>
        <rdfs:comment xml:lang="en">Recycled content is represented separately from recyclability: a product can contain recycled material without being recyclable through a given route, and a recyclable product may contain no recycled material.</rdfs:comment>
        <rdfs:comment xml:lang="en">Scores and labels are method-specific and do not constitute adopted regulatory classifications unless a future delegated act or standard defines them.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Textile Recyclability Ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:Ontology>
    


