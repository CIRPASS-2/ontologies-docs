  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Recyclability Ontology. Version 1.1.2."
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-09"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@language" : "en",
    "@value" : "Elio Hbeich"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Ontology module for route-specific textile recyclability, assessment criteria and results, barriers, scores and labels, actual recycling events, recovered materials, textile waste categories, recycling yield and recycled-content declarations."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-09"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-16"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  }, {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Recyclability Ontology"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "txtrec"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/eudpp/textile-recyclability#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Recyclability is represented as route-specific potential assessed under stated collection, sorting, preparation and recycling conditions. It must not be inferred from a universal boolean."
  }, {
    "@language" : "en",
    "@value" : "Recycled content is represented separately from recyclability: a product can contain recycled material without being recyclable through a given route, and a recyclable product may contain no recycled material."
  }, {
    "@language" : "en",
    "@value" : "Scores and labels are method-specific and do not constitute adopted regulatory classifications unless a future delegated act or standard defines them."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Recyclability Ontology"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "https://w3id.org/eudpp/textile-assessment"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-associated-materials"
