###  https://w3id.org/eudpp/textile-recyclability#RecyclingRoute
:RecyclingRoute rdf:type owl:Class ;
                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                rdfs:comment "Specified sequence or configuration of collection, sorting, preparation and recycling stages used as the context for a recyclability assessment or actual recycling operation."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                rdfs:label "Recycling route"@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclingYieldResult
:RecyclingYieldResult rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentResult> ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Assessment result reporting the mass fraction or other stated yield of recovered material produced by an actual or modelled recycling operation."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                      rdfs:label "Recycling yield result"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#SortingCriterionConcept
:SortingCriterionConcept rdf:type owl:Class ;
                         rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                         <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                         rdfs:comment "SKOS concept used to classify a criterion applied during sorting for recycling."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                         rdfs:label "Sorting criterion concept"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.5.1, pages 136-137."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#SortingForRecyclingProcess
:SortingForRecyclingProcess rdf:type owl:Class ;
                            rdfs:subClassOf <https://w3id.org/eudpp/textile-process#EndOfLifeProcess> ;
                            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                              <https://w3id.org/eudpp/textile-ontology> ;
                            rdfs:comment "End-of-life process in which collected textile products or materials are segregated into streams suitable for subsequent recycling routes."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                            rdfs:label "Sorting for recycling process"@en ;
