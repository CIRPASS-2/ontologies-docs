#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp#hasProperty
<https://w3id.org/eudpp#hasProperty> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp/textile-assessment#assessesProduct
<https://w3id.org/eudpp/textile-assessment#assessesProduct> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp/textile-indicator#hasCategoricalValue
<https://w3id.org/eudpp/textile-indicator#hasCategoricalValue> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp/textile-process#executesProcessType
<https://w3id.org/eudpp/textile-process#executesProcessType> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp/textile-recyclability#appliesSortingCriterion
:appliesSortingCriterion rdf:type owl:ObjectProperty ;
                         rdfs:domain :SortingForRecyclingProcess ;
                         rdfs:range :SortingCriterionConcept ;
                         <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                         rdfs:comment "Relates a sorting-for-recycling process to a criterion applied during sorting."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                         rdfs:label "applies sorting criterion"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-recyclability#assessesRecyclabilityOf
:assessesRecyclabilityOf rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <https://w3id.org/eudpp/textile-assessment#assessesProduct> ;
                         owl:inverseOf :hasRecyclabilityAssessment ;
                         rdfs:domain :RecyclabilityAssessment ;
                         rdfs:range <https://w3id.org/eudpp#Product> ;
                         <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                         rdfs:comment "Relates a recyclability assessment execution specifically to the product whose recyclability it assesses."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                         rdfs:label "assesses recyclability of"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#assessesRecyclingRoute
:assessesRecyclingRoute rdf:type owl:ObjectProperty ;
                        rdfs:domain :RecyclabilityAssessment ;
                        rdfs:range :RecyclingRoute ;
                        <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Relates a recyclability assessment to a recycling route evaluated by that assessment."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                        rdfs:label "assesses recycling route"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#awardsScoreValue
:awardsScoreValue rdf:type owl:ObjectProperty ;
                  rdfs:domain :RecyclabilityScoringRule ;
                  rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                  <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                  rdfs:comment "Relates a recyclability scoring rule to the dimensionless quantitative score value awarded when the rule is satisfied."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                  rdfs:label "awards score value"@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 11.1.2.1, Table 76, pages 190-191."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#barrierAppliesToRoute
:barrierAppliesToRoute rdf:type owl:ObjectProperty ;
                       rdfs:domain :RecyclabilityBarrier ;
                       rdfs:range :RecyclingRoute ;
                       <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                       rdfs:comment "Relates a recyclability barrier to the recycling route it hinders."@en ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                       rdfs:label "barrier applies to route"@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#evaluatesCriterion
:evaluatesCriterion rdf:type owl:ObjectProperty ;
                    rdfs:domain :RecyclabilityCriterionResult ;
                    rdfs:range :RecyclabilityCriterionConcept ;
                    <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                    rdfs:comment "Relates a criterion result to the controlled criterion it evaluates."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                    rdfs:label "evaluates criterion"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#followsRecyclingRoute
:followsRecyclingRoute rdf:type owl:ObjectProperty ;
                       rdfs:domain :TextileRecyclingEvent ;
                       rdfs:range :RecyclingRoute ;
                       <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                       rdfs:comment "Relates an actual textile recycling event to the route it follows."@en ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                       rdfs:label "follows recycling route"@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#hasBarrierType
:hasBarrierType rdf:type owl:ObjectProperty ;
                rdfs:domain :RecyclabilityBarrier ;
                rdfs:range :RecyclabilityBarrierTypeConcept ;
                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                rdfs:comment "Classifies a recyclability barrier using a controlled barrier concept."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                rdfs:label "has barrier type"@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#hasCriterionOutcome
:hasCriterionOutcome rdf:type owl:ObjectProperty ;
                     rdfs:domain :RecyclabilityCriterionResult ;
                     rdfs:range :RecyclabilityOutcomeConcept ;
                     <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Relates a criterion result to its controlled assessment outcome."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                     rdfs:label "has criterion outcome"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#hasCriterionResult
:hasCriterionResult rdf:type owl:ObjectProperty ;
                    rdfs:domain :RecyclabilityAssessmentResult ;
                    rdfs:range :RecyclabilityCriterionResult ;
                    <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                    rdfs:comment "Relates an aggregate recyclability result to an outcome for one evaluated criterion."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                    rdfs:label "has criterion result"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#hasMaximumScoreValue
:hasMaximumScoreValue rdf:type owl:ObjectProperty ;
                      rdfs:domain :RecyclabilityScoringMethod ;
                      rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates a recyclability scoring method to the maximum dimensionless score value defined by that method."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                      rdfs:label "has maximum score value"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "candidate JRC DO2 scale in Section 11.1.2.1, pages 190-191."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#hasMinimumScoreValue
:hasMinimumScoreValue rdf:type owl:ObjectProperty ;
                      rdfs:domain :RecyclabilityScoringMethod ;
                      rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates a recyclability scoring method to the minimum dimensionless score value defined by that method."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                      rdfs:label "has minimum score value"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "candidate JRC DO2 scale in Section 11.1.2.1, pages 190-191."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#hasRecoveredMaterial
:hasRecoveredMaterial rdf:type owl:ObjectProperty ;
                      rdfs:domain :TextileRecyclingEvent ;
                      rdfs:range :RecoveredTextileMaterial ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates an actual textile recycling event to material recovered as an output."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                      rdfs:label "has recovered material"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#hasRecoveredMaterialQualityResult
:hasRecoveredMaterialQualityResult rdf:type owl:ObjectProperty ;
                                   rdfs:domain [ rdf:type owl:Class ;
                                                 owl:unionOf ( :RecyclabilityAssessmentResult
                                                               :TextileRecyclingEvent
                                                             )
                                               ] ;
                                   rdfs:range :RecoveredMaterialQualityResult ;
                                   <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                   rdfs:comment "Relates an assessment or recycling result to a quality result for the recovered material."@en ;
                                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                                   rdfs:label "has recovered material quality result"@en ;
                                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#hasRecyclabilityAspect
:hasRecyclabilityAspect rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <https://w3id.org/eudpp#hasProperty> ;
                        rdfs:domain <https://w3id.org/eudpp#Product> ;
                        rdfs:range :Recyclability ;
                        <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                          <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Relates a product to its recyclability product aspect."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                        rdfs:label "has recyclability aspect"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-recyclability#hasRecyclabilityAssessment
:hasRecyclabilityAssessment rdf:type owl:ObjectProperty ;
                            rdfs:domain <https://w3id.org/eudpp#Product> ;
                            rdfs:range :RecyclabilityAssessment ;
                            <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                            rdfs:comment "Relates a product to a concrete recyclability assessment performed on it."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                            rdfs:label "has recyclability assessment"@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#hasRecyclabilityBarrier
:hasRecyclabilityBarrier rdf:type owl:ObjectProperty ;
                         rdfs:domain :RecyclabilityAssessmentResult ;
                         rdfs:range :RecyclabilityBarrier ;
                         <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                           <https://w3id.org/eudpp/textile-ontology> ;
                         rdfs:comment "Relates a route-specific assessment result to a barrier identified during the assessment."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                         rdfs:label "has recyclability barrier"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-recyclability#hasRecyclabilityLabel
:hasRecyclabilityLabel rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <https://w3id.org/eudpp/textile-indicator#hasCategoricalValue> ;
                       rdfs:domain :RecyclabilityScore ;
                       rdfs:range :RecyclabilityLabelConcept ;
                       <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                         <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ,
                                                         <https://w3id.org/eudpp/textile-ontology> ;
                       rdfs:comment "Relates a recyclability score to a controlled method-specific label."@en ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                       rdfs:label "has recyclability label"@en ;
