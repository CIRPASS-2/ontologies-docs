@prefix : <https://w3id.org/eudpp/textile-recyclability#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-recyclability#> .

<https://w3id.org/eudpp/textile-recyclability> rdf:type owl:Ontology ;
                                                owl:versionIRI <https://w3id.org/eudpp/textile-recyclability/1.1.2> ;
                                                owl:imports <https://w3id.org/eudpp/textile-assessment> ,
                                                            <https://w3id.org/eudpp/textile-associated-materials> ,
                                                            <https://w3id.org/eudpp/textile-connector> ,
                                                            <https://w3id.org/eudpp/textile-core> ,
                                                            <https://w3id.org/eudpp/textile-dpp-mireot> ,
                                                            <https://w3id.org/eudpp/textile-event-mireot> ,
                                                            <https://w3id.org/eudpp/textile-indicator> ,
                                                            <https://w3id.org/eudpp/textile-process> ,
                                                            <https://w3id.org/eudpp/textile-soc> ;
                                                <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Recyclability Ontology. Version 1.1.2."@en ;
                                                <http://purl.org/dc/terms/created> "2026-07-09"^^xsd:date ;
                                                <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                                <http://purl.org/dc/terms/description> "Ontology module for route-specific textile recyclability, assessment criteria and results, barriers, scores and labels, actual recycling events, recovered materials, textile waste categories, recycling yield and recycled-content declarations."@en ;
                                                <http://purl.org/dc/terms/issued> "2026-07-09"^^xsd:date ;
                                                <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                                  <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ,
                                                                                  <https://w3id.org/eudpp/textile-ontology> ;
                                                <http://purl.org/dc/terms/title> "EU DPP Textile Recyclability Ontology"@en ;
                                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtrec" ;
                                                <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-recyclability#" ;
                                                rdfs:comment "Recyclability is represented as route-specific potential assessed under stated collection, sorting, preparation and recycling conditions. It must not be inferred from a universal boolean."@en ,
                                                             "Recycled content is represented separately from recyclability: a product can contain recycled material without being recyclable through a given route, and a recyclable product may contain no recycled material."@en ,
                                                             "Scores and labels are method-specific and do not constitute adopted regulatory classifications unless a future delegated act or standard defines them."@en ;
                                                rdfs:label "EU DPP Textile Recyclability Ontology"@en ;
                                                owl:versionInfo "Version 1.1.2" ;
                                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .

