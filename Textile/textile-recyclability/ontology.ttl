:usesCollectionScheme rdf:type owl:ObjectProperty ;
                      rdfs:domain :CollectionForRecyclingProcess ;
                      rdfs:range :CollectionSchemeConcept ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates a collection-for-recycling process type or configuration to the collection scheme it uses."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                      rdfs:label "uses collection scheme"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-recyclability#usesPreTreatmentTechnique
:usesPreTreatmentTechnique rdf:type owl:ObjectProperty ;
                           rdfs:domain :PreparationForRecyclingProcess ;
                           rdfs:range :PreTreatmentTechniqueConcept ;
                           <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                           rdfs:comment "Relates a preparation-for-recycling process to the pre-treatment technique it uses."@en ;
                           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                           rdfs:label "uses pre-treatment technique"@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-recyclability#usesRecyclingProcessType
:usesRecyclingProcessType rdf:type owl:ObjectProperty ;
                          rdfs:domain :RecyclingRoute ;
                          rdfs:range <https://w3id.org/eudpp/textile-process#RecyclingProcess> ;
                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                            <https://w3id.org/eudpp/textile-ontology> ;
                          rdfs:comment "Relates a recycling route to its principal recycling process type."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                          rdfs:label "uses recycling process type"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-recyclability#usesSortingTechnique
:usesSortingTechnique rdf:type owl:ObjectProperty ;
                      rdfs:domain :SortingForRecyclingProcess ;
                      rdfs:range :SortingTechniqueConcept ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates a sorting-for-recycling process to the sorting technique it uses."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                      rdfs:label "uses sorting technique"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-recyclability#verifiesRecycledContentDeclaration
:verifiesRecycledContentDeclaration rdf:type owl:ObjectProperty ;
                                    rdfs:domain :RecycledContentAssessmentResult ;
                                    rdfs:range :RecycledContentDeclaration ;
                                    <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                    rdfs:comment "Relates a recycled-content assessment result to the declaration that it verifies."@en ;
                                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                                    rdfs:label "verifies recycled content declaration"@en ;
                                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


