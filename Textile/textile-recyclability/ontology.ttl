###  https://w3id.org/eudpp/textile-recyclability#ChainOfCustodyVerificationMethod
:ChainOfCustodyVerificationMethod rdf:type owl:Class ;
                                  rdfs:subClassOf :RecycledContentVerificationMethod ;
                                  <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                  rdfs:comment "Third-party verification method relying on chain-of-custody tracking of recycled material."@en ;
                                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                                  rdfs:label "Chain-of-custody verification method"@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974."@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#ChemicalRecyclingRoute
:ChemicalRecyclingRoute rdf:type owl:Class ;
                        rdfs:subClassOf :RecyclingRoute ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :usesRecyclingProcessType ;
                                          owl:hasValue <https://w3id.org/eudpp/textile-process#ChemicalRecyclingProcess>
                                        ] ;
                        <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                          <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Recycling route whose principal recycling stage chemically transforms textile inputs to recover polymeric, cellulosic or other material feedstock."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                        rdfs:label "Chemical recycling route"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#CollectionForRecyclingProcess
:CollectionForRecyclingProcess rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/eudpp/textile-process#EndOfLifeProcess> ;
                               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                 <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "End-of-life process in which discarded textile products are collected for potential sorting, preparation and recycling."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                               rdfs:label "Collection for recycling process"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#CollectionSchemeConcept
:CollectionSchemeConcept rdf:type owl:Class ;
                         rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                         <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                         rdfs:comment "SKOS concept used to classify an arrangement for collecting textile waste."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                         rdfs:label "Collection scheme concept"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.5.1, pages 135-136."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#ManufacturerDeclarationVerificationMethod
:ManufacturerDeclarationVerificationMethod rdf:type owl:Class ;
                                           rdfs:subClassOf :RecycledContentVerificationMethod ;
                                           <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                           rdfs:comment "Verification method based on a declaration made by the manufacturer."@en ;
                                           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                                           rdfs:label "Manufacturer-declaration verification method"@en ;
                                           <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974."@en ;
                                           <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#MechanicalRecyclingRoute
:MechanicalRecyclingRoute rdf:type owl:Class ;
                          rdfs:subClassOf :RecyclingRoute ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :usesRecyclingProcessType ;
                                            owl:hasValue <https://w3id.org/eudpp/textile-process#MechanicalRecyclingProcess>
                                          ] ;
                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                            <https://w3id.org/eudpp/textile-ontology> ;
                          rdfs:comment "Recycling route whose principal recycling stage mechanically transforms textile inputs into reusable fibres or materials."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                          rdfs:label "Mechanical recycling route"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueConcept
:PreTreatmentTechniqueConcept rdf:type owl:Class ;
                              rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                              rdfs:comment "SKOS concept used to classify a technique that prepares textile waste for a recycling process."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                              rdfs:label "Pre-treatment technique concept"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.5.1, page 137."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#PreparationForRecyclingProcess
:PreparationForRecyclingProcess rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/eudpp/textile-process#EndOfLifeProcess> ;
                                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                  <https://w3id.org/eudpp/textile-ontology> ;
                                rdfs:comment "End-of-life process that prepares a textile product or material for recycling, including removal, cleaning, cutting, opening or other pre-treatment required by a route."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                                rdfs:label "Preparation for recycling process"@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecoveredMaterialQualityResult
:RecoveredMaterialQualityResult rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentResult> ;
                                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                rdfs:comment "Assessment result describing whether recovered textile material meets stated quality requirements for a target use."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                                rdfs:label "Recovered material quality result"@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecoveredTextileMaterial
:RecoveredTextileMaterial rdf:type owl:Class ;
                          rdfs:subClassOf <https://w3id.org/eudpp#MaterialOfComposition> ;
                          <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                          rdfs:comment "Material output recovered from an actual textile recycling process and potentially usable as input to another production process."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                          rdfs:label "Recovered textile material"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#Recyclability
:Recyclability rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/eudpp#Property> ;
               owl:disjointWith :RecycledContent ;
               <http://purl.org/dc/terms/relation> <https://w3id.org/eudpp#RecoverableRate> ,
                                                   <https://w3id.org/eudpp#RecyclingRate> ;
               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                 <https://w3id.org/eudpp/textile-ontology> ;
               rdfs:comment "Potential of a textile product, under a specified collection, sorting, preparation and recycling context, to provide fibre or material feedstock usable in one or more recycling routes without disruptive elements or substances."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
               rdfs:label "Recyclability"@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessment
:RecyclabilityAssessment rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentExecution> ;
                         owl:disjointWith :RecycledContentAssessment ;
                         <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                         rdfs:comment "Concrete execution of a recyclability assessment method on a specified textile product for stated recycling routes and conditions."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                         rdfs:label "Recyclability assessment"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentMethod
:RecyclabilityAssessmentMethod rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentMethod> ;
                               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "Reusable procedure for evaluating textile-product recyclability against stated criteria, assumed system conditions and one or more recycling routes."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                               rdfs:label "Recyclability assessment method"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentResult
:RecyclabilityAssessmentResult rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentResult> ;
                               owl:disjointWith :RecycledContentAssessmentResult ;
                               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "Result produced by a recyclability assessment, reporting route-specific criterion outcomes, barriers, recyclable fraction, score or label when applicable."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                               rdfs:label "Recyclability assessment result"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrier
:RecyclabilityBarrier rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentElement> ;
                      <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                        <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Product, material, substance, information or system condition that hinders collection, sorting, preparation, recycling or the use and quality of recovered material for a specified route."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                      rdfs:label "Recyclability barrier"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept
:RecyclabilityBarrierTypeConcept rdf:type owl:Class ;
                                 rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                 rdfs:comment "Controlled concept classifying a recyclability barrier."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                                 rdfs:label "Recyclability barrier type concept"@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept
:RecyclabilityCriterionConcept rdf:type owl:Class ;
                               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "Controlled concept identifying a criterion used in a recyclability assessment."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                               rdfs:label "Recyclability criterion concept"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionResult
:RecyclabilityCriterionResult rdf:type owl:Class ;
                              rdfs:subClassOf :RecyclabilityAssessmentResult ;
                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                              rdfs:comment "Assessment result reporting the outcome of one controlled recyclability criterion for a product and, where relevant, a specified recycling route."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                              rdfs:label "Recyclability criterion result"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept
:RecyclabilityLabelConcept rdf:type owl:Class ;
                           rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                           <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                           rdfs:comment "Controlled categorical label used by a specified recyclability scoring method."@en ;
                           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                           rdfs:label "Recyclability label concept"@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityOutcomeConcept
:RecyclabilityOutcomeConcept rdf:type owl:Class ;
                             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                             rdfs:comment "Controlled concept expressing the outcome of a recyclability criterion."@en ;
                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                             rdfs:label "Recyclability outcome concept"@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityScore
:RecyclabilityScore rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/eudpp/textile-indicator#Indicator> ;
                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                      <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ,
                                                      <https://w3id.org/eudpp/textile-ontology> ;
                    rdfs:comment "Method-specific indicator calculated from stated recyclability criteria and assumptions. A score does not by itself prove that a product will be collected or recycled in practice."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                    rdfs:label "Recyclability score"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5392-5443; Table 76, printed page 191; JRC DPP Study, Section 7.3, printed page 49, data point “Recyclability score”."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringMethod
:RecyclabilityScoringMethod rdf:type owl:Class ;
                            rdfs:subClassOf :RecyclabilityAssessmentMethod ;
                            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                              <https://w3id.org/eudpp/textile-ontology> ;
                            rdfs:comment "Assessment method that combines criterion outcomes into a method-specific recyclability score or label. It is not a universal regulatory scoring formula."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                            rdfs:label "Recyclability scoring method"@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5402-5443; Table 76, printed page 191, caption line 5441."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclabilityScoringRule
:RecyclabilityScoringRule rdf:type owl:Class ;
                          <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                          rdfs:comment "Rule belonging to a recyclability scoring method and assigning a quantitative point value to a stated criterion under stated route or threshold conditions."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                          rdfs:label "Recyclability scoring rule"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "domain evidence from JRC Section 11.1.2.1, Table 76, pages 190-191."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecycledContent
:RecycledContent rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/eudpp#Property> ;
                 <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                 rdfs:comment "Product aspect describing the proportion by mass of recycled fibres from post-industrial, pre-consumer or post-consumer waste in a textile product."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                 rdfs:label "Recycled content"@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.5, printed page 134, lines 3666-3675; Section 9.2.5.4, printed page 143, lines 3957-3961."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessment
:RecycledContentAssessment rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentExecution> ;
                           <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                           rdfs:comment "Assessment execution that verifies or evaluates a recycled-content declaration for a textile product."@en ;
                           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                           rdfs:label "Recycled content assessment"@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3982."@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessmentResult
:RecycledContentAssessmentResult rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentResult> ;
                                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                 rdfs:comment "Assessment result reporting the outcome of verifying or evaluating a recycled-content declaration."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                                 rdfs:label "Recycled content assessment result"@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Sections 9.2.5.4-9.2.5.5, pages 143-144."@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-recyclability#RecycledContentDeclaration
:RecycledContentDeclaration rdf:type owl:Class ;
                            <http://purl.org/dc/terms/relation> <https://w3id.org/eudpp#RecycledMaterialsUse> ;
                            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ,
                                                              <https://w3id.org/eudpp/textile-ontology> ;
                            rdfs:comment "Declaration reporting the mass fraction of recycled material in a textile product or material. Recycled content is related to, but distinct from, recyclability."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                            rdfs:label "Recycled content declaration"@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC DPP Study, Section 7.3, printed page 50, data point “Recycled content”."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecycledContentPerformanceThreshold
:RecycledContentPerformanceThreshold rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#PerformanceThreshold> ;
                                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                     rdfs:comment "Performance threshold defining a minimum recycled-content value for a stated product, fibre or source context. Candidate values proposed in the JRC design option remain assessment data rather than universal OWL axioms."@en ;
                                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                                     rdfs:label "Recycled content performance threshold"@en ;
                                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 11.1.3, printed page 194, lines 5496-5503; JRC Preparatory Study, Section 11.1.3.1, printed page 194, lines 5504-5519."@en ;
                                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceConcept
:RecycledContentSourceConcept rdf:type owl:Class ;
                              rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf> ,
                                                                <https://w3id.org/eudpp/textile-ontology> ;
                              rdfs:comment "Controlled concept identifying the lifecycle source category of recycled content, including post-industrial, pre-consumer and post-consumer material. The declaration or method must state the definition framework used because ISO and ESPR terminology are not fully aligned."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                              rdfs:label "Recycled content source concept"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC DPP Study, Section 7.3, printed page 50, data point “Origin of the recycled content”."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecycledContentVerificationMethod
:RecycledContentVerificationMethod rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentMethod> ;
                                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                   rdfs:comment "Assessment method used to verify a recycled-content declaration where no direct laboratory determination of recycled versus virgin fibre origin is available at scale."@en ;
                                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                                   rdfs:label "Recycled content verification method"@en ;
                                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3974."@en ;
                                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecycledTextileFibre
:RecycledTextileFibre rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/eudpp/textile-core#TextileFibre> ,
                                      :RecoveredTextileMaterial ;
                      <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                        <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Recovered textile material represented as a textile fibre suitable, subject to quality and process requirements, for use in textile products."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                      rdfs:label "Recycled textile fibre"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-recyclability#RecyclingLoopConcept
:RecyclingLoopConcept rdf:type owl:Class ;
                      rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Controlled concept identifying the intended material-loop destination of a recycling route."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                      rdfs:label "Recycling loop concept"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
