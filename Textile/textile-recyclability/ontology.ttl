                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-recyclability> ;
                       rdfs:label "Textile recycling event"@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "EU DPP EVENT module: dpp:ProductEvent."@en ;
