     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-ontology">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-ontology/1.1.2"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-structure"/>
        <terms:creator>Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Modular ontology network for textile product information in Digital Product Passports, covering product structure, processes, durability, assessment, indicators, context, repairability, recyclability, associated materials and substances of concern.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:title xml:lang="en">CIRPASS Textile Ontology</terms:title>
        <rdfs:label xml:lang="en">CIRPASS Textile Ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
    </owl:Ontology>
    


