        <skos:prefLabel xml:lang="en">Ironing practice</skos:prefLabel>
        <textile-connector:modellingNote xml:lang="en">High-temperature ironing may contribute to shrinkage; the effect remains product- and condition-dependent.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.7.2.6, printed page 403, lines 10417-10433; JRC Preparatory Study, Section 6.3.1, printed page 85, lines 2132-2134.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#directExtraction"/>
        <textile-connector:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#DimensionalStability"/>
        <textile-context:typicallyQualifiesProcess rdf:resource="https://w3id.org/eudpp/textile-process#IroningProcess"/>
    </owl:NamedIndividual>
    


