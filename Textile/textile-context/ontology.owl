        <skos:prefLabel xml:lang="en">Washing frequency</skos:prefLabel>
        <textile-connector:modellingNote xml:lang="en">Washing frequency may influence physical durability and dimensional stability, but the effect depends on material, programme and care conditions.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.7.2, printed page 395, lines 10241-10248; JRC Preparatory Study, Section 6.3.1, printed page 84, lines 2105-2111.</textile-connector:sourceLocator>
