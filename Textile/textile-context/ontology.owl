<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/textile-durability#"
     xml:base="https://w3id.org/eudpp/textile-durability"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:textile-context="https://w3id.org/eudpp/textile-context#"
     xmlns:textile-connector="https://w3id.org/eudpp/textile-connector#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-durability">
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Textile Context Ontology. Version 1.1.2.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:created>
        <terms:creator xml:lang="en">Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Ontology module for representing concrete observations, declarations and settings about textile use, care, environmental exposure, storage and user behaviour. Context factor types are represented as SKOS concepts; processes and process parameters remain in TEXTILE_PROCESS.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:title xml:lang="en">EU DPP Textile Context Ontology</terms:title>
        <vann:preferredNamespacePrefix>txtctx</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-context#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">A context observation is not a textile process, process parameter, assessment result or derived indicator. Washing temperature and similar operational settings remain represented through TEXTILE_PROCESS.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">EU DPP Textile Context Ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
        <textile-connector:sourceLocator xml:lang="en">JRC 3rd milestone, Sections 6.3 (pages 84-87, lines 2105-2244), 9.2.2.2 (pages 125-126, lines 3296-3327), and 13.7.2 (pages 395-410, lines 10227-10646).</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Ontology>
    


