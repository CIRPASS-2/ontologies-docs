    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#hasTopConcept -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#hasTopConcept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#narrower -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#narrower"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#topConceptOf -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#topConceptOf"/>
    


    <!-- https://w3id.org/eudpp/textile-connector#modellingNote -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#modellingNote"/>
    


    <!-- https://w3id.org/eudpp/textile-connector#sourceLocator -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#sourceLocator"/>
    


    <!-- https://w3id.org/eudpp/textile-connector#sourceType -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#sourceType"/>
    


    <!-- https://w3id.org/eudpp/textile-connector#typicalInfluenceOn -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"/>
    


    <!-- https://w3id.org/eudpp/textile-context#typicallyQualifiesProcess -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-context#typicallyQualifiesProcess">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a context factor typically qualifies the interpretation, applicability or expected effect of a textile process type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">typically qualifies process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/textile-context#hasCategoricalValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-context#hasCategoricalValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile context observation to a controlled categorical value represented as a SKOS concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">has categorical value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-context#hasContextFactorType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-context#hasContextFactorType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Identifies the controlled context factor concept observed or declared by a textile context observation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">has context factor type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-context#hasContextObservation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-context#hasContextObservation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#Product"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a product or a concrete textile process execution to a context observation applying to it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">has context observation</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-context#hasQuantitativeValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-context#hasQuantitativeValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile context observation to its quantitative value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">has quantitative value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-context#hasReferencePeriod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-context#hasReferencePeriod">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#ReferencePeriod"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile context observation to the structured time interval for which it is valid or observed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">has reference period</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-context#observationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-context#observationOf">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-context#hasContextObservation"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp#Product"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile context observation to the product or process execution to which it applies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">observation of</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/textile-context#hasTextualValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/textile-context#hasTextualValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile context observation to a textual value used when no controlled concept or quantitative representation is available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">has textual value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    


    <!-- https://w3id.org/eudpp#Product -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Product"/>
    


    <!-- https://w3id.org/eudpp/textile-connector#QuantitativeValue -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
    


    <!-- https://w3id.org/eudpp/textile-connector#ReferencePeriod -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-connector#ReferencePeriod"/>
    


    <!-- https://w3id.org/eudpp/textile-context#TextileContextFactorConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A SKOS concept identifying the type of contextual condition observed or declared for a textile product or process execution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">Textile context factor concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-context#TextileContextObservation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-context#TextileContextObservation">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A concrete observation, declaration or setting of a contextual condition applying to a textile product or a textile process execution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">Textile context observation</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileProcessExecution -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/textile-context#ContextFactorScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-context#ContextFactorScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Controlled vocabulary of textile use, care, exposure, storage and user-behaviour context factor types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">Textile context factor scheme</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-context#careContextFactor"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-context#environmentalContextFactor"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-context#storageContextFactor"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-context#useContextFactor"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-context#userBehaviourFactor"/>
        <skos:prefLabel xml:lang="en">Textile context factor scheme</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-context#abrasionExposure -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-context#abrasionExposure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Exposure of a textile product to rubbing, friction or abrasion during use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">Abrasion exposure</rdfs:label>
        <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#useContextFactor"/>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
        <skos:prefLabel xml:lang="en">Abrasion exposure</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1.3, printed page 113, lines 3000-3009; Annex 13.4, Table 124, printed pages 362-367.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-context#activeOrInactiveStorage -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-context#activeOrInactiveStorage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Whether a textile item is stored for regular access and use or kept unused for an extended period.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <rdfs:label xml:lang="en">Active or inactive storage</rdfs:label>
        <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#storageContextFactor"/>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
        <skos:prefLabel xml:lang="en">Active or inactive storage</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.3.4, printed pages 86-87, lines 2220-2231; JRC Preparatory Study, Section 13.7.2.10, printed page 410, lines 10618-10646.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-context#bleachingPractice -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-context#bleachingPractice">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
