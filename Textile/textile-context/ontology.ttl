#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp/textile-context#hasCategoricalValue
<https://w3id.org/eudpp/textile-context#hasCategoricalValue> rdf:type owl:ObjectProperty ;
                                                             rdfs:domain <https://w3id.org/eudpp/textile-context#TextileContextObservation> ;
                                                             rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                                             rdfs:comment "Relates a textile context observation to a controlled categorical value represented as a SKOS concept."@en ;
                                                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
                                                             rdfs:label "has categorical value"@en ;
                                                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-context#hasContextFactorType
<https://w3id.org/eudpp/textile-context#hasContextFactorType> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <https://w3id.org/eudpp/textile-context#TextileContextObservation> ;
                                                              rdfs:range <https://w3id.org/eudpp/textile-context#TextileContextFactorConcept> ;
                                                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                                              rdfs:comment "Identifies the controlled context factor concept observed or declared by a textile context observation."@en ;
                                                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
                                                              rdfs:label "has context factor type"@en ;
                                                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-context#hasContextObservation
<https://w3id.org/eudpp/textile-context#hasContextObservation> rdf:type owl:ObjectProperty ;
                                                               rdfs:domain [ rdf:type owl:Class ;
                                                                             owl:unionOf ( <https://w3id.org/eudpp#Product>
                                                                                           <https://w3id.org/eudpp/textile-process#TextileProcessExecution>
                                                                                         )
                                                                           ] ;
                                                               rdfs:range <https://w3id.org/eudpp/textile-context#TextileContextObservation> ;
                                                               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                                               rdfs:comment "Relates a product or a concrete textile process execution to a context observation applying to it."@en ;
                                                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
                                                               rdfs:label "has context observation"@en ;
                                                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-context#hasQuantitativeValue
<https://w3id.org/eudpp/textile-context#hasQuantitativeValue> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <https://w3id.org/eudpp/textile-context#TextileContextObservation> ;
                                                              rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                                                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                                              rdfs:comment "Relates a textile context observation to its quantitative value."@en ;
                                                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
                                                              rdfs:label "has quantitative value"@en ;
                                                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-context#hasReferencePeriod
<https://w3id.org/eudpp/textile-context#hasReferencePeriod> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <https://w3id.org/eudpp/textile-context#TextileContextObservation> ;
                                                            rdfs:range <https://w3id.org/eudpp/textile-connector#ReferencePeriod> ;
                                                            <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                                            rdfs:comment "Relates a textile context observation to the structured time interval for which it is valid or observed."@en ;
                                                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
                                                            rdfs:label "has reference period"@en ;
                                                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-context#observationOf
<https://w3id.org/eudpp/textile-context#observationOf> rdf:type owl:ObjectProperty ;
                                                       owl:inverseOf <https://w3id.org/eudpp/textile-context#hasContextObservation> ;
                                                       rdfs:domain <https://w3id.org/eudpp/textile-context#TextileContextObservation> ;
                                                       rdfs:range [ rdf:type owl:Class ;
                                                                    owl:unionOf ( <https://w3id.org/eudpp#Product>
                                                                                  <https://w3id.org/eudpp/textile-process#TextileProcessExecution>
                                                                                )
                                                                  ] ;
                                                       <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                                       rdfs:comment "Relates a textile context observation to the product or process execution to which it applies."@en ;
                                                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
                                                       rdfs:label "observation of"@en ;
                                                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/eudpp/textile-context#hasTextualValue
<https://w3id.org/eudpp/textile-context#hasTextualValue> rdf:type owl:DatatypeProperty ;
                                                         rdfs:domain <https://w3id.org/eudpp/textile-context#TextileContextObservation> ;
                                                         rdfs:range xsd:string ;
                                                         <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                                         rdfs:comment "Relates a textile context observation to a textual value used when no controlled concept or quantitative representation is available."@en ;
                                                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
                                                         rdfs:label "has textual value"@en ;
                                                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


