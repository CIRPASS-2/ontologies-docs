                                                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/eudpp/textile-context#ContextFactorScheme> ;
                                                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Active or inactive storage"@en ;
                                                                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 6.3.4, printed pages 86-87, lines 2220-2231; JRC Preparatory Study, Section 13.7.2.10, printed page 410, lines 10618-10646."@en ;
                                                                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


