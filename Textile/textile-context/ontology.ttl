@prefix : <https://w3id.org/eudpp/textile-durability#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-durability#> .

<https://w3id.org/eudpp/textile-durability> rdf:type owl:Ontology ;
                                             owl:imports <https://w3id.org/eudpp/textile-connector> ,
                                                         <https://w3id.org/eudpp/textile-dpp-mireot> ,
                                                         <https://w3id.org/eudpp/textile-durability> ,
                                                         <https://w3id.org/eudpp/textile-process> ;
                                             <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Context Ontology. Version 1.1.2."@en ;
                                             <http://purl.org/dc/terms/created> "2026-03-06"^^xsd:date ;
                                             <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                             <http://purl.org/dc/terms/description> "Ontology module for representing concrete observations, declarations and settings about textile use, care, environmental exposure, storage and user behaviour. Context factor types are represented as SKOS concepts; processes and process parameters remain in TEXTILE_PROCESS."@en ;
                                             <http://purl.org/dc/terms/issued> "2026-03-06"^^xsd:date ;
                                             <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                             <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                             <http://purl.org/dc/terms/title> "EU DPP Textile Context Ontology"@en ;
                                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtctx" ;
                                             <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-context#" ;
                                             rdfs:comment "A context observation is not a textile process, process parameter, assessment result or derived indicator. Washing temperature and similar operational settings remain represented through TEXTILE_PROCESS."@en ;
                                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
                                             rdfs:label "EU DPP Textile Context Ontology"@en ;
                                             owl:versionInfo "Version 1.1.2" ;
                                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC 3rd milestone, Sections 6.3 (pages 84-87, lines 2105-2244), 9.2.2.2 (pages 125-126, lines 3296-3327), and 13.7.2 (pages 395-410, lines 10227-10646)."@en ;
                                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .

