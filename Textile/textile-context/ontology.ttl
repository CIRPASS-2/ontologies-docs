###  https://w3id.org/eudpp/textile-context#ContextFactorScheme
<https://w3id.org/eudpp/textile-context#ContextFactorScheme> rdf:type owl:NamedIndividual ,
                                                                      <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                                                             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                                             rdfs:comment "Controlled vocabulary of textile use, care, exposure, storage and user-behaviour context factor types."@en ;
                                                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
                                                             rdfs:label "Textile context factor scheme"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#hasTopConcept> <https://w3id.org/eudpp/textile-context#careContextFactor> ,
                                                                                                                 <https://w3id.org/eudpp/textile-context#environmentalContextFactor> ,
                                                                                                                 <https://w3id.org/eudpp/textile-context#storageContextFactor> ,
                                                                                                                 <https://w3id.org/eudpp/textile-context#useContextFactor> ,
                                                                                                                 <https://w3id.org/eudpp/textile-context#userBehaviourFactor> ;
                                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Textile context factor scheme"@en ;
                                                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-context#abrasionExposure
<https://w3id.org/eudpp/textile-context#abrasionExposure> rdf:type owl:NamedIndividual ,
                                                                   <http://www.w3.org/2004/02/skos/core#Concept> ,
                                                                   <https://w3id.org/eudpp/textile-context#TextileContextFactorConcept> ;
                                                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                                          rdfs:comment "Exposure of a textile product to rubbing, friction or abrasion during use."@en ;
                                                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-context> ;
                                                          rdfs:label "Abrasion exposure"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/eudpp/textile-context#useContextFactor> ;
                                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/eudpp/textile-context#ContextFactorScheme> ;
                                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Abrasion exposure"@en ;
                                                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.1.3, printed page 113, lines 3000-3009; Annex 13.4, Table 124, printed pages 362-367."@en ;
                                                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-context#activeOrInactiveStorage
<https://w3id.org/eudpp/textile-context#activeOrInactiveStorage> rdf:type owl:NamedIndividual ,
                                                                          <http://www.w3.org/2004/02/skos/core#Concept> ,
                                                                          <https://w3id.org/eudpp/textile-context#TextileContextFactorConcept> ;
                                                                 <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                                                 rdfs:comment "Whether a textile item is stored for regular access and use or kept unused for an extended period."@en ;
