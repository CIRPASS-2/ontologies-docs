    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept"/>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept"/>
    


    <!-- https://w3id.org/eudpp/textile-core#FibreCompositionComponent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#FibreCompositionComponent"/>
    


    <!-- https://w3id.org/eudpp/textile-process#TextileProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-process#TextileProcess"/>
    


    <!-- https://w3id.org/eudpp/textile-soc#NonTextileComponentMaterialGroup -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#NonTextileComponentMaterialGroup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#MaterialGroup"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A material grouping associated with one or more non-textile components, used as a location or concentration reference unit without treating the component itself as a material group.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Non-textile component material group</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileConcentrationInformation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileConcentrationInformation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#ConcentrationInformation"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Concentration information for a substance present in a textile product, expressed at product, component, material-group or spare-part level as an exact value, maximum value or range.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile concentration information</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Regulation (EU) 2024/1781, Article 7(5)(c)</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileFibreCompositionMaterialGroup -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileFibreCompositionMaterialGroup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#FibreCompositionComponent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-soc#TextileMaterialGroup"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Bridge class for a fibre-composition component that is used as the material-group scope of a textile substance-of-concern presence context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile fibre-composition material group</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This local bridge avoids globally reclassifying every Textile Core fibre-composition component as a SoC material group.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 12.3.12, printed page 246, lines 6847-6863.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileMaterialGroup -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileMaterialGroup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#MaterialGroup"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A fibre-, yarn- or fabric-based material grouping within a textile product that serves as a location or mass-reference unit for substance reporting.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile material group</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileProductGroupSoCReference -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileProductGroupSoCReference">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#ProductGroupSpecificSoCList"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">A versioned reference identifying the textile-product-group source that qualifies a substance under the product-group-specific type (d) criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">Textile product-group SoC reference</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Regulation (EU) 2024/1781, Article 2(27)(d).</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-soc#TextileRecyclingAlertThreshold -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-soc#TextileRecyclingAlertThreshold">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#AlertConcentrationThreshold"/>
