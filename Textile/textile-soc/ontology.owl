    <!-- https://w3id.org/eudpp/soc#hasInstructionInformation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/soc#hasInstructionInformation"/>
    


    <!-- https://w3id.org/eudpp/soc#isQualifiedByProductGroupList -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/soc#isQualifiedByProductGroupList"/>
    


    <!-- https://w3id.org/eudpp/textile-soc#hasPresenceChemicalFunction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-soc#hasPresenceChemicalFunction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile substance occurrence to the chemical function performed in that textile context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">has presence chemical function</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed page 226, lines 6437-6455.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-soc#hasPresenceUseCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-soc#hasPresenceUseCategory">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Classifies the textile chemical occurrence by whether it is associated with process use, intended performance use or unintended presence. The classification is attached to the occurrence rather than globally to the substance identity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">has presence use category</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3, printed page 226, lines 6428-6455.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-soc#hasTextileHandlingInformation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-soc#hasTextileHandlingInformation">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/soc#hasInstructionInformation"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-soc#TextileSoCHandlingInformation"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile substance-of-concern presence context to textile-specific safe-use or lifecycle-handling information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">has textile handling information</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Regulation (EU) 2024/1781, Article 7(5)(d)-(e).</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-soc#hasTextileLocationType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-soc#hasTextileLocationType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/soc#LocationInformation"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-soc#TextileSoCLocationTypeConcept"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a location information object to a controlled textile-specific location type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">has textile location type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Regulation (EU) 2024/1781, Article 7(5)(b).</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-soc#hasTextileProductGroupReference -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-soc#hasTextileProductGroupReference">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/soc#isQualifiedByProductGroupList"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-soc#TextileTypeDQualification"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-soc#TextileProductGroupSoCReference"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile type (d) qualification to the versioned textile product-group reference supporting that qualification.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">has textile product-group reference</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">Regulation (EU) 2024/1781, Article 2(27)(d).</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-soc#relevantToTextileProcess -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-soc#relevantToTextileProcess">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile substance occurrence to a textile process type that introduced, used, transformed or is affected by the substance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
        <rdfs:label xml:lang="en">relevant to textile process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


