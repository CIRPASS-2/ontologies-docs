<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/textile-soc#"
     xml:base="https://w3id.org/eudpp/textile-soc"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:textile-connector="https://w3id.org/eudpp/textile-connector#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-soc">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-soc/1.1.2"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-soc-mireot"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Textile Ontology - Textile Substances of Concern Module. Version 1.1.2.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-09</terms:created>
        <terms:creator xml:lang="en">Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Textile-sector specialisation of the EU DPP Substances of Concern ontology. It specialises substance presence, product location, concentration reporting, product-group qualification, thresholds and lifecycle handling for textile products.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-09</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <terms:title xml:lang="en">EU DPP Textile Ontology - Textile Substances of Concern Module</terms:title>
        <vann:preferredNamespacePrefix>txtsoc</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-soc#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">This module does not classify every textile chemical as a substance of concern. It specialises the generic SoC presence-context model for textile products and attaches textile-specific information to the occurrence, not globally to the chemical identity.</rdfs:comment>
        <rdfs:label xml:lang="en">Textile substances of concern ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
    </owl:Ontology>
    


