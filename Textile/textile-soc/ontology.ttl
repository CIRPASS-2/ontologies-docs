###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#AlertConcentrationThreshold
<https://w3id.org/eudpp/soc#AlertConcentrationThreshold> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#ConcentrationInformation
<https://w3id.org/eudpp/soc#ConcentrationInformation> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#InstructionInformation
<https://w3id.org/eudpp/soc#InstructionInformation> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#LocationInformation
<https://w3id.org/eudpp/soc#LocationInformation> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#MaterialGroup
<https://w3id.org/eudpp/soc#MaterialGroup> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#ProductGroupSpecificSoCList
<https://w3id.org/eudpp/soc#ProductGroupSpecificSoCList> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#SoCTypeDQualification
<https://w3id.org/eudpp/soc#SoCTypeDQualification> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#SubstanceOfConcernPresenceContext
<https://w3id.org/eudpp/soc#SubstanceOfConcernPresenceContext> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#TrackingThreshold
<https://w3id.org/eudpp/soc#TrackingThreshold> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept
<https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept
<https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-core#FibreCompositionComponent
<https://w3id.org/eudpp/textile-core#FibreCompositionComponent> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-process#TextileProcess
<https://w3id.org/eudpp/textile-process#TextileProcess> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-soc#NonTextileComponentMaterialGroup
:NonTextileComponentMaterialGroup rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/eudpp/soc#MaterialGroup> ;
                                  <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                    <https://w3id.org/eudpp/textile-ontology> ;
                                  rdfs:comment "A material grouping associated with one or more non-textile components, used as a location or concentration reference unit without treating the component itself as a material group."@en ;
                                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                                  rdfs:label "Non-textile component material group"@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-soc#TextileConcentrationInformation
:TextileConcentrationInformation rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/eudpp/soc#ConcentrationInformation> ;
                                 <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ,
                                                                   <https://w3id.org/eudpp/textile-ontology> ;
                                 rdfs:comment "Concentration information for a substance present in a textile product, expressed at product, component, material-group or spare-part level as an exact value, maximum value or range."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                                 rdfs:label "Textile concentration information"@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "Regulation (EU) 2024/1781, Article 7(5)(c)"@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-soc#TextileFibreCompositionMaterialGroup
:TextileFibreCompositionMaterialGroup rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/eudpp/textile-core#FibreCompositionComponent> ,
                                                      :TextileMaterialGroup ;
                                      <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                        <https://w3id.org/eudpp/textile-ontology> ;
                                      rdfs:comment "Bridge class for a fibre-composition component that is used as the material-group scope of a textile substance-of-concern presence context."@en ;
                                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                                      rdfs:label "Textile fibre-composition material group"@en ;
                                      <https://w3id.org/eudpp/textile-connector#modellingNote> "This local bridge avoids globally reclassifying every Textile Core fibre-composition component as a SoC material group."@en ;
                                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 12.3.12, printed page 246, lines 6847-6863."@en ;
                                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-soc#TextileMaterialGroup
:TextileMaterialGroup rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/eudpp/soc#MaterialGroup> ;
                      <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                        <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "A fibre-, yarn- or fabric-based material grouping within a textile product that serves as a location or mass-reference unit for substance reporting."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                      rdfs:label "Textile material group"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-soc#TextileProductGroupSoCReference
:TextileProductGroupSoCReference rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/eudpp/soc#ProductGroupSpecificSoCList> ;
                                 <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ,
                                                                   <https://w3id.org/eudpp/textile-ontology> ;
                                 rdfs:comment "A versioned reference identifying the textile-product-group source that qualifies a substance under the product-group-specific type (d) criterion."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                                 rdfs:label "Textile product-group SoC reference"@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "Regulation (EU) 2024/1781, Article 2(27)(d)."@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-soc#TextileRecyclingAlertThreshold
:TextileRecyclingAlertThreshold rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/eudpp/soc#AlertConcentrationThreshold> ;
                                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                  <https://w3id.org/eudpp/textile-ontology> ;
                                rdfs:comment "A textile-sector alert concentration used to inform sorting, recycling or environmentally sound end-of-life handling when the substance may hinder circular treatment."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                                rdfs:label "Textile recycling alert threshold"@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.5.2, printed page 142, lines 3910-3927; Section 12.3.12, printed page 246, lines 6823-6863."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-soc#TextileSoCHandlingInformation
:TextileSoCHandlingInformation rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/eudpp/soc#InstructionInformation> ;
                               <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ,
                                                                 <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                 <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "Textile-specific instruction information concerning safe use and lifecycle handling in the presence of a substance of concern, including disassembly, preparation for reuse, reuse, recycling and environmentally sound end-of-life management; repair guidance may be added as a textile/JRC extension."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                               rdfs:label "Textile SoC handling information"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 12.1, printed pages 219-220, lines 6205-6220."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-soc#TextileSoCLocationTypeConcept
:TextileSoCLocationTypeConcept rdf:type owl:Class ;
                               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                               <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ,
                                                                 <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                 <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "Controlled concept describing a textile-specific kind of product location used to qualify a substance location statement."@en ;
