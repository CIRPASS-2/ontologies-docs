@prefix : <https://w3id.org/eudpp/textile-soc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-soc#> .

<https://w3id.org/eudpp/textile-soc> rdf:type owl:Ontology ;
                                      owl:versionIRI <https://w3id.org/eudpp/textile-soc/1.1.2> ;
                                      owl:imports <https://w3id.org/eudpp/textile-associated-materials> ,
                                                  <https://w3id.org/eudpp/textile-connector> ,
                                                  <https://w3id.org/eudpp/textile-core> ,
                                                  <https://w3id.org/eudpp/textile-process> ,
                                                  <https://w3id.org/eudpp/textile-soc-mireot> ;
                                      <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Ontology - Textile Substances of Concern Module. Version 1.1.2."@en ;
                                      <http://purl.org/dc/terms/created> "2026-07-09"^^xsd:date ;
                                      <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                      <http://purl.org/dc/terms/description> "Textile-sector specialisation of the EU DPP Substances of Concern ontology. It specialises substance presence, product location, concentration reporting, product-group qualification, thresholds and lifecycle handling for textile products."@en ;
                                      <http://purl.org/dc/terms/issued> "2026-07-09"^^xsd:date ;
                                      <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                      <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                      <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ,
                                                                        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                        <https://w3id.org/eudpp/textile-ontology> ;
                                      <http://purl.org/dc/terms/title> "EU DPP Textile Ontology - Textile Substances of Concern Module"@en ;
                                      <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtsoc" ;
                                      <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-soc#" ;
                                      rdfs:comment "This module does not classify every textile chemical as a substance of concern. It specialises the generic SoC presence-context model for textile products and attaches textile-specific information to the occurrence, not globally to the chemical identity."@en ;
                                      rdfs:label "Textile substances of concern ontology"@en ;
                                      owl:versionInfo "Version 1.1.2" .

