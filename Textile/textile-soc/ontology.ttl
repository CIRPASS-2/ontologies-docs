#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp/soc#hasInstructionInformation
<https://w3id.org/eudpp/soc#hasInstructionInformation> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp/soc#isQualifiedByProductGroupList
<https://w3id.org/eudpp/soc#isQualifiedByProductGroupList> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp/textile-soc#hasPresenceChemicalFunction
:hasPresenceChemicalFunction rdf:type owl:ObjectProperty ;
                             rdfs:domain :TextileSubstanceOfConcernPresenceContext ;
                             rdfs:range <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept> ;
                             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                               <https://w3id.org/eudpp/textile-ontology> ;
                             rdfs:comment "Relates a textile substance occurrence to the chemical function performed in that textile context."@en ;
                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                             rdfs:label "has presence chemical function"@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed page 226, lines 6437-6455."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-soc#hasPresenceUseCategory
:hasPresenceUseCategory rdf:type owl:ObjectProperty ;
                        rdfs:domain :TextileSubstanceOfConcernPresenceContext ;
                        rdfs:range <https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept> ;
                        <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                          <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Classifies the textile chemical occurrence by whether it is associated with process use, intended performance use or unintended presence. The classification is attached to the occurrence rather than globally to the substance identity."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                        rdfs:label "has presence use category"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 12.3, printed page 226, lines 6428-6455."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-soc#hasTextileHandlingInformation
:hasTextileHandlingInformation rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf <https://w3id.org/eudpp/soc#hasInstructionInformation> ;
                               rdfs:domain :TextileSubstanceOfConcernPresenceContext ;
                               rdfs:range :TextileSoCHandlingInformation ;
                               <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ,
                                                                 <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "Relates a textile substance-of-concern presence context to textile-specific safe-use or lifecycle-handling information."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                               rdfs:label "has textile handling information"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "Regulation (EU) 2024/1781, Article 7(5)(d)-(e)."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-soc#hasTextileLocationType
:hasTextileLocationType rdf:type owl:ObjectProperty ;
                        rdfs:domain <https://w3id.org/eudpp/soc#LocationInformation> ;
                        rdfs:range :TextileSoCLocationTypeConcept ;
                        <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ,
                                                          <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Relates a location information object to a controlled textile-specific location type."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                        rdfs:label "has textile location type"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "Regulation (EU) 2024/1781, Article 7(5)(b)."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-soc#hasTextileProductGroupReference
:hasTextileProductGroupReference rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf <https://w3id.org/eudpp/soc#isQualifiedByProductGroupList> ;
                                 rdfs:domain :TextileTypeDQualification ;
                                 rdfs:range :TextileProductGroupSoCReference ;
                                 <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2024/1781/oj> ,
                                                                   <https://w3id.org/eudpp/textile-ontology> ;
                                 rdfs:comment "Relates a textile type (d) qualification to the versioned textile product-group reference supporting that qualification."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                                 rdfs:label "has textile product-group reference"@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "Regulation (EU) 2024/1781, Article 2(27)(d)."@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-soc#relevantToTextileProcess
:relevantToTextileProcess rdf:type owl:ObjectProperty ;
                          rdfs:domain :TextileSubstanceOfConcernPresenceContext ;
                          rdfs:range <https://w3id.org/eudpp/textile-process#TextileProcess> ;
                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                            <https://w3id.org/eudpp/textile-ontology> ;
                          rdfs:comment "Relates a textile substance occurrence to a textile process type that introduced, used, transformed or is affected by the substance."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
                          rdfs:label "relevant to textile process"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


