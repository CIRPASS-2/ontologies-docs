#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp/textile-assessment#appliesMethod
:appliesMethod rdf:type owl:ObjectProperty ;
               rdfs:domain :AssessmentExecution ;
               rdfs:range :AssessmentMethod ;
               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
               rdfs:comment "Relates an assessment execution to the reusable assessment method that it performs."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
               rdfs:label "applies method"@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#appliesToEndpoint
:appliesToEndpoint rdf:type owl:ObjectProperty ;
                   rdfs:domain :PerformanceThreshold ;
                   rdfs:range :TestEndpoint ;
                   <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                   rdfs:comment "Relates a performance threshold to the test endpoint to which the threshold applies."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                   rdfs:label "applies to endpoint"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#assessesPerformanceParameter
:assessesPerformanceParameter rdf:type owl:ObjectProperty ;
                              rdfs:domain :AssessmentExecution ;
                              rdfs:range <https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter> ;
                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                              rdfs:comment "Relates an assessment execution to the durability-related performance parameter being evaluated."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                              rdfs:label "assesses performance parameter"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#assessesProduct
:assessesProduct rdf:type owl:ObjectProperty ;
                 rdfs:domain :AssessmentExecution ;
                 rdfs:range <https://w3id.org/eudpp#Product> ;
                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                 rdfs:comment "Relates an assessment execution to the product being assessed, including a product that is used as a component of another product."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                 rdfs:label "assesses product"@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#criterionForPerformanceParameter
:criterionForPerformanceParameter rdf:type owl:ObjectProperty ;
                                  rdfs:domain :AssessmentDecisionCriterion ;
                                  rdfs:range <https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter> ;
                                  <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                  rdfs:comment "Relates a decision criterion to the durability-related performance parameter to which it applies."@en ;
                                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                                  rdfs:label "criterion for performance parameter"@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#definesEndpoint
:definesEndpoint rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :AssessmentMethod
                                             :AssessmentStandard
                                           )
                             ] ;
                 rdfs:range :TestEndpoint ;
                 <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                 rdfs:comment "Relates a method or standard to an endpoint or stopping condition it defines."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                 rdfs:label "defines endpoint"@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.4, Table 124, printed pages 362-367; table caption at line 9698."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#definesMethod
:definesMethod rdf:type owl:ObjectProperty ;
               owl:inverseOf :isDefinedByStandard ;
               rdfs:domain :AssessmentStandard ;
               rdfs:range :AssessmentMethod ;
               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
               rdfs:comment "Relates an assessment standard to an assessment method it defines or specifies."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
               rdfs:label "defines method"@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.4, Table 124, printed pages 362-367; table caption at line 9698."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#hasComparisonOperator
:hasComparisonOperator rdf:type owl:ObjectProperty ;
                       rdfs:domain :PerformanceThreshold ;
                       rdfs:range :ThresholdComparisonOperatorConcept ;
                       <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                       rdfs:comment "Relates a performance threshold to the controlled comparison operator applied to its threshold value."@en ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                       rdfs:label "has comparison operator"@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "domain motivation from JRC Annex 13.8.3, pages 451-452."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#hasCondition
:hasCondition rdf:type owl:ObjectProperty ;
              rdfs:domain :AssessmentExecution ;
              rdfs:range :AssessmentCondition ;
              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
              rdfs:comment "Relates an assessment execution to a condition under which it is performed."@en ;
              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
              rdfs:label "has condition"@en ;
              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 11.1.1.1, printed pages 185-186, lines 5252-5279; Table 71, printed page 186."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#hasMeasuredValue
:hasMeasuredValue rdf:type owl:ObjectProperty ;
                  rdfs:domain :MeasurementResult ;
                  rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                  <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                  rdfs:comment "Relates a measurement result to its quantitative measured value."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                  rdfs:label "has measured value"@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC domain motivation in Section 11.1.1.1, lines 5255-5279."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-assessment#hasMeasurementParameter
:hasMeasurementParameter rdf:type owl:ObjectProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :AssessmentCondition
                                                     :AssessmentMethod
                                                   )
                                     ] ;
                         rdfs:range :MeasurementParameter ;
                         <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                         rdfs:comment "Relates a method or assessment condition to a protocol parameter it specifies."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                         rdfs:label "has measurement parameter"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.1.3, printed pages 112-113, lines 2968-3010; Annex 13.4, Table 124, printed pages 362-367, caption line 9698."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#hasParameterSetting
:hasParameterSetting rdf:type owl:ObjectProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :AssessmentCondition
                                                 :AssessmentExecution
                                               )
                                 ] ;
                     rdfs:range :MeasurementParameterSetting ;
                     <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Relates an assessment execution or condition to a concrete parameter setting."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                     rdfs:label "has parameter setting"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#hasParameterValue
:hasParameterValue rdf:type owl:ObjectProperty ;
                   rdfs:domain :MeasurementParameterSetting ;
                   rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                   <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                   rdfs:comment "Relates a measurement parameter setting to its quantitative value."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                   rdfs:label "has parameter value"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-assessment#hasRatingValue
:hasRatingValue rdf:type owl:ObjectProperty ;
                rdfs:domain :MeasurementResult ;
                rdfs:range :RatingValueConcept ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Relates a measurement result to a controlled rating value or grade."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                rdfs:label "has rating value"@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5255-5279."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#hasScaleValue
:hasScaleValue rdf:type owl:ObjectProperty ;
               owl:inverseOf :inScale ;
               rdfs:domain :RatingScale ;
               rdfs:range :RatingValueConcept ;
               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
               rdfs:comment "Relates a rating scale to one of its controlled rating values."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
               rdfs:label "has scale value"@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#hasThresholdRatingValue
:hasThresholdRatingValue rdf:type owl:ObjectProperty ;
                         rdfs:domain :PerformanceThreshold ;
                         rdfs:range :RatingValueConcept ;
                         <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                         rdfs:comment "Relates a performance threshold to a controlled rating value used as its comparison level."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                         rdfs:label "has threshold rating value"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.8.3, Table 165, printed pages 447-452; table caption at line 10985."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#hasThresholdValue
:hasThresholdValue rdf:type owl:ObjectProperty ;
                   rdfs:domain :PerformanceThreshold ;
                   rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                   <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                   rdfs:comment "Relates a performance threshold to its quantitative comparison value."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                   rdfs:label "has threshold value"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC domain motivation in Annex 13.8.3, pages 451-452."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-assessment#inScale
:inScale rdf:type owl:ObjectProperty ;
         rdfs:domain :RatingValueConcept ;
         rdfs:range :RatingScale ;
         <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
         rdfs:comment "Relates a rating value to the rating scale to which it belongs."@en ;
         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
         rdfs:label "in scale"@en ;
         <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#isDefinedByStandard
:isDefinedByStandard rdf:type owl:ObjectProperty ;
                     rdfs:domain :AssessmentMethod ;
                     rdfs:range :AssessmentStandard ;
                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                     rdfs:comment "Relates an assessment method to the standard that defines or specifies it."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                     rdfs:label "is defined by standard"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.4, Table 124, printed pages 362-367; table caption at line 9698."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#isEvaluatedAgainst
:isEvaluatedAgainst rdf:type owl:ObjectProperty ;
                    rdfs:domain :AssessmentResult ;
                    rdfs:range :AssessmentDecisionCriterion ;
                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                    rdfs:comment "Relates an assessment result to a decision criterion against which it is evaluated."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                    rdfs:label "is evaluated against"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 11.1.1.1, printed pages 185-186, lines 5252-5284; Table 71, printed page 186."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#isInterpretedBy
:isInterpretedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain :MeasurementResult ;
                 rdfs:range :InterpretationScale ;
                 <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                 rdfs:comment "Relates a measurement result to the scale used to interpret it."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                 rdfs:label "is interpreted by"@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 11.1.1.1, printed pages 185-186, lines 5252-5284; Table 71, printed page 186."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#measuresPerformanceParameter
:measuresPerformanceParameter rdf:type owl:ObjectProperty ;
                              rdfs:domain :TestMethod ;
                              rdfs:range <https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter> ;
                              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                              rdfs:comment "Relates a test method to the durability-related performance parameter that the method is intended to assess."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                              rdfs:label "measures performance parameter"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3182-3184."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#producesResult
:producesResult rdf:type owl:ObjectProperty ;
                owl:inverseOf :resultOfAssessment ;
                rdfs:domain :AssessmentExecution ;
                rdfs:range :AssessmentResult ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Relates an assessment execution to a result produced by that execution."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                rdfs:label "produces result"@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.1.3, printed pages 112-113, lines 2968-3010."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


###  https://w3id.org/eudpp/textile-assessment#resultOfAssessment
:resultOfAssessment rdf:type owl:ObjectProperty ;
                    rdfs:domain :AssessmentResult ;
                    rdfs:range :AssessmentExecution ;
                    <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                    rdfs:comment "Relates an assessment result to the assessment execution that produced it."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                    rdfs:label "result of assessment"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#settingForParameter
:settingForParameter rdf:type owl:ObjectProperty ;
                     rdfs:domain :MeasurementParameterSetting ;
                     rdfs:range :MeasurementParameter ;
                     <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Relates a concrete parameter setting to the measurement parameter that it sets."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                     rdfs:label "setting for parameter"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-assessment#specifiesCondition
:specifiesCondition rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :AssessmentMethod
                                                :AssessmentStandard
                                              )
                                ] ;
                    rdfs:range :AssessmentCondition ;
                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                    rdfs:comment "Relates a method or standard to a condition prescribed by its protocol."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-assessment> ;
                    rdfs:label "specifies condition"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.8.3, Table 165, printed pages 447-452; table caption at line 10985."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedRelation> .


