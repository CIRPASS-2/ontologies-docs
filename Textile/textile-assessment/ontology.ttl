@prefix : <https://w3id.org/eudpp/textile-assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-assessment#> .

<https://w3id.org/eudpp/textile-assessment> rdf:type owl:Ontology ;
                                             owl:versionIRI <https://w3id.org/eudpp/textile-assessment/1.1.2> ;
                                             owl:imports <https://w3id.org/eudpp/textile-connector> ,
                                                         <https://w3id.org/eudpp/textile-dpp-mireot> ,
                                                         <https://w3id.org/eudpp/textile-durability> ;
                                             <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Assessment Ontology. Version 1.1.2."@en ;
                                             <http://purl.org/dc/terms/created> "2026-03-06"^^xsd:date ;
                                             <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                             <http://purl.org/dc/terms/description> "Ontology module for textile assessment methods, standards, executions, conditions, parameter settings, results, interpretation scales, endpoints and performance thresholds."@en ;
                                             <http://purl.org/dc/terms/issued> "2026-03-06"^^xsd:date ;
                                             <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                             <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                             <http://purl.org/dc/terms/title> "EU DPP Textile Assessment Ontology"@en ;
                                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtass" ;
                                             <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-assessment#" ;
                                             rdfs:comment "Quantitative results, parameter settings and thresholds use txtcon:QuantitativeValue and SI Digital Framework units through the Textile Connector pattern."@en ,
                                                          "The module separates reusable methods and standards, concrete assessment executions, and the results produced by those executions."@en ;
                                             rdfs:label "EU DPP Textile Assessment Ontology"@en ;
                                             owl:versionInfo "Version 1.1.2" ;
                                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .

