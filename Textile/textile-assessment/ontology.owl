    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/textile-assessment#appliesMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#appliesMethod">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an assessment execution to the reusable assessment method that it performs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">applies method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#appliesToEndpoint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#appliesToEndpoint">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#PerformanceThreshold"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#TestEndpoint"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a performance threshold to the test endpoint to which the threshold applies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">applies to endpoint</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#assessesPerformanceParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#assessesPerformanceParameter">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an assessment execution to the durability-related performance parameter being evaluated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">assesses performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#assessesProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#assessesProduct">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an assessment execution to the product being assessed, including a product that is used as a component of another product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">assesses product</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#criterionForPerformanceParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#criterionForPerformanceParameter">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentDecisionCriterion"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a decision criterion to the durability-related performance parameter to which it applies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">criterion for performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#definesEndpoint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#definesEndpoint">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#AssessmentStandard"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#TestEndpoint"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a method or standard to an endpoint or stopping condition it defines.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">defines endpoint</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.4, Table 124, printed pages 362-367; table caption at line 9698.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#definesMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#definesMethod">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-assessment#isDefinedByStandard"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentStandard"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates an assessment standard to an assessment method it defines or specifies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">defines method</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.4, Table 124, printed pages 362-367; table caption at line 9698.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#hasComparisonOperator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#hasComparisonOperator">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#PerformanceThreshold"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#ThresholdComparisonOperatorConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a performance threshold to the controlled comparison operator applied to its threshold value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">has comparison operator</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">domain motivation from JRC Annex 13.8.3, pages 451-452.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#hasCondition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#hasCondition">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentCondition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates an assessment execution to a condition under which it is performed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">has condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 11.1.1.1, printed pages 185-186, lines 5252-5279; Table 71, printed page 186.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#hasMeasuredValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#hasMeasuredValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#MeasurementResult"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a measurement result to its quantitative measured value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">has measured value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC domain motivation in Section 11.1.1.1, lines 5255-5279.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#hasMeasurementParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#hasMeasurementParameter">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#AssessmentCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#MeasurementParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a method or assessment condition to a protocol parameter it specifies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">has measurement parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1.3, printed pages 112-113, lines 2968-3010; Annex 13.4, Table 124, printed pages 362-367, caption line 9698.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#hasParameterSetting -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#hasParameterSetting">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#AssessmentCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#MeasurementParameterSetting"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an assessment execution or condition to a concrete parameter setting.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">has parameter setting</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#hasParameterValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#hasParameterValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#MeasurementParameterSetting"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a measurement parameter setting to its quantitative value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">has parameter value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#hasRatingValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#hasRatingValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#MeasurementResult"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#RatingValueConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a measurement result to a controlled rating value or grade.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">has rating value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5255-5279.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#hasScaleValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#hasScaleValue">
        <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-assessment#inScale"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#RatingScale"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#RatingValueConcept"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a rating scale to one of its controlled rating values.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <rdfs:label xml:lang="en">has scale value</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-assessment#hasThresholdRatingValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-assessment#hasThresholdRatingValue">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#PerformanceThreshold"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#RatingValueConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a performance threshold to a controlled rating value used as its comparison level.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
