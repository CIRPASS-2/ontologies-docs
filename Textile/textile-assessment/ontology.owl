<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/textile-assessment#"
     xml:base="https://w3id.org/eudpp/textile-assessment"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:textile-connector="https://w3id.org/eudpp/textile-connector#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-assessment">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-assessment/1.1.2"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Textile Assessment Ontology. Version 1.1.2.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:created>
        <terms:creator xml:lang="en">Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Ontology module for textile assessment methods, standards, executions, conditions, parameter settings, results, interpretation scales, endpoints and performance thresholds.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <terms:title xml:lang="en">EU DPP Textile Assessment Ontology</terms:title>
        <vann:preferredNamespacePrefix>txtass</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-assessment#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Quantitative results, parameter settings and thresholds use txtcon:QuantitativeValue and SI Digital Framework units through the Textile Connector pattern.</rdfs:comment>
        <rdfs:comment xml:lang="en">The module separates reusable methods and standards, concrete assessment executions, and the results produced by those executions.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Textile Assessment Ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:Ontology>
    


