  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "TextileProduct is the broad textile product class. It includes final products and products serving an intermediate or component role when they are represented as product-like traceability resources. Identification constraints should be specified by SHACL according to product granularity rather than imposed uniformly on every TextileProduct."
  } ],
