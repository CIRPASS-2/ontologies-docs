@prefix : <https://w3id.org/eudpp/textile-core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-core#> .

<https://w3id.org/eudpp/textile-core> rdf:type owl:Ontology ;
                                       owl:versionIRI <https://w3id.org/eudpp/textile-core/1.1.2> ;
                                       owl:imports <https://w3id.org/eudpp/textile-connector> ,
                                                   <https://w3id.org/eudpp/textile-dpp-mireot> ,
                                                   <https://w3id.org/eudpp/textile-mat-mireot> ;
                                       <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Core Ontology. Version 1.1.2."@en ;
                                       <http://purl.org/dc/terms/created> "2026-03-06"^^xsd:date ;
                                       <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                       <http://purl.org/dc/terms/description> "Ontology module for representing core textile product data relevant to EU Digital Product Passports, including textile product classes, textile apparel scope concepts, fibre composition structures, and controlled SKOS vocabularies for textile apparel product types and fibre types aligned with the JRC preparatory study on textiles."@en ;
                                       <http://purl.org/dc/terms/issued> "2026-03-06"^^xsd:date ;
                                       <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                       <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                       <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                         <https://w3id.org/eudpp/textile-ontology> ;
                                       <http://purl.org/dc/terms/title> "EU DPP Textile Core Ontology"@en ;
                                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "txt" ;
                                       <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-core#" ;
                                       rdfs:comment "Fibre, yarn and fabric are modelled as textile products. When one product is intended to be incorporated into another, dpp:isComponentOf expresses the component role; the ontology does not create a separate intermediate-product class."@en ,
                                                    "Named fibre types and textile apparel product categories are represented as SKOS concepts because they are controlled classification values rather than product subclasses."@en ,
                                                    "Product types such as medical-device, PPE or toy textile apparel remain textile apparel by product nature but are annotated as excluded from the JRC preparatory study scope where appropriate."@en ,
                                                    "These notations are stable local identifiers intended to support data exchange, mapping and validation."@en ;
                                       rdfs:label "EU DPP Textile Core Ontology"@en ;
                                       owl:versionInfo "Version 1.1.2" .

