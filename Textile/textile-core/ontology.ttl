###  https://w3id.org/eudpp/textile-core#TextileFibre
:TextileFibre rdf:type owl:Class ;
              rdfs:subClassOf :TextileProduct ;
              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
              rdfs:comment "Unit of matter characterised by flexibility, fineness and a high ratio of length to maximum transverse dimension, suitable for textile applications."@en ;
              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
              rdfs:label "Textile fibre"@en ;
              <https://w3id.org/eudpp/textile-connector#modellingNote> "TextileFibre is modelled as a textile product when it is represented as an identifiable fibre batch or traceability object. Its incorporation into yarn, fabric or another product is represented with dpp:isComponentOf."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, relevant section, printed page 14, lines 154-160."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-core#TextileProduct
:TextileProduct rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/eudpp#Product> ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Any raw, semi-worked, worked, semi-manufactured, manufactured, semi-made-up or made-up product which is exclusively composed of textile fibres, as well as a product containing at least 80% textile fibres by weight."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                rdfs:label "Textile product"@en ;
                <https://w3id.org/eudpp/textile-connector#modellingNote> "TextileProduct is the broad textile product class. It includes final products and products serving an intermediate or component role when they are represented as product-like traceability resources. Identification constraints should be specified by SHACL according to product granularity rather than imposed uniformly on every TextileProduct."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, relevant section, printed page 14, lines 161-166."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


