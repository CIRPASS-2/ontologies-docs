<https://w3id.org/eudpp/textile-connector#sourceType> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-core#defaultStudyScopeStatus
:defaultStudyScopeStatus rdf:type owl:AnnotationProperty ;
                         <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                         rdfs:comment "Annotation property used on product-type classes to document their default status with respect to a study or regulatory modelling scope."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                         rdfs:label "default study scope status"@en ;
                         <https://w3id.org/eudpp/textile-connector#modellingNote> "This is an annotation-level modelling aid for product types. Instance-level scope status, if needed, should be represented with a data validation pattern or a dedicated object property in a context module."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-core#jrcExclusionReason
:jrcExclusionReason rdf:type owl:AnnotationProperty ;
                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                    rdfs:comment "Annotation specifying the reason why a textile product class or category is excluded from the JRC preparatory study scope."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                    rdfs:label "JRC exclusion reason"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> ;
                    rdfs:range xsd:string .


###  https://w3id.org/eudpp/textile-core#jrcScopeCondition
:jrcScopeCondition rdf:type owl:AnnotationProperty ;
                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                   rdfs:comment "Annotation specifying a textual condition governing inclusion of a textile product class or category in the JRC preparatory study scope."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                   rdfs:label "JRC scope condition"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> ;
                   rdfs:range xsd:string .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp/textile-core#hasFibreComponent
:hasFibreComponent rdf:type owl:ObjectProperty ;
                   rdfs:domain :TextileProduct ;
                   rdfs:range :FibreTypeConcept ;
                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                   rdfs:comment "Relates a textile product to a textile fibre type concept that is part of its composition."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                   rdfs:label "has fibre component"@en ;
                   <https://w3id.org/eudpp/textile-connector#modellingNote> "Non-quantitative relation indicating that a textile product contains a given textile fibre type. This property is useful when the presence of a fibre type is known but its quantitative share is not represented."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-core#hasFibreCompositionComponent
:hasFibreCompositionComponent rdf:type owl:ObjectProperty ;
                              rdfs:domain :TextileProduct ;
                              rdfs:range :FibreCompositionComponent ;
                              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                              rdfs:comment "Relates a textile product to a structured fibre composition component."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                              rdfs:label "has fibre composition component"@en ;
                              <https://w3id.org/eudpp/textile-connector#modellingNote> "No subproperty alignment with dpp:hasMaterialType is asserted because the MAT property links a MaterialOfComposition to an OWL MaterialType, while this textile property links a TextileProduct to a structured FibreCompositionComponent that uses a SKOS fibre-type value."@en ,
                                                                                       "Preferred relation for representing the declared fibre composition of a textile product, including the fibre type and its quantitative share."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-core#hasFibreMassFraction
:hasFibreMassFraction rdf:type owl:ObjectProperty ;
                      rdfs:domain :FibreCompositionComponent ;
                      rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                      <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                      rdfs:comment "Relates a fibre composition component to the mass fraction of that fibre in the textile product."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                      rdfs:label "has fibre mass fraction"@en ;
                      <https://w3id.org/eudpp/textile-connector#modellingNote> "Values use a 0-1 mass-fraction scale and the dimensionless SI unit units:one. Cardinality, range and sum rules will be defined in SHACL."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-core#hasFibreType
:hasFibreType rdf:type owl:ObjectProperty ;
              rdfs:domain :FibreCompositionComponent ;
              rdfs:range :FibreTypeConcept ;
              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
              rdfs:comment "Relates a fibre composition component to the textile fibre type concept it describes."@en ;
              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
              rdfs:label "has fibre type"@en ;
              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-core#hasNonTextileMaterialMassFraction
:hasNonTextileMaterialMassFraction rdf:type owl:ObjectProperty ;
                                   rdfs:domain :TextileProduct ;
                                   rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                   rdfs:comment "Relates a textile product to the mass fraction represented by non-textile materials."@en ;
                                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                                   rdfs:label "has non-textile material mass fraction"@en ;
                                   <https://w3id.org/eudpp/textile-connector#modellingNote> "Values use a 0-1 mass-fraction scale and the dimensionless SI unit units:one. Cardinality, range and sum rules will be defined in SHACL."@en ;
                                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
                                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-core#hasStudyScopeStatus
:hasStudyScopeStatus rdf:type owl:ObjectProperty ;
                     rdfs:domain :TextileProduct ;
                     rdfs:range :StudyScopeStatusConcept ;
                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                     rdfs:comment "Relates a textile product instance to a controlled study scope status concept."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                     rdfs:label "has study scope status"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-core#hasTextileApparelProductType
:hasTextileApparelProductType rdf:type owl:ObjectProperty ;
                              rdfs:domain :TextileApparel ;
                              rdfs:range :TextileApparelProductTypeConcept ;
                              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                              rdfs:comment "Relates a textile apparel product to a controlled textile apparel product type concept."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                              rdfs:label "has textile apparel product type"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-core#hasTextileFibreMassFraction
:hasTextileFibreMassFraction rdf:type owl:ObjectProperty ;
                             rdfs:domain <https://w3id.org/eudpp#Product> ;
                             rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                             rdfs:comment "Relates a product to the total mass fraction represented by textile fibres."@en ;
                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                             rdfs:label "has textile fibre mass fraction"@en ;
                             <https://w3id.org/eudpp/textile-connector#modellingNote> "Values use a 0-1 mass-fraction scale and the dimensionless SI unit units:one. Cardinality, range and sum rules will be defined in SHACL."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  https://w3id.org/eudpp#MaterialOfComposition
<https://w3id.org/eudpp#MaterialOfComposition> rdf:type owl:Class .


###  https://w3id.org/eudpp#Product
<https://w3id.org/eudpp#Product> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-connector#QuantitativeValue
<https://w3id.org/eudpp/textile-connector#QuantitativeValue> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-core#ElectronicTextile
:ElectronicTextile rdf:type owl:Class ;
                   rdfs:subClassOf :TextileProduct ;
                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                   rdfs:comment "Textile-based system that exhibits an intended and exploitable response to changes in its surroundings or to an external signal or input."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                   rdfs:label "Electronic textile"@en ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "E-textile"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-477."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                   :defaultStudyScopeStatus <https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope> ;
                   :jrcExclusionReason "Excluded because electronic textiles are very different from textile apparel in terms of function and physical characteristics."@en .


###  https://w3id.org/eudpp/textile-core#Fabric
:Fabric rdf:type owl:Class ;
        rdfs:subClassOf :TextileProduct ;
        <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
        rdfs:comment "Textile product made from yarns, fibres or filaments and intended to be incorporated into another textile product or used in further manufacturing."@en ;
        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
        rdfs:label "Fabric"@en ;
        <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric is modelled as a textile product. When a fabric is incorporated into another product, the instance-level relation dpp:isComponentOf expresses that role; no separate intermediate-product class is required."@en ;
        <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.2.2, printed page 25, lines 486-492; JRC Preparatory Study, Section 3.3.1, printed page 27, lines 536-546."@en ;
        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-core#FibreCompositionComponent
:FibreCompositionComponent rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/eudpp#MaterialOfComposition> ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasFibreMassFraction ;
                                             owl:someValuesFrom <https://w3id.org/eudpp/textile-connector#QuantitativeValue>
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasFibreType ;
                                             owl:someValuesFrom :FibreTypeConcept
                                           ] ;
                           <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                           rdfs:comment "A structured component of a textile product fibre composition, specifying a fibre type and its quantitative share in the product."@en ;
                           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
                           rdfs:label "Fibre composition component"@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709."@en ;
