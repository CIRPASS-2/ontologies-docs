                   :defaultStudyScopeStatus <https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope> ;
                   :jrcExclusionReason "Excluded because textile apparel identified as a toy is outside the selected scope."@en .


###  https://w3id.org/eudpp/textile-core#Yarn
:Yarn rdf:type owl:Class ;
      rdfs:subClassOf :TextileProduct ;
      <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
      rdfs:comment "Textile product consisting of fibres assembled into a continuous strand and intended to be incorporated into fabric or another textile product."@en ;
      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-core> ;
      rdfs:label "Yarn"@en ;
      <https://w3id.org/eudpp/textile-connector#modellingNote> "Yarn is modelled as a textile product. Its role as an input or component of a fabric or another product is represented with dpp:isComponentOf."@en ;
      <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.2.2, printed page 25, lines 486-492; JRC Preparatory Study, Section 3.3.1, printed page 27, lines 536-546."@en ;
      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


