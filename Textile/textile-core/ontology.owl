<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/textile-core#"
     xml:base="https://w3id.org/eudpp/textile-core"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:textile-core="https://w3id.org/eudpp/textile-core#"
     xmlns:textile-connector="https://w3id.org/eudpp/textile-connector#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-core">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-core/1.1.2"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-mat-mireot"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Textile Core Ontology. Version 1.1.2.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:created>
        <terms:creator xml:lang="en">Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Ontology module for representing core textile product data relevant to EU Digital Product Passports, including textile product classes, textile apparel scope concepts, fibre composition structures, and controlled SKOS vocabularies for textile apparel product types and fibre types aligned with the JRC preparatory study on textiles.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <terms:title xml:lang="en">EU DPP Textile Core Ontology</terms:title>
        <vann:preferredNamespacePrefix>txt</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-core#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Fibre, yarn and fabric are modelled as textile products. When one product is intended to be incorporated into another, dpp:isComponentOf expresses the component role; the ontology does not create a separate intermediate-product class.</rdfs:comment>
        <rdfs:comment xml:lang="en">Named fibre types and textile apparel product categories are represented as SKOS concepts because they are controlled classification values rather than product subclasses.</rdfs:comment>
        <rdfs:comment xml:lang="en">Product types such as medical-device, PPE or toy textile apparel remain textile apparel by product nature but are annotated as excluded from the JRC preparatory study scope where appropriate.</rdfs:comment>
        <rdfs:comment xml:lang="en">These notations are stable local identifiers intended to support data exchange, mapping and validation.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Textile Core Ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
    </owl:Ontology>
    


