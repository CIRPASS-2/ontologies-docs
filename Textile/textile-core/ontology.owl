    <!-- https://w3id.org/eudpp/textile-core#hasFibreComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-core#hasFibreComponent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#FibreTypeConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile product to a textile fibre type concept that is part of its composition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">has fibre component</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Non-quantitative relation indicating that a textile product contains a given textile fibre type. This property is useful when the presence of a fibre type is known but its quantitative share is not represented.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-core#hasFibreCompositionComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-core#hasFibreCompositionComponent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#FibreCompositionComponent"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile product to a structured fibre composition component.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">has fibre composition component</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">No subproperty alignment with dpp:hasMaterialType is asserted because the MAT property links a MaterialOfComposition to an OWL MaterialType, while this textile property links a TextileProduct to a structured FibreCompositionComponent that uses a SKOS fibre-type value.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Preferred relation for representing the declared fibre composition of a textile product, including the fibre type and its quantitative share.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-core#hasFibreMassFraction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-core#hasFibreMassFraction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#FibreCompositionComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a fibre composition component to the mass fraction of that fibre in the textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">has fibre mass fraction</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Values use a 0-1 mass-fraction scale and the dimensionless SI unit units:one. Cardinality, range and sum rules will be defined in SHACL.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-core#hasFibreType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-core#hasFibreType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#FibreCompositionComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#FibreTypeConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a fibre composition component to the textile fibre type concept it describes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">has fibre type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-core#hasNonTextileMaterialMassFraction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-core#hasNonTextileMaterialMassFraction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile product to the mass fraction represented by non-textile materials.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">has non-textile material mass fraction</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Values use a 0-1 mass-fraction scale and the dimensionless SI unit units:one. Cardinality, range and sum rules will be defined in SHACL.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-core#hasStudyScopeStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-core#hasStudyScopeStatus">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#StudyScopeStatusConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile product instance to a controlled study scope status concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">has study scope status</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-core#hasTextileApparelProductType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-core#hasTextileApparelProductType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileApparel"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#TextileApparelProductTypeConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile apparel product to a controlled textile apparel product type concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">has textile apparel product type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-core#hasTextileFibreMassFraction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-core#hasTextileFibreMassFraction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a product to the total mass fraction represented by textile fibres.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">has textile fibre mass fraction</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Values use a 0-1 mass-fraction scale and the dimensionless SI unit units:one. Cardinality, range and sum rules will be defined in SHACL.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


