    <!-- https://w3id.org/eudpp/textile-core#ElectronicTextile -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#ElectronicTextile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile-based system that exhibits an intended and exploitable response to changes in its surroundings or to an external signal or input.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Electronic textile</rdfs:label>
        <skos:altLabel xml:lang="en">E-textile</skos:altLabel>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-477.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <jrcExclusionReason xml:lang="en">Excluded because electronic textiles are very different from textile apparel in terms of function and physical characteristics.</jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#Fabric -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#Fabric">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile product made from yarns, fibres or filaments and intended to be incorporated into another textile product or used in further manufacturing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Fabric</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Fabric is modelled as a textile product. When a fabric is incorporated into another product, the instance-level relation dpp:isComponentOf expresses that role; no separate intermediate-product class is required.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 486-492; JRC Preparatory Study, Section 3.3.1, printed page 27, lines 536-546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#FibreCompositionComponent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#FibreCompositionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-core#hasFibreMassFraction"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-core#hasFibreType"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/eudpp/textile-core#FibreTypeConcept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A structured component of a textile product fibre composition, specifying a fibre type and its quantitative share in the product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Fibre composition component</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 2, printed page 14, lines 161-166; JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535; JRC Preparatory Study, Section 4.1, printed page 33, lines 703-709.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#FibreTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#FibreTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled value for textile fibre type in a fibre composition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Fibre type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#MedicalDeviceTextileApparel -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#MedicalDeviceTextileApparel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileApparel"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile apparel identified as a medical device or as an accessory for a medical device in accordance with Regulation (EU) 2017/745.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Medical device textile apparel</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-481.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <jrcExclusionReason xml:lang="en">Excluded because textile apparel identified as a medical device or as an accessory for a medical device is outside the selected scope.</jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#PPETextileApparel -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#PPETextileApparel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileApparel"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile apparel identified as personal protective equipment in accordance with Regulation (EU) 2016/425.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">PPE textile apparel</rdfs:label>
        <skos:altLabel xml:lang="en">Personal protective equipment textile apparel</skos:altLabel>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-479.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <jrcExclusionReason xml:lang="en">Excluded because textile apparel identified as personal protective equipment is outside the selected scope.</jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#ReusableTextileAbsorbentHygieneProduct -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#ReusableTextileAbsorbentHygieneProduct">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Reusable textile absorbent hygiene product considered a technical textile and excluded from scope.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Reusable textile absorbent hygiene product</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 495-506; JRC Preparatory Study, relevant section, printed page 19, lines 275-279; JRC Preparatory Study, relevant section, Table 3, printed page 19; caption line 275.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <jrcExclusionReason xml:lang="en">Excluded because reusable textile absorbent hygiene products perform a different function from textile apparel and are considered technical textiles.</jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#SmartTextile -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#SmartTextile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile able to sense and react to environmental conditions or external stimuli through incorporated sensors or responsive components.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Smart textile</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-474.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <jrcExclusionReason xml:lang="en">Excluded because smart textiles are very different from textile apparel in terms of function and physical characteristics.</jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#StudyScopeStatusConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#StudyScopeStatusConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept used to indicate whether a textile product type is included in, excluded from, or otherwise qualified with respect to a study or regulatory modelling scope.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Study scope status concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#TextileApparel -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileApparel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile products that aim to cover the body with everything except footwear, including clothing and clothing accessories worn to clothe, adorn, shield, provide comfort, or express identity and belonging.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile apparel</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">TextileApparel is a final textile product category for apparel and apparel accessories. The supplied EU DPP Core snapshot does not declare a separate FinalProduct class, so final-product status remains a local textile distinction under dpp:Product. It is narrower than TextileProduct and should not be confused with the whole textile product domain.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 14, lines 167-170; JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#includedInJRCPreparatoryStudyScope"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#TextileApparelProductTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileApparelProductTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept used as a controlled value for classifying textile apparel product types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile apparel product type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#TextileCleaningProduct -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileCleaningProduct">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile cleaning product considered a technical textile and excluded from scope because its function differs from apparel.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile cleaning product</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 495-505; JRC Preparatory Study, relevant section, printed page 19, lines 275-279; JRC Preparatory Study, relevant section, Table 3, printed page 19; caption line 275.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <jrcExclusionReason xml:lang="en">Excluded because textile cleaning products perform a different function from textile apparel and are considered technical textiles.</jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#TextileFibre -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileFibre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Unit of matter characterised by flexibility, fineness and a high ratio of length to maximum transverse dimension, suitable for textile applications.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile fibre</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">TextileFibre is modelled as a textile product when it is represented as an identifiable fibre batch or traceability object. Its incorporation into yarn, fabric or another product is represented with dpp:isComponentOf.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 14, lines 154-160.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#TextileProduct -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#TextileProduct">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Product"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Any raw, semi-worked, worked, semi-manufactured, manufactured, semi-made-up or made-up product which is exclusively composed of textile fibres, as well as a product containing at least 80% textile fibres by weight.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile product</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">TextileProduct is the broad textile product class. It includes final products and products serving an intermediate or component role when they are represented as product-like traceability resources. Identification constraints should be specified by SHACL according to product granularity rather than imposed uniformly on every TextileProduct.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 14, lines 161-166.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#ToyTextileApparel -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#ToyTextileApparel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileApparel"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile apparel identified as a toy in accordance with Directive 2009/48/EC.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Toy textile apparel</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 469-482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <defaultStudyScopeStatus rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <jrcExclusionReason xml:lang="en">Excluded because textile apparel identified as a toy is outside the selected scope.</jrcExclusionReason>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-core#Yarn -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-core#Yarn">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile product consisting of fibres assembled into a continuous strand and intended to be incorporated into fabric or another textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Yarn</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Yarn is modelled as a textile product. Its role as an input or component of a fabric or another product is represented with dpp:isComponentOf.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.2, printed page 25, lines 486-492; JRC Preparatory Study, Section 3.3.1, printed page 27, lines 536-546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/textile-codelists#FibreTypeScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-codelists#FibreTypeScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled vocabulary of textile fibre types used to describe textile fibre composition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile fibre type scheme</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#chemicalFibre"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#naturalOriginFibre"/>
        <skos:prefLabel xml:lang="en">Textile fibre type scheme</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed page 26, lines 522-535.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-codelists#StudyScopeStatusScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-codelists#StudyScopeStatusScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled vocabulary for representing the status of a textile product type with respect to the JRC preparatory study scope.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Study scope status scheme</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#excludedFromJRCPreparatoryStudyScope"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#includedInJRCPreparatoryStudyScope"/>
        <skos:prefLabel xml:lang="en">Study scope status scheme</skos:prefLabel>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.2, printed pages 25-26, lines 469-506.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-codelists#TextileApparelProductTypeScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-codelists#TextileApparelProductTypeScheme">
