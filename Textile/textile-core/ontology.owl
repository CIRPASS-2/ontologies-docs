        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled vocabulary representing the textile apparel categories of JRC Table 7. The JRC categories are aligned with the PEFCR Apparel and Footwear work but this scheme does not claim identity with the complete PEFCR segmentation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <rdfs:label xml:lang="en">Textile apparel product type scheme</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#dressSkirtOrJumpsuit"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#jacketOrCoat"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#leggingStockingTightOrSock"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#pantsOrShorts"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#shirtOrBlouse"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#sweaterOrMidLayer"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#swimwear"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#tShirt"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#textileApparelAccessory"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#underwear"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-codelists#workwear"/>
        <skos:prefLabel xml:lang="en">Textile apparel product type scheme</skos:prefLabel>
        <textile-connector:modellingNote xml:lang="en">A single textile product-type scheme is retained to avoid duplicating JRC and PEFCR classifications. External PEFCR identifiers may be mapped when a stable authoritative classification is selected.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.2.1, printed pages 24-25, lines 443-468; JRC Preparatory Study, Section 3.2.1, Table 7, printed page 24; caption line 450.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:NamedIndividual>
    


