}, {
  "@id" : "https://w3id.org/eudpp/textile-associated-materials",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Associated Materials Ontology. Version 1.1.2."
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-03-06"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@language" : "en",
    "@value" : "Elio Hbeich"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Ontology module for non-textile components, packaging materials, textile chemical substances and controlled chemical classifications associated with textile products. Fibre composition remains in Textile Core, while regulatory qualification and occurrence of substances of concern belong to the Textile SoC module."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-03-06"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-16"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Associated Materials Ontology"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "txtam"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/eudpp/textile-associated-materials#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Chemical use category and chemical function are modelled as separate SKOS classification axes. This avoids treating a chemical function such as dye, biocide or softener as equivalent to whether the substance is intended to remain in the final article."
  }, {
    "@language" : "en",
    "@value" : "The module reuses soc:Substance for substance identity and the MAT MaterialOfComposition pattern where material occurrences are needed. It does not classify a substance as a substance of concern."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Associated Materials Ontology"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-core"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-mat-mireot"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-soc-mireot"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/eudpp/textile-associated-materials/1.1.2"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "Version 1.1.2"
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "JRC Textile Preparatory Study, Section 3.3.1, pages 27-29, lines 536-547; Section 3.3.2, pages 29-30, lines 575-593; Section 12.3, page 226, lines 6424-6455; Annex 13.8.3, Table 168, page 459, from line 10991."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#ontologyModule"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A physical component integrated into a textile product that is not itself part of the primary textile fibre composition, such as a button, zipper or sequin."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-associated-materials"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Non-textile component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/soc#ProductComponent"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "The alignment with soc:ProductComponent is owned here because this module defines the non-textile component class. It does not imply that every component contains a substance of concern."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6855-6861; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#adaptedDefinition"
  } ]
