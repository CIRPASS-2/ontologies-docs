        <rdfs:comment xml:lang="en">A controlled concept describing whether a chemical is intended to act during processing, remain for product performance, or occur unintentionally.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Textile chemical use category concept</rdfs:label>
