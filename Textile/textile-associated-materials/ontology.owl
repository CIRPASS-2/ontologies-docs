    <!-- https://w3id.org/eudpp/textile-associated-materials#hasComponentMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-associated-materials#hasComponentMaterial">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-mat-mireot"/>
        <rdfs:comment xml:lang="en">Relates a non-textile component to a material occurrence from which the component is made.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">has component material</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">EU DPP MAT module v1.0.2, dpp:MaterialOfComposition; JRC Annex 13.8.3, Table 168, page 459, from line 10991 (details/accessories with material type)</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#externalReuse"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#hasNonTextileComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-associated-materials#hasNonTextileComponent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile product to a non-textile component physically integrated into it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">has non-textile component</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The property is owned by Textile Associated Materials so that Textile Core remains independent of this extension module.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#hasNonTextileComponentType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-associated-materials#hasNonTextileComponentType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponentTypeConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a non-textile component to a controlled concept describing its component type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">has non-textile component type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#hasPackagingMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-associated-materials#hasPackagingMaterial">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile product to a packaging-material occurrence used for its packaging, transport, storage or delivery.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">has packaging material</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The property is owned by Textile Associated Materials so that Textile Core remains independent of this extension module.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#hasPackagingMaterialType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-associated-materials#hasPackagingMaterialType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#PackagingMaterialTypeConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a packaging material occurrence to a controlled concept describing the material type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">has packaging material type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#hasTextileChemicalFunction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-associated-materials#hasTextileChemicalFunction">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile chemical substance to a controlled concept describing its function in textile manufacturing, treatment, finishing or functionalisation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">has textile chemical function</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed page 226, lines 6437-6455.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#hasTextileChemicalUseCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-associated-materials#hasTextileChemicalUseCategory">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a textile chemical substance to a controlled category describing whether it is used as a process chemical, a performance chemical or occurs unintentionally.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">has textile chemical use category</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3, printed page 226, lines 6428-6455.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


