    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    


    <!-- https://w3id.org/eudpp#MaterialOfComposition -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialOfComposition"/>
    


    <!-- https://w3id.org/eudpp/soc#ProductComponent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/soc#ProductComponent"/>
    


    <!-- https://w3id.org/eudpp/soc#Substance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/soc#Substance"/>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#ProductComponent"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A physical component integrated into a textile product that is not itself part of the primary textile fibre composition, such as a button, zipper or sequin.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Non-textile component</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">The alignment with soc:ProductComponent is owned here because this module defines the non-textile component class. It does not imply that every component contains a substance of concern.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6855-6861; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#NonTextileComponentTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponentTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A controlled SKOS concept used to classify the functional type of a non-textile component.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Non-textile component type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6855-6861.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A material occurrence used for the packaging, transport, storage or delivery of a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Packaging material</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">PackagingMaterial is aligned as a subclass of dpp:MaterialOfComposition. The textile-specific type property remains separate because its range is a SKOS controlled concept, while dpp:hasMaterialType ranges over an OWL class.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#PackagingMaterialTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#PackagingMaterialTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A controlled SKOS concept used to classify a packaging material occurrence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Packaging material type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A controlled concept describing the technical function performed by a chemical in textile production or treatment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Textile chemical function concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed page 226, lines 6437-6455.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/soc#Substance"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">A substance used or occurring in a textile manufacturing, treatment, finishing, coating or related textile-production context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <rdfs:label xml:lang="en">Textile chemical substance</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">This class describes textile use context only. It does not assert that the substance remains in the final product or qualifies as a substance of concern.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed pages 225-226, lines 6424-6455.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept -->


