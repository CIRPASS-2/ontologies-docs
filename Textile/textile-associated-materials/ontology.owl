<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/textile-associated-materials#"
     xml:base="https://w3id.org/eudpp/textile-associated-materials"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:textile-connector="https://w3id.org/eudpp/textile-connector#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-associated-materials">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-associated-materials/1.1.2"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-mat-mireot"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-soc-mireot"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Textile Associated Materials Ontology. Version 1.1.2.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:created>
        <terms:creator xml:lang="en">Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Ontology module for non-textile components, packaging materials, textile chemical substances and controlled chemical classifications associated with textile products. Fibre composition remains in Textile Core, while regulatory qualification and occurrence of substances of concern belong to the Textile SoC module.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:title xml:lang="en">EU DPP Textile Associated Materials Ontology</terms:title>
        <vann:preferredNamespacePrefix>txtam</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-associated-materials#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Chemical use category and chemical function are modelled as separate SKOS classification axes. This avoids treating a chemical function such as dye, biocide or softener as equivalent to whether the substance is intended to remain in the final article.</rdfs:comment>
        <rdfs:comment xml:lang="en">The module reuses soc:Substance for substance identity and the MAT MaterialOfComposition pattern where material occurrences are needed. It does not classify a substance as a substance of concern.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Textile Associated Materials Ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
        <textile-connector:sourceLocator xml:lang="en">JRC Textile Preparatory Study, Section 3.3.1, pages 27-29, lines 536-547; Section 3.3.2, pages 29-30, lines 575-593; Section 12.3, page 226, lines 6424-6455; Annex 13.8.3, Table 168, page 459, from line 10991.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#ontologyModule"/>
    </owl:Ontology>
    


