@prefix : <https://w3id.org/eudpp/textile-associated-materials#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-associated-materials#> .

<https://w3id.org/eudpp/textile-associated-materials> rdf:type owl:Ontology ;
                                                       owl:versionIRI <https://w3id.org/eudpp/textile-associated-materials/1.1.2> ;
                                                       owl:imports <https://w3id.org/eudpp/textile-connector> ,
                                                                   <https://w3id.org/eudpp/textile-core> ,
                                                                   <https://w3id.org/eudpp/textile-mat-mireot> ,
                                                                   <https://w3id.org/eudpp/textile-soc-mireot> ;
                                                       <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Associated Materials Ontology. Version 1.1.2."@en ;
                                                       <http://purl.org/dc/terms/created> "2026-03-06"^^xsd:date ;
                                                       <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                                       <http://purl.org/dc/terms/description> "Ontology module for non-textile components, packaging materials, textile chemical substances and controlled chemical classifications associated with textile products. Fibre composition remains in Textile Core, while regulatory qualification and occurrence of substances of concern belong to the Textile SoC module."@en ;
                                                       <http://purl.org/dc/terms/issued> "2026-03-06"^^xsd:date ;
                                                       <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                       <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                                       <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                                       <http://purl.org/dc/terms/title> "EU DPP Textile Associated Materials Ontology"@en ;
                                                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtam" ;
                                                       <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-associated-materials#" ;
                                                       rdfs:comment "Chemical use category and chemical function are modelled as separate SKOS classification axes. This avoids treating a chemical function such as dye, biocide or softener as equivalent to whether the substance is intended to remain in the final article."@en ,
                                                                    "The module reuses soc:Substance for substance identity and the MAT MaterialOfComposition pattern where material occurrences are needed. It does not classify a substance as a substance of concern."@en ;
                                                       rdfs:label "EU DPP Textile Associated Materials Ontology"@en ;
                                                       owl:versionInfo "Version 1.1.2" ;
                                                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Textile Preparatory Study, Section 3.3.1, pages 27-29, lines 536-547; Section 3.3.2, pages 29-30, lines 575-593; Section 12.3, page 226, lines 6424-6455; Annex 13.8.3, Table 168, page 459, from line 10991."@en ;
                                                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#ontologyModule> .

