#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp/textile-associated-materials#hasComponentMaterial
:hasComponentMaterial rdf:type owl:ObjectProperty ;
                      rdfs:domain :NonTextileComponent ;
                      rdfs:range <https://w3id.org/eudpp#MaterialOfComposition> ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-mat-mireot> ;
                      rdfs:comment "Relates a non-textile component to a material occurrence from which the component is made."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                      rdfs:label "has component material"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "EU DPP MAT module v1.0.2, dpp:MaterialOfComposition; JRC Annex 13.8.3, Table 168, page 459, from line 10991 (details/accessories with material type)"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#externalReuse> .


###  https://w3id.org/eudpp/textile-associated-materials#hasNonTextileComponent
:hasNonTextileComponent rdf:type owl:ObjectProperty ;
                        rdfs:domain <https://w3id.org/eudpp/textile-core#TextileProduct> ;
                        rdfs:range :NonTextileComponent ;
                        <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                          <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Relates a textile product to a non-textile component physically integrated into it."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                        rdfs:label "has non-textile component"@en ;
                        <https://w3id.org/eudpp/textile-connector#modellingNote> "The property is owned by Textile Associated Materials so that Textile Core remains independent of this extension module."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 3.3.1, Table 8, printed pages 27-29; table caption at line 546."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-associated-materials#hasNonTextileComponentType
:hasNonTextileComponentType rdf:type owl:ObjectProperty ;
                            rdfs:domain :NonTextileComponent ;
                            rdfs:range :NonTextileComponentTypeConcept ;
                            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                            rdfs:comment "Relates a non-textile component to a controlled concept describing its component type."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                            rdfs:label "has non-textile component type"@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-associated-materials#hasPackagingMaterial
:hasPackagingMaterial rdf:type owl:ObjectProperty ;
                      rdfs:domain <https://w3id.org/eudpp/textile-core#TextileProduct> ;
                      rdfs:range :PackagingMaterial ;
                      <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                        <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates a textile product to a packaging-material occurrence used for its packaging, transport, storage or delivery."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                      rdfs:label "has packaging material"@en ;
                      <https://w3id.org/eudpp/textile-connector#modellingNote> "The property is owned by Textile Associated Materials so that Textile Core remains independent of this extension module."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .


###  https://w3id.org/eudpp/textile-associated-materials#hasPackagingMaterialType
:hasPackagingMaterialType rdf:type owl:ObjectProperty ;
                          rdfs:domain :PackagingMaterial ;
                          rdfs:range :PackagingMaterialTypeConcept ;
                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                          rdfs:comment "Relates a packaging material occurrence to a controlled concept describing the material type."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                          rdfs:label "has packaging material type"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-associated-materials#hasTextileChemicalFunction
:hasTextileChemicalFunction rdf:type owl:ObjectProperty ;
                            rdfs:domain :TextileChemicalSubstance ;
                            rdfs:range :TextileChemicalFunctionConcept ;
                            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                            rdfs:comment "Relates a textile chemical substance to a controlled concept describing its function in textile manufacturing, treatment, finishing or functionalisation."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                            rdfs:label "has textile chemical function"@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed page 226, lines 6437-6455."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-associated-materials#hasTextileChemicalUseCategory
:hasTextileChemicalUseCategory rdf:type owl:ObjectProperty ;
                               rdfs:domain :TextileChemicalSubstance ;
                               rdfs:range :TextileChemicalUseCategoryConcept ;
                               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                               rdfs:comment "Relates a textile chemical substance to a controlled category describing whether it is used as a process chemical, a performance chemical or occurs unintentionally."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                               rdfs:label "has textile chemical use category"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 12.3, printed page 226, lines 6428-6455."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  https://w3id.org/eudpp#MaterialOfComposition
<https://w3id.org/eudpp#MaterialOfComposition> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#ProductComponent
<https://w3id.org/eudpp/soc#ProductComponent> rdf:type owl:Class .


###  https://w3id.org/eudpp/soc#Substance
<https://w3id.org/eudpp/soc#Substance> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent
:NonTextileComponent rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/eudpp/soc#ProductComponent> ;
                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                     rdfs:comment "A physical component integrated into a textile product that is not itself part of the primary textile fibre composition, such as a button, zipper or sequin."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                     rdfs:label "Non-textile component"@en ;
                     <https://w3id.org/eudpp/textile-connector#modellingNote> "The alignment with soc:ProductComponent is owned here because this module defines the non-textile component class. It does not imply that every component contains a substance of concern."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.1, printed pages 27, 29, lines 536-547; JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6855-6861; JRC Preparatory Study, Section 3.3.1, Table 8, printed page 27; caption line 546."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-associated-materials#NonTextileComponentTypeConcept
:NonTextileComponentTypeConcept rdf:type owl:Class ;
                                rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                rdfs:comment "A controlled SKOS concept used to classify the functional type of a non-textile component."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                                rdfs:label "Non-textile component type concept"@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6855-6861."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-associated-materials#PackagingMaterial
:PackagingMaterial rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/eudpp#MaterialOfComposition> ;
                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                   rdfs:comment "A material occurrence used for the packaging, transport, storage or delivery of a textile product."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                   rdfs:label "Packaging material"@en ;
                   <https://w3id.org/eudpp/textile-connector#modellingNote> "PackagingMaterial is aligned as a subclass of dpp:MaterialOfComposition. The textile-specific type property remains separate because its range is a SKOS controlled concept, while dpp:hasMaterialType ranges over an OWL class."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-associated-materials#PackagingMaterialTypeConcept
:PackagingMaterialTypeConcept rdf:type owl:Class ;
                              rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                              rdfs:comment "A controlled SKOS concept used to classify a packaging material occurrence."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                              rdfs:label "Packaging material type concept"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.8.3, Table 168, printed page 459; table caption at line 10991."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-associated-materials#TextileChemicalFunctionConcept
:TextileChemicalFunctionConcept rdf:type owl:Class ;
                                rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                rdfs:comment "A controlled concept describing the technical function performed by a chemical in textile production or treatment."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                                rdfs:label "Textile chemical function concept"@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed page 226, lines 6437-6455."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-associated-materials#TextileChemicalSubstance
:TextileChemicalSubstance rdf:type owl:Class ;
                          rdfs:subClassOf <https://w3id.org/eudpp/soc#Substance> ;
                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                          rdfs:comment "A substance used or occurring in a textile manufacturing, treatment, finishing, coating or related textile-production context."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                          rdfs:label "Textile chemical substance"@en ;
                          <https://w3id.org/eudpp/textile-connector#modellingNote> "This class describes textile use context only. It does not assert that the substance remains in the final product or qualifies as a substance of concern."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed pages 225-226, lines 6424-6455."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept
:TextileChemicalUseCategoryConcept rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                   rdfs:comment "A controlled concept describing whether a chemical is intended to act during processing, remain for product performance, or occur unintentionally."@en ;
                                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-associated-materials> ;
                                   rdfs:label "Textile chemical use category concept"@en ;
                                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 12.3, printed page 226, lines 6428-6455."@en ;
                                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-core#TextileProduct
<https://w3id.org/eudpp/textile-core#TextileProduct> rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/eudpp/textile-associated-materials-codelists#NonTextileComponentTypeScheme
<https://w3id.org/eudpp/textile-associated-materials-codelists#NonTextileComponentTypeScheme> rdf:type owl:NamedIndividual ,
                                                                                                       <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                                                                                              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                                                                              rdfs:comment "Controlled vocabulary of functional types of non-textile components integrated into textile products."@en ;
