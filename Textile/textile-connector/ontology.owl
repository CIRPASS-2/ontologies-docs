<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/textile-connector#"
     xml:base="https://w3id.org/eudpp/textile-connector"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:textile-connector="https://w3id.org/eudpp/textile-connector#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-connector">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-connector/1.1.2"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-si-mireot"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Textile Connector Ontology. Version 1.1.2.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:created>
        <terms:creator xml:lang="en">Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Shared foundation and connector module for the EU DPP textile ontology network. It defines the common quantitative-value and reference-period patterns, the shared product-technology-level vocabulary, controlled provenance vocabularies, editorial annotations and weak cross-module annotation relations. Domain-specific operational relations remain in their domain modules.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <terms:title xml:lang="en">EU DPP Textile Connector Ontology</terms:title>
        <vann:preferredNamespacePrefix>txtcon</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-connector#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Operational instance-level relations belong in the relevant domain module and are validated through SHACL.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation polarity is not represented as a direct annotation on a source class because one class may have several outgoing weak relations with different directions. Edge-level polarity and evidence remain in the canonical relation register until a statement-level representation is adopted.</rdfs:comment>
        <rdfs:comment xml:lang="en">The BC/BAT/BNAT product-technology axis is shared here because it is used by more than one textile aspect module. Aspect-specific configurations remain in their own module and map to the shared level rather than duplicating it.</rdfs:comment>
        <rdfs:comment xml:lang="en">The common ReferencePeriod pattern is infrastructure only; domain modules retain their own hasReferencePeriod relations.</rdfs:comment>
        <rdfs:comment xml:lang="en">The connector is intentionally dependency-light: it imports the BIPM SI Reference Point but no textile domain module. SKOS terms are referenced directly through their standard W3C IRIs.</rdfs:comment>
        <rdfs:comment xml:lang="en">The quantitative-value pattern links numerical values to BIPM SI measurement-unit and quantity-kind resources without recreating SI terms.</rdfs:comment>
        <rdfs:comment xml:lang="en">The typical relation properties are annotation properties for contextual class-level or concept-level statements. They do not assert deterministic causal axioms.</rdfs:comment>
        <rdfs:comment xml:lang="en">Working extraction identifiers are maintained in the crosswalk documentation rather than stabilised as ontology annotations.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Textile Connector Ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
        <sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</sourceLocator>
        <sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#ontologyModule"/>
    </owl:Ontology>
    


