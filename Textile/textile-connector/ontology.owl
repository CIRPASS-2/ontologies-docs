    <!-- https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled concept classifying a product technology as base case, best available technology or best not-yet-available technology.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">Product technology level concept</rdfs:label>
        <modellingNote xml:lang="en">This shared class prevents aspect modules from recreating the same BC/BAT/BNAT axis. Aspect-specific profiles may map to one of its concepts without becoming equivalent to that generic level.</modellingNote>
        <sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 17, lines 228-235.</sourceLocator>
        <sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-connector#QuantitativeValue -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-connector#QuantitativeValue">
