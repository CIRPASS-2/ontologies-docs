    <!-- https://w3id.org/eudpp/textile-connector#evidenceStatus -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#evidenceStatus">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an ontology resource to one or more controlled concepts describing how explicitly the resource is supported or how strongly it was reconstructed from source material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">evidence status</rdfs:label>
        <modellingNote xml:lang="en">This annotation qualifies the ontology resource itself. Evidence and polarity for an individual weak relation edge remain in the canonical relation register or require a reified statement model.</modellingNote>
        <sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</sourceLocator>
        <sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#modellingNote -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#modellingNote">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Human-readable note documenting a modelling decision, limitation, assumption, source wording or intended future refinement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">modelling note</rdfs:label>
        <sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</sourceLocator>
        <sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    </owl:AnnotationProperty>
    


