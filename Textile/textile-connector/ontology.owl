    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#typicalInfluenceOn -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a source concept, parameter, process, context factor or structural characteristic typically influences a target concept, without asserting a deterministic or universally valid causal relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">typical influence on</rdfs:label>
        <modellingNote xml:lang="en">Use this property for cross-module class-level or concept-level links such as process parameter to structural characteristic, structure to durability, or context factor to durability. It is intentionally an annotation property to avoid strong OWL inferences over classes.</modellingNote>
        <sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</sourceLocator>
        <sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#typicallyContributesTo -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicallyContributesTo">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a source entity typically contributes to, supports or participates in the realisation of a target characteristic, performance aspect or outcome.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">typically contributes to</rdfs:label>
        <modellingNote xml:lang="en">This is a specialised form of typical influence. It should not be interpreted as a necessary or sufficient condition.</modellingNote>
        <sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</sourceLocator>
        <sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a source entity typically increases the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">typically increases likelihood of</rdfs:label>
        <modellingNote xml:lang="en">This property is appropriate for risk-like links, for example context or use factors increasing the likelihood of a durability failure mode.</modellingNote>
        <sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</sourceLocator>
        <sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Weak annotation relation indicating that a source entity typically reduces the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">typically reduces likelihood of</rdfs:label>
        <modellingNote xml:lang="en">This property is appropriate for protective or mitigating links. It should not be interpreted as a guarantee of prevention.</modellingNote>
        <sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</sourceLocator>
        <sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"/>
    </owl:AnnotationProperty>
    


