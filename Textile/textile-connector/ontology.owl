    <!-- https://w3id.org/eudpp/textile-connector#hasMeasurementUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-connector#hasMeasurementUnit">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
