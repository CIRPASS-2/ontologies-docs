        <rdfs:comment xml:lang="en">Relates a quantitative value to the measurement unit used to express it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <rdfs:label xml:lang="en">has measurement unit</rdfs:label>
        <sourceLocator xml:lang="en">docs/decisions/TXT-DEC-001.md</sourceLocator>
        <sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


