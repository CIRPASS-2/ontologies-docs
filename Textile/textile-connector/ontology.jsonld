  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The cited source provides supporting rather than primary evidence."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Supporting evidence"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Supporting evidence"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme"
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "CIRPASS Textile Ontology modelling specification, version 1.1.0."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#projectDecision"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-connector#typicalInfluenceOn",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Weak annotation relation indicating that a source concept, parameter, process, context factor or structural characteristic typically influences a target concept, without asserting a deterministic or universally valid causal relation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "typical influence on"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Use this property for cross-module class-level or concept-level links such as process parameter to structural characteristic, structure to durability, or context factor to durability. It is intentionally an annotation property to avoid strong OWL inferences over classes."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "docs/decisions/TXT-DEC-006.md"
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#projectDecision"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-connector#typicallyContributesTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Weak annotation relation indicating that a source entity typically contributes to, supports or participates in the realisation of a target characteristic, performance aspect or outcome."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "typically contributes to"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "This is a specialised form of typical influence. It should not be interpreted as a necessary or sufficient condition."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "docs/decisions/TXT-DEC-006.md"
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#projectDecision"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Weak annotation relation indicating that a source entity typically increases the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "typically increases likelihood of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "This property is appropriate for risk-like links, for example context or use factors increasing the likelihood of a durability failure mode."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "docs/decisions/TXT-DEC-006.md"
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#projectDecision"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Weak annotation relation indicating that a source entity typically reduces the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "typically reduces likelihood of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "This property is appropriate for protective or mitigating links. It should not be interpreted as a guarantee of prevention."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "docs/decisions/TXT-DEC-006.md"
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#projectDecision"
  } ]
} ]