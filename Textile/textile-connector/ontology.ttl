<http://www.w3.org/2004/02/skos/core#topConceptOf> rdf:type owl:ObjectProperty .


###  https://w3id.org/eudpp/textile-connector#hasMeasurementUnit
:hasMeasurementUnit rdf:type owl:ObjectProperty ;
                    rdfs:domain :QuantitativeValue ;
                    rdfs:range <https://si-digital-framework.org/SI#MeasurementUnit> ;
                    <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                    rdfs:comment "Relates a quantitative value to the measurement unit used to express it."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                    rdfs:label "has measurement unit"@en ;
                    :sourceLocator "docs/decisions/TXT-DEC-001.md"@en ;
                    :sourceType :modellingAbstraction .


###  https://w3id.org/eudpp/textile-connector#hasQuantityKind
:hasQuantityKind rdf:type owl:ObjectProperty ;
                 rdfs:domain :QuantitativeValue ;
                 rdfs:range <https://si-digital-framework.org/SI#QuantityKind> ;
                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                 rdfs:comment "Relates a quantitative value to the kind of quantity that it expresses."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                 rdfs:label "has quantity kind"@en ;
                 :sourceLocator "docs/decisions/TXT-DEC-001.md"@en ;
                 :sourceType :modellingAbstraction .


###  https://w3id.org/eudpp/textile-connector#hasReferenceDuration
:hasReferenceDuration rdf:type owl:ObjectProperty ;
                      rdfs:domain :ReferencePeriod ;
                      rdfs:range :QuantitativeValue ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates a reference period to its quantitative duration."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                      rdfs:label "has reference duration"@en ;
                      :sourceLocator "docs/decisions/TXT-DEC-004.md"@en ;
                      :sourceType :projectDecision .


