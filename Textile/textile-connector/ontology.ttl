###  https://w3id.org/eudpp/textile-connector#evidenceStatus
:evidenceStatus rdf:type owl:AnnotationProperty ;
                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                rdfs:comment "Relates an ontology resource to one or more controlled concepts describing how explicitly the resource is supported or how strongly it was reconstructed from source material."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                rdfs:label "evidence status"@en ;
                :modellingNote "This annotation qualifies the ontology resource itself. Evidence and polarity for an individual weak relation edge remain in the canonical relation register or require a reified statement model."@en ;
                :sourceLocator "docs/decisions/TXT-DEC-006.md"@en ;
                :sourceType :projectDecision ;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://w3id.org/eudpp/textile-connector#modellingNote
:modellingNote rdf:type owl:AnnotationProperty ;
               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
               rdfs:comment "Human-readable note documenting a modelling decision, limitation, assumption, source wording or intended future refinement."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
               rdfs:label "modelling note"@en ;
               :sourceLocator "docs/decisions/TXT-DEC-006.md"@en ;
               :sourceType :projectDecision ;
               rdfs:range rdf:langString .


###  https://w3id.org/eudpp/textile-connector#sourceLocator
:sourceLocator rdf:type owl:AnnotationProperty ;
               rdfs:range rdf:langString .


###  https://w3id.org/eudpp/textile-connector#sourceType
:sourceType rdf:type owl:AnnotationProperty ;
            rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://w3id.org/eudpp/textile-connector#typicalInfluenceOn
:typicalInfluenceOn rdf:type owl:AnnotationProperty ;
                    <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                    rdfs:comment "Weak annotation relation indicating that a source concept, parameter, process, context factor or structural characteristic typically influences a target concept, without asserting a deterministic or universally valid causal relation."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                    rdfs:label "typical influence on"@en ;
                    :modellingNote "Use this property for cross-module class-level or concept-level links such as process parameter to structural characteristic, structure to durability, or context factor to durability. It is intentionally an annotation property to avoid strong OWL inferences over classes."@en ;
                    :sourceLocator "docs/decisions/TXT-DEC-006.md"@en ;
                    :sourceType :projectDecision .


###  https://w3id.org/eudpp/textile-connector#typicallyContributesTo
:typicallyContributesTo rdf:type owl:AnnotationProperty ;
                        <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                        rdfs:comment "Weak annotation relation indicating that a source entity typically contributes to, supports or participates in the realisation of a target characteristic, performance aspect or outcome."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                        rdfs:label "typically contributes to"@en ;
                        :modellingNote "This is a specialised form of typical influence. It should not be interpreted as a necessary or sufficient condition."@en ;
                        :sourceLocator "docs/decisions/TXT-DEC-006.md"@en ;
                        :sourceType :projectDecision ;
                        rdfs:subPropertyOf :typicalInfluenceOn .


###  https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf
:typicallyIncreasesLikelihoodOf rdf:type owl:AnnotationProperty ;
                                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                rdfs:comment "Weak annotation relation indicating that a source entity typically increases the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                                rdfs:label "typically increases likelihood of"@en ;
                                :modellingNote "This property is appropriate for risk-like links, for example context or use factors increasing the likelihood of a durability failure mode."@en ;
                                :sourceLocator "docs/decisions/TXT-DEC-006.md"@en ;
                                :sourceType :projectDecision ;
                                rdfs:subPropertyOf :typicalInfluenceOn .


###  https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf
:typicallyReducesLikelihoodOf rdf:type owl:AnnotationProperty ;
                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                              rdfs:comment "Weak annotation relation indicating that a source entity typically reduces the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                              rdfs:label "typically reduces likelihood of"@en ;
                              :modellingNote "This property is appropriate for protective or mitigating links. It should not be interpreted as a guarantee of prevention."@en ;
                              :sourceLocator "docs/decisions/TXT-DEC-006.md"@en ;
                              :sourceType :projectDecision ;
                              rdfs:subPropertyOf :typicalInfluenceOn .


