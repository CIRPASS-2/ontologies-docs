@prefix : <https://w3id.org/eudpp/textile-connector#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-connector#> .

<https://w3id.org/eudpp/textile-connector> rdf:type owl:Ontology ;
                                            owl:versionIRI <https://w3id.org/eudpp/textile-connector/1.1.2> ;
                                            owl:imports <https://w3id.org/eudpp/textile-si-mireot> ;
                                            <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Connector Ontology. Version 1.1.2."@en ;
                                            <http://purl.org/dc/terms/created> "2026-03-06"^^xsd:date ;
                                            <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                            <http://purl.org/dc/terms/description> "Shared foundation and connector module for the EU DPP textile ontology network. It defines the common quantitative-value and reference-period patterns, the shared product-technology-level vocabulary, controlled provenance vocabularies, editorial annotations and weak cross-module annotation relations. Domain-specific operational relations remain in their domain modules."@en ;
                                            <http://purl.org/dc/terms/issued> "2026-03-06"^^xsd:date ;
                                            <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                            <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                                              <https://w3id.org/eudpp/textile-ontology> ;
                                            <http://purl.org/dc/terms/title> "EU DPP Textile Connector Ontology"@en ;
                                            <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtcon" ;
                                            <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-connector#" ;
                                            rdfs:comment "Operational instance-level relations belong in the relevant domain module and are validated through SHACL."@en ,
                                                         "Relation polarity is not represented as a direct annotation on a source class because one class may have several outgoing weak relations with different directions. Edge-level polarity and evidence remain in the canonical relation register until a statement-level representation is adopted."@en ,
                                                         "The BC/BAT/BNAT product-technology axis is shared here because it is used by more than one textile aspect module. Aspect-specific configurations remain in their own module and map to the shared level rather than duplicating it."@en ,
                                                         "The common ReferencePeriod pattern is infrastructure only; domain modules retain their own hasReferencePeriod relations."@en ,
                                                         "The connector is intentionally dependency-light: it imports the BIPM SI Reference Point but no textile domain module. SKOS terms are referenced directly through their standard W3C IRIs."@en ,
                                                         "The quantitative-value pattern links numerical values to BIPM SI measurement-unit and quantity-kind resources without recreating SI terms."@en ,
                                                         "The typical relation properties are annotation properties for contextual class-level or concept-level statements. They do not assert deterministic causal axioms."@en ,
                                                         "Working extraction identifiers are maintained in the crosswalk documentation rather than stabilised as ontology annotations."@en ;
                                            rdfs:label "EU DPP Textile Connector Ontology"@en ;
                                            owl:versionInfo "Version 1.1.2" ;
                                            :sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                            :sourceType :ontologyModule .

