#################################################################

###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  https://si-digital-framework.org/SI#MeasurementUnit
<https://si-digital-framework.org/SI#MeasurementUnit> rdf:type owl:Class .


###  https://si-digital-framework.org/SI#QuantityKind
<https://si-digital-framework.org/SI#QuantityKind> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept
:ProductTechnologyLevelConcept rdf:type owl:Class ;
                               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                               rdfs:comment "Controlled concept classifying a product technology as base case, best available technology or best not-yet-available technology."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                               rdfs:label "Product technology level concept"@en ;
                               :modellingNote "This shared class prevents aspect modules from recreating the same BC/BAT/BNAT axis. Aspect-specific profiles may map to one of its concepts without becoming equivalent to that generic level."@en ;
                               :sourceLocator "JRC Preparatory Study, relevant section, printed page 17, lines 228-235."@en ;
                               :sourceType :adaptedDefinition .


###  https://w3id.org/eudpp/textile-connector#QuantitativeValue
:QuantitativeValue rdf:type owl:Class ;
                   <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                   rdfs:comment "A numerical value expressed using a measurement unit and, when useful, a kind of quantity."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                   rdfs:label "Quantitative value"@en ;
                   :sourceLocator "docs/decisions/TXT-DEC-001.md"@en ;
                   :sourceType :modellingAbstraction .


###  https://w3id.org/eudpp/textile-connector#ReferencePeriod
:ReferencePeriod rdf:type owl:Class ;
                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                 rdfs:comment "Structured temporal interval used to qualify the period to which an observation, indicator or other time-bound textile statement applies."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                 rdfs:label "Reference period"@en ;
                 :sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                 :sourceType :projectDecision .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme
:EvidenceStatusScheme rdf:type owl:NamedIndividual ,
                               <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                      <http://www.w3.org/2004/02/skos/core#hasTopConcept> :contextDependentEvidence ,
                                                                          :explicitEvidence ,
                                                                          :implicitEvidence ,
                                                                          :reconstructedEvidence ,
                                                                          :stronglyImpliedEvidence ,
                                                                          :supportingEvidence ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Controlled categories describing the evidential status of weak ontology statements."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                      rdfs:label "Evidence status scheme"@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Evidence status scheme"@en ;
                      :sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      :sourceType :projectDecision .


###  https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelScheme
:ProductTechnologyLevelScheme rdf:type owl:NamedIndividual ,
                                       <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                              <http://www.w3.org/2004/02/skos/core#hasTopConcept> :baseCaseTechnologyLevel ,
                                                                                  :bestAvailableTechnologyLevel ,
                                                                                  :bestNotYetAvailableTechnologyLevel ;
                              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                              rdfs:comment "Controlled vocabulary of the JRC base case, best available technology and best not-yet-available technology levels."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                              rdfs:label "Product technology level scheme"@en ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Product technology level scheme"@en ;
                              :sourceLocator "JRC Section 2, printed page 17, lines 228-235."@en ;
                              :sourceType :adaptedDefinition .


###  https://w3id.org/eudpp/textile-connector#SourceTypeScheme
:SourceTypeScheme rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                  <http://www.w3.org/2004/02/skos/core#hasTopConcept> :adaptedDefinition ,
                                                                      :adaptedRelation ,
                                                                      :directExtraction ,
                                                                      :externalReuse ,
                                                                      :modellingAbstraction ,
                                                                      :ontologyModule ,
                                                                      :projectDecision ,
                                                                      :sectorExtension ;
                  <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                  rdfs:comment "Controlled categories describing how an ontology resource is supported or introduced."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                  rdfs:label "Source type scheme"@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Source type scheme"@en ;
                  :sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                  :sourceType :projectDecision .


###  https://w3id.org/eudpp/textile-connector#adaptedDefinition
:adaptedDefinition rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos/core#Concept> ;
                   <http://www.w3.org/2004/02/skos/core#inScheme> :SourceTypeScheme ;
                   <http://www.w3.org/2004/02/skos/core#topConceptOf> :SourceTypeScheme ;
                   <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                   rdfs:comment "The concept is source-supported, but the ontology definition has been shortened, normalised or adapted."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
                   rdfs:label "Adapted definition"@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Adapted definition"@en ;
                   :sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                   :sourceType :projectDecision .


###  https://w3id.org/eudpp/textile-connector#adaptedRelation
:adaptedRelation rdf:type owl:NamedIndividual ,
