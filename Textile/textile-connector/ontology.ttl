#    Data properties
#################################################################

###  https://w3id.org/eudpp/textile-connector#numericValue
:numericValue rdf:type owl:DatatypeProperty ;
              rdfs:domain :QuantitativeValue ;
              rdfs:range xsd:decimal ;
              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
              rdfs:comment "Relates a quantitative value to its numerical component."@en ;
              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
              rdfs:label "numeric value"@en ;
              :sourceLocator "docs/decisions/TXT-DEC-001.md"@en ;
              :sourceType :modellingAbstraction .


###  https://w3id.org/eudpp/textile-connector#periodEnd
:periodEnd rdf:type owl:DatatypeProperty ;
           rdfs:domain :ReferencePeriod ;
           rdfs:range xsd:dateTime ;
           <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
           rdfs:comment "End date and time of a reference period."@en ;
           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
           rdfs:label "period end"@en ;
           :sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
           :sourceType :projectDecision .


###  https://w3id.org/eudpp/textile-connector#periodStart
:periodStart rdf:type owl:DatatypeProperty ;
             rdfs:domain :ReferencePeriod ;
             rdfs:range xsd:dateTime ;
             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
             rdfs:comment "Start date and time of a reference period."@en ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-connector> ;
             rdfs:label "period start"@en ;
             :sourceLocator "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
             :sourceType :projectDecision .


