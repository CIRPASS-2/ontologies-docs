    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf"/>
    


    <!-- https://w3id.org/eudpp/textile-durability#typicalDegradationExpression -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-durability#typicalDegradationExpression">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Annotation used at class level to document a usual degradation expression of a durability-related performance characteristic without imposing a necessary OWL restriction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">typical degradation expression</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#typicalFailureExpression -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-durability#typicalFailureExpression">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Annotation used at class level to document the usual failure expression of an observed performance parameter without imposing an OWL existential restriction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">typical failure expression</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#typicalProgressionTo -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-durability#typicalProgressionTo">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Annotation used at class level to document a typical degradation progression without asserting a necessary causal relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">typical progression to</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:AnnotationProperty>
    


