    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#evidenceStatus"/>
    


    <!-- https://w3id.org/eudpp/textile-connector#modellingNote -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/eudpp/textile-connector#modellingNote"/>
    


