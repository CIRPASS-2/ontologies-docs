<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/textile-durability#"
     xml:base="https://w3id.org/eudpp/textile-durability"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:textile-connector="https://w3id.org/eudpp/textile-connector#"
     xmlns:textile-durability="https://w3id.org/eudpp/textile-durability#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-durability">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-durability/1.1.2"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Textile Durability Ontology. Version 1.1.2.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:created>
        <terms:creator xml:lang="en">Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Ontology module for textile durability constructs, durability-related performance characteristics, degradation phenomena, external damage and failure modes. Test methods, observations, measurement results, thresholds and values remain in the textile assessment module.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <terms:title xml:lang="en">EU DPP Textile Durability Ontology</terms:title>
        <vann:preferredNamespacePrefix>txtdur</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-durability#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Assessment methods, measurement results, thresholds and quantitative values are intentionally outside this module and should be represented in the textile assessment module.</rdfs:comment>
        <rdfs:comment xml:lang="en">If durability parameter names or failure-mode names are needed as controlled data values in application profiles, a separate SKOS codelist can be derived from this OWL hierarchy without replacing the OWL classes.</rdfs:comment>
        <rdfs:comment xml:lang="en">ObservedDegradationPhenomenon is not declared disjoint with ObservedPerformanceParameter, because degradation phenomena such as pilling can also be handled as observed performance parameters in inspection contexts.</rdfs:comment>
        <rdfs:comment xml:lang="en">The alignment to dpp:Durability entails that textile durability is also a dpp:QualityIndicator and dpp:QuantitativeProperty. This inherited classification denotes a measurable quality characteristic and remains distinct from txtcon:QuantitativeValue.</rdfs:comment>
        <rdfs:comment xml:lang="en">The module covers tactile, functional, structural, visual and surface degradation concepts such as RoughOrStiffFabric, LossOfComfort, ElasticityLoss, FuzzingOrMatting, ColourDepthEvenness and FabricSmoothness.</rdfs:comment>
        <rdfs:comment xml:lang="en">The module keeps Durability and IntrinsicDurability as explicit OWL classes and represents observed performance parameters and failure modes as OWL classes rather than SKOS concepts.</rdfs:comment>
        <rdfs:comment xml:lang="en">This module represents durability constructs, observed performance parameter types and failure mode types as OWL classes. It intentionally does not introduce SKOS codelists for these concepts in the core ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Textile Durability Ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
    </owl:Ontology>
    


