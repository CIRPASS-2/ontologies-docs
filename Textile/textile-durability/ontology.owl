    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/textile-durability#hasDegradationExpression -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-durability#hasDegradationExpression">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a durability-related performance characteristic to a degradation phenomenon that expresses deterioration of that characteristic. This is an instance-level relation and is not a deterministic causal axiom.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">has degradation expression</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#hasDurabilityAspect -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-durability#hasDurabilityAspect">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile product to a durability aspect relevant to its assessment or declaration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">has durability aspect</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#hasExternalDamage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-durability#hasExternalDamage">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ExternalDamage"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile product or product observation to external damage occurring during use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">has external damage</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#hasFailureExpression -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-durability#hasFailureExpression">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates an observed performance parameter to a failure mode that expresses degradation or loss of that parameter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">has failure expression</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#hasFailureMode -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-durability#hasFailureMode">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile product to a failure mode observed, expected or considered relevant for that product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">has failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#hasObservedDegradationPhenomenon -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-durability#hasObservedDegradationPhenomenon">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a product to a degradation phenomenon observed or considered relevant for that product. A concrete observation, test and result should be represented in the textile assessment module.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">has observed degradation phenomenon</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#hasObservedPerformanceParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-durability#hasObservedPerformanceParameter">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a textile product to an observed performance parameter relevant to its durability assessment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">has observed performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#mayResultIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-durability#mayResultIn">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-durability#ExternalDamage"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Indicates that external damage may result in a failure mode.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">may result in</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-durability#negativelyAffects -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-durability#negativelyAffects">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ExternalDamage"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#FailureMode"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Indicates that a failure mode, degradation phenomenon or damage negatively affects a durability-related aspect.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">negatively affects</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#Durability -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Durability"/>
    


    <!-- https://w3id.org/eudpp#Product -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Product"/>
    


    <!-- https://w3id.org/eudpp#Property -->


    <owl:Class rdf:about="https://w3id.org/eudpp#Property"/>
    


    <!-- https://w3id.org/eudpp/textile-durability#AbrasionResistance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#AbrasionResistance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Observed performance parameter describing the resistance of a textile material or product to wear caused by rubbing or abrasion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Abrasion resistance</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Observed abrasion resistance contributes to the interpretation of intrinsic durability but is not equivalent to intrinsic durability.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#directExtraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#AccidentalDamage -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#AccidentalDamage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ExternalDamage"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">External damage occurring during use, such as accidental tearing, ripping or staining, which may lead to product rejection or disposal.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Accidental damage</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Accidental damage may result in tear or rip, but this is not a necessary relation in every case.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11090-11091.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <typicalProgressionTo rdf:resource="https://w3id.org/eudpp/textile-durability#TearOrRip"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#AssemblyPerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#AssemblyPerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of observed performance parameters related to seams, assembly or garment construction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Assembly performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ColourDepthEvenness -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ColourDepthEvenness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Observed visual performance parameter describing the depth and evenness of colour in a textile product or fabric, especially in relation to dyeing and finishing quality.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Colour depth and evenness</rdfs:label>
        <skos:altLabel xml:lang="en">Colour depth</skos:altLabel>
        <skos:altLabel xml:lang="en">Colour evenness</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Colour depth and evenness is distinct from colour fastness. Colour fastness concerns resistance to fading, running or alteration, whereas colour depth/evenness concerns the achieved visual colour quality.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#Discolouration"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ColourFading -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ColourFading">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Visual failure mode corresponding to progressive loss of colour intensity during use, washing, ageing or exposure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Colour fading</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11089-11093; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2276-2279.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ColourFastness -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ColourFastness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Observed performance parameter describing the resistance of a textile colour to fading, running or alteration under conditions such as washing, rubbing, perspiration or light exposure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Colour fastness</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Colour fastness is the resistance parameter; colour fading is a typical visual failure expression of its degradation.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Observed colour fastness contributes to the interpretation of intrinsic durability, while colour fading is a failure expression.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#ColourFading"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ComponentFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ComponentFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes affecting components or trims.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Component failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of observed performance parameters related to deformation, shape retention or dimensional behaviour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Deformation performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#DimensionalStability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#DimensionalStability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Observed performance parameter describing the ability of a textile product or fabric to retain its dimensions after use, laundering or other treatment cycles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Dimensional stability</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Dimensional stability contributes to the interpretation of intrinsic durability; loss of dimensional stability is the corresponding failure expression.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Dimensional stability is the performance parameter; loss of dimensional stability is the corresponding failure expression.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 11.1.1.1, printed page 186, lines 5267-5273; Annex 13.10.1, printed page 469, lines 11089-11094.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#Discolouration -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#Discolouration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Kept distinct from colour fading because discolouration may be localised, irregular or caused by specific use or exposure conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Discolouration</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11093.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#Durability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#Durability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Durability"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Durability</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Through the alignment txtdur:Durability rdfs:subClassOf dpp:Durability, this class inherits dpp:QualityIndicator and dpp:QuantitativeProperty. This is an inherited EU DPP Core commitment: it does not make a durability instance a numeric value. Numerical observations and results remain represented through Textile Assessment and txtcon:QuantitativeValue.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11067.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ElasticityLoss -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ElasticityLoss">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Structural failure mode corresponding to loss of elasticity, elastic recovery or stretch-related functionality of a textile product or fabric.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Elasticity loss</rdfs:label>
        <skos:altLabel xml:lang="en">Loss of elasticity</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Elasticity loss is kept distinct from loss of dimensional stability. A product may lose elastic recovery without necessarily being described primarily as dimensionally unstable.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-connector:typicallyIncreasesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#LossOfComfort"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ExternalDamage -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ExternalDamage">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Damage caused by external or accidental events during product use, not necessarily resulting from intrinsic lack of durability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">External damage</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FabricBreakdown -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FabricBreakdown">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Aggregated failure mode. It may be decomposed later into more specific phenomena such as fraying, thinning, localised wear or hole formation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Fabric breakdown</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11089-11093; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FabricSmoothness -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FabricSmoothness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Observed performance parameter describing the visible or tactile smoothness of a fabric surface, commonly considered during visual inspection after washing, drying or other durability-related stress.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Fabric smoothness</rdfs:label>
        <skos:altLabel xml:lang="en">Surface smoothness</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric smoothness is represented as an observed performance parameter. A measured value or inspection grade should be represented in the assessment module, while rough or stiff fabric is modelled as a failure expression.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FabricStrength -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FabricStrength">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Aggregated observed mechanical performance parameter describing the strength of a fabric, potentially covering tensile strength, tear strength or bursting strength depending on the test context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Fabric strength</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Fabric strength contributes to the interpretation of intrinsic durability as an aggregated mechanical performance parameter.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Fabric strength is modelled as reducing the likelihood of tear or rip under comparable conditions, rather than as negatively affecting tear or rip.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicallyReducesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#TearOrRip"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FailureMode">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Failure modes are kept separate from observed performance parameters. For example, colour fastness is a parameter, while colour fading is a failure mode.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FunctionalFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FunctionalFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily involving loss of intended use, comfort or functional suitability of a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Functional failure mode</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Introduced to represent failure modes that are not adequately captured by visual, structural, mechanical or component failure categories alone.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#FuzzingOrMatting -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#FuzzingOrMatting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Observed surface degradation phenomenon involving fuzzing or matting of the fabric surface. The term follows the JRC and ISO wording &apos;fuzzing or matting&apos;, not &apos;melting&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Fuzzing or matting</rdfs:label>
        <skos:altLabel xml:lang="en">Fabric fuzzing</skos:altLabel>
        <skos:altLabel xml:lang="en">Fabric matting</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">FuzzingOrMatting is not made a subclass of FailureMode because it is modelled following the existing pilling pattern as an observed degradation phenomenon used in performance inspection.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">The research gap used the wording &apos;fuzzing/melting&apos;, but the JRC and referenced ISO standards use fuzzing/matting. This ontology therefore introduces FuzzingOrMatting and avoids the unsupported term melting.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <typicalProgressionTo rdf:resource="https://w3id.org/eudpp/textile-durability#FabricBreakdown"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#HoleInSeam -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#HoleInSeam">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SeamFailure"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Specific seam failure involving a hole or localised opening at or around a seam.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Hole in seam</rdfs:label>
        <skos:altLabel xml:lang="en">Holes in seams</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11093.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#IntrinsicDurability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#IntrinsicDurability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Durability construct based on the physical and measurable ability of a textile product to maintain relevant performance characteristics over time under specified use, maintenance or test conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Intrinsic durability</rdfs:label>
        <skos:altLabel xml:lang="en">Physical durability</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#LogoFailure -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#LogoFailure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Logo failure may also be interpreted as a component-related failure depending on whether the logo is printed, embroidered or applied as a separate component. It is kept under visual failure mode in this module.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Logo failure</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11091-11092.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#LossOfComfort -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#LossOfComfort">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FunctionalFailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Functional failure mode corresponding to loss of comfort or comfort-related suitability during use, maintenance or ageing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Loss of comfort</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Loss of comfort is kept as a functional failure mode. Specific causes may include roughness, stiffness, loss of elasticity, poor breathability, poor insulation or other context-dependent phenomena.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Failure expression corresponding to loss of the ability of a textile product or fabric to retain its dimensions after use, laundering or treatment cycles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Loss of dimensional stability</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11091-11092.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#MechanicalFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#MechanicalFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily involving rupture, tearing or mechanical damage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Mechanical failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of observed performance parameters related to mechanical resistance or strength.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Mechanical performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon">
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Observable phenomenon indicating physical deterioration of a textile material or product. It is distinct from the performance characteristic used to assess resistance to that deterioration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Observed degradation phenomenon</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Durability-related product characteristic that can be observed, assessed or measured to evaluate physical durability. It denotes the characteristic type, not a test, observation, result or quantitative value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Observed performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#Pilling -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#Pilling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Observed surface degradation phenomenon involving the formation of small balls or pills of entangled fibres on a textile surface during wear, friction, use or testing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Pilling</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Observed pilling may contribute to fabric breakdown as part of a progressive surface degradation process, but it should not be treated as the sole necessary cause of fabric breakdown.</textile-connector:modellingNote>
        <textile-connector:modellingNote xml:lang="en">Observed pilling negatively affects the interpretation of intrinsic durability; pilling resistance, if modelled separately, should be represented as a protective characteristic.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <typicalProgressionTo rdf:resource="https://w3id.org/eudpp/textile-durability#FabricBreakdown"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#PillingResistance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#PillingResistance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Durability-related performance characteristic describing the ability of a textile material, fabric or product to resist the formation of pills under friction, wear or use conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Pilling resistance</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Pilling resistance is separated from Pilling.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <typicalDegradationExpression rdf:resource="https://w3id.org/eudpp/textile-durability#Pilling"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#ProductAgeing -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#ProductAgeing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Progressive change or degradation of textile product performance over time under repeated use, care, environmental exposure or stress.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Product ageing</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.1.3, printed pages 112-113, lines 2968-3010.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#RadiationInducedDegradation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#RadiationInducedDegradation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ProductAgeing"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Degradation of textile material or product properties associated with ultraviolet or other relevant radiation exposure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Radiation-induced degradation</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 12.3.16, printed page 254, lines 7150-7157.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#TactileFailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Failure mode in which a fabric becomes or is perceived as rough, stiff or unpleasant to touch, affecting user acceptance and comfort-related use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Rough or stiff fabric</rdfs:label>
        <skos:altLabel xml:lang="en">Fabric roughness</skos:altLabel>
        <skos:altLabel xml:lang="en">Fabric stiffness</skos:altLabel>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">The concept is modelled as a tactile failure mode rather than as a structural characteristic. The corresponding structural or tactile fabric property remains outside this module.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
        <textile-connector:typicallyIncreasesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#LossOfComfort"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#SeamFailure -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#SeamFailure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Structural or assembly-related failure mode involving loss of seam integrity or seam functionality.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Seam failure</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 469, lines 11089-11094.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#SeamSlippage -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#SeamSlippage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#AssemblyPerformanceParameter"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Durability-related assembly performance characteristic describing displacement of yarns at or near a seam under mechanical stress, which may lead to deformation or opening.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Seam slippage</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Seam slippage negatively affects the interpretation of intrinsic durability as a loss of assembly performance.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#StructuralFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#StructuralFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily affecting structure, integrity or dimensional behaviour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Structural failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Observed degradation phenomenon affecting the surface condition of a textile material or product, such as pilling, fuzzing or matting.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Surface degradation phenomenon</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Introduced to keep surface degradation phenomena separate from strict FailureMode, because the ontology declares FailureMode and ObservedPerformanceParameter disjoint at high level.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#SurfaceFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#SurfaceFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily affecting the textile surface. Borderline surface phenomena that are also assessed as performance parameters should remain under ObservedDegradationPhenomenon to preserve the module disjointness pattern.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Surface failure mode</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">This class is available for strict failure modes. Pilling and fuzzing/matting are intentionally kept as observed degradation phenomena when they are used as inspection parameters.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of observed performance parameters related to surface behaviour or surface degradation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Surface performance parameter</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#TactileFailureMode -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#TactileFailureMode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Category of failure modes primarily affecting tactile perception, hand feel or comfort-related touch properties of a textile product or fabric.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <rdfs:label xml:lang="en">Tactile failure mode</rdfs:label>
        <textile-connector:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
        <textile-connector:modellingNote xml:lang="en">Introduced to avoid forcing tactile failures such as rough or stiff fabric into purely visual or purely structural categories.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-durability#TearOrRip -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-durability#TearOrRip">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#MechanicalFailureMode"/>
