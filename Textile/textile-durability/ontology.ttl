@prefix : <https://w3id.org/eudpp/textile-durability#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-durability#> .

<https://w3id.org/eudpp/textile-durability> rdf:type owl:Ontology ;
                                             owl:versionIRI <https://w3id.org/eudpp/textile-durability/1.1.2> ;
                                             owl:imports <https://w3id.org/eudpp/textile-connector> ,
                                                         <https://w3id.org/eudpp/textile-dpp-mireot> ;
                                             <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Durability Ontology. Version 1.1.2."@en ;
                                             <http://purl.org/dc/terms/created> "2026-03-06"^^xsd:date ;
                                             <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                             <http://purl.org/dc/terms/description> "Ontology module for textile durability constructs, durability-related performance characteristics, degradation phenomena, external damage and failure modes. Test methods, observations, measurement results, thresholds and values remain in the textile assessment module."@en ;
                                             <http://purl.org/dc/terms/issued> "2026-03-06"^^xsd:date ;
                                             <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                             <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                             <http://purl.org/dc/terms/title> "EU DPP Textile Durability Ontology"@en ;
                                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtdur" ;
                                             <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-durability#" ;
                                             rdfs:comment "Assessment methods, measurement results, thresholds and quantitative values are intentionally outside this module and should be represented in the textile assessment module."@en ,
                                                          "If durability parameter names or failure-mode names are needed as controlled data values in application profiles, a separate SKOS codelist can be derived from this OWL hierarchy without replacing the OWL classes."@en ,
                                                          "ObservedDegradationPhenomenon is not declared disjoint with ObservedPerformanceParameter, because degradation phenomena such as pilling can also be handled as observed performance parameters in inspection contexts."@en ,
                                                          "The alignment to dpp:Durability entails that textile durability is also a dpp:QualityIndicator and dpp:QuantitativeProperty. This inherited classification denotes a measurable quality characteristic and remains distinct from txtcon:QuantitativeValue."@en ,
                                                          "The module covers tactile, functional, structural, visual and surface degradation concepts such as RoughOrStiffFabric, LossOfComfort, ElasticityLoss, FuzzingOrMatting, ColourDepthEvenness and FabricSmoothness."@en ,
                                                          "The module keeps Durability and IntrinsicDurability as explicit OWL classes and represents observed performance parameters and failure modes as OWL classes rather than SKOS concepts."@en ,
                                                          "This module represents durability constructs, observed performance parameter types and failure mode types as OWL classes. It intentionally does not introduce SKOS codelists for these concepts in the core ontology."@en ;
                                             rdfs:label "EU DPP Textile Durability Ontology"@en ;
                                             owl:versionInfo "Version 1.1.2" ;
                                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#projectDecision> .

