#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-connector#evidenceStatus
<https://w3id.org/eudpp/textile-connector#evidenceStatus> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-connector#modellingNote
<https://w3id.org/eudpp/textile-connector#modellingNote> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-connector#sourceLocator
<https://w3id.org/eudpp/textile-connector#sourceLocator> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-connector#sourceType
<https://w3id.org/eudpp/textile-connector#sourceType> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf
<https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf
<https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf> rdf:type owl:AnnotationProperty .


###  https://w3id.org/eudpp/textile-durability#typicalDegradationExpression
:typicalDegradationExpression rdf:type owl:AnnotationProperty ;
                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                              rdfs:comment "Annotation used at class level to document a usual degradation expression of a durability-related performance characteristic without imposing a necessary OWL restriction."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                              rdfs:label "typical degradation expression"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#typicalFailureExpression
:typicalFailureExpression rdf:type owl:AnnotationProperty ;
                          <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                          rdfs:comment "Annotation used at class level to document the usual failure expression of an observed performance parameter without imposing an OWL existential restriction."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                          rdfs:label "typical failure expression"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#typicalProgressionTo
:typicalProgressionTo rdf:type owl:AnnotationProperty ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Annotation used at class level to document a typical degradation progression without asserting a necessary causal relation."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                      rdfs:label "typical progression to"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/eudpp/textile-durability#hasDegradationExpression
:hasDegradationExpression rdf:type owl:ObjectProperty ;
                          rdfs:domain :ObservedPerformanceParameter ;
                          rdfs:range :ObservedDegradationPhenomenon ;
                          <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                          rdfs:comment "Relates a durability-related performance characteristic to a degradation phenomenon that expresses deterioration of that characteristic. This is an instance-level relation and is not a deterministic causal axiom."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                          rdfs:label "has degradation expression"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#hasDurabilityAspect
:hasDurabilityAspect rdf:type owl:ObjectProperty ;
                     rdfs:domain <https://w3id.org/eudpp#Product> ;
                     rdfs:range :Durability ;
                     <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Relates a textile product to a durability aspect relevant to its assessment or declaration."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                     rdfs:label "has durability aspect"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#hasExternalDamage
:hasExternalDamage rdf:type owl:ObjectProperty ;
                   rdfs:domain <https://w3id.org/eudpp#Product> ;
                   rdfs:range :ExternalDamage ;
                   <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                   rdfs:comment "Relates a textile product or product observation to external damage occurring during use."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                   rdfs:label "has external damage"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#hasFailureExpression
:hasFailureExpression rdf:type owl:ObjectProperty ;
                      rdfs:domain :ObservedPerformanceParameter ;
                      rdfs:range :FailureMode ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates an observed performance parameter to a failure mode that expresses degradation or loss of that parameter."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                      rdfs:label "has failure expression"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#hasFailureMode
:hasFailureMode rdf:type owl:ObjectProperty ;
                rdfs:domain <https://w3id.org/eudpp#Product> ;
                rdfs:range :FailureMode ;
                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                rdfs:comment "Relates a textile product to a failure mode observed, expected or considered relevant for that product."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                rdfs:label "has failure mode"@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#hasObservedDegradationPhenomenon
:hasObservedDegradationPhenomenon rdf:type owl:ObjectProperty ;
                                  rdfs:domain <https://w3id.org/eudpp#Product> ;
                                  rdfs:range :ObservedDegradationPhenomenon ;
                                  <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                  rdfs:comment "Relates a product to a degradation phenomenon observed or considered relevant for that product. A concrete observation, test and result should be represented in the textile assessment module."@en ;
                                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                                  rdfs:label "has observed degradation phenomenon"@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#hasObservedPerformanceParameter
:hasObservedPerformanceParameter rdf:type owl:ObjectProperty ;
                                 rdfs:domain <https://w3id.org/eudpp#Product> ;
                                 rdfs:range :ObservedPerformanceParameter ;
                                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                 rdfs:comment "Relates a textile product to an observed performance parameter relevant to its durability assessment."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                                 rdfs:label "has observed performance parameter"@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#mayResultIn
:mayResultIn rdf:type owl:ObjectProperty ;
             rdfs:domain :ExternalDamage ;
             rdfs:range :FailureMode ;
             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
             rdfs:comment "Indicates that external damage may result in a failure mode."@en ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
             rdfs:label "may result in"@en ;
             <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#negativelyAffects
:negativelyAffects rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :ExternalDamage
                                               :FailureMode
                                               :ObservedDegradationPhenomenon
                                             )
                               ] ;
                   rdfs:range :Durability ;
                   <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                   rdfs:comment "Indicates that a failure mode, degradation phenomenon or damage negatively affects a durability-related aspect."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                   rdfs:label "negatively affects"@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/eudpp#Durability
<https://w3id.org/eudpp#Durability> rdf:type owl:Class .


###  https://w3id.org/eudpp#Product
<https://w3id.org/eudpp#Product> rdf:type owl:Class .


###  https://w3id.org/eudpp#Property
<https://w3id.org/eudpp#Property> rdf:type owl:Class .


###  https://w3id.org/eudpp/textile-durability#AbrasionResistance
:AbrasionResistance rdf:type owl:Class ;
                    rdfs:subClassOf :MechanicalPerformanceParameter ;
                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                    rdfs:comment "Observed performance parameter describing the resistance of a textile material or product to wear caused by rubbing or abrasion."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                    rdfs:label "Abrasion resistance"@en ;
                    <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                    <https://w3id.org/eudpp/textile-connector#modellingNote> "Observed abrasion resistance contributes to the interpretation of intrinsic durability but is not equivalent to intrinsic durability."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#directExtraction> .


###  https://w3id.org/eudpp/textile-durability#AccidentalDamage
:AccidentalDamage rdf:type owl:Class ;
                  rdfs:subClassOf :ExternalDamage ;
                  <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                  rdfs:comment "External damage occurring during use, such as accidental tearing, ripping or staining, which may lead to product rejection or disposal."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                  rdfs:label "Accidental damage"@en ;
                  <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                  <https://w3id.org/eudpp/textile-connector#modellingNote> "Accidental damage may result in tear or rip, but this is not a necessary relation in every case."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11090-11091."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                  :typicalProgressionTo :TearOrRip .


###  https://w3id.org/eudpp/textile-durability#AssemblyPerformanceParameter
:AssemblyPerformanceParameter rdf:type owl:Class ;
                              rdfs:subClassOf :ObservedPerformanceParameter ;
                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                              rdfs:comment "Category of observed performance parameters related to seams, assembly or garment construction."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                              rdfs:label "Assembly performance parameter"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#ColourDepthEvenness
:ColourDepthEvenness rdf:type owl:Class ;
                     rdfs:subClassOf :VisualPerformanceParameter ;
                     <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                     rdfs:comment "Observed visual performance parameter describing the depth and evenness of colour in a textile product or fabric, especially in relation to dyeing and finishing quality."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                     rdfs:label "Colour depth and evenness"@en ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Colour depth"@en ,
                                                                    "Colour evenness"@en ;
                     <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                     <https://w3id.org/eudpp/textile-connector#modellingNote> "Colour depth and evenness is distinct from colour fastness. Colour fastness concerns resistance to fading, running or alteration, whereas colour depth/evenness concerns the achieved visual colour quality."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> ;
                     :typicalFailureExpression :Discolouration .


###  https://w3id.org/eudpp/textile-durability#ColourFading
:ColourFading rdf:type owl:Class ;
              rdfs:subClassOf :VisualFailureMode ;
              <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
              rdfs:comment "Visual failure mode corresponding to progressive loss of colour intensity during use, washing, ageing or exposure."@en ;
              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
              rdfs:label "Colour fading"@en ;
              <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
              <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11089-11093; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2276-2279."@en ;
              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-durability#ColourFastness
:ColourFastness rdf:type owl:Class ;
                rdfs:subClassOf :VisualPerformanceParameter ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Observed performance parameter describing the resistance of a textile colour to fading, running or alteration under conditions such as washing, rubbing, perspiration or light exposure."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                rdfs:label "Colour fastness"@en ;
                <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                <https://w3id.org/eudpp/textile-connector#modellingNote> "Colour fastness is the resistance parameter; colour fading is a typical visual failure expression of its degradation."@en ,
                                                                         "Observed colour fastness contributes to the interpretation of intrinsic durability, while colour fading is a failure expression."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                :typicalFailureExpression :ColourFading .


###  https://w3id.org/eudpp/textile-durability#ComponentFailureMode
:ComponentFailureMode rdf:type owl:Class ;
                      rdfs:subClassOf :FailureMode ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Category of failure modes affecting components or trims."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                      rdfs:label "Component failure mode"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter
:DeformationPerformanceParameter rdf:type owl:Class ;
                                 rdfs:subClassOf :ObservedPerformanceParameter ;
                                 <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                 rdfs:comment "Category of observed performance parameters related to deformation, shape retention or dimensional behaviour."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                                 rdfs:label "Deformation performance parameter"@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#DimensionalStability
:DimensionalStability rdf:type owl:Class ;
                      rdfs:subClassOf :DeformationPerformanceParameter ;
                      <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                      rdfs:comment "Observed performance parameter describing the ability of a textile product or fabric to retain its dimensions after use, laundering or other treatment cycles."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                      rdfs:label "Dimensional stability"@en ;
                      <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                      <https://w3id.org/eudpp/textile-connector#modellingNote> "Dimensional stability contributes to the interpretation of intrinsic durability; loss of dimensional stability is the corresponding failure expression."@en ,
                                                                               "Dimensional stability is the performance parameter; loss of dimensional stability is the corresponding failure expression."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 11.1.1.1, printed page 186, lines 5267-5273; Annex 13.10.1, printed page 469, lines 11089-11094."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                      :typicalFailureExpression :LossOfDimensionalStability .


###  https://w3id.org/eudpp/textile-durability#Discolouration
:Discolouration rdf:type owl:Class ;
                rdfs:subClassOf :VisualFailureMode ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Kept distinct from colour fading because discolouration may be localised, irregular or caused by specific use or exposure conditions."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                rdfs:label "Discolouration"@en ;
                <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11093."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-durability#Durability
:Durability rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/eudpp#Durability> ;
            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
            rdfs:comment "Ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair."@en ;
            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
            rdfs:label "Durability"@en ;
            <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
            <https://w3id.org/eudpp/textile-connector#modellingNote> "Through the alignment txtdur:Durability rdfs:subClassOf dpp:Durability, this class inherits dpp:QualityIndicator and dpp:QuantitativeProperty. This is an inherited EU DPP Core commitment: it does not make a durability instance a numeric value. Numerical observations and results remain represented through Textile Assessment and txtcon:QuantitativeValue."@en ;
            <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.1, printed page 468, lines 11065-11067."@en ;
            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-durability#ElasticityLoss
:ElasticityLoss rdf:type owl:Class ;
                rdfs:subClassOf :StructuralFailureMode ;
                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                rdfs:comment "Structural failure mode corresponding to loss of elasticity, elastic recovery or stretch-related functionality of a textile product or fabric."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                rdfs:label "Elasticity loss"@en ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "Loss of elasticity"@en ;
                <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ,
                                                                          <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                <https://w3id.org/eudpp/textile-connector#modellingNote> "Elasticity loss is kept distinct from loss of dimensional stability. A product may lose elastic recovery without necessarily being described primarily as dimensionally unstable."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> ;
                <https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf> :LossOfComfort .


###  https://w3id.org/eudpp/textile-durability#ExternalDamage
:ExternalDamage rdf:type owl:Class ;
                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                rdfs:comment "Damage caused by external or accidental events during product use, not necessarily resulting from intrinsic lack of durability."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                rdfs:label "External damage"@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#FabricBreakdown
:FabricBreakdown rdf:type owl:Class ;
                 rdfs:subClassOf :StructuralFailureMode ;
                 <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                 rdfs:comment "Aggregated failure mode. It may be decomposed later into more specific phenomena such as fraying, thinning, localised wear or hole formation."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                 rdfs:label "Fabric breakdown"@en ;
                 <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11089-11093; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-durability#FabricSmoothness
:FabricSmoothness rdf:type owl:Class ;
                  rdfs:subClassOf :SurfacePerformanceParameter ,
                                  :VisualPerformanceParameter ;
                  <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                  rdfs:comment "Observed performance parameter describing the visible or tactile smoothness of a fabric surface, commonly considered during visual inspection after washing, drying or other durability-related stress."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                  rdfs:label "Fabric smoothness"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Surface smoothness"@en ;
                  <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                  <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric smoothness is represented as an observed performance parameter. A measured value or inspection grade should be represented in the assessment module, while rough or stiff fabric is modelled as a failure expression."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> ;
                  :typicalFailureExpression :RoughOrStiffFabric .


###  https://w3id.org/eudpp/textile-durability#FabricStrength
:FabricStrength rdf:type owl:Class ;
                rdfs:subClassOf :MechanicalPerformanceParameter ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Aggregated observed mechanical performance parameter describing the strength of a fabric, potentially covering tensile strength, tear strength or bursting strength depending on the test context."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                rdfs:label "Fabric strength"@en ;
                <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                <https://w3id.org/eudpp/textile-connector#modellingNote> "Fabric strength contributes to the interpretation of intrinsic durability as an aggregated mechanical performance parameter."@en ,
                                                                         "Fabric strength is modelled as reducing the likelihood of tear or rip under comparable conditions, rather than as negatively affecting tear or rip."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                <https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf> :TearOrRip .


###  https://w3id.org/eudpp/textile-durability#FailureMode
:FailureMode rdf:type owl:Class ;
             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
             rdfs:comment "Failure modes are kept separate from observed performance parameters. For example, colour fastness is a parameter, while colour fading is a failure mode."@en ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
             rdfs:label "Failure mode"@en ;
             <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#FunctionalFailureMode
:FunctionalFailureMode rdf:type owl:Class ;
                       rdfs:subClassOf :FailureMode ;
                       <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                       rdfs:comment "Category of failure modes primarily involving loss of intended use, comfort or functional suitability of a textile product."@en ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                       rdfs:label "Functional failure mode"@en ;
                       <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
                       <https://w3id.org/eudpp/textile-connector#modellingNote> "Introduced to represent failure modes that are not adequately captured by visual, structural, mechanical or component failure categories alone."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#FuzzingOrMatting
:FuzzingOrMatting rdf:type owl:Class ;
                  rdfs:subClassOf :SurfaceDegradationPhenomenon ;
                  <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                  rdfs:comment "Observed surface degradation phenomenon involving fuzzing or matting of the fabric surface. The term follows the JRC and ISO wording 'fuzzing or matting', not 'melting'."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                  rdfs:label "Fuzzing or matting"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Fabric fuzzing"@en ,
                                                                 "Fabric matting"@en ;
                  <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                  <https://w3id.org/eudpp/textile-connector#modellingNote> "FuzzingOrMatting is not made a subclass of FailureMode because it is modelled following the existing pilling pattern as an observed degradation phenomenon used in performance inspection."@en ,
                                                                           "The research gap used the wording 'fuzzing/melting', but the JRC and referenced ISO standards use fuzzing/matting. This ontology therefore introduces FuzzingOrMatting and avoids the unsupported term melting."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> ;
                  :typicalProgressionTo :FabricBreakdown .


###  https://w3id.org/eudpp/textile-durability#HoleInSeam
:HoleInSeam rdf:type owl:Class ;
            rdfs:subClassOf :SeamFailure ;
            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
            rdfs:comment "Specific seam failure involving a hole or localised opening at or around a seam."@en ;
            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
            rdfs:label "Hole in seam"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Holes in seams"@en ;
            <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ,
                                                                      <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
            <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11093."@en ;
            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-durability#IntrinsicDurability
:IntrinsicDurability rdf:type owl:Class ;
                     rdfs:subClassOf :Durability ;
                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                     rdfs:comment "Durability construct based on the physical and measurable ability of a textile product to maintain relevant performance characteristics over time under specified use, maintenance or test conditions."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                     rdfs:label "Intrinsic durability"@en ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Physical durability"@en ;
                     <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-durability#LogoFailure
:LogoFailure rdf:type owl:Class ;
             rdfs:subClassOf :VisualFailureMode ;
             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
             rdfs:comment "Logo failure may also be interpreted as a component-related failure depending on whether the logo is printed, embroidered or applied as a separate component. It is kept under visual failure mode in this module."@en ;
             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
             rdfs:label "Logo failure"@en ;
             <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11091-11092."@en ;
             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-durability#LossOfComfort
:LossOfComfort rdf:type owl:Class ;
               rdfs:subClassOf :FunctionalFailureMode ;
               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
               rdfs:comment "Functional failure mode corresponding to loss of comfort or comfort-related suitability during use, maintenance or ageing."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
               rdfs:label "Loss of comfort"@en ;
               <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ,
                                                                         <https://w3id.org/eudpp/textile-connector#reconstructedEvidence> ;
               <https://w3id.org/eudpp/textile-connector#modellingNote> "Loss of comfort is kept as a functional failure mode. Specific causes may include roughness, stiffness, loss of elasticity, poor breathability, poor insulation or other context-dependent phenomena."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability
:LossOfDimensionalStability rdf:type owl:Class ;
                            rdfs:subClassOf :StructuralFailureMode ;
                            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                            rdfs:comment "Failure expression corresponding to loss of the ability of a textile product or fabric to retain its dimensions after use, laundering or treatment cycles."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                            rdfs:label "Loss of dimensional stability"@en ;
                            <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11091-11092."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-durability#MechanicalFailureMode
:MechanicalFailureMode rdf:type owl:Class ;
                       rdfs:subClassOf :FailureMode ;
                       <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                       rdfs:comment "Category of failure modes primarily involving rupture, tearing or mechanical damage."@en ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                       rdfs:label "Mechanical failure mode"@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter
:MechanicalPerformanceParameter rdf:type owl:Class ;
                                rdfs:subClassOf :ObservedPerformanceParameter ;
                                <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                rdfs:comment "Category of observed performance parameters related to mechanical resistance or strength."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                                rdfs:label "Mechanical performance parameter"@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon
:ObservedDegradationPhenomenon rdf:type owl:Class ;
                               <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                               rdfs:comment "Observable phenomenon indicating physical deterioration of a textile material or product. It is distinct from the performance characteristic used to assess resistance to that deterioration."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                               rdfs:label "Observed degradation phenomenon"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter
:ObservedPerformanceParameter rdf:type owl:Class ;
                              rdfs:subClassOf <https://w3id.org/eudpp#Property> ;
                              <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                              rdfs:comment "Durability-related product characteristic that can be observed, assessed or measured to evaluate physical durability. It denotes the characteristic type, not a test, observation, result or quantitative value."@en ;
                              rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                              rdfs:label "Observed performance parameter"@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                              <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-durability#Pilling
:Pilling rdf:type owl:Class ;
         rdfs:subClassOf :ObservedDegradationPhenomenon ,
                         :SurfaceDegradationPhenomenon ;
         <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
         rdfs:comment "Observed surface degradation phenomenon involving the formation of small balls or pills of entangled fibres on a textile surface during wear, friction, use or testing."@en ;
         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
         rdfs:label "Pilling"@en ;
         <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
         <https://w3id.org/eudpp/textile-connector#modellingNote> "Observed pilling may contribute to fabric breakdown as part of a progressive surface degradation process, but it should not be treated as the sole necessary cause of fabric breakdown."@en ,
                                                                  "Observed pilling negatively affects the interpretation of intrinsic durability; pilling resistance, if modelled separately, should be represented as a protective characteristic."@en ;
         <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en ;
         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
         :typicalProgressionTo :FabricBreakdown .


###  https://w3id.org/eudpp/textile-durability#PillingResistance
:PillingResistance rdf:type owl:Class ;
                   rdfs:subClassOf :SurfacePerformanceParameter ;
                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                   rdfs:comment "Durability-related performance characteristic describing the ability of a textile material, fabric or product to resist the formation of pills under friction, wear or use conditions."@en ;
                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-durability> ;
                   rdfs:label "Pilling resistance"@en ;
                   <https://w3id.org/eudpp/textile-connector#evidenceStatus> <https://w3id.org/eudpp/textile-connector#explicitEvidence> ;
                   <https://w3id.org/eudpp/textile-connector#modellingNote> "Pilling resistance is separated from Pilling."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."@en ;
                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
                   :typicalDegradationExpression :Pilling .


