  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#Durability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp#Durability"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Through the alignment txtdur:Durability rdfs:subClassOf dpp:Durability, this class inherits dpp:QualityIndicator and dpp:QuantitativeProperty. This is an inherited EU DPP Core commitment: it does not make a durability instance a numeric value. Numerical observations and results remain represented through Textile Assessment and txtcon:QuantitativeValue."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "JRC Annex 13.10.1, printed page 468, lines 11065-11067."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#adaptedDefinition"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#ElasticityLoss",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Structural failure mode corresponding to loss of elasticity, elastic recovery or stretch-related functionality of a textile product or fabric."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Elasticity loss"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#StructuralFailureMode"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Loss of elasticity"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-connector#reconstructedEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Elasticity loss is kept distinct from loss of dimensional stability. A product may lose elastic recovery without necessarily being described primarily as dimensionally unstable."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "CIRPASS Textile Ontology modelling specification, version 1.1.0."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#modellingAbstraction"
  } ],
  "https://w3id.org/eudpp/textile-connector#typicallyIncreasesLikelihoodOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#LossOfComfort"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#ExternalDamage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Damage caused by external or accidental events during product use, not necessarily resulting from intrinsic lack of durability."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "External damage"
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "CIRPASS Textile Ontology modelling specification, version 1.1.0."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#modellingAbstraction"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#FabricBreakdown",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Aggregated failure mode. It may be decomposed later into more specific phenomena such as fraying, thinning, localised wear or hole formation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Fabric breakdown"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#StructuralFailureMode"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11089-11093; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#adaptedDefinition"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#FabricSmoothness",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Observed performance parameter describing the visible or tactile smoothness of a fabric surface, commonly considered during visual inspection after washing, drying or other durability-related stress."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Fabric smoothness"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Surface smoothness"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Fabric smoothness is represented as an observed performance parameter. A measured value or inspection grade should be represented in the assessment module, while rough or stiff fabric is modelled as a failure expression."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "CIRPASS Textile Ontology modelling specification, version 1.1.0."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#modellingAbstraction"
  } ],
  "https://w3id.org/eudpp/textile-durability#typicalFailureExpression" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#FabricStrength",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Aggregated observed mechanical performance parameter describing the strength of a fabric, potentially covering tensile strength, tear strength or bursting strength depending on the test context."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Fabric strength"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Fabric strength contributes to the interpretation of intrinsic durability as an aggregated mechanical performance parameter."
  }, {
    "@language" : "en",
    "@value" : "Fabric strength is modelled as reducing the likelihood of tear or rip under comparable conditions, rather than as negatively affecting tear or rip."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#adaptedDefinition"
  } ],
  "https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#TearOrRip"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#FailureMode",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Failure modes are kept separate from observed performance parameters. For example, colour fastness is a parameter, while colour fading is a failure mode."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Failure mode"
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "CIRPASS Textile Ontology modelling specification, version 1.1.0."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#modellingAbstraction"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#FunctionalFailureMode",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Category of failure modes primarily involving loss of intended use, comfort or functional suitability of a textile product."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Functional failure mode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#FailureMode"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#reconstructedEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Introduced to represent failure modes that are not adequately captured by visual, structural, mechanical or component failure categories alone."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "CIRPASS Textile Ontology modelling specification, version 1.1.0."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#modellingAbstraction"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#FuzzingOrMatting",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Observed surface degradation phenomenon involving fuzzing or matting of the fabric surface. The term follows the JRC and ISO wording 'fuzzing or matting', not 'melting'."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Fuzzing or matting"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Fabric fuzzing"
  }, {
    "@language" : "en",
    "@value" : "Fabric matting"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "FuzzingOrMatting is not made a subclass of FailureMode because it is modelled following the existing pilling pattern as an observed degradation phenomenon used in performance inspection."
  }, {
    "@language" : "en",
    "@value" : "The research gap used the wording 'fuzzing/melting', but the JRC and referenced ISO standards use fuzzing/matting. This ontology therefore introduces FuzzingOrMatting and avoids the unsupported term melting."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "CIRPASS Textile Ontology modelling specification, version 1.1.0."
  } ],
