}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#DimensionalStability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Observed performance parameter describing the ability of a textile product or fabric to retain its dimensions after use, laundering or other treatment cycles."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Dimensional stability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Dimensional stability contributes to the interpretation of intrinsic durability; loss of dimensional stability is the corresponding failure expression."
  }, {
    "@language" : "en",
    "@value" : "Dimensional stability is the performance parameter; loss of dimensional stability is the corresponding failure expression."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "JRC Section 11.1.1.1, printed page 186, lines 5267-5273; Annex 13.10.1, printed page 469, lines 11089-11094."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#adaptedDefinition"
  } ],
  "https://w3id.org/eudpp/textile-durability#typicalFailureExpression" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#Discolouration",
