    "@value" : "JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11089-11093; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2276-2279."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
