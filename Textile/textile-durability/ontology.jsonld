}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#Pilling",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Observed surface degradation phenomenon involving the formation of small balls or pills of entangled fibres on a textile surface during wear, friction, use or testing."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Pilling"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Observed pilling may contribute to fabric breakdown as part of a progressive surface degradation process, but it should not be treated as the sole necessary cause of fabric breakdown."
  }, {
    "@language" : "en",
    "@value" : "Observed pilling negatively affects the interpretation of intrinsic durability; pilling resistance, if modelled separately, should be represented as a protective characteristic."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
