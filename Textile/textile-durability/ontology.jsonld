  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#ColourFastness",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Observed performance parameter describing the resistance of a textile colour to fading, running or alteration under conditions such as washing, rubbing, perspiration or light exposure."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Colour fastness"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Colour fastness is the resistance parameter; colour fading is a typical visual failure expression of its degradation."
  }, {
    "@language" : "en",
    "@value" : "Observed colour fastness contributes to the interpretation of intrinsic durability, while colour fading is a failure expression."
  } ],
