}, {
  "@id" : "https://w3id.org/eudpp/textile-durability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Durability Ontology. Version 1.1.2."
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-03-06"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@language" : "en",
    "@value" : "Elio Hbeich"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Ontology module for textile durability constructs, durability-related performance characteristics, degradation phenomena, external damage and failure modes. Test methods, observations, measurement results, thresholds and values remain in the textile assessment module."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-03-06"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-16"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://w3id.org/eudpp/textile-ontology"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Durability Ontology"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "txtdur"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/eudpp/textile-durability#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Assessment methods, measurement results, thresholds and quantitative values are intentionally outside this module and should be represented in the textile assessment module."
  }, {
    "@language" : "en",
    "@value" : "If durability parameter names or failure-mode names are needed as controlled data values in application profiles, a separate SKOS codelist can be derived from this OWL hierarchy without replacing the OWL classes."
  }, {
    "@language" : "en",
    "@value" : "ObservedDegradationPhenomenon is not declared disjoint with ObservedPerformanceParameter, because degradation phenomena such as pilling can also be handled as observed performance parameters in inspection contexts."
  }, {
    "@language" : "en",
    "@value" : "The alignment to dpp:Durability entails that textile durability is also a dpp:QualityIndicator and dpp:QuantitativeProperty. This inherited classification denotes a measurable quality characteristic and remains distinct from txtcon:QuantitativeValue."
  }, {
    "@language" : "en",
    "@value" : "The module covers tactile, functional, structural, visual and surface degradation concepts such as RoughOrStiffFabric, LossOfComfort, ElasticityLoss, FuzzingOrMatting, ColourDepthEvenness and FabricSmoothness."
  }, {
    "@language" : "en",
    "@value" : "The module keeps Durability and IntrinsicDurability as explicit OWL classes and represents observed performance parameters and failure modes as OWL classes rather than SKOS concepts."
  }, {
    "@language" : "en",
    "@value" : "This module represents durability constructs, observed performance parameter types and failure mode types as OWL classes. It intentionally does not introduce SKOS codelists for these concepts in the core ontology."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Durability Ontology"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-dpp-mireot"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability/1.1.2"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "Version 1.1.2"
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "CIRPASS Textile Ontology modelling specification, version 1.1.0."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#projectDecision"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#AbrasionResistance",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Observed performance parameter describing the resistance of a textile material or product to wear caused by rubbing or abrasion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Abrasion resistance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Observed abrasion resistance contributes to the interpretation of intrinsic durability but is not equivalent to intrinsic durability."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#directExtraction"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/textile-durability#AccidentalDamage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "External damage occurring during use, such as accidental tearing, ripping or staining, which may lead to product rejection or disposal."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Accidental damage"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#ExternalDamage"
  } ],
  "https://w3id.org/eudpp/textile-connector#evidenceStatus" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#explicitEvidence"
  } ],
  "https://w3id.org/eudpp/textile-connector#modellingNote" : [ {
    "@language" : "en",
    "@value" : "Accidental damage may result in tear or rip, but this is not a necessary relation in every case."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceLocator" : [ {
    "@language" : "en",
    "@value" : "JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11090-11091."
  } ],
  "https://w3id.org/eudpp/textile-connector#sourceType" : [ {
    "@id" : "https://w3id.org/eudpp/textile-connector#adaptedDefinition"
  } ],
  "https://w3id.org/eudpp/textile-durability#typicalProgressionTo" : [ {
    "@id" : "https://w3id.org/eudpp/textile-durability#TearOrRip"
  } ]
