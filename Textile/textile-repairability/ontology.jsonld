}, {
  "@id" : "https://w3id.org/eudpp/textile-repairability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Repairability Ontology. Version 1.1.2."
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-01"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@language" : "en",
    "@value" : "Elio Hbeich"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Ontology module for textile repairability-related product aspects, services, guidance, design features, contextual conditions, priority elements, assessments, repair-related process specialisations and their links to EU DPP product-event semantics. The module does not define a universal objective repairability score."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-01"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-16"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Repairability Ontology"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "txtrep"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/eudpp/textile-repairability#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The JRC concludes that textile-apparel repairability cannot currently be represented by a simple objective framework. This ontology therefore represents evidence and enabling conditions without inferring that a product is objectively repairable."
  }, {
    "@language" : "en",
    "@value" : "The module reuses the semantic product-event classes defined in the EU DPP EVENT module. Textile-specific life-extension event classes bridge those event semantics with concrete textile process executions; EPCIS technical carriers remain defined by the EVENT module."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EU DPP Textile Repairability Ontology"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "https://w3id.org/eudpp/textile-actor-mireot"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-assessment"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-associated-materials"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-connector"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-context"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-core"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-dpp-mireot"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-durability"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-event-mireot"
  }, {
    "@id" : "https://w3id.org/eudpp/textile-process"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/eudpp/textile-repairability/1.1.2"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "Version 1.1.2"
  } ]
