        <skos:notation>REPAIR_SERVICE_BAT</skos:notation>
        <skos:prefLabel xml:lang="en">Best available repair service configuration</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairServiceConfigurationScheme"/>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/textile-repairability#repairServiceBC -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-repairability#repairServiceBC">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairServiceConfigurationConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Professional repair services are available but have long response times, reduced transparency and consumer mistrust; repair support is very limited and company service is available only in parts of the sales region.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
