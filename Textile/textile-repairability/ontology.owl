        <rdfs:comment xml:lang="en">Textile intervention process intended to enhance the functionality, performance, capacity, safety or aesthetics of a product or component.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Upgrade process</rdfs:label>
