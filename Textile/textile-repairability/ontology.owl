            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#RepairGuidance"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#RepairService"/>
