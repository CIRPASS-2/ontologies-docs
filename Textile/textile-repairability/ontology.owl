    <!-- https://w3id.org/eudpp/textile-repairability#repairServiceBAT -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/textile-repairability#repairServiceBAT">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairServiceConfigurationConcept"/>
