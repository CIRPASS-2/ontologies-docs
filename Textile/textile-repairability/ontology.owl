        <rdfs:comment xml:lang="en">Relates a refurbishment or remanufacturing execution to a textile product used as reusable input, including a product used as a component of another product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">uses reusable textile input</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Annex 13.10.1.7, printed pages 473-475, lines 11280-11386.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#usesSpareComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#usesSpareComponent">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-process#usesInput"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a concrete repair-related process execution to a replacement non-textile component used during the intervention.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">uses spare component</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3399-3408; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11291-11296.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


