<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/eudpp/textile-repairability#"
     xml:base="https://w3id.org/eudpp/textile-repairability"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:textile-connector="https://w3id.org/eudpp/textile-connector#">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/textile-repairability">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-repairability/1.1.2"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-actor-mireot"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-context"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-core"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-durability"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-event-mireot"/>
        <owl:imports rdf:resource="https://w3id.org/eudpp/textile-process"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Textile Repairability Ontology. Version 1.1.2.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-01</terms:created>
        <terms:creator xml:lang="en">Elio Hbeich</terms:creator>
        <terms:description xml:lang="en">Ontology module for textile repairability-related product aspects, services, guidance, design features, contextual conditions, priority elements, assessments, repair-related process specialisations and their links to EU DPP product-event semantics. The module does not define a universal objective repairability score.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-01</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</terms:modified>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:title xml:lang="en">EU DPP Textile Repairability Ontology</terms:title>
        <vann:preferredNamespacePrefix>txtrep</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-repairability#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">The JRC concludes that textile-apparel repairability cannot currently be represented by a simple objective framework. This ontology therefore represents evidence and enabling conditions without inferring that a product is objectively repairable.</rdfs:comment>
        <rdfs:comment xml:lang="en">The module reuses the semantic product-event classes defined in the EU DPP EVENT module. Textile-specific life-extension event classes bridge those event semantics with concrete textile process executions; EPCIS technical carriers remain defined by the EVENT module.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Textile Repairability Ontology</rdfs:label>
        <owl:versionInfo>Version 1.1.2</owl:versionInfo>
    </owl:Ontology>
    


