    <!-- https://w3id.org/eudpp/textile-repairability#addressesFailureMode -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#addressesFailureMode">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#PriorityRepairElement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a concrete repair-related process execution or priority element to a textile failure mode that it addresses.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">addresses failure mode</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#assessesRepairabilityOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#assessesRepairabilityOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-assessment#assessesProduct"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#TextileApparel"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a repairability assessment execution to the textile apparel it assesses.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">assesses repairability of</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#considersProcessType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#considersProcessType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-process#RepairProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a repairability assessment to a repair or other repair-related life-extension process type considered by the assessment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">considers process type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#considersRepairService -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#considersRepairService">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairService"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a repairability assessment to a repair service evaluated or considered as evidence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">considers repair service</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3474-3476; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#coversPriorityElementType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#coversPriorityElementType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairGuidance"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#PriorityRepairElementTypeConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates repair guidance to a controlled priority-element type covered by the guidance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">covers priority element type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Section 9.2.3.1, printed page 128, lines 3416-3421; Section 9.2.3.3, Table 48, printed page 130, caption at line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#hasDesignFeature -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#hasDesignFeature">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a repairability assessment to a design feature considered in the assessment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">has repairability design feature</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11290; JRC Preparatory Study, Section 9.2.3.1, printed page 127, lines 3362-3375.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#hasElementType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#hasElementType">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#PriorityRepairElement"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#PriorityRepairElementTypeConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assigns a controlled element type to a priority repair element role.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">has priority repair element type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#hasInteractiveRepairSupport -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#hasInteractiveRepairSupport">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairService"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#InteractiveRepairSupport"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a repair service to interactive real-time repair support.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">has interactive repair support</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#hasLifeExtensionInterventionAspect -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#hasLifeExtensionInterventionAspect">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileApparel"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates textile apparel to a repairability-related product aspect.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">has life-extension intervention aspect</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#hasPriorityRepairElement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#hasPriorityRepairElement">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#PriorityRepairElement"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a repairability assessment to a priority repair element considered in the assessment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">has priority repair element</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#hasRepairActionType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#hasRepairActionType">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-process#hasProcessMethod"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairActionTypeConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Relates a concrete repair process execution to a controlled repair-action method such as patching, mending, button replacement or zipper replacement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">has repair action type</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#hasRepairActorType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/textile-repairability#hasRepairActorType">
