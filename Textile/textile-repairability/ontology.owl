    <!-- https://w3id.org/eudpp/textile-repairability#canBeDisassembledWithoutDamage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/textile-repairability#canBeDisassembledWithoutDamage">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessmentResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Indicates whether the assessed product or relevant element was found capable of disassembly without damage in the stated assessment context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">can be disassembled without damage</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11283; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11378-11386; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11649-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#hasRepairPriceTransparency -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/textile-repairability#hasRepairPriceTransparency">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Indicates whether transparent repair-price or cost information is available for the service.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">has repair price transparency</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/textile-repairability#isAvailableInWholeSalesRegion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/textile-repairability#isAvailableInWholeSalesRegion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Indicates whether the repair service is available throughout the region in which the textile product is sold.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">is available in whole sales region</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:DatatypeProperty>
    


