        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a repairability assessment to a textile context observation describing repair behaviour. The observation should use txtctx:repairBehaviour as its factor type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">uses repair behaviour observation</rdfs:label>
