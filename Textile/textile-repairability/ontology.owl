    <!-- https://w3id.org/eudpp/textile-repairability#DigitalRepairGuidance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#DigitalRepairGuidance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DigitalInstruction"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairGuidance"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Repair guidance provided in digital form and capable of carrying a web link through the DPP digital-instruction pattern.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Digital repair guidance</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#DisassemblyFeature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#DisassemblyFeature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Design feature describing whether a product or relevant element can be taken apart for repair, upgrade, refurbishment or remanufacturing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Disassembly feature</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11283; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11378-11386; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11649-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#EaseOfDisassembly -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#EaseOfDisassembly">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#DisassemblyFeature"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Disassembly feature concerning the ease with which a product or relevant element can be taken apart without damage or excessive effort.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Ease of disassembly</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11283; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11378-11386; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11649-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#InteractiveRepairSupport -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#InteractiveRepairSupport">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#DigitalRepairGuidance"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Interactive real-time digital repair guidance, for example through augmented reality, artificial intelligence or another interactive technology.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Interactive repair support</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#directExtraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Product aspect concerning intervention-based extension or restoration of textile-product use, functionality or value through repair, upgrade, refurbishment or remanufacturing. It is an organising class and not a score.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Life-extension intervention aspect</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#LifeExtensionProductEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#LifeExtensionProductEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-event-mireot"/>
        <rdfs:comment xml:lang="en">A concrete textile process occurrence that is also interpreted as a product lifecycle event intended to extend, restore or substantially change the useful life, functionality or condition of a textile product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Life-extension product event</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#ModularityFeature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#ModularityFeature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Design feature by which relevant product elements are modular, detachable or interchangeable in support of repair or upgrade.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Modularity feature</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#PriorityRepairElement -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#PriorityRepairElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentElement"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment role assigned to a product element that is important for repairability because of failure frequency or functional relevance. The physical element itself remains represented in the appropriate textile or component module.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Priority repair element</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#PriorityRepairElementTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#PriorityRepairElementTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept identifying a priority repair element type such as fabric, zipper, button or embellishment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Priority repair element type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RefurbishmentPossibility -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RefurbishmentPossibility">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Ability of a product or discarded product to be prepared, cleaned, tested, serviced and, where necessary, repaired so that performance or functionality is restored within the originally intended use and performance range.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Possibility of refurbishment</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11374-11400; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RefurbishmentProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RefurbishmentProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RemanufacturingPossibility -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RemanufacturingPossibility">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Possibility of producing a new product from waste objects, products or components through actions involving at least one change that may affect the product performance, purpose or type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Possibility of remanufacturing</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 16-17, lines 222-225; JRC Preparatory Study, Section 13.10.1.13, printed pages 480-481, lines 11645-11673; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RemanufacturingProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RemanufacturingProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#EndOfLifeProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairActionTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairActionTypeConcept">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#ProcessMethodConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Controlled process-method concept identifying a textile repair action such as patching, mending, button replacement or zipper replacement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair action type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairActorTypeConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairActorTypeConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept used to classify the role or category of an actor participating in textile repair.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair actor type concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3436-3443.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairCostCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairCostCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Economic condition describing repair cost in relation to a comparable new product price and its influence on a repair decision.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair cost condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3429-3435; JRC Preparatory Study, Section 9.2.3.3, printed page 129, lines 3477-3481.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairGuidance -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairGuidance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Information or instructions supporting repair of textile apparel or common damaged elements. Guidance may be physical or digital and is distinct from the repair service and the repair operation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair guidance</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Textile process type related to upgrade, refurbishment or remanufacturing and organised with repair under the broader family of life-extension interventions. Concrete operations are represented as txtprc:TextileProcessExecution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair-related life-extension process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairService -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairService">
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Service that performs, organises or supports textile repair interventions, including company-provided, independent professional and community-supported repair.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair service</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3474-3476; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairServiceConfigurationConcept -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairServiceConfigurationConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#RatingValueConcept"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">SKOS concept representing a BC, BAT or BNAT repair-service and guidance configuration from JRC Table 48.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repair service configuration concept</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#Repairability -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#Repairability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Ability of a defective product or waste object to return, through one or more actions, to a condition in which it fulfils its intended use. For textile apparel, user acceptance of restored functionality and potentially changed aesthetics is contextually relevant.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repairability</rdfs:label>
        <textile-connector:modellingNote xml:lang="en">Repair may extend product use, but the outcome depends on failure type, service availability, cost, user acceptance and the effectiveness of the intervention; no deterministic inference is asserted.</textile-connector:modellingNote>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11273-11279; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
        <textile-connector:typicallyContributesTo rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment execution that gathers contextual evidence about repairability-related product aspects, services, guidance, design features, priority elements, costs, spare-part availability and user acceptance. It does not itself constitute the result.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repairability assessment</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairabilityAssessmentResult -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessmentResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentResult"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Result produced by a repairability assessment. It records the evidence-based outcome and relevant service configuration without asserting a universal objective repairability score.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repairability assessment result</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentCondition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Assessment condition external to intrinsic product design that influences repair feasibility or the decision to repair.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repairability contextual condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentElement"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Design-related feature that may enable repair, upgrade, refurbishment or remanufacturing, such as modularity, standardisation or disassembly.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Repairability design feature</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11290; JRC Preparatory Study, Section 9.2.3.1, printed page 127, lines 3362-3375.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#SparePartAvailabilityCondition -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#SparePartAvailabilityCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Condition describing whether a suitable spare component or replacement element is available for a contemplated repair. Availability may depend on collections, styles, colours, logistics and actual expected use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Spare-part availability condition</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3399-3408; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11291-11296.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#StandardisationFeature -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#StandardisationFeature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature"/>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Design feature by which components or interfaces are standardised in a way that may support replacement, repair or upgrade.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Standardisation feature</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#TextileRefurbishmentEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#TextileRefurbishmentEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#RefurbishmentEvent"/>
