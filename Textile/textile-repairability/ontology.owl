    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#RemanufacturingProcess">
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <rdfs:comment xml:lang="en">Process producing a new textile product from waste objects, products or components, with at least one change that may affect performance, purpose or type. It is distinct from material recycling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Remanufacturing process</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 16-17, lines 222-225; JRC Preparatory Study, Section 13.10.1.13, printed pages 480-481, lines 11645-11673; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#UpgradeProcess">
