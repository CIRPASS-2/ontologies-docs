                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
        <rdfs:comment xml:lang="en">Relates a repair service or repair guidance to the maintenance, repair, upgrade, refurbishment or remanufacturing process type it supports.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
