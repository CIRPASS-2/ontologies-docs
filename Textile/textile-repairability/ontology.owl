            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
        <terms:source rdf:resource="https://w3id.org/eudpp/textile-event-mireot"/>
        <rdfs:comment xml:lang="en">A concrete textile repair occurrence that is both a textile process execution and an instance of the EU DPP RepairEvent semantics.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
        <rdfs:label xml:lang="en">Textile repair event</rdfs:label>
        <textile-connector:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11273-11279; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</textile-connector:sourceLocator>
        <textile-connector:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/textile-repairability#TextileUpgradingEvent -->


    <owl:Class rdf:about="https://w3id.org/eudpp/textile-repairability#TextileUpgradingEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#UpgradingEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionProductEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-process#executesProcessType"/>
