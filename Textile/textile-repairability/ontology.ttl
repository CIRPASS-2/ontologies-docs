###  https://w3id.org/eudpp/textile-repairability#repairServiceBAT
:repairServiceBAT rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos/core#Concept> ,
                           :RepairServiceConfigurationConcept ;
                  <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                  rdfs:comment "Professional repair services are available and transparent; detailed repair guidance covers common damaged elements; company repair service is available throughout the sales region."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                  rdfs:label "Best available repair service configuration"@en ;
                  <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/eudpp/textile-connector#bestAvailableTechnologyLevel> ;
                  <http://www.w3.org/2004/02/skos/core#inScheme> :RepairServiceConfigurationScheme ;
                  <http://www.w3.org/2004/02/skos/core#notation> "REPAIR_SERVICE_BAT" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Best available repair service configuration"@en ;
                  <http://www.w3.org/2004/02/skos/core#topConceptOf> :RepairServiceConfigurationScheme ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-repairability#repairServiceBC
:repairServiceBC rdf:type owl:NamedIndividual ,
                          <http://www.w3.org/2004/02/skos/core#Concept> ,
                          :RepairServiceConfigurationConcept ;
                 <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                 rdfs:comment "Professional repair services are available but have long response times, reduced transparency and consumer mistrust; repair support is very limited and company service is available only in parts of the sales region."@en ;
                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                 rdfs:label "Base-case repair service configuration"@en ;
                 <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/eudpp/textile-connector#baseCaseTechnologyLevel> ;
                 <http://www.w3.org/2004/02/skos/core#inScheme> :RepairServiceConfigurationScheme ;
                 <http://www.w3.org/2004/02/skos/core#notation> "REPAIR_SERVICE_BC" ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Base-case repair service configuration"@en ;
                 <http://www.w3.org/2004/02/skos/core#topConceptOf> :RepairServiceConfigurationScheme ;
                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482."@en ;
                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


