###  https://w3id.org/eudpp/textile-repairability#RefurbishmentPossibility
:RefurbishmentPossibility rdf:type owl:Class ;
                          rdfs:subClassOf :LifeExtensionInterventionAspect ;
                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                          rdfs:comment "Ability of a product or discarded product to be prepared, cleaned, tested, serviced and, where necessary, repaired so that performance or functionality is restored within the originally intended use and performance range."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                          rdfs:label "Possibility of refurbishment"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11374-11400; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-repairability#RefurbishmentProcess
:RefurbishmentProcess rdf:type owl:Class ;
                      rdfs:subClassOf :RepairRelatedProcess .


