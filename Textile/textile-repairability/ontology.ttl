@prefix : <https://w3id.org/eudpp/textile-repairability#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/eudpp/textile-repairability#> .

<https://w3id.org/eudpp/textile-repairability> rdf:type owl:Ontology ;
                                                owl:versionIRI <https://w3id.org/eudpp/textile-repairability/1.1.2> ;
                                                owl:imports <https://w3id.org/eudpp/textile-actor-mireot> ,
                                                            <https://w3id.org/eudpp/textile-assessment> ,
                                                            <https://w3id.org/eudpp/textile-associated-materials> ,
                                                            <https://w3id.org/eudpp/textile-connector> ,
                                                            <https://w3id.org/eudpp/textile-context> ,
                                                            <https://w3id.org/eudpp/textile-core> ,
                                                            <https://w3id.org/eudpp/textile-dpp-mireot> ,
                                                            <https://w3id.org/eudpp/textile-durability> ,
                                                            <https://w3id.org/eudpp/textile-event-mireot> ,
                                                            <https://w3id.org/eudpp/textile-process> ;
                                                <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Textile Repairability Ontology. Version 1.1.2."@en ;
                                                <http://purl.org/dc/terms/created> "2026-07-01"^^xsd:date ;
                                                <http://purl.org/dc/terms/creator> "Elio Hbeich"@en ;
                                                <http://purl.org/dc/terms/description> "Ontology module for textile repairability-related product aspects, services, guidance, design features, contextual conditions, priority elements, assessments, repair-related process specialisations and their links to EU DPP product-event semantics. The module does not define a universal objective repairability score."@en ;
                                                <http://purl.org/dc/terms/issued> "2026-07-01"^^xsd:date ;
                                                <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                <http://purl.org/dc/terms/modified> "2026-07-16"^^xsd:date ;
                                                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                                <http://purl.org/dc/terms/title> "EU DPP Textile Repairability Ontology"@en ;
                                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "txtrep" ;
                                                <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/textile-repairability#" ;
                                                rdfs:comment "The JRC concludes that textile-apparel repairability cannot currently be represented by a simple objective framework. This ontology therefore represents evidence and enabling conditions without inferring that a product is objectively repairable."@en ,
                                                             "The module reuses the semantic product-event classes defined in the EU DPP EVENT module. Textile-specific life-extension event classes bridge those event semantics with concrete textile process executions; EPCIS technical carriers remain defined by the EVENT module."@en ;
                                                rdfs:label "EU DPP Textile Repairability Ontology"@en ;
                                                owl:versionInfo "Version 1.1.2" .

