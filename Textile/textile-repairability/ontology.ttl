###  https://w3id.org/eudpp/textile-repairability#DisassemblyFeature
:DisassemblyFeature rdf:type owl:Class ;
                    rdfs:subClassOf :RepairabilityDesignFeature ;
                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                    rdfs:comment "Design feature describing whether a product or relevant element can be taken apart for repair, upgrade, refurbishment or remanufacturing."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                    rdfs:label "Disassembly feature"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11283; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11378-11386; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11649-11658."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


