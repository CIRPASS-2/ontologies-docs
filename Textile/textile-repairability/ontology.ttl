###  https://w3id.org/eudpp/textile-repairability#addressesFailureMode
:addressesFailureMode rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( <https://w3id.org/eudpp/textile-process#TextileProcessExecution>
                                                  :PriorityRepairElement
                                                )
                                  ] ;
                      rdfs:range <https://w3id.org/eudpp/textile-durability#FailureMode> ;
                      <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                      rdfs:comment "Relates a concrete repair-related process execution or priority element to a textile failure mode that it addresses."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                      rdfs:label "addresses failure mode"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#assessesRepairabilityOf
:assessesRepairabilityOf rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <https://w3id.org/eudpp/textile-assessment#assessesProduct> ;
                         rdfs:domain :RepairabilityAssessment ;
                         rdfs:range <https://w3id.org/eudpp/textile-core#TextileApparel> ;
                         <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                         rdfs:comment "Relates a repairability assessment execution to the textile apparel it assesses."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                         rdfs:label "assesses repairability of"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#considersProcessType
:considersProcessType rdf:type owl:ObjectProperty ;
                      rdfs:domain :RepairabilityAssessment ;
                      rdfs:range [ rdf:type owl:Class ;
                                   owl:unionOf ( <https://w3id.org/eudpp/textile-process#RepairProcess>
                                                 :RepairRelatedProcess
                                               )
                                 ] ;
                      <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                      rdfs:comment "Relates a repairability assessment to a repair or other repair-related life-extension process type considered by the assessment."@en ;
                      rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                      rdfs:label "considers process type"@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                      <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#considersRepairService
:considersRepairService rdf:type owl:ObjectProperty ;
                        rdfs:domain :RepairabilityAssessment ;
                        rdfs:range :RepairService ;
                        <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                        rdfs:comment "Relates a repairability assessment to a repair service evaluated or considered as evidence."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                        rdfs:label "considers repair service"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3474-3476; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#coversPriorityElementType
:coversPriorityElementType rdf:type owl:ObjectProperty ;
                           rdfs:domain :RepairGuidance ;
                           rdfs:range :PriorityRepairElementTypeConcept ;
                           <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                           rdfs:comment "Relates repair guidance to a controlled priority-element type covered by the guidance."@en ;
                           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                           rdfs:label "covers priority element type"@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Section 9.2.3.1, printed page 128, lines 3416-3421; Section 9.2.3.3, Table 48, printed page 130, caption at line 3482."@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#hasDesignFeature
:hasDesignFeature rdf:type owl:ObjectProperty ;
                  rdfs:domain :RepairabilityAssessment ;
                  rdfs:range :RepairabilityDesignFeature ;
                  <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                  rdfs:comment "Relates a repairability assessment to a design feature considered in the assessment."@en ;
                  rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                  rdfs:label "has repairability design feature"@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11290; JRC Preparatory Study, Section 9.2.3.1, printed page 127, lines 3362-3375."@en ;
                  <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#hasElementType
:hasElementType rdf:type owl:ObjectProperty ;
                rdfs:domain :PriorityRepairElement ;
                rdfs:range :PriorityRepairElementTypeConcept ;
                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                rdfs:comment "Assigns a controlled element type to a priority repair element role."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                rdfs:label "has priority repair element type"@en ;
                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658."@en ;
                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#hasInteractiveRepairSupport
:hasInteractiveRepairSupport rdf:type owl:ObjectProperty ;
                             rdfs:domain :RepairService ;
                             rdfs:range :InteractiveRepairSupport ;
                             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                             rdfs:comment "Relates a repair service to interactive real-time repair support."@en ;
                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                             rdfs:label "has interactive repair support"@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#hasLifeExtensionInterventionAspect
:hasLifeExtensionInterventionAspect rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf <https://w3id.org/eudpp#hasProperty> ;
                                    rdfs:domain <https://w3id.org/eudpp/textile-core#TextileApparel> ;
                                    rdfs:range :LifeExtensionInterventionAspect ;
                                    <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                                    rdfs:comment "Relates textile apparel to a repairability-related product aspect."@en ;
                                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                                    rdfs:label "has life-extension intervention aspect"@en ;
                                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#hasPriorityRepairElement
:hasPriorityRepairElement rdf:type owl:ObjectProperty ;
                          rdfs:domain :RepairabilityAssessment ;
                          rdfs:range :PriorityRepairElement ;
                          <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                          rdfs:comment "Relates a repairability assessment to a priority repair element considered in the assessment."@en ;
                          rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                          rdfs:label "has priority repair element"@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11284-11290; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11381-11385; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11655-11658."@en ;
                          <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#hasRepairActionType
:hasRepairActionType rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <https://w3id.org/eudpp/textile-process#hasProcessMethod> ;
                     rdfs:domain <https://w3id.org/eudpp/textile-process#TextileProcessExecution> ;
                     rdfs:range :RepairActionTypeConcept ;
                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                     rdfs:comment "Relates a concrete repair process execution to a controlled repair-action method such as patching, mending, button replacement or zipper replacement."@en ;
                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                     rdfs:label "has repair action type"@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418."@en ;
                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#hasRepairActorType
:hasRepairActorType rdf:type owl:ObjectProperty ;
                    rdfs:domain <https://w3id.org/eudpp#Actor> ;
                    rdfs:range :RepairActorTypeConcept ;
                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                    rdfs:comment "Classifies a DPP actor by its role or category in textile repair."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                    rdfs:label "has repair actor type"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3436-3443."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#hasRepairCostCondition
:hasRepairCostCondition rdf:type owl:ObjectProperty ;
                        rdfs:domain :RepairabilityAssessment ;
                        rdfs:range :RepairCostCondition ;
                        <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                        rdfs:comment "Relates a repairability assessment to the repair-cost condition considered."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                        rdfs:label "has repair cost condition"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3429-3435; JRC Preparatory Study, Section 9.2.3.3, printed page 129, lines 3477-3481."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#hasRepairCostToNewProductPriceRatio
:hasRepairCostToNewProductPriceRatio rdf:type owl:ObjectProperty ;
                                     rdfs:domain :RepairCostCondition ;
                                     rdfs:range <https://w3id.org/eudpp/textile-connector#QuantitativeValue> ;
                                     <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                     rdfs:comment "Relates a repair-cost condition to a dimensionless quantitative ratio between repair cost and the price of a comparable new product."@en ;
                                     rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                                     rdfs:label "has repair cost-to-new-product price ratio"@en ;
                                     <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3429-3435; JRC Preparatory Study, Section 9.2.3.3, printed page 129, lines 3477-3481."@en ;
                                     <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#hasRepairGuidance
:hasRepairGuidance rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <https://w3id.org/eudpp#hasProperty> ;
                   rdfs:domain <https://w3id.org/eudpp/textile-core#TextileApparel> ;
                   rdfs:range :RepairGuidance ;
                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                   rdfs:comment "Relates textile apparel to repair guidance or repair-support information."@en ;
