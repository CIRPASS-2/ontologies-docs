###  https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect
:LifeExtensionInterventionAspect rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/eudpp#Property> ;
                                 <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                 rdfs:comment "Product aspect concerning intervention-based extension or restoration of textile-product use, functionality or value through repair, upgrade, refurbishment or remanufacturing. It is an organising class and not a score."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                                 rdfs:label "Life-extension intervention aspect"@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831."@en ;
                                 <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#LifeExtensionProductEvent
:LifeExtensionProductEvent rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/eudpp#ProductEvent> ,
                                           <https://w3id.org/eudpp/textile-process#TextileProcessExecution> ;
