                rdfs:comment "Information or instructions supporting repair of textile apparel or common damaged elements. Guidance may be physical or digital and is distinct from the repair service and the repair operation."@en ;
                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                rdfs:label "Repair guidance"@en ;
