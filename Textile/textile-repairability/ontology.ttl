                                   <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#Repairability
:Repairability rdf:type owl:Class ;
               rdfs:subClassOf :LifeExtensionInterventionAspect ;
               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
               rdfs:comment "Ability of a defective product or waste object to return, through one or more actions, to a condition in which it fulfils its intended use. For textile apparel, user acceptance of restored functionality and potentially changed aesthetics is contextually relevant."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
               rdfs:label "Repairability"@en ;
               <https://w3id.org/eudpp/textile-connector#modellingNote> "Repair may extend product use, but the outcome depends on failure type, service availability, cost, user acceptance and the effectiveness of the intervention; no deterministic inference is asserted."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11273-11279; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> ;
               <https://w3id.org/eudpp/textile-connector#typicallyContributesTo> <https://w3id.org/eudpp/textile-durability#Durability> .


###  https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment
:RepairabilityAssessment rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentExecution> ;
                         <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                         rdfs:comment "Assessment execution that gathers contextual evidence about repairability-related product aspects, services, guidance, design features, priority elements, costs, spare-part availability and user acceptance. It does not itself constitute the result."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                         rdfs:label "Repairability assessment"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#RepairabilityAssessmentResult
:RepairabilityAssessmentResult rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentResult> ;
                               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                               rdfs:comment "Result produced by a repairability assessment. It records the evidence-based outcome and relevant service configuration without asserting a universal objective repairability score."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                               rdfs:label "Repairability assessment result"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition
:RepairabilityContextCondition rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentCondition> ;
                               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                               rdfs:comment "Assessment condition external to intrinsic product design that influences repair feasibility or the decision to repair."@en ;
                               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                               rdfs:label "Repairability contextual condition"@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476."@en ;
                               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature
:RepairabilityDesignFeature rdf:type owl:Class ;
                            rdfs:subClassOf <https://w3id.org/eudpp/textile-assessment#AssessmentElement> ;
                            <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                            rdfs:comment "Design-related feature that may enable repair, upgrade, refurbishment or remanufacturing, such as modularity, standardisation or disassembly."@en ;
                            rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                            rdfs:label "Repairability design feature"@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11290; JRC Preparatory Study, Section 9.2.3.1, printed page 127, lines 3362-3375."@en ;
                            <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#SparePartAvailabilityCondition
:SparePartAvailabilityCondition rdf:type owl:Class ;
                                rdfs:subClassOf :RepairabilityContextCondition ;
                                <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                rdfs:comment "Condition describing whether a suitable spare component or replacement element is available for a contemplated repair. Availability may depend on collections, styles, colours, logistics and actual expected use."@en ;
                                rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                                rdfs:label "Spare-part availability condition"@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3399-3408; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11291-11296."@en ;
                                <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-repairability#StandardisationFeature
:StandardisationFeature rdf:type owl:Class ;
                        rdfs:subClassOf :RepairabilityDesignFeature ;
                        <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                        rdfs:comment "Design feature by which components or interfaces are standardised in a way that may support replacement, repair or upgrade."@en ;
                        rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                        rdfs:label "Standardisation feature"@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831."@en ;
                        <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-repairability#TextileRefurbishmentEvent
:TextileRefurbishmentEvent rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/eudpp#RefurbishmentEvent> ,
                                           :LifeExtensionProductEvent ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/eudpp/textile-process#executesProcessType> ;
                                             owl:hasValue :RefurbishmentProcess
                                           ] ;
                           <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                             <https://w3id.org/eudpp/textile-event-mireot> ;
                           rdfs:comment "A concrete textile refurbishment occurrence that is both a textile process execution and an instance of the EU DPP RefurbishmentEvent semantics."@en ;
                           rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                           rdfs:label "Textile refurbishment event"@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11374-11400; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
                           <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#TextileRemanufacturingEvent
:TextileRemanufacturingEvent rdf:type owl:Class ;
                             rdfs:subClassOf <https://w3id.org/eudpp#RemanufacturingEvent> ,
                                             :LifeExtensionProductEvent ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <https://w3id.org/eudpp/textile-process#executesProcessType> ;
                                               owl:hasValue :RemanufacturingProcess
                                             ] ;
                             <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                               <https://w3id.org/eudpp/textile-event-mireot> ;
                             rdfs:comment "A concrete textile remanufacturing occurrence that is both a textile process execution and an instance of the EU DPP RemanufacturingEvent semantics."@en ;
                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                             rdfs:label "Textile remanufacturing event"@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, relevant section, printed pages 16-17, lines 222-225; JRC Preparatory Study, Section 13.10.1.13, printed pages 480-481, lines 11645-11673; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#TextileRepairEvent
:TextileRepairEvent rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/eudpp#RepairEvent> ,
                                    :LifeExtensionProductEvent ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty <https://w3id.org/eudpp/textile-process#executesProcessType> ;
                                      owl:hasValue <https://w3id.org/eudpp/textile-process#RepairProcess>
                                    ] ;
                    <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                      <https://w3id.org/eudpp/textile-event-mireot> ;
                    rdfs:comment "A concrete textile repair occurrence that is both a textile process execution and an instance of the EU DPP RepairEvent semantics."@en ;
                    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                    rdfs:label "Textile repair event"@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11273-11279; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
                    <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#TextileUpgradingEvent
:TextileUpgradingEvent rdf:type owl:Class ;
                       rdfs:subClassOf <https://w3id.org/eudpp#UpgradingEvent> ,
                                       :LifeExtensionProductEvent ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <https://w3id.org/eudpp/textile-process#executesProcessType> ;
                                         owl:hasValue :UpgradeProcess
                                       ] ;
                       <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ,
                                                         <https://w3id.org/eudpp/textile-event-mireot> ;
                       rdfs:comment "A concrete textile upgrading occurrence that is both a textile process execution and an instance of the EU DPP UpgradingEvent semantics."@en ;
                       rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                       rdfs:label "Textile upgrading event"@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831."@en ;
                       <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


###  https://w3id.org/eudpp/textile-repairability#Upgradability
:Upgradability rdf:type owl:Class ;
               rdfs:subClassOf :LifeExtensionInterventionAspect ;
               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
               rdfs:comment "Ability of a product to be accessible for actions that enhance functionality, performance, capacity, safety or aesthetics."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
               rdfs:label "Upgradability"@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 9.1.2, printed pages 101-102, lines 2722-2728; JRC Preparatory Study, Section 13.10.1.4, printed page 472, lines 11264-11272; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-repairability#UpgradeProcess
:UpgradeProcess rdf:type owl:Class ;
                rdfs:subClassOf :RepairRelatedProcess .


###  https://w3id.org/eudpp/textile-repairability#UserAcceptanceCondition
:UserAcceptanceCondition rdf:type owl:Class ;
                         rdfs:subClassOf :RepairabilityContextCondition ;
                         <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                         rdfs:comment "Contextual condition concerning whether a user accepts the restored function and potentially changed aesthetics of the product after repair."@en ;
                         rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                         rdfs:label "User acceptance condition"@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3419-3428."@en ;
                         <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-repairability#UserAcceptanceStatusConcept
:UserAcceptanceStatusConcept rdf:type owl:Class ;
                             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ,
                                             <https://w3id.org/eudpp/textile-assessment#RatingValueConcept> ;
                             <http://purl.org/dc/terms/source> <https://w3id.org/eudpp/textile-ontology> ;
                             rdfs:comment "Controlled rating-value concept describing the recorded acceptance status of a repaired product in a stated assessment context."@en ;
                             rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                             rdfs:label "User acceptance status concept"@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceLocator> "CIRPASS Textile Ontology modelling specification, version 1.1.0."@en ;
                             <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#modellingAbstraction> .


