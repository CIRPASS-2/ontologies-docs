###  https://w3id.org/eudpp/textile-repairability#RepairService
:RepairService rdf:type owl:Class ;
               <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
               rdfs:comment "Service that performs, organises or supports textile repair interventions, including company-provided, independent professional and community-supported repair."@en ;
               rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
               rdfs:label "Repair service"@en ;
               <https://w3id.org/eudpp/textile-connector#sourceLocator> "JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3474-3476; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482."@en ;
               <https://w3id.org/eudpp/textile-connector#sourceType> <https://w3id.org/eudpp/textile-connector#adaptedDefinition> .


###  https://w3id.org/eudpp/textile-repairability#RepairServiceConfigurationConcept
:RepairServiceConfigurationConcept rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ,
                                                   <https://w3id.org/eudpp/textile-assessment#RatingValueConcept> ;
                                   <http://purl.org/dc/terms/source> <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf> ;
                                   rdfs:comment "SKOS concept representing a BC, BAT or BNAT repair-service and guidance configuration from JRC Table 48."@en ;
                                   rdfs:isDefinedBy <https://w3id.org/eudpp/textile-repairability> ;
                                   rdfs:label "Repair service configuration concept"@en ;
