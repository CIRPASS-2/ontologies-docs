  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#Repairability">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Ability of a defective product or waste object to return, through one or more actions, to a condition in which it fulfils its intended use. For textile apparel, user acceptance of restored functionality and potentially changed aesthetics is contextually relevant.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Repairability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect"/>
    <txtcon:modellingNote xml:lang="en">Repair may extend product use, but the outcome depends on failure type, service availability, cost, user acceptance and the effectiveness of the intervention; no deterministic inference is asserted.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 15-16, lines 218-222; JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11273-11279; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicallyContributesTo rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#RemanufacturingPossibility">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Possibility of producing a new product from waste objects, products or components through actions involving at least one change that may affect the product performance, purpose or type.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Possibility of remanufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#LifeExtensionInterventionAspect"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed pages 16-17, lines 222-225; JRC Preparatory Study, Section 13.10.1.13, printed pages 480-481, lines 11645-11673; JRC Preparatory Study, relevant section, Table 2, printed page 15; caption line 219.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
