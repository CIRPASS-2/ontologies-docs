>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Design-related feature that may enable repair, upgrade, refurbishment or remanufacturing, such as modularity, standardisation or disassembly.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Repairability design feature</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentElement"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11290; JRC Preparatory Study, Section 9.2.3.1, printed page 127, lines 3362-3375.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#usesReusableTextileInput">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a refurbishment or remanufacturing execution to a textile product used as reusable input, including a product used as a component of another product.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">uses reusable textile input</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-process#usesInput"/>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1.7, printed pages 473-475, lines 11280-11386.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#DisassemblyFeature">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Design feature describing whether a product or relevant element can be taken apart for repair, upgrade, refurbishment or remanufacturing.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Disassembly feature</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11283; JRC Preparatory Study, Section 13.10.1.7, printed page 475, lines 11378-11386; JRC Preparatory Study, Section 13.10.1.13, printed page 480, lines 11649-11658.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#usesSpareComponent">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a concrete repair-related process execution to a replacement non-textile component used during the intervention.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">uses spare component</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#NonTextileComponent"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-process#usesInput"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3399-3408; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11291-11296.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Assessment condition external to intrinsic product design that influences repair feasibility or the decision to repair.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Repairability contextual condition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentCondition"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3466-3476.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#hasDesignFeature">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a repairability assessment to a design feature considered in the assessment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessment"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">has repairability design feature</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11280-11290; JRC Preparatory Study, Section 9.2.3.1, printed page 127, lines 3362-3375.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability">
    <dcterms:bibliographicCitation xml:lang="en">EU DPP Textile Repairability Ontology. Version 2.0.0 candidate.</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-01</dcterms:created>
    <dcterms:creator xml:lang="en">Andreas Schneider</dcterms:creator>
    <dcterms:creator xml:lang="en">BOUGACHA Racem</dcterms:creator>
    <dcterms:creator xml:lang="en">Elio Hbeich</dcterms:creator>
    <dcterms:creator xml:lang="en">Ivo Ladenius</dcterms:creator>
    <dcterms:creator xml:lang="en">Jan Merckx</dcterms:creator>
    <dcterms:creator xml:lang="en">Piero de Sabbata</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology module for textile repairability-related product aspects, services, guidance, design features, contextual conditions, priority elements, assessments, repair-related process specialisations and their links to EU DPP product-event semantics. The module does not define a universal objective repairability score.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-01</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:title xml:lang="en">EU DPP Textile Repairability Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>txtrep</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-repairability#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">The JRC concludes that textile-apparel repairability cannot currently be represented by a simple objective framework. This ontology therefore represents evidence and enabling conditions without inferring that a product is objectively repairable.</rdfs:comment>
    <rdfs:comment xml:lang="en">The module reuses the semantic product-event classes defined in the EU DPP EVENT module. Textile-specific life-extension event classes bridge those event semantics with concrete textile process executions; EPCIS technical carriers remain defined by the EVENT module.</rdfs:comment>
    <rdfs:label xml:lang="en">EU DPP Textile Repairability Ontology</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-actor-mireot"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-core"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-event-mireot"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-process"/>
    <owl:priorVersion rdf:resource="https://w3id.org/eudpp/textile-repairability/1.1.2"/>
    <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-repairability/2.0.0"/>
    <owl:versionInfo>Version 2.0.0 candidate</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1c94eb3fd7c78d55a1dc95905092ccc2e86f9301e2c314f1fe5400eb6a9102193">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:hasValue rdf:resource="https://w3id.org/eudpp/textile-repairability#RemanufacturingProcess"/>
    <owl:onProperty rdf:resource="https://w3id.org/eudpp/textile-process#executesProcessType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#RepairRelatedProcess">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Textile process type related to upgrade, refurbishment or remanufacturing and organised with repair under the broader family of life-extension interventions. Concrete operations are represented as txtprc:TextileProcessExecution.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Repair-related life-extension process</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcess"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#hasRepairActionType">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a concrete repair process execution to a controlled repair-action method such as patching, mending, button replacement or zipper replacement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">has repair action type</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairActionTypeConcept"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-process#hasProcessMethod"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3, printed page 127, lines 3355-3360; JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#refersToTextileElement">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Links a priority repair element role to a textile product used as a component or repairable element, such as a fabric element.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#PriorityRepairElement"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">refers to textile element</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology 1.1.0, repair-element role modelling specification.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#hasRepairResponseTimeValue">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a repair service to a quantitative response-time value expressed with an SI time unit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairService"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">has repair response time value</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#SparePartAvailabilityCondition">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Condition describing whether a suitable spare component or replacement element is available for a contemplated repair. Availability may depend on collections, styles, colours, logistics and actual expected use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Spare-part availability condition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityContextCondition"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3399-3408; JRC Preparatory Study, Section 13.10.1.5, printed page 473, lines 11291-11296.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#repairCafeActor">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairActorTypeConcept"/>
    <rdfs:comment xml:lang="en">Community organisation, association or repair café supporting unpaid or assisted repair.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Repair café or community repair actor</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairActorTypeScheme"/>
    <skos:notation>REPAIR_ACTOR_REPAIR_CAFE</skos:notation>
    <skos:prefLabel xml:lang="en">Repair café or community repair actor</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairActorTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3436-3443.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#companyRepairActor">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairActorTypeConcept"/>
    <rdfs:comment xml:lang="en">Company or brand providing or organising repair services for textile apparel.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Company or brand repair actor</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairActorTypeScheme"/>
    <skos:notation>REPAIR_ACTOR_COMPANY</skos:notation>
    <skos:prefLabel xml:lang="en">Company or brand repair actor</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairActorTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3474-3476; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#providesGuidance">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a repair service to guidance made available through that service.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairService"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">provides guidance</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairGuidance"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.2, printed page 129, lines 3474-3476; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#canBeDisassembledWithoutDamage">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the assessed product or relevant element was found capable of disassembly without damage in the stated assessment context.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityAssessmentResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">can be disassembled without damage</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
