  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#LifeExtensionProductEvent">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-event-mireot"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A concrete textile process occurrence that is also interpreted as a product lifecycle event intended to extend, restore or substantially change the useful life, functionality or condition of a textile product.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Life-extension product event</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#ModularityFeature">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Design feature by which relevant product elements are modular, detachable or interchangeable in support of repair or upgrade.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Modularity feature</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairabilityDesignFeature"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.1.3, printed page 108, lines 2816-2831.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#isAvailableInWholeSalesRegion">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Indicates whether the repair service is available throughout the region in which the textile product is sold.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-repairability#RepairService"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">is available in whole sales region</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; JRC Preparatory Study, Section 9.2.3.3, Table 48, printed page 130; caption line 3482.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-repairability#RepairGuidance">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Information or instructions supporting repair of textile apparel or common damaged elements. Guidance may be physical or digital and is distinct from the repair service and the repair operation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Repair guidance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DocumentFormattedProperty"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.3.1, printed page 128, lines 3416-3418; JRC Preparatory Study, Section 9.2.3.3, printed pages 129-130, lines 3477-3483; Table 48, printed page 130, caption line 3482.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
