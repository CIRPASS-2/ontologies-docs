    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Result produced by a repairability assessment. It records the evidence-based outcome and relevant service configuration without asserting a universal objective repairability score.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-repairability"/>
    <rdfs:label xml:lang="en">Repairability assessment result</rdfs:label>
