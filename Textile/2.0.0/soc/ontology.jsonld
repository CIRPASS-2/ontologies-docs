  {
    "@id": "https://w3id.org/eudpp/textile-soc",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/bibliographicCitation": [
      {
        "@language": "en",
        "@value": "EU DPP Textile Ontology - Textile Substances of Concern Module. Version 2.0.0 candidate."
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-07-09"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@language": "en",
        "@value": "Andreas Schneider"
      },
      {
        "@language": "en",
        "@value": "BOUGACHA Racem"
      },
      {
        "@language": "en",
        "@value": "Elio Hbeich"
      },
      {
        "@language": "en",
        "@value": "Ivo Ladenius"
      },
      {
        "@language": "en",
        "@value": "Jan Merckx"
      },
      {
        "@language": "en",
        "@value": "Piero de Sabbata"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Textile-sector specialisation of the EU DPP Substances of Concern ontology. It specialises substance presence, product location, concentration reporting, product-group qualification, thresholds and lifecycle handling for textile products."
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-07-09"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-10-27"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "http://data.europa.eu/eli/reg/2024/1781/oj"
      },
      {
        "@id": "https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"
      },
      {
        "@id": "https://w3id.org/eudpp/textile-ontology"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "EU DPP Textile Ontology - Textile Substances of Concern Module"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "txtsoc"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/eudpp/textile-soc#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "This module does not classify every textile chemical as a substance of concern. It specialises the generic SoC presence-context model for textile products and attaches textile-specific information to the occurrence, not globally to the chemical identity."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Textile substances of concern ontology"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://w3id.org/eudpp/textile-associated-materials"
      },
      {
        "@id": "https://w3id.org/eudpp/textile-con-mireot"
      },
      {
