      },
      {
        "@id": "https://w3id.org/eudpp/textile-soc-mireot"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/eudpp/textile-soc/2.0.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "Version 2.0.0 candidate"
      }
    ]
  },
  {
    "@id": "https://w3id.org/eudpp/textile-soc#hasConcentrationReportingLevel",
