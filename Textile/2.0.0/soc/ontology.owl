  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#hasApplicableRegulatoryThreshold">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/soc"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">This property indicates which regulatory thresholds are relevant for interpreting a reported concentration. It does not by itself express whether the threshold is met, exceeded, or violated.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">has applicable regulatory threshold</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp#ThresholdOfSubstanceOfConcern"/>
    <skos:definition xml:lang="en">Links a concentration information object to a regulatory threshold that is applicable for its interpretation.</skos:definition>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/eudpp/soc#hasApplicableRegulatoryThreshold"/>
    <txtcon:modellingNote xml:lang="en">Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Historical SOC 0.1.2, https://w3id.org/eudpp/soc#hasApplicableRegulatoryThreshold; local adaptation: docs/decisions/TXT-DEC-010.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
