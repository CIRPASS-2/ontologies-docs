    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Free-text description used because the JRC and ESPR do not define a controlled vocabulary or formal spatial model for location. This textual description may complement a structured reference to a product part.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-soc#LocationInformation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
