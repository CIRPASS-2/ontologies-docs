    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">is part of product</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
    <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-soc#hasPart"/>
