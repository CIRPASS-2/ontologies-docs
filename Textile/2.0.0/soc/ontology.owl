    <rdfs:subClassOf rdf:nodeID="cb325c2387e832c80df2e3ca45a76ad9404ca3e063e5b6d100cc8a93ae0860c4fa8"/>
    <skos:definition xml:lang="en">A contextual regulatory evaluation in which a reported concentration is compared with an applicable regulatory threshold.</skos:definition>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/eudpp/soc#ThresholdEvaluation"/>
    <txtcon:modellingNote xml:lang="en">Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted.</txtcon:modellingNote>
