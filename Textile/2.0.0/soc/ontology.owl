  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#TextileSoCLocationTypeConcept">
    <dcterms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
