    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Identifier used to match a substance against regulatory lists.</skos:definition>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/eudpp/soc#substanceIdentifier"/>
    <txtcon:modellingNote xml:lang="en">Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Historical SOC 0.1.2, https://w3id.org/eudpp/soc#substanceIdentifier; local adaptation: docs/decisions/TXT-DEC-010.md</txtcon:sourceLocator>
