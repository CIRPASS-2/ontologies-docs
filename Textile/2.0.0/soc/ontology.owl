  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#appliesToProduct">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">qualification applies to product</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
    <skos:definition xml:lang="en">Identifies the product to which a qualification assertion applies in this Textile reporting profile.</skos:definition>
    <txtcon:modellingNote xml:lang="en">Qualification applicability in the Textile SoC profile. This differs from dpp:appliesToProduct, whose domain is DigitalProductPassport. Always use the txtsoc prefix for qualification scope.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-010.md</txtcon:sourceLocator>
