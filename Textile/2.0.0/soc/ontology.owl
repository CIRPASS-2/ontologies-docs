  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#referenceVersion">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-soc#ExternalRegulatoryReference"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">referenceVersion</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A version recorded for an external regulatory reference.</skos:definition>
    <txtcon:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-010.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#LocationInformation">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/soc"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Information object attached to a SubstancePresenceContext in order to describe the reported location of the substance within the product. This class does not imply a formal spatial model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">Location information</rdfs:label>
    <skos:definition xml:lang="en">Contextual qualitative information describing where a substance is located within a product.</skos:definition>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/eudpp/soc#LocationInformation"/>
    <txtcon:modellingNote xml:lang="en">Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Historical SOC 0.1.2, https://w3id.org/eudpp/soc#LocationInformation; local adaptation: docs/decisions/TXT-DEC-010.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#nonTextileComponentLocation">
    <dcterms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-soc#TextileSoCLocationTypeConcept"/>
    <rdfs:comment xml:lang="en">The substance is located in a non-textile component such as a button, zipper, buckle, rivet, sequin or other hard component.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">Non-textile component location</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-soc#TextileSoCLocationTypeScheme"/>
    <skos:notation>LOC_NON_TEXTILE_COMPONENT</skos:notation>
    <skos:prefLabel xml:lang="en">Non-textile component location</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-soc#TextileSoCLocationTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#ConcentrationReferenceBasis">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/soc"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">ConcentrationReferenceBasis represents the denominator or reference scope used for concentration calculation, such as the final product mass, an article mass, a product part mass, or a material group mass. It is distinct from the reporting level and from the concrete product part to which the information may refer.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">concentration reference basis</rdfs:label>
    <skos:definition xml:lang="en">Reference basis against which a substance concentration is calculated or reported.</skos:definition>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/eudpp/soc#ConcentrationReferenceBasis"/>
    <txtcon:modellingNote xml:lang="en">Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Historical SOC 0.1.2, https://w3id.org/eudpp/soc#ConcentrationReferenceBasis; local adaptation: docs/decisions/TXT-DEC-010.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#InstructionType">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/soc"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">This class represents the kind of instruction expressed in the DPP information element.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">Instruction type</rdfs:label>
    <skos:definition xml:lang="en">Declared type of instruction according to the relevant lifecycle-related activity addressed by the information element.</skos:definition>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/eudpp/soc#InstructionType"/>
    <txtcon:modellingNote xml:lang="en">Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Historical SOC 0.1.2, https://w3id.org/eudpp/soc#InstructionType; local adaptation: docs/decisions/TXT-DEC-010.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#TextileConcentrationInformation">
    <dcterms:source rdf:resource="http://data.europa.eu/eli/reg/2024/1781/oj"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Concentration information for a substance present in a textile product, expressed at product, component, material-group or spare-part level as an exact value, maximum value or range.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">Textile concentration information</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern"/>
    <rdfs:subClassOf rdf:nodeID="cb253d71b91ca092150a02e1bfbd76bd4253149863e4cd822f2a180442df9fa6fda"/>
    <rdfs:subClassOf rdf:nodeID="cb471b70a660137461bc10eb0f933ef6e50234f05e91fb1db076a10c0ff4b26a32"/>
    <txtcon:sourceLocator xml:lang="en">Regulation (EU) 2024/1781, Article 7(5)(c)</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
