  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#hasPresenceUseCategory">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Classifies the textile chemical occurrence by whether it is associated with process use, intended performance use or unintended presence. The classification is attached to the occurrence rather than globally to the substance identity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-soc#TextileSubstanceOfConcernPresenceContext"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">has presence use category</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-associated-materials#TextileChemicalUseCategoryConcept"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 12.3, printed page 226, lines 6428-6455.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#isQualifiedBySVHCList">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/soc"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Links a SoC type (a) qualification to the external SVHC Candidate List used as qualification basis.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#SoCQualificationAssertion"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">is qualified by SVHC list</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-soc#SVHCCandidateList"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-soc#hasRegulatoryBasis"/>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/eudpp/soc#isQualifiedBySVHCList"/>
    <txtcon:modellingNote xml:lang="en">Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Historical SOC 0.1.2, https://w3id.org/eudpp/soc#isQualifiedBySVHCList; local adaptation: docs/decisions/TXT-DEC-010.md</txtcon:sourceLocator>
