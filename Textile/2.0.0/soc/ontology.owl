  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#substanceIdentifier">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/soc"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Functional interoperability property used for cross-checking against SVHC, CLP, POPs or other external references.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#Substance"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
