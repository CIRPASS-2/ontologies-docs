  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#hasConcentrationReferenceBasis">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/soc"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">This property clarifies the denominator or reference scope of the reported concentration. It is important because the regulatory interpretation of a concentration may differ depending on whether it is calculated against the final product, an article, a product part, or a material group.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#ConcentrationOfSubstanceOfConcern"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">has concentration reference basis</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-soc#ConcentrationReferenceBasis"/>
    <skos:definition xml:lang="en">Links a concentration information object to the reference basis used for calculating or reporting the concentration.</skos:definition>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/eudpp/soc#hasConcentrationReferenceBasis"/>
    <txtcon:modellingNote xml:lang="en">Definition/comment adapted from historical SOC 0.1.2. Local namespace, scope and CORE alignment are Textile decisions documented in docs/decisions/TXT-DEC-010.md; no equivalence to the historical resource is asserted.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Historical SOC 0.1.2, https://w3id.org/eudpp/soc#hasConcentrationReferenceBasis; local adaptation: docs/decisions/TXT-DEC-010.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
