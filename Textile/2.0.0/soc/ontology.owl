  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-soc#NonTextileComponentMaterialGroup">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A material grouping associated with one or more non-textile components, used as a location or concentration reference unit without treating the component itself as a material group.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <rdfs:label xml:lang="en">Non-textile component material group</rdfs:label>
