  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#AssessmentMethod">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Procedure or documented approach used to assess, observe, test, measure or evaluate a textile product or a durability-related performance parameter.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <rdfs:label xml:lang="en">Assessment method</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentElement"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3182-3184; JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5251-5279.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#hasThresholdValue">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a performance threshold to its quantitative comparison value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#PerformanceThreshold"/>
