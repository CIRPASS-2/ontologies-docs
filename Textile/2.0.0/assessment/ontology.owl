    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Scale used to interpret, classify or rate an assessment result.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <rdfs:label xml:lang="en">Interpretation scale</rdfs:label>
