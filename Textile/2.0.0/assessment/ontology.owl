  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment-codelists#ThresholdComparisonOperatorScheme">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary of comparison operators used by performance thresholds.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <rdfs:label xml:lang="en">Threshold comparison operator scheme</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#equalTo"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#greaterThan"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#greaterThanOrEqualTo"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#lessThan"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-assessment-codelists#lessThanOrEqualTo"/>
    <skos:prefLabel xml:lang="en">Threshold comparison operator scheme</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology 1.1.0, assessment threshold-comparison vocabulary specification.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#TestMethod">
