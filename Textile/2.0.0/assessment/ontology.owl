    <rdfs:label xml:lang="en">has rating value</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#RatingValueConcept"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5255-5279.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#AssessmentDecisionCriterion">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Criterion used to interpret, accept, reject, classify or otherwise decide on an assessment result.</rdfs:comment>
