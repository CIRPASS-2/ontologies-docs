    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Assessment method that applies a controlled experimental or inspection procedure to a durability-related performance parameter.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <rdfs:label xml:lang="en">Test method</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3182-3184; JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5260-5279.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
