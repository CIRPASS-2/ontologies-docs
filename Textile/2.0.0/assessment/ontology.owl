    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment">
    <dcterms:bibliographicCitation xml:lang="en">EU DPP Textile Assessment Ontology. Version 2.0.0 candidate.</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:created>
    <dcterms:creator xml:lang="en">Andreas Schneider</dcterms:creator>
    <dcterms:creator xml:lang="en">BOUGACHA Racem</dcterms:creator>
    <dcterms:creator xml:lang="en">Elio Hbeich</dcterms:creator>
    <dcterms:creator xml:lang="en">Ivo Ladenius</dcterms:creator>
    <dcterms:creator xml:lang="en">Jan Merckx</dcterms:creator>
    <dcterms:creator xml:lang="en">Piero de Sabbata</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology module for textile assessment methods, standards, executions, conditions, parameter settings, results, interpretation scales, endpoints and performance thresholds.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <dcterms:title xml:lang="en">EU DPP Textile Assessment Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>txtass</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-assessment#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Quantitative results, parameter settings and thresholds use txtcon:QuantitativeValue and SI Digital Framework units through the Textile Connector pattern.</rdfs:comment>
    <rdfs:comment xml:lang="en">The module separates reusable methods and standards, concrete assessment executions, and the results produced by those executions.</rdfs:comment>
    <rdfs:label xml:lang="en">EU DPP Textile Assessment Ontology</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <owl:priorVersion rdf:resource="https://w3id.org/eudpp/textile-assessment/1.1.2"/>
    <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-assessment/2.0.0"/>
    <owl:versionInfo>Version 2.0.0 candidate</owl:versionInfo>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#hasParameterValue">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a measurement parameter setting to its quantitative value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-assessment#MeasurementParameterSetting"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <rdfs:label xml:lang="en">has parameter value</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#RobustnessScoringMethod">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Robustness assessment method that maps test and inspection results to points and combines them into a robustness score.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <rdfs:label xml:lang="en">Robustness scoring method</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#RobustnessAssessment"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5251-5279; JRC Preparatory Study, Section 11.1.1.1, Table 71, printed page 186; caption line 5284.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#TestCondition">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Controlled assessment condition used in a test protocol, such as temperature, humidity, load, duration, washing cycle or abrasion cycle.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <rdfs:label xml:lang="en">Test condition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentCondition"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5260-5279.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#MeasurementParameterSetting">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Concrete assignment of a quantitative or controlled value to a measurement parameter in an assessment execution or protocol.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <rdfs:label xml:lang="en">Measurement parameter setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentElement"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-assessment#hasRatingValue">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
