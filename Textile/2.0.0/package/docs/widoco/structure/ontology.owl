<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:txtcon="https://w3id.org/eudpp/textile-connector#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricElasticity">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric structural characteristic denoting elastic behaviour of the fabric.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric elasticity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fabric elasticity may influence dimensional stability and wrinkle recovery; the relation depends on fibre composition, yarn structure and fabric construction.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Reconstructed concept added to support relations between fabric manufacturing methods, fabric structure and deformation performance.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 178-179, printed pages 488-490; captions at lines 11875 and 11877.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#DimensionalStability"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#Wrinkling"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnUniformity">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Yarn structural characteristic expressing uniformity in thickness and mass along the yarn length.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn uniformity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStructuralCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Yarn uniformity may contribute to fabric strength and regularity, but the relation depends on fabric structure and process conditions.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#FabricStrength"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#ResistanceCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Structural or material resistance characteristic, distinct from the observed degradation phenomenon itself.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Resistance characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Resistance characteristics are distinct from the observed degradation phenomena themselves. For example, pilling resistance is not the same as observed pilling.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Structural superclass introduced to organise the module; not necessarily a verbatim JRC term.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A property describing the structure, physical constitution, mechanical behaviour, tactile quality, visual quality or functional behaviour of a textile fibre, yarn, fabric or assembly.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Textile structure characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Modelled as a subclass of dpp:Property because instances are linked from products through a subproperty of dpp:hasProperty.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Structural characteristics are disjoint from observed performance parameters, degradation phenomena and failure modes. For example, pilling resistance is a structure/resistance characteristic, while pilling is an observed degradation phenomenon.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Structural superclass introduced to organise the module; not necessarily a verbatim JRC term.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">This is the top-level class for structural characteristics in the textile structure module. It should not be used for observed durability performance parameters themselves.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 177-182, printed pages 486-495; captions at lines 11873-11907.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#ThreadCount">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric construction characteristic expressing the number of threads per specified unit length in a woven fabric.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Thread count</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://w3id.org/eudpp/textile-process#TargetFabricDensity"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricConstructionCharacteristic"/>
    <skos:altLabel xml:lang="en">Number of threads</skos:altLabel>
    <skos:altLabel xml:lang="en">Thread density</skos:altLabel>
    <skos:relatedMatch rdf:resource="https://w3id.org/eudpp/textile-process#TargetFabricDensity"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Although the JRC uses the term thread count, its definition is a density per unit length. A quantitative value should therefore include a reciprocal-length unit rather than a dimensionless count.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Thread count is represented in TEXTILE_STRUCTURE as a fabric construction characteristic. The related process-side concept txtprc:TargetFabricDensity remains a fabric manufacturing parameter. The two concepts should not be merged automatically; one describes a product/fabric characteristic, the other a process parameter or target.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 493-494, lines 11902-11907; JRC Preparatory Study, relevant section, Table 182, printed page 302; caption line 9114.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricBreathability"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricHandle"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure">
    <dcterms:bibliographicCitation xml:lang="en">EU DPP Textile Structure Ontology. Version 2.0.0 candidate.</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:created>
    <dcterms:creator xml:lang="en">Andreas Schneider</dcterms:creator>
    <dcterms:creator xml:lang="en">BOUGACHA Racem</dcterms:creator>
    <dcterms:creator xml:lang="en">Elio Hbeich</dcterms:creator>
    <dcterms:creator xml:lang="en">Ivo Ladenius</dcterms:creator>
    <dcterms:creator xml:lang="en">Jan Merckx</dcterms:creator>
    <dcterms:creator xml:lang="en">Piero de Sabbata</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology module for characteristics of textile fibres, yarns, fabrics and assemblies. It separates characteristic types from quantitative or qualitative values and does not represent process settings, assessment results or observed degradation phenomena.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:title xml:lang="en">EU DPP Textile Structure Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>txtstr</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-structure#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Characteristic classes describe what is observed or declared about a fibre, yarn, fabric or assembly. Concrete numerical values are represented as txtcon:QuantitativeValue instances, while methods and results belong to Textile Assessment and process settings belong to Textile Process.</rdfs:comment>
    <rdfs:label xml:lang="en">EU DPP Textile Structure Ontology</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-core"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <owl:priorVersion rdf:resource="https://w3id.org/eudpp/textile-structure/1.1.2"/>
    <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-structure/2.0.0"/>
    <owl:versionInfo>Version 2.0.0 candidate</owl:versionInfo>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.2, pages 484-495, Tables 177-182, lines ending at 11874 and lines 11875-11920; Section 4.5, page 41, lines 1001-1037.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#ontologyModule"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cba5aa5631e58d41005347fae108c67800eebe441876ab565b0060e8ba963593e4">
    <rdf:first rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
    <rdf:rest rdf:nodeID="cb1501b739fc71815cb05b105d6a9135ba821707a6c7e7de8436591519c5d555d3e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#CutPrecision">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Assembly characteristic concerning precision of cutting or pattern construction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Cut precision</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Cut precision may influence assembly quality and seam performance, but it is reconstructed here mainly to prepare links with the future confectioning process model.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Reconstructed concept added to support future links with confectioning process and final product quality.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.2, Table 182, printed pages 494-495; table caption at line 11907; supporting text on printed page 495, lines 11927-11932.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#SeamStrength"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FibreSectionShape">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Structural fibre characteristic expressing the cross-sectional shape of textile fibres.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fibre section shape</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#StructuralFibreCharacteristic"/>
    <skos:altLabel xml:lang="en">Fibre cross-section shape</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnVisualCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Yarn characteristic concerning visible appearance or visual quality.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn visual characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This superclass was introduced to organise G-003 Yarn appearance without placing a yarn-level visual characteristic under a fibre-level visual characteristic.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricConstructionCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric structural characteristic concerning fabric construction, density, mass per area or arrangement of yarns/threads.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric construction characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This superclass distinguishes structural fabric characteristics from process parameters in TEXTILE_PROCESS. The same real-world quantity may be represented as a process target/parameter in TEXTILE_PROCESS and as a product/fabric characteristic in TEXTILE_STRUCTURE, but these roles should be kept explicit.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FibreStrength">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Mechanical fibre characteristic expressing resistance of fibres to tensile stress or breakage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fibre strength</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#MechanicalFibreCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fibre strength typically contributes to yarn strength as a mechanical input.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnHairiness"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FibreCleanliness">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fibre quality characteristic concerning impurities or foreign matter remaining in the fibre.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fibre cleanliness</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreQualityCharacteristic"/>
    <skos:editorialNote xml:lang="en">The term is named FibreCleanliness rather than FibreCleanness, following standard textile and English usage.</skos:editorialNote>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">A weak influence link from fibre cleanliness to yarn appearance is represented in this module. The corresponding link to fabric appearance remains pending until a fabric appearance target concept is introduced.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Fibre cleanliness is modelled as a fibre quality characteristic, not as a structural dimension such as length, fineness or section shape. Quantitative or qualitative measurements of contamination, trash content or impurity levels should be represented through assessment results.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricAppearance"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnAppearance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricDrape">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric behavioural characteristic concerning how a fabric hangs in three dimensions and adapts to contours.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric drape</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricBehaviouralCharacteristic"/>
    <skos:altLabel xml:lang="en">Drape</skos:altLabel>
    <skos:altLabel xml:lang="en">Drapeability</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fabric drape is modelled as a fabric behavioural characteristic. Concrete drape measurements, test methods or performance levels should be represented in TEXTILE_ASSESSMENT.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnHairiness">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Yarn structural characteristic concerning fibre ends and loops protruding from the yarn body.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn hairiness</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStructuralCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Table 180 identifies yarn hairiness as an unwanted yarn characteristic. It reports that hairiness decreases with increasing fibre length and fibre strength, while it may increase with fibre fineness after the optimal working range.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Yarn hairiness is modelled as a yarn structural characteristic rather than as an assessment result. Quantitative hairiness values, test methods or thresholds should be represented in the assessment module.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricTactileCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric-level characteristic concerning touch, hand-feel or perceived tactile behaviour.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric tactile characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This superclass organises G-006 Fabric handle / fabric softness without treating it as a purely structural dimension or as an assessment result.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnMechanicalCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Yarn characteristic concerning mechanical behaviour such as yarn strength or elasticity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn mechanical characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnCharacteristic"/>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FibreElasticity">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Mechanical fibre characteristic concerning deformation and recovery after removal of a load.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fibre elasticity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#MechanicalFibreCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fibre elasticity may influence wrinkling behaviour through recovery behaviour. The relation is context-dependent and mediated by fabric and garment structure.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#Wrinkling"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FibreQualityCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fibre characteristic concerning fibre quality conditions that are not purely structural, mechanical, physical or visual.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fibre quality characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This superclass was introduced to avoid forcing fibre cleanliness under a purely structural or visual fibre characteristic. It organises G-002 without changing the semantics of existing fibre characteristic subclasses.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#SeamStrength">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Assembly characteristic expressing the mechanical strength or integrity of a seam.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Seam strength</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Seam strength typically reduces the likelihood of seam-related failure modes and influences seam slippage behaviour.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.2, Table 182, printed pages 494-495; table caption at line 11907; supporting text on printed page 495, lines 11927-11932.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#SeamSlippage"/>
    <txtcon:typicallyReducesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#SeamFailure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricFunctionalCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric-level characteristic concerning functional performance relevant to use, comfort or intended application.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric functional characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This superclass keeps functional fabric characteristics out of TEXTILE_CORE and separate from observed durability parameters.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricHandle">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric tactile characteristic concerning softness, smoothness, flexibility and overall sensation when touched.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric handle</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricTactileCharacteristic"/>
    <skos:altLabel xml:lang="en">Fabric hand</skos:altLabel>
    <skos:altLabel xml:lang="en">Fabric softness</skos:altLabel>
    <skos:altLabel xml:lang="en">Hand feel</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fabric handle is modelled as a fabric tactile characteristic, not as a simple fabric structural characteristic and not as an assessment result. Quantitative or qualitative measurements of softness, handle or touch should be represented through the assessment module when a concrete method or result is recorded.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Table 180 relates fabric softness or handle to fibre characteristics. The influence links are represented as weak annotation-level relations, not as deterministic OWL causal axioms.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnAppearance">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Yarn visual characteristic concerning diameter, hairiness, visible defects and overall appearance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn appearance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnVisualCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Quantitative or qualitative observations of yarn appearance should be represented through the assessment module when a concrete test, inspection or result is recorded.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Table 180 reports that yarn appearance improves with the increase of fibre cleanliness. Yarn appearance is therefore modelled as a yarn-level visual characteristic, not as a fibre characteristic and not as an assessment result.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricAppearance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnTactileCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Yarn characteristic concerning tactile or hand-feel behaviour.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn tactile characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnCharacteristic"/>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Characteristic of garment or textile assembly, including seams, sewing and cutting quality.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Assembly characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Structural superclass introduced to organise the module; not necessarily a verbatim JRC term.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Characteristic of an intermediate textile structure such as yarn, fabric, resistance property or assembly.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Intermediate textile characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Structural superclass introduced to organise the module; not necessarily a verbatim JRC term.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricRigidity">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric structural characteristic denoting rigidity or stiffness.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric rigidity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fabric rigidity may influence wrinkling and deformation behaviour, but the direction and acceptability depend on product type and fabric construction.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Reconstructed concept added to support relations between fabric manufacturing methods and fabric behaviour.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 178-179, printed pages 488-490; captions at lines 11875 and 11877.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#Wrinkling"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FibreLength">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Structural fibre characteristic expressing the length of textile fibres.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fibre length</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#StructuralFibreCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fibre length is modelled as typically influencing yarn strength through yarn structure. The relation should not be interpreted as a deterministic rule.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricHandle"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricLustre"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnHairiness"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnStrength"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#StructuralFibreCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fibre characteristic concerning fibre structure, morphology or geometry.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Structural fibre characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreCharacteristic"/>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnElasticity">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Yarn mechanical characteristic concerning the ability of yarn to deform and recover.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn elasticity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnMechanicalCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Reconstructed concept added to support process-related relations such as the effect of twist level on yarn elasticity.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Yarn elasticity may influence wrinkling and recovery behaviour, but the relation is mediated by fabric structure and garment construction.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#Wrinkling"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricBehaviouralCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric-level characteristic concerning the physical behaviour of a fabric under use, gravity, movement, care or stress conditions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric behavioural characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This superclass organises fabric drape without reducing it either to a purely structural dimension or to an assessment result.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#SewingCharacteristic">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Assembly characteristic concerning sewing quality or sewing-related construction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Sewing characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#AssemblyCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Reconstructed concept added to support future links with confectioning process and seam-related durability.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Sewing characteristics may influence seam strength and final product durability. Detailed process parameters should be represented in TEXTILE_PROCESS.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.2, Table 182, printed pages 494-495; table caption at line 11907; supporting text on printed page 495, lines 11927-11932.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#SeamStrength"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricStructuralCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Characteristic of fabric structure or fabric-level physical behaviour.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric structural characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Specific fabric structural characteristics are included as reconstructed or strongly implied concepts where needed to represent relations extracted from the JRC study.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FibreFineness">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Structural fibre characteristic expressing fibre fineness or linear density.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fibre fineness</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#StructuralFibreCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fibre fineness typically affects yarn uniformity and regularity, but the direction and magnitude depend on fibre type and process conditions.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricDrape"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricHandle"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricLustre"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnHairiness"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#YarnUniformity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#MechanicalFibreCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fibre characteristic concerning mechanical behaviour such as strength or elasticity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Mechanical fibre characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreCharacteristic"/>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricVisualCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric-level characteristic concerning visible appearance, lustre, shininess, sheen or other visual qualities.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric visual characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This superclass organises G-007 Fabric lustre / fabric shininess without treating it as a purely structural dimension or as an assessment result.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric-level characteristic relevant to durability, comfort, appearance or functional performance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This superclass avoids forcing tactile fabric properties such as fabric handle under a purely structural fabric category.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#hasCharacteristicValue">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile structure characteristic occurrence to a quantitative value containing a number and a measurement unit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">has characteristic value</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-002.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricAppearance">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric visual characteristic concerning the overall visible appearance or visual quality of a fabric.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric appearance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricVisualCharacteristic"/>
    <skos:altLabel xml:lang="en">Fabric visual appearance</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fabric appearance is represented as a fabric visual characteristic in TEXTILE_STRUCTURE. Observed changes in fabric appearance after use or cleaning cycles should be represented in TEXTILE_DURABILITY or TEXTILE_ASSESSMENT, not as the structural characteristic itself.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricBreathability">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric functional characteristic concerning the passage of water vapour through the fabric and evaporative cooling.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric breathability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricFunctionalCharacteristic"/>
    <skos:altLabel xml:lang="en">Air permeability</skos:altLabel>
    <skos:altLabel xml:lang="en">Breathability</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fabric breathability is represented in TEXTILE_STRUCTURE as a fabric-level functional characteristic, not as a TEXTILE_CORE product class and not as an assessment result.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Characteristic of a yarn that may influence fabric and product durability.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#IntermediateTextileCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">This class corresponds to the aggregated INT-001 concept. More specific yarn characteristics are represented as subclasses.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricMassPerUnitArea">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric construction characteristic expressing the mass of fabric per unit surface area.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric mass per unit area</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricConstructionCharacteristic"/>
    <skos:altLabel xml:lang="en">Fabric grammage</skos:altLabel>
    <skos:altLabel xml:lang="en">Fabric weight</skos:altLabel>
    <txtcon:modellingNote xml:lang="en">The preferred term uses mass rather than weight, following the technical note in JRC Section 2, page 14, footnote 15. Expected SI quantity kind: quantities:SUDE (surface density).</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 4.5, printed page 41, lines 1018-1020; JRC Preparatory Study, Section 13.10.2, printed pages 493-494, lines 11902-11915; Table 182, printed page 494, caption line 11907.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricBreathability"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricDrape"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-structure#FabricInsulation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnStrength">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Yarn mechanical characteristic expressing the ability of a yarn to withstand tensile force without breaking.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn strength</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnMechanicalCharacteristic"/>
    <skos:altLabel xml:lang="en">Yarn tenacity</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Yarn strength typically contributes to fabric strength, but the relation is mediated by fabric construction and processing.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#FabricStrength"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#characteristicOf">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile structure characteristic occurrence to the textile product that it describes, including a product used as a component of another product.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">characteristic of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
    <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-structure#hasStructuralCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 177-182, printed pages 486-495; captions at lines 11873-11907.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnStructuralCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Yarn characteristic concerning structural regularity or configuration.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn structural characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnCharacteristic"/>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#MoistureRetention">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Physical fibre characteristic concerning the capacity of fibres to absorb or retain moisture.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Moisture retention</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#PhysicalFibreCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 178-179, printed pages 488-490; captions at lines 11875 and 11877.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#hasTextualValue">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile structure characteristic occurrence to a free-text value when no controlled value list is available.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">has textual value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Controlled qualitative characteristic values may later be represented as SKOS concepts if required.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-005.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#hasStructuralCharacteristic">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile product, including a product used as a component of another product, to a textile structure characteristic occurrence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">has structural characteristic</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-structure#characteristicOf"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This property structures textile structure data in RDF/OWL; it is not claimed as a verbatim JRC relation.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.2, Tables 177-182, printed pages 486-495; captions at lines 11873-11907.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#PhysicalFibreCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fibre characteristic concerning physical behaviour such as moisture retention.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Physical fibre characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreCharacteristic"/>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricLustre">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric visual characteristic concerning the reflection of light that creates a shiny or glossy appearance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric lustre</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricVisualCharacteristic"/>
    <skos:altLabel xml:lang="en">Fabric luster</skos:altLabel>
    <skos:altLabel xml:lang="en">Fabric sheen</skos:altLabel>
    <skos:altLabel xml:lang="en">Fabric shininess</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Concrete observations or measurements of lustre, shininess or appearance should be represented through the assessment module when a test method, visual inspection protocol or measured value is recorded.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Table 180 reports that fabric shininess increases with the increase of fibre length and fibre fineness. Fabric lustre is modelled as a fabric visual characteristic, not as a structural dimension and not as an assessment result.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FibreCharacteristic">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A characteristic of a textile fibre that can influence yarn manufacture, fabric behaviour and durability-related performance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fibre characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#TextileStructureCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">This class corresponds to the aggregated MAT-001 concept. MAT-004 Fibre type is represented in TEXTILE_CORE through txt:FibreTypeConcept and txtcs:FibreTypeScheme, and used through txt:hasFibreType on txt:FibreCompositionComponent. It is therefore not duplicated as a textile structure class in this module.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">This is modelled as an OWL class because it is a semantic category and potential target of assessment/indicator relations, not merely a codelist value.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FibreColour">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Visual fibre characteristic concerning the colour of a fibre and its influence on dyeing or bleaching behaviour.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fibre colour</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#VisualFibreCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1, printed page 110, lines 2895-2900; Annex 13.10.2, Tables 177 and 180, printed pages 486-491; captions at lines 11873 and 11879; supporting text on printed page 484, lines 11853-11859.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#VisualFibreCharacteristic">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fibre characteristic concerning visual properties such as colour.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Visual fibre characteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FibreCharacteristic"/>
    <txtcon:sourceLocator xml:lang="en">Textile Structure modelling hierarchy, version 1.1.0; motivated by JRC Annex 13.10.2, Tables 177-182.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#FabricInsulation">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric functional characteristic concerning the retention of heat and reduction of heat transfer.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Fabric insulation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#FabricFunctionalCharacteristic"/>
    <skos:altLabel xml:lang="en">Insulation</skos:altLabel>
    <skos:altLabel xml:lang="en">Thermal insulation</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fabric insulation is represented as a fabric-level functional characteristic. Concrete insulation values or standard test results should be represented in TEXTILE_ASSESSMENT.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 488-491, lines 11875-11888; JRC Preparatory Study, relevant section, Table 178, printed page 302; caption line 9109.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-structure#YarnSoftness">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Yarn tactile characteristic concerning perceived softness or smoothness.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-structure"/>
    <rdfs:label xml:lang="en">Yarn softness</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-structure#YarnTactileCharacteristic"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.2, printed pages 492-493, lines 11889-11901; JRC Preparatory Study, relevant section, Table 181, printed page 302; caption line 9113.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
