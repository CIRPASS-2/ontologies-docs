<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:txtcon="https://w3id.org/eudpp/textile-connector#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector">
    <dcterms:bibliographicCitation xml:lang="en">EU DPP Textile Connector Ontology. Version 2.0.0 candidate.</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:created>
    <dcterms:creator xml:lang="en">Andreas Schneider</dcterms:creator>
    <dcterms:creator xml:lang="en">BOUGACHA Racem</dcterms:creator>
    <dcterms:creator xml:lang="en">Elio Hbeich</dcterms:creator>
    <dcterms:creator xml:lang="en">Ivo Ladenius</dcterms:creator>
    <dcterms:creator xml:lang="en">Jan Merckx</dcterms:creator>
    <dcterms:creator xml:lang="en">Piero de Sabbata</dcterms:creator>
    <dcterms:description xml:lang="en">Shared foundation and connector module for the EU DPP textile ontology network. It defines the common quantitative-value and reference-period patterns, the shared product-technology-level vocabulary, controlled provenance vocabularies, editorial annotations and weak cross-module annotation relations. Domain-specific operational relations remain in their domain modules.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <dcterms:title xml:lang="en">EU DPP Textile Connector Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>txtcon</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-connector#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Operational instance-level relations belong in the relevant domain module and are validated through SHACL.</rdfs:comment>
    <rdfs:comment xml:lang="en">Relation polarity is not represented as a direct annotation on a source class because one class may have several outgoing weak relations with different directions. Edge-level polarity and evidence remain in the canonical relation register until a statement-level representation is adopted.</rdfs:comment>
    <rdfs:comment xml:lang="en">The BC/BAT/BNAT product-technology axis is shared here because it is used by more than one textile aspect module. Aspect-specific configurations remain in their own module and map to the shared level rather than duplicating it.</rdfs:comment>
    <rdfs:comment xml:lang="en">The common ReferencePeriod pattern is infrastructure only; domain modules retain their own hasReferencePeriod relations.</rdfs:comment>
    <rdfs:comment xml:lang="en">The connector is intentionally dependency-light: it imports the BIPM SI Reference Point but no textile domain module. SKOS terms are referenced directly through their standard W3C IRIs.</rdfs:comment>
    <rdfs:comment xml:lang="en">The quantitative-value pattern links numerical values to BIPM SI measurement-unit and quantity-kind resources without recreating SI terms.</rdfs:comment>
    <rdfs:comment xml:lang="en">The typical relation properties are annotation properties for contextual class-level or concept-level statements. They do not assert deterministic causal axioms.</rdfs:comment>
    <rdfs:comment xml:lang="en">Working extraction identifiers are maintained in the crosswalk documentation rather than stabilised as ontology annotations.</rdfs:comment>
    <rdfs:label xml:lang="en">EU DPP Textile Connector Ontology</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-si-mireot"/>
    <owl:priorVersion rdf:resource="https://w3id.org/eudpp/textile-connector/1.1.2"/>
    <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-connector/2.0.0"/>
    <owl:versionInfo>Version 2.0.0 candidate</owl:versionInfo>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#ontologyModule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#typicallyReducesLikelihoodOf">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Weak annotation relation indicating that a source entity typically reduces the likelihood of a target degradation phenomenon, failure mode, damage mechanism or adverse outcome.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">typically reduces likelihood of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"/>
    <txtcon:modellingNote xml:lang="en">This property is appropriate for protective or mitigating links. It should not be interpreted as a guarantee of prevention.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#adaptedDefinition">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="en">The concept is source-supported, but the ontology definition has been shortened, normalised or adapted.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Adapted definition</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-connector#SourceTypeScheme"/>
    <skos:prefLabel xml:lang="en">Adapted definition</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-connector#SourceTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Controlled concept classifying a product technology as base case, best available technology or best not-yet-available technology.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Product technology level concept</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <txtcon:modellingNote xml:lang="en">This shared class prevents aspect modules from recreating the same BC/BAT/BNAT axis. Aspect-specific profiles may map to one of its concepts without becoming equivalent to that generic level.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 17, lines 228-235.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#reconstructedEvidence">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="en">The concept, hierarchy or relation was reconstructed from several source statements or analytical artefacts.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Reconstructed evidence</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme"/>
    <skos:prefLabel xml:lang="en">Reconstructed evidence</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#explicitEvidence">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="en">The source explicitly states the concept or relation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Explicit evidence</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme"/>
    <skos:prefLabel xml:lang="en">Explicit evidence</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#contextDependentEvidence">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="en">The evidence depends on product, material, process, method or use context.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Context-dependent evidence</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme"/>
    <skos:prefLabel xml:lang="en">Context-dependent evidence</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#QuantitativeValue">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A numerical value expressed using a measurement unit and, when useful, a kind of quantity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Quantitative value</rdfs:label>
    <txtcon:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-001.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#projectDecision">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="en">The resource results from an explicit project modelling or governance decision.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Project decision</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-connector#SourceTypeScheme"/>
    <skos:prefLabel xml:lang="en">Project decision</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-connector#SourceTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#EvidenceStatusScheme">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:comment xml:lang="en">Controlled categories describing the evidential status of weak ontology statements.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Evidence status scheme</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-connector#contextDependentEvidence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-connector#implicitEvidence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-connector#stronglyImpliedEvidence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-connector#supportingEvidence"/>
    <skos:prefLabel xml:lang="en">Evidence status scheme</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#modellingAbstraction">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="en">The ontology introduces a structure needed to represent source information correctly.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Modelling abstraction</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-connector#SourceTypeScheme"/>
    <skos:prefLabel xml:lang="en">Modelling abstraction</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-connector#SourceTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#hasMeasurementUnit">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a quantitative value to the measurement unit used to express it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">has measurement unit</rdfs:label>
    <rdfs:range rdf:resource="https://si-digital-framework.org/SI#MeasurementUnit"/>
    <txtcon:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-001.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#altLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#adaptedRelation">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="en">The relation is source-supported, but its ontology formulation has been normalised or adapted.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Adapted relation</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-connector#SourceTypeScheme"/>
    <skos:prefLabel xml:lang="en">Adapted relation</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-connector#SourceTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#typicallyContributesTo">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Weak annotation relation indicating that a source entity typically contributes to, supports or participates in the realisation of a target characteristic, performance aspect or outcome.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">typically contributes to</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-connector#typicalInfluenceOn"/>
    <txtcon:modellingNote xml:lang="en">This is a specialised form of typical influence. It should not be interpreted as a necessary or sufficient condition.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-006.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#bestNotYetAvailableTechnologyLevel">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept"/>
    <rdfs:comment xml:lang="en">Product technology with ambitious performance that is not yet implemented at scale and is therefore not considered available on the market.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Best not-yet-available technology level</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelScheme"/>
    <skos:notation>BNAT</skos:notation>
    <skos:prefLabel xml:lang="en">Best not-yet-available technology level</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 2, printed page 17, lines 228-235.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#periodStart">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Start date and time of a reference period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-connector#ReferencePeriod"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">period start</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#numericValue">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Relates a quantitative value to its numerical component.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">numeric value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <txtcon:sourceLocator xml:lang="en">docs/decisions/TXT-DEC-001.md</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-connector#bestAvailableTechnologyLevel">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelConcept"/>
    <rdfs:comment xml:lang="en">Product technology with ambitious performance that is available on the market and implemented at scale.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <rdfs:label xml:lang="en">Best available technology level</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-connector#ProductTechnologyLevelScheme"/>
    <skos:notation>BAT</skos:notation>
