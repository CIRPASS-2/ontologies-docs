  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#StructuralFailureMode">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of failure modes primarily affecting structure, integrity or dimensional behaviour.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Structural failure mode</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#typicalFailureExpression">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Annotation used at class level to document the usual failure expression of an observed performance parameter without imposing an OWL existential restriction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">typical failure expression</rdfs:label>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-associated-materials-codelists#uvAbsorberOrStabiliser">
    <txtcon:typicallyReducesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#RadiationInducedDegradation"/>
