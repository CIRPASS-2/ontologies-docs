<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:txtcon="https://w3id.org/eudpp/textile-connector#"
   xmlns:txtdur="https://w3id.org/eudpp/textile-durability#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#LossOfComfort">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Functional failure mode corresponding to loss of comfort or comfort-related suitability during use, maintenance or ageing.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Loss of comfort</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FunctionalFailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Loss of comfort is kept as a functional failure mode. Specific causes may include roughness, stiffness, loss of elasticity, poor breathability, poor insulation or other context-dependent phenomena.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#Discolouration">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Kept distinct from colour fading because discolouration may be localised, irregular or caused by specific use or exposure conditions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Discolouration</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualFailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11093.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#TearOrRip">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Mechanical failure mode involving rupture, tearing or ripping of textile material under stress, snagging or damage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Tear or rip</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#MechanicalFailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Annex 13.10.1.1, printed page 469, lines 11090-11091.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#AccidentalDamage">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">External damage occurring during use, such as accidental tearing, ripping or staining, which may lead to product rejection or disposal.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Accidental damage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ExternalDamage"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Accidental damage may result in tear or rip, but this is not a necessary relation in every case.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11090-11091.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtdur:typicalProgressionTo rdf:resource="https://w3id.org/eudpp/textile-durability#TearOrRip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ElasticityLoss">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Structural failure mode corresponding to loss of elasticity, elastic recovery or stretch-related functionality of a textile product or fabric.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Elasticity loss</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
    <skos:altLabel xml:lang="en">Loss of elasticity</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Elasticity loss is kept distinct from loss of dimensional stability. A product may lose elastic recovery without necessarily being described primarily as dimensionally unstable.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    <txtcon:typicallyIncreasesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#LossOfComfort"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#negativelyAffects">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Indicates that a failure mode, degradation phenomenon or damage negatively affects a durability-related aspect.</rdfs:comment>
    <rdfs:domain rdf:nodeID="cb68067f2b743e19efb21ee5d853c3161b0666d622a2f0455c63f429b69f182231"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">negatively affects</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#TrimFailure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Component failure mode involving failure of trims or auxiliary components associated with a textile product.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Trim failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ComponentFailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11094.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#Wrinkling">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Durability-related deformation behaviour describing the tendency of a textile material or product to form creases under use or after deformation and recovery cycles.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Wrinkling</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Wrinkling affects the interpretation of intrinsic durability depending on product type, use context and acceptable thresholds.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#VisualFailureMode">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of failure modes primarily affecting visible appearance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Visual failure mode</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#Pilling">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Observed surface degradation phenomenon involving the formation of small balls or pills of entangled fibres on a textile surface during wear, friction, use or testing.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Pilling</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Observed pilling may contribute to fabric breakdown as part of a progressive surface degradation process, but it should not be treated as the sole necessary cause of fabric breakdown.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Observed pilling negatively affects the interpretation of intrinsic durability; pilling resistance, if modelled separately, should be represented as a protective characteristic.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtdur:typicalProgressionTo rdf:resource="https://w3id.org/eudpp/textile-durability#FabricBreakdown"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#PillingResistance">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Durability-related performance characteristic describing the ability of a textile material, fabric or product to resist the formation of pills under friction, wear or use conditions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Pilling resistance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Pilling resistance is separated from Pilling.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtdur:typicalDegradationExpression rdf:resource="https://w3id.org/eudpp/textile-durability#Pilling"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#hasDegradationExpression">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a durability-related performance characteristic to a degradation phenomenon that expresses deterioration of that characteristic. This is an instance-level relation and is not a deterministic causal axiom.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">has degradation expression</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#LogoFailure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Logo failure may also be interpreted as a component-related failure depending on whether the logo is printed, embroidered or applied as a separate component. It is kept under visual failure mode in this module.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Logo failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualFailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11091-11092.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#TactileFailureMode">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of failure modes primarily affecting tactile perception, hand feel or comfort-related touch properties of a textile product or fabric.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Tactile failure mode</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Introduced to avoid forcing tactile failures such as rough or stiff fabric into purely visual or purely structural categories.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#SeamSlippage">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Durability-related assembly performance characteristic describing displacement of yarns at or near a seam under mechanical stress, which may lead to deformation or opening.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Seam slippage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#AssemblyPerformanceParameter"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Seam slippage negatively affects the interpretation of intrinsic durability as a loss of assembly performance.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of observed performance parameters related to deformation, shape retention or dimensional behaviour.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Deformation performance parameter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#FuzzingOrMatting">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Observed surface degradation phenomenon involving fuzzing or matting of the fabric surface. The term follows the JRC and ISO wording 'fuzzing or matting', not 'melting'.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Fuzzing or matting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon"/>
    <skos:altLabel xml:lang="en">Fabric fuzzing</skos:altLabel>
    <skos:altLabel xml:lang="en">Fabric matting</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">FuzzingOrMatting is not made a subclass of FailureMode because it is modelled following the existing pilling pattern as an observed degradation phenomenon used in performance inspection.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">The research gap used the wording 'fuzzing/melting', but the JRC and referenced ISO standards use fuzzing/matting. This ontology therefore introduces FuzzingOrMatting and avoids the unsupported term melting.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    <txtdur:typicalProgressionTo rdf:resource="https://w3id.org/eudpp/textile-durability#FabricBreakdown"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#MechanicalFailureMode">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of failure modes primarily involving rupture, tearing or mechanical damage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Mechanical failure mode</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#SeamFailure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Structural or assembly-related failure mode involving loss of seam integrity or seam functionality.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Seam failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 469, lines 11089-11094.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb0">
    <rdf:first rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
    <rdf:rest rdf:nodeID="cb1501b739fc71815cb05b105d6a9135ba821707a6c7e7de8436591519c5d555d3e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#FabricBreakdown">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Aggregated failure mode. It may be decomposed later into more specific phenomena such as fraying, thinning, localised wear or hole formation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Fabric breakdown</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11089-11093; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#RadiationInducedDegradation">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Degradation of textile material or product properties associated with ultraviolet or other relevant radiation exposure.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Radiation-induced degradation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ProductAgeing"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 12.3.16, printed page 254, lines 7150-7157.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#hasFailureMode">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile product to a failure mode observed, expected or considered relevant for that product.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">has failure mode</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#HoleInSeam">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Specific seam failure involving a hole or localised opening at or around a seam.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Hole in seam</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SeamFailure"/>
    <skos:altLabel xml:lang="en">Holes in seams</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11092-11093.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#SurfaceFailureMode">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of failure modes primarily affecting the textile surface. Borderline surface phenomena that are also assessed as performance parameters should remain under ObservedDegradationPhenomenon to preserve the module disjointness pattern.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Surface failure mode</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">This class is available for strict failure modes. Pilling and fuzzing/matting are intentionally kept as observed degradation phenomena when they are used as inspection parameters.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of observed performance parameters related to surface behaviour or surface degradation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Surface performance parameter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#IntrinsicDurability">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Durability construct based on the physical and measurable ability of a textile product to maintain relevant performance characteristics over time under specified use, maintenance or test conditions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Intrinsic durability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
    <skos:altLabel xml:lang="en">Physical durability</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#hasObservedPerformanceParameter">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile product to an observed performance parameter relevant to its durability assessment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">has observed performance parameter</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#DimensionalStability">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Observed performance parameter describing the ability of a textile product or fabric to retain its dimensions after use, laundering or other treatment cycles.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Dimensional stability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#DeformationPerformanceParameter"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Dimensional stability contributes to the interpretation of intrinsic durability; loss of dimensional stability is the corresponding failure expression.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Dimensional stability is the performance parameter; loss of dimensional stability is the corresponding failure expression.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Section 11.1.1.1, printed page 186, lines 5267-5273; Annex 13.10.1, printed page 469, lines 11089-11094.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtdur:typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Failure mode in which a fabric becomes or is perceived as rough, stiff or unpleasant to touch, affecting user acceptance and comfort-related use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Rough or stiff fabric</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#TactileFailureMode"/>
    <skos:altLabel xml:lang="en">Fabric roughness</skos:altLabel>
    <skos:altLabel xml:lang="en">Fabric stiffness</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">The concept is modelled as a tactile failure mode rather than as a structural characteristic. The corresponding structural or tactile fabric property remains outside this module.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    <txtcon:typicallyIncreasesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#LossOfComfort"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ColourFading">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Visual failure mode corresponding to progressive loss of colour intensity during use, washing, ageing or exposure.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Colour fading</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualFailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11089-11093; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2276-2279.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of observed performance parameters related to visual appearance or colour behaviour.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Visual performance parameter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#FabricSmoothness">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Observed performance parameter describing the visible or tactile smoothness of a fabric surface, commonly considered during visual inspection after washing, drying or other durability-related stress.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Fabric smoothness</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#SurfacePerformanceParameter"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"/>
    <skos:altLabel xml:lang="en">Surface smoothness</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fabric smoothness is represented as an observed performance parameter. A measured value or inspection grade should be represented in the assessment module, while rough or stiff fabric is modelled as a failure expression.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    <txtdur:typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#RoughOrStiffFabric"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#LossOfDimensionalStability">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Failure expression corresponding to loss of the ability of a textile product or fabric to retain its dimensions after use, laundering or treatment cycles.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Loss of dimensional stability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#StructuralFailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2277-2279; JRC Preparatory Study, Section 13.10.1.1, printed page 469, lines 11091-11092.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#FailureMode">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Failure modes are kept separate from observed performance parameters. For example, colour fastness is a parameter, while colour fading is a failure mode.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Failure mode</rdfs:label>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#FabricStrength">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Aggregated observed mechanical performance parameter describing the strength of a fabric, potentially covering tensile strength, tear strength or bursting strength depending on the test context.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Fabric strength</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Fabric strength contributes to the interpretation of intrinsic durability as an aggregated mechanical performance parameter.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Fabric strength is modelled as reducing the likelihood of tear or rip under comparable conditions, rather than as negatively affecting tear or rip.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicallyReducesLikelihoodOf rdf:resource="https://w3id.org/eudpp/textile-durability#TearOrRip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#AssemblyPerformanceParameter">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of observed performance parameters related to seams, assembly or garment construction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Assembly performance parameter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ExternalDamage">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Damage caused by external or accidental events during product use, not necessarily resulting from intrinsic lack of durability.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">External damage</rdfs:label>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#typicalProgressionTo">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Annotation used at class level to document a typical degradation progression without asserting a necessary causal relation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">typical progression to</rdfs:label>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#SurfaceDegradationPhenomenon">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Observed degradation phenomenon affecting the surface condition of a textile material or product, such as pilling, fuzzing or matting.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Surface degradation phenomenon</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Introduced to keep surface degradation phenomena separate from strict FailureMode, because the ontology declares FailureMode and ObservedPerformanceParameter disjoint at high level.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#hasObservedDegradationPhenomenon">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a product to a degradation phenomenon observed or considered relevant for that product. A concrete observation, test and result should be represented in the textile assessment module.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">has observed degradation phenomenon</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Durability-related product characteristic that can be observed, assessed or measured to evaluate physical durability. It denotes the characteristic type, not a test, observation, result or quantitative value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Observed performance parameter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Property"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1bffae0b7a7d35398b2acae27aba631a4b8a5af70b3cb61c539193613cf65bcd6">
    <rdf:first rdf:resource="https://w3id.org/eudpp/textile-durability#ExternalDamage"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#hasExternalDamage">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile product or product observation to external damage occurring during use.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">has external damage</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ExternalDamage"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ColourDepthEvenness">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Observed visual performance parameter describing the depth and evenness of colour in a textile product or fabric, especially in relation to dyeing and finishing quality.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Colour depth and evenness</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"/>
    <skos:altLabel xml:lang="en">Colour depth</skos:altLabel>
    <skos:altLabel xml:lang="en">Colour evenness</skos:altLabel>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Colour depth and evenness is distinct from colour fastness. Colour fastness concerns resistance to fading, running or alteration, whereas colour depth/evenness concerns the achieved visual colour quality.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
    <txtdur:typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#Discolouration"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ColourFastness">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Observed performance parameter describing the resistance of a textile colour to fading, running or alteration under conditions such as washing, rubbing, perspiration or light exposure.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Colour fastness</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#VisualPerformanceParameter"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Colour fastness is the resistance parameter; colour fading is a typical visual failure expression of its degradation.</txtcon:modellingNote>
    <txtcon:modellingNote xml:lang="en">Observed colour fastness contributes to the interpretation of intrinsic durability, while colour fading is a failure expression.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtdur:typicalFailureExpression rdf:resource="https://w3id.org/eudpp/textile-durability#ColourFading"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#typicalDegradationExpression">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Annotation used at class level to document a usual degradation expression of a durability-related performance characteristic without imposing a necessary OWL restriction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">typical degradation expression</rdfs:label>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cbb56c7c9b0751963ca43928a539dec044fa3caa55bb3ec2d9c3943b52cc4ce3a3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="cbb0d92f78c916d11cb391dc1af93910ee6c2d4ffdf7e347047f100b12aaa2628f"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb78520c5b0eb75793c47c4ee7fc2eb5a7833321255cdf8e8fa587ce318c5435c9">
    <rdf:first rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <rdf:rest rdf:nodeID="cba5aa5631e58d41005347fae108c67800eebe441876ab565b0060e8ba963593e4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1501b739fc71815cb05b105d6a9135ba821707a6c7e7de8436591519c5d555d3e">
    <rdf:first rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#Durability">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Ability of a product to maintain over time its function and performance under specified conditions of use, maintenance and repair.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Durability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#Durability"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Through the alignment txtdur:Durability rdfs:subClassOf dpp:Durability, this class inherits dpp:QualityIndicator and dpp:QuantitativeProperty. This is an inherited EU DPP Core commitment: it does not make a durability instance a numeric value. Numerical observations and results remain represented through Textile Assessment and txtcon:QuantitativeValue.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11067.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ProductAgeing">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Progressive change or degradation of textile product performance over time under repeated use, care, environmental exposure or stress.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Product ageing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1.3, printed pages 112-113, lines 2968-3010.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of observed performance parameters related to mechanical resistance or strength.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Mechanical performance parameter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ZipperFailure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Specific trim failure involving failure of a zipper or zip fastener.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Zipper failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#TrimFailure"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#implicitEvidence"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2273-2274.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability">
    <dcterms:bibliographicCitation xml:lang="en">EU DPP Textile Durability Ontology. Version 2.0.0 candidate.</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:created>
    <dcterms:creator xml:lang="en">Andreas Schneider</dcterms:creator>
    <dcterms:creator xml:lang="en">BOUGACHA Racem</dcterms:creator>
    <dcterms:creator xml:lang="en">Elio Hbeich</dcterms:creator>
    <dcterms:creator xml:lang="en">Ivo Ladenius</dcterms:creator>
    <dcterms:creator xml:lang="en">Jan Merckx</dcterms:creator>
    <dcterms:creator xml:lang="en">Piero de Sabbata</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology module for textile durability constructs, durability-related performance characteristics, degradation phenomena, external damage and failure modes. Test methods, observations, measurement results, thresholds and values remain in the textile assessment module.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <dcterms:title xml:lang="en">EU DPP Textile Durability Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>txtdur</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-durability#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Assessment methods, measurement results, thresholds and quantitative values are intentionally outside this module and should be represented in the textile assessment module.</rdfs:comment>
    <rdfs:comment xml:lang="en">If durability parameter names or failure-mode names are needed as controlled data values in application profiles, a separate SKOS codelist can be derived from this OWL hierarchy without replacing the OWL classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">ObservedDegradationPhenomenon is not declared disjoint with ObservedPerformanceParameter, because degradation phenomena such as pilling can also be handled as observed performance parameters in inspection contexts.</rdfs:comment>
    <rdfs:comment xml:lang="en">The alignment to dpp:Durability entails that textile durability is also a dpp:QualityIndicator and dpp:QuantitativeProperty. This inherited classification denotes a measurable quality characteristic and remains distinct from txtcon:QuantitativeValue.</rdfs:comment>
    <rdfs:comment xml:lang="en">The module covers tactile, functional, structural, visual and surface degradation concepts such as RoughOrStiffFabric, LossOfComfort, ElasticityLoss, FuzzingOrMatting, ColourDepthEvenness and FabricSmoothness.</rdfs:comment>
    <rdfs:comment xml:lang="en">The module keeps Durability and IntrinsicDurability as explicit OWL classes and represents observed performance parameters and failure modes as OWL classes rather than SKOS concepts.</rdfs:comment>
    <rdfs:comment xml:lang="en">This module represents durability constructs, observed performance parameter types and failure mode types as OWL classes. It intentionally does not introduce SKOS codelists for these concepts in the core ontology.</rdfs:comment>
    <rdfs:label xml:lang="en">EU DPP Textile Durability Ontology</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
    <owl:priorVersion rdf:resource="https://w3id.org/eudpp/textile-durability/1.1.2"/>
    <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-durability/2.0.0"/>
    <owl:versionInfo>Version 2.0.0 candidate</owl:versionInfo>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#AbrasionResistance">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Observed performance parameter describing the resistance of a textile material or product to wear caused by rubbing or abrasion.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Abrasion resistance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#MechanicalPerformanceParameter"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#explicitEvidence"/>
    <txtcon:modellingNote xml:lang="en">Observed abrasion resistance contributes to the interpretation of intrinsic durability but is not equivalent to intrinsic durability.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Annex 13.10.1, printed page 468, lines 11065-11071; Annex 13.4, Table 124, printed pages 362-367 where applicable.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#directExtraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ComponentFailureMode">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of failure modes affecting components or trims.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Component failure mode</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Observable phenomenon indicating physical deterioration of a textile material or product. It is distinct from the performance characteristic used to assess resistance to that deterioration.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Observed degradation phenomenon</rdfs:label>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#hasDurabilityAspect">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile product to a durability aspect relevant to its assessment or declaration.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">has durability aspect</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cba5aa5631e58d41005347fae108c67800eebe441876ab565b0060e8ba963593e4">
    <rdf:first rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
    <rdf:rest rdf:nodeID="cb1bffae0b7a7d35398b2acae27aba631a4b8a5af70b3cb61c539193613cf65bcd6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#FunctionalFailureMode">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Category of failure modes primarily involving loss of intended use, comfort or functional suitability of a textile product.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">Functional failure mode</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:evidenceStatus rdf:resource="https://w3id.org/eudpp/textile-connector#reconstructedEvidence"/>
    <txtcon:modellingNote xml:lang="en">Introduced to represent failure modes that are not adequately captured by visual, structural, mechanical or component failure categories alone.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#mayResultIn">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Indicates that external damage may result in a failure mode.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-durability#ExternalDamage"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">may result in</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-durability#hasFailureExpression">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates an observed performance parameter to a failure mode that expresses degradation or loss of that parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedPerformanceParameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <rdfs:label xml:lang="en">has failure expression</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cbb0d92f78c916d11cb391dc1af93910ee6c2d4ffdf7e347047f100b12aaa2628f">
    <rdf:first rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
