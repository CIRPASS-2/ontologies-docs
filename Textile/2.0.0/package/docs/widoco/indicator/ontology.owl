  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#PerformanceRetentionRate">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Calculated indicator expressing retained performance relative to an initial or reference performance value under stated calculation rules.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">Performance retention rate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5231-5243.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#derivedFrom">
