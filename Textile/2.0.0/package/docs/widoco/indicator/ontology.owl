    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates an indicator to an assessment result or another indicator used as evidence in its calculation, aggregation or interpretation.</rdfs:comment>
