  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#evaluatedAgainstThreshold">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates an indicator to a performance threshold used to interpret or classify its value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">evaluated against threshold</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-assessment#PerformanceThreshold"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#concernsDurabilityAspect">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates an indicator to the durability concept whose interpretation it supports.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">concerns durability aspect</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#concernsFailureMode">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates an indicator to a textile failure mode that it interprets or uses in its derivation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">concerns failure mode</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#FailureMode"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3177-3180.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#hasCategoricalValue">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates an indicator to a controlled categorical, ordinal or rating value represented as a SKOS concept.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">has categorical value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#LifetimeOfProduct">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Indicator expressing a stated, observed or inferred lifespan of a textile product using a specified lifespan descriptor and stated assumptions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">Lifetime of product</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#LifetimeIndicator"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 5.8, printed page 73, lines 1695-1710; JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3168-3181; JRC Preparatory Study, Section 5.8, Table 32, printed page 73; caption line 1703.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#RobustnessScore">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Score produced by a robustness scoring method from selected textile test and visual-inspection results; it is proxy information for physical durability and is not a service-lifetime value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">Robustness score</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.1, printed page 185, lines 5228-5246; JRC Preparatory Study, Section 11.1.1.1, printed pages 185-186, lines 5251-5286; JRC Preparatory Study, Section 11.1.1.1, Table 71, printed page 186; caption line 5284.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicallyContributesTo rdf:resource="https://w3id.org/eudpp/textile-durability#IntrinsicDurability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#concernsDegradationPhenomenon">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates an indicator to an observed textile degradation phenomenon that it interprets.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">concerns degradation phenomenon</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#ObservedDegradationPhenomenon"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#Indicator">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Derived information object used to calculate, interpret, aggregate, compare or communicate evidence about a textile product. An indicator is not the underlying assessment result, characteristic, threshold or quantitative value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">Indicator</rdfs:label>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#supportsAssessmentOf">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates an indicator to a durability concept whose assessment it supports without asserting equivalence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">supports assessment of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-durability#Durability"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
