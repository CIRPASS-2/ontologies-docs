  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#contributesToIndicator">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates an indicator to a broader indicator to which it contributes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">contributes to indicator</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#DegradationRate">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Calculated indicator expressing change in a performance parameter or degradation phenomenon per stated unit of time, use, cycle or exposure.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">Degradation rate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#PerformanceIndicator"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 11.1.1, printed page 185, lines 5231-5243.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#informsEstimateOf">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates supporting indicator evidence to a lifetime-of-product indicator whose value is inferred from that evidence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">informs estimate of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-indicator#LifetimeOfProduct"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.1.5, printed page 121, lines 3168-3181.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#isIndicatorOf">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates an indicator to the product that it describes or interprets.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">is indicator of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-indicator#concernsProduct"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator">
    <dcterms:bibliographicCitation xml:lang="en">EU DPP Textile Indicator Ontology. Version 2.0.0 candidate.</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:created>
    <dcterms:creator xml:lang="en">Andreas Schneider</dcterms:creator>
    <dcterms:creator xml:lang="en">BOUGACHA Racem</dcterms:creator>
    <dcterms:creator xml:lang="en">Elio Hbeich</dcterms:creator>
    <dcterms:creator xml:lang="en">Ivo Ladenius</dcterms:creator>
    <dcterms:creator xml:lang="en">Jan Merckx</dcterms:creator>
    <dcterms:creator xml:lang="en">Piero de Sabbata</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology module for derived textile durability and use-related indicators. It separates indicators from assessment results, product characteristics, thresholds and quantitative values.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
    <dcterms:title xml:lang="en">EU DPP Textile Indicator Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>txtind</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-indicator#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">This module does not assert a subclass alignment to dpp:QualityIndicator. CORE dpp:QuantitativeProperty, a superclass of dpp:QualityIndicator, represents a quantitative property or measurand of a product. Textile txtcon:QuantitativeValue represents a structured numerical value with a measurement unit and, optionally, a quantity kind. These roles are distinct; the CORE hierarchy alone does not establish their equivalence or justify an Indicator alignment.</rdfs:comment>
    <rdfs:comment xml:lang="en">This module models interpretive or calculated indicators. It does not treat a raw assessment result, a durability characteristic, a threshold or a quantitative value as an indicator.</rdfs:comment>
    <rdfs:label xml:lang="en">EU DPP Textile Indicator Ontology</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <owl:priorVersion rdf:resource="https://w3id.org/eudpp/textile-indicator/1.1.2"/>
    <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-indicator/2.0.0"/>
    <owl:versionInfo>Version 2.0.0 candidate</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#DurabilityIndicator">
    <dcterms:relation rdf:resource="https://w3id.org/eudpp#QualityIndicator"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Indicator used to express or interpret durability-related evidence about a textile product.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">Durability indicator</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-indicator#hasIndicator">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a product to an indicator that describes or interprets it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <rdfs:label xml:lang="en">has indicator</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-indicator#Indicator"/>
    <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-indicator#isIndicatorOf"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
