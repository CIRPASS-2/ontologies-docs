@prefix soc: <https://w3id.org/eudpp/soc#> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix thes: <https://w3id.org/eudpp/thesauri/> .
@prefix unit: <http://qudt.org/vocab/unit/> .


<https://w3id.org/eudpp/soc>
    a owl:Ontology ;
    rdfs:label "Substances of Concern module"@en ;
    dcterms:title "EU DPP Core Ontology - Substances of Concern Module"@en ;
    dcterms:description "Provides the core classes and properties for representing substances, their regulatory qualification as substances of concern, their external regulatory basis, and their contextual presence in products."@en ;
    dcterms:creator "Elio Hbeich"@en ;
    dcterms:source "JRC Preparatory study on textiles for product policy instruments - 3rd milestone, especially Sections 9.2.7, 12.2, 12.3.2, 12.3.3, 12.3.4, 12.3.11 and 12.3.12."@en ;
    dcterms:source "Article 7(5) and Article 7(6) of Regulation (EU) 2024/1781."@en ;
    dcterms:source "Global modeling principles for architectural layering and SHACL-oriented constraint enforcement."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "Version 0.1.2 DRAFT"@en ;
    dcterms:created "2026-04-15"^^xsd:date ;
    dcterms:issued "2026-04-17"^^xsd:date ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/soc#" ;
    vann:preferredNamespacePrefix "soc" ;
    rdfs:comment "Draft SoC module. This version explicitly separates substance identity, regulatory qualification, external regulatory references, product-contextual presence, and contextual information objects for location, concentration, threshold evaluation, regulatory consequence, information requirement, and instructions. Substance presence is authoritatively represented through SubstancePresenceContext."@en .

#################################################################
# 1) Core domain classes
#################################################################

dpp:Product
    a owl:Class ;
    rdfs:label "Product"@en .

soc:Substance
    a owl:Class ;
    rdfs:label "Substance"@en ;
    skos:definition "An identified substance considered independently of any specific product occurrence or regulatory qualification."@en ;
    rdfs:comment "This class represents the identity layer. It is product-agnostic and should not be confused with its legal status as a substance of concern."@en .

soc:RegulatoryQualification
    a owl:Class ;
    rdfs:label "Regulatory qualification"@en ;
    skos:definition "A regulatory status or qualification attributed to an entity under a legal or policy framework."@en ;
    rdfs:comment "Generic superclass introduced to separate domain identity from legal qualification."@en .

soc:SubstanceOfConcernQualification
    a owl:Class ;
    rdfs:subClassOf soc:RegulatoryQualification ;
    rdfs:label "Substance of Concern qualification"@en ;
    skos:definition "A regulatory qualification indicating that a substance is considered a substance of concern under Article 2(27) ESPR."@en ;
    rdfs:comment "This is a legal qualification layer, not a purely chemical category."@en .

#################################################################
# 2) External regulatory references
#################################################################

soc:ExternalRegulatoryReference
    a owl:Class ;
    rdfs:label "External regulatory reference"@en ;
    skos:definition "An external regulatory list, classification, or specification used as the basis for a regulatory qualification."@en ;
    rdfs:comment "This class represents external documentary or classificatory references used to justify or determine a regulatory qualification."@en .

soc:SVHCCandidateList
    a owl:Class ;
    rdfs:subClassOf soc:ExternalRegulatoryReference ;
    rdfs:label "SVHC Candidate List"@en ;
    skos:definition "List of substances identified under REACH Article 59."@en ;
    rdfs:comment "External regulatory reference used to determine SoC type (a) qualification. This reference may be documented with identifiers, source, version, and date information."@en .

soc:CLPAnnexVIClassification
    a owl:Class ;
    rdfs:subClassOf soc:ExternalRegulatoryReference ;
    rdfs:label "CLP Annex VI classification"@en ;
    skos:definition "Harmonised hazard classification under CLP Annex VI."@en ;
    rdfs:comment "External regulatory classification used to determine SoC type (b) qualification. This reference may be documented with identifiers, source, version, and date information."@en .

soc:POPsList
    a owl:Class ;
    rdfs:subClassOf soc:ExternalRegulatoryReference ;
    rdfs:label "POPs list"@en ;
    skos:definition "List of substances regulated as Persistent Organic Pollutants."@en ;
    rdfs:comment "External regulatory reference used to determine SoC type (c) qualification. This reference may be documented with identifiers, source, version, and date information."@en .

soc:ProductGroupSpecificSoCList
    a owl:Class ;
    rdfs:subClassOf soc:ExternalRegulatoryReference ;
    rdfs:label "Product-group specific SoC list"@en ;
    skos:definition "List of substances hindering reuse or recycling for a given product group."@en ;
    rdfs:comment "External regulatory specification used to determine SoC type (d) qualification. This reference may be documented with identifiers, source, version, date, and product-category applicability information."@en .

#################################################################
# 3) SoC qualification subclasses
#################################################################

soc:SoCTypeAQualification
    a owl:Class ;
    rdfs:subClassOf soc:SubstanceOfConcernQualification ;
    rdfs:label "SoC type (a) qualification"@en ;
    skos:definition "Qualification assigned to a substance meeting REACH Article 57 criteria and identified under Article 59(1) (SVHC)."@en ;
    rdfs:comment "Qualification based on the SVHC Candidate List."@en .

soc:SoCTypeBQualification
    a owl:Class ;
    rdfs:subClassOf soc:SubstanceOfConcernQualification ;
    rdfs:label "SoC type (b) qualification"@en ;
    skos:definition "Qualification assigned to a substance harmonised-classified under CLP Annex VI Part 3 in one of the relevant hazard classes or categories."@en ;
    rdfs:comment "Hazard-based regulatory qualification."@en .

soc:SoCTypeCQualification
    a owl:Class ;
    rdfs:subClassOf soc:SubstanceOfConcernQualification ;
    rdfs:label "SoC type (c) qualification"@en ;
    skos:definition "Qualification assigned to a substance identified as a Persistent Organic Pollutant under the POPs Regulation."@en ;
    rdfs:comment "Qualification based on POPs regulatory listings."@en .

soc:SoCTypeDQualification
    a owl:Class ;
    rdfs:subClassOf soc:SubstanceOfConcernQualification ;
    rdfs:label "SoC type (d) qualification"@en ;
    skos:definition "Qualification assigned to a substance that hinders reuse or recycling, as determined in product-group-specific delegated acts."@en ;
    rdfs:comment "Circularity-driven qualification. Product-group dependent."@en .

soc:hasApplicableQualification
    a owl:ObjectProperty ;
    rdfs:label "has applicable qualification"@en ;
    skos:definition "Links a substance-of-concern presence context to the substance-of-concern qualification that is applicable for the substance in that product context."@en ;
    rdfs:domain soc:SubstanceOfConcernPresenceContext ;
    rdfs:range soc:SubstanceOfConcernQualification ;
    rdfs:comment "This property expresses the qualification that is applicable in a given product-related context. It complements soc:hasSoCQualification, which links a substance identity to a regulatory qualification independently of a specific product occurrence. The contextual link is particularly relevant when the qualification depends on product group, delegated acts, recycling or reuse relevance, or other context-dependent regulatory criteria."@en .

#################################################################
# 4) Situation layer
#################################################################

soc:Situation
    a owl:Class ;
    rdfs:label "Situation"@en ;
    skos:definition "A contextualised state of affairs or configuration in which entities stand in a meaningful relation under specific conditions."@en ;
    rdfs:comment "Generic superclass introduced for modelling contextual situations. It is not tied to a specific regulatory domain."@en .

soc:SubstancePresenceContext
    a owl:Class ;
    rdfs:subClassOf
        soc:Situation ,
        [
            a owl:Restriction ;
            owl:onProperty soc:hasSubstance ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass soc:Substance
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty soc:hasProduct ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass dpp:Product
        ] ;
    rdfs:label "Substance Presence Context"@en ;
    skos:definition "A contextualised situation in which a given substance is present in a given product."@en ;
    rdfs:comment "Contextual situation used as the authoritative pivot for attaching DPP information related to the presence of a substance in a product, such as location information, concentration information and instruction information."@en .

soc:SubstanceOfConcernPresenceContext
    a owl:Class ;
    rdfs:subClassOf
        soc:SubstancePresenceContext ,
        [
            a owl:Restriction ;
            owl:onProperty soc:hasApplicableQualification ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass soc:SubstanceOfConcernQualification
        ] ;
    rdfs:label "substance of concern presence context"@en ;
    skos:definition "A substance presence context in which the substance present in the product is associated with an applicable substance-of-concern qualification."@en ;
    rdfs:comment "This class specialises SubstancePresenceContext for cases where the reported substance presence is relevant under the ESPR substances-of-concern framework. It keeps generic substance presence separate from legally qualified SoC presence."@en .

#################################################################
# 5) Object properties - identity / qualification
#################################################################

soc:hasQualification
    a owl:ObjectProperty ;
    rdfs:label "has qualification"@en ;
    skos:definition "Links a substance to a regulatory qualification attributed to it."@en ;
    rdfs:domain soc:Substance ;
    rdfs:range soc:RegulatoryQualification ;
    rdfs:comment "Generic property used to separate substance identity from regulatory status."@en .

soc:qualifiesSubstance
    a owl:ObjectProperty ;
    rdfs:label "qualifies substance"@en ;
    rdfs:comment "Inverse of hasQualification."@en ;
    rdfs:domain soc:RegulatoryQualification ;
    rdfs:range soc:Substance ;
    owl:inverseOf soc:hasQualification .

soc:hasSoCQualification
    a owl:ObjectProperty ;
    rdfs:subPropertyOf soc:hasQualification ;
    rdfs:label "has SoC qualification"@en ;
    skos:definition "Links a substance to a qualification stating that it is a substance of concern under the ESPR framework."@en ;
    rdfs:domain soc:Substance ;
    rdfs:range soc:SubstanceOfConcernQualification .

soc:hasRegulatoryBasis
    a owl:ObjectProperty ;
    rdfs:label "has regulatory basis"@en ;
    skos:definition "Links a regulatory qualification to the external regulatory reference on which it is based."@en ;
    rdfs:domain soc:RegulatoryQualification ;
    rdfs:range soc:ExternalRegulatoryReference ;
    rdfs:comment "Generic property linking a qualification to its supporting external legal or classificatory basis."@en ;
    owl:inverseOf soc:isRegulatoryBasisFor .

soc:isRegulatoryBasisFor
    a owl:ObjectProperty ;
    rdfs:label "is regulatory basis for"@en ;
    skos:definition "Links an external regulatory reference to the qualification for which it serves as regulatory basis."@en ;
    rdfs:domain soc:ExternalRegulatoryReference ;
    rdfs:range soc:RegulatoryQualification ;
    rdfs:comment "Inverse of hasRegulatoryBasis."@en .

soc:isQualifiedBySVHCList
    a owl:ObjectProperty ;
    rdfs:subPropertyOf soc:hasRegulatoryBasis ;
    rdfs:label "is qualified by SVHC list"@en ;
    rdfs:comment "Links a SoC type (a) qualification to the external SVHC Candidate List used as qualification basis."@en ;
    rdfs:domain soc:SoCTypeAQualification ;
    rdfs:range soc:SVHCCandidateList .

soc:isQualifiedByCLPClassification
    a owl:ObjectProperty ;
    rdfs:subPropertyOf soc:hasRegulatoryBasis ;
    rdfs:label "is qualified by CLP classification"@en ;
    rdfs:comment "Links a SoC type (b) qualification to the external CLP Annex VI classification used as qualification basis."@en ;
    rdfs:domain soc:SoCTypeBQualification ;
    rdfs:range soc:CLPAnnexVIClassification .

soc:isQualifiedByPOPsList
    a owl:ObjectProperty ;
    rdfs:subPropertyOf soc:hasRegulatoryBasis ;
    rdfs:label "is qualified by POPs list"@en ;
    rdfs:comment "Links a SoC type (c) qualification to the external POPs list used as qualification basis."@en ;
    rdfs:domain soc:SoCTypeCQualification ;
    rdfs:range soc:POPsList .

soc:isQualifiedByProductGroupList
    a owl:ObjectProperty ;
    rdfs:subPropertyOf soc:hasRegulatoryBasis ;
    rdfs:label "is qualified by product-group list"@en ;
    rdfs:comment "Links a SoC type (d) qualification to the product-group-specific external list or delegated act used as qualification basis."@en ;
    rdfs:domain soc:SoCTypeDQualification ;
    rdfs:range soc:ProductGroupSpecificSoCList .

#################################################################
# 6) Object properties - presence context
#################################################################

soc:hasProduct
    a owl:ObjectProperty ;
    rdfs:label "has product"@en ;
    rdfs:comment "Links a substance presence context to the product in which the substance is present."@en ;
    rdfs:domain soc:SubstancePresenceContext ;
    rdfs:range dpp:Product .

soc:hasPresenceContext
    a owl:ObjectProperty ;
    rdfs:label "has presence context"@en ;
    rdfs:comment "Inverse of hasProduct. Links a product to a substance presence context associated with it."@en ;
    rdfs:domain dpp:Product ;
    rdfs:range soc:SubstancePresenceContext ;
    owl:inverseOf soc:hasProduct .

soc:hasSubstance
    a owl:ObjectProperty ;
    rdfs:label "has substance"@en ;
    rdfs:comment "Links a substance presence context to the substance that is present in the product."@en ;
    rdfs:domain soc:SubstancePresenceContext ;
    rdfs:range soc:Substance .

soc:isPresentThroughContext
    a owl:ObjectProperty ;
    rdfs:label "is present through context"@en ;
    rdfs:comment "Inverse of hasSubstance."@en ;
    rdfs:domain soc:Substance ;
    rdfs:range soc:SubstancePresenceContext ;
    owl:inverseOf soc:hasSubstance .


#################################################################
# 7) Datatype properties for substance identification
#################################################################

soc:iupacName
    a owl:DatatypeProperty ;
    rdfs:label "IUPAC name"@en ;
    skos:definition "IUPAC or other international name of the substance."@en ;
    rdfs:domain soc:Substance ;
    rdfs:range xsd:string ;
    rdfs:comment "Name in the International Union of Pure and Applied Chemistry (IUPAC) nomenclature, or another international name when IUPAC name is not available [ESPR Article 7(5)]."@en ;
    dcterms:source "ESPR Article 7(5)."@en ;
    dcterms:identifier "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" .

soc:otherName
    a owl:DatatypeProperty ;
    rdfs:label "other name"@en ;
    skos:definition "Usual, trade or abbreviated names of the substance."@en ;
    rdfs:domain soc:Substance ;
    rdfs:range xsd:string ;
    rdfs:comment "Other names, including usual name, trade name, abbreviation [ESPR Article 7(5)]."@en ;
    dcterms:source "ESPR Article 7(5)."@en ;
    dcterms:identifier "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" .

soc:abbreviation
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf soc:otherName ;
    rdfs:label "abbreviation"@en ;
    rdfs:domain soc:Substance ;
    rdfs:range xsd:string ;
    rdfs:comment "An abbreviation used for the substance."@en ;
    dcterms:source "ESPR Article 7(5)."@en ;
    dcterms:identifier "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" .

soc:tradeName
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf soc:otherName ;
    rdfs:label "trade name"@en ;
    rdfs:domain soc:Substance ;
    rdfs:range xsd:string ;
    rdfs:comment "A trade name under which the substance is known."@en ;
    dcterms:source "ESPR Article 7(5)."@en ;
    dcterms:identifier "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" .

soc:usualName
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf soc:otherName ;
    rdfs:label "usual name"@en ;
    rdfs:domain soc:Substance ;
    rdfs:range xsd:string ;
    rdfs:comment "A usual name under which the substance is known."@en ;
    dcterms:source "ESPR Article 7(5)."@en ;
    dcterms:identifier "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" .

soc:ecNumber
    a owl:DatatypeProperty ;
    rdfs:label "EC number"@en ;
    skos:definition "European Community number of the substance, where available and appropriate."@en ;
    rdfs:domain soc:Substance ;
    rdfs:range xsd:string .

soc:echaNumber
    a owl:DatatypeProperty ;
    rdfs:label "ECHA number"@en ;
    skos:definition "Identifier assigned by ECHA, where available and appropriate."@en ;
    rdfs:domain soc:Substance ;
    rdfs:range xsd:string .

soc:casName
    a owl:DatatypeProperty ;
    rdfs:label "CAS name"@en ;
    skos:definition "The Chemical Abstract Service (CAS) name, if available."@en ;
    rdfs:domain soc:Substance ;
    rdfs:range xsd:string ;
    dcterms:source "ESPR Article 7(5)."@en ;
    dcterms:identifier "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" .

soc:casNumber
    a owl:DatatypeProperty ;
    rdfs:label "CAS number"@en ;
    skos:definition "The Chemical Abstract Service (CAS) number, if available."@en ;
    rdfs:domain soc:Substance ;
    rdfs:range xsd:string ;
    dcterms:source "ESPR Article 7(5)."@en ;
    dcterms:identifier "https://eur-lex.europa.eu/eli/reg/2024/1781/oj" .

soc:substanceIdentifier
    a owl:DatatypeProperty ;
    rdfs:label "substance identifier"@en ;
    skos:definition "Identifier used to match a substance against regulatory lists."@en ;
    rdfs:domain soc:Substance ;
    rdfs:range xsd:string ;
    rdfs:comment "Functional interoperability property used for cross-checking against SVHC, CLP, POPs or other external references."@en .

#################################################################
# 8) Datatype properties for qualification documentation
#################################################################

soc:qualificationSource
    a owl:DatatypeProperty ;
    rdfs:label "qualification source"@en ;
    skos:definition "Textual reference to the legal or regulatory source on which a qualification is based."@en ;
    rdfs:domain soc:RegulatoryQualification ;
    rdfs:range xsd:string .

soc:qualificationNote
    a owl:DatatypeProperty ;
    rdfs:label "qualification note"@en ;
    skos:definition "Additional explanatory note associated with a regulatory qualification."@en ;
    rdfs:domain soc:RegulatoryQualification ;
    rdfs:range xsd:string .

#################################################################
# 9) Contextual scope condition
#################################################################

soc:remainsInFinalProduct
    a owl:DatatypeProperty ;
    rdfs:label "remains in final product"@en ;
    skos:definition "Condition indicating that the substance remains in the final product placed on the market."@en ;
    rdfs:domain soc:SubstancePresenceContext ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Scope condition used to distinguish substances remaining in the final product from substances used only during manufacturing."@en .

#################################################################
# 10) Product internal structure (minimal)
#################################################################

soc:ProductPart
    a owl:Class ;
    rdfs:label "product part"@en ;
    skos:definition "A part, portion, internal element, layer, zone, material group, component, or structural subdivision of a product that may serve as the target of SoC-related reporting."@en ;
    rdfs:comment "ProductPart identifies a concrete or declared subdivision of a product. It may be used to specify where a substance is located, to which part a concentration value refers, or to which part an instruction applies. It should not be confused with the reporting level or with the mass reference basis used for concentration calculation."@en .

soc:isPartOfProduct
    a owl:ObjectProperty ;
    rdfs:label "is part of product"@en ;
    skos:definition "Links a product part to the product of which it is a part."@en ;
    rdfs:domain soc:ProductPart ;
    rdfs:range dpp:Product ;
    owl:inverseOf soc:hasPart ;
    rdfs:comment "This property expresses structural inclusion of a part within a product."@en .

soc:hasPart
    a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    skos:definition "Links a product to one of its parts."@en ;
    rdfs:domain dpp:Product ;
    rdfs:range soc:ProductPart ;
    rdfs:comment "Inverse of isPartOfProduct."@en .

soc:partDescriptor
    a owl:DatatypeProperty ;
    rdfs:label "part descriptor"@en ;
    skos:definition "Textual description identifying or characterising a product part."@en ;
    rdfs:domain soc:ProductPart ;
    rdfs:range xsd:string ;
    rdfs:comment "Free-text description used when no controlled vocabulary or formal taxonomy of product parts is available."@en .

#################################################################
# 10bis) Product part specialisations
#################################################################

soc:ProductComponent
    a owl:Class ;
    rdfs:subClassOf soc:ProductPart ;
    rdfs:label "Product component"@en ;
    skos:definition "A component or assembled element of a product that may be relevant for substance location, concentration reporting, or instructions."@en .

soc:MaterialGroup
    a owl:Class ;
    rdfs:subClassOf soc:ProductPart ;
    rdfs:label "material group"@en ;
    skos:definition "A material or material grouping within a product, used as a structural unit for reporting or calculating substance concentration."@en ;
    rdfs:comment "This class remains product-sector neutral. Sector-specific material group subclasses, such as textile material groups or hard component material groups, should be defined in product-specific modules."@en .

soc:SparePart
    a owl:Class ;
    rdfs:subClassOf soc:ProductPart ;
    rdfs:label "Spare part"@en ;
    skos:definition "A replaceable part of a product that may be relevant for SoC reporting, location, concentration, or lifecycle instructions."@en .



#################################################################
# 11) Location information
#################################################################

soc:LocationInformation
    a owl:Class ;
    rdfs:label "Location information"@en ;
    skos:definition "Contextual qualitative information describing where a substance is located within a product."@en ;
    rdfs:comment "Information object attached to a SubstancePresenceContext in order to describe the reported location of the substance within the product. This class does not imply a formal spatial model."@en .

soc:ReportingLevel
    a owl:Class ;
    rdfs:label "reporting level"@en ;
    skos:definition "Declared level of granularity at which a substance-related information item is reported."@en ;
    rdfs:comment "Reporting level indicates the declared granularity of an information item, such as product level, component level, material level, or spare-part level. It does not by itself identify the concrete product part concerned, nor does it define the mass reference basis used for concentration calculation."@en .

soc:ProductLevel
    a owl:NamedIndividual , soc:ReportingLevel ;
    rdfs:label "product-level"@en ;
    rdfs:comment "Information reported at the level of the entire product."@en .

soc:ComponentLevel
    a owl:NamedIndividual , soc:ReportingLevel ;
    rdfs:label "component-level"@en ;
    rdfs:comment "Information reported at the level of a relevant component."@en .

soc:SparePartLevel
    a owl:NamedIndividual , soc:ReportingLevel ;
    rdfs:label "spare-part-level"@en ;
    rdfs:comment "Information reported at the level of a spare part."@en .

soc:MaterialLevel
    a owl:NamedIndividual , soc:ReportingLevel ;
    rdfs:label "Material level"@en ;
    skos:definition "Reporting level corresponding to a material or material group within a product structure."@en  .

soc:hasLocationInformation
    a owl:ObjectProperty ;
    rdfs:label "has location information"@en ;
    skos:definition "Links a substance presence context to a location information object."@en ;
    rdfs:domain soc:SubstancePresenceContext ;
    rdfs:range soc:LocationInformation ;
    rdfs:comment "This property attaches contextual location information to a substance presence context."@en .

soc:isLocationInformationOf
    a owl:ObjectProperty ;
    rdfs:label "is location information of"@en ;
    rdfs:comment "Inverse of hasLocationInformation."@en ;
    rdfs:domain soc:LocationInformation ;
    rdfs:range soc:SubstancePresenceContext ;
    owl:inverseOf soc:hasLocationInformation .

soc:locationDescriptor
    a owl:DatatypeProperty ;
    rdfs:label "location descriptor"@en ;
    skos:definition "Textual description of where the substance is located within the product."@en ;
    rdfs:domain soc:LocationInformation ;
    rdfs:range xsd:string ;
    rdfs:comment "Free-text description used because the JRC and ESPR do not define a controlled vocabulary or formal spatial model for location. This textual description may complement a structured reference to a product part."@en .

soc:hasLocationReportingLevel
    a owl:ObjectProperty ;
    rdfs:label "has location reporting level"@en ;
    skos:definition "Indicates the reporting granularity at which the location is described."@en ;
    rdfs:domain soc:LocationInformation ;
    rdfs:range soc:ReportingLevel ;
    rdfs:comment "This property expresses whether the information is reported at product, component, material, or spare-part level."@en .

soc:refersToProductPartForLocation
    a owl:ObjectProperty ;
    rdfs:label "refers to product part for location"@en ;
    skos:definition "Links a location information object to the product part to which the reported location refers."@en ;
    rdfs:domain soc:LocationInformation ;
    rdfs:range soc:ProductPart ;
    rdfs:comment "Optional property used when the reported location refers to a specific part of the product rather than to the whole product."@en .

#################################################################
# 12) Concentration information
#################################################################

soc:ConcentrationInformation
    a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty soc:hasQuantitativeValue ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass soc:QuantitativeValue
    ] ;
    rdfs:label "Concentration information"@en ;
    skos:definition "Contextual quantitative information describing the reported concentration of a substance present in a product."@en ;
    rdfs:comment "Information object attached to a SubstancePresenceContext in order to represent an exact value, a maximum value, or a concentration range. A concentration information object may describe concentration at the level of the whole product or at the level of a specific product part."@en .

soc:QuantitativeValue
    a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty soc:hasUnit ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass soc:Unit
    ] ;
    rdfs:label "Quantitative value"@en ;
    skos:definition "A quantitative expression consisting of one or more numerical values and a unit."@en ;
    rdfs:comment "Generic superclass for quantitative expressions used in the SoC module, including concentration information and regulatory thresholds."@en .

soc:ExactQuantitativeValue
    a owl:Class ;
    rdfs:subClassOf soc:QuantitativeValue ;
    rdfs:label "Exact quantitative value"@en ;
    skos:definition "A quantitative expression represented by a single exact numerical value and a unit."@en .

soc:MaximumQuantitativeValue
    a owl:Class ;
    rdfs:subClassOf soc:QuantitativeValue ;
    rdfs:label "Maximum quantitative value"@en ;
    skos:definition "A quantitative expression represented by a single upper-bound numerical value and a unit."@en .

soc:RangeQuantitativeValue
    a owl:Class ;
    rdfs:subClassOf soc:QuantitativeValue ;
    rdfs:label "Range quantitative value"@en ;
    skos:definition "A quantitative expression represented by a lower bound, an upper bound, and a unit."@en .

soc:hasConcentrationInformation
    a owl:ObjectProperty ;
    rdfs:label "has concentration information"@en ;
    skos:definition "Links a substance presence context to a concentration information object."@en ;
    rdfs:domain soc:SubstancePresenceContext ;
    rdfs:range soc:ConcentrationInformation ;
    rdfs:comment "This property attaches contextual concentration information to a substance presence context. Multiple concentration information objects may be attached when different reporting granularities or different product parts are involved."@en .

soc:isConcentrationInformationOf
    a owl:ObjectProperty ;
    rdfs:label "is concentration information of"@en ;
    rdfs:comment "Inverse of hasConcentrationInformation."@en ;
    rdfs:domain soc:ConcentrationInformation ;
    rdfs:range soc:SubstancePresenceContext ;
    owl:inverseOf soc:hasConcentrationInformation .

soc:hasQuantitativeValue
    a owl:ObjectProperty ;
    rdfs:label "has quantitative value"@en ;
    skos:definition "Links a concentration information object to its quantitative expression."@en ;
    rdfs:domain soc:ConcentrationInformation ;
    rdfs:range soc:QuantitativeValue ;
    rdfs:comment "This property links concentration information to an exact, maximum, or range quantitative value."@en ;
    owl:inverseOf soc:isQuantitativeValueOfConcentration .

soc:isQuantitativeValueOfConcentration
    a owl:ObjectProperty ;
    rdfs:label "is quantitative value of concentration"@en ;
    skos:definition "Links a quantitative value to the concentration information it quantifies."@en ;
    rdfs:domain soc:QuantitativeValue ;
    rdfs:range soc:ConcentrationInformation ;
    owl:inverseOf soc:hasQuantitativeValue .

soc:isQuantitativeValueOfThreshold
    a owl:ObjectProperty ;
    rdfs:label "is quantitative value of threshold"@en ;
    skos:definition "Links a quantitative value to the regulatory threshold it quantifies."@en ;
    rdfs:domain soc:QuantitativeValue ;
    rdfs:range soc:RegulatoryThreshold ;
    owl:inverseOf soc:hasThresholdQuantitativeValue .

soc:hasConcentrationReportingLevel
    a owl:ObjectProperty ;
    rdfs:label "has concentration reporting level"@en ;
    skos:definition "Indicates the reporting granularity at which the concentration is described."@en ;
    rdfs:domain soc:ConcentrationInformation ;
    rdfs:range soc:ReportingLevel ;
    rdfs:comment "This property expresses whether the concentration is reported at product, component, material, or spare-part level."@en .

soc:refersToProductPartForConcentration
    a owl:ObjectProperty ;
    rdfs:label "refers to product part for concentration"@en ;
    skos:definition "Links a concentration information object to the product part to which the reported concentration refers."@en ;
    rdfs:domain soc:ConcentrationInformation ;
    rdfs:range soc:ProductPart ;
    rdfs:comment "Optional property used when the reported concentration refers to a specific part of the product rather than to the whole product."@en .

soc:numericValue
    a owl:DatatypeProperty ;
    rdfs:label "numeric value"@en ;
    skos:definition "Single numerical value used for an exact quantitative value."@en ;
    rdfs:domain soc:ExactQuantitativeValue ;
    rdfs:range xsd:decimal .

soc:maximumValue
    a owl:DatatypeProperty ;
    rdfs:label "maximum value"@en ;
    skos:definition "Single upper-bound numerical value used for a maximum quantitative value."@en ;
    rdfs:domain soc:MaximumQuantitativeValue ;
    rdfs:range xsd:decimal .

soc:lowerBound
    a owl:DatatypeProperty ;
    rdfs:label "lower bound"@en ;
    skos:definition "Lower bound of a quantitative range."@en ;
    rdfs:domain soc:RangeQuantitativeValue ;
    rdfs:range xsd:decimal .

soc:upperBound
    a owl:DatatypeProperty ;
    rdfs:label "upper bound"@en ;
    skos:definition "Upper bound of a quantitative range."@en ;
    rdfs:domain soc:RangeQuantitativeValue ;
    rdfs:range xsd:decimal .

soc:Unit
    a owl:Class ;
    rdfs:subClassOf qudt:Unit ;
    rdfs:label "unit"@en ;
    skos:definition "Unit used to express a quantitative value."@en ;
    rdfs:comment "This class reuses QUDT units for expressing quantitative values in the SoC module."@en .

soc:Percent
    a owl:NamedIndividual , soc:Unit ;
    skos:exactMatch unit:PERCENT ;
    rdfs:label "percent"@en .

soc:PPM
    a owl:NamedIndividual , soc:Unit ;
    skos:exactMatch unit:PPM ;
    rdfs:label "parts per million"@en .

soc:hasUnit
    a owl:ObjectProperty ;
    rdfs:label "has unit"@en ;
    skos:definition "Links a quantitative value to the unit in which it is expressed."@en ;
    rdfs:domain soc:QuantitativeValue ;
    rdfs:range soc:Unit .

soc:isUnitOf
    a owl:ObjectProperty ;
    rdfs:label "is unit of"@en ;
    skos:definition "Links a unit to a quantitative value expressed using that unit."@en ;
    rdfs:domain soc:Unit ;
    rdfs:range soc:QuantitativeValue ;
    owl:inverseOf soc:hasUnit .


soc:analyticalMethod
    a owl:DatatypeProperty ;
    rdfs:label "analytical method"@en ;
    skos:definition "Textual description of the analytical method used to determine or verify the concentration."@en ;
    rdfs:domain soc:ConcentrationInformation ;
    rdfs:range xsd:string .

soc:measurementBasis
    a owl:DatatypeProperty ;
    rdfs:label "measurement basis"@en ;
    skos:definition "Textual description of the basis used for expressing or calculating the concentration."@en ;
    rdfs:domain soc:ConcentrationInformation ;
    rdfs:range xsd:string .


#################################################################
# 12bis) Concentration calculation method
#################################################################

soc:ConcentrationCalculationMethod
    a owl:Class ;
    rdfs:label "concentration calculation method"@en ;
    skos:definition "A method used to calculate or report the concentration of a substance in a product or in a part of its material structure."@en ;
    rdfs:comment "This class represents the methodological basis used for concentration reporting. The chosen calculation method may affect threshold assessment and regulatory interpretation."@en .

soc:ProductBasedConcentrationCalculation
    a owl:NamedIndividual , soc:ConcentrationCalculationMethod ;
    rdfs:label "product-based concentration calculation"@en ;
    skos:definition "Calculation method in which the concentration is calculated using the total mass of the final product."@en ;
    rdfs:comment "This method corresponds to a product-level calculation option, where all relevant materials and components are aggregated at final product level."@en .

soc:MaterialGroupBasedConcentrationCalculation
    a owl:NamedIndividual , soc:ConcentrationCalculationMethod ;
    rdfs:label "material-group-based concentration calculation"@en ;
    skos:definition "Calculation method in which the concentration is calculated separately for defined material groups within a product."@en ;
    rdfs:comment "This method corresponds to a material-group-based calculation option. Product-sector-specific modules may define the relevant material group categories."@en .

soc:hasConcentrationCalculationMethod
    a owl:ObjectProperty ;
    rdfs:label "has concentration calculation method"@en ;
    skos:definition "Links a concentration information object to the method used to calculate or report the concentration."@en ;
    rdfs:domain soc:ConcentrationInformation ;
    rdfs:range soc:ConcentrationCalculationMethod ;
    rdfs:comment "This property records whether the reported concentration was calculated at final-product level or according to material groups. The method is relevant because it may affect the interpretation of thresholds."@en .

soc:isConcentrationCalculationMethodOf
    a owl:ObjectProperty ;
    rdfs:label "is concentration calculation method of"@en ;
    skos:definition "Links a concentration calculation method to the concentration information that uses it."@en ;
    rdfs:domain soc:ConcentrationCalculationMethod ;
    rdfs:range soc:ConcentrationInformation ;
    owl:inverseOf soc:hasConcentrationCalculationMethod .


soc:ConcentrationReferenceBasis
    a owl:Class ;
    rdfs:label "concentration reference basis"@en ;
    skos:definition "Reference basis against which a substance concentration is calculated or reported."@en ;
    rdfs:comment "ConcentrationReferenceBasis represents the denominator or reference scope used for concentration calculation, such as the final product mass, an article mass, a product part mass, or a material group mass. It is distinct from the reporting level and from the concrete product part to which the information may refer."@en .

soc:FinalProductMassBasis
    a owl:NamedIndividual , soc:ConcentrationReferenceBasis ;
    rdfs:label "final product mass basis"@en .

soc:ProductPartMassBasis
    a owl:NamedIndividual , soc:ConcentrationReferenceBasis ;
    rdfs:label "product part mass basis"@en .

soc:MaterialGroupMassBasis
    a owl:NamedIndividual , soc:ConcentrationReferenceBasis ;
    rdfs:label "material group mass basis"@en .

soc:ArticleMassBasis
    a owl:NamedIndividual , soc:ConcentrationReferenceBasis ;
    rdfs:label "article mass basis"@en ;
    rdfs:comment "Useful when the relevant legal interpretation follows an article-based reference mass, as in some REACH-related contexts."@en .

soc:hasConcentrationReferenceBasis
    a owl:ObjectProperty ;
    rdfs:label "has concentration reference basis"@en ;
    skos:definition "Links a concentration information object to the reference basis used for calculating or reporting the concentration."@en ;
    rdfs:domain soc:ConcentrationInformation ;
    rdfs:range soc:ConcentrationReferenceBasis ;
    rdfs:comment "This property clarifies the denominator or reference scope of the reported concentration. It is important because the regulatory interpretation of a concentration may differ depending on whether it is calculated against the final product, an article, a product part, or a material group."@en .

soc:isConcentrationReferenceBasisOf
    a owl:ObjectProperty ;
    rdfs:label "is concentration reference basis of"@en ;
    skos:definition "Links a concentration reference basis to the concentration information that uses it."@en ;
    rdfs:domain soc:ConcentrationReferenceBasis ;
    rdfs:range soc:ConcentrationInformation ;
    owl:inverseOf soc:hasConcentrationReferenceBasis .


#################################################################
# 13) Instruction information
#################################################################

soc:InstructionInformation
    a owl:Class ;
    rdfs:label "Instruction information"@en ;
    skos:definition "A contextual prescriptive information object describing how a product, product part, or substance-related situation should be handled in the presence of a substance of concern."@en ;
    rdfs:comment "Information object attached to a SubstancePresenceContext in order to represent SoC-related instructions, such as safe use, repair, reuse, disassembly, or recycling. This class is intentionally extensible: beyond a basic type and textual content, it may later carry conditions of application, targeted product parts, precautions, recommended actions, forbidden actions, or end-of-life handling guidance."@en .

soc:InstructionType
    a owl:Class ;
    rdfs:label "Instruction type"@en ;
    skos:definition "Declared type of instruction according to the relevant lifecycle-related activity addressed by the information element."@en ;
    rdfs:comment "This class represents the kind of instruction expressed in the DPP information element."@en .

soc:SafeUseInstructionType
    a owl:NamedIndividual , soc:InstructionType ;
    rdfs:label "safe-use"@en ;
    rdfs:comment "Instruction related to the safe use of the product in relation to the substance."@en .

soc:RepairInstructionType
    a owl:NamedIndividual , soc:InstructionType ;
    rdfs:label "repair"@en ;
    rdfs:comment "Instruction related to the repair of the product in relation to the substance."@en .

soc:ReuseInstructionType
    a owl:NamedIndividual , soc:InstructionType ;
    rdfs:label "reuse"@en ;
    rdfs:comment "Instruction related to the reuse of the product in relation to the substance."@en .

soc:DisassemblyInstructionType
    a owl:NamedIndividual , soc:InstructionType ;
    rdfs:label "disassembly"@en ;
    rdfs:comment "Instruction related to the disassembly of the product in relation to the substance."@en .

soc:RecyclingInstructionType
    a owl:NamedIndividual , soc:InstructionType ;
    rdfs:label "recycling"@en ;
    rdfs:comment "Instruction related to the recycling of the product in relation to the substance."@en .

soc:hasInstructionInformation
    a owl:ObjectProperty ;
    rdfs:label "has instruction information"@en ;
    skos:definition "Links a substance presence context to an instruction information object."@en ;
    rdfs:domain soc:SubstancePresenceContext ;
    rdfs:range soc:InstructionInformation ;
    rdfs:comment "This property attaches contextual instruction information to a substance presence context."@en .

soc:isInstructionInformationOf
    a owl:ObjectProperty ;
    rdfs:label "is instruction information of"@en ;
    rdfs:comment "Inverse of hasInstructionInformation."@en ;
    rdfs:domain soc:InstructionInformation ;
    rdfs:range soc:SubstancePresenceContext ;
    owl:inverseOf soc:hasInstructionInformation .

soc:hasInstructionType
    a owl:ObjectProperty ;
    rdfs:label "has instruction type"@en ;
    skos:definition "Indicates the declared type of instruction represented by an instruction information object."@en ;
    rdfs:domain soc:InstructionInformation ;
    rdfs:range soc:InstructionType ;
    rdfs:comment "This property expresses whether the instruction concerns safe use, repair, reuse, disassembly, or recycling."@en .

soc:hasInstructionReportingLevel
    a owl:ObjectProperty ;
    rdfs:label "has instruction reporting level"@en ;
    skos:definition "Indicates the reporting granularity at which the instruction is intended to apply."@en ;
    rdfs:domain soc:InstructionInformation ;
    rdfs:range soc:ReportingLevel ;
    rdfs:comment "This property expresses whether the instruction is stated at product, component, material, or spare-part level."@en .

soc:refersToProductPartForInstruction
    a owl:ObjectProperty ;
    rdfs:label "refers to product part for instruction"@en ;
    skos:definition "Links an instruction information object to the product part to which the instruction refers."@en ;
    rdfs:domain soc:InstructionInformation ;
    rdfs:range soc:ProductPart ;
    rdfs:comment "Optional property used when the instruction refers to a specific part of the product rather than to the whole product."@en .

soc:instructionContent
    a owl:DatatypeProperty ;
    rdfs:label "instruction content"@en ;
    skos:definition "Textual content of an instruction related to a substance present in a product."@en ;
    rdfs:domain soc:InstructionInformation ;
    rdfs:range xsd:string ;
    rdfs:comment "Free-text guidance attached to a substance presence context. The ESPR does not define a controlled vocabulary or formal structure for instruction content."@en .

soc:recommendedAction
    a owl:DatatypeProperty ;
    rdfs:label "recommended action"@en ;
    skos:definition "Textual description of an action that is recommended in relation to the instruction."@en ;
    rdfs:domain soc:InstructionInformation ;
    rdfs:range xsd:string ;
    rdfs:comment "Optional prescriptive qualifier used to state what should be done when the instruction applies."@en .

soc:forbiddenAction
    a owl:DatatypeProperty ;
    rdfs:label "forbidden action"@en ;
    skos:definition "Textual description of an action that should not be performed in relation to the instruction."@en ;
    rdfs:domain soc:InstructionInformation ;
    rdfs:range xsd:string ;
    rdfs:comment "Optional prescriptive qualifier used to state what should be avoided when the instruction applies."@en .

soc:precautionaryMeasure
    a owl:DatatypeProperty ;
    rdfs:label "precautionary measure"@en ;
    skos:definition "Textual description of a precaution to be observed in relation to the instruction."@en ;
    rdfs:domain soc:InstructionInformation ;
    rdfs:range xsd:string ;
    rdfs:comment "Optional qualifier used to express handling precautions related to the presence of a substance of concern."@en .

soc:applicationCondition
    a owl:DatatypeProperty ;
    rdfs:label "application condition"@en ;
    skos:definition "Textual condition under which the instruction applies."@en ;
    rdfs:domain soc:InstructionInformation ;
    rdfs:range xsd:string ;
    rdfs:comment "Optional qualifier used to express the circumstances, constraints, or conditions under which the instruction is applicable."@en .

#################################################################
# 14) Datatype properties for external regulatory references
#################################################################

soc:referenceIdentifier
    a owl:DatatypeProperty ;
    rdfs:label "reference identifier"@en ;
    skos:definition "Identifier used to identify an external regulatory reference."@en ;
    rdfs:domain soc:ExternalRegulatoryReference ;
    rdfs:range xsd:string ;
    rdfs:comment "This property may be used to record a documentary identifier, entry code, listing identifier, or other reference-specific identifier."@en .

soc:referenceSource
    a owl:DatatypeProperty ;
    rdfs:label "reference source"@en ;
    skos:definition "Textual source or URI identifying the origin of an external regulatory reference."@en ;
    rdfs:domain soc:ExternalRegulatoryReference ;
    rdfs:range xsd:string ;
    rdfs:comment "This property records the source from which the regulatory reference is derived, such as a regulation, official list, delegated act, or authoritative registry."@en .

soc:referenceVersion
    a owl:DatatypeProperty ;
    rdfs:label "reference version"@en ;
    skos:definition "Version identifier of an external regulatory reference."@en ;
    rdfs:domain soc:ExternalRegulatoryReference ;
    rdfs:range xsd:string ;
    rdfs:comment "This property is particularly relevant for regulatory lists and classifications that evolve over time."@en .

soc:referenceDate
    a owl:DatatypeProperty ;
    rdfs:label "reference date"@en ;
    skos:definition "Relevant date associated with an external regulatory reference."@en ;
    rdfs:domain soc:ExternalRegulatoryReference ;
    rdfs:range xsd:date ;
    rdfs:comment "This property may record a publication date, issue date, update date, or consultation date associated with the external regulatory reference."@en .

soc:appliesToProductCategory
    a owl:DatatypeProperty ;
    rdfs:label "applies to product category"@en ;
    skos:definition "Textual indication of the product category or product group to which an external regulatory reference applies."@en ;
    rdfs:domain soc:ExternalRegulatoryReference ;
    rdfs:range xsd:string ;
    rdfs:comment "This property is especially relevant for product-group-specific SoC references, including delegated acts that define type (d) substances for specific product categories."@en .

#################################################################
# 15) Regulatory thresholds
#################################################################

soc:RegulatoryThreshold
    a owl:Class ;
    rdfs:label "Regulatory threshold"@en ;
    skos:definition "A regulatory or technical threshold value used to interpret or govern the reporting, tracking, exemption, or end-of-life handling of a substance of concern."@en ;
    rdfs:comment "This class represents threshold values that are distinct from reported concentration values. A regulatory threshold is used as a reference for legal or technical interpretation."@en .

soc:TrackingThreshold
    a owl:Class ;
    rdfs:subClassOf soc:RegulatoryThreshold ;
    rdfs:label "Tracking threshold"@en ;
    skos:definition "A threshold value above which a substance of concern must be tracked or reported."@en ;
    rdfs:comment "This class represents thresholds used to determine whether a substance of concern must be tracked or reported in the DPP context."@en .

soc:NonExemptionThreshold
    a owl:Class ;
    rdfs:subClassOf soc:RegulatoryThreshold ;
    rdfs:label "Non-exemption threshold"@en ;
    skos:definition "A threshold value above which an information element may not be exempted."@en ;
    rdfs:comment "This class represents thresholds used to determine when exemptions are not allowed, such as the 0.1% w/w threshold for certain substances."@en .

soc:HazardClassThreshold
    a owl:Class ;
    rdfs:subClassOf soc:RegulatoryThreshold ;
    rdfs:label "Hazard-class threshold"@en ;
    skos:definition "A threshold value that depends on a hazard class or hazard category."@en ;
    rdfs:comment "This class represents thresholds whose applicability depends on a hazard classification, especially in the context of SoC type (b)."@en .

soc:AlertConcentrationThreshold
    a owl:Class ;
    rdfs:subClassOf soc:RegulatoryThreshold ;
    rdfs:label "Alert concentration threshold"@en ;
    skos:definition "A threshold value above which a substance should trigger alert-based handling, such as disposal instead of recycling."@en ;
    rdfs:comment "This class represents circularity-driven threshold values such as c_alert for SoC type (d)."@en .

soc:hasRegulatoryThreshold
    a owl:ObjectProperty ;
    rdfs:label "has regulatory threshold"@en ;
    skos:definition "Links a regulatory qualification to a threshold relevant to its interpretation or application."@en ;
    rdfs:domain soc:RegulatoryQualification ;
    rdfs:range soc:RegulatoryThreshold ;
    rdfs:comment "This property indicates that a regulatory qualification is associated with one or more regulatory thresholds."@en ;
    owl:inverseOf soc:isRegulatoryThresholdOf .

soc:isRegulatoryThresholdOf
    a owl:ObjectProperty ;
    rdfs:label "is regulatory threshold of"@en ;
    skos:definition "Links a regulatory threshold to the regulatory qualification for which it is relevant."@en ;
    rdfs:domain soc:RegulatoryThreshold ;
    rdfs:range soc:RegulatoryQualification ;
    rdfs:comment "Inverse of hasRegulatoryThreshold."@en .

soc:isThresholdDerivedFrom
    a owl:ObjectProperty ;
    rdfs:label "is threshold derived from"@en ;
    skos:definition "Links a regulatory threshold to the external regulatory reference from which it is derived."@en ;
    rdfs:domain soc:RegulatoryThreshold ;
    rdfs:range soc:ExternalRegulatoryReference ;
    rdfs:comment "This property documents the regulatory basis from which a threshold is derived."@en ;
    owl:inverseOf soc:isRegulatorySourceForThreshold .

soc:isRegulatorySourceForThreshold
    a owl:ObjectProperty ;
    rdfs:label "is regulatory source for threshold"@en ;
    skos:definition "Links an external regulatory reference to a regulatory threshold derived from it."@en ;
    rdfs:domain soc:ExternalRegulatoryReference ;
    rdfs:range soc:RegulatoryThreshold ;
    rdfs:comment "Inverse of isThresholdDerivedFrom."@en .

soc:hasThresholdQuantitativeValue
    a owl:ObjectProperty ;
    rdfs:label "has threshold quantitative value"@en ;
    skos:definition "Links a regulatory threshold to its quantitative expression."@en ;
    rdfs:domain soc:RegulatoryThreshold ;
    rdfs:range soc:QuantitativeValue ;
    rdfs:comment "This property links a regulatory threshold to an exact, maximum, or range quantitative value."@en .

soc:thresholdNote
    a owl:DatatypeProperty ;
    rdfs:label "threshold note"@en ;
    skos:definition "Additional explanatory note associated with a regulatory threshold."@en ;
    rdfs:domain soc:RegulatoryThreshold ;
    rdfs:range xsd:string .

soc:appliesToHazardClass
    a owl:DatatypeProperty ;
    rdfs:label "applies to hazard class"@en ;
    skos:definition "Textual indication of the hazard class or hazard category to which a threshold applies."@en ;
    rdfs:domain soc:RegulatoryThreshold ;
    rdfs:range xsd:string ;
    rdfs:comment "This property is especially useful for hazard-class-dependent thresholds derived from CLP classifications."@en .

soc:thresholdAppliesToProductCategory
    a owl:DatatypeProperty ;
    rdfs:label "threshold applies to product category"@en ;
    skos:definition "Textual indication of the product category or group to which a threshold applies."@en ;
    rdfs:domain soc:RegulatoryThreshold ;
    rdfs:range xsd:string ;
    rdfs:comment "This property is especially useful for product-group-specific thresholds, including those associated with SoC type (d)."@en .

#################################################################
# 16) Links between reported concentration and regulatory thresholds
#################################################################

soc:hasApplicableRegulatoryThreshold
    a owl:ObjectProperty ;
    rdfs:label "has applicable regulatory threshold"@en ;
    skos:definition "Links a concentration information object to a regulatory threshold that is applicable for its interpretation."@en ;
    rdfs:domain soc:ConcentrationInformation ;
    rdfs:range soc:RegulatoryThreshold ;
    rdfs:comment "This property indicates which regulatory thresholds are relevant for interpreting a reported concentration. It does not by itself express whether the threshold is met, exceeded, or violated."@en ;
    owl:inverseOf soc:isApplicableRegulatoryThresholdFor .

soc:isApplicableRegulatoryThresholdFor
    a owl:ObjectProperty ;
    rdfs:label "is applicable regulatory threshold for"@en ;
    skos:definition "Links a regulatory threshold to a concentration information object for which it is applicable."@en ;
    rdfs:domain soc:RegulatoryThreshold ;
    rdfs:range soc:ConcentrationInformation ;
    rdfs:comment "Inverse of hasApplicableRegulatoryThreshold."@en .


#################################################################
# 16bis) Threshold evaluation
#################################################################

soc:ThresholdEvaluation
    a owl:Class ;
    rdfs:subClassOf
        soc:Situation ,
        [
            a owl:Restriction ;
            owl:onProperty soc:evaluatesConcentrationInformation ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass soc:ConcentrationInformation
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty soc:evaluatesAgainstThreshold ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass soc:RegulatoryThreshold
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty soc:hasThresholdEvaluationResult ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass soc:ThresholdEvaluationResult
        ] ;
    rdfs:label "Threshold evaluation"@en ;
    skos:definition "A contextual regulatory evaluation in which a reported concentration is compared with an applicable regulatory threshold."@en ;
    rdfs:comment "This class represents the evaluative layer between measurement and regulatory consequence. It does not replace ConcentrationInformation or RegulatoryThreshold; it records the result of applying a threshold rule to a concentration value in a given substance presence context."@en .

soc:ThresholdEvaluationResult
    a owl:Class ;
    rdfs:label "Threshold evaluation result"@en ;
    skos:definition "Controlled result value produced by a threshold evaluation."@en ;
    rdfs:comment "This class is used as a controlled vocabulary for the outcome of threshold evaluation."@en .

soc:BelowThreshold
    a owl:NamedIndividual , soc:ThresholdEvaluationResult ;
    rdfs:label "below threshold"@en ;
    skos:definition "Evaluation result indicating that the reported concentration is below the applicable threshold."@en .

soc:AtThreshold
    a owl:NamedIndividual , soc:ThresholdEvaluationResult ;
    rdfs:label "at threshold"@en ;
    skos:definition "Evaluation result indicating that the reported concentration is equal to the applicable threshold."@en .

soc:AboveThreshold
    a owl:NamedIndividual , soc:ThresholdEvaluationResult ;
    rdfs:label "above threshold"@en ;
    skos:definition "Evaluation result indicating that the reported concentration is above the applicable threshold."@en .

soc:ThresholdNotEvaluated
    a owl:NamedIndividual , soc:ThresholdEvaluationResult ;
    rdfs:label "threshold not evaluated"@en ;
    skos:definition "Evaluation result indicating that the threshold comparison has not been performed or cannot be determined from the available data."@en .

soc:evaluatesConcentrationInformation
    a owl:ObjectProperty ;
    rdfs:label "evaluates concentration information"@en ;
    skos:definition "Links a threshold evaluation to the concentration information being evaluated."@en ;
    rdfs:domain soc:ThresholdEvaluation ;
    rdfs:range soc:ConcentrationInformation ;
    owl:inverseOf soc:isEvaluatedByThresholdEvaluation .

soc:isEvaluatedByThresholdEvaluation
    a owl:ObjectProperty ;
    rdfs:label "is evaluated by threshold evaluation"@en ;
    skos:definition "Links a concentration information object to a threshold evaluation in which it is evaluated."@en ;
    rdfs:domain soc:ConcentrationInformation ;
    rdfs:range soc:ThresholdEvaluation .

soc:evaluatesAgainstThreshold
    a owl:ObjectProperty ;
    rdfs:label "evaluates against threshold"@en ;
    skos:definition "Links a threshold evaluation to the regulatory threshold used for the comparison."@en ;
    rdfs:domain soc:ThresholdEvaluation ;
    rdfs:range soc:RegulatoryThreshold ;
    owl:inverseOf soc:isThresholdUsedInEvaluation .

soc:isThresholdUsedInEvaluation
    a owl:ObjectProperty ;
    rdfs:label "is threshold used in evaluation"@en ;
    skos:definition "Links a regulatory threshold to a threshold evaluation in which it is used."@en ;
    rdfs:domain soc:RegulatoryThreshold ;
    rdfs:range soc:ThresholdEvaluation .

soc:hasThresholdEvaluationResult
    a owl:ObjectProperty ;
    rdfs:label "has threshold evaluation result"@en ;
    skos:definition "Links a threshold evaluation to its result."@en ;
    rdfs:domain soc:ThresholdEvaluation ;
    rdfs:range soc:ThresholdEvaluationResult .

soc:hasThresholdEvaluation
    a owl:ObjectProperty ;
    rdfs:label "has threshold evaluation"@en ;
    skos:definition "Links a substance presence context to a threshold evaluation associated with it."@en ;
    rdfs:domain soc:SubstancePresenceContext ;
    rdfs:range soc:ThresholdEvaluation ;
    owl:inverseOf soc:isThresholdEvaluationOf .

soc:isThresholdEvaluationOf
    a owl:ObjectProperty ;
    rdfs:label "is threshold evaluation of"@en ;
    skos:definition "Links a threshold evaluation to the substance presence context to which it belongs."@en ;
    rdfs:domain soc:ThresholdEvaluation ;
    rdfs:range soc:SubstancePresenceContext .

soc:evaluationDate
    a owl:DatatypeProperty ;
    rdfs:label "evaluation date"@en ;
    skos:definition "Date on which the threshold evaluation was performed or recorded."@en ;
    rdfs:domain soc:ThresholdEvaluation ;
    rdfs:range xsd:date .

soc:evaluationMethod
    a owl:DatatypeProperty ;
    rdfs:label "evaluation method"@en ;
    skos:definition "Textual description of the method or rule used to perform the threshold evaluation."@en ;
    rdfs:domain soc:ThresholdEvaluation ;
    rdfs:range xsd:string .

soc:evaluationNote
    a owl:DatatypeProperty ;
    rdfs:label "evaluation note"@en ;
    skos:definition "Additional explanatory note associated with a threshold evaluation."@en ;
    rdfs:domain soc:ThresholdEvaluation ;
    rdfs:range xsd:string .

soc:RegulatoryConsequence
    a owl:Class ;
    rdfs:label "Regulatory consequence"@en ;
    skos:definition "A regulatory outcome or obligation resulting from the interpretation of a threshold evaluation."@en ;
    rdfs:comment "This class represents the consequence layer, distinct from the physical comparison between concentration and threshold."@en .

soc:hasRegulatoryConsequence
    a owl:ObjectProperty ;
    rdfs:label "has regulatory consequence"@en ;
    skos:definition "Links a threshold evaluation to the regulatory consequence derived from it."@en ;
    rdfs:domain soc:ThresholdEvaluation ;
    rdfs:range soc:RegulatoryConsequence ;
    owl:inverseOf soc:isRegulatoryConsequenceOf .


soc:isRegulatoryConsequenceOf
    a owl:ObjectProperty ;
    rdfs:label "is regulatory consequence of"@en ;
    skos:definition "Links a regulatory consequence to the threshold evaluation from which it is derived."@en ;
    rdfs:domain soc:RegulatoryConsequence ;
    rdfs:range soc:ThresholdEvaluation .

soc:ReportingObligation
    a owl:NamedIndividual , soc:RegulatoryConsequence ;
    rdfs:label "reporting obligation"@en .

soc:RegulatoryActionRequired
    a owl:NamedIndividual , soc:RegulatoryConsequence ;
    rdfs:label "regulatory action required"@en .

soc:NoActionRequired
    a owl:NamedIndividual , soc:RegulatoryConsequence ;
    rdfs:label "no action required"@en .


#################################################################
# 17) Information requirements and exemptions
#################################################################

soc:InformationRequirement
    a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty soc:hasExemptionStatus ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass soc:ExemptionStatus
    ] ;
    rdfs:label "Information requirement"@en ;
    skos:definition "A regulatory requirement specifying that a given information element must be provided in relation to a substance presence context."@en ;
    rdfs:comment "This class represents the obligation to provide information, independently from the actual information object used to satisfy it."@en .

soc:Exemption
    a owl:Class ;
    rdfs:label "Exemption"@en ;
    skos:definition "A regulatory condition under which an information requirement does not apply, or may be waived."@en ;
    rdfs:comment "This class represents exemptions as explicit regulatory objects rather than encoding them only through threshold values."@en .

soc:ExemptionStatus
    a owl:Class ;
    rdfs:label "Exemption status"@en ;
    skos:definition "Controlled value indicating whether an information requirement is exempted, non-exempted, or not assessed."@en .

soc:Exempted
    a owl:NamedIndividual , soc:ExemptionStatus ;
    rdfs:label "exempted"@en .

soc:NotExempted
    a owl:NamedIndividual , soc:ExemptionStatus ;
    rdfs:label "not exempted"@en .

soc:ExemptionNotAssessed
    a owl:NamedIndividual , soc:ExemptionStatus ;
    rdfs:label "exemption not assessed"@en .


soc:hasInformationRequirement
    a owl:ObjectProperty ;
    rdfs:label "has information requirement"@en ;
    skos:definition "Links a substance presence context to an applicable information requirement."@en ;
    rdfs:domain soc:SubstancePresenceContext ;
    rdfs:range soc:InformationRequirement .

soc:isInformationRequirementOf
    a owl:ObjectProperty ;
    rdfs:label "is information requirement of"@en ;
    skos:definition "Links an information requirement to the substance presence context to which it applies."@en ;
    rdfs:domain soc:InformationRequirement ;
    rdfs:range soc:SubstancePresenceContext ;
    owl:inverseOf soc:hasInformationRequirement .

soc:hasExemption
    a owl:ObjectProperty ;
    rdfs:label "has exemption"@en ;
    skos:definition "Links an information requirement to an exemption that may apply to it."@en ;
    rdfs:domain soc:InformationRequirement ;
    rdfs:range soc:Exemption ;
    owl:inverseOf soc:isExemptionOf .

soc:isExemptionOf
    a owl:ObjectProperty ;
    rdfs:label "is exemption of"@en ;
    skos:definition "Links an exemption to the information requirement to which it applies."@en ;
    rdfs:domain soc:Exemption ;
    rdfs:range soc:InformationRequirement .

soc:hasExemptionStatus
    a owl:ObjectProperty ;
    rdfs:label "has exemption status"@en ;
    skos:definition "Links an information requirement to its exemption status."@en ;
    rdfs:domain soc:InformationRequirement ;
    rdfs:range soc:ExemptionStatus .

soc:isResultOfThresholdEvaluation
    a owl:ObjectProperty ;
    rdfs:label "is result of threshold evaluation"@en ;
    skos:definition "Links an information requirement to the threshold evaluation from which it results."@en ;
    rdfs:domain soc:InformationRequirement ;
    rdfs:range soc:ThresholdEvaluation .

soc:hasResultingInformationRequirement
    a owl:ObjectProperty ;
    rdfs:label "has resulting information requirement"@en ;
    skos:definition "Links a threshold evaluation to an information requirement resulting from that evaluation."@en ;
    rdfs:domain soc:ThresholdEvaluation ;
    rdfs:range soc:InformationRequirement ;
    rdfs:comment "This property represents the regulatory consequence of applying a threshold evaluation to a concentration information object."@en ;
    owl:inverseOf soc:isResultOfThresholdEvaluation .

soc:isSatisfiedByLocationInformation
    a owl:ObjectProperty ;
    rdfs:label "is satisfied by location information"@en ;
    skos:definition "Links an information requirement to the location information object that satisfies it."@en ;
    rdfs:domain soc:InformationRequirement ;
    rdfs:range soc:LocationInformation .

soc:isSatisfiedByConcentrationInformation
    a owl:ObjectProperty ;
    rdfs:label "is satisfied by concentration information"@en ;
    skos:definition "Links an information requirement to the concentration information object that satisfies it."@en ;
    rdfs:domain soc:InformationRequirement ;
    rdfs:range soc:ConcentrationInformation .

soc:isSatisfiedByInstructionInformation
    a owl:ObjectProperty ;
    rdfs:label "is satisfied by instruction information"@en ;
    skos:definition "Links an information requirement to the instruction information object that satisfies it."@en ;
    rdfs:domain soc:InformationRequirement ;
    rdfs:range soc:InstructionInformation .

soc:requirementSource
    a owl:DatatypeProperty ;
    rdfs:label "requirement source"@en ;
    skos:definition "Textual source or legal reference from which the information requirement is derived."@en ;
    rdfs:domain soc:InformationRequirement ;
    rdfs:range xsd:string .

soc:requirementNote
    a owl:DatatypeProperty ;
    rdfs:label "requirement note"@en ;
    skos:definition "Additional note explaining the information requirement."@en ;
    rdfs:domain soc:InformationRequirement ;
    rdfs:range xsd:string .

soc:exemptionCondition
    a owl:DatatypeProperty ;
    rdfs:label "exemption condition"@en ;
    skos:definition "Textual description of the condition under which an exemption applies."@en ;
    rdfs:domain soc:Exemption ;
    rdfs:range xsd:string .

soc:exemptionSource
    a owl:DatatypeProperty ;
    rdfs:label "exemption source"@en ;
    skos:definition "Textual source or legal reference from which the exemption is derived."@en ;
    rdfs:domain soc:Exemption ;
    rdfs:range xsd:string .



#################################################################
# 18) Disjointness and distinction axioms
#################################################################

[
    a owl:AllDisjointClasses ;
    owl:members (
        soc:ExactQuantitativeValue
        soc:MaximumQuantitativeValue
        soc:RangeQuantitativeValue
    )
] .

[
    a owl:AllDisjointClasses ;
    owl:members (
        soc:TrackingThreshold
        soc:NonExemptionThreshold
        soc:HazardClassThreshold
        soc:AlertConcentrationThreshold
    )
] .

[
    a owl:AllDifferent ;
    owl:distinctMembers (
        soc:ProductLevel
        soc:ComponentLevel
        soc:MaterialLevel
        soc:SparePartLevel
    )
] .

[
    a owl:AllDifferent ;
    owl:distinctMembers (
        soc:SafeUseInstructionType
        soc:RepairInstructionType
        soc:ReuseInstructionType
        soc:DisassemblyInstructionType
        soc:RecyclingInstructionType
    )
] .

[
    a owl:AllDifferent ;
    owl:distinctMembers (
        soc:ProductBasedConcentrationCalculation
        soc:MaterialGroupBasedConcentrationCalculation
    )
] .

[
    a owl:AllDifferent ;
    owl:distinctMembers (
        soc:Exempted
        soc:NotExempted
        soc:ExemptionNotAssessed
    )
] .

[
    a owl:AllDifferent ;
    owl:distinctMembers (
        soc:ReportingObligation
        soc:RegulatoryActionRequired
        soc:NoActionRequired
    )
] .
[
    a owl:AllDifferent ;
    owl:distinctMembers (
        soc:BelowThreshold
        soc:AtThreshold
        soc:AboveThreshold
        soc:ThresholdNotEvaluated
    )
] .