@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix soc: <https://w3id.org/eudpp/soc#> .
@prefix txt: <https://w3id.org/eudpp/textile-core#> .
@prefix txtam: <https://w3id.org/eudpp/textile-associated-materials#> .
@prefix txtcon: <https://w3id.org/eudpp/textile-connector#> .
@prefix txtprc: <https://w3id.org/eudpp/textile-process#> .
@prefix txtsoc: <https://w3id.org/eudpp/textile-soc#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

txtsoc:NonTextileComponentMaterialGroup a owl:Class ;
    rdfs:label "Non-textile component material group"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A material grouping associated with one or more non-textile components, used as a location or concentration reference unit without treating the component itself as a material group."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf soc:MaterialGroup ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:TextileFibreCompositionMaterialGroup a owl:Class ;
    rdfs:label "Textile fibre-composition material group"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Bridge class for a fibre-composition component that is used as the material-group scope of a textile substance-of-concern presence context."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf txt:FibreCompositionComponent,
        txtsoc:TextileMaterialGroup ;
    txtcon:modellingNote "This local bridge avoids globally reclassifying every Textile Core fibre-composition component as a SoC material group."@en ;
    txtcon:sourceLocator "JRC Section 12.3.12, printed page 246, lines 6847-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:TextileRecyclingAlertThreshold a owl:Class ;
    rdfs:label "Textile recycling alert threshold"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A textile-sector alert concentration used to inform sorting, recycling or environmentally sound end-of-life handling when the substance may hinder circular treatment."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf soc:AlertConcentrationThreshold ;
    txtcon:sourceLocator "JRC Section 9.2.5.2, printed page 142, lines 3910-3927; Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileTrackingThreshold a owl:Class ;
    rdfs:label "Textile tracking threshold"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A tracking or disclosure threshold applicable to a substance occurrence in a textile product or textile product group."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf soc:TrackingThreshold ;
    txtcon:sourceLocator "JRC Section 12.1, printed page 220, lines 6213-6220; Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:hasPresenceChemicalFunction a owl:ObjectProperty ;
    rdfs:label "has presence chemical function"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile substance occurrence to the chemical function performed in that textile context."@en ;
    rdfs:domain txtsoc:TextileSubstanceOfConcernPresenceContext ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtam:TextileChemicalFunctionConcept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 3.3.2, printed pages 29-30, lines 584-593; JRC Preparatory Study, Section 12.3, printed page 226, lines 6437-6455."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:hasPresenceUseCategory a owl:ObjectProperty ;
    rdfs:label "has presence use category"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Classifies the textile chemical occurrence by whether it is associated with process use, intended performance use or unintended presence. The classification is attached to the occurrence rather than globally to the substance identity."@en ;
    rdfs:domain txtsoc:TextileSubstanceOfConcernPresenceContext ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtam:TextileChemicalUseCategoryConcept ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 12.3, printed page 226, lines 6428-6455."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:hasTextileHandlingInformation a owl:ObjectProperty ;
    rdfs:label "has textile handling information"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile substance-of-concern presence context to textile-specific safe-use or lifecycle-handling information."@en ;
    rdfs:domain txtsoc:TextileSubstanceOfConcernPresenceContext ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:TextileSoCHandlingInformation ;
    rdfs:subPropertyOf soc:hasInstructionInformation ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 7(5)(d)-(e)."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:hasTextileLocationType a owl:ObjectProperty ;
    rdfs:label "has textile location type"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a location information object to a controlled textile-specific location type."@en ;
    rdfs:domain soc:LocationInformation ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:TextileSoCLocationTypeConcept ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 7(5)(b)."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:hasTextileProductGroupReference a owl:ObjectProperty ;
    rdfs:label "has textile product-group reference"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile type (d) qualification to the versioned textile product-group reference supporting that qualification."@en ;
    rdfs:domain txtsoc:TextileTypeDQualification ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtsoc:TextileProductGroupSoCReference ;
    rdfs:subPropertyOf soc:isQualifiedByProductGroupList ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 2(27)(d)."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:relevantToTextileProcess a owl:ObjectProperty ;
    rdfs:label "relevant to textile process"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Relates a textile substance occurrence to a textile process type that introduced, used, transformed or is affected by the substance."@en ;
    rdfs:domain txtsoc:TextileSubstanceOfConcernPresenceContext ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:range txtprc:TextileProcess ;
    txtcon:sourceLocator "JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:TextileConcentrationInformation a owl:Class ;
    rdfs:label "Textile concentration information"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Concentration information for a substance present in a textile product, expressed at product, component, material-group or spare-part level as an exact value, maximum value or range."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf soc:ConcentrationInformation ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 7(5)(c)"@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileMaterialGroup a owl:Class ;
    rdfs:label "Textile material group"@en ;
    dcterms:source <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A fibre-, yarn- or fabric-based material grouping within a textile product that serves as a location or mass-reference unit for substance reporting."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf soc:MaterialGroup ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileTypeDQualification a owl:Class ;
    rdfs:label "Textile type (d) qualification"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A product-group-specific type (d) qualification indicating that a substance hinders the reuse or recycling of a textile product or textile material stream."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf soc:SoCTypeDQualification ;
    txtcon:sourceLocator "JRC Section 12.1, printed page 219, lines 6169-6170; Section 12.3.6, printed pages 238-239, lines 6634-6639; Section 12.3.11, printed page 246, lines 6815-6822."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:adhesiveOrBondingLayerLocation a skos:Concept,
        txtsoc:TextileSoCLocationTypeConcept ;
    rdfs:label "Adhesive or bonding layer location"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "The substance is located in an adhesive, laminate, bonding film or other joining layer."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:inScheme txtsoc:TextileSoCLocationTypeScheme ;
    skos:notation "LOC_ADHESIVE_BONDING" ;
    skos:prefLabel "Adhesive or bonding layer location"@en ;
    skos:topConceptOf txtsoc:TextileSoCLocationTypeScheme ;
    txtcon:sourceLocator "ESPR Annex I; JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:coatingOrFinishLocation a skos:Concept,
        txtsoc:TextileSoCLocationTypeConcept ;
    rdfs:label "Coating or finish location"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "The substance is located in a coating, finish or functional surface treatment applied to the textile product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:inScheme txtsoc:TextileSoCLocationTypeScheme ;
    skos:notation "LOC_COATING_FINISH" ;
    skos:prefLabel "Coating or finish location"@en ;
    skos:topConceptOf txtsoc:TextileSoCLocationTypeScheme ;
    txtcon:sourceLocator "ESPR Annex I; JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:fibreCompositionLocation a skos:Concept,
        txtsoc:TextileSoCLocationTypeConcept ;
    rdfs:label "Fibre composition location"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "The substance is located in a fibre-composition material group, including a fibre-, yarn- or fabric-based part."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:inScheme txtsoc:TextileSoCLocationTypeScheme ;
    skos:notation "LOC_FIBRE_COMPOSITION" ;
    skos:prefLabel "Fibre composition location"@en ;
    skos:topConceptOf txtsoc:TextileSoCLocationTypeScheme ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:nonTextileComponentLocation a skos:Concept,
        txtsoc:TextileSoCLocationTypeConcept ;
    rdfs:label "Non-textile component location"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "The substance is located in a non-textile component such as a button, zipper, buckle, rivet, sequin or other hard component."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:inScheme txtsoc:TextileSoCLocationTypeScheme ;
    skos:notation "LOC_NON_TEXTILE_COMPONENT" ;
    skos:prefLabel "Non-textile component location"@en ;
    skos:topConceptOf txtsoc:TextileSoCLocationTypeScheme ;
    txtcon:sourceLocator "JRC Preparatory Study, Section 12.3.12, printed page 246, lines 6847-6861."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:printedOrDyedRegionLocation a skos:Concept,
        txtsoc:TextileSoCLocationTypeConcept ;
    rdfs:label "Printed or dyed region location"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "The substance is located in a printed, dyed or otherwise colour-treated region of the textile product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:inScheme txtsoc:TextileSoCLocationTypeScheme ;
    skos:notation "LOC_PRINT_DYE" ;
    skos:prefLabel "Printed or dyed region location"@en ;
    skos:topConceptOf txtsoc:TextileSoCLocationTypeScheme ;
    txtcon:sourceLocator "ESPR Annex I; JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:unknownTextileProductLocation a skos:Concept,
        txtsoc:TextileSoCLocationTypeConcept ;
    rdfs:label "Unknown textile product location"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "The product contains the substance but the more specific location within the textile product has not been determined or disclosed."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:inScheme txtsoc:TextileSoCLocationTypeScheme ;
    skos:notation "LOC_UNKNOWN" ;
    skos:prefLabel "Unknown textile product location"@en ;
    skos:topConceptOf txtsoc:TextileSoCLocationTypeScheme ;
    txtcon:sourceLocator "ESPR Annex I; JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:wholeProductLocation a skos:Concept,
        txtsoc:TextileSoCLocationTypeConcept ;
    rdfs:label "Whole textile product location"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "The substance is reported as distributed throughout, or only locatable at the level of, the whole textile product."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:inScheme txtsoc:TextileSoCLocationTypeScheme ;
    skos:notation "LOC_WHOLE_PRODUCT" ;
    skos:prefLabel "Whole textile product location"@en ;
    skos:topConceptOf txtsoc:TextileSoCLocationTypeScheme ;
    txtcon:sourceLocator "ESPR Annex I; JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:TextileProductGroupSoCReference a owl:Class ;
    rdfs:label "Textile product-group SoC reference"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A versioned reference identifying the textile-product-group source that qualifies a substance under the product-group-specific type (d) criterion."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf soc:ProductGroupSpecificSoCList ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 2(27)(d)."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:TextileSoCHandlingInformation a owl:Class ;
    rdfs:label "Textile SoC handling information"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Textile-specific instruction information concerning safe use and lifecycle handling in the presence of a substance of concern, including disassembly, preparation for reuse, reuse, recycling and environmentally sound end-of-life management; repair guidance may be added as a textile/JRC extension."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf soc:InstructionInformation ;
    txtcon:sourceLocator "JRC Section 12.1, printed pages 219-220, lines 6205-6220."@en ;
    txtcon:sourceType txtcon:adaptedDefinition .

txtsoc:TextileSubstanceOfConcernPresenceContext a owl:Class ;
    rdfs:label "Textile substance of concern presence context"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "A substance-of-concern presence context specialised for a textile product, textile material group or non-textile component."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf soc:SubstanceOfConcernPresenceContext ;
    txtcon:sourceLocator "Regulation (EU) 2024/1781, Article 2(27) and Article 7(5); core pivot pattern soc:SubstanceOfConcernPresenceContext"@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:TextileSoCLocationTypeConcept a owl:Class ;
    rdfs:label "Textile SoC location type concept"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled concept describing a textile-specific kind of product location used to qualify a substance location statement."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    rdfs:subClassOf skos:Concept ;
    txtcon:sourceLocator "ESPR Annex I; JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

txtsoc:TextileSoCLocationTypeScheme a skos:ConceptScheme ;
    rdfs:label "Textile SoC location type scheme"@en ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    rdfs:comment "Controlled vocabulary of textile-specific location types used in substance location information."@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/textile-soc> ;
    skos:hasTopConcept txtsoc:adhesiveOrBondingLayerLocation,
        txtsoc:coatingOrFinishLocation,
        txtsoc:fibreCompositionLocation,
        txtsoc:nonTextileComponentLocation,
        txtsoc:printedOrDyedRegionLocation,
        txtsoc:unknownTextileProductLocation,
        txtsoc:wholeProductLocation ;
    skos:prefLabel "Textile SoC location type scheme"@en ;
    txtcon:sourceLocator "ESPR Annex I; JRC Section 12.1, printed pages 219-220, lines 6203-6220; JRC Section 12.3.12, printed page 246, lines 6823-6863."@en ;
    txtcon:sourceType txtcon:modellingAbstraction .

<https://w3id.org/eudpp/textile-soc> a owl:Ontology ;
    rdfs:label "Textile substances of concern ontology"@en ;
    dcterms:bibliographicCitation "EU DPP Textile Ontology - Textile Substances of Concern Module. Version 1.1.2."@en ;
    dcterms:created "2026-07-09"^^xsd:date ;
    dcterms:creator "Elio Hbeich"@en,
        "BOUGACHA Racem"@en ;
    dcterms:description "Textile-sector specialisation of the EU DPP Substances of Concern ontology. It specialises substance presence, product location, concentration reporting, product-group qualification, thresholds and lifecycle handling for textile products."@en ;
    dcterms:issued "2026-07-09"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-07-16"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1781/oj>,
        <https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf>,
        <https://w3id.org/eudpp/textile-ontology> ;
    dcterms:title "EU DPP Textile Ontology - Textile Substances of Concern Module"@en ;
    vann:preferredNamespacePrefix "txtsoc" ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/textile-soc#" ;
    rdfs:comment "This module does not classify every textile chemical as a substance of concern. It specialises the generic SoC presence-context model for textile products and attaches textile-specific information to the occurrence, not globally to the chemical identity."@en ;
    owl:imports <https://w3id.org/eudpp/textile-associated-materials>,
        <https://w3id.org/eudpp/textile-connector>,
        <https://w3id.org/eudpp/textile-core>,
        <https://w3id.org/eudpp/textile-process>,
        <https://w3id.org/eudpp/textile-soc-mireot> ;
    owl:versionIRI <https://w3id.org/eudpp/textile-soc/1.1.2> ;
    owl:versionInfo "Version 1.1.2" .

[] a owl:AllDisjointClasses ;
    owl:members ( txtsoc:TextileSubstanceOfConcernPresenceContext txtsoc:TextileConcentrationInformation txtsoc:TextileProductGroupSoCReference txtsoc:TextileSoCHandlingInformation ) .

