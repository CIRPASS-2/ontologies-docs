@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dpp:hasMaterialType a owl:ObjectProperty ;
    rdfs:label "Has material type"@en ;
    rdfs:domain dpp:MaterialOfComposition ;
    rdfs:range dpp:MaterialType .

<https://w3id.org/eudpp/textile-mat-mireot> a owl:Ontology ;
    rdfs:label "Textile MAT MIREOT subset"@en ;
    dcterms:description "Bounded Textile-scoped MIREOT subset of MAT terms required by the CIRPASS Textile Ontology."@en ;
    dcterms:modified "2026-07-24"^^xsd:date ;
    dcterms:references "External source ontology version 1.0.2."@en ;
    dcterms:source <https://w3id.org/eudpp/MAT> ;
    dcterms:title "Textile MAT MIREOT subset"@en ;
    owl:versionIRI <https://w3id.org/eudpp/textile-mat-mireot/1.1.2> ;
    owl:versionInfo "Version 1.1.2" .

dpp:MaterialOfComposition a owl:Class ;
    rdfs:label "Material of composition"@en ;
    rdfs:comment "Material the product (or component) is made of [ESPR Annex I]. Material as an element of composition."@en .

dpp:MaterialType a owl:Class ;
    rdfs:label "Material type"@en ;
    rdfs:comment """Placeholder class for material type classification applicable in a sector or mandated by a delegated act (DA).

Potential types could be, on the example of textile sector: cotton, nylon, ..."""@en .
