    <rdfs:comment xml:lang="en">(Optional) An unordered list of one or more EPCs naming specific objects to which the event pertained.</rdfs:comment>
    <rdfs:domain rdf:nodeID="n7beafeda066d4019a2da909b6e4bb324b24"/>
    <schema1:domainIncludes rdf:resource="https://ref.gs1.org/epcis/ObjectEvent"/>
    <schema1:domainIncludes rdf:resource="https://ref.gs1.org/epcis/TransactionEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ref.gs1.org/epcis/"/>
    <rdfs:label>epcList</rdfs:label>
    <sw:term_status>stable</sw:term_status>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp#dppEventRecordIdentifier">
