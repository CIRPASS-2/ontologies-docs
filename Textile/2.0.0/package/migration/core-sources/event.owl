  <rdf:Description rdf:about="https://w3id.org/eudpp#MakingAvailableOnMarketEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
    <rdfs:label xml:lang="en">Making Available on the Market</rdfs:label>
    <rdfs:comment xml:lang="en">Any supply of a product for distribution, consumption or use on the Union market in the course of a commercial activity, whether in return for payment or free of charge. ESPR Art 2(39).</rdfs:comment>
    <dcterms:source xml:lang="en">Regulation (EU) 2024/1781; Art 2(39)</dcterms:source>
    <dcterms:identifier>https://eur-lex.europa.eu/eli/reg/2024/1781/oj</dcterms:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://ref.gs1.org/epcis/eventTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment xml:lang="en">The date and time at which the EPCIS Capturing Applications asserts the event occurred.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
    <schema1:domainIncludes rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
