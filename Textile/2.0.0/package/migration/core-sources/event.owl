    <sw:term_status>stable</sw:term_status>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp#DPPArchivalEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#DPPEvent"/>
    <rdfs:label xml:lang="en">DPP Archival Event</rdfs:label>
    <rdfs:comment xml:lang="en">An event corresponding to the archival or end-of-active-life management of a Digital Product Passport.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp#hasProductEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has product event</rdfs:label>
    <rdfs:comment xml:lang="en">Links an EPCIS-inspired technical event carrier to the product event semantics it journalises.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ref.gs1.org/epcis/EPCISEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/eudpp#isRepresentedByCarrier"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7beafeda066d4019a2da909b6e4bb324b4">
    <rdf:first rdf:resource="https://w3id.org/eudpp#ProductEvent"/>
    <rdf:rest rdf:nodeID="n7beafeda066d4019a2da909b6e4bb324b5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7beafeda066d4019a2da909b6e4bb324b8">
    <rdf:first rdf:resource="https://w3id.org/eudpp#DPPUpdateEvent"/>
