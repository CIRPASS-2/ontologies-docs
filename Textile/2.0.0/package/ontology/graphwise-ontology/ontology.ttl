<https://w3id.org/eudpp/expiresOn> a owl:DatatypeProperty;
  rdfs:domain <https://w3id.org/eudpp/Identifier>;
  rdfs:range xsd:date;
  rdfs:label "expires on"@en;
  rdfs:isDefinedBy <https://w3id.org/eudpp/> .

<https://w3id.org/eudpp/name> a owl:DatatypeProperty;
  rdfs:domain <https://w3id.org/eudpp/Entity>;
  rdfs:range xsd:string;
  rdfs:comment "Name of an entity (Agent, Facility, Product, etc.)."@en;
  rdfs:label "name"@en;
  rdfs:isDefinedBy <https://w3id.org/eudpp/> .

<https://w3id.org/eudpp/postalAddress> a owl:DatatypeProperty;
  rdfs:domain <https://w3id.org/eudpp/Entity>;
