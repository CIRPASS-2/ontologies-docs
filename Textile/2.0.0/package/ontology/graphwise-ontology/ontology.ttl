  rdf:first <https://w3id.org/eudpp/ClassificationScheme>;
  rdf:rest rdf:nil .

<https://w3id.org/eudpp/emailAddress> a owl:DatatypeProperty;
  rdfs:domain <https://w3id.org/eudpp/Entity>;
  rdfs:range xsd:string;
  rdfs:label "email address"@en;
  rdfs:isDefinedBy <https://w3id.org/eudpp/> .

<https://w3id.org/eudpp/date> a owl:DatatypeProperty;
  rdfs:domain <https://w3id.org/eudpp/ProductAgentRelationOrEvent>;
  rdfs:range xsd:date;
  rdfs:comment "If present, the relation can be interpreted as an event occurring on this date."@en;
  rdfs:label "date"@en;
  rdfs:isDefinedBy <https://w3id.org/eudpp/> .

<https://w3id.org/eudpp/mandatorinessLevel> a owl:DatatypeProperty;
  rdfs:domain _:ddfe0312827244cdba84c5eafdf0c1d7408;
  rdfs:range xsd:integer;
  rdfs:comment "Level of mandatoriness/desirability (0..10) of the identifier/classification scheme for the given appliesTo class(es). Eg EUDPP products must have at least one DPP ID";
  rdfs:label "mandatoriness level"@en;
  rdfs:isDefinedBy <https://w3id.org/eudpp/> .

_:ddfe0312827244cdba84c5eafdf0c1d7408 a owl:Class;
  owl:unionOf _:ddfe0312827244cdba84c5eafdf0c1d7409 .

_:ddfe0312827244cdba84c5eafdf0c1d7409 a rdf:List;
  rdf:first <https://w3id.org/eudpp/IdentifierScheme>;
  rdf:rest _:ddfe0312827244cdba84c5eafdf0c1d7410 .

_:ddfe0312827244cdba84c5eafdf0c1d7410 a rdf:List;
  rdf:first <https://w3id.org/eudpp/ClassificationScheme>;
  rdf:rest rdf:nil .

<https://w3id.org/eudpp/isPreferred> a owl:DatatypeProperty;
  rdfs:domain _:ddfe0312827244cdba84c5eafdf0c1d7411;
  rdfs:range xsd:boolean;
  rdfs:comment "Whether this mandatory identifier/classification scheme is preferred and its code is used in the Entity URL";
  rdfs:label "is preferred"@en;
  rdfs:isDefinedBy <https://w3id.org/eudpp/> .

_:ddfe0312827244cdba84c5eafdf0c1d7411 a owl:Class;
  owl:unionOf _:ddfe0312827244cdba84c5eafdf0c1d7412 .

