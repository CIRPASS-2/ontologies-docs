  rdfs:domain _:ddfe0312827244cdba84c5eafdf0c1d7396;
  rdfs:range xsd:string;
  rdfs:comment "A regexp that the identifier/classification code must conform to."@en;
  rdfs:label "code pattern"@en;
  rdfs:isDefinedBy <https://w3id.org/eudpp/> .

_:ddfe0312827244cdba84c5eafdf0c1d7396 a owl:Class;
  owl:unionOf _:ddfe0312827244cdba84c5eafdf0c1d7397 .

_:ddfe0312827244cdba84c5eafdf0c1d7397 a rdf:List;
  rdf:first <https://w3id.org/eudpp/IdentifierScheme>;
  rdf:rest _:ddfe0312827244cdba84c5eafdf0c1d7398 .

_:ddfe0312827244cdba84c5eafdf0c1d7398 a rdf:List;
