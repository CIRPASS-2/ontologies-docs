_:ddfe0312827244cdba84c5eafdf0c1d7413 a rdf:List;
  rdf:first <https://w3id.org/eudpp/ClassificationScheme>;
  rdf:rest rdf:nil .

<https://w3id.org/eudpp/code> a owl:DatatypeProperty;
  rdfs:domain _:ddfe0312827244cdba84c5eafdf0c1d7391;
  rdfs:range xsd:string;
  rdfs:comment "The code of an Identifier, Classification, IdentifierScheme, or ClassificationScheme."@en;
  rdfs:label "code"@en;
  rdfs:isDefinedBy <https://w3id.org/eudpp/> .

_:ddfe0312827244cdba84c5eafdf0c1d7391 a owl:Class;
  owl:unionOf _:ddfe0312827244cdba84c5eafdf0c1d7392 .

