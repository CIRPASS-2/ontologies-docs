  rdf:first <https://w3id.org/eudpp/Classification>;
  rdf:rest _:ddfe0312827244cdba84c5eafdf0c1d7394 .

_:ddfe0312827244cdba84c5eafdf0c1d7394 a rdf:List;
  rdf:first <https://w3id.org/eudpp/IdentifierScheme>;
  rdf:rest _:ddfe0312827244cdba84c5eafdf0c1d7395 .

_:ddfe0312827244cdba84c5eafdf0c1d7395 a rdf:List;
  rdf:first <https://w3id.org/eudpp/ClassificationScheme>;
  rdf:rest rdf:nil .

