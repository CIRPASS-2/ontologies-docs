    <txtcon:sourceLocator xml:lang="en">candidate JRC DO2 scale in Section 11.1.2.1, pages 190-191.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#hasMaximumScoreValue">
