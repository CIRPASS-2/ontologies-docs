    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#preparationForRecyclingCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#sortabilityCriterion"/>
    <skos:prefLabel xml:lang="en">System-condition criterion</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionScheme"/>
