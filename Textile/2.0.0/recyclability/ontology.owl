    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Recyclability label concept</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#conditionalRecyclabilityLabel">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept"/>
    <rdfs:comment xml:lang="en">Method-specific label indicating recyclability only for certain routes, conditions or pre-treatments.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Conditional recyclability label</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelScheme"/>
    <skos:prefLabel xml:lang="en">Conditional recyclability label</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#substanceOfConcernBarrier">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept"/>
    <rdfs:comment xml:lang="en">A substance presence or qualification hinders reuse, recycling or recovered-material use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Substance-of-concern barrier</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <skos:prefLabel xml:lang="en">Substance-of-concern barrier</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5410-5443; Table 76, printed page 191, caption line 5441; JRC Preparatory Study, Section 12.3.8, printed pages 239-240, lines 6673-6719; JRC Preparatory Study, Section 12.3.10, printed pages 241-242, lines 6739-6779.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#highRecyclabilityLabel">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept"/>
    <rdfs:comment xml:lang="en">Method-specific label indicating a comparatively favourable assessment outcome under stated assumptions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">High recyclability label</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelScheme"/>
    <skos:prefLabel xml:lang="en">High recyclability label</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessmentMethod">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Reusable procedure for evaluating textile-product recyclability against stated criteria, assumed system conditions and one or more recycling routes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Recyclability assessment method</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentMethod"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#unavailableDataCarrierBarrier">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept"/>
    <rdfs:comment xml:lang="en">The product data carrier is missing, damaged or inaccessible at end of life, preventing retrieval of reliable sorting and recycling information.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Unavailable data carrier barrier</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <skos:prefLabel xml:lang="en">Unavailable data carrier barrier</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC DPP Study, Section 6.1.4, printed pages 38-39, dependence of end-of-life sorting on an available DPP data carrier.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#ManufacturerDeclarationVerificationMethod">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Verification method based on a declaration made by the manufacturer.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Manufacturer-declaration verification method</rdfs:label>
