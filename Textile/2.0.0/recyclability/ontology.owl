    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5410-5443; Table 76, printed page 191, caption line 5441; JRC Preparatory Study, Section 12.3.8, printed pages 239-240, lines 6673-6719; JRC Preparatory Study, Section 12.3.10, printed pages 241-242, lines 6739-6779.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
