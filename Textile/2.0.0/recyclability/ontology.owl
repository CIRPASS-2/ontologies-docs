    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingLoopConcept"/>
    <rdfs:comment xml:lang="en">Recycling route producing material for a product system other than textile fibre-to-fibre use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Open-loop recycling</rdfs:label>
