  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentAssessment">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Assessment execution that verifies or evaluates a recycled-content declaration for a textile product.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Recycled content assessment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-assessment#AssessmentExecution"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.5.4, printed pages 143-144, lines 3957-3982.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability">
    <dcterms:bibliographicCitation xml:lang="en">EU DPP Textile Recyclability Ontology. Version 2.0.0 candidate.</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-09</dcterms:created>
    <dcterms:creator xml:lang="en">Andreas Schneider</dcterms:creator>
    <dcterms:creator xml:lang="en">BOUGACHA Racem</dcterms:creator>
    <dcterms:creator xml:lang="en">Elio Hbeich</dcterms:creator>
    <dcterms:creator xml:lang="en">Ivo Ladenius</dcterms:creator>
    <dcterms:creator xml:lang="en">Jan Merckx</dcterms:creator>
    <dcterms:creator xml:lang="en">Piero de Sabbata</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology module for route-specific textile recyclability, assessment criteria and results, barriers, scores and labels, actual recycling events, recovered materials, textile waste categories, recycling yield and recycled-content declarations.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-09</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <dcterms:title xml:lang="en">EU DPP Textile Recyclability Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>txtrec</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-recyclability#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Recyclability is represented as route-specific potential assessed under stated collection, sorting, preparation and recycling conditions. It must not be inferred from a universal boolean.</rdfs:comment>
    <rdfs:comment xml:lang="en">Recycled content is represented separately from recyclability: a product can contain recycled material without being recyclable through a given route, and a recyclable product may contain no recycled material.</rdfs:comment>
    <rdfs:comment xml:lang="en">Scores and labels are method-specific and do not constitute adopted regulatory classifications unless a future delegated act or standard defines them.</rdfs:comment>
    <rdfs:label xml:lang="en">EU DPP Textile Recyclability Ontology</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-assessment"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-associated-materials"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-core"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-event-mireot"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-indicator"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-process"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-soc"/>
    <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-recyclability/2.0.0"/>
    <owl:versionInfo>Version 2.0.0 candidate</owl:versionInfo>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#projectDecision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#automatedSortingTechnique">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingTechniqueConcept"/>
    <rdfs:comment xml:lang="en">Machine-based sorting technique, including systems using near-infrared spectroscopy or product identifiers.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Automated sorting technique</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingTechniqueScheme"/>
    <skos:prefLabel xml:lang="en">Automated sorting technique</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingTechniqueScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.5.1, printed pages 135-136, lines 3713-3752.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#manualSeparationPreTreatment">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueConcept"/>
    <rdfs:comment xml:lang="en">Manual removal of non-textile parts from fibre-containing textile parts.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Manual separation pre-treatment</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueScheme"/>
    <skos:prefLabel xml:lang="en">Manual separation pre-treatment</skos:prefLabel>
