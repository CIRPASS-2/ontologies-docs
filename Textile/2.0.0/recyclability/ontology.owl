    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#spinningStageTextileWaste"/>
    <skos:notation>WASTE_POST_INDUSTRIAL</skos:notation>
    <skos:prefLabel xml:lang="en">Post-industrial textile waste</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceScheme"/>
