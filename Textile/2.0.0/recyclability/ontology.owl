    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept"/>
    <rdfs:comment xml:lang="en">Method-specific criterion evaluating whether dyes interfere with the intended recycling route. It must not be interpreted as a universal requirement that recyclable textiles be undyed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Dye absence criterion</rdfs:label>
