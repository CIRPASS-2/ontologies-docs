    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#monoMaterialCriterion">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept"/>
    <rdfs:comment xml:lang="en">Method-specific criterion evaluating whether the product or assessed material group consists of one principal material stream.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Mono-material criterion</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-recyclability#productDesignCriterion"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionScheme"/>
    <skos:prefLabel xml:lang="en">Mono-material criterion</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5402-5443; Table 76, printed page 191, caption line 5441.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#assessesRecyclabilityOf">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a recyclability assessment execution specifically to the product whose recyclability it assesses.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityAssessment"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">assesses recyclability of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp#Product"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-assessment#assessesProduct"/>
    <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#hasRecyclabilityAssessment"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityOutcomeConcept">
