    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceConcept"/>
    <rdfs:comment xml:lang="en">Post-industrial textile waste generated during fabric manufacturing or apparel confectioning.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Fabric or confectioning-stage textile waste</rdfs:label>
