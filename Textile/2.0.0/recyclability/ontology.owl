  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileChemicalRecyclingEvent">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Textile recycling event executing the chemical recycling process type.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Textile chemical recycling event</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileRecyclingEvent"/>
    <rdfs:subClassOf rdf:nodeID="cb280af6fa4d565fc5408ff2acc3a0ff5599c765cb2ae0b4513c2ae3422c1c8cc1a"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceScheme">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary for recycled content source scheme.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Recycled content source scheme</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#postConsumerRecycledContent"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#postIndustrialRecycledContent"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#preConsumerRecycledContent"/>
    <skos:prefLabel xml:lang="en">Recycled content source scheme</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#nonTextileComponentBarrier">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept"/>
    <rdfs:comment xml:lang="en">A non-textile component interferes with sorting, preparation or recycling.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Non-textile component barrier</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <skos:prefLabel xml:lang="en">Non-textile component barrier</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5410-5443; Table 76, printed page 191, caption line 5441; JRC Preparatory Study, Section 12.3.8, printed pages 239-240, lines 6673-6719; JRC Preparatory Study, Section 12.3.10, printed pages 241-242, lines 6739-6779.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#fibreToFibreRecycling">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingLoopConcept"/>
    <rdfs:comment xml:lang="en">Recycling route intended to produce fibre or material feedstock usable in textile products.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Fibre-to-fibre recycling</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingLoopScheme"/>
    <skos:prefLabel xml:lang="en">Fibre-to-fibre recycling</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclingLoopScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#CollectionSchemeConcept">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">SKOS concept used to classify an arrangement for collecting textile waste.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Collection scheme concept</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.5.1, pages 135-136.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#hasRecyclabilityLabel">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a recyclability score to a controlled method-specific label.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityScore"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">has recyclability label</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp/textile-indicator#hasCategoricalValue"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.3.3, printed page 86, lines 2193-2205; JRC DPP Study, Section 7.3, printed page 49, data point “Recyclability score”.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#postConsumerRecycledContent">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceConcept"/>
    <rdfs:comment xml:lang="en">Recycled material recovered from products after use by consumers or end users.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Post-consumer recycled content</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceScheme"/>
    <skos:prefLabel xml:lang="en">Post-consumer recycled content</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC DPP Study, Section 7.3, printed page 50, post-consumer recycled-content origin.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#SortingCriterionScheme">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary of criteria used to sort textile waste for recycling routes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Sorting criterion scheme</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#colourSortingCriterion"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#fibreCompositionSortingCriterion"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#productConstructionSortingCriterion"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-recyclability#productTypeSortingCriterion"/>
    <skos:prefLabel xml:lang="en">Sorting criterion scheme</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.5.1, printed pages 135-136, lines 3713-3752.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#collectionOrSortingSystemBarrier">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept"/>
    <rdfs:comment xml:lang="en">The assumed collection or sorting system cannot reliably direct the product to the intended recycling route.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Collection or sorting system barrier</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <skos:prefLabel xml:lang="en">Collection or sorting system barrier</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#coatingBarrier">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept"/>
    <rdfs:comment xml:lang="en">A coating interferes with separation, recycling or recovered-material quality.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Coating barrier</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#highRiskCoatingBarrier"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#mediumRiskCoatingBarrier"/>
    <skos:prefLabel xml:lang="en">Coating barrier</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5410-5443; Table 76, printed page 191, caption line 5441; JRC Preparatory Study, Section 12.3.8, printed pages 239-240, lines 6673-6719; JRC Preparatory Study, Section 12.3.10, printed pages 241-242, lines 6739-6779.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#sortabilityCriterion">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept"/>
    <rdfs:comment xml:lang="en">Whether the product can be segregated from other waste and assigned to an appropriate recycling stream.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Sortability criterion</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-recyclability#systemConditionCriterion"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionScheme"/>
    <skos:prefLabel xml:lang="en">Sortability criterion</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.5.1, printed pages 135-136, lines 3713-3752.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#disruptiveElementAbsenceCriterion">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept"/>
    <rdfs:comment xml:lang="en">Whether the product lacks elements or substances that disrupt collection, sorting, preparation or recycling or limit recovered-fibre use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Absence of disruptive elements criterion</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-recyclability#productDesignCriterion"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionScheme"/>
    <skos:prefLabel xml:lang="en">Absence of disruptive elements criterion</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 11.1.2.1, printed pages 190-191, lines 5410-5443; Table 76, printed page 191, caption line 5441; JRC Preparatory Study, Section 12.3.8, printed pages 239-240, lines 6673-6719; JRC Preparatory Study, Section 12.3.10, printed pages 241-242, lines 6739-6779.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#criterionSatisfied">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityOutcomeConcept"/>
    <rdfs:comment xml:lang="en">The assessed evidence satisfies the criterion.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Criterion satisfied</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityOutcomeScheme"/>
    <skos:prefLabel xml:lang="en">Criterion satisfied</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityOutcomeScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#hasReferenceProductMassValue">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a recycled-content declaration to the reference product mass, excluding trims where the applicable method requires this basis.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentDeclaration"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">has reference product mass value</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#QuantitativeValue"/>
    <txtcon:sourceLocator xml:lang="en">JRC DPP Study, Section 7.4, printed page 54, reference product weight excluding trims.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#routeSpecificCriterion">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept"/>
    <rdfs:comment xml:lang="en">Criterion whose outcome depends on the selected recycling technology or route.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Route-specific criterion</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionScheme"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#coatingAbsenceCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#dyeAbsenceCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#elastaneProportionCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#fibreCompositionEligibilityCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#fibreFeedstockUseCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#mechanicalRecyclingCompatibilityCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#printingAbsenceCriterion"/>
    <skos:prefLabel xml:lang="en">Route-specific criterion</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Controlled concept identifying a criterion used in a recyclability assessment.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Recyclability criterion concept</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#barrierAppliesToRoute">
