    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Recovered textile material represented as a textile fibre suitable, subject to quality and process requirements, for use in textile products.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Recycled textile fibre</rdfs:label>
