  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#postIndustrialRecycledContent">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceConcept"/>
    <rdfs:comment xml:lang="en">Recycled material originating from industrial production waste, using the ESPR-oriented source terminology described by the DPP content study.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Post-industrial recycled content</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceScheme"/>
    <skos:prefLabel xml:lang="en">Post-industrial recycled content</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC DPP Study, Section 7.3, printed page 50, post-industrial recycled-content origin.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#manualSortingTechnique">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingTechniqueConcept"/>
    <rdfs:comment xml:lang="en">Sorting technique based on human inspection.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Manual sorting technique</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingTechniqueScheme"/>
    <skos:prefLabel xml:lang="en">Manual sorting technique</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingTechniqueScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.5.1, printed pages 135-136, lines 3713-3752.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#SortingTechniqueConcept">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">SKOS concept used to classify a textile sorting technique.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Sorting technique concept</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.5.1, page 137.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#productConstructionSortingCriterion">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingCriterionConcept"/>
    <rdfs:comment xml:lang="en">Sorting criterion based on product or fabric construction, including mono-layer or multi-layer and woven or knitted structures.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Product-construction sorting criterion</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingCriterionScheme"/>
    <skos:prefLabel xml:lang="en">Product-construction sorting criterion</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#SortingCriterionScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.5.1, printed pages 135-136, lines 3713-3752.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#RecycledContentSourceConcept">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Controlled concept identifying the lifecycle source category of recycled content, including post-industrial, pre-consumer and post-consumer material. The declaration or method must state the definition framework used because ISO and ESPR terminology are not fully aligned.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Recycled content source concept</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <txtcon:sourceLocator xml:lang="en">JRC DPP Study, Section 7.3, printed page 50, data point “Origin of the recycled content”.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#insufficientCompositionInformationBarrier">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept"/>
    <rdfs:comment xml:lang="en">Composition or dismantling data are insufficient for reliable route selection.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Insufficient composition information barrier</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <skos:prefLabel xml:lang="en">Insufficient composition information barrier</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#shreddingPreTreatment">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueConcept"/>
    <rdfs:comment xml:lang="en">Pre-treatment in which textile material is shredded to improve the efficiency of a subsequent recycling technique.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Shredding pre-treatment</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueScheme"/>
    <skos:prefLabel xml:lang="en">Shredding pre-treatment</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#PreTreatmentTechniqueScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.5.1, printed pages 136-137, lines 3753-3760; Table 50, printed pages 137-138, caption at line 3774.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#RecyclabilityLabelConcept">
