    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceConcept"/>
    <rdfs:comment xml:lang="en">Textile waste generated during manufacturing of textile products or their fibre, yarn and fabric precursors, including cutting waste, roll ends, excess material, production errors and certain discarded finished products.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Post-industrial textile waste</rdfs:label>
