    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#innerOuterCompositionSimilarityCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#materialChoiceCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#materialSeparabilityCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#monoMaterialCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#sequinAbsenceCriterion"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-recyclability#substanceRestrictionCriterion"/>
    <skos:prefLabel xml:lang="en">Product-design criterion</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#preparationForRecyclingCriterion">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionConcept"/>
    <rdfs:comment xml:lang="en">Whether the product can be prepared for recycling, or sent directly to recycling without route-incompatible preparation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Preparation for recycling criterion</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-recyclability#systemConditionCriterion"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityCriterionScheme"/>
    <skos:prefLabel xml:lang="en">Preparation for recycling criterion</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#mixedFibreCompositionBarrier">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept"/>
    <rdfs:comment xml:lang="en">Mixed fibre composition hinders or constrains the selected recycling route.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Mixed-fibre composition barrier</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <skos:prefLabel xml:lang="en">Mixed-fibre composition barrier</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.10.1.14, printed pages 481-482, lines 11685-11730.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#preConsumerTextileWaste">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceConcept"/>
    <rdfs:comment xml:lang="en">Textile waste generated at the retailer stage by discarding unsold products because of overstock, obsolescence, damage, defects or qualifying returns.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Pre-consumer textile waste</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceScheme"/>
    <skos:notation>WASTE_PRE_CONSUMER</skos:notation>
    <skos:prefLabel xml:lang="en">Pre-consumer textile waste</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#TextileWasteSourceScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 15, lines 197-207; JRC Preparatory Study, Section 9.2.4, printed page 130, lines 3496-3505.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#multiLayerConstructionBarrier">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2026-05/Textiles_DPP_20260513.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeConcept"/>
    <rdfs:comment xml:lang="en">A multi-layer construction limits reliable automated identification or separation for recycling.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Multi-layer construction sorting barrier</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <skos:prefLabel xml:lang="en">Multi-layer construction sorting barrier</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-recyclability#RecyclabilityBarrierTypeScheme"/>
    <txtcon:sourceLocator xml:lang="en">JRC DPP Study, Section 6.1.4, printed page 38, sorting limitations involving multilayer or different inner/outer fibre construction.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#coatingAbsenceCriterion">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
