    <rdfs:comment xml:lang="en">Barrier associated with reactive dyes, sulphur dyes or pigments that may hinder recycling or affect recovered-material quality.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Reactive or sulphur dye barrier</rdfs:label>
