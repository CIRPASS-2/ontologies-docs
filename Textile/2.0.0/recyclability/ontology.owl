  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-recyclability#TextileWaste">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Textile product that the holder discards, intends to discard or is required to discard.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-recyclability"/>
    <rdfs:label xml:lang="en">Textile waste</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp/textile-core#TextileProduct"/>
    <txtcon:modellingNote xml:lang="en">TextileWaste represents a textile product in a waste status. The generation-stage category is supplied separately through hasWasteSourceType.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, relevant section, printed page 15, lines 188-212; JRC Preparatory Study, Section 9.2.4, printed page 130, lines 3487-3509.</txtcon:sourceLocator>
