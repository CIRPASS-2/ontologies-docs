  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#cleaningFrequency">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">How often a textile product undergoes laundering, professional cleaning, hand washing, airing, steaming or another cleaning operation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Cleaning frequency</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#careContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
