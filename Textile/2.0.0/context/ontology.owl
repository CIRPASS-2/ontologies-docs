    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">The duration for which a product is used during a stated episode or reference period, distinct from an estimated product lifetime.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Duration of use</rdfs:label>
