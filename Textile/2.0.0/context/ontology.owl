  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#intensityOfUse">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">The severity or demanding nature of product use; any implementation must define the scale or operational criterion used.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Intensity of use</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#useContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Intensity of use</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.6.1, printed pages 146-147, lines 4090-4130.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#storageHumidity">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Ambient humidity condition applying while a textile product is stored.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Storage humidity</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#storageContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Storage humidity</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3322-3325; JRC Preparatory Study, Section 9.2.2.1, printed page 123, lines 3260-3262.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#laundrySortingPractice">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Practice used to sort textile items before washing, for example by colour, fibre type or washing temperature.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Laundry sorting practice</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#careContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Laundry sorting practice</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.7.2.1, printed pages 395-396, lines 10249-10268; JRC Preparatory Study, Section 9.2.2.1, printed page 123, lines 3249-3255.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtctx:typicallyQualifiesProcess rdf:resource="https://w3id.org/eudpp/textile-process#WashingProcess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#typicallyQualifiesProcess">
