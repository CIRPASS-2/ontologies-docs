    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Duration of use</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Annex 13.7.2, printed page 395, lines 10235-10243.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
