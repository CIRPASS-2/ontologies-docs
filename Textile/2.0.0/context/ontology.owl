  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#careBehaviour">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">User choices and practices affecting laundering, drying, ironing, storage or maintenance of a textile product.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Care behaviour</rdfs:label>
    <skos:altLabel xml:lang="en">Maintenance practice</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#userBehaviourFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Care behaviour</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.3.1, printed pages 84-85, lines 2105-2143; JRC Preparatory Study, Section 13.7.2, printed pages 394-395, lines 10227-10248.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#hasContextFactorType">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Identifies the controlled context factor concept observed or declared by a textile context observation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">has context factor type</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#ironingPractice">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Practice and frequency with which a textile product is ironed or steamed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Ironing practice</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#careContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Ironing practice</skos:prefLabel>
    <txtcon:modellingNote xml:lang="en">High-temperature ironing may contribute to shrinkage; the effect remains product- and condition-dependent.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.7.2.6, printed page 403, lines 10417-10433; JRC Preparatory Study, Section 6.3.1, printed page 85, lines 2132-2134.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#directExtraction"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#DimensionalStability"/>
    <txtctx:typicallyQualifiesProcess rdf:resource="https://w3id.org/eudpp/textile-process#IroningProcess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#abrasionExposure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Exposure of a textile product to rubbing, friction or abrasion during use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Abrasion exposure</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#useContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Abrasion exposure</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1.3, printed page 113, lines 3000-3009; Annex 13.4, Table 124, printed pages 362-367.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#bleachingPractice">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Practice or condition describing whether bleaching is used and under what care conditions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Bleaching practice</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#careContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Bleaching practice</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3296-3305.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtctx:typicallyQualifiesProcess rdf:resource="https://w3id.org/eudpp/textile-process#WashingProcess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#userBehaviourFactor">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Context factor related to user choices affecting care, repair, storage, replacement or product use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">User behaviour factor</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#careBehaviour"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#careInstructionCompliance"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#repairBehaviour"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#replacementBehaviour"/>
    <skos:prefLabel xml:lang="en">User behaviour factor</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#mechanicalStress">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Mechanical loading or deformation imposed on a textile product during use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Mechanical stress</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#useContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Mechanical stress</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Section 9.2.1.3, printed page 113, lines 3000-3009; Annex 13.4, Table 124, printed pages 362-367.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#observationOf">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile context observation to the product or process execution to which it applies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">observation of</rdfs:label>
    <rdfs:range rdf:nodeID="cb1c678f59b948fcc8cc76c173f2743da010a48dbe5a0ce340a4855b1cda896a378"/>
    <owl:inverseOf rdf:resource="https://w3id.org/eudpp/textile-context#hasContextObservation"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#ContextFactorScheme">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary of textile use, care, exposure, storage and user-behaviour context factor types.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Textile context factor scheme</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-context#careContextFactor"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-context#environmentalContextFactor"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-context#storageContextFactor"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-context#useContextFactor"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/textile-context#userBehaviourFactor"/>
    <skos:prefLabel xml:lang="en">Textile context factor scheme</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#TextileContextObservation">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A concrete observation, declaration or setting of a contextual condition applying to a textile product or a textile process execution.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Textile context observation</rdfs:label>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#activeOrInactiveStorage">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Whether a textile item is stored for regular access and use or kept unused for an extended period.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Active or inactive storage</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#storageContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Active or inactive storage</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.3.4, printed pages 86-87, lines 2220-2231; JRC Preparatory Study, Section 13.7.2.10, printed page 410, lines 10618-10646.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#hasCategoricalValue">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile context observation to a controlled categorical value represented as a SKOS concept.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">has categorical value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#replacementBehaviour">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">User behaviour concerning substitution or disposal of a textile product; replacement frequency remains a derived indicator in TEXTILE_INDICATOR.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Replacement behaviour</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#userBehaviourFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Replacement behaviour</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.3.4, printed pages 86-87, lines 2220-2244; JRC Preparatory Study, Section 6.4.1, printed page 87, lines 2246-2259.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#uvExposure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Exposure of a textile product to ultraviolet radiation; the source and exposure conditions should be stated where known.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Ultraviolet exposure</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#environmentalContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Ultraviolet exposure</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Section 10.2.3, printed page 180, lines 5038-5043.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#hasReferencePeriod">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a textile context observation to the structured time interval for which it is valid or observed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextObservation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">has reference period</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/eudpp/textile-connector#ReferencePeriod"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#temperatureExposure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Exposure of a textile product to a stated temperature condition during use, care, drying, ironing or storage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Temperature exposure</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#environmentalContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Temperature exposure</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3309-3318.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#environmentalContextFactor">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Context factor related to sunlight, ultraviolet radiation, humidity, moisture, temperature or external chemicals.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Environmental exposure context factor</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#externalChemicalExposure"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#humidityExposure"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#moistureExposure"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#sunlightExposure"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#temperatureExposure"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#uvExposure"/>
    <skos:prefLabel xml:lang="en">Environmental exposure context factor</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#sunlightExposure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Exposure of a textile product to direct or indirect sunlight during drying, storage or use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Sunlight exposure</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#environmentalContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Sunlight exposure</skos:prefLabel>
    <txtcon:modellingNote xml:lang="en">Sunlight exposure may influence colour fastness and appearance depending on dyes, material and exposure conditions.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.1, printed page 123, lines 3257-3262; JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3315-3316; JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3322-3325.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#ColourFastness"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#moistureExposure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Exposure of a textile product to moisture or a wet condition, distinguished from ambient relative humidity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Moisture exposure</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#environmentalContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Moisture exposure</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3317-3318.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#careInstructionCompliance">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Extent to which the user follows the care instructions provided for a textile product.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Care-instruction compliance</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#userBehaviourFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Care-instruction compliance</skos:prefLabel>
    <txtcon:modellingNote xml:lang="en">Following care instructions may support maintenance of product condition, but no deterministic lifetime inference is asserted.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 6.3.2, printed page 85, lines 2144-2157; JRC Preparatory Study, Section 13.7.2.8, printed page 404, lines 10440-10458; JRC Preparatory Study, Section 9.2.2.1, printed pages 122-123, lines 3234-3262.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#directExtraction"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#IntrinsicDurability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#storageContextFactor">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Context factor related to storage practice or storage conditions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Storage context factor</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#activeOrInactiveStorage"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#foldingOrHangingCondition"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#storageHumidity"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#storageSunlightExposure"/>
    <skos:prefLabel xml:lang="en">Storage context factor</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#washingFrequency">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">How often a textile product is washed during a stated reference period.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Washing frequency</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#careContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Washing frequency</skos:prefLabel>
    <txtcon:modellingNote xml:lang="en">Washing frequency may influence physical durability and dimensional stability, but the effect depends on material, programme and care conditions.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.7.2, printed page 395, lines 10241-10248; JRC Preparatory Study, Section 6.3.1, printed page 84, lines 2105-2111.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#directExtraction"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#DimensionalStability"/>
    <txtctx:typicallyQualifiesProcess rdf:resource="https://w3id.org/eudpp/textile-process#WashingProcess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#frequencyOfUse">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">How often a textile product is used or worn during a stated reference period.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Frequency of use</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#useContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Frequency of use</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.7.2, printed page 395, lines 10235-10243; JRC Preparatory Study, Section 6.3.1, printed page 84, lines 2105-2111.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#foldingOrHangingCondition">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Whether and how a textile product is folded or hung during storage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Folding or hanging condition</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#storageContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Folding or hanging condition</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.1, printed page 123, lines 3259-3262; JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3322-3325; JRC Preparatory Study, Section 13.7.2.7, printed page 403, lines 10434-10439.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#directExtraction"/>
    <txtctx:typicallyQualifiesProcess rdf:resource="https://w3id.org/eudpp/textile-process#StorageProcess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#dryingPractice">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Method or practice used to dry a textile product, such as tumble drying, indoor line drying or outdoor line drying.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Drying practice</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#careContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Drying practice</skos:prefLabel>
    <txtcon:modellingNote xml:lang="en">Drying method and temperature may influence shrinkage and dimensional stability; no deterministic effect is asserted.</txtcon:modellingNote>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.7.2.5, printed page 403, lines 10404-10416; JRC Preparatory Study, Section 6.3.1, printed page 85, lines 2126-2131.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
    <txtcon:typicalInfluenceOn rdf:resource="https://w3id.org/eudpp/textile-durability#DimensionalStability"/>
    <txtctx:typicallyQualifiesProcess rdf:resource="https://w3id.org/eudpp/textile-process#DryingProcess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#useContextFactor">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Context factor related to how a textile product is used or worn.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Use context factor</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#abrasionExposure"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#durationOfUse"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#frequencyOfUse"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#intensityOfUse"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#mechanicalStress"/>
    <skos:prefLabel xml:lang="en">Use context factor</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb14f145ed3d7a1d2cedc1e037d310437ae12bd0693a80c7ea2919fe04dd151a654">
    <rdf:first rdf:resource="https://w3id.org/eudpp/textile-process#TextileProcessExecution"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context">
    <dcterms:bibliographicCitation xml:lang="en">EU DPP Textile Context Ontology. Version 2.0.0 candidate.</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:created>
    <dcterms:creator xml:lang="en">Andreas Schneider</dcterms:creator>
    <dcterms:creator xml:lang="en">BOUGACHA Racem</dcterms:creator>
    <dcterms:creator xml:lang="en">Elio Hbeich</dcterms:creator>
    <dcterms:creator xml:lang="en">Ivo Ladenius</dcterms:creator>
    <dcterms:creator xml:lang="en">Jan Merckx</dcterms:creator>
    <dcterms:creator xml:lang="en">Piero de Sabbata</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology module for representing concrete observations, declarations and settings about textile use, care, environmental exposure, storage and user behaviour. Context factor types are represented as SKOS concepts; processes and process parameters remain in TEXTILE_PROCESS.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-06</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <dcterms:title xml:lang="en">EU DPP Textile Context Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>txtctx</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/eudpp/textile-context#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">A context observation is not a textile process, process parameter, assessment result or derived indicator. Washing temperature and similar operational settings remain represented through TEXTILE_PROCESS.</rdfs:comment>
    <rdfs:label xml:lang="en">EU DPP Textile Context Ontology</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-connector"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-dpp-mireot"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-durability"/>
    <owl:imports rdf:resource="https://w3id.org/eudpp/textile-process"/>
    <owl:priorVersion rdf:resource="https://w3id.org/eudpp/textile-context/1.1.2"/>
    <owl:versionIRI rdf:resource="https://w3id.org/eudpp/textile-context/2.0.0"/>
    <owl:versionInfo>Version 2.0.0 candidate</owl:versionInfo>
    <txtcon:sourceLocator xml:lang="en">JRC 3rd milestone, Sections 6.3 (pages 84-87, lines 2105-2244), 9.2.2.2 (pages 125-126, lines 3296-3327), and 13.7.2 (pages 395-410, lines 10227-10646).</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#externalChemicalExposure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Exposure of a textile product to an external chemical formulation during care or use; the substance or formulation should be identified separately where possible.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">External chemical exposure</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#environmentalContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">External chemical exposure</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 13.7.2, printed page 395, lines 10241-10244; JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3310-3314.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#storageSunlightExposure">
    <dcterms:source rdf:resource="https://susproc.jrc.ec.europa.eu/product-bureau/sites/default/files/2025-12/Textile-Prep-Study_3rd-Milestone_20251212.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Exposure to sunlight while a textile product is stored.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Storage sunlight exposure</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/eudpp/textile-context#storageContextFactor"/>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:prefLabel xml:lang="en">Storage sunlight exposure</skos:prefLabel>
    <txtcon:sourceLocator xml:lang="en">JRC Preparatory Study, Section 9.2.2.2, printed page 125, lines 3322-3325; JRC Preparatory Study, Section 9.2.2.1, printed page 123, lines 3257-3262.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#adaptedDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#careContextFactor">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">Context factor related to laundering, cleaning, drying, ironing, bleaching or other care practices.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Care context factor</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#bleachingPractice"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#cleaningFrequency"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#detergentUsePractice"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#dryingPractice"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#ironingPractice"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#laundrySortingPractice"/>
    <skos:narrower rdf:resource="https://w3id.org/eudpp/textile-context#washingFrequency"/>
    <skos:prefLabel xml:lang="en">Care context factor</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/textile-context#ContextFactorScheme"/>
    <txtcon:sourceLocator xml:lang="en">CIRPASS Textile Ontology modelling specification, version 1.1.0.</txtcon:sourceLocator>
    <txtcon:sourceType rdf:resource="https://w3id.org/eudpp/textile-connector#modellingAbstraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/eudpp/textile-context#hasContextObservation">
    <dcterms:source rdf:resource="https://w3id.org/eudpp/textile-ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relates a product or a concrete textile process execution to a context observation applying to it.</rdfs:comment>
    <rdfs:domain rdf:nodeID="cb1c678f59b948fcc8cc76c173f2743da010a48dbe5a0ce340a4855b1cda896a378"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">has context observation</rdfs:label>
