    <rdf:type rdf:resource="https://w3id.org/eudpp/textile-context#TextileContextFactorConcept"/>
    <rdfs:comment xml:lang="en">User behaviour concerning self-repair, seeking help or using a professional repair service.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/textile-context"/>
    <rdfs:label xml:lang="en">Repair behaviour</rdfs:label>
